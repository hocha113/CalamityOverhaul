Mewtwo: {
	DisplayName: Chip de braindance
	Tooltip: Úsalo para entrar en un braindance
}

RapidBarrelModule: {
	DisplayName: Cañón de disparo rápido
	Tooltip: Un resorte de retroceso ultralargo produce pulsos ardientes a costa de estabilidad y potencia por disparo
}

FocusBarrelModule: {
	DisplayName: Cañón de concentración
	Tooltip: Fuerza a los tres rayos con seguimiento a converger en un único golpe concentrado y catastrófico
}

PrecisionOpticModule: {
	DisplayName: Mira de precisión
	Tooltip:
		'''
		Juicio calibrado: elimina toda la dispersión; impactos consecutivos sin fallar acumulan calibración
		Con quince cargas dispara un rayo de juicio perforante con crítico garantizado; fallar reinicia la calibración
		'''
}

OverloadCoreModule: {
	DisplayName: Núcleo de sobrecarga
	Tooltip:
		'''
		Quita el seguro del orbe: sigue cargando tras el máximo para sobrecargarlo — hasta doble daño y mayor explosión
		Si aguantas más allá de la línea roja, el núcleo revienta: te empuja y quema la mitad de tu maná
		'''
}

SteadyStockModule: {
	DisplayName: Culata estabilizadora
	Tooltip: Una culata pesada compuesta absorbe el retroceso, cambiando algo de cadencia por daño extra por disparo
}

HarmonyGripModule: {
	DisplayName: Empuñadura armónica
	Tooltip:
		'''
		La bioconducción reduce el coste de maná; el maná derramado al golpear se condensa en brumas resonantes
		Las brumas flotan hacia ti: recogerlas devuelve maná y acumula Armonía que aumenta la cadencia (máx. 5)
		'''
}

ResonanceFrameModule: {
	DisplayName: Armazón de resonancia
	Tooltip: El armazón de armónicos apilados vierte un rayo extra, intensificando la andanada
}

AdaptiveOpticModule: {
	DisplayName: Mira adaptativa
	Tooltip:
		'''
		Control de tiro predictivo: analiza el movimiento del objetivo y proyecta un marcador holográfico de intercepción
		Los rayos se desvían para anticipar el tiro; golpear objetivos en movimiento añade impactos adaptativos
		'''
}

AssaultStockModule: {
	DisplayName: Culata de asalto
	Tooltip:
		'''
		La culata integra dos módulos de combate: al empuñar el arma se despliegan dos brazos artillados flotantes en tus hombros
		Los brazos se sincronizan con tu gatillo y disparan dardos de apoyo alternándose con cada disparo
		'''
}

BalancedGripModule: {
	DisplayName: Empuñadura equilibrada
	Tooltip:
		'''
		Protocolo de equilibrio gemelo: los rayos acumulan carga Yang, los orbes acumulan carga Yin
		Mientras ambas cargas estén equilibradas, aumentan el daño, la cadencia y la eficiencia de maná
		'''
}

CapacitorBankModule: {
	DisplayName: Banco de condensadores
	Tooltip: Una pila densa de condensadores llena la esfera en ciclos mucho más cortos, pero amortigua su energía de salida
}

CrystalGripModule: {
	DisplayName: Empuñadura de cristal
	Tooltip:
		'''
		El cristal sintético ahorra maná y mejora el crítico; los impactos críticos se refractan en materia:
		esquirlas de cristal estallan del objetivo en arcos balísticos y se curvan hacia enemigos cercanos
		'''
}

EfficientGripModule: {
	DisplayName: Empuñadura eficiente
	Tooltip: Una empuñadura ergonómica de grado industrial optimiza a la vez el consumo energético y el ritmo de disparo
}

HeavyBarrelModule: {
	DisplayName: Cañón pesado
	Tooltip: El estriado reforzado aplasta la dispersión y la cadencia; cada disparo se convierte en un golpe contundente
}

HighVoltageCoreModule: {
	DisplayName: Núcleo de alto voltaje
	Tooltip:
		'''
		Un condensador de alto voltaje se carga con cada impacto
		Con carga completa, tu siguiente impacto descarga un arco perforante que atraviesa todo en su trayectoria
		'''
}

HoloOpticModule: {
	DisplayName: Mira holográfica
	Tooltip:
		'''
		Proyector de retícula táctica: despliega periódicamente una rejilla holográfica en tu cursor durante el combate
		Los proyectiles enemigos que la tocan se disuelven; tus rayos al cruzarla se recalibran: más daño y nueva puntería
		'''
}

HypersonicBarrelModule: {
	DisplayName: Cañón hipersónico
	Tooltip:
		'''
		El estriado estatorreactor acelera los rayos en vuelo; romper la barrera del sonido detona un anillo de choque Mach
		Tras la barrera, los rayos se ponen al rojo blanco: más daño, más perforación y estela de condensación
		'''
}

KineticDamperModule: {
	DisplayName: Culata amortiguadora cinética
	Tooltip:
		'''
		Los amortiguadores hidráulicos almacenan el retroceso de tus impactos como reserva cinética; sobre media reserva eres inmune al empuje
		Al recibir daño, toda la reserva estalla en una onda sísmica de contraataque que aparta a los enemigos
		'''
}

LightStockModule: {
	DisplayName: Culata ligera
	Tooltip:
		'''
		El armazón ligero segmentado aumenta la cadencia y convierte cada rayo principal en una cadena de luz reptante:
		dos eslabones siguen la trayectoria del rayo, cada uno con su propio daño
		'''
}

MultiCellFrameModule: {
	DisplayName: Armazón multicelda
	Tooltip: Las celdas de refrigeración en paralelo disparan dos rayos a la vez: más cobertura, menos daño por rayo
}

PlasmaInjectorModule: {
	DisplayName: Inyector de plasma
	Tooltip:
		'''
		Inyecta plasma de alta entalpía en el orbe: su detonación deja un sol de plasma en miniatura
		El sol abrasa todo lo cercano y azota periódicamente al enemigo más próximo con erupciones solares
		'''
}

QuantumFrameModule: {
	DisplayName: Armazón cuántico
	Tooltip:
		'''
		Protocolo de entrelazamiento: golpear dos objetivos distintos seguidos los entrelaza cuánticamente unos segundos
		El daño a uno se copia en parte al otro; si uno muere, el vínculo colapsa y descarga el eco acumulado en el superviviente
		'''
}

ScattershotBarrelModule: {
	DisplayName: Cañón de perdigones
	Tooltip: La boca fracturada divide cada disparo en una ráfaga de rayos: cobertura enorme, daño por rayo muy reducido
}

ThermalOpticModule: {
	DisplayName: Mira térmica
	Tooltip: El bloqueo infrarrojo hace que los rayos se aferren al objetivo, con ganancias de precisión y crítico
}

VolatileFrameModule: {
	DisplayName: Armazón inestable
	Tooltip: La red de refrigeración sobrecargada exprime un rayo y crítico extra, pero el maná y la dispersión se disparan
}

NovaBarrelModule: {
	DisplayName: Cañón nova
	Tooltip:
		'''
		La boca de plasma sobrecargada detona un micropulso en cada impacto de rayo
		El precio es más dispersión, menos potencia por disparo y mayor consumo de maná
		'''
}

PrismOpticModule: {
	DisplayName: Mira de prisma
	Tooltip:
		'''
		Un prisma de fase al final de la ruta óptica divide cada rayo en dos astillas al expirar
		Los rayos principales vuelan algo menos lejos a cambio de una ventana de crítico más afilada
		'''
}

TeslaCoreModule: {
	DisplayName: Núcleo Tesla
	Tooltip:
		'''
		El arco de alto voltaje hace que los rayos impactados salten al enemigo más cercano
		Cada nodo encadenado hereda los efectos al impactar, con mayor coste de maná
		'''
}

RecoilStockModule: {
	DisplayName: Culata de retroceso
	Tooltip:
		'''
		Un búfer de sobrecarga convierte las detonaciones de la esfera en impulso cinético para el portador
		El alcance del rayo se extiende a la par; el gatillo se siente algo más pesado
		'''
}

SwarmGripModule: {
	DisplayName: Empuñadura de enjambre
	Tooltip:
		'''
		La empuñadura de malla neural libera un enjambre de microesferas con fuerte seguimiento al detonar la esfera
		La velocidad de la esfera baja y el consumo de maná sube como compensación
		'''
}

GravityFrameModule: {
	DisplayName: Armazón gravitacional
	Tooltip:
		'''
		Un anillo de singularidad miniatura convierte la esfera en un pozo gravitacional
		Atrae a los enemigos cercanos mientras carga y amplía mucho el radio de explosión
		La cámara de precisión hace que la carga se sienta algo más lenta
		'''
}

LaserBarrelModule: {
	DisplayName: Cañón láser de prisma
	Tooltip: Convierte el clic izquierdo en un haz láser de prisma continuo que sigue el cursor, con enorme coste de maná y potencia limitada
}

OscillatorBarrelModule: {
	DisplayName: Cañón láser oscilante
	Tooltip:
		'''
		Un condensador de pulso integrado detona una microexplosión en la punta del haz cada 30 fotogramas
		El daño directo baja ligeramente, pero las explosiones de área y el menor maná compensan el fuego continuo
		'''
}

ScorchBarrelModule: {
	DisplayName: Cañón láser abrasador
	Tooltip:
		'''
		La tobera de plasma de alta entalpía incendia a los enemigos al contacto del láser
		El daño del haz baja un poco, pero la combustión sostenida y el menor maná compensan la pérdida directa
		'''
}

ReflectionBarrelModule: {
	DisplayName: Cañón láser reflectante
	Tooltip:
		'''
		Un prisma de diamante en el punto de impacto desvía parte de la energía en dos rayos laterales
		El daño del haz principal aumenta, pero el consumo extremo de maná encarece el fuego sostenido
		'''
}

EchoOpticModule: {
	DisplayName: Mira de eco
	Tooltip:
		'''
		Un elemento de resonancia al final de la ruta captura el eco energético cuando un rayo expira
		Cada muerte de rayo genera tres subrayos con seguimiento en abanico, compensando el alcance reducido
		'''
}

FrostOpticModule: {
	DisplayName: Mira de escarcha
	Tooltip:
		'''
		La lente criogénica inflige Quemadura de escarcha a los objetivos golpeados
		La velocidad del rayo baja, pero el seguimiento es más estable, con perforación y crítico extra
		'''
}

SingularityCoreModule: {
	DisplayName: Núcleo de singularidad
	Tooltip:
		'''
		Un generador de microgravedad dirige continuamente la esfera hacia el enemigo más cercano en vuelo
		El radio de explosión se amplía mucho, pero el campo denso encarece el maná
		'''
}

ScrambleFieldModule: {
	DisplayName: Módulo de campo perturbador
	Tooltip:
		'''
		Una bobina de alta frecuencia dispara una microonda de choque alrededor de la esfera cada 40 fotogramas mientras carga
		La escala de la explosión aumenta a costa de una carga más lenta y mayor consumo de maná
		'''
}

BraceStockModule: {
	DisplayName: Culata de soporte
	Tooltip: Un soporte estabilizador pesado elimina toda la dispersión y extiende el alcance del rayo, cambiando algo de cadencia por precisión extrema
}

LaunchStockModule: {
	DisplayName: Culata de lanzamiento
	Tooltip:
		'''
		Un mecanismo de resorte sobrecargado dispara tres rayos con seguimiento en abanico en el instante en que se lanza la esfera
		La velocidad de la esfera aumenta y el coste de maná sube a la par
		'''
}

SentinelGripModule: {
	DisplayName: Empuñadura centinela
	Tooltip:
		'''
		La empuñadura con sensor inteligente dispara automáticamente un rayo con seguimiento al enemigo más cercano cada 20 fotogramas mientras la esfera está en el aire
		La velocidad de la esfera baja ligeramente y el maná sube, pero el fuego de acompañamiento compensa
		'''
}

ConductorGripModule: {
	DisplayName: Empuñadura conductora
	Tooltip:
		'''
		El material superconductor potencia los saltos en cadena del arco a mayor distancia y con más rebotes
		Cada impacto va acompañado de una ráfaga de partículas de arco; ligero aumento de daño y maná
		'''
}

PhantomFrameModule: {
	DisplayName: Armazón fantasma
	Tooltip:
		'''
		Una cavidad de fase cuántica teletransporta el rayo a 80 píxeles del enemigo más cercano cada 30 fotogramas
		Evita obstáculos por completo; ligero aumento de alcance y daño con más coste de maná
		'''
}

RecursiveFrameModule: {
	DisplayName: Armazón recursivo
	Tooltip:
		'''
		Un chasis de bucle topológico reenvía cada rayo desde la posición del jugador en su dirección original al morir
		El daño del rayo principal sube pero el alcance se acorta; el eco hace menos daño y no se repite
		'''
}

ForkBarrelModule: {
	DisplayName: Cañón bifurcado
	Tooltip:
		'''
		Un prisma interno divide cada rayo en dos subrayos angulados cada 50 fotogramas
		Ligera penalización de daño y maná
		'''
}

NullBarrelModule: {
	DisplayName: Cañón nulo
	Tooltip:
		'''
		Una cámara de borrado de datos reduce el daño casi a cero, pero otorga perforación prácticamente infinita
		Los impactos inyectan una toxina virulenta que corroe al objetivo con el tiempo
		'''
}

HelixBarrelModule: {
	DisplayName: Cañón helicoidal
	Tooltip:
		'''
		La óptica de doble canal obliga a dos rayos a enrollarse en espiral alrededor de un eje común
		Dispersión cero; ligera penalización de daño y velocidad; excelente con configuraciones de alta perforación
		'''
}

TargetPainterOpticModule: {
	DisplayName: Mira de designación
	Tooltip:
		'''
		El sistema láser de designación marca a los objetivos golpeados con icor corrosivo, reduciendo su defensa
		También mejora el seguimiento y la probabilidad de crítico
		'''
}

StrobeOpticModule: {
	DisplayName: Mira estroboscópica
	Tooltip:
		'''
		El modulador de cambio de fase alterna rápidamente el rayo entre atravesar muros y estado sólido
		30 % de probabilidad de confundir a los enemigos golpeados; ligera bonificación de perforación y velocidad
		'''
}

SniperOpticModule: {
	DisplayName: Mira de francotirador
	Tooltip:
		'''
		Los colimadores magnéticos aumentan drásticamente velocidad, alcance y daño por impacto
		A costa de una cadencia muy reducida y seguimiento casi nulo
		Combínala con el cañón hipersónico para golpes extremos a larga distancia
		'''
}

StormCellModule: {
	DisplayName: Célula de tormenta
	Tooltip:
		'''
		Durante la carga libera un rayo eléctrico con seguimiento hacia el enemigo más cercano cada 25 fotogramas
		Carga más rápida y mayor radio de explosión, pero mayor coste de maná
		'''
}

CryoCoreModule: {
	DisplayName: Núcleo criogénico
	Tooltip:
		'''
		Una celda de energía ultracongelada congela a todos los enemigos dentro del radio de explosión de la esfera
		Explosión algo mayor, carga algo más lenta
		'''
}

DarkMatterCoreModule: {
	DisplayName: Núcleo de materia oscura
	Tooltip:
		'''
		Un campo de materia oscura atrae a los enemigos cercanos hacia la esfera durante su fase de vuelo
		La esfera sigue objetivos a la vez; el radio de explosión aumenta significativamente
		Alto coste de maná
		'''
}

ErgonomicStockModule: {
	DisplayName: Culata ergonómica
	Tooltip: El diseño ergonómico de precisión reduce sustancialmente el coste de maná con ligeras mejoras de cadencia y precisión
}

ExtenderStockModule: {
	DisplayName: Culata extensora
	Tooltip:
		'''
		Un riel alargado otorga a los rayos mayor alcance y velocidad de vuelo con una pérdida mínima de daño
		Combínala con la mira de francotirador para cobertura extrema a larga distancia
		'''
}

StormStockModule: {
	DisplayName: Culata de tormenta
	Tooltip:
		'''
		Resortes de retroceso de alta densidad empujan la cadencia y el número de rayos al límite a costa del daño por impacto
		Combínala con el cañón de perdigones para saturación total del campo
		'''
}

VampireGripModule: {
	DisplayName: Empuñadura vampírica
	Tooltip:
		'''
		La empuñadura bioeléctrica convierte parte del daño del rayo en recuperación de vida
		Los impactos láser son más frecuentes pero curan menos por tick; útil en combates prolongados
		'''
}

ChronalGripModule: {
	DisplayName: Empuñadura temporal
	Tooltip:
		'''
		La bobina de retardo de fase ralentiza a los enemigos en cada impacto
		Con mejor seguimiento, el fuego denso mantiene un control persistente sobre la multitud
		'''
}

CascadeGripModule: {
	DisplayName: Empuñadura en cascada
	Tooltip:
		'''
		Cada 5 impactos genera un nodo en cascada flotante en el punto de golpe
		El nodo permanece ~2 s y dispara 5 rayos con seguimiento que cazan enemigos cercanos
		Reduce ligeramente el daño base
		'''
}

MirrorFrameModule: {
	DisplayName: Armazón espejo
	Tooltip:
		'''
		Una cavidad de reflexión simétrica genera un rayo espejo de 180° por cada rayo disparado
		Los rayos espejo hacen menos daño; la cobertura bidireccional aumenta drásticamente la densidad de impactos
		'''
}

NullspaceFrameModule: {
	DisplayName: Armazón del vacío
	Tooltip:
		'''
		Un generador de grieta del vacío deja un eco de microexplosión a lo largo de la trayectoria del rayo cada 20 fotogramas
		Alcance ligeramente extendido; penalización de daño mínima
		'''
}

OverkillFrameModule: {
	DisplayName: Armazón de exceso
	Tooltip:
		'''
		El circuito de exceso apila una carga por cada muerte, hasta 15; cada carga añade un 2 % de daño
		Las cargas decaen con el tiempo: cuanto más rápido mates, más fuerte te vuelves
		'''
}

GraviticBarrelModule: {
	DisplayName: Cañón gravitacional
	Tooltip:
		'''
		La microsingularidad integrada atrae a los enemigos cercanos hacia cada rayo en vuelo
		La dispersión y el seguimiento se ajustan mientras el alcance crece; la velocidad de salida baja un poco
		'''
}

PrismaticBarrelModule: {
	DisplayName: Cañón prismático
	Tooltip:
		'''
		Los prismas de dispersión arrojan estelas RGB desde cada rayo y esquirlas de color al impactar
		Añade un rayo extra y compensación de crítico a costa de algo de daño y dispersión
		'''
}

ConcussionBarrelModule: {
	DisplayName: Boca de conmoción
	Tooltip:
		'''
		El búfer de sobrecarga detona un pequeño anillo de conmoción en el punto de impacto cada 5 golpes acumulados
		El daño y la dispersión por disparo mejoran, pero la velocidad de ataque paga el precio
		'''
}

ObsidianBarrelModule: {
	DisplayName: Cañón de obsidiana
	Tooltip:
		'''
		Los impactos graban grietas de obsidiana en el objetivo; al llenar las capas estallan en vidrio volcánico cazador
		Las detonaciones de la esfera rompen grietas cercanas antes de tiempo, ideal contra grupos bajo presión sostenida
		'''
}

LifebloomBarrelModule: {
	DisplayName: Cañón de flor vital
	Tooltip:
		'''
		Los rayos siembran brotes vitales parásitos que drenan daño retardado y devuelven un poco de vida al portador
		Cuando el huésped muere, el brote salta a un enemigo cercano y sigue creciendo
		'''
}

MagmaVentBarrelModule: {
	DisplayName: Cañón de respiradero magmático
	Tooltip:
		'''
		Impactos y rayos expirados dejan respiraderos de magma de corta duración que erupcionan en columnas de calor verticales
		En el inframundo o líquidos muy calientes el ciclo es más rápido para negar zonas
		'''
}

CumulusBarrelModule: {
	DisplayName: Cañón de cúmulos
	Tooltip:
		'''
		Las trayectorias condensan núcleos de nube recargables que se alimentan de rayos SHPC y esferas cercanas
		Al llenarse, cada nube descarga tres rayos cortos de lluvia eléctrica para fuego posicional
		'''
}

MossboundBarrelModule: {
	DisplayName: Cañón de musgo
	Tooltip:
		'''
		Los rayos siembran parches de musgo húmedo que ralentizan enemigos y avanzan hacia una breve inmovilización por raíces
		Las esferas en vuelo absorben musgo cercano para ampliar su explosión final
		'''
}

FrostfernBarrelModule: {
	DisplayName: Cañón de helecho helado
	Tooltip:
		'''
		El primer golpe traza una vena de hielo detrás del objetivo, compartiendo escarcha con enemigos en la línea
		Encadena multitudes mediante una geometría de helecho ramificado en lugar de congelar solo a una víctima
		'''
}

SandstormBarrelModule: {
	DisplayName: Cañón de tormenta de arena
	Tooltip:
		'''
		El fuego sostenido arrolla un muro de arena móvil que desgasta enemigos y debilita proyectiles hostiles
		Los rayos ganan perforación extra mientras el maná sube para mantener la tormenta
		'''
}

CoralReefBarrelModule: {
	DisplayName: Cañón de arrecife de coral
	Tooltip:
		'''
		Los puntos de impacto generan anclas de coral que se conectan en líneas de arrecife dañinas
		Las detonaciones de la esfera hacen que las anclas cercanas liberen oleadas circulares sincronizadas
		'''
}

HiveBarrelModule: {
	DisplayName: Cañón de colmena
	Tooltip:
		'''
		Los impactos con clic izquierdo marcan enemigos con feromonas; las detonaciones de la esfera lanzan abejas cibernéticas contra los marcados
		Dispersa las marcas para que el enjambre se divida y cubra el campo
		'''
}

MoondewBarrelModule: {
	DisplayName: Cañón de rocío lunar
	Tooltip:
		'''
		Las estelas condensan prismas de rocío que refractan rayos posteriores en disparos derivados cortos
		La noche y la luna casi llena elevan el límite de refracción y la recompensa de cada prisma
		'''
}

CrosslinkOpticModule: {
	DisplayName: Mira de enlace cruzado
	Tooltip:
		'''
		Al impactar, una unidad de enlace neural arca un cable de datos desde el objetivo al enemigo más cercano
		Aumentan los saltos en cadena y el radio de salto, con un ligero aumento del coste de maná
		'''
}

ZoomOpticModule: {
	DisplayName: Mira de zoom
	Tooltip:
		'''
		Una lente magnética de largo alcance empuja los rayos más lejos y más rápido a costa de seguimiento y velocidad de ataque
		Impactos a más de 600 píxeles activan un golpe incandescente extra que escala con la distancia
		'''
}

PingOpticModule: {
	DisplayName: Mira de marcado
	Tooltip: El sistema de señalización marca a los objetivos golpeados con Marca de muerte y aporta cierta probabilidad de crítico
}

CapacitorPulseModule: {
	DisplayName: Pulso de condensador
	Tooltip:
		'''
		Las pilas densas de condensadores liberan una microdetonación de pulso aproximadamente cada medio segundo mientras carga
		El radio de explosión y el tiempo de carga aumentan; sube el coste de maná
		'''
}

EntropyCoreModule: {
	DisplayName: Núcleo de entropía
	Tooltip:
		'''
		La esfera absorbe «entropía» de los enemigos cercanos durante el vuelo
		Al detonar libera una réplica de onda secundaria proporcional a la entropía acumulada: cuanto más densa la multitud, más fuerte la onda
		'''
}

ResonanceReactorModule: {
	DisplayName: Reactor de resonancia
	Tooltip:
		'''
		Emita un anillo de resonancia aproximadamente cada 0,75 s mientras carga
		La detonación provoca un choque de resonancia extra a los pies del jugador, cubriendo huecos cuerpo a cuerpo
		'''
}

OverwatchStockModule: {
	DisplayName: Culata de vigilancia
	Tooltip:
		'''
		Al permanecer quieto acumulas cargas de «Vigilancia» (máx. 5) que decaen rápido al moverte
		Cada carga otorga +3 % de daño y +2 % de crítico; la postura firme reduce ligeramente cadencia y dispersión
		'''
}

MomentumStockModule: {
	DisplayName: Culata de impulso
	Tooltip:
		'''
		Al moverte rápido acumulas cargas de «Impulso» (máx. 6) que decaen rápido al detenerte
		Cada carga otorga +4 % de velocidad de ataque y +6 % de velocidad del rayo, espejo de la culata de vigilancia
		'''
}

BulwarkStockModule: {
	DisplayName: Culata de bastión
	Tooltip:
		'''
		Al sostener el SHPC otorga una ligera reducción de daño al jugador
		La postura firme ralentiza ligeramente la carga y reduce el consumo de maná
		'''
}

CombatGripModule: {
	DisplayName: Empuñadura de combate
	Tooltip:
		'''
		Matar con rayos o láser acumula «Ímpetu de combate» (máx. 5)
		Cada carga otorga +4 % de velocidad de ataque y +2 % de daño; las cargas decaen sin muertes
		'''
}

TempestGripModule: {
	DisplayName: Empuñadura de tempestad
	Tooltip:
		'''
		Tras varios impactos acumulados desata una «Ráfaga de tempestad»: múltiples arcos de datos alrededor del último impacto
		El daño por disparo baja y el maná sube a cambio de limpieza rítmica
		'''
}

AbsorberGripModule: {
	DisplayName: Empuñadura absorbente
	Tooltip:
		'''
		Los impactos de rayo y láser devuelven una fracción del daño infligido como maná
		El daño por disparo baja ligeramente y el coste base de maná sube como contrapartida
		'''
}

HarmonicFrameModule: {
	DisplayName: Armazón armónico
	Tooltip:
		'''
		Varios rayos coexistiendo arcan cables de resonancia entre sí para daño extra
		Añade un rayo extra a costa de daño por disparo y algo de dispersión
		'''
}

ReplicatorFrameModule: {
	DisplayName: Armazón replicador
	Tooltip:
		'''
		Al expirar, un rayo con seguimiento genera un eco breve en su lugar que sigue volando en la dirección original
		El daño principal sube pero la duración se acorta; aumenta el coste de maná
		'''
}

ArchiveFrameModule: {
	DisplayName: Armazón de archivo
	Tooltip:
		'''
		Acumula el daño del SHPC; cada vez que se supera el umbral, detona una explosión de archivo a los pies del jugador
		El daño por disparo aumenta ligeramente con un pequeño sobrecoste de maná
		'''
}

CWRItem: {
	TemperatureText: Temperatura de combustión
	InternalStoredEnergy: Energía almacenada
	DeathModeItemText: Objeto de Modo Muerte
	LegendItemUpgradeDisable:
		'''
		Esta arma legendaria ha sido configurada para no poder mejorarse en el mundo actual.
		Para levantar esta restricción, vuelve a entrar al mundo.
		'''
	ItemLegendOnMouseLang: Pulsa [Shift] para escuchar la historia...

	CWRItem: {
		TemperatureText: Temperatura de combustión
		InternalStoredEnergy: Energía almacenada
		DeathModeItemText: Modo Muerte
		LegendItemUpgradeDisable:
			'''
			Esta arma legendaria ha sido configurada para no poder mejorarse en el mundo actual.
			Para levantar esta restricción, vuelve a entrar al mundo.
			'''
		ItemLegendOnMouseLang: Pulsa [Shift] para escuchar la historia...
	}
}

RMagicConch: {
	DontUseMagicConch: Una criatura poderosa te está observando...

	RMagicConch: {
		DontUseMagicConch: Una criatura poderosa te está observando...
		DisplayName: Caracola mágica
		Tooltip: Escucha con atención y oirás el océano
	}
}

GraniteTome: {
	DisplayName: Tomo de granito
	Tooltip:
		'''
		Invoca un orbe lento y teledirigido de energía de granito
		Se hace añicos en fragmentos de cristal buscadores al impactar
		'''
}

GraniteFlower: {
	DisplayName: Flor de granito
	Tooltip:
		'''
		Dispara una semilla de cristal que florece en una flor de energía persistente
		La flor pulsa varias veces, rociando pétalos de cristal a su alrededor
		'''
}

GraniteThrowingKnife: {
	DisplayName: Cuchillo arrojadizo de granito
	Tooltip:
		'''
		Lanza un cuchillo perforante que deja una estela de energía cristalina
		Se hace añicos en fragmentos de cristal en su último golpe o contra el terreno
		'''
}

GraniteWalkingBoots: {
	DisplayName: Botas andariegas de granito
	Tooltip:
		'''
		Aumenta enormemente la velocidad de carrera y la aceleración
		Crepita con chispas azules a máxima velocidad
		'''
}

MarbleClub: {
	DisplayName: Garrote de mármol
	Tooltip:
		'''
		Un golpe lento y pesado con un retroceso aplastante
		Puede petrificar a los enemigos, ralentizándolos brevemente
		El primer impacto de cada golpe desata una onda de choque de mármol
		'''
}

MarbleHuntingKnife: {
	DisplayName: Cuchillo de caza de mármol
	Tooltip:
		'''
		Ataques de tajo veloces
		Cada tercer golpe es un remate más amplio que rocía fragmentos de mármol
		'''
}

MarbleDisc: {
	DisplayName: Disco de mármol
	Tooltip:
		'''
		Lanza un disco giratorio que rebota entre enemigos y paredes
		Luego regresa curvándose a tu mano; pueden volar hasta dos a la vez
		'''
}

MarblePebble: {
	DisplayName: Guijarro de mármol
	Tooltip:
		'''
		Una piedra de honda inagotable, veloz y propensa a golpes críticos
		Inflige mucho más daño a los enemigos con mucha vida máxima
		Rebota una vez en el suelo
		'''
}

MarbleShield: {
	DisplayName: Égida de mármol
	Tooltip:
		'''
		Aumenta la defensa y la resistencia al retroceso
		Mantiene una guardia de piedra regenerable que absorbe un golpe entrante, estallando en fragmentos
		Prepárate para un bloqueo perfecto que refleja los proyectiles
		'''
}

MarbleBalloon: {
	DisplayName: Globo de mármol
	Tooltip:
		'''
		Pulsa Abajo en el aire para azotar el suelo, liberando una onda de choque al aterrizar
		Anula el daño por caída
		'''
}

MarbleinaBottle: {
	DisplayName: Mármol en una botella
	Tooltip: Otorga un pesado segundo salto
}

MarbleCloudBalloon: {
	DisplayName: Globo nuboso de mármol
	Tooltip:
		'''
		Otorga un pesado segundo salto
		Pulsa Abajo en el aire para azotar el suelo, liberando una onda de choque al aterrizar
		Anula el daño por caída
		'''
}

TestItem: {
	// DisplayName: Test Item
	// Tooltip: ""
}

OniMeiRubbingHigekiri: {
	// DisplayName: Higekiri
	Tooltip: Los golpes directos de hoja se refuerzan contra objetivos con poca vida y las bajas restauran postura; daño de hoja -2%
	// Origin: The night of the test cut, the head fell with the beard still clinging to the edge. The old name comes from that
	Power: Corta-Barbas: Los golpes directos de hoja aumentan de forma lineal contra objetivos con menos del 35 % de vida (hasta +60 %, o +45 % contra jefes); una baja con un golpe directo restaura 8 de postura una vez por acción
	Burden: Daño de hoja -2 % — contra objetivos sanos, este filo es algo más romo que la inscripción original
}

OniKeikoRune: {
	// DisplayName: Keiko Rune
	/* Tooltip:
		'''
		Use it to open the Onikiri lesson from the beginning, or use it again mid-lesson to put the lesson away
		Left with you when the opening lesson is declined; the rune is not consumed and may be used again
		''' */
	// NeedBlade: Onikiri is not in your bag, so the rune has no lesson to open
	// Closed: The lesson is put away; use the rune again to reopen
	// NotNow: Something else holds the stage right now
}

OniMeiRubbingOnikiri: {
	// DisplayName: Onikiri
	Tooltip: Inscripción original: mantiene la hoja tal cual, sin don ni precio
	// Origin: At Ichijo-Modoribashi, the oni that lost its arm never dared come back for it. The name has been nailed to the tang ever since
	Power: La inscripción original. La hoja permanece exactamente como es — no concede ni arrebata nada
	Burden: ———
}

OniMeiRubbingShishinoko: {
	// DisplayName: Shishi-no-ko
	Tooltip: Dos ondas de fauces coronan un combo completo de cinco golpes; intervalo del combo +2%
	// Origin: Left by the pillow at midnight, the blade roared like a lion. Inlaid in gold, to honor the name
	Power: Rugido del León: Completa cinco golpes de combo sin interrupciones por desplazamientos ni artes; el quinto libera dos ondas convergentes de fauces, cada una con un 22 % del daño de hoja base
	Burden: Intervalo del combo +2 % — hay que tomar aire antes de soltar un rugido
}

OniMeiRubbingTomokiri: {
	// DisplayName: Tomokiri
	Tooltip: Cancelar con un desplazamiento deja cortes de Culpa retardados; daño recibido +6%
	// Origin: Crossed with a friendly blade in trial, it cut the friend in two. A name of blame, chiseled into the tang; the sword has run violent since
	Power: Corta-Amigos: Cancelar un combo con Kamui deja un corte fantasma que muerde tras 6 tics e inflige un 35 % del daño de hoja base
	Burden: Daño recibido +6 %; cada fantasma añade una Culpa (máx. 3) que suma 4 de vigor al siguiente desplazamiento — un golpe de Zanshin salda todas las Culpas
}

OniMeiRubbingKazehi: {
	// DisplayName: Kaze-hi
	Tooltip: Coste de desplazamiento -15 %, consumo de Sakura -20 %; daño de marcas de tinta -20%
	// Origin: A groove opened like a wind channel; where the blade passes, only wind is heard, no blade is seen
	Power: Jinete del Viento: Coste de vigor del Paso Relámpago -15 %, consumo del Vuelo Sakura -20 %
	Burden: Daño de las marcas relámpago -20 % — la acanaladura se abrió para aligerar, no para matar
}

OniMeiRubbingChihi: {
	// DisplayName: Chi-hi
	Tooltip: Los impactos activos restauran más vigor; regeneración natural -35%
	// Origin: This groove is not for lightness, but for letting blood. So said the one who opened the edge
	Power: Sangría: El primer impacto de cada golpe del combo restaura +1 de vigor; el primer impacto de Zanshin de una acción restaura +4
	Burden: Regeneración natural de vigor -35 % y demora tras gastar +0,3 s — sin sangre en el filo, vuelve poco aliento
}

OniMeiRubbingFudo: {
	// DisplayName: Fudo
	Tooltip: Gasta postura para amortiguar impactos durante acciones comprometidas; ganancia de postura -15%
	// Origin: Carved in the brushwork of the seed syllable Kan. The Immovable One sits by the edge, flames at his back
	Power: Inamovible: Durante una acción comprometida, gasta 20 de postura para reducir el daño de contacto o proyectil hostil al 65 % y el retroceso al 25 % (2,5 s de recarga); la represalia de desmembramiento nunca se bloquea
	Burden: Ganancia de postura -15 % — la fuerza defensiva se extrae de tu acumulación
}

OniMeiRubbingKurikara: {
	// DisplayName: Kurikara
	Tooltip: Las ejecuciones otorgan tres bucles de fuego dracónico; límite de vigor -10%
	// Origin: The dragon coils about the sword and would swallow it. An old horimono subject, its scales inlaid in gold
	Power: Espiral del Dragón: Una ejecución otorga tres cargas de fuego dracónico durante 10 segundos; cada quinto golpe de un combo completo consume una y libera un bucle con un 50 % del daño de hoja base
	Burden: Límite de vigor -10 % — donde se enrosca el dragón, el aliento se estrecha
}

OniMeiRubbingTessetsu: {
	// DisplayName: Tessetsu
	Tooltip: El primer impacto de cada golpe cercena acero; daño de hoja -10%
	// Origin: A grand name for a scrap of iron. Nailed into the tang as a joke that stuck
	Power: Corte de Hierro: El primer impacto de cada golpe del combo inflige ×1,25 de daño a enemigos de acero o acorazados
	Burden: Daño de hoja -10 % — contra la carne se siente como hierro romo
}

OniMeiRubbingKyushu: {
	// DisplayName: Kyushu
	Tooltip: Remates profundos contra cabezas reales con poca vida; daño de hoja -3%
	// Origin: The head is still the old one. Cut clean; no need for a scare-name
	Power: Cazacabezas: Los golpes directos de hoja solo afectan cuerpos independientes o cabezas reales con menos del 35 % de vida y aumentan hasta +85 % (+60 % contra jefes)
	Burden: Daño de hoja -3 %; los segmentos de cuerpo, cola y cuerpo alternativo nunca activan Cazacabezas
}

OniMeiRubbingIkiai: {
	// DisplayName: Ikiai
	Tooltip: El quinto golpe libera un arco de espada del 55 %; intervalo del combo +4%
	// Origin: The breath you held while staring, then the blades met on the beat
	Power: Onda de Aliento: El quinto golpe de un combo completo lanza un arco de espada con un 55 % del daño de hoja base; vuela 16 tics y atraviesa como máximo tres cuerpos distintos
	Burden: Intervalo del combo +4%
}

OniMeiRubbingKyoko: {
	// DisplayName: Kyoko
	Tooltip: El espacio vacío prepara un corte cercano y un pulso de presión; las acciones cercanas rápidas desenfocan
	// Origin: A roar into empty air; the echo finds no place to land
	Power: Rugido Hueco: 90 tics sin enemigos preparan el siguiente golpe directo de hoja a menos de 260 px para infligir ×1,25 de daño; mientras esté frío, emite un pulso de presión de 24 tics cada 90 tics
	Burden: Cuatro acciones cercanas en 36 tics causan 24 tics de desenfoque con ×0,95 de daño cercano; los impactos lejanos no consumen el corte preparado
}

OniMeiRubbingKarikiri: {
	// DisplayName: Karikiri
	Tooltip: El cuerpo falso esquiva por completo un impacto; se rearma en 4 segundos
	// Origin: Learned so well it turned fake. An afterimage enters the tang
	Power: Cuerpo Falso: Al iniciar un Paso Relámpago deja durante 90 tics un señuelo de pose congelada que esquiva por completo un impacto de NPC o proyectil hostil; se rearma tras 240 tics
	Burden: Mientras vive el señuelo, el daño recibido y el coste de desplazamiento son ×1,12; al romperse, el daño recibido es ×1,18 durante 60 tics. La expiración natural no crea vacío
}

OniMeiRubbingMokukiri: {
	// DisplayName: Mokukiri
	Tooltip: Terminar de forma natural un desplazamiento pagado prepara Muerte Silenciosa; desplazarse o fallar la consume
	// Origin: The air sank. You got used to it. The guilt stayed
	Power: Muerte Silenciosa: Durante 45 tics tras finalizar de forma natural un Paso Relámpago normal pagado, la siguiente acción de combo o Zanshin inflige ×1,35 de daño
	Burden: Otro desplazamiento o un fallo consume Muerte Silenciosa; los desplazamientos de ejecución gratuitos nunca la preparan
}

OniMeiRubbingKumokiri: {
	// DisplayName: Kumo-kiri
	// Tooltip: Three cuts pin a web; closing it cuts everything inside; regen -25% while anchors stand
	// Origin: The earth-spider nested in the rafters. What was cut was not the spider, but the threads it hung from
	/* Power:
		'''
		Ink-Silk: when the blade itself lands a hit, it pins a silk anchor at the cut point for 4s
		Spread them out: the same foe gives no second anchor within 0.4s, and two anchors need roughly six tiles between them
		The third anchor strings an ink-silk triangle that sags, then snaps toward its centre, cutting every foe it sweeps for 90% of a blade hit and binding them 1s
		After it closes, 1.5s pass before you can weave again
		''' */
	// Burden: While any anchor still stands, natural regen -25%. An anchor left to expire wastes the cut that set it
	// DeedHint: Cut down thirty of the things that nest in the rafters, and the blade will learn that smell
}

OniMeiRubbingOnimaru: {
	// DisplayName: Oni-maru
	// Tooltip: Stand still and the blade flies off to cut on its own; you have no blade while it is out
	// Origin: One of the Five Great Swords that cut its own demon's leg off. Stand still, and it still moves
	/* Power:
		'''
		Self-Cut: stand nearly still for 1s and the blade goes on standby
		From then on it spends 10 of your vigor every 1.5s to fly at a foe within 40 tiles, cut for 140% of a blade hit, and return to the sheath
		''' */
	// Burden: The blade is out of your hands for the whole flight, so no combo, no flash step, no Sakura Flight. With nothing nearby it will not launch
	// DeedHint: Take a hit while standing still for ten seconds without moving, and the blade moves for you once
}

OniMeiRubbingRaikiri: {
	// DisplayName: Rai-kiri
	// Tooltip: The fifth beat and the big arts call lightning under open sky; beat interval +6%, nothing indoors
	// Origin: Tachibana Dosetsu cut thunder in the rain. The edge has to learn that bolt first
	/* Power:
		'''
		Thunder-Call: when the fifth beat, a Zanshin strike, Annihilating Flash, or Finale Slash lands and there is open sky overhead, a bolt drops from the top of the world
		The bolt deals 70% of a blade hit, and in a thunderstorm one strike can call up to three
		''' */
	// Burden: Combo beat interval +6%, sunny days included, because the wind-up is paid either way. Blocked overhead or underground, no bolt falls
	// DeedHint: Slay a boss-tier foe in a storm under open sky, and the edge learns the bolt
}

OniMeiRubbingNuekiri: {
	// DisplayName: Nue-kiri
	// Tooltip: Finish a combo airborne and the fifth beat becomes a ground slam; no dashing for 0.7s after landing
	// Origin: Minamoto no Yorimasa's shot came from above. The cut fell out of the sky
	/* Power:
		'''
		Nue-Dive: finish a full combo at least three tiles off the ground and the fifth beat stops swinging sideways, diving at the floor instead
		The landing opens a shock ring about 12 tiles across for 120% of a blade hit, and drags nearby foes toward the impact
		''' */
	// Burden: No flash steps for about 0.7s after you land. Fought close to the ground, the fifth beat stays an ordinary fifth beat
	// DeedHint: At night, cut down a flyer from great height, and the blade learns that plunge
}

OniMeiRubbingKamihi: {
	// DisplayName: Kami-hi
	// Tooltip: Dashing through a foe drops a paper cutout; cutting the paper hits the foe; dashes cost more while paper stands
	// Origin: Omokage silhouettes cut out for the surface world. While the paper stands, the blade keeps cutting it
	/* Power:
		'''
		Paper-Effigy: dashing through a foe leaves a paper cutout of it where you land, good for 7s, two on the field at most
		Cutting that paper deals 80% of a blade hit straight to the foe itself
		It also opens a wound on the foe for 1.5s, and your hits land 12% harder while that wound is open
		''' */
	// Burden: Dash vigor cost +12% while any effigy stands
	// DeedHint: Sever twenty omokage papers in Ura, and the hand learns how paper is cut
}

OniMeiRubbingSorahi: {
	// DisplayName: Sora-hi
	// Tooltip: One extra dash off the ground and double regen; the first 0.75s after landing gives nothing back
	// Origin: With no ground underfoot, breath floats. Touch down and it sinks away
	/* Power:
		'''
		Air-Groove: natural regen doubles while both feet are off the ground, and you get one extra dash
		An air dash that runs out leaves you hovering at its endpoint for half a second
		''' */
	// Burden: Natural regen drops to zero for 0.75s after you land, and dashing on the ground costs 10% more vigor
	// DeedHint: Stay airborne for fifteen seconds while still cutting, and the groove learns to float
}

OniMeiRubbingKagamihi: {
	// DisplayName: Kagami-hi
	// Tooltip: A dash endpoint stands a paper mirror that copies your next cut; weapon damage -5%
	// Origin: The cut in the mirror lands half a beat late
	/* Power:
		'''
		Mirror-Echo: the endpoint of a Kamui flash step stands a paper mirror for 2s
		The next time you cut, the figure in the mirror repeats that same cut for 45% of a blade hit, then shatters
		''' */
	// Burden: Weapon damage -5%. The copy swings from wherever the mirror stands, so whether it connects is on you
	// DeedHint: Finish a mimic with a Zanshin strike, and the mirror can write it back
}

OniMeiRubbingAmahi: {
	// DisplayName: Ama-hi
	// Tooltip: Sakura Flight drips ink that pools and binds where it lands; Sakura drain +15%
	// Origin: Petals must soak through before water will stay
	/* Power:
		'''
		Ink-Rain: while cruising in Sakura Flight, a bead of ink drops every 0.1s for 12% of a blade hit
		Beads spread into puddles where they land, and foes that step in are bound for half a second
		''' */
	// Burden: Sakura Flight drain +15%. Carrying rain the whole way costs
	// DeedHint: Fly in the rain for ten straight seconds with petals soaked through
}

OniMeiRubbingTsuzurihi: {
	// DisplayName: Tsuzuri-hi
	// Tooltip: Ink brands from one dash cut lines between each other; a lone brand deals -30%
	// Origin: Marks must string together before they become a line
	// Power: Mark-Stitch: ink brands from the same dash all go off together and cut lines between one another, each line for 35% of a blade hit
	// Burden: A lone ink brand deals -30%. Catch only one foe per dash and this groove is a pure loss
	// DeedHint: Pierce six different foes in one dash, and the marks stitch
}

OniMeiRubbingBonsho: {
	// DisplayName: Bonsho
	// Tooltip: Hold full stance without a Finale and the blade tolls itself; half your stance buys a ring of control
	// Origin: The bell does not wait to be struck. When stance is full, it rings itself
	/* Power:
		'''
		Bell-Toll: hold full stance for 3s without releasing Finale Slash and the blade tolls on its own
		Foes within 30 tiles each take 60% of a blade hit and are bound 1.5s, and your stance drops to 50
		''' */
	// Burden: Once the bell rings, that Finale is gone. Full stance forces you to pick one
	// DeedHint: Win a whole boss fight without a single execution, then knock the bell down
}

OniMeiRubbingHannya: {
	// DisplayName: Hannya
	// Tooltip: Drop low and the mask turns demon: heavier hits and lifesteal; frail while it is out, duller before it turns
	// Origin: When the face turns, it is not the same face anymore
	/* Power:
		'''
		Mask-Shift: below 35% of your own life the mask turns demon, blade damage +20%, and every hit restores 0.5% of your max life
		While the demon face is out, every third hit brings up a mask that bites for 50% of a blade hit
		''' */
	// Burden: Damage taken +15% while the demon face is out. In maiden form, weapon damage -4%
	// DeedHint: Slay a boss while you yourself have only a breath left, and the mask can turn
}

OniMeiRubbingKaresansui: {
	// DisplayName: Karesansui
	// Tooltip: Plant your feet to rake a sand garden that stays put, cutting and feeding stance
	// Origin: The rake pattern stays where you made it. Step in, and the blade follows
	/* Power:
		'''
		Sand-Garden: stand nearly still for 1.5s and a sand field about 20 tiles across is raked at your feet, lasting 5s
		The field cuts every half second for 18% of a blade hit
		While you stand inside your own field, stance gain +30%
		''' */
	// Burden: You have to plant first, and moving clears what you have built up
	// DeedHint: Hold one spot for thirty seconds of combat without taking a hit, and the sand can be raked
}

OniMeiRubbingSenju: {
	// DisplayName: Senju
	// Tooltip: Six ghost arms join the Finale Slash freeze; afterwards vigor zeroes and dashing is locked 3s
	// Origin: One hand, one name. Every boss sent off by Finale must be counted
	// Power: Thousand-Arms: during the Finale Slash freeze, six sword-bearing ghost arms rise behind you and cut with it, each for 30% of a blade hit
	// Burden: After the Finale your vigor drops to zero and you cannot flash step for 3s
	// DeedHint: Send off eight different bosses with Finale, one hand for each name
}

OniMeiRubbingKogehi: {
	// DisplayName: Koge-hi
	Tooltip: Los Pasos Relámpago abrasan todo su trayecto; daño de hoja -4%
	// Origin: Do not put your foot in the hot shallows. The groove is for stepping clear
	Power: Rastro Abrasador: Un desplazamiento deja hasta cinco quemaduras repartidas de forma uniforme durante 90 tics, cada impacto inflige un 14 % del daño de hoja base; las quemaduras a menos de 32 px se renuevan
	Burden: Daño de hoja -4 %; compensa la pérdida con el suelo ardiente que deja el movimiento
}

OniMeiRubbingKanhi: {
	// DisplayName: Kan-hi
	Tooltip: Regeneración natural en frío ×2,25; costes de desplazamiento y Sakura +8%
	// Origin: Quiet by the door. Let the ears rest
	Power: Aliento Quieto: Tras 120 tics sin un impacto directo de hoja, la regeneración natural de vigor es ×2,25
	Burden: Costes de vigor del desplazamiento y del crucero Sakura +8 % — la recuperación en calma se paga al moverse
}

OniMeiRubbingTodohi: {
	// DisplayName: Todo-hi
	Tooltip: Los impactos atan durante 36 tics; rearme del desplazamiento +6 tics
	// Origin: A bit sticky. Keep contact to turn; break off and it stalls
	Power: Atadura Pegajosa: Los golpes directos de hoja atan al objetivo durante 36 tics y fijan la movilidad de enemigos normales/jefes en 0,88/0,96
	Burden: Rearme del desplazamiento +6 tics; Atadura y Entumecimiento solo aplican la proporción de movimiento más fuerte
}

OniMeiRubbingShiorihi: {
	// DisplayName: Shiori-hi
	Tooltip: Las bajas podan un objetivo con poca vida; regeneración natural -10 %, Zanshin vacío cuesta vigor
	// Origin: Cut the spent flower to open the edge, not for looks
	Power: Poda de Pétalos: Una baja con golpe directo selecciona otro cuerpo con un 50 % de vida o menos a 240 px, lo rastrea brevemente y lo corta por un 25 % del daño de hoja base; sin objetivo no inicia la recarga de 45 tics
	Burden: Regeneración natural de vigor -10 %; un Zanshin vacío cuesta 2 de vigor. Las hojas de poda no pueden encadenarse
}

OniMeiRubbingShiohi: {
	// DisplayName: Shio-hi
	Tooltip: En marea otorga vigor o daño de Zanshin; los combos fuera de compás pierden algo de filo
	// Origin: Tide marks overnight. Wet contact feeds the return
	Power: Compás de Marea: En un ciclo de 48 tics con una semiventana de 6 tics, un combo en marea restaura +3 de vigor una vez por acción y un Zanshin en marea inflige ×1,08 de daño
	Burden: Daño del combo fuera de marea ×0,97; la fase de marea se fija al comenzar la acción
}

OniMeiRubbingShibori: {
	// DisplayName: Shibori
	Tooltip: Atravesar o recibir contacto comprometido entumece; ganancia de postura -15%
	// Origin: Guard even with numb hands. The blade hurts too
	Power: Contraataque Entumecedor: Una parada al atravesar entumece directamente; el contacto durante una acción comprometida puede gastar 15 de postura para reducir el impacto al 85 % y entumecer (90 tics de recarga). Dura 45 tics, fija la movilidad normal/jefe en 0,90/0,98 y el daño de contacto en ×0,90
	Burden: Ganancia de postura -15%
}

OniMeiRubbingChinmei: {
	// DisplayName: Chinmei
	Tooltip: Daño de proyectiles -12 %, retroceso -65 %; ganancia de postura -15%
	// Origin: When the ears buzz, settle first, then move
	Power: Apaciguar: Daño de proyectiles hostiles ×0,88 y retroceso ×0,35
	Burden: Inactivo en combate puramente cuerpo a cuerpo; ganancia de postura -15%
}

OniMeiRubbingAshidome: {
	// DisplayName: Ashidome
	Tooltip: Mantente firme 45 tics y la siguiente acción comprometida inflige ×1,25 de daño
	// Origin: Stand still. Guard lives where the feet stop
	Power: Paso Plantado: Mantén la velocidad al cuadrado en 2,25 o menos durante 45 tics; el siguiente quinto golpe, Zanshin, Destello Arrasamundos o acción de Final inflige ×1,25 de daño
	Burden: La carga se consume al iniciar la acción, incluso si falla; moverse borra el progreso
}

OniMeiRubbingYoen: {
	// DisplayName: Yoen
	Tooltip: Las ejecuciones trasladan un único campo de brasas; límite de vigor -5%
	// Origin: Oven heat still on the edge. Fire out; burn not gone
	Power: Campo de Brasas: Una ejecución crea o traslada tu único campo de brasas; dura 180 tics y puede infligir al mismo cuerpo un 16 % del daño de hoja base cada 45 tics
	Burden: Límite de vigor -5 %; coste de desplazamiento ×1,10 mientras exista el campo
}

