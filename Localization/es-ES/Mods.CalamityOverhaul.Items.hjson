	// Tooltip: ""
}

ShellRequisitionChip: {
	DisplayName: Chip de requisición de caparazón
	// Tooltip: ""
}

MemoryScorchChip: {
	DisplayName: Chip de ablación de memoria
	// Tooltip: ""
}

BuffSiphonChip: {
	DisplayName: Chip de extracción de beneficios
	// Tooltip: ""
}

CombatSiphonChip: {
	DisplayName: Chip de extracción táctica
	// Tooltip: ""
}

BallisticTurncoatChip: {
	DisplayName: Chip de traición balística
	// Tooltip: ""
}

MeltdownBrandChip: {
	DisplayName: Chip de marca de fusión
	// Tooltip: ""
}

MapBlackoutChip: {
	DisplayName: Chip de apagado del mapa
	// Tooltip: ""
}

ChannelScrambleChip: {
	DisplayName: Chip de interferencia de canal
	// Tooltip: ""
}

StealthStripChip: {
	DisplayName: Chip de despojo de sigilo
	// Tooltip: ""
}

CooldownInjectChip: {
	DisplayName: Chip de inyección de enfriamiento
	// Tooltip: ""
}

CyberwareOfflineChip: {
	DisplayName: Chip de desconexión de ciberimplantes
	// Tooltip: ""
}

Mewtwo: {
	DisplayName: Chip de hipersueño
	Tooltip: Tras usarlo, entras en hipersueño
}

RapidBarrelModule: {
	DisplayName: Cañón de disparo rápido
	Tooltip:
		'''
		El fuego continuo acumula calor en el cañón: cuanto más calor, más cadencia; el haz se pone al rojo blanco y suelta escoria ardiente
		En el instante en que el calor toca la línea roja entra unos segundos en chorro de sobrecalentamiento: cadencia máxima y consumo de maná a cero, vapor a raudales en la boca y alarma continua
		Tras el chorro, enfriamiento forzado y la cadencia cae mucho; al dejar de disparar el calor se disipa con lentitud; gestiona el calor y pisa la línea roja
		'''
}

FocusBarrelModule: {
	DisplayName: Cañón concentrador
	Tooltip: Tres haces rastreadores se fuerzan a uno solo y asestan un golpe concentrado catastrófico
}

PrecisionOpticModule: {
	DisplayName: Mira de precisión
	Tooltip:
		'''
		Sistema de veredicto calibrado: la dispersión baja a cero; los impactos seguidos sin fallar acumulan calibración
		Al completar quince capas dispara solo un rayo de veredicto perforante que critica de forma garantizada; fallar borra la calibración
		'''
}

OverloadCoreModule: {
	DisplayName: Núcleo de sobrecarga
	Tooltip:
		'''
		Quita el seguro de la esfera de energía: tras llenar la carga, seguir cargando entra en sobrecarga santa; el daño puede duplicarse y la explosión se ensancha
		Si cruzas la línea roja y no sueltas, el núcleo estalla en recámara, te empuja y quema la mitad del maná
		'''
}

SteadyStockModule: {
	DisplayName: Culata estabilizadora
	Tooltip:
		'''
		En las pausas de disparo carga un condensador; el anillo sobre tu cabeza muestra la carga en tiempo real; al disparar de nuevo descarga según la carga actual y potencia todos los haces de esa ronda
		A carga máxima añade penetración y vetas de voltaje, pero hay una ventana de estabilidad; si se pasa, se descarga a cero. El mayor beneficio es el disparo a golpes; el fuego continuo casi no carga
		En modo láser, al encender vierte la carga de golpe y obtiene un eco de daño breve
		'''
}

HarmonyGripModule: {
	DisplayName: Empuñadura resonante
	Tooltip:
		'''
		La conducción de bioelectricidad reduce el consumo de maná; al impactar, el maná sobrante se condensa en niebla resonante que se esparce por el campo
		La niebla flota hacia ti; al recogerla devuelve maná y apila capas de armonía que suben la cadencia (hasta cinco)
		'''
}

ResonanceFrameModule: {
	DisplayName: Caja de resonancia
	Tooltip:
		'''
		Metrónomo de onda estacionaria: cuenta los disparos; cada cuarto se eleva a haz de pulso resonante, más grueso, más doloroso y con una capa más de penetración
		Al impactar, el haz de pulso levanta una onda de choque anular a la frecuencia de la onda, inflige daño de área y empuja un poco a los enemigos
		Si mantienes el ritmo y das pulsos seguidos, las capas de ritmo potencian el pulso; si dejas de disparar demasiado, el ritmo vuelve a cero
		En modo láser, la columna se carga de rojo a un ritmo fijo; un impacto en la ventana del pulso levanta la misma onda
		'''
}

AdaptiveOpticModule: {
	DisplayName: Mira adaptativa
	Tooltip:
		'''
		Sistema de control de fuego predictivo: analiza la trayectoria del objetivo y proyecta una retícula holográfica en el punto de intercepción
		El haz se desvía solo para adelantarse; al golpear a un objetivo en movimiento añade un golpe adaptativo
		'''
}

AssaultStockModule: {
	DisplayName: Culata de asalto
	Tooltip:
		'''
		En la culata van dos módulos de apoyo: al empuñar el arma se despliegan en los hombros un par de brazos cañón flotantes
		Los brazos disparan a la vez que tú, alternando dardos de apoyo a alta cadencia
		'''
}

BalancedGripModule: {
	DisplayName: Empuñadura equilibrada
	Tooltip:
		'''
		Protocolo de doble balanza: los impactos de clic izquierdo acumulan Yang; las esferas de clic derecho acumulan Yin
		Cuando ambos se acercan entra en estado de balanza: daño, cadencia y eficiencia de maná suben del todo
		'''
}

CapacitorBankModule: {
	DisplayName: Banco de condensadores
	Tooltip:
		'''
		Al cargar, sobre tu cabeza se encienden una a una seis celdas; cuanto más llena la carga, más se iluminan
		Tras disparar la esfera, el bastidor se queda y descarga celda a celda, disparando arcos de alimentación a la esfera en vuelo
		Cada arco que llega añade daño y radio de explosión; cuanto más lejos vuela, más energía se bombea
		'''
}

CrystalGripModule: {
	DisplayName: Empuñadura de cristal
	Tooltip:
		'''
		El medio de cristal sintético estrangula el maná y sube el crítico; la onda de un crítico se refracta en algo sólido
		Del cuerpo del objetivo brotan esquirlas de prisma que salpican en parábola y las captura la atracción de red de los enemigos cercanos
		'''
}

EfficientGripModule: {
	DisplayName: Empuñadura eficiente
	Tooltip:
		'''
		Protocolo de ciclo sin pérdida: al impactar un haz o un láser, recupera energía según el maná de ese disparo y la condensa en celdas de recuperación que te rodean
		Al juntar ocho celdas, el siguiente clic izquierdo es un disparo sin pérdida: el maná se devuelve entero y todas las celdas se vierten en la boca para potenciar esa salva
		En modo láser, el disparo sin pérdida vierte todas las celdas en el cursor y detona un orbe de energía recuperada
		'''
}

HeavyBarrelModule: {
	DisplayName: Cañón pesado
	Tooltip:
		'''
		El rayado más grueso aplasta la dispersión y el ritmo; cada disparo es un cincel pesado
		Haces y láser que golpean al mismo objetivo dejan una muesca; la cuarta forja un mazo que atraviesa el cuerpo
		El mazo inflige daño extra de crítico garantizado según el cincel más pesado de la ventana y rompe un instante la armadura del objetivo (la rotura solo cuenta para tus impactos)
		'''
}

HighVoltageCoreModule: {
	DisplayName: Núcleo de alto voltaje
	Tooltip:
		'''
		El arma lleva un condensador de alto voltaje: cada impacto lo carga
		Al llenarse, el siguiente impacto te usa como electrodo y suelta un arco perforante que golpea a todos los enemigos de la línea
		'''
}

HoloOpticModule: {
	DisplayName: Mira holográfica
	Tooltip:
		'''
		Proyector de rejilla táctica: en combate despliega periódicamente una rejilla holográfica en el cursor
		Los proyectiles enemigos que la tocan se disuelven; tus haces que la atraviesan se calibran, ganan daño y apuntan al enemigo más cercano
		'''
}

HypersonicBarrelModule: {
	DisplayName: Cañón hipersónico
	Tooltip:
		'''
		El rayado de estampación acelera el haz sin cesar; al romper la barrera del sonido estalla un anillo de onda de choque
		Tras romperla, el haz entra en estado de blanco: más daño, más penetración y una estela de vapor condensado
		'''
}

KineticDamperModule: {
	DisplayName: Culata de amortiguación cinética
	Tooltip:
		'''
		El amortiguador hidráulico guarda el retroceso como reserva cinética; por encima de la mitad, inmunidad al retroceso
		En el instante de recibir daño, toda la reserva se convierte en una onda de contraataque que abre el suelo y aparta a los enemigos cercanos
		'''
}

LightStockModule: {
	DisplayName: Culata ligera
	Tooltip:
		'''
		El diseño segmentado y aligerado sube la cadencia y convierte cada haz principal en una cadena de luz reptante
		Detrás del haz van dos eslabones que recorren su trayectoria y resuelven daño por separado
		'''
}

MultiCellFrameModule: {
	DisplayName: Caja de celdas múltiples
	Tooltip:
		'''
		Protocolo de alimentación matricial: alrededor se despliegan seis celdas; cada ronda de impactos carga una; en modo láser carga más despacio
		Al llenarse las seis, la matriz carga y dispara a la vez seis haces de localización hacia el objetivo; luego se vacían todas y entra un breve enfriamiento
		'''
}

PlasmaInjectorModule: {
	DisplayName: Inyector de plasma
	Tooltip:
		'''
		Inyecta plasma de alta entalpía en la esfera de energía: al detonar, en el centro se condensa un sol residual de plasma
		El sol residual quema sin cesar a los enemigos cercanos y, de forma periódica, escupe lenguas de protuberancia que persiguen al objetivo más cercano
		'''
}

QuantumFrameModule: {
	DisplayName: Caja cuántica
	Tooltip:
		'''
		Protocolo de observación entrelazada: golpear a dos objetivos distintos los entrelaza unos segundos
		Mientras dura, parte del daño que reciba uno se copia al otro; si uno muere, el entrelazamiento colapsa y vierte el daño copiado acumulado en el superviviente
		'''
}

ScattershotBarrelModule: {
	DisplayName: Cañón de perdigones
	Tooltip:
		'''
		La boca rota parte un disparo en varios haces cortos; al primer impacto o al agotarse se rompen en un cono de esquirlas de luz
		Las esquirlas no persiguen y el daño cae en picado con la distancia: a quemarropa puedes clavar el cono entero en el mismo objetivo; a distancia solo rozan
		Al detonar una esfera de energía también lanza una gran perdigonada de esquirlas en la dirección del vuelo
		'''
}

ThermalOpticModule: {
	DisplayName: Mira térmica
	Tooltip: "El impacto deja una marca de calor; en la visión térmica la presa pasa del rojo hierro al blanco; al llenarse la marca se activa el bloqueo de blanco: el haz muerde a ese objetivo, con crítico extra y quemadura continua"
}

VolatileFrameModule: {
	DisplayName: Caja inestable
	Tooltip:
		'''
		El campo de contención de la caja se desestabiliza; cada haz nace con una mutación caótica al azar; la capa de fallo marca la identidad con color:
		Fisión (cian) se parte a mitad en un haz secundario; Sobrecarga (rojo) duplica el daño pero la trayectoria es salvaje; Inestabilidad (naranja) detona al primer impacto; Distorsión (violeta) se dobla hacia el enemigo más cercano
		En modo láser el campo pulsa: el pulso de sobrecarga añade daño de eco; el de inestabilidad acumula detonaciones al impactar
		'''
}

NovaBarrelModule: {
	DisplayName: Cañón nova
	Tooltip:
		'''
		La boca de plasma sobrecargada hace que cada haz detone un microestallido de pulso al impactar
		El precio es menos estabilidad, menos poder por disparo y más consumo de maná
		'''
}

PrismOpticModule: {
	DisplayName: Mira de prisma
	Tooltip:
		'''
		El prisma de fase al final del camino de luz parte dos haces secundarios
		El haz principal vuela un poco menos, pero captura una ventana de crítico precisa
		'''
}

TeslaCoreModule: {
	DisplayName: Núcleo Tesla
	Tooltip:
		'''
		El arco de alto voltaje hace que, tras impactar, el haz salte al enemigo más cercano
		Cada nodo de la cadena hereda el comportamiento del impacto, pero el gasto de maná sube a la vez
		'''
}

RecoilStockModule: {
	DisplayName: Culata de retroceso
	Tooltip:
		'''
		El amortiguador sobrecargado convierte el choque de la explosión de la esfera en energía cinética que te dispara
		El alcance de los haces también se alarga; el precio es un ritmo de gatillo un poco más lento
		'''
}

SwarmGripModule: {
	DisplayName: Empuñadura de enjambre
	Tooltip:
		'''
		La empuñadura de red neural suelta, al explotar la esfera, varias mini esferas de luz de persecución feroz
		La velocidad inicial de la esfera y el gasto de maná pagan el precio
		'''
}

GravityFrameModule: {
	DisplayName: Caja gravitatoria
	Tooltip:
		'''
		El anillo de micro singularidad convierte la esfera en un atractor
		Al cargar, tira sin cesar a los enemigos cercanos hacia el centro; el radio de explosión se agranda mucho
		La cámara precisa hace que el ritmo de carga sea un poco más lento
		'''
}

LaserBarrelModule: {
	DisplayName: Cañón láser de prisma
	Tooltip: El haz convergente se convierte en una columna láser de prisma continua; el precio es un consumo de maná enorme y una potencia limitada
}

OscillatorBarrelModule: {
	DisplayName: Cañón láser oscilante
	Tooltip:
		'''
		La columna de prisma lleva un condensador de pulso: cada 30 fotogramas detona un pulso de energía en el extremo del haz
		El daño por fotograma baja un poco, pero la explosión de área y el menor consumo de maná cubren la debilidad de la irradiación continua
		'''
}

ScorchBarrelModule: {
	DisplayName: Cañón láser abrasador
	Tooltip:
		'''
		La boca de plasma de alta entalpía hace que el láser prenda al objetivo al impactar
		El daño del haz baja un poco, pero la quemadura continua y el menor consumo de maná cubren el hueco de daño directo
		'''
}

ReflectionBarrelModule: {
	DisplayName: Cañón láser de refracción
	Tooltip:
		'''
		El prisma romboidal refracta en el punto de impacto una parte de la energía en dos haces secundarios
		El daño del haz principal sube, pero el consumo de maná es tan alto que irradiar sin parar sale caro
		'''
}

EchoOpticModule: {
	DisplayName: Mira de eco
	Tooltip:
		'''
		El elemento de eco al final del camino captura la onda residual cuando el haz se extingue
		Al extinguirse cada haz suelta tres haces secundarios rastreadores en abanico, que cubren la pérdida de distancia
		'''
}

FrostOpticModule: {
	DisplayName: Mira de escarcha
	Tooltip:
		'''
		El sistema de enfoque refrigerado congela al objetivo en quemadura de escarcha al impactar
		La velocidad del haz baja un poco, pero el rastreo es más estable, con penetración extra y crítico
		'''
}

SingularityCoreModule: {
	DisplayName: Núcleo de singularidad
	Tooltip:
		'''
		El generador de microcampo gravitatorio desvía sin cesar la órbita de la esfera hacia el enemigo más cercano
		El radio de explosión se agranda mucho, pero el campo denso hace que el consumo de maná suba a la vez
		'''
}

ScrambleFieldModule: {
	DisplayName: Núcleo de campo de interferencia
	Tooltip:
		'''
		La bobina de interferencia de alta frecuencia, mientras cargas, dispara cada 40 fotogramas una microonda de choque alrededor de la esfera
		La explosión se agranda; el precio es un ritmo de carga más lento y más maná
		'''
}

BraceStockModule: {
	DisplayName: Culata de soporte
	Tooltip:
		'''
		Tras quedarte quieto en el suelo unos 1 segundo, el trípode hidráulico se despliega solo y te ancla en forma de cañón
		Mientras está desplegado, la dispersión de los haces baja a cero, el alcance y la velocidad de proyectil suben mucho, ganas penetración extra y estabilidad, y +8% de crítico
		Moverte o dejar el suelo recoge el soporte; si lo vuelves a desplegar en 8 segundos, el sistema hidráulico aún está caliente y la preparación se acorta mucho
		Al llevarlo, dispersión -20% y cadencia -5%
		'''
}

LaunchStockModule: {
	DisplayName: Culata de lanzamiento
	Tooltip:
		'''
		El muelle sobrecargado, en el instante de disparar la esfera, suelta además tres haces rastreadores en abanico
		La velocidad de la esfera sube y el consumo de maná también
		'''
}

SentinelGripModule: {
	DisplayName: Empuñadura centinela
	Tooltip:
		'''
		La empuñadura con sensores, mientras vuela la esfera, dispara cada 20 fotogramas un haz rastreador al enemigo más cercano
		La velocidad inicial de la esfera baja y el gasto de maná sube, pero el fuego de acompañamiento continuo cubre la pérdida
		'''
}

ConductorGripModule: {
	DisplayName: Empuñadura conductora
	Tooltip:
		'''
		El material superconductor refuerza el arco en cadena: salta más lejos y más veces
		Cada impacto estalla en partículas de arco; el daño por disparo y el consumo de maná suben un poco
		'''
}

PhantomFrameModule: {
	DisplayName: Caja de fase
	Tooltip:
		'''
		La cámara de fase cuántica teletransporta cada 30 fotogramas el haz en vuelo a 80 píxeles del enemigo más cercano
		Elude del todo los obstáculos; el alcance y el daño del haz suben un poco; el precio es más maná
		'''
}

RecursiveFrameModule: {
	DisplayName: Caja recursiva
	Tooltip:
		'''
		La caja de circuito topológico, al extinguirse cada haz, reenvía una copia desde tu posición en la dirección original
		El daño del haz principal sube pero el alcance se acorta; la copia hace menos daño y ya no se recursa; el consumo de maná sube
		'''
}

ForkBarrelModule: {
	DisplayName: Cañón en horquilla
	Tooltip:
		'''
		El prisma de derivación de la cámara se parte cada 50 fotogramas y lanza un haz hijo a cada lado
		El daño por disparo baja un poco y el consumo de maná sube un poco
		'''
}

NullBarrelModule: {
	DisplayName: Cañón de anulación
	Tooltip:
		'''
		El borrador de datos aplasta el poder por disparo hasta dejarlo mínimo, pero la penetración es, en teoría, infinita
		Al impactar inyecta un flujo de datos venenoso que erosiona al objetivo sin cesar
		'''
}

HelixBarrelModule: {
	DisplayName: Cañón helicoidal
	Tooltip:
		'''
		La cámara de doble canal obliga a dos haces a enroscarse en vuelo alrededor de un eje común
		Precisión a cero de dispersión; el disparo pierde un poco; destaca con penetración múltiple
		'''
}

TargetPainterOpticModule: {
	DisplayName: Mira de bloqueo
	Tooltip:
		'''
		El sistema láser de designación aplica infección corrupta al impactar y recorta mucho la defensa
		El rastreo y el crítico suben a la vez
		'''
}

StrobeOpticModule: {
	DisplayName: Mira estroboscópica
	Tooltip:
		'''
		El modulador de fase de alta frecuencia hace que el haz alterne sin cesar entre atravesar muros y no atravesarlos
		Tiene probabilidad de confundir al objetivo; penetración extra y un poco más de cadencia
		'''
}

SniperOpticModule: {
	DisplayName: Mira de francotirador
	Tooltip:
		'''
		Al dejar de disparar y estabilizar el punto de mira se acumula el bloqueo; la línea de guía se extiende desde la boca
		Tras cargar el bloqueo, el siguiente disparo se eleva a rayo que parte el aire: daño multiplicado, perforación total, impacto instantáneo
		Tras disparar, el bloqueo se borra; agitar el punto de mira pierde progreso; moverte no afecta a la carga
		Suben la velocidad de proyectil y el alcance; el precio es menos cadencia y rastreo a cero
		'''
}

StormCellModule: {
	DisplayName: Célula de tormenta
	Tooltip:
		'''
		Mientras cargas, cada 25 fotogramas dispara un haz rastreador al enemigo más cercano
		El consumo de maná sube, pero cargas más rápido y el radio de explosión se agranda
		'''
}

CryoCoreModule: {
	DisplayName: Núcleo criogénico
	Tooltip:
		'''
		La cámara de ultrafrío, al explotar la esfera, congela a todos los enemigos del área
		El radio de explosión se agranda; el ritmo de carga es un poco más lento
		'''
}

DarkMatterCoreModule: {
	DisplayName: Núcleo de materia oscura
	Tooltip:
		'''
		El campo de materia oscura, mientras vuela la esfera, tira sin cesar a los enemigos cercanos hacia el centro
		La esfera persigue a la vez y el radio de explosión se agranda mucho; el consumo de maná sube
		'''
}

ErgonomicStockModule: {
	DisplayName: Culata ergonómica
	Tooltip:
		'''
		La culata recuerda tu mano: al atacar sin cesar al mismo objetivo (o en una dirección parecida) acumulas pericia de «memoria muscular»
		La pericia desbloquea beneficios por tramos: la dispersión se cierra → sube la cadencia → a pericia máxima entra «hombre y arma, uno»
		En ese estado, golpear al objetivo recordado devuelve un poco de maná, el haz gana una corrección de precisión y ambos dejan un rastro rítmico
		Cambiar de objetivo o dejar de disparar mucho tiempo hace que la memoria se disipe enseguida
		'''
}

ExtenderStockModule: {
	DisplayName: Culata extensible
	Tooltip:
		'''
		El raíl alargado extiende el alcance y la velocidad de los haces
		Corte terminal: cuando el haz vuela una distancia, despliega in situ la energía restante en una hoja de luz perpendicular a la trayectoria que barre en abanico y remata
		Un haz que se extingue al agotar la penetración deja una hoja reducida según la distancia ya volada; si se extingue a quemarropa, no se activa
		En modo láser, tras irradiar un momento, suelta el ataque y corta en cruz en el punto de la columna que señala el cursor
		'''
}

StormStockModule: {
	DisplayName: Culata de tormenta
	Tooltip:
		'''
		El fuego continuo acumula a tu alrededor un campo de tormenta anular que se disipa al dejar de disparar
		Los proyectiles enemigos del campo los desvía el ciclón y te rodean sin darte
		Cuando el medidor de tormenta se llena, un rayo cae desde lo alto del dominio sobre los enemigos del campo
		'''
}

VampireGripModule: {
	DisplayName: Empuñadura de sangre enroscada
	Tooltip:
		'''
		La empuñadura de bioelectricidad devuelve una parte del daño del haz como vida
		El láser impacta más a menudo, pero cada recuperación es menor; en combates largos da aguante
		'''
}

ChronalGripModule: {
	DisplayName: Empuñadura de fase temporal
	Tooltip:
		'''
		La bobina de retraso de fase deja al objetivo ralentizado al impactar
		Con el rastreo extra, un fuego denso forma un control continuo
		'''
}

CascadeGripModule: {
	DisplayName: Empuñadura en cascada
	Tooltip:
		'''
		Tras 5 impactos acumulados, en el punto de impacto nace un nodo de cascada suspendido
		El nodo dura unos 2 segundos, caza solo a los enemigos cercanos y dispara haces rastreadores
		El disparo pierde un poco
		'''
}

MirrorFrameModule: {
	DisplayName: Caja espejo
	Tooltip:
		'''
		La cámara de reflexión simétrica, al nacer cada haz, parte un espejo simétrico a 180°
		El espejo hace menos daño; la cobertura en ambos sentidos densifica mucho el fuego
		'''
}

NullspaceFrameModule: {
	DisplayName: Caja del Vacío
	Tooltip:
		'''
		El generador de fisuras del Vacío deja cada 20 fotogramas un eco explosivo en miniatura en la trayectoria del haz
		El alcance se alarga un poco; la pérdida por disparo es mínima
		'''
}

OverkillFrameModule: {
	DisplayName: Caja de exceso
	Tooltip:
		'''
		El circuito de exceso hace que cada muerte apile una capa de oleada de matanza (hasta 15); cada capa +2% de daño
		Las capas se desvanecen con el tiempo; cuanto más rápido el ritmo, más fuerte
		'''
}

GraviticBarrelModule: {
	DisplayName: Cañón gravitatorio
	Tooltip:
		'''
		La recámara con una micro singularidad hace que el haz atraiga sin cesar a los enemigos cercanos al volar
		La dispersión y el rastreo bajan un poco; el haz vuela más lejos y un poco más despacio
		'''
}

PrismaticBarrelModule: {
	DisplayName: Cañón prismático
	Tooltip:
		'''
		El prisma de dispersión hace que cada haz suelte una estela de color al volar y, al impactar, esquirlas de luz de color
		Dispara un haz extra y compensa el crítico; el poder por disparo baja un poco y la dispersión sube un poco
		'''
}

ConcussionBarrelModule: {
	DisplayName: Boca de concusión
	Tooltip:
		'''
		La cámara de amortiguación sobrecargada, cada 5 impactos acumulados, detona un anillo de concusión en miniatura en el punto de impacto
		El poder por disparo sube y la dispersión se cierra, pero el precio de cadencia es alto
		'''
}

ObsidianBarrelModule: {
	DisplayName: Cañón de obsidiana
	Tooltip:
		'''
		El impacto graba grietas de obsidiana en el cuerpo del objetivo; al llenarse se parten en vidrio volcánico que caza
		La explosión de la esfera de clic derecho detona antes las grietas cercanas; sirve para segar grupos irradiados sin parar
		'''
}

LifebloomBarrelModule: {
	DisplayName: Cañón de hoja vital
	Tooltip:
		'''
		El haz siembra un brote vital parásito que, con retraso, extrae vida del objetivo y devuelve un poco al usuario
		Al morir el huésped, el brote salta a un enemigo cercano y sigue creciendo
		'''
}

MagmaVentBarrelModule: {
	DisplayName: Cañón de magma
	Tooltip:
		'''
		En el impacto y al extinguirse el haz queda una boca de lava de corta vida que, de forma periódica, escupe una columna de calor vertical
		En el Inframundo o en líquidos de alto calor el ritmo se acelera; sirve para bloquear zonas
		'''
}

CumulusBarrelModule: {
	DisplayName: Cañón de cúmulo
	Tooltip:
		'''
		En la trayectoria del haz se condensan núcleos de nube recargables; los haces y esferas posteriores del SHPC los cargan al pasar
		Al llenarse, el núcleo deja caer tres haces de tormenta de corto alcance; sirve para tender fuego de posición
		'''
}

MossboundBarrelModule: {
	DisplayName: Cañón de musgo
	Tooltip:
		'''
		El haz tiende zonas de musgo húmedo; los enemigos que entran se ralentizan y se enredan poco a poco
		La esfera de clic derecho, al pasar, absorbe las marcas de musgo y agranda el radio de la explosión final
		'''
}

FrostfernBarrelModule: {
	DisplayName: Cañón de helecho de escarcha
	Tooltip:
		'''
		El primer impacto extrae detrás del objetivo una red de cristal de hielo y hace que los enemigos sufran escarcha a la vez
		Encadena al grupo en una rama de helecho de escarcha que se extiende
		'''
}

SandstormBarrelModule: {
	DisplayName: Cañón de tormenta de arena
	Tooltip:
		'''
		El fuego continuo levanta delante una cortina de arena móvil que erosiona a los enemigos y debilita los proyectiles enemigos que la cruzan
		El haz gana penetración extra, pero el consumo de maná sube mientras se mantiene la cortina
		'''
}

CoralReefBarrelModule: {
	DisplayName: Cañón de coral
	Tooltip:
		'''
		En el punto de impacto crece un ancla de coral; entre varias anclas se tienden líneas de arrecife que cortan a los enemigos
		La explosión de la esfera de clic derecho hace que las anclas cercanas suelten a la vez una oleada anular
		'''
}

HiveBarrelModule: {
	DisplayName: Cañón de colmena
	Tooltip:
		'''
		Clic izquierdo marca a los enemigos con feromona; la explosión de clic derecho envía un enjambre cibernético que se lanza en picado contra los marcados
		Cuanto más repartidas las marcas, más estable la cobertura: ritmo de tender con la izquierda y recoger con la derecha
		'''
}

MoondewBarrelModule: {
	DisplayName: Cañón de rocío lunar
	Tooltip:
		'''
		El haz condensa prismas de rocío en el camino; los haces posteriores que los tocan se refractan en haces derivados de corto alcance
		De noche y cerca de la luna llena suben el tope de refracción y la duración del rocío
		'''
}

CrosslinkOpticModule: {
	DisplayName: Mira de enlace
	Tooltip:
		'''
		El módulo de enlace neural, al impactar, tiende un arco de datos entre el objetivo y el enemigo más cercano
		Suben a la vez los saltos de cadena y el radio de salto; el consumo de maná sube un poco
		'''
}

ZoomOpticModule: {
	DisplayName: Mira de distancia focal
	Tooltip:
		'''
		La lente magnética de teleobjetivo hace que el haz vuele más lejos y más rápido, a costa de cadencia y rastreo
		Si la distancia de impacto es ≥ 600 píxeles, añade un golpe extra de blanco; cuanto más lejos, mayor la bonificación
		'''
}

PingOpticModule: {
	DisplayName: Mira de marcado
	Tooltip: El sistema de señal, al impactar, aplica marca de muerte al objetivo y otorga cierta probabilidad de crítico
}

CapacitorPulseModule: {
	DisplayName: Condensador de pulso
	Tooltip:
		'''
		La pila de condensadores de alta densidad, mientras cargas, suelta en la esfera un microestallido de pulso cada medio segundo aproximadamente
		El radio de explosión sube con el tiempo de carga; el consumo de maná se agrava
		'''
}

EntropyCoreModule: {
	DisplayName: Núcleo de entropía
	Tooltip:
		'''
		La esfera, al volar, absorbe sin cesar «carga de entropía» de los enemigos cercanos
		Al detonar, suelta una explosión residual extra según lo acumulado; cuanto más denso el grupo, más fuerte la onda
		'''
}

ResonanceReactorModule: {
	DisplayName: Reactor de resonancia
	Tooltip:
		'''
		Mientras cargas suelta sin cesar anillos de partículas resonantes
		Al detonar, a tus pies se dispara un impacto de resonancia extra que cubre el cuerpo a cuerpo
		'''
}

OverwatchStockModule: {
	DisplayName: Culata de vigía
	Tooltip:
		'''
		Al quedarte quieto acumulas capas de «vigía» (hasta 5); al moverte se desvanecen enseguida
		Cada capa +3% de daño y +2% de crítico; la dispersión y la cadencia bajan un poco por la postura firme
		'''
}

MomentumStockModule: {
	DisplayName: Culata de momento
	Tooltip:
		'''
		Al moverte a gran velocidad acumulas capas de «cinética» (hasta 6); al parar se desvanecen enseguida
		Cada capa +4% de cadencia y +6% de velocidad de proyectil; es el espejo de la culata de vigía
		'''
}

BulwarkStockModule: {
	DisplayName: Culata de baluarte
	Tooltip:
		'''
		Al empuñar el SHPC otorga al jugador un poco de reducción de daño
		La postura firme ralentiza un poco la carga y reduce el consumo de maná
		'''
}

CombatGripModule: {
	DisplayName: Empuñadura de combate
	Tooltip:
		'''
		Al impactar y matar acumulas «ímpetu de guerra» (hasta 5 capas)
		Cada capa +4% de cadencia y +2% de daño; las capas se desvanecen con el tiempo si no hay muertes
		'''
}

TempestGripModule: {
	DisplayName: Empuñadura de tempestad
	Tooltip:
		'''
		Cada cierto número de impactos dispara una «ráfaga de tempestad» que lanza varios arcos alrededor del último punto de impacto
		El poder por disparo baja un poco y el consumo de maná sube, pero limpia el campo con ritmo
		'''
}

AbsorberGripModule: {
	DisplayName: Empuñadura absorbente
	Tooltip:
		'''
		Al impactar un haz o un láser, devuelve un poco de maná según el daño; se abastece en ciclo
		El poder por disparo baja un poco y el consumo original de maná sube como precio
		'''
}

HarmonicFrameModule: {
	DisplayName: Caja armónica
	Tooltip:
		'''
		Cuando hay varios haces a la vez, tienden arcos de resonancia entre sí e infligen daño extra
		Dispara un haz extra; el poder por disparo baja un poco y la dispersión sube un poco
		'''
}

ReplicatorFrameModule: {
	DisplayName: Caja de réplica de datos
	Tooltip:
		'''
		Al extinguirse un haz rastreador, en el lugar nace una copia de eco de vida muy corta que sigue en la dirección original
		El daño del haz principal sube pero su vida se acorta; el consumo de maná se agrava
		'''
}

ArchiveFrameModule: {
	DisplayName: Caja de archivo
	Tooltip:
		'''
		Acumula sin cesar el daño de los impactos del SHPC; cada vez que llega al umbral, en tu posición suelta una explosión de «archivo de datos»
		El daño por disparo sube; el consumo de maná se eleva un poco
		'''
}

CWRItem: {
	TemperatureText: Temperatura de combustión
	InternalStoredEnergy: Energía almacenada
	BrutalWorldItemText: Exclusivo del Mundo Cruel
	BrutalRelicSeriesText: Reliquia cruel · exclusivo del Mundo Cruel
	LegendItemUpgradeDisable:
		'''
		Esta arma legendaria está configurada para no poder mejorarse en el mundo actual
		Si quieres quitar el bloqueo, vuelve a entrar en el mundo
		'''
	ItemLegendOnMouseLang: Pulsa 'Mayús' para oír la historia...

	CWRItem: {
		TemperatureText: Temperatura de combustión
		InternalStoredEnergy: Energía almacenada
		BrutalWorldItemText: Exclusivo del Mundo Cruel
		BrutalRelicSeriesText: Reliquia cruel · exclusivo del Mundo Cruel
		LegendItemUpgradeDisable:
			'''
			Esta arma legendaria está configurada para no poder mejorarse en el mundo actual
			Si quieres quitar el bloqueo, vuelve a entrar en el mundo
			'''
		ItemLegendOnMouseLang: Pulsa 'Mayús' para oír la historia...
	}
}

RMagicConch: {
	DontUseMagicConch: Una criatura poderosa te tiene en la mira...

	RMagicConch: {
		DontUseMagicConch: Una criatura poderosa te tiene en la mira...
		DisplayName: Caracola mágica
		Tooltip: Escucha con atención y oirás el sonido del océano
	}
}

GraniteTome: {
	DisplayName: Tomo de granito
	Tooltip:
		'''
		El canto reúne tres puntos de carga; al llenarse dispara en abanico tres esferas de energía de granito de rastreo ligero
		Al impactar, las esferas se rompen en fragmentos de cristal que persiguen
		'''
}

GraniteFlower: {
	DisplayName: Flor de granito
	Tooltip:
		'''
		Lanza una semilla de cristal que, al caer, florece en una flor de energía fija
		La flor pulsa tres veces y dispara pétalos de cristal al enemigo más cercano
		Al marchitarse, los pétalos se rompen del todo y salpican esquirlas a su alrededor
		'''
}

GraniteThrowingKnife: {
	DisplayName: Cuchillo arrojadizo de granito
	Tooltip:
		'''
		Lanza un cuchillo perforante que arrastra un arco eléctrico azul verdoso
		Al golpear a un enemigo, salta un microarco a otro enemigo cercano
		Al final del vuelo o al chocar con el terreno se rompe en fragmentos de cristal
		'''
}

GraniteWalkingBoots: {
	DisplayName: Botas de marcha de granito
	Tooltip:
		'''
		Aumentan mucho la velocidad de carrera y la aceleración
		En el instante de alcanzar la velocidad máxima, la suela se electrifica y suelta arcos
		Al correr a tope, el suelo echa chispas y a tu espalda queda un rastro azul verdoso
		'''
}

MarbleClub: {
	DisplayName: Maza de mármol
	Tooltip:
		'''
		Un mazazo lento y pesado de arriba abajo, con retroceso enorme
		El impacto petrifica un instante al enemigo y lo deja rígido como fósil
		Si golpea el suelo, levanta una onda de mármol a pleno poder y una ola de polvo
		Si golpeas en el aire, solo queda una sacudida de aire debilitada
		'''
}

MarbleHuntingKnife: {
	DisplayName: Cuchillo de caza de mármol
	Tooltip:
		'''
		Tajos cruzados y rápidos
		Cada tercer golpe se convierte en un tajo final más ancho, da un paso de embestida y dispara fragmentos de mármol
		'''
}

MarbleDisc: {
	DisplayName: Disco de mármol
	Tooltip:
		'''
		Lanza un disco giratorio que rebota entre enemigos y muros
		Cada rebote a un objetivo nuevo dora más el disco y sube un 10% el daño, hasta un 30%
		Al agotar los rebotes vuelve a la mano; pueden existir dos a la vez
		'''
}

MarblePebble: {
	DisplayName: Guijarro de mármol
	Tooltip:
		'''
		Piedra rápida de uso infinito; al chocar con el suelo rebota una vez
		Inflige más daño extra cuanto más alta es la vida máxima del enemigo
		Al golpear a un coloso, estalla en luz dorada y suena a roca partida
		'''
}

MarbleShield: {
	DisplayName: Escudo de mármol
	Tooltip:
		'''
		Aumenta el retroceso cuerpo a cuerpo
		Tres fragmentos de mármol orbitantes forman un escudo de guardia de piedra; cuando está listo absorbe un golpe y se rompe
		Pulsa [KEY] para alzar el escudo y bloquear: un bloqueo perfecto anula el daño, rompe los proyectiles cercanos y lanza de vuelta hojas de piedra
		Tras un bloqueo perfecto, el daño cuerpo a cuerpo sube un 10% durante 5 segundos
		'''
}

MarbleBalloon: {
	DisplayName: Globo de mármol
	Tooltip:
		'''
		En el aire, pulsa ↓ para estrellarte contra el suelo; cuanto más tiempo acumules en la caída, más fuerte y más ancha es la onda al aterrizar
		Inmunidad al daño por caída
		'''
}

MarbleinaBottle: {
	DisplayName: Mármol en una botella
	Tooltip: Otorga un segundo salto extra, pesado y potente; mantén pulsado el salto para subir más
}

MarbleCloudBalloon: {
	DisplayName: Globo de nube de mármol
	Tooltip:
		'''
		Otorga un segundo salto extra, pesado y potente; mantén pulsado el salto para subir más
		En el aire, pulsa ↓ para estrellarte contra el suelo; cuanto más tiempo acumules en la caída, más fuerte y más ancha es la onda al aterrizar
		Inmunidad al daño por caída
		'''
}

TestItem: {
	// DisplayName: Test Item
	// Tooltip: ""
}

OniMeiRubbingHigekiri: {
	DisplayName: Corte de barba
	Tooltip: Cuanto más herido está el enemigo, más duro corta este tajo; rematarlo con tu mano devuelve postura; daño base -2%
	Origin: La noche en que el linaje Minamoto probó el filo, este cuchillo cortó de un tajo la cabeza y la barba del mentón; el pelo se quedó pegado al filo. El viejo nombre Corte de barba nació esa noche
	Power:
		'''
		«Decapitar» Cuando el filo golpea en persona a un enemigo con menos del 35% de vida, empieza a sumar daño; cuanto más fina la vida, más suma
		En enemigos normales, hasta +60%; en jefes, hasta +45%
		Rematarlo con tu mano devuelve 8 de postura; el mismo golpe solo la devuelve una vez
		'''
	Burden: Daño base -2%. Mientras el enemigo aún tiene mucha vida, este cuchillo es un poco más romo que la inscripción original
}

OniKeikoRune: {
	DisplayName: Talismán de keiko
	Tooltip:
		'''
		Úsalo para empezar de cero la lección de Onikiri; si lo usas otra vez a mitad de la lección, la recoge
		Es el vale que queda al rechazar la lección inicial; el talismán no se consume y puedes abrirla una y otra vez
		'''
	NeedBlade: No hay un Onikiri en el zurrón; el talismán no puede abrir la lección
	Closed: La lección se ha recogido; usa de nuevo el talismán para reabrirla
	NotNow: Ahora hay otro asunto; el talismán no puede sostener el escenario
}

OniMeiRubbingOnikiri: {
	DisplayName: Onikiri
	Tooltip: Inscripción original. No añade efecto ni cobra precio
	Origin: Watanabe no Tsuna lo llevó al puente de Ichijō-Modoribashi y cortó de un tajo el brazo de un oni; el demonio huyó y no volvió a reclamarlo. El cuchillo que había cortado a un oni se llamó Onikiri desde entonces, y el nombre se quedó clavado en la espiga
	Power: "Inscripción original. Todo lo que este cuchillo ya tiene se queda tal cual: ni un ápice de más, ni un ápice de menos"
	Burden: Ninguno
}

OniMeiRubbingShishinoko: {
	DisplayName: Hijo del león
	Tooltip: El combo de cinco tiempos no se interrumpe; el quinto suelta dos ondas de filo cruzadas; intervalo entre tajos +2%
	Origin: Una noche lo dejaron junto a la almohada del amo y, a medianoche, rugió solo, como un león; lo oyó toda la casa. El amo lo rebautizó Hijo del león y incrustó el nombre en oro en la espiga, para premiar aquel grito
	Power:
		'''
		«Ímpetu de león» Si el combo de cinco tiempos se completa sin que un Paso relámpago o un gran golpe lo corte, el quinto tiempo cierra las fauces del león
		Suelta dos ondas de filo cruzadas; cada una inflige el 22% de un tajo
		'''
	Burden: Intervalo entre tajos del combo +2%. El rugido hay que acumularlo, así que el cuchillo va un poco más despacio
}

OniMeiRubbingTomokiri: {
	DisplayName: Corte al amigo
	Tooltip: Si el Paso relámpago corta el combo, deja in situ una sombra de culpa que remata; al empuñarlo, daño recibido +6%
	Origin: "Dos tesoros Minamoto se probaron filo con filo; este cortó al amigo de en frente por la cintura. Aquella falta se cinceló en el nombre: Corte al amigo, el cuchillo que cortó a un amigo, y el carácter se volvió feroz"
	Power:
		'''
		«Sombra de culpa» Si cortas el combo con el Paso relámpago Kamui, el tajo interrumpido se queda in situ
		Luego muerde solo; el daño es el 35% de un tajo
		'''
	Burden:
		'''
		Mientras empuñas este cuchillo, el daño que recibes +6%
		Cada sombra de culpa apila una capa de «Culpa», hasta tres; cada capa hace que el siguiente Paso relámpago gaste 4 de vigor extra
		Si el tajo de Zanshin tras el Paso relámpago impacta, la culpa se salda de una vez
		'''
}

OniMeiRubbingKazehi: {
	DisplayName: Conducto del viento
	Tooltip: El Paso relámpago ahorra un 15% de vigor y el vuelo de sakura un 20%; daño de las marcas de tinta -20%
	Origin: "Quien abrió el filo hizo este conducto recto y largo, «para dejarle camino al viento». Al blandir el cuchillo, el viento llega primero: cuando oyes el silbido, el filo ya ha vuelto"
	Power: «Viento a favor» Gasto de vigor del Paso relámpago Kamui -15%; gasto del vuelo de sakura -20%
	Burden: Daño de las marcas de tinta que deja el Paso relámpago -20%. Este conducto se abrió para aligerar el cuerpo, no para matar
}

OniMeiRubbingChihi: {
	DisplayName: Conducto de sangre
	Tooltip: Golpear devuelve vigor; cuanto más cortes, más vigor; recuperación natural de vigor -35%
	Origin: "Los demás conductos se abren para aligerar la hoja; este no. Quien entregó el filo lo dijo claro: esta ranura es para la sangre; si la sangre corre rápido, tu aliento vuelve rápido"
	Power:
		'''
		«Reflujo» El primer impacto de cada tiempo del combo devuelve 1 de vigor extra
		Cada impacto del tajo de Zanshin tras el Paso relámpago devuelve 4 extra
		'''
	Burden: Recuperación natural de vigor -35%; tras atacar hay que esperar 0.3 segundos más para empezar a recuperar. Si el cuchillo no toca sangre, el vigor cuesta volver
}

OniMeiRubbingFudo: {
	DisplayName: Inmóvil
	Tooltip: Si te golpean durante la animación de un gran golpe, gastas postura a cambio de reducción de daño; ganancia de postura -15%
	Origin: "El tallista cinceló al trazo del sánscrito kāṃ y sentó a Fudō Myōō, cubierto de llamas, en el costado del filo. Este santo solo gobierna una palabra: firmeza. Golpee lo que golpee, se queda sentado"
	Power:
		'''
		«Guarda inmóvil» Si te alcanzan durante la animación de un tajo que no puedes recoger —Zanshin, Destello aniquilador, Danza final—, Fudō te cubre
		Gasta 20 de postura; ese golpe deja solo el 65% del daño y el 25% del retroceso; tras bloquear, 2.5 segundos de descanso
		'''
	Burden: Ganancia habitual de postura -15%; la fuerza de la guarda se resta de lo acumulado. El contragolpe de Desmembrar no entra en la protección
}

OniMeiRubbingKurikara: {
	DisplayName: Kurikara
	Tooltip: Tras una ejecución acumulas tres capas de fuego de dragón; cada combo de cinco completo quema una; tope de vigor -10%
	Origin: "En la hoja está tallado el rey dragón Kurikara: un dragón negro se enrosca en la espada y abre la boca para tragar el filo. Es un tema viejo de la talla de cuchillos; entre las escamas hay oro incrustado"
	Power:
		'''
		«Anillo de fuego de dragón» Tras una ejecución, la hoja enciende tres capas de fuego de dragón, válidas diez segundos
		Cada vez que completas un combo de cinco, el quinto tiempo quema una capa y suelta un tajo anular; el daño es el 50% de un tajo
		'''
	Burden: Tope de vigor -10%. En el tramo donde se enrosca el dragón, el vigor pasa más estrecho
}

OniMeiRubbingTessetsu: {
	DisplayName: Corte de hierro
	Tooltip: Al cortar acero y máquinas, el primer tajo de cada tiempo +25%; daño base -10%
	Origin: "Alguien lo probó y torció la boca: el nombre asusta, el filo parece un trozo de hierro crudo. El herrero no se enfadó y cinceló aquella pulla tal cual en la espiga: hierro crudo será, pero hierro contra hierro es donde se ve la verdad"
	Power: «Cortar metal» El primer tajo de cada tiempo del combo, si cae sobre enemigos de acero o máquina que echan chispas, +25% de daño
	Burden: Daño base -10%. Contra carne, se parece más a un trozo de hierro romo
}

OniMeiRubbingKyushu: {
	DisplayName: Cabeza antigua
	Tooltip: Solo cobra cabezas; las de poca vida las cobra más duro que Corte de barba; daño base -3%
	Origin: "Hay cuchillos que, al cortar una buena cabeza, cambian de nombre y brillan una vez. El dueño de esta inscripción no iba de eso: las cabezas se cortan, el nombre se queda; un cuchillo que corta limpio no asusta con nombres nuevos"
	Power:
		'''
		«Tomar la cabeza» Esta bonificación solo reconoce la cabeza, o a los enemigos que no tienen segmentos
		Cuando su vida baja del 35%, tus tajos empiezan a sumar; cuanto más fina, más suman
		En enemigos normales, hasta +85%; en jefes, hasta +60%
		'''
	Burden: Daño base -3%. El tronco, la cola y el resto de segmentos no cuentan como tomar la cabeza
}

OniMeiRubbingIkiai: {
	DisplayName: Unión del aliento
	Tooltip: El quinto tiempo de un combo de cinco completo lanza una onda de espada hacia el cursor; intervalo entre tajos +4%
	Origin: "Decía el viejo espadachín que, si el forcejeo se alarga, las respiraciones de ambos se muerden; quien cierra primero ese aliento, su cuchillo llega primero. Esta inscripción talla ese arte: aguantar, coincidir, dejar caer el filo"
	Power: «Aliento» Al completar un combo de cinco, el quinto tiempo lanza en la dirección a la que apuntas una onda de espada en arco; el daño es el 55% de un tajo y se disipa tras cortar como máximo a tres enemigos
	Burden: Intervalo entre tajos del combo +4%
}

OniMeiRubbingKyoko: {
	DisplayName: Rugido hueco
	Tooltip: A distancia acumula un tajo; al volverte y cortar a quemarropa duele más; si cortas pegado sin parar, pierdes el foco
	Origin: "El que probaba el filo rugió hacia un valle vacío y no hubo eco: cuando no hay nadie, ese aliento vuelve entero al cuchillo. Esta talla guarda precisamente esa contención"
	Power:
		'''
		«Eco vacío» Si en 16 bloques a tu alrededor no hay enemigos durante 1.5 segundos, el cuchillo te guarda un golpe
		El primer tajo que aciertes dentro de 16 bloques, +25% de daño; si aciertas más lejos, no lo gasta y se queda
		El cuchillo, en reposo, suena solo: si 1.5 segundos no golpeas a nadie o no hay enemigos cerca, cada 1.5 segundos ralentiza 0.4 segundos a los enemigos en 20 bloques
		'''
	Burden: Si en 0.6 segundos das cuatro tajos a quemarropa, pierdes el foco 0.4 segundos; en ese rato el daño a quemarropa -5%
}

OniMeiRubbingKarikiri: {
	DisplayName: Corte falso
	Tooltip: El Paso relámpago deja una sombra que recibe un golpe por ti; tras usarla hay que esperar 4 segundos
	Origin: "El aprendiz copió la postura del maestro al diez por diez; el maestro solo dijo: demasiado parecido, tan parecido que se ve falso. Esta inscripción talla precisamente ese cuerpo falso: por muy bien que se plante, solo es la sombra que recibe el tajo por ti"
	Power:
		'''
		«Cuerpo falso» Al arrancar el Paso relámpago Kamui, deja in situ una sombra congelada en la postura, 1.5 segundos
		En ese rato, cualquier enemigo o proyectil que llegue, la sombra lo bloquea del todo una vez
		Tras bloquear hay que esperar 4 segundos para dejar otra
		'''
	Burden:
		'''
		Mientras la sombra está en el campo, el daño que recibes y el gasto de vigor del Paso relámpago +12%
		Durante 1 segundo tras romperse la sombra, el daño recibido +18%
		Si la sombra se disipa al cumplir el tiempo, no cuenta como rota
		'''
}

OniMeiRubbingMokukiri: {
	DisplayName: Corte silencioso
	Tooltip: Tras un Paso relámpago normal que gasta vigor, el siguiente tajo +35%; fallar también lo gasta
	Origin: "En el instante en que termina el Paso relámpago, el entorno se calla de golpe. Los viejos espadachines saben que el siguiente tajo, en ese silencio, es el más pesado. El nombre es la cosa: cortar en silencio"
	Power: «Muerte silenciosa» Tras completar de forma natural un Paso relámpago normal que gasta vigor, durante 0.75 segundos el siguiente tajo de combo o de Zanshin +35% de daño
	Burden: Si ese tajo falla, también se gasta; otro Paso relámpago a mitad también lo borra. El Paso relámpago de ejecución gratuito no da Muerte silenciosa
}

OniMeiRubbingKumokiri: {
	DisplayName: Corte a la araña
	Tooltip: Tres tajos clavan una red; al recogerla corta a todos los que están dentro; con anclas colgando, recuperación de vigor -25%
	Origin: Minamoto no Yorimitsu yacía enfermo; la araña de tierra se disfrazó de monje y tendió hilos para atarlo. Él tomó el cuchillo, cortó los hilos y hirió a la araña; al día siguiente siguió el rastro de sangre y arrasó el nido. Desde entonces el cuchillo se llama Corte a la araña
	Power:
		'''
		«Hilo de tinta» Cuando el filo golpea en persona, clava un ancla de hilo en el punto del tajo, 4 segundos
		Las anclas deben ir separadas: el mismo enemigo no recibe una segunda en 0.4 segundos, y entre dos anclas debe haber unos seis bloques
		Al clavar tres se forma un triángulo de hilo de tinta; tras un instante se recoge hacia el centro; los enemigos barridos reciben cada uno el 90% de un tajo y quedan atados 1 segundo
		Tras recoger la red, 1.5 segundos de descanso antes de tejer otra
		'''
	Burden: Mientras hay anclas en el campo, la recuperación natural de vigor -25%. Si el ancla caduca, ese tajo se da por perdido
	DeedHint: "Mata treinta criaturas arácnidas: arañas, trepadores de sangre, escorpiones de arena y todo lo que tenga ocho patas y suba por las paredes. Al cumplir el cupo, el cuchillo reconoce ese olor a sangre"
}

OniMeiRubbingOnimaru: {
	DisplayName: Onimaru
	Tooltip: Quédate quieto y el cuchillo vuela solo a cortar; mientras está fuera, no lo tienes en la mano
	Origin: Onimaru Kunitsuna, una de las Cinco Espadas del Cielo. Al amo lo atormentaban cada noche oni pequeños en sueños; una noche este cuchillo se cayó solo del estante y cortó la cabeza de oni tallada en la pata del brasero; la pesadilla se cortó de raíz. El hombre no se mueve; él sí
	Power:
		'''
		«Tajo autónomo» Si te quedas quieto 1 segundo, el cuchillo entra en espera
		Después, cada 1.5 segundos te resta 10 de vigor, vuela solo hacia un enemigo en 40 bloques, corta el 140% de un tajo y vuelve a la vaina
		'''
	Burden: "Todo el tiempo que el cuchillo está fuera no está en tu mano: combo, Paso relámpago y vuelo de sakura no se pueden usar. Si no hay objetivo cerca, no vuela"
	DeedHint: Empuña el cuchillo y quédate quieto diez segundos; aunque te golpeen, no des un paso. Si te aguantas, el cuchillo se mueve una vez por ti
}

OniMeiRubbingRaikiri: {
	DisplayName: Corte del rayo
	Tooltip: El quinto tiempo y los grandes golpes, al aire libre, llaman un rayo que atraviesa al enemigo; intervalo entre tajos +6%; en cuevas no cae
	Origin: Tachibana Dōsetsu se resguardaba de la lluvia bajo un árbol; un rayo le cayó encima, él desenvainó y cortó de vuelta, y siguió vivo. Desde entonces el cuchillo se llama Corte del rayo
	Power:
		'''
		«Cortar el rayo» Cuando el quinto tiempo, el Zanshin, el Destello aniquilador o la Danza final golpea a un enemigo, si ves el cielo sobre tu cabeza, cae una columna de rayo desde el cénit
		El daño de la columna es el 70% de un tajo; en una tormenta, el mismo golpe puede soltar hasta tres
		'''
	Burden: "Intervalo entre tajos del combo +6%; también en día despejado va lento: la cuenta del rayo se paga. Si un bloque te tapa la cabeza o estás en una cueva, no cae"
	DeedHint: En una tormenta, mata a un jefe al aire libre; solo entonces el filo reconoce ese rayo
}

OniMeiRubbingNuekiri: {
	DisplayName: Corte a la nue
	Tooltip: Si completas un combo de cinco en el aire, el quinto tiempo se convierte en un picado al suelo; al aterrizar, unos 0.7 segundos sin Paso relámpago
	Origin: De noche, sobre el palacio, revoloteaba el ave monstruosa nue; Minamoto no Yorimasa la derribó de un flechazo desde las nubes y, al caer, el tajo que añadió fue un mazazo siguiendo la caída. Esta inscripción guarda precisamente esa caída
	Power:
		'''
		«Caída de la nue» Si completas un combo de cinco a más de tres bloques del suelo, el quinto tiempo ya no es un tajo horizontal, sino un picado contra el suelo
		En el punto de caída estalla un anillo de choque de unos 12 bloques; el daño es el 120% de un tajo y arrastra a los enemigos cercanos hacia el punto
		'''
	Burden: Tras aterrizar, unos 0.7 segundos no puedes usar el Paso relámpago. Si cortas pegado al suelo, el quinto tiempo sigue siendo el quinto de siempre
	DeedHint: De noche, súbete a más de treinta bloques del suelo y mata a un enemigo volador; el cuchillo reconoce ese picado
}

OniMeiRubbingKamihi: {
	DisplayName: Conducto de papel
	Tooltip: Si el Paso relámpago atraviesa a un enemigo, deja un recorte de papel; cortar el papel es cortar el cuerpo; con papel en el campo, el Paso relámpago gasta más vigor
	Origin: "El arte del encuadernador de papel, cuando llega al extremo, parte de un tajo el papel y la sombra. Este conducto copia esa mano: al atravesar el cuerpo, recorta la sombra del otro y la deja in situ. Mientras el papel esté, la cuenta se cobra contra el papel"
	Power:
		'''
		«Sombra recortada» Si el Paso relámpago Kamui atraviesa a un enemigo, en el punto de llegada deja un recorte de papel a su medida, 7 segundos; como máximo dos a la vez
		Cortar ese papel inflige el 80% de un tajo, contado directo al cuerpo
		A la vez abre en el cuerpo una brecha de 1.5 segundos; mientras dura, tus tajos le hacen +12%
		'''
	Burden: Mientras hay papel en el campo, el gasto de vigor del Paso relámpago +12%
	DeedHint: En el mundo interior, corta veinte recortes de papel de efigie; solo entonces la mano sabe cómo se recorta el papel
}

OniMeiRubbingSorahi: {
	DisplayName: Conducto del aire
	Tooltip: En el aire, un Paso relámpago extra y la recuperación de vigor se duplica; los 0.75 segundos al aterrizar no recuperan nada
	Origin: "El maestro que abrió este conducto tenía una teoría rara: el vigor, como la gente, se vuelve perezoso en cuanto el pie toca suelo. Por eso abrió el cuchillo tan ligero, para que uno se quede un rato más en el aire: mientras flotas, el vigor viene a buscarte"
	Power:
		'''
		«Cuerpo flotante» Con los pies en el aire, la recuperación natural de vigor se duplica y te da un Paso relámpago extra
		Al terminar un Paso relámpago en el aire, te quedas medio segundo suspendido en el punto final
		'''
	Burden: Durante 0.75 segundos tras aterrizar, la recuperación natural de vigor baja a cero. Un Paso relámpago en el suelo gasta un 10% más de vigor
	DeedHint: Quince segundos seguidos sin tocar el suelo, y en ese rato el filo debe golpear al menos cinco veces; solo entonces el conducto reconoce el cuerpo flotante
}

OniMeiRubbingKagamihi: {
	DisplayName: Conducto del espejo
	Tooltip: En el final del Paso relámpago se alza un espejo de papel que copia tu siguiente tajo; daño base -5%
	Origin: "Todo maestro de pulir espejos sabe que el gesto del espejo parece a la vez, pero siempre va medio tiempo tarde. Quien abrió este conducto quiso usar precisamente ese medio tiempo: que el del espejo complete un tajo por ti, tarde, pero que llegue"
	Power:
		'''
		«Copia del espejo» En el final del Paso relámpago Kamui se alza un espejo de papel, 2 segundos
		La primera vez que cortes después, la figura del espejo copia el mismo tajo; el daño es el 45% de un tajo, y luego se rompe
		'''
	Burden: Daño base -5%. El tajo copiado sale desde donde está el espejo; si llega o no, depende de dónde lo plantes
	DeedHint: Remata a un cofre mímico con un tajo de Zanshin; las imitaciones de la Calamidad también cuentan como cosas que copian a la gente
}

OniMeiRubbingAmahi: {
	DisplayName: Conducto de lluvia
	Tooltip: El vuelo de sakura gotea tinta todo el camino; al caer se extiende en un charco que ata; gasto de vigor del vuelo de sakura +15%
	Origin: "La canaleta que recoge la lluvia bajo el alero también se llama conducto de lluvia. Quien abrió el filo le hizo al cuchillo esta ranura a imagen del alero: la lluvia recogida no se desperdicia; mientras vuelas, gotea, y gotea sobre los que van a recibir el tajo"
	Power:
		'''
		«Lluvia que cae» Durante el vuelo de sakura, cada 0.1 segundos suelta una gota de tinta; el daño es el 12% de un tajo
		Al caer, la gota se extiende en un charco de tinta; el enemigo que pisa queda atado medio segundo
		'''
	Burden: Gasto de vigor del vuelo de sakura +15%. Volar con una lluvia a cuestas sale caro
	DeedHint: En un día de lluvia, vuela con sakura diez segundos seguidos; solo cuando los pétalos están empapados se queda el agua
}

OniMeiRubbingTsuzurihi: {
	DisplayName: Conducto de costura
	Tooltip: Las marcas de tinta de un mismo Paso relámpago se unen y cortan; daño de cada marca -30%
	Origin: "Tsuzuri es la puntada con la que el encuadernador cose un libro: un ojo por aguja; al tirar del hilo, las hojas sueltas se vuelven un tomo. Quien abrió este conducto usa las marcas de tinta como puntadas: solo al ensartarlas se cierra la línea"
	Power: «Huellas cosidas» Las marcas de tinta de un mismo Paso relámpago detonan a la vez y tienden líneas de corte entre sí; cada tramo inflige el 35% de un tajo
	Burden: Daño de cada marca de tinta -30%. Si un Paso relámpago solo atraviesa a uno, este conducto es pérdida neta
	DeedHint: Atraviesa a seis enemigos distintos en un solo Paso relámpago; solo entonces las marcas se pueden coser
}

OniMeiRubbingBonsho: {
	DisplayName: Campana del templo
	Tooltip: Si la postura está llena y no sueltas la Danza final, el cuchillo toca la campana solo; el tañido gasta la mitad de la postura a cambio de un anillo que ata y controla el campo
	Origin: "La campana del templo suena cuando alguien la golpea; la de la hoja no espera. El tallista lo dijo claro: si el ímpetu está lleno y no lo sueltas, la campana lo suelta por ti"
	Power:
		'''
		«Un golpe de campana» Si en 3 segundos tras llenar la postura no sueltas la Danza final, el cuchillo toca la campana solo
		Los enemigos en 30 bloques reciben cada uno el 60% de un tajo y quedan atados 1.5 segundos; tu postura baja a 50
		'''
	Burden: En cuanto suena la campana, esa Danza final se pierde. Con el ímpetu lleno, tienes que elegir una de las dos
	DeedHint: Derriba a un jefe en todo el combate sin usar Destello aniquilador ni Danza final; así, a golpes de campana
}

OniMeiRubbingHannya: {
	DisplayName: Hannya
	Tooltip: "Con poca vida se voltea la máscara oni: el cuchillo pesa más y roba vida; durante la máscara eres más frágil; en reposo, un poco más romo"
	Origin: "La máscara Hannya del nō representa el instante en que una mujer, odiando hasta el extremo, se vuelve oni. El tallista sentó esa máscara en la hoja: cuando te empujan al borde, la máscara se voltea sola"
	Power:
		'''
		«Cambio de máscara» Si tu vida baja del 35%, se voltea la máscara oni: daño del cuchillo +20%; cada impacto restaura el 0.5% de la vida máxima
		Durante la máscara, cada tres impactos se alza una máscara oni que muerde; el daño es el 50% de un tajo
		'''
	Burden: Durante la máscara oni, daño recibido +15%. Mientras sigue siendo máscara de mujer, daño base -4%
	DeedHint: Mata a un jefe cuando tu vida ha caído por debajo de una décima; solo entonces la máscara se voltea
}

OniMeiRubbingKaresansui: {
	DisplayName: Jardín seco
	Tooltip: Quédate quieto y rastrilla un campo de dibujos de arena que se queda in situ; dentro corta sin cesar y sube la postura
	Origin: "El jardinero no usa ni una gota de agua: solo con arena y piedra rastrilla montes y mares. El tallista metió esas vetas en el cuchillo: si el espadachín se planta lo bastante, el aliento del filo también rastrilla un jardín de arena a tus pies"
	Power:
		'''
		«Dibujo de arena» Si te quedas quieto 1.5 segundos, rastrilla a tus pies un campo de dibujos de arena de 20 bloques, 5 segundos
		Dentro corta cada medio segundo; el daño es el 18% de un tajo
		Si tú estás dentro, la ganancia de postura +30%
		'''
	Burden: Hay que quedarse quieto para rastrillar; moverte borra lo acumulado
	DeedHint: Clávate en un sitio treinta segundos sin recibir ni un golpe; solo entonces sale la arena
}

OniMeiRubbingSenju: {
	DisplayName: Mil brazos
	Tooltip: Al congelarse la Danza final, se alzan seis manos oni que cortan a la vez; tras la Danza, el vigor se vacía y 3 segundos sin Paso relámpago
	Origin: "Kannon de los mil brazos salva a uno con cada mano. El tallista grabó los mil brazos en la hoja y le puso esta regla: cada uno a quien despide la Danza final debe tener una mano que lo reciba"
	Power: «Mil brazos» Durante el fotograma congelado de la Danza final, a tu espalda se alzan seis manos oni con cuchillo que cortan a la vez; cada una inflige el 30% de un tajo
	Burden: Tras la Danza final el vigor se vacía y, durante 3 segundos, no puedes usar el Paso relámpago
	DeedHint: Despide a ocho jefes distintos con la Danza final; una mano por cada uno
}

OniMeiRubbingKogehi: {
	DisplayName: Conducto abrasado
	Tooltip: El Paso relámpago deja en todo el camino hasta cinco zonas abrasadas; daño base -4%
	Origin: "El maestro que abrió este conducto vivía junto a un arenal de lava y estaba harto de ver a quien no mira el suelo. Dijo que este conducto se abrió para que esquives el calor: tú pasas, el quemazón se queda atrás, para el que te persigue"
	Power:
		'''
		«Marca abrasada» El Paso relámpago Kamui deja a lo largo de todo el camino hasta cinco zonas abrasadas; cada una quema 1.5 segundos
		El enemigo que está en una zona abrasada se quema cada medio segundo; el daño es el 14% de un tajo
		Una zona nueva que cae sobre una vieja a menos de dos bloques solo la refresca
		'''
	Burden: Daño base -4%; lo que falta hay que recuperarlo con las zonas que siembras al moverte
}

OniMeiRubbingKanhi: {
	DisplayName: Conducto del ocio
	Tooltip: Cuando el cuchillo se enfría, la recuperación natural de vigor pasa a 2.25 veces; gasto de vigor del Paso relámpago y del vuelo de sakura +8%
	Origin: "A la puerta de la forja hay un banco largo; el maestro, al terminar, se sienta y escucha la calle. Decía que hay que saber parar: cuando el oído se aclara, el vigor vuelve rápido. Este conducto es ese banco"
	Power: «Aliento ocioso» Tras dos segundos sin que el cuchillo golpee nada, la recuperación natural de vigor pasa a 2.25 veces
	Burden: Gasto de vigor del Paso relámpago y del vuelo de sakura +8%. El vigor que vuelve en la calma se paga con el movimiento
}

OniMeiRubbingTodohi: {
	DisplayName: Conducto de la demora
	Tooltip: Golpear pega al enemigo 0.6 segundos; el siguiente Paso relámpago tarda 0.1 segundos más en arrancar
	Origin: "Este conducto se templó raro: al pasar el filo por la carne se vuelve pegajoso, y lo que recibe el tajo se queda un instante clavado. Quien abrió el filo no lo veía como defecto: lo pegajoso es él, no tú"
	Power: «Atadura de demora» Cuando el filo golpea en persona, pega al enemigo 0.6 segundos; los normales bajan al 88% de movimiento, los jefes al 96%
	Burden: El siguiente arranque del Paso relámpago tarda 0.1 segundos más. La Atadura de demora y el Entumecimiento no se apilan en el mismo enemigo; se queda el más fuerte
}

OniMeiRubbingShiorihi: {
	DisplayName: Conducto de la poda
	Tooltip: Al rematar a uno con tu mano, recorta de paso al más herido de al lado; recuperación natural de vigor -10%
	Origin: "El jardinero, al podar, tiene una regla: si ya ha sacado las tijeras, corta de una vez lo marchito del mismo ramo, para no volver. Quien abrió este conducto, antes, era jardinero"
	Power:
		'''
		«Poda» Al rematar a un objetivo con el cuchillo, busca 15 bloques desde donde cae
		Elige a otro enemigo con menos de la mitad de vida, va y lo recorta; el daño es el 25% de un tajo
		Si no encuentra a nadie, no entra en enfriamiento; si recorta, 0.75 segundos de descanso
		'''
	Burden: Recuperación natural de vigor -10%. Un Zanshin que falla gasta 2 de vigor extra. Las muertes que recorta la propia hoja de podar no vuelven a activarla
}

OniMeiRubbingShiohi: {
	DisplayName: Conducto de la marea
	Tooltip: Si cortas al pulso de la marea, recuperas vigor y el Zanshin pesa más; el combo fuera de pulso es un poco más romo
	Origin: "Quien abrió el filo creció junto al mar y afilaba al ritmo de la marea. Decía que la marea sube y baja, y el vigor de uno también: el tajo que sale con la pleamar, el mar te devuelve la fuerza"
	Power:
		'''
		«Pulso de marea» Bajo la barra de vigor hay una cresta de 0.8 segundos por ciclo; los 0.2 segundos de la cima son la ventana de marea
		Los combos que salen en la ventana, el primer impacto de cada tajo devuelve 3 de vigor; el Zanshin en la ventana +8% de daño
		'''
	Burden: El combo fuera de pulso, -3% de daño. Si coincidiste o no se decide en el instante en que pulsas el tajo; acertar después ya no cuenta
}

OniMeiRubbingShibori: {
	DisplayName: Talla del entumecimiento
	Tooltip: Atravesar con el Paso relámpago o recibir un golpe duro en un gran golpe entumece al que te toca; ganancia de postura -15%
	Origin: "Aunque la mano que empuña se entumezca del golpe, no puedes soltar: es el sufrimiento del primer año. El maestro que talló esta inscripción usó el sufrimiento al revés: si yo me entumezco uno, el que me toca se entumece diez"
	Power:
		'''
		«Entumecimiento de vuelta» Si el Paso relámpago atraviesa a un enemigo, lo entumece del todo
		Si recibes daño de contacto durante la animación de un tajo que no puedes recoger, puedes gastar 15 de postura para bajar ese golpe al 85% y entumecer al que viene; luego 1.5 segundos de descanso
		El enemigo entumecido, 0.75 segundos más lento: los normales al 90%, los jefes al 98%; el daño de contacto al chocarte también -10%
		'''
	Burden: Ganancia habitual de postura -15%
}

OniMeiRubbingChinmei: {
	DisplayName: Silencio del campo
	Tooltip: Daño de los proyectiles enemigos -12%, retroceso -65%; ganancia de postura -15%
	Origin: "En la formación vuelan flechas y piedras; un zumbido en el oído y la gente se asusta. El veterano que talló esta inscripción solo dejó una frase: primero, cálmate; plantéate y luego muévete; lo que vuela duele menos"
	Power: «Silencio del campo» Los proyectiles enemigos que te golpean, daño -12%; el retroceso deja solo el 35%
	Burden: Ganancia de postura -15%. En un cuerpo a cuerpo puro, esta talla se queda casi ociosa
}

OniMeiRubbingAshidome: {
	DisplayName: Pie firme
	Tooltip: Quédate quieto 0.75 segundos y el siguiente gran golpe o el quinto tiempo +25%
	Origin: "La primera frase del maestro de espada, al abrir la clase: que los pies no se muevan. Con el pie firme se guarda la fuerza; la fuerza guardada, al salir, pesa. Esta inscripción te recuerda esa primera lección"
	Power: «Pie firme» Si te quedas quieto 0.75 segundos, acumulas un golpe; el siguiente quinto tiempo, Zanshin, Destello aniquilador o Danza final +25% de daño
	Burden: En cuanto el golpe sale, se gasta; fallar no lo devuelve. Moverte borra lo acumulado
}

OniMeiRubbingYoen: {
	DisplayName: Ascuas restantes
	Tooltip: Tras una ejecución deja en el suelo un campo de ascuas; solo uno a la vez; tope de vigor -5%
	Origin: "Cuando se sella el horno de forja, el calor que queda en la cámara aún calienta toda la noche. Quien abrió el filo le dejó al cuchillo esa mano: el fuego se apagó, el quemazón no"
	Power:
		'''
		«Ascuas» Tras una ejecución deja en el foco un campo de ascuas, 3 segundos
		El mismo enemigo se quema cada 0.75 segundos; el daño es el 16% de un tajo
		Solo hay un campo; otra ejecución lo mueve al sitio nuevo
		'''
	Burden: Tope de vigor -5%. Mientras el campo de ascuas aún quema, el gasto de vigor del Paso relámpago +10%
}

ScrapBeacon: {
	DisplayName: Baliza de chatarra
	Tooltip:
		'''
		Invoca de noche al Comandante de chatarra
		"La chatarra reconoce sola a su capataz"
		'''
}

GaolCellKey: {
	DisplayName: Llave de la celda del calabozo
	Tooltip:
		'''
		Alza in situ la celda del calabozo; en el altar se coloca un cráneo seco aletargado (objeto de prueba)
		Acércate al altar para despertarlo; durante el combate, las dos puertas laterales se sellan con una reja de energía de polvo espectral
		Tras derrotar al espectro del calabozo, la celda se apaga para siempre; el espectro que huye se aletarga de nuevo a los pocos segundos
		"Al girar la llave, el muro recuerda su forma"
		'''
	BuiltHint: La celda ya está alzada; el cráneo seco del altar te espera
}

RustedGaolIrons: {
	DisplayName: Grilletes oxidados
	Tooltip:
		'''
		La defensa sube 3 puntos; inmunidad al retroceso
		Tras recibir un golpe, la velocidad de movimiento sube un instante
		"El número de celda del interior del aro ya se ha pulido"
		'''
}

UndrownedShackleCharm: {
	DisplayName: Aro de grillete del ancla hundida
	Tooltip:
		'''
		En el agua te mueves como en tierra y obtienes la capacidad de nadar
		El tiempo de respiración bajo el agua se alarga mucho
		"El ancla tocó fondo; la persona aún respira"
		'''
}

GaolAnchorWeapon: {
	DisplayName: Ancla de la cárcel
	Tooltip:
		'''
		Lanza un ancla gigante; al clavarse en un muro tensa un instante una cadena de daño
		"Una herramienta de ejecución no se jubila"
		'''
}

SumpPearl: {
	DisplayName: Perla de agua de cárcel
	Tooltip:
		'''
		Una perla mate que el agua de cárcel condensó en las junturas de los huesos de un condenado
		El mercado de los no muertos la reconoce
		'''
}

FloodGalleryKey: {
	DisplayName: Llave de la sala de desagüe
	Tooltip:
		'''
		Alza in situ la sala de desagüe y coloca al condenado del ancla hundida (objeto de prueba)
		"Las marcas de nivel del muro son su reloj de latidos"
		'''
	Placed: La sala de desagüe ya está alzada. Si quieres despertarlo, súbete a la plataforma de la válvula de la izquierda y no te muevas.
}

ProofSealCharm: {
	DisplayName: Sello de inspección
	Tooltip:
		'''
		El daño de los proyectiles de trampa baja un 25% y tienen un 15% de fallar el disparo
		"La pieza sellada, los mecanismos la dejan pasar"
		'''
	Misfire: Fallo de disparo
}

OverseerLogger: {
	DisplayName: Registrador del capataz
	Tooltip:
		'''
		Obtienes percepción del peligro; las trampas y mecanismos cercanos no tienen dónde esconderse
		"Lleva el turno de cada boca de dardo"
		'''
}

ProofingHallKey: {
	DisplayName: Llave de la sala de aceptación
	Tooltip:
		'''
		Alza in situ la sala de aceptación y cuelga el brazo polvoriento (objeto de prueba)
		"La campana del banco de revisión aún suena"
		'''
	Placed: La sala de aceptación ya está alzada. Si quieres empezar la revisión, súbete al banco de la izquierda y no te muevas, hasta que la campana termine de contar.
}

WheezingWyrm: {
	DisplayName: Bastón del dragón que tose
	Tooltip:
		'''
		Mantén pulsado para escupir llama de dragón sin parar
		La cabeza del dragón está vieja; antes de encenderse siempre tose humo
		El soplo continuo enciende cada vez más la garganta; el color pasa del rojo oscuro al azul candente
		Cuanto más brillante la llama, más quema; la llama azul inflige el máximo daño y aplica Fuego infernal
		"No está del todo muerto; solo es un fumador empedernido aclarándose la garganta"
		'''
}

Abyssrend: {
	DisplayName: Grieta del abismo
	Tooltip:
		'''
		Clic izquierdo alterna una estocada de punta y un tajo de canto; cada golpe rasga una corriente oscura del océano que persigue a la presa
		Clic derecho levanta una succión abisal, arrastra a los enemigos de delante hasta las pinzas, las alza y las estrella contra el suelo cercano, detonando cavitación de alta presión
		Los enemigos golpeados y los alcanzados por la onda de cavitación caen en presión abisal y se entorpecen mucho
		"Recuerda el sonido de cuando el mar profundo lo aplasta todo"
		'''
}

SneezingWyrm: {
	DisplayName: Trabuco del dragón que estornuda
	Tooltip:
		'''
		Dispara con rapidez proyectiles de golpe de dragón al rojo
		El fuego continuo calienta cada vez más la recámara; el color de la bala pasa del naranja al blanco azulado
		Cada vez que se llena un aliento, el dragón sopla por la trayectoria un proyectil de aliento que busca enemigos en zigzag
		La nariz del dragón le pica del humo y, de vez en cuando, estornuda y escupe una ristra de humo denso hacia un lado
		"No te pongas del lado por el que estornuda"
		'''
}

TiroFinale: {
	DisplayName: Vals final
	Tooltip:
		'''
		Recibe a la vez las bonificaciones de daño a distancia y mágico
		Disparar consume munición y maná; cada disparo teje un mosquete de pedernal fantasma dorado que te rodea en formación
		Al mantener clic izquierdo, la formación apunta por turnos al cursor y dispara a la vez; cada arma solo suena una vez y se disuelve en luz dorada
		Clic derecho recoge al menos cuatro mosquetes fantasma y los condensa en un cañón gigante que toca el final
		"Las formas hay que cumplirlas; el telón, que sea grande"
		'''
}

Everdeep: {
	DisplayName: Abismo eterno
	Tooltip:
		'''
		Dispara un anillo de corriente de alta presión abisal
		Tras atravesar a los enemigos, el anillo vuela un tramo, se pliega y vuelve a golpear
		Los impactos acumulan resonancia abisal; las perlas que rodean el tomo son las capas
		Cuando la resonancia se desborda, desde la tierra bajo los pies del enemigo se alza un enorme tornado de agua
		"El abismo no se abre para ti; se cierra a tu espalda"
		'''
}

Deepclaw: {
	DisplayName: Pinza del abismo
	Tooltip:
		'''
		Invoca una langosta abisal para que luche por ti
		La langosta embiste y muerde con las pinzas
		Cada tres impactos de pinza, la langosta recoge las pinzas y detona un tañido de cavitación
		El tañido inflige daño de área y arrastra a los enemigos hacia el centro de la explosión
		"Lo de las profundidades nunca suelta la pinza"
		'''
}

Undertow: {
	DisplayName: Marea abisal
	Tooltip:
		'''
		Convierte cualquier flecha en una saeta de espina abisal
		Al impactar, la cola de agua se colapsa en una pequeña burbuja de cavitación y estalla otra vez
		Mantén clic derecho para cargar; al soltar con la carga llena, dispara una saeta pesada de presión abisal de 3 veces el daño
		La saeta pesada lo atraviesa todo y arrastra a los enemigos hacia la trayectoria
		Al detenerse, detona una implosión de cavitación
		"El mar no te aparta; te recoge"
		'''
}

TideReaper: {
	DisplayName: Guadaña del abismo
	Tooltip:
		'''
		Lanza una hoz abisal que gira sola y vuelve a la mano
		En vuelo suelta sin cesar medias lunas de la guadaña abisal que cazan a los enemigos cercanos
		Clic derecho lanza un ancla-vórtice: la hoz se clava delante y gira en un remolino
		El remolino arrastra a los enemigos al centro, acelera las medias lunas y luego vuelve
		"Tras la bajamar, en la playa solo quedan huesos blancos"
		'''
}

SeaShrimpShell: {
	DisplayName: Caparazón de camarón de cristal abisal
	Tooltip:
		'''
		El caparazón duro que mudó el camarón de cristal abisal
		Material de crafteo imprescindible de las armas de la serie abisal
		"Acércalo a la oreja y aún oyes el agua de la fosa"
		'''
}

DeepcrystalWarhelm: {
	DisplayName: Yelmo de guerra de cristal abisal
	Tooltip:
		'''
		El daño cuerpo a cuerpo sube un 18%; el crítico cuerpo a cuerpo sube un 10%
		La velocidad de ataque cuerpo a cuerpo sube un 18%
		"El peso del caparazón se te ha quedado en los huesos"
		'''
	SetBonus:
		'''
		El daño cuerpo a cuerpo sube un 18%, pero el daño que recibes aumenta un 10%
		Al golpear a un enemigo se condensan burbujas orbitantes; al juntar 5, todas colapsan y detonan una explosión pesada de cavitación en el objetivo
		Al recibir un golpe, las burbujas ya condensadas se rompen y una contraonda de cavitación aparta a los enemigos cercanos (con enfriamiento)
		Mojado, las burbujas se juntan más rápido y la detonación es más feroz
		'''
}

DeepcrystalVisor: {
	DisplayName: Visor de cristal abisal
	Tooltip:
		'''
		El daño a distancia sube un 18%; el crítico a distancia sube un 10%
		30% de probabilidad de no consumir munición
		"A través de la membrana de cristal, la fosa brilla como el día"
		'''
	SetBonus:
		'''
		El daño a distancia sube un 18%, pero el daño que recibes aumenta un 10%
		Al golpear a un enemigo se condensan burbujas orbitantes; al juntar 5, todas colapsan y disparan una columna de agua perforante hacia el objetivo
		Al recibir un golpe, las burbujas ya condensadas se rompen y una contraonda de cavitación aparta a los enemigos cercanos (con enfriamiento)
		Mojado, las burbujas se juntan más rápido y la detonación es más feroz
		'''
}

DeepcrystalCrown: {
	DisplayName: Corona mágica de cristal abisal
	Tooltip:
		'''
		El daño mágico sube un 18%; el crítico mágico sube un 10%
		El consumo de maná baja un 18%
		"En el racimo de cristal hay sellado un murmullo del mar"
		'''
	SetBonus:
		'''
		El daño mágico sube un 18%, pero el daño que recibes aumenta un 10%
		Al golpear a un enemigo se condensan burbujas orbitantes; al juntar 5, todas colapsan y sueltan tres orbes de agua guiados que caen sobre el objetivo
		Al recibir un golpe, las burbujas ya condensadas se rompen y una contraonda de cavitación aparta a los enemigos cercanos (con enfriamiento)
		Mojado, las burbujas se juntan más rápido y la detonación es más feroz
		'''
}

DeepcrystalFeelers: {
	DisplayName: Corona de tentáculos de cristal abisal
	Tooltip:
		'''
		El daño de invocación sube un 18%
		El tope de súbditos sube 2
		"Los tentáculos saben antes que tú hacia dónde va la presa"
		'''
	SetBonus:
		'''
		El daño de invocación sube un 18%, pero el daño que recibes aumenta un 10%
		Al golpear a un enemigo se condensan burbujas orbitantes; al juntar 5, todas colapsan y sueltan cuatro burbujas rastreadoras que cercan al objetivo
		Al recibir un golpe, las burbujas ya condensadas se rompen y una contraonda de cavitación aparta a los enemigos cercanos (con enfriamiento)
		Mojado, las burbujas se juntan más rápido y la detonación es más feroz
		'''
}

DeepcrystalBreastplate: {
	DisplayName: Peto de cristal abisal
	Tooltip:
		'''
		Todo el daño sube un 10%; el crítico sube un 6%
		"Caparazón por filo, sangre por marea"
		'''
}

DeepcrystalGreaves: {
	DisplayName: Grebas de cristal abisal
	Tooltip:
		'''
		La velocidad de movimiento sube un 15%; mojado, sube aún más
		En el agua te mueves con soltura
		"Pisas las olas como tierra firme"
		'''
}

SeaShrimpRelic: {
	DisplayName: Reliquia del camarón de cristal abisal
	Tooltip: ""
}

FallenKingsCrown: {
	DisplayName: Corona del rey caído
	Tooltip:
		'''
		Inmunidad al daño por caída
		En el aire, mantén pulsado abajo para convertirte en una corona que cae en picado y acelera el descenso
		Si no pulsas abajo, una caída natural de más de 25 bloques también entra sola en el picado
		Los enemigos que choquen en el descenso los aplasta la corona
		Al aterrizar suelta una onda de gel; cuanto más profundo el descenso, más daño, y a 40 bloques de profundidad llega al máximo
		La onda se suelta como máximo cada 1.5 segundos; hasta que se recarga, el brillo de la corona se apaga
		En el punto de caída queda un dominio de gel; el enemigo que pisa se ralentiza y sangra sin cesar
		Usar el gancho, montar o caer en un líquido cancela el picado
		"El día en que el trono tocó suelo, el peso fue el juicio"
		'''
}

BloodfogIris: {
	DisplayName: Iris de la niebla de sangre
	Tooltip:
		'''
		El crítico sube un 8%
		Pulsa dos veces izquierda, derecha o arriba para convertirte en niebla de sangre y embestir en esa dirección; al arrancar, invencibilidad breve
		Enfriamiento de la embestida: 1.25 segundos; durante el enfriamiento, la pupila de la niebla se apaga
		Tras la embestida entras 1.5 segundos en acecho: te ocultas en la niebla y baja el odio
		El siguiente ataque durante el acecho critica de forma garantizada
		Al recibir daño letal te conviertes en niebla de sangre, te recompones hacia el cursor, quedas invencible un instante y entras directo en acecho
		La salvación en niebla ocurre como máximo una vez cada 60 segundos; durante 3 segundos tras recomponerte, el daño que recibes sube un 15%
		"La niebla no se ha disipado; la pupila no se ha cerrado"
		'''
}

WorldEatersMaw: {
	DisplayName: Mandíbula que come mundos
	Tooltip:
		'''
		Todos tus ataques apilan una capa de corrosión ácida, hasta 10, 6 segundos; el impacto la refresca
		Al llenarse, la defensa baja 15 puntos y arranca 20 de vida por segundo
		Al morir un enemigo con corrosión, una larva del Devoramundos sale del cadáver y lucha por ti; como máximo una cada 2 segundos
		La larva se entierra, acecha a los enemigos cercanos, al morder apila 2 capas de corrosión y, al romper tierra, salpica ácido a su alrededor
		Como máximo 3 larvas a la vez; cada una vive 7 segundos
		"Los bordes del mundo son las marcas de sus dientes"
		'''
}

MirrorheartParadox: {
	DisplayName: Paradoja del corazón espejo
	Tooltip:
		'''
		Un corazón espejo vaga a tu lado
		Cuando el corazón está sólido, en el instante de recibir daño cambias de sitio con él, esquivas ese golpe y quedas invencible un instante
		En los dos puntos del cambio estalla un pulso de latido: 90 de daño base y confunde a los enemigos 2.5 segundos
		Durante 5 segundos tras el cambio, tus proyectiles los reproduce el corazón espejo al 50% de daño
		Los súbditos, las armas de empuñe y los explosivos no se reproducen
		Contragolpe de la paradoja: el siguiente golpe que recibas en 3 segundos tras el cambio, +25% de daño
		El cambio ocurre como máximo una vez cada 25 segundos; durante el enfriamiento el corazón está semitransparente, cargando; al solidificarse suena un aviso
		"El del espejo se parte el corazón un paso antes que tú"
		'''
}

SwarmVortexBeacon: {
	DisplayName: Baliza del vórtice de enjambre
	Tooltip:
		'''
		Al golpear a un enemigo apilas marca de abeja; al completar 8 capas lo arrastra el vórtice de enjambre
		El vórtice ata al objetivo y lo estrangula 5 segundos; cada segundo, 4 mordiscos de abeja de 18 de daño base
		El enemigo arrastrado se ralentiza mucho; un jefe solo un poco
		Si sigues golpeando al objetivo del vórtice, puedes alargar el estrangulamiento hasta 8 segundos
		Solo se mantiene un vórtice a la vez; cuando una nueva presa llena las marcas, el enjambre se muda
		Al morir el objetivo, el vórtice también salta a un enemigo cercano
		Si llevas la mochila de colmena, el daño de los mordiscos sube un 25%
		Al quedarte quieto, el enjambre vuelve al nido y te forma una coraza de cera
		La coraza absorbe hasta 30 de daño; al empezar a moverte se queda 5 segundos
		Tras romperse, tarda 3 segundos en volver a cristalizar
		"La baliza de la reina no convoca al enjambre; señala a la siguiente presa"
		'''
}

SoulbindingArm: {
	DisplayName: Muñeca que ata almas
	Tooltip:
		'''
		A tu alrededor se abre un dominio maldito; los enemigos dentro reciben un 8% más de tu daño
		Matar a un enemigo dentro del dominio cobra un alma; puedes guardar hasta 8
		Las almas te rodean; cada una bloquea un proyectil enemigo y luego se apaga
		El proyectil bloqueado se convierte en una bola de llama maldita que se lanza a un enemigo cercano: 60 de daño base
		Tras cada bloqueo, el anillo de almas tarda 1 segundo en recargar
		Cuando el anillo se llena, se condensa un instante y una mano espectral gigante se lanza al enemigo más poderoso cercano
		La mano inflige 300 de daño base que ignora la defensa y crece con tu bonificación de daño
		El enemigo atrapado, 5 segundos, recibe un 20% más de todo daño; los normales además quedan inmovilizados 1 segundo
		"El brazo cortado aún cobra almas; los cinco dedos nunca se soltaron"
		'''
}

WhiteoutStormCore: {
	DisplayName: Núcleo de la tormenta blanca
	Tooltip:
		'''
		+5% de reducción de daño; inmunidad a Frío, Congelado, Fuego de escarcha y Congelación
		Al recibir daño, detona sola una tormenta de blanqueo, 6 segundos, enfriamiento de 20 segundos
		La tormenta inflige 120 de daño base a los enemigos cercanos y aplica 3 segundos de Confusión y 6 de ceguera blanca
		Los enemigos con ceguera blanca se ralentizan mucho y reciben 10 de congelación por segundo
		Durante la tormenta obtienes un 30% extra de reducción de daño e inmunidad al retroceso; la cortina de nieve no te tapa la vista
		Los jefes no se confunden y la ralentización que reciben baja mucho
		Al correr sin parar en el suelo, cada segundo se alza hacia adelante una fila de púas de hielo que rompen tierra
		Cada púa inflige 45 de daño base y congela un instante al enemigo
		"Dentro de la visión blanca, el viento y la nieve solo te abren paso a ti"
		'''
}

GluttonousThroat: {
	DisplayName: Garganta glotona
	Tooltip:
		'''
		El 8% de todo el daño que infliges vuelve a ti en forma de perlas de sangre
		Las perlas no ocupan el enfriamiento de pociones de curación, pero como máximo restauran el 2% de la vida máxima por segundo
		La sangre que no cabe se vierte al suelo; la Fagocitación lunar cierra esta garganta y, mientras dura, las perlas se pierden
		Cada 9 segundos saca una lengua de carne gigante, agarra al enemigo más lejano en 68 bloques y lo arrastra hasta ti
		El enemigo mordido cae 5 segundos en sierra pútrida: 40 de vida por segundo
		Durante 2.5 segundos tras arrastrarlo a tu cara, tu siguiente golpe contra él inflige el doble
		Un golpe de ejecución además detona la sierra pútrida restante y la convierte en daño extra
		Los jefes no se arrastran, pero también los muerde, les aplica la sierra y los marca para la ejecución
		"Al otro lado de la garganta no hay fondo"
		'''
}

RefractionWaltz: {
	DisplayName: Vals de refracción
	Tooltip:
		'''
		Aumenta mucho la aceleración y la capacidad de giro en el aire
		Al llegar al punto más alto de un salto, al segundo salto, al dar la vuelta o al embestir, a tu espalda se condensa un cristal de refracción
		Pueden existir hasta 6 cristales a la vez; al pasarse, el más antiguo se rompe solo
		Los cristales se unen en el orden del baile y tienden haces de prisma; al juntar seis, el primero y el último cierran el anillo
		El daño de haces, cristales y esquirlas crece con tu bonificación de daño
		Cada haz corta al mismo enemigo como máximo 4 veces por segundo, 35 de daño base cada vez
		Si un enemigo rompe un cristal, recibe 70 de daño base y las esquirlas que salen, 40 cada una
		El impacto tiñe de refracción: el objetivo se mueve más lento y tu crítico contra él sube un 8%
		"Cuando la red de luz se forma, quien baila al son es el dueño del baile"
		'''
}

TwinPupilTether: {
	DisplayName: Rienda de las dos pupilas
	Tooltip:
		'''
		Invoca dos mini ojos demoníacos —Visión y Pupila ígnea— que te rodean; el daño crece con tu bonificación de daño
		Visión dispara láser de francotirador a enemigos a media distancia: 140 de daño base por disparo, uno cada 0.7 segundos aproximadamente
		Pupila ígnea escupe llama maldita sin parar a los enemigos cercanos: 40 de daño base por soplo, 5 soplos por segundo
		Entre ambos ojos tira siempre una rienda que corta; al mismo enemigo, como máximo 4 cortes por segundo, 80 de daño base cada uno
		El enemigo cortado abre una herida 3 segundos; mientras dura, el daño de este par de ojos contra él sube un 25%
		Cuanto más rápido te mueves, más se abren los ojos y más se alarga la rienda
		Pulsa dos veces abajo para una carga cruzada: los dos ojos te flanquean a ambos lados del cursor, se cruzan y detonan en el cruce
		El choque de la carga inflige 380; la detonación del cruce, 1100 de daño base; enfriamiento de 9 segundos
		"Una mirada cosida; un hilo que lo corta todo"
		'''
}

ProbeMatrixCore: {
	DisplayName: Núcleo de la matriz de sondas
	Tooltip:
		'''
		Despliega 5 sondas del Destructor en formación de escolta; adquieren objetivos solas y disparan láser rastreador
		El láser inflige 55 de daño base; al golpear al mismo objetivo acumula designación; al completar 8 capas llama un golpe orbital
		El golpe orbital deja caer desde el cénit un rayo de la muerte perforante: 900 de daño base por tick
		El objetivo atrapado en la columna resuelve como máximo dos ticks por golpe, hasta 1800 en total
		Tras cada golpe, la designación se borra y entra 3 segundos de enfriamiento; el punto de caída deja un calor que quema
		Si un enemigo derriba una sonda, se reconstruye en unos 2.5 segundos; la formación no ocupa ranuras de invocación
		"La serpiente de acero ya cayó; sus ojos siguen recorriendo el cielo por ti"
		'''
}

OverloadCommandCore: {
	DisplayName: Núcleo de mando de sobrecarga
	Tooltip:
		'''
		Al golpear a un enemigo acumulas carga iónica: +4 por impacto; al llegar a 100 entras en sobrecarga iónica
		Si dejas de atacar más de 1 segundo, la carga empieza a perderse con lentitud
		La sobrecarga iónica dura 5 segundos; mientras, la velocidad de ataque sube un 30%
		Durante la sobrecarga, al golpear a un enemigo salta un arco que encadena hasta 3 tramos entre enemigos cercanos
		El daño del arco es el 40% del daño real de ese impacto y baja en cada tramo
		Durante la sobrecarga, a tu espalda se despliegan cuatro brazos mecánicos fantasma que golpean a la vez que tú
		Con un arma cuerpo a cuerpo, los cuatro brazos cortan; cada golpe inflige el 24% del daño del arma
		Con las demás armas, los cuatro brazos disparan proyectiles iónicos; cada uno inflige el 20% del daño del arma
		Tras la sobrecarga, el cuerpo se sobrecalienta 3 segundos: la cadencia baja un 8% y no puedes acumular carga
		"El mando se ha transferido. Los cuatro brazos obedecen, hasta la fusión"
		'''
}

BloomNovaBulb: {
	DisplayName: Bulbo de nova en flor
	Tooltip:
		'''
		La vida máxima sube 30 puntos; la regeneración de vida sube 4
		Al recibir un ataque, lanza hacia el agresor o hacia la dirección del golpe una red de zarzas que lo ata; como máximo una oleada cada 1.5 segundos
		El daño base de las zarzas va de 220 a 330, por tramos según el valor de crecimiento, y crece con tu bonificación de daño
		El enemigo atado se ralentiza y se desgarra sin cesar: 80 por segundo; un jefe solo se ralentiza un poco
		Si el enemigo atado te ataca, recibe el daño de zarzas de vuelta: el 100% de ese golpe más 120 de daño base
		El contragolpe al mismo enemigo se resuelve como máximo una vez cada medio segundo
		El combate continuo acumula valor de crecimiento: más zarzas y más tiempo atado
		Si la vida baja del 35%, florece sola una nova: una onda de pétalos barre a tu alrededor y ata a los enemigos, 1200 de daño base
		En el instante de florecer restauras el 25% de la vida; los 6 segundos siguientes la regeneración se dispara y se agota todo el valor de crecimiento
		Tras florecer, una niebla de esporas te sigue 6 segundos; los ataques de los enemigos en la niebla tienen un 25% de fallar
		La nova en flor ocurre como máximo una vez cada 60 segundos
		"Cada herida riega la siguiente flor"
		'''
}

SolarCoreFist: {
	DisplayName: Puño del núcleo solar
	Tooltip:
		'''
		Quédate quieto medio segundo y entra en la postura de guardia de piedra
		En la postura, el daño que recibes baja un 50% y eres inmune al retroceso
		Cada golpe que recibes en la postura apila 1 capa de carga de núcleo solar; cada 100 de daño original de tus ataques apila 1 capa extra
		Hasta 24 capas; cada 8, las vetas del caparazón se encienden un grado
		5 segundos seguidos de postura fuerzan 2 segundos de sobrecalentamiento: pierdes la reducción de daño, no puedes cargar ni volver a plantarte
		En la postura, mantén pulsado abajo medio segundo para lanzar in situ un puñetazo a pleno hacia el cursor y una nova solar más grande
		Empezar a moverte también rompe la postura y suelta el puño, pero el puñetazo pesado baja un 25%
		Soltar el puñetazo termina la postura y no sobrecalienta
		Daño base del puñetazo pesado: 500; cada capa de carga +12.5%; a capas máximas, 2000; crece con tu bonificación de daño
		En el primer enemigo que golpea el puñetazo estalla una nova solar y, a ambos lados, seis detonaciones encadenadas de lava
		A partir de 8 capas, la postura lleva un aura abrasadora cuyo daño crece con tu bonificación de daño
		"La gema solar del templo aún late; el caparazón de piedra no es más que su guante"
		'''
}

TidalFin: {
	DisplayName: Aleta de la marea
	Tooltip:
		'''
		Pulsa [KEY] para embestir hacia el cursor; en un instante puedes pulsar de nuevo y encadenar, hasta dos tramos
		Cada tramo se puede apuntar de nuevo; durante la embestida eres del todo invencible
		En el camino se alza un muro de tsunami que se queda unos segundos; cada impacto inflige 140 de daño base
		Varios muros no apilan ticks de daño al mismo objetivo
		El muro empuja y ralentiza los proyectiles enemigos pequeños
		En el final del último tramo se alza un tornado de marea que se queda y estrangula; cada impacto inflige 200 de daño base
		El daño del muro y del tornado crece con tu bonificación de daño
		Con lluvia o en el agua, la embestida pasa a tres tramos y todo el daño sube un 50%
		Tras terminar todas las embestidas, 12 segundos de enfriamiento
		[c/2696A0:"La marea no ha olvidado a su rey"]
		'''
}

RiteRing: {
	DisplayName: Anillo de ritos
	Tooltip:
		'''
		El daño sube un 8%; el maná máximo sube 40; cada runa encendida sube otro 1% de daño
		Atacar o lanzar hechizos enciende a tu lado las runas una a una; al completar 8 se lanza solo el rito actual
		Los ritos rotan en orden: rito del espejo, láser de llama lunar, rito de las estrellas
		Rito del espejo: evoca 3 cuerpos espejo pálidos; cada uno dispara 3 salvas de los proyectiles del arma que empuñas, al 40% de daño
		Las armas de invocación, de empuñe y explosivas no se pueden reflejar; el cuerpo espejo dispara proyectiles de runa
		Láser de llama lunar: sobre tu cabeza se abre un ojo lunar que dispara un rayo de la muerte que barre el campo
		Rito de las estrellas: un mini anillo estelar colapsa y se deshace, y hace caer 16 estrellas sobre los enemigos
		Pulsa dos veces izquierda o derecha para gastar 3 runas, rasgar el velo y teleportarte un tramo corto en esa dirección
		"El rito empezó hace tiempo, y tú estás en el centro del anillo"
		'''
}

WingsOfInterference: {
	DisplayName: Alas de interferencia día y noche
	Tooltip:
		'''
		Te conviertes en las alas de la Emperatriz de la luz: 3.5 segundos de vuelo de día, 4.5 de noche; en vuelo, mantén pulsado abajo para flotar
		Forma diurna: tus proyectiles de ataque tiran un rastro de interferencia al volar
		Cuando dos rastros se cruzan, el cruce detona solo una explosión de prisma: 200 de daño base
		Forma nocturna: la velocidad de movimiento sube de forma notable y el vuelo dura más
		De noche, al recibir un ataque lo esquivas solo, una vez cada 48 segundos
		De noche, los proyectiles enemigos que se te acercan dejan un rastro de aurora y revelan la trayectoria de antemano
		En el instante del alba y del ocaso se desencadena una explosión de interferencia a pantalla completa: 1100 de daño base y borra los proyectiles enemigos
		"Día y noche interfieren en la punta del ala; la luz colapsa en el cruce"
		'''
	FormDay: "Ahora es de día: la red de interferencia está tendida"
	FormNight: "Ahora es de noche: el vuelo de aurora está tendido"
}

BlackFlashSigil: {
	DisplayName: Sello del destello negro
	Tooltip:
		'''
		Al atacar despiertas el sello; ante el pecho se enciende el anillo de pulso del destello negro
		Cuando el anillo se contrae al mínimo, la ventana de juicio se abre con un chasquido seco
		Si impactas a un enemigo dentro de la ventana, se activa el destello negro: ese golpe sube a 3 veces el daño y critica de forma garantizada
		Cada destello negro apila 1 capa de destello encadenado; cada capa añade 0.25 veces más al destello negro; 6 capas, tope 4.5 veces
		Cuanto más alto el encadenado, más rápido el pulso y más pronto llega la siguiente ventana
		Si la ventana se pasa vacía, o impactas fuera de ella, el encadenado se borra del todo
		A 4 capas de encadenado entra la sensación de dominio: los proyectiles ante tus ojos parecen más lentos
		Los súbditos atacan por su cuenta; no entran en el pulso ni cortan el encadenado
		"Cuando el destello se vuelve negro, el instante se alza sobre lo eterno"
		'''
}

FrogsparkBoots: {
	DisplayName: Botas rana resplandecientes
	Tooltip:
		'''
		Permiten volar y correr a gran velocidad; en el hielo resbalas con más firmeza y ya no rompes el hielo fino
		Puedes caminar sobre agua, miel y lava; inmunidad a En llamas
		Al tocar lava obtienes 7 segundos de inmunidad; después, el daño de lava que recibes baja mucho
		La velocidad de salto sube un 48%; permiten el salto automático y aumentan mucho la resistencia a las caídas
		"Un impulso de pata de rana, y el fuego abre camino"
		'''
}

CthulsparkBoots: {
	DisplayName: Botas Cthulhu resplandecientes
	Tooltip:
		'''
		Tienen todas las capacidades de las Botas rana resplandecientes
		Obtienen tres saltos extra de nube, ventisca y tormenta de arena; la altura de salto sube; inmunidad al daño por caída
		Pulsa dos veces una dirección para embestir con el Ojo gigante y apartar a los enemigos del camino
		"Flota sobre tu cabeza y vigila cada paso por ti"
		'''
}

NinjaCthulsparkBoots: {
	DisplayName: Botas ninja Cthulhu resplandecientes
	Tooltip:
		'''
		Tienen todas las capacidades de las Botas Cthulhu resplandecientes
		Un 10% de probabilidad de esquivar ataques; puedes aferrarte a los muros y deslizarte hacia abajo
		Pulsa dos veces una dirección para la embestida ninja de sombra escarlata: más rápida, más lejos, con un rastro carmesí
		La embestida aparta enemigos como el Escudo de Cthulhu y, al chocar, otorga invencibilidad breve
		"El Ojo gigante se ató un pañuelo y juró no volver a pestañear"
		'''
}

SeaShrimpSummonItem: {
	DisplayName: Cebo de camarón cristalizado
	Tooltip:
		'''
		Úsalo en el océano para invocar al camarón de cristal abisal
		"El cebo que se hunde no vuelve; lo que vuelve es otra cosa"
		'''
}

SeaShrimpTreasureBag: {
	DisplayName: Bolsa del tesoro (camarón de cristal abisal)
	Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
}

SeaShrimpTestItem: {
	DisplayName: Jaula de observación de camarones
	Tooltip: "Uso de desarrollo: invoca al camarón de cristal abisal en cualquier lugar"
}

BssBloomBud: {
	DisplayName: Capullo espinoso
	Tooltip:
		'''
		Úsalo en la superficie del desierto para llamar a la Pitón floral del desierto
		"La raíz de la duna, al florecer, tiene hambre"
		'''
}

FssFesterBud: {
	DisplayName: Capullo pútrido
	Tooltip:
		'''
		Úsalo en la superficie del desierto para llamar a la Pitón pútrida de arena
		"El capullo no murió; aprendió a supurar"
		'''
}

BudPiercer: {
	DisplayName: Filo de capullo
	Tooltip:
		'''
		Tras lanzarlo vuela un instante en recto y luego cae
		Al golpear a un enemigo siembra un capullo que, al poco, abre un anillo de pétalos
		Varias dagas pueden apilar capullos en el mismo objetivo
		Si se clava en el suelo, florece in situ y dispara hacia arriba tres agujas del yermo
		"Bajo las escamas de la pitón, cada una quiere florecer"
		'''
}

Thornstring: {
	DisplayName: Cuerda de espinas
	Tooltip:
		'''
		Convierte cualquier flecha en una saeta de espina
		Al impactar, la saeta de espina dispara agujas cortas a ambos lados
		Mantén clic derecho para cargar; al soltar con la carga llena, dispara una saeta pesada perforante de 2.5 veces el daño
		La saeta pesada, en cada impacto y en el punto de caída, abre un anillo de pétalos
		"La cuerda es enredadera, la flecha es espina, el arco es una flor que no quiere secarse"
		'''
}

BloomCaller: {
	DisplayName: Cuerno que llama capullos
	Tooltip:
		'''
		Toca el cuerno y llama a un capullo joven de flor del yermo para que luche a tu lado
		El capullo joven lanza púas que caen hacia los enemigos
		Cada dos lanzamientos, el tercero se convierte en una embestida; tras chocar, gira y abre un anillo de pétalos
		"El cuerno no es una orden; es riego"
		'''
}

Budcrown: {
	DisplayName: Corona de capullos
	Tooltip:
		'''
		Mantén pulsado el ataque para que la cabeza del martillo gire suspendida a tu alrededor; al soltar, la lanzas hacia el punto de mira
		Al golpear a un enemigo, la cabeza sacude agujas del yermo
		Cada tres impactos, la cabeza se abre en furia, estalla un anillo de pétalos y empuja con fuerza
		"El capullo más pesado es el que se abre más alto"
		'''
}

BloomTome: {
	DisplayName: Tomo de capullos
	Tooltip:
		'''
		Dispara un proyectil-capullo que florece
		Al golpear a un enemigo o al caer al suelo, abre un anillo de pétalos
		Cada cuarto disparo se convierte en un proyectil en plenitud: más pétalos y, hacia arriba, dos agujas del yermo
		"La página que abras, esa florece"
		'''
}

