AmmoBoxFire: {
	DisplayName: Caja de Munición Ardiente
	Tooltip:
		'''
		Mantén presionado para desplegar, después de desplegar, mantén la munición en la caja, haz clic derecho en la caja de munición para cargar municiones especiales en el cargador del arma
		Las municiones especiales se pueden combinar con el efecto de las balas originales
		Hace que las balas sean extremadamente inflamables, causando explosiones al impactar
		'''
}

ArmourPiercerBox: {
	DisplayName: Caja de Munición Perforadora
	Tooltip:
		'''
		Mantén presionado para desplegar. Después de desplegar, haz clic derecho en la caja con un arma para llenar el cargador con munición especial.
		La munición especial puede combinarse con el efecto de las balas originales.
		Recubre las balas con tungsteno para aumentar su capacidad de perforación, ignorando el 75% de la armadura del objetivo.
		"Sin embargo, no intentes usar una pistola para destruir un tanque."
		'''
}

HighExplosiveBox: {
	DisplayName: Caja de Munición de Alta Explosión
	Tooltip:
		'''
		Mantén presionado para desplegar. Después de desplegar, haz clic derecho en la caja con un arma para llenar el cargador con munición especial.
		La munición especial puede combinarse con el efecto de las balas originales.
		Transforma las balas en explosivos de alto poder; provocan explosiones intensas al impactar.
		"¡Hazlos volar todos!"
		'''
}

DragonBreathBox: {
	DisplayName: Caja de Munición aliento de Dragón
	Tooltip:
		'''
		Mantén presionado para desplegar. Después de desplegar, haz clic derecho en la caja con un arma para llenar el cargador con munición especial.
		La munición especial puede combinarse con el efecto de las balas originales.
		Una combinación de magia y tecnología; las balas explotan al impactar, causando un chorro metálico que daña a muchos enemigos.
		"¿Crees que es la saliva de ese dragón?"
		'''
}

