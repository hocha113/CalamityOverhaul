MoldProcessingTable: {
	DisplayName: Banco de moldes
	Tooltip:
		'''
		Clic derecho para abrir el banco de moldes
		Descomponer: funde piezas de modificación sobrantes en fragmentos
		Reforjar: consume fragmentos para producir nuevos moldes; puedes fijar objetivos del códice
		'''
}

