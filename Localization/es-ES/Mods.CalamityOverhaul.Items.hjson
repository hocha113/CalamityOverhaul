SHPCModTooltipDraw: {
	InstalledHeader: Módulos instalados
	NoModules: Ninguno
	BonusHeader: Bonificación total actual de módulos
}

MoldProcessingTable: {
	DisplayName: Banco de moldes
	Tooltip:
		'''
		Clic derecho para abrir el banco de moldes
		Descomponer: funde piezas de modificación sobrantes del mismo tipo en fragmentos
		Reforjar: consume fragmentos para producir moldes nuevos; puedes fijar un objetivo del códice
		'''
}

ElementWhip: {
	DisplayName: Látigo elemental
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		Quema a los enemigos con fuego elemental
		"La esencia de Terra, junto con los elementos del universo, atraviesa el mundo"
		'''
}

AzureDragonRage: {
	DisplayName: Ira del dragón azul
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		Desprende un fuerte olor a hierba fresca
		'''
}

BleedingScourge: {
	DisplayName: Flagelo escarlata
	Tooltip: Al golpear a un enemigo lo marca con la muerte y hace caer una lluvia de sangre
}

GhostFireWhip: {
	DisplayName: Látigo de fuego fantasmal
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		Un látigo muy largo, tejido con la ira de las almas en pena de la mazmorra
		[c/d4bc75:La pasión pura se irradia desde el infierno y te empuja a descubrir quién te agravió]
		'''
}

DivineSourceBlade: {
	DisplayName: Cuchilla aniquiladora de la Fuente Áurea
	Tooltip:
		'''
		Combo de cuatro tiempos: primero dos tajos rápidos en sentido antihorario y luego en sentido horario
		Después traza un anillo elíptico en el espacio y, al rematar, corta de vuelta por el mismo camino
		Cada tajo dispara más saetas de luz rastreadores; el corte de retorno lanza una gigantesca media luna azul
		Herir enemigos acumula carga con lentitud; clic derecho gasta toda la carga para potenciar el arma 7 segundos
		Durante la potenciación el daño se dispara, las saetas son más numerosas y feroces, y los efectos se tiñen de Fuente Áurea
		"La vida no cesa"
		'''
}

CursedflameBloodfist: {
	DisplayName: Puño de sangre de llama maldita
	Tooltip:
		'''
		Cuenta como cuerpo a cuerpo y magia, y recibe al completo las bonificaciones de ambos
		Mantén clic izquierdo para soltar una ráfaga de puñetazos a ambos lados; puedes correr con normalidad mientras golpeas
		Cada puñetazo resuelve un golpe de área a tu alrededor: el retroceso es mínimo, pero la cadencia es densísima
		A la vez esparce puños de fuego voladores hacia el cursor; quien reciba el impacto arde con Llama maldita
		La ráfaga drena maná sin parar y se detiene sola cuando te quedas seco
		"A quién le pertenecía este brazo ya no se distingue: el fuego lo ha borrado"
		'''
}

FoodStallChair: {
	DisplayName: Silla de plástico de puesto de comida
	Tooltip: ¡YO SOY LA SILLA QUE SE ACERCA!
}

Arbiter: {
	DisplayName: Sentenciador
	ManifestInteractHint: "[Clic derecho] Extrae este hacha"
	ManifestInventoryFullHint: La mochila está llena; deja un hueco antes de extraer el hacha
	Tooltip:
		'''
		Mantén clic izquierdo para cargar y alzar el hacha de la sentencia
		Al soltar, taja hacia abajo y libera una onda de fuego que se extiende por el suelo hacia ambos lados
		Cuanto más cargues, más lejos se extienden las llamas y mayor es su poder
		"El juicio se alza entre las llamas"
		'''
}

Cloudwalking: {
	DisplayName: Paseo entre nubes
	Tooltip:
		'''
		Mantén clic izquierdo para cargar y alzar el gran hacha
		Al soltar, el hacha vuela hacia adelante y va dejando nubes a su paso
		Vuelve sola a tu mano
		'''
}

AnnihilatingUniverse: {
	DisplayName: Saeta de aniquilación cósmica
	Tooltip:
		'''
		Las flechas que golpean a un enemigo dejan una estrella resplandeciente en el lugar
		Clic derecho destruye a los enemigos con el poder del Devorador de dioses
		'''
}

NeutronStarIngot: {
	DisplayName: Lingote de estrella de neutrones
	Tooltip: El peso de todas las cosas, reunido en la yema de los dedos
}

DawnshatterAzure: {
	DisplayName: Alba del firmamento
	Tooltip:
		'''
		Mantén clic izquierdo para encadenar un combo de cinco tiempos; el último gira y enciende una corona solar
		Clic derecho alza el arma y carga, luego embiste hacia el cursor
		"El fuego purifica el alma y despoja a tus enemigos hasta no dejar nada"
		'''
}

Flawless: {
	DisplayName: Trascendencia
	Tooltip:
		'''
		Combo de cuatro tiempos: barrido, estocada, contrabarrido y estocada final; cada uno más pesado que el anterior
		Las estocadas cambian a una punta fina, llegan más lejos y salpican cristales de escarcha al impactar
		"Cambió la punta siete veces. En el blanco solo hay un agujero"
		'''
}

StormGoddessSpear: {
	DisplayName: Lanza de la diosa de la tormenta
	Tooltip:
		'''
		Dispara un beso de tormenta cargado de arcos eléctricos destructivos
		Al empuñarla, invoca el alma remanente de la diosa de la tormenta para que luche a tu lado
		[legend]
		'''
	Legend:
		'''
		Alina, el filo más agudo que Terra haya conocido.
		Su fe era inquebrantable, su combate implacable. Polvo de hierro en la lanza de plata, el cabello al viento. La hoja de la tormenta aullaba al pasar.
		Aun así, hasta el filo más agudo se quiebra y se desmorona; la fe solo halló la indiferencia de los dioses.
		Cuando el Supremo dictó sentencia, sus compañeros, su linaje, sus juramentos y su gloria se convirtieron en cenizas.
		Con sus propios ojos vio cómo la llamada justicia pisoteaba todo… sangre y lágrimas… polvo…… cómo en nombre del orden se ejecutaba la destrucción más vil.
		Dioses…… Alina ya no mira a los dioses.
		Retrocedió al abismo, se destruyó a sí misma y dejó que un poder antiguo y prohibido devorara su alma a su antojo
		La armadura de Alina se fundió en un cuerpo de hierro abisal. Las nubes de antaño, el sol ensangrentado y el pasado se entrelazaron; la mirada de sus compañeros… y de su linaje al morir…… Alina… todo había terminado.
		Ya no era la Alina de antaño, la diosa de la guerra que protegía Terra
		Su furia regresó como un vendaval, arrastrando a los insectos del campo de batalla; su trueno partió cielo y nubes, hendió tronos y tierra.
		La diosa de la tormenta, Alina, trajo sin piedad destrucción y venganza.
		'''
}

DragonsScaleGreatsword: {
	DisplayName: Gran hoja de alga dracónica
	Tooltip:
		'''
		Los tajos siguen un combo de tres tiempos; el tercero suelta un remate de mayor poder dracónico
		Cada tajo libera una onda espiral de alga verde que, al golpear, estalla en varias nubes de alga tóxica
		Los ataques cuerpo a cuerpo verdaderos generan gran cantidad de nubes de alga tóxica
		Clic derecho invoca el alma del dragón esmeralda para que muerda a los enemigos hacia el cursor, esparciendo nubes tóxicas a su paso
		'''
}

CosmicCalamity: {
	DisplayName: Calamidad galáctica
	Tooltip: Los ataques generan ondas de choque en forma de media luna
}

SpearOfLonginus: {
	DisplayName: Lanza de Longinos
	Tooltip:
		'''
		Al empuñarla, una cruz sagrada emerge bajo tus pies y absorbe energía divina por sí sola
		Cada vez que la barra se llena se completa una carga, hasta un máximo de seis campos de fuerza
		Mientras la sostienes, marca con el destino al enemigo más cercano
		Si el campo golpea a un enemigo marcado, se desata la Ira del Peregrino
		[legend]
		'''
	Legend:
		'''
		
		“Dios quebrantado, permíteme redimir mis pecados.”
		La guerra se ha extendido por siglos. Yo, el derrotado que huyó de una gran civilización, sobrevivo solo en este planeta desolado al borde del universo.
		A decenas de miles de años luz, las máquinas de guerra aplastan estrellas; un ataque brutal y aterrador puede borrar en un instante años luz de cielo y convertirlo en un dominio de silencio.
		Y esa guerra ha durado cientos de años. Hoy, la gran civilización a la que pertenezco está al borde del colapso; me convertiré en un pecador del universo, el más irreverente de los blasfemos.
		Mi carne ya se ha podrido, mis huesos son arrugas de la vejez; estoy a punto de convertirme en una de las débiles máquinas que yo mismo creé.
		Antes de eso, que Dios me otorgue perdón y absuelva mi falta de respeto hacia esa existencia suprema, para que al caer mi alma descienda al abismo del infierno y sufra un dolor sin fin.
		Aun así, por la civilización a la que pertenezco, por la victoria en esta guerra que abarca siglos, debo absorber el poder fragmentado de esa existencia suprema.
		Para guiar su poder misterioso, no tengo otra opción que inyectar metal frío en su cuerpo divino quebrantado.
		Es una blasfemia inevitable. Por la continuidad de la civilización, por la victoria en la guerra, debo convertirme en el creyente más devoto de esa existencia suprema, y en el blasfemo más irreverente de la historia.
		'''
}

BloodAltar: {
	DisplayName: Altar carmesí
	Tooltip:
		'''
		Clic derecho en el altar para invocar la Luna de Sangre con una Lágrima de sangre
		Recoge automáticamente las Lágrimas de sangre y las Gotas de sangre que caen en el mundo y las guarda en el cofre más cercano
		"Que el mundo quede bajo la mirada del carmesí"
		'''
}

BarrenBow: {
	DisplayName: Arco yermo
	Tooltip: Las flechas disparadas estallan en corriente yerma al golpear a un enemigo
}

ElementMuzzleBrake: {
	DisplayName: Estabilizador elemental
	Tooltip:
		'''
		El daño a distancia aumenta un 12%
		La probabilidad de crítico a distancia aumenta un 15%
		La velocidad de disparo a distancia aumenta un 12%
		A los enemigos les costará más detectarte
		'''
}

EyeOfSingularity: {
	DisplayName: Visión de la singularidad
	Tooltip:
		'''
		El daño a distancia aumenta un 100%
		La probabilidad de crítico a distancia aumenta un 100%
		La velocidad de disparo a distancia aumenta un 100% y dejas de consumir munición
		Eleva el multiplicador de daño crítico de todas las armas a distancia al 500%
		Tus proyectiles a distancia rasgan el espacio y, al impactar, generan un microagujero negro que atrae y desgarra a los enemigos cercanos
		Si permaneces inmóvil, entras en el estado Horizonte de sucesos:
		  Te vuelves invisible e inmune a todo daño por contacto
		  Al disparar sueltas además ráfagas de rayos gamma que persiguen a los enemigos
		Obtienes salto cuántico: pulsa [KEY] para teleportarte al cursor y borrar los proyectiles enemigos a tu paso
		Clic derecho activa el Protocolo de colapso:
		  Gasta todo el maná; durante los siguientes 10 segundos todos tus ataques a distancia ignoran los fotogramas de invencibilidad y critican de forma forzada
		  Enfriamiento de 60 segundos
		Si recibes un golpe letal, te conviertes en una supernova que inflige daño de área enorme y te recompones 3 segundos después en un lugar seguro
		Este efecto tiene 60 segundos de enfriamiento
		[c/33ff33:"El dios dragón dormido toca tus nervios; en Sus ojos el alma de todas las máquinas ya no guarda secretos"]
		[c/ffaa00:"La constelación avariciosa bebe la llama de la boca del cañón; el brillo de las estrellas antes de apagarse acaba en su vientre"]
		[c/00ffff:"La Muerte te sigue en silencio y cobra cada nombre que habrá de pagarse"]
		'''
}

ArcaneThroneOfEternity: {
	DisplayName: Trono del arcano eterno
	Tooltip:
		'''
		El daño mágico aumenta un 100%
		La probabilidad de crítico mágico aumenta un 100%
		La velocidad de ataque mágico aumenta un 100%
		El maná máximo aumenta en 1000 puntos; la regeneración de maná se dispara y nunca se interrumpe
		Todos los proyectiles mágicos obtienen penetración infinita
		Tus ataques mágicos rasgan el velo de la realidad y, en el punto de impacto, abren una fisura arcana que estalla sin cesar
		Todos los ataques mágicos aplican una maldición prohibida aleatoria:
		  Erosión del Vacío, parada temporal, combustión del alma, colapso gravitatorio, desintegración hiperespacial
		Cuando el maná supera el 90% obtienes el estado «Omnisciencia»:
		  Todos los proyectiles mágicos bloquean enemigos por sí solos y el multiplicador de daño crítico sube al 1000%
		Obtienes salto de la verdad: pulsa [KEY] para rasgar el espacio y entrar en un dominio de dimensión superior:
		  Durante un instante eres inmune a todo daño y te mueves con libertad; al salir sueltas una sacudida de realidad devastadora
		  Enfriamiento de 30 segundos
		Clic derecho activa el Cálculo de la raíz:
		  Durante los siguientes 10 segundos todos tus ataques mágicos sueltan a la vez 5 hechizos espejo
		  Enfriamiento de 60 segundos
		Si recibes un golpe letal, el tiempo retrocede al estado de hace 5 segundos y recuperas la vida, el maná y la posición de entonces
		Este efecto tiene 60 segundos de enfriamiento
		Los enemigos tienen más probabilidades de apuntarte a ti
		[c/b84dff:"El sabio sin nombre abre tu cráneo y, más allá de las estrellas, escribe verdades olvidadas"]
		[c/ffdd66:"El Señor del Cambio tira de la urdimbre del destino y trata la realidad como un borrador inacabado"]
		[c/66ffff:"El cadáver sentado en el Trono Dorado te observa, y hace tiempo que olvidó qué es la muerte"]
		'''
}

PrecisionMuzzleBrake: {
	DisplayName: Estabilizador de alta precisión
	Tooltip:
		'''
		El daño a distancia aumenta un 8%
		La probabilidad de crítico a distancia aumenta un 10%
		La velocidad de disparo a distancia aumenta un 8%
		A los enemigos les costará más detectarte
		'''
}

SimpleMuzzleBrake: {
	DisplayName: Estabilizador tosco
	Tooltip:
		'''
		El daño a distancia aumenta un 5%
		La probabilidad de crítico a distancia aumenta un 5%
		La velocidad de disparo a distancia aumenta un 5%
		A los enemigos les costará más detectarte
		'''
}

HalibutItem: {
	DisplayName: Fletán
	Tooltip: ""
}

HalibutPilotChart: {
	DisplayName: Carta de navegación
	Tooltip:
		'''
		Úsala para empezar de cero la guía del Fletán; si la usas otra vez a mitad de la guía, la recoge
		Es el vale que queda al rechazar la guía inicial; la carta no se consume y puedes abrirla una y otra vez
		'''
	NeedFish: No hay un Fletán en el zurrón; la carta no tiene a quién guiar
	HoldFish: La carta está abierta; empuña el Fletán y empieza la lección
	Closed: La guía se ha recogido; usa de nuevo la carta para reabrirla
	NotNow: Ahora hay otro asunto; la carta no puede extenderse
}

OnikiriItem: {
	DisplayName: Onikiri
	Tooltip: ""
}

KikasaItem: {
	DisplayName: Kikasa
	Tooltip: ""
}

KikasaTalismanLin: {
	DisplayName: Talismán de llovizna
	Tooltip: El ritmo de la lluvia de tinta se acelera y, si no se interrumpe, se vuelve cada vez más densa; cada gota pesa un poco menos
	Origin: "Decía el viejo talismánico: para pedir lluvia no hace falta despertar al Rey Dragón; basta un talismán de llovizna. Que las gotas sean pequeñas no importa; lo que importa es que no paren"
	Power: "«Llovizna» El ritmo de la lluvia de tinta se acelera un 20% y las gotas se suceden sin descanso; unos diez segundos de lluvia ininterrumpida acumulan «Lluvia persistente»: bajo la sombrilla cae una cortina de hilos de lluvia y el ritmo se acelera otro 10%; al dejar de atacar la intensidad se disipa y, al recoger la sombrilla, se reduce a la mitad de inmediato"
	Burden: Daño de cada gota -6%
}

KikasaTalismanLao: {
	DisplayName: Talismán de charco de tinta
	Tooltip: Toda gota de tinta que toca el suelo forma un charco; el charco bebe la lluvia, sube de nivel y, al llenarse, se desborda; el impacto directo es un poco más leve
	Origin: Al talismánico le fastidiaba que la lluvia se secara en cuanto caía y se malgastara toda la tinta, así que dibujó este talismán para dejarla en el suelo. Un instante más de inundación ya es ganancia
	Power: "«Charcos» Toda gota de tinta que toca el suelo forma un charco (no hace falta llegar al cuarto umbral «Inclinación del lago»); duración del charco +50%, radio +30%; las gotas que se unen a un charco existente suben el nivel del agua, y la tercera lo desborda: la superficie se ensancha un paso y lanza ondas de desborde a ambos lados (50% del daño del charco cada una)"
	Burden: Daño directo de las gotas de tinta -5%
}

KikasaTalismanPei: {
	DisplayName: Talismán de diluvio
	Tooltip: Al invertir la sombrilla la tinta se acumula más rápido; cuando el cuenco está lleno, verter es abrir la compuerta; la lluvia habitual se vuelve un poco más lenta
	Origin: "Lo peor al pedir lluvia es que no duela. Este talismán solo atiende una cosa: si va a llover, que sea un diluvio"
	Power: "«Diluvio» Velocidad de acumulación invertida +35%, daño de los surtidores de tinta +20%; al llenarse, el borde del cuenco rebosa perlas y emite un zumbido grave: verter en ese instante es abrir la compuerta: el origen de la cascada estalla con un impacto (80% del daño de la cascada) y la cascada de tinta se ensancha"
	Burden: El ritmo de la lluvia de tinta se ralentiza un 8%
}

KikasaTalismanSha: {
	DisplayName: Talismán de lluvia veloz
	Tooltip: La sombrilla se abre en un instante; el primer tiempo suelta tres gotas rápidas seguidas; el tiempo siguiente se retrasa un poco
	Origin: "El talismánico iba de noche y se topó con salteadores: abrió la sombrilla, dejó caer la lluvia y la recogió, todo en un parpadeo. Después escribió esa «rapidez» en un talismán"
	Power: «Lluvia veloz» Tiempo de apertura de la sombrilla -75%; el primer tiempo al abrirla suelta siempre tres gotas rápidas (75% de daño cada una)
	Burden: Tras el triple, el intervalo del siguiente tiempo +40%
}

KikasaTalismanYin: {
	DisplayName: Talismán de flor de tinta
	Tooltip: Las gotas de tinta que impactan apilan marcas de tinta; al completar cinco capas estalla una flor de tinta; el impacto directo es un poco más leve
	Origin: "Una gota de tinta en papel húmedo, si no la limpias, se abre sola en flor. El talismánico decía que los enemigos son igual: unas gotas más, y florecen"
	Power: «Flor de tinta» Las gotas dejan una marca al impactar (hasta cinco capas, cada una sangra con el tiempo); al completar cinco se abre la flor, inflige 160% del daño de gota y limpia las capas
	Burden: Daño directo de las gotas de tinta -8%
}

KikasaTalismanLu: {
	DisplayName: Talismán de rocío
	Tooltip: Al impactar, las gotas a veces condensan una perla de rocío; recogerla restaura vida; el ritmo de la lluvia se ralentiza un poco
	Origin: "Dicen los textos que el rocío cae del cielo y aleja toda enfermedad. El talismánico no logró ese milagro, así que se conformó con lo segundo: que cada gota lleve un poco de dulzura"
	Power: «Rocío» Las gotas de tinta tienen un 12% de condensar una perla de rocío al impactar; recogerla restaura 2 de vida; como máximo tres en el campo
	Burden: El ritmo de la lluvia de tinta se ralentiza un 6%
}

KikasaTalismanFei: {
	DisplayName: Talismán de niebla
	Tooltip: Cada tercera gota se vuelve gota de niebla y deja en el impacto una bruma de tinta que hiere y ralentiza; la gota de niebla en sí es más leve
	Origin: A mitad de la lluvia de montaña, a menudo se vuelve niebla y se pega a la gente. El talismánico pensó que ese aferramiento era peor que las gotas, así que lo metió en el talismán para que trabajara por él
	Power: "«Niebla» Cada tercera gota de tinta se vuelve gota de niebla: en el impacto deja bruma de tinta dos segundos; los enemigos dentro sufren daño continuo y -10% de velocidad de movimiento"
	Burden: Daño de la gota de niebla -30%
}

KikasaTalismanXian: {
	DisplayName: Talismán de perlas salpicadas
	Tooltip: Las gotas grandes se rompen al caer en cinco perlas de tinta que rebotan; los charcos son un poco más pequeños
	Origin: La lluvia gruesa contra las losas levanta perlas a media altura y te empapa. El talismánico escribió ese bote en el talismán y enseñó a las perlas a morder
	Power: «Perlas salpicadas» Las gotas grandes se rompen al caer en cinco perlas de tinta (30% de daño cada una); cada perla aún puede rebotar dos veces
	Burden: Radio de los charcos de tinta -15%
}

KikasaTalismanXi: {
	DisplayName: Talismán de marea
	Tooltip: Los charcos de tinta respiran con la marea y se abalanzan solos sobre los enemigos cercanos; su duración es un poco más corta
	Origin: "El talismánico vivió tres años junto al mar y solo aprendió una cosa: el agua no espera a que la pisen, ella misma se lanza"
	Power: "«Marea» Los charcos de tinta ganan naturaleza de marea: suben y bajan al respirar; cuando cae tinta nueva en un charco, este se lanza hacia el enemigo más cercano y el borde de la ola inflige 50% del daño del charco"
	Burden: Duración de los charcos de tinta -20%
}

KikasaTalismanZi: {
	DisplayName: Talismán de impregnación
	Tooltip: Los enemigos que se empapan en un charco de tinta acumulan capas de impregnación y reciben más daño de tinta; el charco en sí es más leve
	Origin: Para teñir tela hay que dejarla tres días en la tina, o el color no cala. El talismánico teñó tela y sabe mejor que nadie lo que vale un «remojo»
	Power: «Impregnación» Los enemigos dentro de un charco de tinta acumulan impregnación sin cesar (hasta ocho capas); cada capa aumenta un 2.5% el daño de tinta que reciben
	Burden: Daño del charco de tinta -25%
}

KikasaTalismanTing: {
	DisplayName: Talismán de surtidor del trueno
	Tooltip: Los surtidores de tinta se vuelven columnas de agua y trueno que encadenan electricidad a los enemigos cercanos; las cascadas que tocan el suelo a veces levantan un surtidor menor; acumular tinta es un poco más lento
	Origin: Nada asusta tanto como un lago en una noche de tormenta. El rayo entra en el agua y todo el lago se enciende. El talismánico dibujó este talismán a partir de esa escena
	Power: «Surtidor del trueno» Altura de la columna del surtidor +50%; al impactar encadena electricidad a hasta dos enemigos cercanos (50% del daño del surtidor cada uno); una cascada de tinta que aún no está llena tiene un 25% de levantar un surtidor menor al tocar el suelo
	Burden: Velocidad de acumulación invertida -13%
}

KikasaTalismanHong: {
	DisplayName: Talismán de puente iris
	Tooltip: "Al recogerse la cascada de tinta se alza un puente iris: bajo el puente hay beneficios, el arco quema a los enemigos; la cascada es un poco más estrecha"
	Origin: "Ver un arcoíris después de la lluvia es buen augurio. El talismánico lo dibujó en el talismán: en cuanto para la lluvia, se tiende el puente, y quien se pone debajo recibe su parte"
	Power: "«Puente iris» Al recogerse la cascada de tinta, se alza un puente iris cinco segundos sobre el punto de caída: bajo el puente, velocidad de movimiento +10% y daño de invocación +10%; los enemigos que cruzan el arco reciben 40% del daño de la cascada cada medio segundo"
	Burden: Anchura de la cascada de tinta -10%
}

KikasaTalismanHang: {
	DisplayName: Talismán de miasma nocturno
	Tooltip: De noche el daño de tinta aumenta y los charcos evaporan columnas de miasma; de día baja un poco
	Origin: Dicen que el vapor del agua de noche no se toca. El talismánico guardó una botella de todos modos, y resultó que no se toca. Entonces que lo toquen los enemigos
	Power: «Miasma nocturno» De noche el daño de tinta +15%; los charcos evaporan sin cesar columnas de miasma (30% del daño de gota cada medio segundo)
	Burden: De día el daño de tinta -5%
}

KikasaTalismanBao: {
	DisplayName: Talismán de granizo
	Tooltip: "Cada cuarto tiempo todas las gotas se vuelven granizo gigante: golpes que rompen armadura y no dejan charco; el daño habitual de las gotas es un poco más leve"
	Origin: "El granizo es el mal genio de la lluvia: parte tejas y cubos y nadie lo detiene. El talismánico no quiso domesticarlo; solo pactó: cada cuatro tiempos, uno es suyo"
	Power: "«Granizo» Cada cuarto tiempo es una descarga conjunta: todas las gotas se vuelven granizo gigante: tamaño x1.6, daño x2.2, rompe armadura y empuja con fuerza; el granizo gigante no deja charcos de tinta"
	Burden: Daño de gota de los tiempos normales -8%
}

KikasaTalismanShu: {
	DisplayName: Talismán de lluvia oportuna
	Tooltip: Tras recibir daño, tres segundos de lluvia densísima y cada gota cura; el ritmo habitual se ralentiza un poco
	Origin: "En el mundo flotante llaman «lluvia oportuna» a quien llega justo a tiempo. Este talismán sigue esa regla: si el dueño de la sombrilla recibe un golpe, la lluvia tiene que acudir al instante"
	Power: «Lluvia oportuna» Durante tres segundos tras recibir daño, el intervalo de la lluvia se reduce a la mitad, los hilos se vuelven dorados y cada gota que impacta restaura 1 de vida; 12 segundos de enfriamiento
	Burden: Intervalo habitual de la lluvia +5%
}

KikasaTalismanLong: {
	DisplayName: Talismán de cascada impetuosa
	Tooltip: La cascada de tinta se vuelve un torrente que empuja a los enemigos; dura menos
	Origin: Cuando baja una riada, nadie se tiene en pie. El talismánico lo vio una vez desde el risco y, al volver, solo escribió un «empuje» en el talismán
	Power: "«Cascada impetuosa» La cascada de tinta se vuelve un torrente: el cuerpo de la cascada empuja sin cesar a los enemigos de la línea de caída y el retroceso del impacto directo del origen +35%"
	Burden: Duración de la cascada de tinta -20%
}

KikasaTalismanShuang: {
	DisplayName: Talismán de espejo de escarcha
	Tooltip: "Los charcos se congelan en espejos de escarcha: pisarlos ralentiza, una gota los rompe y estallan; los charcos no pueden renovarse"
	Origin: "Tras la escarcha, el agua de los charcos se congela en una noche: parece un espejo, y solo al pisarlo se entiende. Lo que guardó el talismánico fue precisamente esa capa de «parece inofensivo»"
	Power: "«Espejo de escarcha» Las gotas grandes se congelan solas en charcos de escarcha (no hace falta llegar al cuarto umbral «Inclinación del lago»); el charco se vuelve espejo: ya no quema, quien lo pisa se ralentiza un 40%; una gota de tinta que golpea el espejo lo rompe al instante, convierte la vida restante del espejo en daño explosivo y alza estalactitas"
	Burden: Cada espejo de escarcha existe por separado; los charcos no pueden fusionarse para renovar su duración
}

KikasaTalismanZha: {
	DisplayName: Talismán de tambor de lluvia
	Tooltip: Si impactas en siete tiempos seguidos, el octavo triplica el daño de todas las gotas; después la lluvia calla un tiempo
	Origin: "Las gotas contra la sombrilla ya son un tambor. El talismánico oyó el truco: si no fallas ni un tiempo, el octavo es el más sonoro"
	Power: "«Tambor de lluvia» Sobre la sombrilla cuelga un anillo de siete puntos: si en siete tiempos seguidos al menos una gota impacta en cada uno, el octavo inflige x3 de daño en todas las gotas, como un redoble; si fallas un tiempo, se cuenta de nuevo"
	Burden: Tras el redoble, la lluvia calla un tiempo
}

KikasaTalismanNi: {
	DisplayName: Talismán tricolor
	Tooltip: "Las gotas de tinta rotan tres colores: rojo estalla, cian ralentiza, violeta vulnera; el daño de gota baja un poco"
	Origin: "Que la tinta tenga cinco colores es jerga del oficio; el talismánico solo podía permitirse tres. Aun así, el rojo explota, el cian ata y el violeta corroe: basta"
	Power: "«Tricolor» Las gotas de tinta rotan tres colores en orden: las rojas estallan en un área pequeña (40% de daño de salpicadura), las cianes ralentizan un 15% y las violetas hacen que el enemigo reciba +5% de daño de tinta"
	Burden: Daño de las gotas de tinta -5%
}

KikasaTalismanWen: {
	DisplayName: Talismán de escritura de nubes
	Tooltip: Tres estrellas-talismán en el borde de la sombrilla se cargan con cada impacto y, al llenarse, se lanzan solas como saetas de tinta rastreadoras; el ritmo de la lluvia se ralentiza un poco
	Origin: "La escritura de nubes es la letra que el Dao pone en las nubes; un mortal no puede copiarla. El talismánico copió lo que pudo: los caracteres no salieron bien, pero aprendieron a volar"
	Power: «Escritura de nubes» Tres estrellas de escritura de nubes rodean el borde de la sombrilla; cada impacto de gota las carga; al llenarse, la estrella de turno se lanza sola como una saeta de tinta rastreadora (120% del daño de gota)
	Burden: Intervalo de la lluvia +8%
}

KikasaTalismanPo: {
	DisplayName: Talismán de alma lunar
	Tooltip: De noche los impactos llenan la luna; en luna llena la siguiente cascada de tinta se vuelve cascada lunar; de día no hace nada
	Origin: "El talismánico practicaba de noche y vio una luna pequeña sobre la sombrilla: cuantos más golpes, más redonda. Si la criaba hasta el quince, justo caía una buena cascada"
	Power: "«Alma lunar» De noche cuelga una luna de tinta sobre la sombrilla y se llena con cada impacto; en luna llena la siguiente cascada se vuelve cascada lunar: anchura x1.5, los golpes dejan estallidos de marca lunar (35% de daño de salpicadura)"
	Burden: Este talismán no hace nada de día
}

KikasaTalismanXiao: {
	DisplayName: Talismán de los Nueve Cielos
	Tooltip: La sombrilla suspendida sube a gran altura; las gotas caen más rápido y duelen más; el ritmo de la lluvia se ralentiza un poco
	Origin: La misma gota, desde el alero, solo salpica; desde los Nueve Cielos abre un cráter. El razonamiento del talismánico era así de sencillo
	Power: "«Nueve Cielos» La altura de la sombrilla suspendida se duplica; las gotas caen en picado desde lo alto: velocidad terminal +40%, daño +25%, y en el punto de caída aparece primero un anillo de sombra de lluvia"
	Burden: Intervalo de la lluvia +10%
}

KikasaTalismanMei: {
	DisplayName: Talismán de lluvia de moho
	Tooltip: Las gotas cuelgan moho que sangra; al morir, un enemigo mohoso infecta a los de alrededor con esporas; el impacto directo es un poco más leve
	Origin: La lluvia de ciruelo duró cuarenta días y el cofre de talismanes crió moho. El talismánico no quiso limpiarlo. Si lo crió la lluvia, también cuenta como de la casa
	Power: «Lluvia de moho» Las gotas de tinta aplican «corrosión de moho» (hasta diez capas, sangrado por capas); al morir, un enemigo mohoso escupe una niebla de esporas que transmite la mitad de las capas a los enemigos cercanos e inflige un poco de daño
	Burden: Daño directo de las gotas de tinta -10%
}

KikasaTalismanPi: {
	DisplayName: Talismán de trueno celestial
	Tooltip: Tras verter una cascada de tinta, durante diez segundos las gotas a veces llaman un rayo que cae en vertical; los surtidores son un poco más leves
	Origin: Los Cinco Truenos del Dao dicen «llamar al rayo con la lluvia». El talismánico no aprendió bien el oficio y solo se quedó con la segunda mitad. Aun así, de lluvia no le faltaba
	Power: "«Trueno celestial» Cada vez que vanas una cascada de tinta se abre una ventana de diez segundos: dentro de ella, las gotas tienen un 20% de llamar un rayo que cae en el punto de impacto (180% de daño, atraviesa todo el trayecto del rayo)"
	Burden: Daño de los surtidores de tinta -20%
}

KikasaTalismanXia: {
	DisplayName: Talismán de bruma incendiada
	Tooltip: Al amanecer y al atardecer el daño de tinta se dispara y las gotas encienden llama de bruma; al mediodía y en plena noche baja un poco
	Origin: "La bruma es lluvia que arde en el horizonte. El talismánico recogió un puñado antes del alba: el papel se tostó, pero el talismán quedó"
	Power: «Bruma incendiada» Durante hora y media antes y después del alba y del ocaso, el daño de tinta +18% y las gotas encienden «llama de bruma», una quemadura breve; en esas horas todo el equipo de lluvia se tiñe de naranja dorado
	Burden: Al mediodía y en plena noche el daño de tinta -6%
}

KikasaTalismanJi: {
	DisplayName: Talismán de cielo despejado
	Tooltip: Mientras sostienes la sombrilla, los impactos acumulan serenidad; al recogerla, un haz de luz celestial cae sobre el cursor; durante la apertura el daño de tinta baja un poco
	Origin: En el instante en que escampea, por la rendija de las nubes cae una columna de luz. El talismánico esperó medio mes y, antes de que las nubes se cerraran, la calcó en el talismán
	Power: «Despejar» Los impactos con la sombrilla abierta acumulan serenidad; al recogerla, las nubes se abren un instante y un haz de luz celestial cae sobre el cursor; el daño se calcula según lo acumulado y, al llenarse, es el más feroz
	Burden: Mientras la sombrilla está abierta, el daño de tinta -8%
}

KikasaTalismanYu: {
	DisplayName: Talismán de danza Yu
	Tooltip: "Los impactos acumulan ofrendas; al llenarse se abre el altar y se danza: lluvia densa, gotas feroces, charcos y surtidores a pleno; al terminar, tres surtidores a la vez; fuera del gran rito, todo es un poco más romo"
	Origin: "Los antiguos pedían lluvia alzando un altar y danzando, con las ocho músicas completas; a ese rito lo llamaban «danza Yu». El talismánico metió todo el ceremonial en un solo talismán: la sombrilla es la bruja, la lluvia es la respuesta"
	Power: "«Gran Yu» Los impactos de la lluvia de tinta acumulan ofrendas; al llenarse se abre el altar y entra «Gran Yu» diez segundos: el intervalo de la lluvia se reduce a la mitad, las gotas se tiñen de tinta iris y su daño +15%, todas dejan charco al caer y los surtidores se abren del todo; al terminar, tres surtidores brotan a la vez bajo la sombrilla"
	Burden: Fuera del Gran Yu, el daño de tinta -10%
}

SHPCItem: {
	DisplayName: SHPC
	Tooltip: ""
}

AvalancheM60: {
	DisplayName: Avalancha M60
	Tooltip:
		'''
		Usa bolas de nieve como munición
		Dispara gran cantidad de bolas de nieve; el fuego se intensifica a medida que baja la munición
		Cada 20 disparos entra en una ráfaga de sobreclock y provoca una pequeña avalancha
		"Dianci, vamos a una guerra de nieve"
		'''
}

CrystalDimming: {
	DisplayName: Era glacial
	Tooltip:
		'''
		Usa bolas de nieve como munición
		Dispara proyectiles de cristal de hielo; en el suelo del impacto se alzan pilares de glaciar
		Cerca de un racimo ya existente, el pilar crece más alto
		Clic derecho libera una onda de avance glacial que levanta a lo largo del suelo una cresta de hielo cada vez más alta
		"La tierra recuerda cada vez que se congeló"
		'''
}

DarkFrostSolstice: {
	DisplayName: Divinidad del invierno
	Tooltip:
		'''
		Usa bolas de nieve como munición
		Dispara granizo y fuego espectral polar; los ataques tienen probabilidad de congelar al enemigo
		Cada 20 disparos entra en una ráfaga de sobreclock y genera un pilar de hielo enorme en el cursor
		'''
}

SnowQuay: {
	DisplayName: Víbora de nieve
	Tooltip:
		'''
		Usa bolas de nieve como munición
		Mantén clic izquierdo para soplar nieve y lanzar un chorro denso contra los enemigos
		Mientras soplas, acumulas presión en la cámara de nieve
		Al soltar, si hay presión suficiente, disparas una gran bola de nieve compactada
		"La alegría del invierno empieza con un soplador de nieve"
		'''
}

NeutronGlaive: {
	DisplayName: Tajo del dominio negro
	Tooltip:
		'''
		Al blandirla dispara una poderosa onda de espada gravitatoria que, al golpear, provoca una explosión de estrella de neutrones
		Clic derecho carga con la espada alzada; al soltar con la carga completa desatas una gran explosión de estrella de neutrones en el cursor
		Si sueltas antes de terminar, la energía se vierte de golpe
		'''
}

NeutronBow: {
	DisplayName: Cuerda de Roche
	Tooltip:
		'''
		Dispara flechas de gravedad que, al impactar, generan varios rayos gamma
		Clic derecho carga en tres niveles; al llenar la energía dispara tres poderosas flechas gravitatorias
		'''
	Lang1: Capturando gravedad
	Lang2: Doblegando la gravedad
	Lang3: ¡Listo!!
}

NeutronGun: {
	DisplayName: Cazador estelar
	Tooltip:
		'''
		Dispara proyectiles de gravedad que, al impactar, generan un punto de distorsión
		Clic derecho cambia a modo francotirador y dispara balas gravitatorias más potentes; al impactar hacen caer varios rayos gamma
		Cada disparo carga el arma; al llenarse, el siguiente dispara una explosión de estrella de neutrones en el cursor
		"¡Derriba el sol!"
		'''
}

NeutronWand: {
	DisplayName: Luz de la tumba estelar
	Tooltip:
		'''
		Clic izquierdo lanza un púlsar hacia el cursor; se frena, se detiene y gira cada vez más rápido
		Los dos haces de sus polos barren el campo al girar; como máximo pueden quedar tres a la vez
		Mantén clic derecho para aplicar freno magnético: la energía cinética del giro se comprime en la corteza
		Al soltar se produce un seísmo estelar: la corteza se rompe, la magnetosfera se reconecta y las estrellas que sobreviven entran en sobreclock
		"Aquel psíquico quiso comprimir estrellas en agujeros negros, pero lo que obtuvo fueron restos detenidos en degeneración.
		Dejó una a una sus obras fallidas en el Vacío; los nómadas llaman a esa región la tumba estelar"
		'''
}

NeutronScythe: {
	DisplayName: Emisario del agujero negro
	Tooltip:
		'''
		Hoces de neutrones que giran a gran velocidad; en vuelo disparan rayos gamma al enemigo más cercano y dejan varios puntos de distorsión explosiva a lo largo de la trayectoria
		Clic derecho libera una explosión de agujero negro y lanza a la vez trece hoces en todas direcciones
		'''
}

RebelBlade: {
	DisplayName: Hoja rebelde
	Tooltip:
		'''
		El cuerpo a cuerpo verdadero genera gran cantidad de orbes demoníacos alrededor del objetivo
		Clic derecho dirige el vuelo de la hoja y taja hacia el cursor
		'''
}

MG42: {
	DisplayName: MG42
	Tooltip:
		'''
		El fuego continuo sobrecalienta el cañón
		Convierte las balas de mosquete en proyectiles perforantes
		'''
}

DragonsWord: {
	DisplayName: Palabra del dragón
	Tooltip:
		'''
		Dispara lágrimas de dragón que, tras girar un rato, persiguen a los enemigos
		Clic derecho lanza en el cursor el hechizo de la orden del dragón y dicta la muerte a los enemigos del área
		"Un dragón solo puede llorar una vez en la vida"
		'''
}

SnowQuayMK2: {
	DisplayName: Víbora de nieve MK2
	Tooltip:
		'''
		Usa bolas de nieve como munición
		Una variante militar con compresor de refrigeración que funde las bolas de nieve en conos de hielo de alta velocidad
		Clic izquierdo dispara ráfagas de tres clavos de hielo; el último de cada ráfaga es un cono pesado que estalla en cristales al impactar
		Clic derecho dispara una ráfaga de sobrepresión: un abanico de conos de corto alcance
		"La segunda generación de la Víbora de nieve ya no necesita calentamiento"
		'''
}

JusticeUnveiled: {
	DisplayName: Manifestación de la justicia
	Tooltip:
		'''
		Los ataques a distancia acumulan usos de «Golpe de justicia», hasta un máximo de cinco
		Pulsa [UP] para gastar uno y convocar un impacto sagrado gigante que aplasta a los enemigos
		"Si la justicia es necesaria, iré a donde haga falta"
		'''
}

WeaverGrievances: {
	DisplayName: Rencor entrelazado
	RitualInteractHint: "[Clic derecho] Extrae este cuchillo"
	RitualInventoryFullHint: La mochila está llena; deja un hueco antes de extraer el cuchillo
	Tooltip:
		'''
		Libera gran cantidad de garras de alma rencorosa; tiene efectos especiales en el Inframundo y la mazmorra
		Los tajos siguen un combo de tres tiempos; el tercero se convierte en un remate circular de gran alcance
		Clic derecho rueda hacia el cursor y te vuelves un molino de almas rencorosas; chocar con un enemigo durante la rodada te otorga fotogramas de invencibilidad
		Una rodada a corta distancia cuenta como una esquiva perfecta
		[legend]
		'''
	Legend:
		'''
		La mazmorra, inmutable desde tiempos inmemoriales, se extiende por la tierra; sus muros están grabados con inscripciones y alaridos de guerreros antiguos. Cada ladrillo rezuma rencor estancado, como cadenas de almas que los atan a una noche sin fin al cabo del tiempo.
		Aquellos guerreros fueron el filo del rey y combatieron por él en todos los confines. El brillo de sus espadas iluminó incontables campos; su sangre alzó la grandeza de Terra. Su lealtad era tan eterna como las estrellas, su fe tan firme como el hierro.
		Sin embargo, cuando la guerra terminó y el estandarte del Señor de los Demonios se rasgó a los pies del rey, en el instante mismo en que llegó la paz, el rey ordenó arrojarlos al abismo oscuro.
		«¡Nosotros no traicionamos; el rey nos traicionó a nosotros!» El lamento de las almas rasgó el Vacío y atravesó el silencio de los eones. Sus espíritus no volvieron al polvo: quedaron presos en el abismo de la nada, testigos de la noche eterna.
		Aquellos llantos que no cesaban se volvieron una acusación muda, clavada hasta el confín del éter.
		Dicen que el rey, temeroso de su lealtad y de su ira, escuchó el susurro de los hechiceros del Señor de los Demonios y eligió convertir a aquellos guerreros en sombra de la historia.
		Pero el rencor, como una marea, torció la realidad de la mazmorra. Su dolor sacudió la barrera del tiempo y tejió una profecía de venganza:
		«¡El Señor de los Demonios volverá, el Vacío se rasgará y nuestra llama de ira lo quemará todo!»
		Cuando Terra vuelva a enfrentarse a la aniquilación, estos muertos se alzarán de la oscuridad. Sus espadas ya no lucharán por la gloria de Terra, sino para juzgar a los traidores.
		Gloria y lealtad hace tiempo que se extinguieron; la llama de la venganza lo devorará todo.
		'''
}

Starship: {
	DisplayName: Gran nave de las estrellas
	Tooltip:
		'''
		El fuego continuo acumula calor y la cadencia sube con él
		Clic derecho gasta munición para cargar un proyectil cometa; el siguiente disparo lo lanza, inflige gran daño y aplica Superdescomposición
		Al alcanzar el calor máximo, dos escoltas te acompañan, persiguen y disparan balas estelares, y periódicamente lanzan proyectiles planetarios a tu espalda
		Soltar el disparo desencadena el final: 14 meteoritos rastreadores que ignoran la defensa y una minigalaxia se vierten sobre el cursor
		'''
}

SandDagger: {
	DisplayName: Daga de arena oculta
	Tooltip:
		'''
		Se lanza en línea recta y, en vuelo, la gravedad la hace caer un poco
		Al chocar con el suelo se clava; si entra en arena, carga hacia arriba, detona una onda de choque de las venas de la tierra y dispara púas de arena
		'''
}

UnderTheSand: {
	DisplayName: Bajo la arena
	Tooltip:
		'''
		Lanza un par de oleadas de arena que, en vuelo, caen por la gravedad
		Al tocar el suelo se alza de golpe una púa de arena que lanza al aire a los enemigos que toca
		'''
}

WastelandFang: {
	DisplayName: Colmillo del yermo
	Tooltip:
		'''
		Rebota al chocar con bloques y se recoge acelerando
		Abre la boca y escupe varios orbes de arena
		'''
}

MelodyTheSand: {
	DisplayName: Melodía en la arena
	Tooltip:
		'''
		Dispara un pequeño tornado de arena que cae al suelo por la gravedad
		Al aterrizar recorre el suelo de un lado a otro y, al chocar con un muro o al acabarse el suelo, gira al instante
		Enrolla sin cesar a los enemigos que golpea y los eleva
		'''
}

SandVortexOfTheDecayedSea: {
	DisplayName: Vórtice de arena del mar podrido
	Tooltip:
		'''
		Hace caer en el cursor un vórtice de mar profundo corrompido
		El vórtice absorbe y desgarra sin cesar a los enemigos del área y perturba los proyectiles enemigos
		Periódicamente lanza perlas de mar profundo corrompidas que persiguen
		Haz clic de nuevo para refrescar el vórtice existente; al disiparse de forma natural estalla un anillo de perlas
		"Arrastrado por el rugido podrido del mar profundo"
		'''
}

DuneStalker: {
	DisplayName: Acechador de las dunas
	Tooltip:
		'''
		Dispara una cabeza de gancho arrastrada por cadenas en lugar de la munición
		La cabeza desgarra a los enemigos a su paso y, al impactar o al llegar al límite de alcance, se recoge sola
		'''
}

SeasonalKunai: {
	DisplayName: Kunai de las estaciones
	Tooltip:
		'''
		Lanza de una vez cuatro kunai principales en abanico, de alta penetración, que se abren al volar
		Al impactar o al agotarse se parten en tres hojas menores que barren en abanico
		De día aplica quemadura del alba; de noche, decadencia nocturna
		"Reflejo de las cuatro estaciones"
		'''
}

WraithKunai: {
	DisplayName: Kunai espectral
	Tooltip:
		'''
		Lanza de una vez tres cuchillos escarlata en abanico: vuelan rápido, se detienen un instante y luego se lanzan desde lejos contra el enemigo más cercano
		Al impactar en la carga provocan un choque escarlata y sacuden la pantalla; al agotarse estallan en una ola de fuego de almas
		De día aplica quemadura; de noche, combustión del alma
		'''
}

CalSelfPortrait: {
	DisplayName: Foto olvidada
	Tooltip:
		'''
		Una foto que alguien olvidó
		[legend]
		'''
	Legend: "¿Y qué más querías ver? :)"
}

WUTIVSelfPortrait: {
	DisplayName: Gracias, Wuti
	Tooltip: ""
}

HandmadeDoll: {
	DisplayName: Muñeco cosido a mano
	Tooltip:
		'''
		Úsalo en el Inframundo para invocar al Muro carnoso
		Si el Guía está vivo, será sacrificado al usarlo
		"Hecho a mano; el Guía no se enteró"
		'''
}

ScapegoatDoll: {
	DisplayName: Muñeco sustituto
	Tooltip:
		'''
		En la mochila, puede bloquear una muerte por ti
		Tras bloquearla, el muñeco se rompe y desaparece
		'''
	ShatterText: El muñeco sustituto se ha roto
}

Snowblindness: {
	DisplayName: Ceguera de nieve
	Tooltip:
		'''
		Dispara a alta cadencia bolas de nieve y rayos polarísimos
		Al golpear a un enemigo genera varios rayos polarísimos EX a su alrededor
		"Perdido en la ventisca, espera eterna, mapa del sufrimiento, adelantamiento en la curva,
		lentes agrietadas por el hielo, sangre seca, hielo rojo, castor que llora, silueta en el hielo"
		'''
}

WhiplashGalactica: {
	DisplayName: Flagelo galáctico
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		Al golpear a un enemigo lo marca con la muerte y dispara bolas de fuego cósmico
		"La columna de aquella serpiente cósmica, rebosante de energía del universo, guía la ira del cosmos"
		'''
}

FocusingGrimoire: {
	DisplayName: Grimorio de concentración
	Tooltip:
		'''
		Clic izquierdo dispara anillos térmicos rastreadores que marcan al objetivo al impactar
		Clic derecho dispara con rapidez un rayo de la muerte; si golpea a un objetivo marcado, inflige daño extra y critica de forma garantizada
		"Uno vale por seis"
		'''
}

CommandersStaff: {
	DisplayName: Bastón del comandante
	Tooltip:
		'''
		Dispara un rayo de descomposición térmica que atraviesa enemigos
		"Arrancado del brazo de aquella máquina. ¿Y si en vez de diésel usamos psíquica?"
		'''
}

RaiderGun: {
	DisplayName: Asaltante
	Tooltip:
		'''
		Convierte las balas de mosquete en balas de alta velocidad
		Clic derecho permite una rodada-embestida y recarga el cargador
		La primera bala tras la rodada se convierte en una granada del Destructor
		"Ideal para rescates de rehenes en interiores"
		'''
}

HyperionBarrage: {
	DisplayName: Cañón automático Hyperion
	Tooltip:
		'''
		Dispara misiles de crucero térmicos que, al impactar, estallan y prenden a los enemigos
		Cada cuarto gatillazo se convierte en una salva vertical de tres misiles que se lanzan en picado hacia el punto de mira
		"Que cada cosa dé de sí"
		'''
}

RaiderGunEX: {
	DisplayName: Asaltante EX
	Tooltip:
		'''
		Convierte las balas de mosquete en balas de alta velocidad
		Dispara además gran cantidad de proyectiles homing del Destructor
		Clic derecho permite una rodada-embestida y recarga el cargador
		La primera bala tras la rodada se convierte en una granada del Destructor
		"Bombardeo sin tregua"
		'''
}

CommandersChainsaw: {
	DisplayName: Motosierra del comandante
	Tooltip:
		'''
		Al golpear al objetivo genera chispas
		"Échale más diésel"
		'''
}

GeminisTribute: {
	DisplayName: Ofrenda de los Gemelos
	Tooltip:
		'''
		Lanza por turnos hoces del Ojo láser y del Ojo de llama demoníaca que cortan de ida y vuelta en una onda senoidal
		Clic derecho suelta ambas hoces a la vez en cruce; en el impacto se condensa un ojo fusionado que dispara pulsos bicolores a su alrededor
		"Solo puede haber una personalidad principal, y está claro que ganó el Ojo de llama"
		'''
}

Dicoria: {
	DisplayName: Doble pupila
	Tooltip:
		'''
		Dispara dos balas a la vez; el disparo se puede cargar
		Al llenar la carga dispara un rayo térmico
		"Oye, ¿así no nos vamos a quedar bizcos?"
		'''
}

DestroyersBlade: {
	DisplayName: Hoja del Destructor
	Tooltip:
		'''
		Dispara proyectiles térmicos
		"Encierra el poderoso núcleo energético del Destructor"
		'''
}

Observer: {
	DisplayName: Observador
	Tooltip: "\"Sigue mirándote\""
}

StaffoftheDestroyer: {
	DisplayName: Bastón invocador del Destructor
	Tooltip:
		'''
		Invoca un Destructor en miniatura para que luche por ti
		Cuanto más alto sea el límite de invocaciones, más fuerte será el Destructor
		Necesita al menos 4 ranuras de invocación
		'''
}

EyekiteStaff: {
	DisplayName: Cometa del ojo atado
	Tooltip:
		'''
		Invoca un pequeño Ojo de Cthulhu atado a ti con hilos de sangre roja y blanca
		Vaga por el aire como una cometa: a veces forcejea por huir y el hilo lo arrastra de vuelta
		Si hay enemigos cerca, se lanza a embestirlos y el hilo de sangre lo recupera de un tirón como remate
		Puedes invocar varios a la vez
		'''
}

BloodshotBomb: {
	DisplayName: Granada del ojo lloroso
	Tooltip:
		'''
		Al sostenerla se enciende la mecha; hay tres etapas, unas dos segundos cada una
		Cuanto más corta es la mecha, más rojo se congestiona el ojo, más violenta es la explosión y más carne salpica
		Clic izquierdo para lanzarla en cualquier momento: explota al tocar algo, y solo al morder carne escupe fragmentos
		Si la mecha se agota y no la sueltas, explota en tu mano
		"No quiere dejarte"
		'''
	SelfBoom: "{0} miró una vez de más"
}

Eyetooth: {
	DisplayName: Colmillo del ojo lloroso
	Tooltip:
		'''
		Lanza hacia los enemigos un colmillo arrancado del Ojo de Cthulhu
		Tras morder a un enemigo, el dardo se planta sobre su cabeza, enfoca un instante y se lanza a un segundo mordisco
		El mordisco en picado inflige 150% de daño y la herida del colmillo sigue sangrando
		'''
}

Shatterfang: {
	DisplayName: Hoja de colmillo roto
	Tooltip:
		'''
		Tres tajos normales y un tajo de choque que desgasta mucho la hoja
		El tajo que agota la hoja la rompe en el acto y lanza un gran fragmento de diente
		Entre tajos normales suelta de vez en cuando dientes menores afectados por la gravedad
		Con la media hoja los tajos son más ligeros, pero el daño baja y ya no dispara fragmentos
		El ataque continuo también desestabiliza la hoja hasta que se rompe en silencio
		Clic derecho dedica un momento a repararla; en reposo también sana con lentitud y, al llenarse, suena un tintineo
		"Un colmillo caído de la boca del demonio ocular, que aún guarda la obsesión de morder"
		'''
}

CommandersClaw: {
	DisplayName: Pinza del comandante
	Tooltip:
		'''
		Lanza una lanza ornamental del comandante cuya punta siempre mira en la dirección del vuelo
		Al impactar estalla en chispas metálicas y una onda de choque, y sacude un poco la pantalla
		Pueden existir varias lanzas a la vez; al chocar con un muro se clavan en el terreno y, al atravesar a un enemigo, se quedan un instante adheridas
		'''
}

CommandersStaffEX: {
	DisplayName: Bastón del comandante EX
	Tooltip:
		'''
		Dispara cinco rayos sobrecargados que convergen en anillo y cortan al girar
		"Sirve para cortar metal"
		'''
}

CommandersChainsawEX: {
	DisplayName: Motosierra del comandante EX
	Tooltip: "\"Tritura todo lo que se interponga\""
}

SoulofFrightEX: {
	DisplayName: Alma del terror EX
	Tooltip:
		'''
		En su interior palpita el poder concentrado del terror
		Se obtiene al derrotar máquinas rebeldes durante el Motín Mecánico
		'''
}

SoulofMightEX: {
	DisplayName: Alma del poder EX
	Tooltip:
		'''
		En su interior palpita el poder concentrado de la destrucción
		Se obtiene al derrotar máquinas rebeldes durante el Motín Mecánico
		'''
}

SoulofSightEX: {
	DisplayName: Alma de la visión EX
	Tooltip:
		'''
		En su interior palpita el poder concentrado de la sabiduría
		Se obtiene al derrotar máquinas rebeldes durante el Motín Mecánico
		'''
}

DestroyersBladeEX: {
	DisplayName: Hoja del Destructor EX
	Tooltip:
		'''
		Un tajo pesado que abre un corte negro y rojo envuelto en haces rojos y blancos y proyectiles sombra
		Tras envainar un instante entra en el Protocolo de acecho: sube la velocidad de movimiento y te acercas a la presa
		Durante el acecho, clic derecho te conviertes en la cabeza del Destructor y muerdes a la presa; sin objetivo, embistes hacia el cursor
		Una mordida exitosa inflige daño enorme y entra en el Protocolo de aniquilación:
		Los proyectiles se potencian del todo y persiguen; el tajo final escupe además una cabeza del Destructor
		"Destruir siempre es más fácil que construir"
		'''
}

ThermalGenerator: {
	DisplayName: Generador térmico
	Tooltip:
		'''
		Introduce combustible para generar electricidad
		Clic derecho en el bloque inserta combustible con rapidez; Mayús + clic derecho lo extrae
		'''
}

ThermalBattery: {
	DisplayName: Batería térmica
	Tooltip: Almacena una cantidad de energía eléctrica
}

FluidPipeline: {
	DisplayName: Tubería de líquidos
	Tooltip:
		'''
		Transporta agua, lava, miel o Shimmer
		Una tubería solo lleva un líquido a la vez; hay que vaciarla antes de cambiar a otro
		Clic derecho para desmontarla con rapidez
		'''
}

FluidPump: {
	DisplayName: Bomba de líquidos
	Tooltip:
		'''
		Al recibir corriente extrae el líquido del mundo bajo la máquina y lo guarda en su tanque interno
		Cada casilla extraída consume 2 UE; el líquido viaja por tuberías hacia tanques o máquinas
		'''
}

FluidTank: {
	DisplayName: Depósito de líquidos
	Tooltip:
		'''
		Almacena hasta 32 casillas de líquido; la ventanilla del depósito muestra el nivel
		Se comunica con bombas y máquinas a través de tuberías de líquidos
		Al desmontarlo, el líquido del interior se pierde
		'''
}

LargeFluidTank: {
	DisplayName: Depósito de líquidos grande
	Tooltip:
		'''
		Almacena hasta 128 casillas de líquido; la ventanilla del depósito muestra el nivel
		Se comunica con bombas y máquinas a través de tuberías de líquidos
		Al desmontarlo, el líquido del interior se pierde
		'''
}

CircuitBoard: {
	DisplayName: Placa de circuitos
	Tooltip: Componente electrónico básico de las máquinas industriales
}

FluidInjector: {
	DisplayName: Inyector de líquidos
	Tooltip:
		'''
		Consume el líquido almacenado y lo vierte en el mundo bajo la máquina
		Cada casilla colocada consume 2 UE
		Al colocar lava, vigila dónde pisas
		'''
}

BottlingMachine: {
	DisplayName: Envasadora
	Tooltip:
		'''
		Si introduces botellas o cubos vacíos, extrae líquido almacenado y los llena; si introduces recipientes llenos, los vacía y recupera el líquido
		Cada operación consume 5 UE; el producto se retira de la ranura de salida
		Las ranuras de entrada y salida pueden conectarse a tuberías de objetos para cargar y descargar solas
		'''
}

MagmaThermalGenerator: {
	DisplayName: Generador térmico de magma
	Tooltip:
		'''
		Si el cuerpo toca lava, genera con lentitud; si el tanque tiene reserva de magma, genera a pleno rendimiento
		El magma puede llegar por tuberías de líquidos o verterse con un cubo de lava mediante clic derecho
		La primera fuente de energía principal de una fábrica en el Inframundo
		'''
}

FluidText: {
	WaterName: Agua
	LavaName: Lava
	HoneyName: Miel
	ShimmerName: Shimmer
	EmptyName: Vacío
	BarFormat: "{0} {1}/{2}"
}

ShimmerTransmuter: {
	DisplayName: Cuba de transmutación de Shimmer
	Tooltip:
		'''
		Introduce un objeto y gasta Shimmer para transmutarlo; el producto cae en la ranura de salida
		Cada transmutación consume 10 UE y 64 unidades de Shimmer; el Shimmer debe bombearse desde un lago a través de tuberías
		Admite transmutación de objetos y descomposición de recetas; no acepta monedas ni objetos que suelten criaturas
		Las ranuras de entrada y salida pueden conectarse a tuberías de objetos para cargar y descargar solas
		'''
}

WindGrivenGenerator: {
	DisplayName: Generador eólico
	Tooltip: Se mueve con el viento y produce electricidad
	UnderstandWindGriven: Hace falta una idea inicial de cómo funciona la energía eólica
	UnderstandWindGriven2: Hay que extraer aerogeneradores viejos en los asteroides para entender cómo se fabrican
}

WindGrivenGeneratorMK2: {
	DisplayName: Generador eólico MK2
	Tooltip: Se mueve con el viento y produce electricidad
	UnderstandWindGrivenMK2: Hace falta un conocimiento profundo de cómo funciona la energía eólica
	UnderstandWindGrivenMK2Remind: Hay que extraer las turbinas eólicas gigantes de los asteroides para entender sus principios de fabricación
}

ThermalGeneratorMK2: {
	DisplayName: Generador térmico MK2
	Tooltip:
		'''
		Introduce combustible para generar electricidad
		Clic derecho en el bloque inserta combustible con rapidez; Mayús + clic derecho lo extrae
		'''
}

WGGMK2Wilderness: {
	DisplayName: Generador eólico gigante en la naturaleza
	Tooltip: ""
}

WGGWilderness: {
	DisplayName: Generador eólico en la naturaleza
	Tooltip: ""
}

TeslaElectromagneticTower: {
	DisplayName: Torre electromagnética Tesla
	Tooltip:
		'''
		Necesita electricidad para funcionar
		Tras colocarla en el suelo, clic derecho para alternar entre modo ataque y modo escolta
		El modo ataque dispara arcos eléctricos a los enemigos cercanos
		El modo escolta aplica Electrificado a todos los enemigos del área; si un jugador está dentro
		y sostiene un objeto recargable, la torre le dispara arcos para recargarlo a distancia
		"Ingenieros, no se acerquen"
		'''
}

FlameTurret: {
	TurretOnText: Torre de llamas activada
	TurretOffText: Torre de llamas desactivada
	NoEnergyText: ¡Energía insuficiente!
	FuelLoadText: Gel cargado x{0}
	FuelTakeText: Gel extraído x{0}
	DisplayName: Torre de lanzallamas
	Tooltip:
		'''
		Necesita electricidad para funcionar
		Lanza sin cesar lenguas de fuego a los enemigos que se acercan; las llamas atraviesan grupos y aplican Fuego infernal
		Sostén gel y haz clic derecho en la torre para cargar combustible; al quemar gel el fuego es más feroz
		Mantén Mayús y clic derecho para extraer el gel; las tuberías de objetos también pueden alimentar la ranura de combustible
		Clic derecho con las manos vacías o una señal de cable enciende o apaga la torre
		"Huele a slime asado"
		'''
}

CryoTurret: {
	TurretOnText: Torre de hielo activada
	TurretOffText: Torre de hielo desactivada
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Torre de hielo
	Tooltip:
		'''
		Necesita electricidad para funcionar
		Esparce frío sin cesar a todos los enemigos del área y los ralentiza con escarcha
		Un enemigo cubierto de frío unos dos segundos queda congelado un instante
		Ralentizar y congelar es su oficio; el daño es solo un poco de quemadura de escarcha
		Clic derecho o una señal de cable enciende o apaga la torre
		"Enfríate un poco"
		'''
}

LaserTurret: {
	TurretOnText: Torre láser activada
	TurretOffText: Torre láser desactivada
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Torre láser
	Tooltip:
		'''
		Necesita electricidad para funcionar
		Dispara un haz de alto daño a los enemigos a la vista; el alcance es enorme, pero la cadencia es lenta
		No fija objetivos tapados por el terreno; prioriza a los jefes
		Clic derecho o una señal de cable enciende o apaga la torre
		"Un disparo, uno menos"
		'''
}

ShieldGenerator: {
	FieldOnText: Campo de escudo activado
	FieldOffText: Campo de escudo desactivado
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Generador de escudo
	Tooltip:
		'''
		Necesita electricidad para funcionar
		Mientras funciona con corriente, los jugadores del área obtienen un escudo de energía
		El escudo se carga con lentitud, absorbe parte del daño al recibir un golpe y se disipa al salir del área
		Cuantos más jugadores proteja, más rápido consume electricidad
		Clic derecho o una señal de cable enciende o apaga el campo
		'''
}

HealStation: {
	FieldOnText: Aura de curación activada
	FieldOffText: Aura de curación desactivada
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Estación de curación
	Tooltip:
		'''
		Necesita electricidad para funcionar
		Mientras funciona con corriente, regenera con lentitud la vida de todos los jugadores del área
		Clic derecho o una señal de cable enciende o apaga el aura
		"¿Accidente laboral? Nunca oído"
		'''
}

EmblemOfDread: {
	DisplayName: Emblema del que teme la muerte
	Tooltip:
		'''
		Aumenta un 100% el daño cuerpo a cuerpo
		Aumenta un 100% la probabilidad de crítico cuerpo a cuerpo
		Aumenta un 100% la velocidad de ataque cuerpo a cuerpo
		Aumenta 100 puntos de defensa e ignora toda merma de defensa
		Reduce un 75% el daño recibido y refleja al atacante 100 veces ese daño
		Todos los ataques cuerpo a cuerpo aplican Erosión del Vacío
		Si el enemigo tiene menos de 250 000 de vida, los ataques cuerpo a cuerpo verdaderos pueden borrarlo del todo
		Al moverte a gran velocidad dejas varios puntos de distorsión en el camino que infligen daño extremo a quien los toca
		Obtienes la capacidad de Estocada gravitatoria: pulsa [KEY] para una estocada de gran distancia y suelta gran cantidad de rayos gravitatorios
		Si recibes un golpe letal, recuperas al instante toda la vida y obtienes un escudo gravitatorio; este efecto tiene 60 segundos de enfriamiento
		Los enemigos tienen más probabilidades de apuntarte a ti
		[c/d94fff:"Un ángel santo cubre tus ojos y susurra mentiras eternas y empalagosas"]
		[c/ff4d4d:"El carnicero bañado en sangre toma tus dos hojas y declara que solo la matanza otorga gloria"]
		[c/4da6ff:"Una paloma azul picotea tu frente y se ríe de tu lucha insignificante"]
		'''
}

ElectricMinRocket: {
	DisplayName: Minicohete eléctrico
	Tooltip:
		'''
		Clic derecho para usar el cohete, o colócalo en el suelo y haz clic derecho para despegar
		En el aire, usa izquierda y derecha para ajustar la dirección
		Mantén pulsado abajo para descender con suavidad; el vuelo consume electricidad con lentitud
		Pulsa espacio para interrumpir el vuelo
		"Hecho en la Unión Soviética, sólido y duradero; casi llegó a la Luna"
		'''
}

TeleportStation: {
	NoEnergyText: ¡Energía insuficiente!
	TargetNoEnergyText: ¡La estación de destino no tiene electricidad de espera!
	UnnamedText: Estación sin nombre ({0}, {1})
	DisplayName: Estación de teletransporte
	Tooltip:
		'''
		Forma una red de teletransporte con las demás estaciones del mundo
		Clic derecho abre el panel; pulsa un destino para teleportarte
		El teletransporte consume electricidad según la distancia; la estación de destino también necesita un poco de electricidad de espera
		Puedes nombrar las estaciones para reconocerlas en la lista
		'''
}

ElectricSundial: {
	NoEnergyText: ¡Energía insuficiente!
	BusyText: ¡El tiempo ya está avanzando a toda prisa!
	SkipBroadcast: "{0} activó el reloj de sol eléctrico; el tiempo vuela hasta el amanecer"
	DisplayName: Reloj de sol eléctrico
	Tooltip:
		'''
		Cuando almacena 1000 de electricidad, clic derecho adelanta el tiempo hasta el amanecer
		Tiene su propia fuente y no le afecta el enfriamiento de siete días del Reloj de sol encantado
		Al usarlo avisa a todo el servidor
		'''
}

WeatherController: {
	NoEnergyText: ¡Energía insuficiente!
	RainBroadcast: "{0} activó el controlador del clima; las nubes de lluvia se están reuniendo"
	ClearBroadcast: "{0} activó el controlador del clima; escamparon las nubes"
	DisplayName: Controlador del clima
	Tooltip:
		'''
		Clic derecho gasta 500 de electricidad para hacer llover; si ya llueve, dispersa la lluvia
		Solo manda sobre la lluvia, no sobre el viento
		Al usarlo avisa a todo el servidor
		'''
}

SolarPanel: {
	DisplayName: Panel solar
	Tooltip:
		'''
		Genera de día; al mediodía alcanza el máximo
		Con lluvia la eficiencia cae mucho; durante un eclipse solar se detiene del todo
		Si un bloque sólido le tapa la cabeza, no funciona
		'''
}

SolarPanelMK2: {
	DisplayName: Panel solar MK2
	Tooltip:
		'''
		Genera de día; al mediodía alcanza el máximo, con el triple de eficiencia que el original
		Con lluvia la eficiencia cae mucho; durante un eclipse solar se detiene del todo
		Si un bloque sólido le tapa la cabeza, no funciona
		'''
}

CapacitorMatrix: {
	DisplayName: Matriz de condensadores
	Tooltip:
		'''
		Gran armario de almacenamiento de hasta 40 000 de electricidad
		Su caudal de carga y descarga supera de largo a la batería térmica; es el búfer central de una red grande
		'''
}

UEPipeline: {
	DisplayName: Tubería de energía
	Tooltip:
		'''
		Sirve para transmitir electricidad
		Clic derecho desmonta con rapidez la tubería del punto indicado y la recupera
		Conecta generadores y otras fuentes y lleva la electricidad a baterías u otros aparatos
		'''
}

WireInterface: {
	ModeBridgeText: "Solo puente: al recibir una señal de mecanismo, conmuta las máquinas adyacentes"
	ModeFullText: "Aviso de lleno: emite una señal de mecanismo cuando una máquina adyacente se llena"
	ModeEmptyText: "Aviso de vacío: emite una señal de mecanismo cuando una máquina adyacente se agota"
	MachineOffText: En espera
	MachineOnText: Activo
	DisplayName: Interfaz de mecanismos
	Tooltip:
		'''
		Adaptador bidireccional entre el cable de mecanismos y la red eléctrica
		Al recibir una señal de mecanismo, enciende o pone en espera las máquinas pegadas a él
