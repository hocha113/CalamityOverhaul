	Tooltip:
		'''
		Úsalo en la superficie del desierto para llamar a la Pitón pútrida de arena
		"El capullo no murió; aprendió a supurar"
		'''
}

BloomCaller: {
	DisplayName: Cuerno que llama capullos
	Tooltip:
		'''
		Toca el cuerno y llama a un capullo joven de flor del yermo para que luche a tu lado
		El capullo joven lanza púas que caen hacia los enemigos
		Cada dos lanzamientos, el tercero se convierte en una embestida; tras chocar, gira y abre un anillo de pétalos
		"El cuerno no es una orden; es riego"
		'''
}
