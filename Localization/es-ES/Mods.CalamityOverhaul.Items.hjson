FungalFeed: {
	DisplayName: Pienso fúngico
	Tooltip:
		'''
		Puedes lanzárselo a un cangrejo micótico para domesticarlo
		El cangrejo domesticado te sigue y combate a tu lado
		Puedes equiparle una [i:CalamityOverhaul/MushroomSaddle]silla de champiñón y convertirlo en montura
		"Lo que más les gusta son los champiñones"
		'''
}

MushroomSaddle: {
	DisplayName: Silla de champiñón
	Tooltip:
		'''
		Se puede equipar en un cangrejo micótico domesticado con [i:CalamityOverhaul/FungalFeed]pienso fúngico
		Sostén la silla y haz clic izquierdo en el cangrejo para equiparla
		Clic derecho en un cangrejo con silla para montarlo
		'''
	UseCombat: Solo se puede colocar en un cangrejo micótico
}

EncyclopediaofOceanicKnowledge: {
	DisplayName: Enciclopedia del saber oceánico
	Tooltip:
		'''
		Al usarla, comprendes al instante todo el saber de los peces
		Desbloquea todas las habilidades de peces
		[c/FFD700:La sabiduría del océano se reunirá en ti]
		'''
	Text1: Ya dominas todo el saber
	Text2: ¡Has aprendido [NUM] saberes de peces!
}

TheForgottenTome: {
	DisplayName: Libro del mundo olvidado
	Tooltip:
		'''
		Al usarlo, olvidas al instante todas las vivencias de este mundo
		Rostros de vivos y muertos, caída sin fondo, todos los seres son culpa, no hay otro mundo
		Me llamo [NAME]; cuando leas esto, ya estaré muerto
		'''
	CompletionText: Ya lo has olvidado todo
	ConditionsText: Alcanza cualquier final argumental
}

Fishoil: {
	DisplayName: Aceite de pescado embotellado
	Tooltip:
