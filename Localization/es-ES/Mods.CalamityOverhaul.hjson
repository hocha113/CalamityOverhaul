# For Language Pack Creators:
# The keys here were previously in Items. Since EcTypeItem has been removed, all localization keys similar to "ItemNameEcType" have been moved here.
# The corresponding format is "ItemNameEcType" → "RItemName" or "ItemNameOverride".
# Apart from the class name change, the DisplayName and Tooltip remain the same as in the previous version.
# So if you need to migrate your language pack to the new version, simply copy and paste the entries here and update the class names accordingly.

Arcanes: {
	Items: {
		ArcaneTransformer: {
			DisplayName: Transformador arcano
			Tooltip: ""
		}
	}
}

Resurrections: {
	ResurrectionDeath: {
		DeathText: "{0} murió por la Resurrección del Abismo"
		WarningCombatText: El Abismo te está consumiendo...
		DeathNoticeText: Has sido consumido por el Abismo...
		MarkRemainText: La marca del Abismo aún te envuelve...
		RetainValueFormat: Valor de resurrección: {0}%
	}
}

QuickHack: {
	SynapseBurn: {
		DisplayName: Quemadura sináptica
		Description: Sobrecarga las sinapsis neuronales del objetivo, infligiendo daño térmico continuo
	}

	ShortCircuit: {
		DisplayName: Cortocircuito
		Description: Libera un pulso electromagnético que inflige daño instantáneo y una breve parálisis
	}

	Cyberpsychosis: {
		DisplayName: Ciberpsicosis
		Description: Sumerge al objetivo en un frenesí y lo hace atacar a todas las unidades cercanas
	}

	SystemReset: {
		DisplayName: Reinicio del sistema
		Description: Fuerza un reinicio del sistema del objetivo, paralizándolo por completo
	}

	OpticOverload: {
		DisplayName: Sobrecarga óptica
		Description: Ciega al objetivo, impidiéndole percibir su entorno
	}

	MemoryWipe: {
		DisplayName: Borrado de memoria
		Description: Borra los datos de hostilidad del objetivo y restablece su lista de agresión
	}

	Contagion: {
		DisplayName: Propagación
		Description: Implanta un programa malicioso autorreplicante que se extiende a objetivos cercanos
	}

	TileDetonate: {
		DisplayName: Detonación de bloques
		Description: Compromete la integridad estructural y provoca una explosión localizada
	}

	TilePhase: {
		DisplayName: Protocolo de virtualización
		Description: Altera las propiedades físicas de un bloque, volviéndolo intangible durante un tiempo
	}

	TileMagPull: {
		DisplayName: Atracción magnética
		Description: Genera un campo magnético que atrae hacia ti los objetos caídos cercanos
	}

	MachineShortCircuit: {
		DisplayName: Cortocircuito mecánico
		Description: Vacía la energía eléctrica de la máquina objetivo y libera arcos eléctricos que dañan entidades cercanas
	}

	TurretHijack: {
		DisplayName: Secuestro de torreta
		Description: Altera el módulo IFF, invirtiendo temporalmente la lealtad de la torreta
	}

	FalseMemory: {
		DisplayName: Modificación de memoria
		Description: Implanta recuerdos falsos, interrumpiendo brevemente la persecución o suprimiendo su patrón asesino
	}

	SelfDismember: {
		DisplayName: Autodesmembramiento
		Description: Obliga a la anomalía a desmembrarse a sí misma
	}

	SystemHalt: {
		DisplayName: Cuelgue
		Description: Sumerge al objetivo en un silencio temporal y detiene toda actividad
	}

	TurretCircuitOverload: {
		DisplayName: Sobrecarga de circuito
		Description: Inyecta corriente inversa en el circuito de alimentación de la torreta, dejándola totalmente inoperativa durante mucho tiempo
	}

	TurretShortCircuit: {
		DisplayName: Cortocircuito de torreta
		Description: Descarga al instante la energía de la torreta para un breve parón; vuelve a activarse en cuanto se recupera
	}

	VirusBroadcast: {
		DisplayName: Difusión viral
		Description: Inyecta código gusano en la torre de señales, que lanza ondas electromagnéticas cibernéticas y cortocircuita durante mucho tiempo todas las torretas del alcance de la emisión
	}

	MeltdownProtocol: {
		DisplayName: Protocolo de fusión
		Description: Bloquea el circuito de refrigeración; cuatro segundos después sobrecalienta, estalla y alcanza a los enemigos cercanos
	}

	ProjectileHijack: {
		DisplayName: Toma de control balística
		Description: Reasigna el proyectil entrante y lo hace dar la vuelta
	}

	ProjectileFreeze: {
		DisplayName: Congelación balística
		Description: Clava un proyectil en el aire y lo suelta a los cinco segundos
	}

	DataPurge: {
		DisplayName: Purga de datos
		Description: Borra el proyectil entrante y todos los del mismo tipo cercanos
	}

	BallisticOverclock: {
		DisplayName: Sobrefrecuencia balística
		Description: Añade daño, perforación y tiempo de vuelo a uno de tus proyectiles
	}

	Electrolysis: {
		DisplayName: Electrólisis
		Description: Electrifica este líquido; los enemigos sumergidos reciben daño continuo
	}

	Cryostasis: {
		DisplayName: Criostasis
		Description: Congela un trozo de líquido en hielo fino sobre el que se puede pisar; se derrite a los ocho segundos
	}

	LiquidPurge: {
		DisplayName: Drenaje de líquido
		Description: Drena el líquido de alrededor. También funciona con lava
	}

	ItemRecall: {
		DisplayName: Recuperación remota
		Description: Tira del objeto caído hasta tus pies
	}

	Reappraise: {
		DisplayName: Nueva tirada
		Description: Vuelve a tirar el prefijo del equipo que está en el suelo
	}

	ArmorParse: {
		DisplayName: Análisis de armadura
		Description: Reduce la defensa del objetivo a cero durante seis segundos
	}

	Exorcise: {
		DisplayName: Cierre de sesión forzado
		Description: Marca al objetivo para el cierre; al recibir cinco golpes se dispara un golpe grave
	}

	DataLeech: {
		DisplayName: Succión de datos
		Description: Mientras dura, golpear a este objetivo te devuelve RAM, hasta un tope
	}

	SwarmLink: {
		DisplayName: Enlace de enjambre
		Description: Al acertar al objetivo, hasta cinco enemigos cercanos reciben un 30% del daño
	}

	MachineOverclock: {
		DisplayName: Sobrefrecuencia mecánica
		Description: Durante diez segundos sostiene la máquina con una carga fija; al vencer, quema toda la electricidad
	}

	GridBlackout: {
		DisplayName: Apagón de la red
		Description: Usa la torre de señales para cortar la corriente de todas las máquinas en un radio amplio
	}

	PowerTransmute: {
		DisplayName: Conversión de carga
		Description: Convierte la carga del objeto que sostienes en RAM y luego lo vacía
	}

	NeuralOverclock: {
		DisplayName: Sobrefrecuencia neuronal
		Description: Durante ocho segundos atacas más rápido; la RAM deja de recuperarse y pierdes vida sin parar
	}

	WraithForceDrive: {
		DisplayName: Impulso forzado del espectro sirviente
		Description: Durante diez segundos las acciones del espectro sirviente no cuestan nada; luego la Erosión se profundiza y el espectro sirviente duerme
	}

	IndexPreread: {
		DisplayName: Precarga de índice
		Description: Lee todo el contenido sin abrir el recipiente y señala lo más valioso
	}

	LockBurn: {
		DisplayName: Quema de cerradura
		Description: Abre este cofre sin llave; el precio es quemar un objeto de dentro
	}

	DielSkip: {
		DisplayName: Salto diurno
		Description: Avanza el tiempo hasta el amanecer o el atardecer más cercano
	}

	StormInject: {
		DisplayName: Inyección de tormenta
		Description: Llama una tormenta eléctrica; los rayos solo caen sobre enemigos que lleven algún efecto de hackeo
	}

	GravityInvert: {
		DisplayName: Inversión de gravedad
		Description: Invierte la gravedad a tu alrededor; enemigos y objetos caídos caen hacia arriba
	}

	SegmentDelink: {
		DisplayName: Desconexión de segmento
		Description: El daño a este segmento solo se anota; al vencer se liquida el 60% sobre el cuerpo principal
	}

	LimbSeizure: {
		DisplayName: Requisa de miembro
		Description: Hace que este miembro ataque a su propio cuerpo durante ocho segundos
	}

	CommandLinkCut: {
		DisplayName: Corte de enlace
		Description: Corta su enlace con los compañeros; durante diez segundos cada uno pelea por su cuenta
	}

	MunitionSwap: {
		DisplayName: Sustitución de munición
		Description: La torreta dispara la munición de tu inventario y el daño se calcula con el tuyo
	}

	TurretMesh: {
		DisplayName: Red de torretas
		Description: Las torretas cercanas se enlazan y disparan juntas hacia donde apuntas, cuarenta disparos en total
	}

	BeaconForge: {
		DisplayName: Baliza falsa
		Description: La torre de señales emite una falsa llamada de socorro y atrae enemigos de un área amplia
	}

	PrivilegeEscalate: {
		DisplayName: Escalada de privilegios
		Description: Los protocolos cuestan menos, se suben más rápido y no tienen alcance; la RAM no se recupera mientras dura
	}

	ItemSalvage: {
		DisplayName: Desguace
		Description: Desguaza este objeto del suelo y recupera un 60% de los materiales
	}

	DataBrand: {
		DisplayName: Marca de datos
		Description: Copia el prefijo de este equipo y, en el siguiente hackeo, lo imprime en otro
		HudTag: Marca: {0}
		DenyNoPrefix: Este objeto no tiene prefijo que copiar
		DenyIncompatible: El prefijo registrado no encaja en este objeto
	}

	EntityMasquerade: {
		DisplayName: Mascarada
		Description: Hace que este objeto caído parezca un jugador a ojos de los enemigos y reciba el fuego por ti durante treinta segundos
	}

	TileConscript: {
		DisplayName: Requisa de bloques
		Description: Parte estos bloques en ocho placas de armadura que orbitan a tu alrededor y, al vencer, las lanza
	}

	VeinResonance: {
		DisplayName: Resonancia de veta
		Description: Las vetas del mismo mineral se ven a través de las paredes; extraerlas suelta el doble, pero llama a los guardianes
	}

	StressInvert: {
		DisplayName: Inversión de tensión
		Description: Durante diez segundos estos bloques no se pueden romper; los enemigos que chocan contra ellos reciben daño
	}

	PressureSurge: {
		DisplayName: Sobreprisión
		Description: Presuriza este líquido; lo que esté sumergido sale disparado al cielo
	}

	MirrorSurface: {
		DisplayName: Superficie espejo
		Description: La superficie se vuelve un espejo; los proyectiles enemigos que la cruzan se copian para ti
	}

	DelayFuse: {
		DisplayName: Espoleta retardada
		Description: Este proyectil deja de desaparecer, queda suspendido treinta segundos y se vuelve una mina
	}

	ProjectileTithe: {
		DisplayName: Requisa de proyectiles
		Description: Este proyectil traga el fuego enemigo cercano y, al vencer, estalla según lo que haya tragado
	}

	ProjectileSample: {
		DisplayName: Muestra de proyectil
		Description: Toma una muestra de este proyectil; durante veinte segundos, cada doce disparos tuyos replican uno
	}

	CompensationProtocol: {
		DisplayName: Protocolo de compensación
		Description: Adelanta un 10% de la vida del objetivo; si no lo matas en ocho segundos, pagas la deuda tú
	}

	PayloadRewrite: {
		DisplayName: Reescritura de carga
		Description: Durante diez segundos los proyectiles del objetivo pasan a ser tuyos y se calculan con tu daño
	}

	PhaseDesync: {
		DisplayName: Desfase
		Description: Separa el cuerpo del objetivo de su caja de impacto; a ambos lados les cuesta más acertar
	}

	LiveCellTap: {
		DisplayName: Célula viva
		Description: El objetivo queda inmóvil e inmune al daño y convierte su vida en tu RAM
	}

	FirmwareRollback: {
		DisplayName: Retroceso de firmware
		Description: Hace que el objetivo vuelva al comportamiento de la fase anterior; al vencer, entra en furia durante cinco segundos
	}

	ShellRequisition: {
		DisplayName: Requisa de cuerpo
		Description: Los objetivos muertos mientras están marcados se levantan y luchan por ti durante quince segundos
	}

	PositionCast: {
		DisplayName: Emisión de coordenadas
		Description: Durante quince segundos su posición es visible para todo tu equipo
	}

	GaugePollution: {
		DisplayName: Contaminación de lecturas
		Description: Contamina su interfaz; las lecturas de vida y munición saltan al azar durante ocho segundos
	}

	LinkTraceback: {
		DisplayName: Rastreo de enlace
		Description: Corta las subidas que te apuntan, quema al emisor y lo marca
	}

	ForceUninstall: {
		DisplayName: Desinstalación forzada
		Description: Arranca de ti un protocolo enemigo; no puedes arrancar otro en medio minuto
	}

	MemoryScorch: {
		DisplayName: Quema de memoria
		Description: Quema tres puntos de RAM del rival; su recuperación queda en cero durante diez segundos
		SealTag: Recuperación de RAM sellada
	}

	BuffSiphon: {
		DisplayName: Sifón de beneficio
		Description: Roba su beneficio de mayor duración restante y te lo quedas, hasta treinta segundos
	}

	CombatSiphon: {
		DisplayName: Sifón táctico
		Description: Durante diez segundos el daño que le infliges se convierte en tu RAM en proporción
	}

	BallisticTurncoat: {
		DisplayName: Traición balística
		Description: Los tres siguientes proyectiles del rival dan la vuelta a medio vuelo y vuelven a su dueño; si deja de disparar, está a salvo
		HijackCounter: Proyectil secuestrado {0}/{1}
		DeathReason: El proyectil que disparó {0} fue desviado por {1} y volvió
	}

	MeltdownBrand: {
		DisplayName: Marca de fusión
		Description: Una espoleta de cuatro segundos visible todo el tiempo; al quemarse explota por ochenta de daño; desinstalarla a medio camino la desactiva
		FuseTag: Fusión {0}s
		DeathReason: "{0} estalló por la marca de fusión que plantó {1}"
	}

	MapBlackout: {
		DisplayName: Apagón del mapa
		Description: Su mapa se llena de estática durante quince segundos; alfileres y marcas de equipo se apagan también
	}

	ChannelScramble: {
		DisplayName: Interferencia de canal
		Description: Durante veinte segundos su chat se vuelve ilegible y las placas de nombre de los aliados desaparecen de su pantalla
	}

	StealthStrip: {
		DisplayName: Despojo de sigilo
		Description: Le arranca toda invisibilidad y sigilo; durante diez segundos no puede recuperarlos y su contorno es visible para todos
	}

	CooldownInject: {
		DisplayName: Inyección de enfriamiento
		Description: Durante seis segundos usa objetos un 35% más lento; un enfriamiento de poción en curso gana cinco segundos más
	}

	CyberwareOffline: {
		DisplayName: Ciberimplantes desconectados
		Description: Durante ocho segundos todos sus ciberimplantes se desconectan
	}
}

