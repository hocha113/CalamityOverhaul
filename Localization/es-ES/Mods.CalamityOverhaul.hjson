	LeadAnvil: Yunque de plomo
	CrimsonAltar: Altar carmesí
	Tile192: Hojas de madera viva
	Tile187: Malas hierbas
	Tile352: Espinas
}

OniRainWorld: {
	OniRainWorldSystem: {
		InteractHint: "[Clic derecho] Entra en la lluvia con el paraguas"
		DescendHint: "[Clic derecho] Entra en la lluvia profunda con el paraguas"
		GrabHint: "[Clic derecho] Arrebata el paraguas"
		OniDeathReason: "{0} fue arrastrado a la lluvia por lo que hay bajo el paraguas"
	}
}

GodSmithMagicConduit: {
	GsHeatRay.Desc:
		'''
		Reforja: mantén pulsado para sostener un rayo abrasador; al rojo blanco el haz se ensancha y, al llenar 5 capas de fusión, detona
		Clic derecho ventila el calor y lo convierte en una lanza de destello coronal
		'''
	GsMedusaHead.Desc:
		'''
		Reforja: mantén pulsado para abrir un cono de mirada petrificante; al llenar las marcas de piedra, el enemigo se petrifica un instante; al rojo blanco la mirada se cierra en una mirada fija
		Clic derecho ventila el calor y dispara miradas petrificantes a los ocho rumbos
		'''

	GsSoulDrain: {
		Desc:
			'''
			Reforja: un conducto de sanguijuela que ata hasta 3 enemigos y los drena a la vez; solo al rojo blanco hay regeneración de vida real
			Clic derecho detona la sangre acumulada en el cursor; una detonación sobrecargada te quita 10 de vida
			'''
		BloodPriceDeath: "{0} fue drenado por su propio conducto de sanguijuela"
	}
}

GodSmithMagicMorph: {
	GsClingerStaff.Desc:
		'''
		Reforja: mantén pulsado el clic derecho un instante para tender un muro de enredaderas malditas de unos 16 bloques en la dirección de puntería, al ángulo que quieras
		Si cargas de más, en cada extremo del muro nace un faldón vertical
		'''
	GsCrimsonRod.Desc:
		'''
		Reforja: la nube de sangre se vuelve un campo de lluvia sacrificial
		Las gotas acumulan Erosión de sangre; a tres capas estalla; los aliados dentro recuperan vida poco a poco
		Clic derecho gasta un poco de maná y mueve el campo al cursor
		'''
	GsCrystalSerpent.Desc:
		'''
		Reforja: los cristales rotos rebotan una vez más
		Mantén pulsado el clic derecho para cargar; al soltar, sueltas una serpiente de cristal enorme que serpentea y estalla en una lluvia de esquirlas más densa
		'''
	GsCrystalStorm.Desc:
		'''
		Reforja: mantén pulsado el clic derecho para cargar un vórtice de refracción en el cursor
		Tus esquirlas de cristal que lo atraviesan se refractan, vuelan más rápido y atraviesan a 1 enemigo más
		'''
	GsFlamelash.Desc:
		'''
		Reforja: el vuelo guiado gira un 25% más rápido
		Mantén pulsado el clic derecho para cargar; al soltar, sueltas una serpiente de fuego larga que sigue tu guía y prende a los enemigos del camino
		'''
	GsMagicMissile.Desc:
		'''
		Reforja: el vuelo guiado gira un 25% más rápido
		Mantén pulsado el clic derecho para cargar; al soltar, sueltas una triple ráfaga de misiles mágicos que escoltan tu cursor en formación
		'''
	GsMeteorStaff.Desc:
		'''
		Reforja: allí donde cae el meteorito queda un cráter que quema sin parar
		Mantén pulsado el clic derecho para cargar; al soltar, llamas una salva de cinco meteoritos en la línea del cursor
		'''
	GsNimbusRod.Desc:
		'''
		Reforja: si las dos nubes están a la vez, entre ellas se tiende un corredor de lluvia que empapa y ralentiza a los enemigos dentro
		Clic derecho alterna entre lluvia tibia y tormenta; la tormenta lanza rayos a lo largo del corredor
		'''
	GsRainbowGun.Desc:
		'''
		Reforja: mientras el arcoíris permanece, tus proyectiles en la franja por encima del arco infligen un 8% más, y el arco suelta pulsos de prisma que persiguen
		Clic derecho recoge el arcoíris y te devuelve la mitad del maná
		'''
	GsRainbowRod.Desc:
		'''
		Reforja: el proyectil guiado estalla en destellos de prisma al acertar
		Mantén pulsado el clic derecho para cargar; al soltar, alzas un puente arcoíris: los enemigos que lo cruzan reciben daño y los aliados que lo pisan ganan velocidad
		'''
	GsSkyFracture.Desc:
		'''
		Reforja: al lanzarse, las hojas mágicas rasgan un destello de fisura
		Mantén pulsado el clic derecho para cargar; al soltar, se abren tres grietas alrededor del cursor que disparan hojas mágicas que se cierran hacia el centro
		'''
}

GodSmithSummonWhips: {
	GsCoolWhip.Desc:
		'''
		Reforja: los copos que nacen de un azote a tempo son más grandes y atraviesan a 1 enemigo más
		4 marcas de escarcha cierran el sello de ejecución; el siguiente azote a tempo que acierte lo abre en una explosión de escarcha y aplica Congelación
		'''
	GsDarkHarvest.Desc:
		'''
		Reforja: el salto de energía oscura se extiende a enemigos cercanos; cada marca de cosecha en el objetivo añade un salto
		4 marcas cierran el sello de ejecución; el siguiente azote a tempo que acierte cosecha su alma y lanza una hoz relámpago a todos los enemigos con marca en el campo
		'''
	GsDurendal.Desc:
		'''
		Reforja: tras 3 azotes a tempo seguidos, cada azote a tempo posterior suelta una onda de espada dorada desde la punta
		5 marcas cierran el sello de ejecución; el siguiente azote a tempo que acierte llama una hoja de veredicto sagrado
		'''
	GsFirecracker.Desc:
		'''
		Reforja: conserva la detonación clásica de los súbditos
		Los azotes a tempo cargan mechas en el objetivo; al reunir 3, la siguiente detonación encadena 3 explosiones extra
		'''
	GsKaleidoscope.Desc:
		'''
		Reforja: la ventana de tempo es la más estricta de todos los látigos; un azote al aire borra el ritmo
		Cada marca enciende un color de prisma; al reunir los cinco, el siguiente azote a tempo que acierte despliega un tajo de caleidoscopio de cinco prismas y el objetivo recibe críticos asegurados durante 5 s
		'''
	GsLeatherWhip.Desc:
		'''
		Reforja: encadenar azotes a tempo acumula ritmo y el látigo se acelera
		3 marcas cierran el sello de ejecución; el siguiente azote a tempo que acierte lo hace estallar, inflige un 200% de daño y luego tus súbditos apalean al objetivo 2 s
		'''
	GsMorningStar.Desc:
		'''
		Reforja: cada azote a tempo golpea un anillo de choque en la punta
		3 marcas cierran el sello de ejecución; el siguiente azote a tempo que acierte llama un mazo de estrella caída sobre la cabeza del objetivo
		'''
	GsSnapthorn.Desc:
		'''
		Reforja: los azotes a tempo siembran marcas de espina en la presa
		4 marcas cierran el sello de ejecución; el siguiente azote a tempo que acierte detona las espinas y dispara 4 púas venenosas que persiguen
		'''
	GsSpinalTap.Desc:
		'''
		Reforja: si un barrido a tempo azota a 3 enemigos, estalla un eco de hueso que alcanza a todos los que no recibieron el látigo
		4 marcas cierran el sello de ejecución; el siguiente azote a tempo que acierte hace brotar una aguja de hueso desde el suelo
		'''
}

GodSmithAcc.GodSmithSharkToothNecklace.EffectDesc:
	'''
	El daño aumenta un 4%
	Desgarro de colmillo: el ataque rasga la piel del objetivo; cada capa de Desgarro equivale a 1 de penetración de armadura, hasta 8 capas, durante 3 s
	'''

