SeaShrimpBoss: {
	// DisplayName: Abyssal Crystal Shrimp
	// Bestiary: The carapaced tyrant of the deepest trench. Its great claw strikes faster than sound can swim; the blow tears the water itself into vacuum, and the collapsing bubble flashes bright as day. Fishermen say the waterspouts that burst from a calm sea are just it shadowboxing far below.
	// ChecklistSpawnInfo: Use Crystallized Shrimp Bait at the ocean
}

BssHead: {
	// DisplayName: Bloomsand Serpent
	// Bestiary: A great serpent that prowls beneath the dunes. Cacti have taken root in its hide, and the crimson blooms drink deep of its blood. They say when a sandstorm rises, it is the serpent turning over below.
}

// BssBody.DisplayName: Bloomsand Serpent
// BssTail.DisplayName: Bloomsand Serpent

FssHead: {
	// DisplayName: Festersand Serpent
	// Bestiary: A mutated Bloomsand Serpent. Shadow seeped into the sand, the crimson blooms festered into cysts, and ichor replaced the blood in its veins. It is longer than it once was, and hungrier. The golden puddles gleaming in the desert are not rainwater. They are its drool.
}

// FssBody.DisplayName: Festersand Serpent
// FssTail.DisplayName: Festersand Serpent
