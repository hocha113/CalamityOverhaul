Thrower: {
	NoEnergyText: ¡Energía insuficiente!
	NoItemText: ¡No hay objetos que lanzar!
	WorkingText: Lanzando...
	IdleText: En espera
	DisplayName: Lanzador
	Tooltip:
		'''
		Consume electricidad para lanzar objetos
		Clic derecho abre el panel de control
		'''
}

PlayerLauncher: {
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Plataforma de catapulta
	Tooltip:
		'''
		Consume electricidad para catapultar en la dirección configurada al jugador que se sube
		Tras el lanzamiento, inmunidad breve al daño por caída
		Clic derecho abre el panel de control
		'''
}

PacifierTower: {
	FieldOnText: Campo de fuerza activado
	FieldOffText: Campo de fuerza desactivado
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Generador de campo de calma
	Tooltip:
		'''
		Mientras funciona con corriente, suprime la aparición natural de enemigos en el área
		Clic derecho o una señal de cable enciende o apaga el campo
		'''
}

PotionBeacon: {
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Baliza de difusión de pociones
	Tooltip:
		'''
		Guarda pociones de beneficio y difunde el efecto sin cesar a los jugadores del área
		Una botella cubre el doble de la duración original del beneficio
		Clic derecho abre el panel de control
		'''
}

HerbFarmer: {
	NoEnergyText: ¡Energía insuficiente!
	// FullText: Produce storage is full!
	DisplayName: Granja de hierbas
	Tooltip:
		'''
		Consume semillas y electricidad para sembrar sola en el suelo válido de su alrededor
		Cosecha hierbas en flor y produce hierba y semillas
		Clic derecho abre el panel de control
		'''
}

MushroomFarmer: {
	NoEnergyText: ¡Energía insuficiente!
	FullText: ¡El almacén de producto está lleno!
	DisplayName: Granja de champiñones
	Tooltip:
		'''
		Consume electricidad para cultivar champiñones comunes en la hierba cercana, y champiñones luminosos en hierba de champiñón
		Los recoge sola y los guarda; de vez en cuando obtiene semillas de hierba de champiñón
		Clic derecho abre el panel de control
		'''
}

Apiary: {
	NoEnergyText: ¡Energía insuficiente!
	NoBottleText: ¡No hay botellas vacías!
	FullText: ¡El almacén de producto está lleno!
	DisplayName: Colmena
	Tooltip:
		'''
		Introduce botellas de cristal vacías; el enjambre consume electricidad para elaborar botellas de miel
		Si hay miel cerca o está en la jungla, el enjambre está más activo y el ritmo sube
		Clic derecho abre el panel de control
		'''
}

SlimeVat: {
	NoEnergyText: ¡Energía insuficiente!
	NoWaterText: ¡No hay bastante agua!
	FullText: ¡El almacén de producto está lleno!
	PourText: +{0} agua
	DisplayName: Tina de cultivo de slimes
	Tooltip:
		'''
		Consume agua y electricidad para cultivar gel de forma periódica
		Absorbe sola el agua cercana; también puedes verter con un cubo de agua mediante clic derecho
		Clic derecho abre el panel de control
		'''
}

AutoFisher: {
	NoEnergyText: ¡Energía insuficiente!
	NoBaitText: ¡No hay cebo!
	NoWaterText: ¡No hay superficie de pesca cerca!
	FullText: ¡El almacén de pesca está lleno!
	DisplayName: Máquina de pesca automática
	Tooltip:
		'''
		Consume cebo y electricidad para recoger sola las capturas de la superficie bajo la máquina
		Cuanto mayor es el agua y mejor el cebo, más abundante es la pesca
		Clic derecho abre el panel de control
		'''
}
