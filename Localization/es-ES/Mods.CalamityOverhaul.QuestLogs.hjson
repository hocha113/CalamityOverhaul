QuestNode: {
	FirstQuest: {
		DisplayName: ¡Bienvenido al mundo de Calamity!
		Description: El comienzo del viaje
		DetailedDescription: Toda leyenda empieza en lo humilde. Reclama tu equipo inicial y prepárate para un mundo de dioses y monstruos.
		QuestObjective.Description: Clic para reclamar objetos iniciales
		QuestReward.Description: Paquete de aventura inicial
	}

	MiningQuest: {
		DisplayName: Fundamentos de minería
		Description: Obtén diez {0}
		DetailedDescription: El subsuelo guarda riqueza infinita; primero necesitamos metales básicos para herramientas.
		QuestObjective.Description: Recolecta diez {0}

		QuestReward: {
			Description: Cinco {0}
			Description2: Una {0}
		}
	}

	MiningQuestII: {
		DisplayName: Edad del hierro
		Description: Recolecta cincuenta {0}
		QuestObjective.Description: Recolecta cincuenta {0}

		QuestReward: {
			Description: Cincuenta {0}
			Description2: Una {0}
		}

		DetailedDescription: El cobre es demasiado blando; necesitamos metales más duros. Baja más para encontrar vetas de hierro.
	}

	MiningQuestIII: {
		DisplayName: Fiebre del oro
		Description: Recolecta cien {0}
		QuestObjective.Description: Recolecta cien {0}

		QuestReward: {
			Description: Cien {0}
			Description2: Una {0}
		}

		DetailedDescription: El oro no es solo moneda: conduce bien la magia y es dúctil; más blando que el hierro, pero clave para equipo avanzado.
	}

	BrimstoneElementalQuest: {
		DisplayName: Elemental de Azufre
		Description: Derrota al elemental de azufre
		QuestObjective.Description: Derrota al elemental de azufre
		QuestReward.Description: 10 almas de la noche
		DetailedDescription: En las ruinas del risco de azufre, despierta y vence al espíritu elemental dormido; cuidado con su infierno de proyectiles.
	}

	CalamitasCloneQuest: {
		DisplayName: Clon de Calamitas
		Description: Derrota al Clon de Calamitas
		QuestObjective.Description: Derrota al Clon de Calamitas
		QuestReward.Description: 10 polvo calamitoso
		DetailedDescription: Un clon lleno de odio y destrucción; véncelo para demostrar que mereces enfrentar a la verdadera bruja.
	}

	CrabulonQuest: {
		DisplayName: Crabulon
		Description: Derrota a Crabulon
		QuestObjective.Description: Derrota a Crabulon
		QuestReward.Description: 50 setas luminiscentes
		DetailedDescription: En el subsuelo fúngico acecha un cangrejo gigante infestado; sus esporas son muy peligrosas.
	}

	CryogenQuest: {
		DisplayName: Criógeno
		Description: Derrota a Criógeno
		QuestObjective.Description: Derrota a Criógeno
		QuestReward.Description: 10 almas de luz
		DetailedDescription: El antiguo archimago del cosmos está sellado en hielo eterno; libéralo y véncelo.
	}

	DesertScourgeQuest: {
		DisplayName: Azote del desierto
		Description: Derrota al azote del desierto
		QuestObjective.Description: Derrota al azote del desierto
		QuestReward.Description: 10 fragmentos de victoria
