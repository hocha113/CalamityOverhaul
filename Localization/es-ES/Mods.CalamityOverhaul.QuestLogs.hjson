QuestNode: {
	FirstQuest: {
		DisplayName: ¡Bienvenido a este mundo!
		Description: El comienzo del viaje
		DetailedDescription: Toda leyenda empieza en lo humilde. Reclama tu equipo inicial y prepárate para un mundo de dioses y monstruos.
		QuestObjective.Description: Clic para reclamar objetos iniciales
	}

	MiningQuest: {
		DisplayName: Fundamentos de minería
		Description: Obtén diez {0}
		DetailedDescription: El subsuelo guarda riqueza infinita; primero necesitamos metales básicos para herramientas.
	}

	MiningQuestII: {
		DisplayName: Edad del hierro
		Description: Recolecta cincuenta {0}
		DetailedDescription: El cobre es demasiado blando; necesitamos metales más duros. Baja más para encontrar vetas de hierro.
	}

	MiningQuestIII: {
		DisplayName: Fiebre del oro
		Description: Recolecta cien {0}
		DetailedDescription: El oro no es solo moneda: conduce bien la magia y es dúctil; más blando que el hierro, pero clave para equipo avanzado.
	}

	BrimstoneElementalQuest: {
		DisplayName: Elemental de Azufre
		Description: Derrota al elemental de azufre
		DetailedDescription: En las ruinas del risco de azufre, despierta y vence al espíritu elemental dormido; cuidado con su infierno de proyectiles.
	}

	CalamitasCloneQuest: {
		DisplayName: Clon de Calamitas
		Description: Derrota al Clon de Calamitas
		DetailedDescription: Un clon lleno de odio y destrucción; véncelo para demostrar que mereces enfrentar a la verdadera bruja.
	}

	CrabulonQuest: {
		DisplayName: Crabulon
		Description: Derrota a Crabulon
		DetailedDescription: En el subsuelo fúngico acecha un cangrejo gigante infestado; sus esporas son muy peligrosas.
	}

	CryogenQuest: {
		DisplayName: Criógeno
		Description: Derrota a Criógeno
		DetailedDescription: El antiguo archimago del cosmos está sellado en hielo eterno; libéralo y véncelo.
	}

	DesertScourgeQuest: {
		DisplayName: Azote del desierto
		Description: Derrota al azote del desierto
		DetailedDescription: El antiguo tirano de los mares ahora agoniza en el desierto seco; cuidado con sus mandíbulas y secuaces.
	}

	EaterofWorldsQuest: {
		DisplayName: Devorador de mundos / Cerebro de Cthulhu
		Description: Derrota al jefe de la Corrupción o del Carmesí
		QuestObjective.Description: Derrota al Devorador de mundos o al Cerebro de Cthulhu
		DetailedDescription: El mal se extiende; entra en la herida del mundo y elimina al gusano o al cerebro vil.
	}

	EyeofCthulhuQuest: {
		DisplayName: Ojo de Cthulhu
		Description: Derrota al Ojo de Cthulhu
		DetailedDescription: Mientras sientas esa mirada maligna, aparecerá; es tu primera prueba de verdad.
	}

	GolemQuest: {
		DisplayName: Gólem
		Description: Derrota al Gólem
		DetailedDescription: En el templo de la jungla yace una máquina de guerra antigua; cuidado con láseres y puños.
	}

	HiveMindQuest: {
		DisplayName: La Mente de la Colmena / Los Perforadores
		Description: Derrota al dios del bioma maligno
		QuestObjective.Description: Derrota a La Mente de la Colmena o a Los Perforadores
		DetailedDescription: Son la conciencia de la Corrupción y el Carmesí hecha carne; si no caen, la tierra no tendrá paz.
	}

	KingSlimeQuest: {
		DisplayName: Rey Slime
		Description: Derrota al Rey Slime
		DetailedDescription: El rey de los gelatinosos; parece cómico, pero no dejes que su tamaño te aplaste.
	}

	LunaticCultistQuest: {
		DisplayName: Cultista lunático
		Description: Derrota al cultista lunático
		DetailedDescription: En la entrada de la mazmorra, fanáticos intentan evitar o provocar el apocalipsis; detén el ritual.
	}

	MechanicalBossesQuest: {
		DisplayName: Jefes mecánicos
		Description: Derrota a todos los jefes mecánicos
		QuestObjective.Description: Derrota a todos los jefes mecánicos
		DetailedDescription: Alguien reconstruyó los órganos de Cthulhu en acero. Un par de ojos, un cráneo y un gusano largo.
	}

	MoonLordQuest: {
		DisplayName: Señor de la Luna
		Description: Derrota al Señor de la Luna
		DetailedDescription: La mente detrás de todo, el terror del lado oscuro de la luna; acaba con esta pesadilla.
	}

	PlaguebringerGoliathQuest: {
		DisplayName: La Goliat Traeplagas
		Description: Derrota a La Goliat Traeplagas
		DetailedDescription: Una abeja reina modificada por nanovirus; mortal y cargada de peste.
	}

	PlanteraQuest: {
		DisplayName: Plantera
		Description: Derrota a Plantera
		DetailedDescription: En lo profundo de la jungla duerme una flor devoradora; rompe el bulbo y enfréntate a su furia.
	}

	SkeletronQuest: {
		DisplayName: Skeletron
		Description: Derrota a Skeletron
		DetailedDescription: Solo venciendo a este anciano maldito podrás entrar con seguridad en la mazmorra.
	}

	SlimeGodQuest: {
		DisplayName: Dios Slime
		Description: Derrota al Dios Slime
		DetailedDescription: La cima de la especie slime, un dios antiguo y voraz; cuidado con sus avatares combinados.
	}

	WallofFleshQuest: {
		DisplayName: Muro carnoso
		Description: Derrota a Muro carnoso
		DetailedDescription: El guardián del mundo. Arroja el muñeco vudú del guía a la lava para liberar a la antigua deidad de este mundo y abrir el modo difícil.
	}

	CeaselessVoidQuest: {
		DisplayName: Vacío Perpetuo
		Description: Derrota a Vacío Perpetuo
		DetailedDescription: Centinela del Devorador de Dioses, espejo del vacío de otra dimensión.
	}

	DevourerofGodsQuest: {
		DisplayName: Devorador de Dioses
		Description: Derrota al Devorador de Dioses
		DetailedDescription: Una serpiente cósmica hambrienta de divinidad; combátela en el vacío sin dejar que te trague.
	}

	DragonfollyQuest: {
		DisplayName: Locura dracónica
		Description: Derrota a la locura dracónica
		DetailedDescription: Un fallido clon de Yharon, un pseudodragón loco y electrizado.
	}

	ExoMechsQuest: {
		DisplayName: Exo Mecánicos
		Description: Derrota a los Exo Mecánicos
		DetailedDescription: Las obras maestras de Draedon, cénit de la tecnología terrariana; sobrevive a la función perfecta.
	}

	OldDukeQuest: {
		DisplayName: El Viejo Duque
		Description: Derrota a El Viejo Duque
		DetailedDescription: El antiguo señor de las profundidades del Mar de Azufre; cuidado con su vapor tóxico.
	}

	PolterghastQuest: {
		DisplayName: Polterghast
		Description: Derrota a Polterghast
		DetailedDescription: Almas vengativas de la mazmorra reunidas en un monstruo; calma su furia.
	}

	PrimordialWyrmQuest: {
		DisplayName: Guiverno primordial
		Description: Derrota al guiverno primordial
		DetailedDescription: Guardián del fondo del abismo, más antiguo que los dioses; no lo molestes sin necesidad.
	}

	ProfanedGuardiansQuest: {
		DisplayName: Guardianes profanados
		Description: Derrota a los guardianes profanados
		DetailedDescription: Leales guardianes de la Diosa Profanada; derrotales para debilitar sus defensas.
	}

	ProvidenceQuest: {
		DisplayName: Providence, la Diosa Profanada
		Description: Derrota a Providence
		DetailedDescription: Diosa del fuego sagrado y la purificación; desafíala en el Sagrado o el Inframundo sin quemarte.
	}

	SignusQuest: {
		DisplayName: Signus, Enviado del Devorador
		Description: Derrota a Signus
		DetailedDescription: Centinela del Devorador de Dioses, asesino sin forma, fantasma del vacío.
	}

	StormWeaverQuest: {
		DisplayName: Tejedor de tormentas
		Description: Derrota al tejedor de tormentas
		DetailedDescription: Centinela del Devorador de Dioses, gusano del cielo que se alimenta de rayos.
	}

	SupremeCalamitasQuest: {
		DisplayName: Calamitas Suprema
		Description: Derrota a Calamitas Suprema
		DetailedDescription: La legendaria Bruja del Azufre; ¿fin del viaje o nuevo comienzo? Prepárate para el infierno de proyectiles.
	}

	YharonQuest: {
		DisplayName: Yharon, dragón del renacimiento
		Description: Derrota a Yharon
		DetailedDescription: El fiel compañero del Tirano, dragón con renacer de fénix; prueba del alma.
	}

	BatteryQuest: {
		DisplayName: Almacenamiento de energía
		Description: Fabrica una batería térmica
		DetailedDescription: La electricidad debe almacenarse; las baterías son el primer paso de una red estable.
	}

	HydroelectricQuest: {
		DisplayName: Energía limpia
		Description: Fabrica un generador hidroeléctrico
		DetailedDescription: Aprovecha el agua en movimiento para generar electricidad de forma limpia y sostenible.
	}

	IndustrialStartQuest: {
		DisplayName: Revolución industrial
		Description: Fabrica un generador eólico
		DetailedDescription: Primer paso hacia la automatización: usa el viento para mover tus máquinas.
	}

	ItemFilterQuest: {
		DisplayName: Clasificación logística
		Description: Fabrica un filtro de objetos
		DetailedDescription: Las líneas automáticas necesitan orden; controla el flujo con filtros.
	}

	MiningMachineQuest: {
		DisplayName: Excavación automática
		Description: Fabrica una máquina minera
		DetailedDescription: Olvida la minería manual; esta máquina devora vetas con eficiencia asombrosa.
	}

	MiningMachineIIQuest: {
		DisplayName: Perforación profunda
		Description: Fabrica una máquina minera MK2
		DetailedDescription: Un núcleo reforzado ofrece velocidad sin igual.
	}

	PipelineQuest: {
		DisplayName: Transmisión de energía
		Description: Fabrica tuberías de energía universal
		DetailedDescription: Las venas entre generadores y máquinas; sin ellas la electricidad no circula.
	}

	TeslaTowerQuest: {
		DisplayName: Torre de tormenta magnética
		Description: Fabrica una torre Tesla
		DetailedDescription: Una maravilla de la energía inalámbrica. La torre transmite energía por el aire y te ahorra la mayor parte del cableado.
	}

	FluidPumpQuest: {
		// DisplayName: Fluid Engineering
		// Description: Craft a Fluid Pump
		// DetailedDescription: Water and lava are resources too. The pump is what invites them out of the world.
	}

	FluidPipelineQuest: {
		// DisplayName: Veins of Liquid
		// Description: Craft Fluid Pipelines
		// DetailedDescription: Liquids need a grid of their own. Fluid pipes carry only fluids and leave the power grid alone.
	}

	FluidTankQuest: {
		// DisplayName: Vessel of Reserves
		// Description: Craft a Fluid Tank
		// DetailedDescription: Pumping fast means nothing without somewhere to keep it. The tank is the battery of the fluid network.
	}

	MagmaGeneratorQuest: {
		// DisplayName: Magma Thermal Power
		// Description: Craft a Magma Thermal Generator
		// DetailedDescription: The pumped magma finally has somewhere to go. It earns a little while touching lava, and runs at full power once its tank is fed.
	}

	ShimmerTransmuterQuest: {
		// DisplayName: Shimmer Alchemy
		// Description: Craft a Shimmer Transmuter
		// DetailedDescription: Pump shimmer into the machine, and item forms can be rewritten on an assembly line.
	}

	CrusherQuest: {
		// DisplayName: Ore from Rubble
		// Description: Craft an Ore Crusher
		// DetailedDescription: Two ore crushed into three. The incinerator's supply line just gained a yield step.
	}

	RecyclerQuest: {
		// DisplayName: Waste into Worth
		// Description: Craft a Recycler
		// DetailedDescription: Don't toss retired gear. Break it into bars by rarity and send it back to the furnace.
	}

	AutoCrafterQuest: {
		// DisplayName: Automated Assembly
		// Description: Craft an Auto Crafter
		// DetailedDescription: Pin a recipe; materials walk in and products walk out. The crafting bench no longer needs you standing by.
	}

	MushroomFarmerQuest: {
		// DisplayName: Fungiculture
		// Description: Craft a Mushroom Farming Machine
		// DetailedDescription: Harvests on grass and mushroom grass are its business. Glowing mushrooms included.
	}

	ApiaryQuest: {
		// DisplayName: Sweet Industry
		// Description: Craft an Electric Apiary
		// DetailedDescription: Empty bottles in, bottled honey out. The hive works harder near honey or in the jungle.
	}

	SlimeVatQuest: {
		// DisplayName: Gel Production
		// Description: Craft a Slime Culture Vat
		// DetailedDescription: Water and power in, gel out. The vat is the first raw-material machine of the farm waste stream.
	}

	BiomassGeneratorQuest: {
		// DisplayName: Closed Ecology
		// Description: Craft a Biomass Generator
		// DetailedDescription: Don't waste the farm's surplus. Feed it to the burner for power and the grow-burn loop starts turning.
	}

	FlameTurretQuest: {
		// DisplayName: Line of Fire
		// Description: Craft a Flamethrower Turret
		// DetailedDescription: A close-range wall of fire against crowds. Load gel and it burns harder.
	}

	CryoTurretQuest: {
		// DisplayName: Frost Lockdown
		// Description: Craft a Cryo Turret
		// DetailedDescription: Not built to kill, built to freeze. Enemies under the tower slow down until they can barely step.
	}

	LaserTurretQuest: {
		// DisplayName: Lightspeed Sniper
		// Description: Craft a Laser Turret
		// DetailedDescription: Anything in line of sight is one beam away. Longest range in the family, and it prefers big targets.
	}

	ShieldGeneratorQuest: {
		// DisplayName: Energy Bulwark
		// Description: Craft a Shield Generator
		// DetailedDescription: Everyone in range gets a layer of absorbing shield. More allies, faster drain.
	}

	HealStationQuest: {
		// DisplayName: Field Medicine
		// Description: Craft a Healing Station
		// DetailedDescription: Stand in the aura and wounds slowly close. The phrase "workplace injury" retires today.
	}

	TeleportStationQuest: {
		// DisplayName: Teleport Network
		// Description: Craft a Teleport Station
		// DetailedDescription: Two stations make a network, and the whole map opens up. The farther the hop, the higher the toll.
	}

	ElectricSundialQuest: {
		// DisplayName: Winding the Sundial
		// Description: Craft an Electric Sundial
		// DetailedDescription: Store a thousand units of power to skip the night in one press. The whole server gets notified.
	}

	SolarPanelQuest: {
		// DisplayName: Facing the Sun
		// Description: Craft a Solar Panel
		// DetailedDescription: Generates by day and peaks at noon. Keep its sky clear; rain and eclipses are its days off.
	}

	CapacitorMatrixQuest: {
		// DisplayName: Grand Reservoir
		// Description: Craft a Capacitor Matrix
		// DetailedDescription: Forty thousand units in one bank. The grid's flywheel, and the end of the blackout era.
	}

	WeatherControllerQuest: {
		// DisplayName: Rainmaker
		// Description: Craft a Weather Controller
		// DetailedDescription: Five hundred power buys a rain, and once more clears it. The wind takes no orders.
	}

	WireInterfaceQuest: {
		// DisplayName: Wire Bridging
		// Description: Craft Wire Interfaces
		// DetailedDescription: The wire network and the power grid finally speak. Signals can toggle machines, and machines can send signals back.
	}

	SensorQuest: {
		// DisplayName: Electric Sentry Eye
		// Description: Craft a Multi-Mode Sensor
		// DetailedDescription: Charge levels, enemies and blood moons, nothing escapes its watch. The moment a condition holds, a wire signal goes out.
	}

	GridSwitchQuest: {
		// DisplayName: Grid Dispatch
		// Description: Craft a Grid Switch
		// DetailedDescription: A master switch built into the lines. Flip it open and the whole downstream grid falls silent at once.
	}

	ThermalPowerQuest: {
		DisplayName: Hora de quemar
		Description: Fabrica un generador térmico
		DetailedDescription: Quema combustible para mucha energía; poco ecológico, pero fiable al principio.
	}

	AnnihilatingUniverseQuest: {
		DisplayName: Aniquilador del universo
		Description: Obtén el «Aniquilador del universo»
		DetailedDescription: Comprime el poder de galaxias en una cuerda de arco; destruye dimensiones, la prueba suprema del arquero.
	}

	AriaofTheCosmosQuest: {
		DisplayName: Aria del cosmos
		Description: Obtén la «Aria del cosmos»
		DetailedDescription: Toca la sinfonía de las estrellas; invoca agujeros negros y cuásares hasta disolver a los enemigos.
	}

	NeutronBowQuest: {
		DisplayName: Arco de neutrones
		Description: Obtén arco de neutrones
		DetailedDescription: Forjado con fragmentos del núcleo de una estrella de neutrones; cada flecha lleva gravedad colapsada.
	}

	NeutronGlaiveQuest: {
		DisplayName: Guja de neutrones
		Description: Obtén guja de neutrones
		DetailedDescription: Densidad asombrosa; ninguna armadura resiste su tajo.
	}

	NeutronGunQuest: {
		DisplayName: Rifle de neutrones
		Description: Obtén rifle de neutrones
		DetailedDescription: Dispara microflujos de neutrones casi sin resistencia.
	}

	NeutronScytheQuest: {
		DisplayName: Guadaña de neutrones
		Description: Obtén guadaña de neutrones
		DetailedDescription: La herramienta del segador; siega la vida como trigo.
	}

	NeutronStarIngotQuest: {
		DisplayName: Lingote de estrella de neutrones
		Description: Obtén lingote de estrella de neutrones
		DetailedDescription: Uno de los materiales más densos del universo; vibra con fluctuaciones gravitatorias.
	}

	NeutronWandQuest: {
		DisplayName: Varita de neutrones
		Description: Obtén varita de neutrones
		DetailedDescription: Controla la gravedad y deforma el espacio-tiempo.
	}

	PandemoniumQuest: {
		DisplayName: Pandemonium
		Description: Obtén «Pandemonium»
		DetailedDescription: Arma definitiva que fusiona almas y poder calamitoso; llaves del infierno y el abismo.
	}

	RockQuest: {
		DisplayName: Piedra eternita antigua
		Description: Obtén piedra eternita antigua
		DetailedDescription: Una piedra aparentemente común que ha visto innumerables ciclos del desafío final; símbolo de perseverancia eterna.
	}

	TerminusQuest: {
		DisplayName: Piedra del fin
		Description: Obtén piedra del fin
		DetailedDescription: Llave del desafío final; contempla la piedra y enfrenta a los seres más fuertes del mundo.
	}

	SpearOfLonginusQuest: {
		DisplayName: Lanza de Longino
		Description: Obtén lanza de Longino
		DetailedDescription: La lanza sagrada que perforó a un dios; atraviesa campos y dominios absolutos.
	}

	DragonsWordQuest: {
		DisplayName: Palabra del dragón
		Description: Obtén palabra del dragón
		DetailedDescription: Un dragón solo llora una vez en la vida, al morir.
	}

	RockQuestII: {
		DisplayName: Ciclo de conquista
		Description: Completa la oleada de jefes cinco veces y obtén al menos cinco piedras eternita antiguas
		DetailedDescription: Símbolo del verdadero guerrero
	}

	AdventurerQuests: {
		DisplayName: Aventurero
		Description: ¡El mundo es mío!
		QuestObjective.Description: Clic para reclamar
		DetailedDescription: Todo viaje empieza con un paso; calza estas botas y recorre el mundo.
	}

	ExploreDungeon: {
		DisplayName: Mazmorra sombría
		Description: Descubre la entrada de la mazmorra
		QuestObjective.Description: Llega a la mazmorra
		DetailedDescription: Secretos y peligros tras muros malditos; solo los más valientes pisan el reino de los muertos.
	}

	ExploreHell: {
		DisplayName: Abismo infernal
		Description: Desciende al Inframundo
		QuestObjective.Description: Llega al Inframundo
		DetailedDescription: Ríos de lava en lo más profundo; hogar de demonios y fuente de obsidiana y mineral del infierno.
	}

	ExploreJungle: {
		DisplayName: Expedición a la jungla
		Description: Adéntrate en la jungla
		QuestObjective.Description: Llega a la jungla
		DetailedDescription: Un laberinto verde vibrante y mortal; templos antiguos y enjambres de abejas.
	}

	ExploreOcean: {
		DisplayName: Fin del mundo
		Description: Llega al océano
		QuestObjective.Description: Llega al océano
		DetailedDescription: Donde el cielo y el mar se encuentran; naufragios y monstruos bajo el azul profundo.
	}

	ExploreSnow: {
		DisplayName: Tierra helada
		Description: Explora la tundra nevada
		QuestObjective.Description: Llega a la nieve
		DetailedDescription: Permafrost eterno; la vida aquí es más resistente.
	}

	ExploreSpace: {
		DisplayName: Mar de estrellas
		Description: Vuela al espacio
		QuestObjective.Description: Llega al espacio
		DetailedDescription: Libérate de la gravedad y toca las estrellas para ver el mundo entero.
	}

	HellLabSchematic: {
		DisplayName: Plano del infierno
		Description: Busca el plano cifrado en el laboratorio de Draedon del Inframundo
		QuestObjective.Description: Obtén el plano del infierno
		DetailedDescription: Draedon tenía un puesto en el infierno para experimentar con energía geotérmica; el plano puede desbloquear nuevas armas.
	}

	IceLabSchematic: {
		DisplayName: Código polar
		Description: Busca el plano cifrado en el laboratorio de Draedon en la nieve
		QuestObjective.Description: Obtén el plano helado
		DetailedDescription: El frío conserva instrumentos de precisión; baja al laboratorio bajo el hielo.
	}

	JungleLabSchematic: {
		DisplayName: Borrador de la jungla
		Description: Busca el plano cifrado en el laboratorio de Draedon en la jungla
		QuestObjective.Description: Obtén el plano de la jungla
		DetailedDescription: La jungla oculta el laboratorio biológico de Draedon sobre plagas y nanovirus.
	}

	PlanetoidLabSchematic: {
		DisplayName: Misterio estelar
		Description: Busca el plano cifrado en el laboratorio de Draedon en el planetoide
		QuestObjective.Description: Obtén el plano del planetoide
		DetailedDescription: En la microgravedad de las alturas flota un laboratorio con diseños tempranos de mecánicas estelares.
	}

	SunkenSeaLabSchematic: {
		DisplayName: Mar hundido
		Description: Busca el plano cifrado en el laboratorio de Draedon del mar hundido
		QuestObjective.Description: Obtén el plano del mar hundido
		DetailedDescription: En este mar subterráneo tranquilo, Draedon dejó investigación sobre energía prismática.
	}

	AquaticScourgeQuest: {
		DisplayName: Azote acuático
		Description: Derrota al azote acuático
		DetailedDescription: Antes leviatán pacífico del océano claro, ahora retorcido por el Mar de Azufre; cuidado con cargas y nubes tóxicas.
	}

	QueenSlimeQuest: {
		DisplayName: Reina Slime
		Description: Derrota a la Reina Slime
		DetailedDescription: Emperatriz cristalina del Sagrado; más ágil y letal que su consorte; prepárate para un barrage espectacular.
	}

	BuildHouse: {
		DisplayName: Maestro constructor
		Description: Construye una casa válida
		QuestObjective.Description: Construye una casa válida
		DetailedDescription: Todos necesitan refugio; con mesa, silla, luz y paredes atraerás al guía y a otros NPC.
	}

	CollectEvilOres: {
		DisplayName: Menas malignas
		Description: Recolecta menas malignas
		QuestObjective.Description: Recolecta mena de demonita o carmesita
		DetailedDescription: Menas de aura inquietante, frías y viscosas; esenciales pese a venir de la herida del mundo.
	}

	CollectFallenStars: {
		DisplayName: Coleccionista de estrellas
		Description: Recolecta estrellas fugaces
		QuestObjective.Description: Recolecta estrellas fugaces
		DetailedDescription: Lágrimas del cielo nocturno; aumentan maná y sirven de munición o material mágico.
	}

	CollectGems: {
		DisplayName: Coleccionista de gemas
		Description: Recolecta gemas variadas
		QuestObjective.Description: Recolecta cinco tipos de gemas
		DetailedDescription: Cristales en la roca; decoración y material para bastones y garfios; juntar colores forma un arcoíris.
	}

	CollectHerbs: {
		DisplayName: Aprendiz de hierbas
		Description: Recolecta hierbas variadas
		QuestObjective.Description: Recolecta tres tipos de hierbas
		DetailedDescription: Base de la alquimia; plantas del desierto, la nieve o el infierno; el primer paso del maestro alquimista.
	}

	CollectOres: {
		DisplayName: Recolección de menas
		Description: Recolecta menas básicas

		QuestObjective: {
			Description: {
				Iron: Recolecta mena de hierro o plomo
				Copper: Recolecta mena de cobre o estaño
			}
		}

		DetailedDescription: La minería es supervivencia; cobre y hierro son el inicio de todo héroe.
	}

	DeepExplorer: {
		DisplayName: Explorador profundo
		Description: Explora todos los biomas principales
		QuestObjective.Description: Completa todas las misiones de exploración
		DetailedDescription: Has recorrido el mundo de las nubes al infierno; el mapa prueba tu valor.
	}

	ExploreCaverns: {
		DisplayName: Profundidades de caverna
		Description: Explora capas más profundas
		QuestObjective.Description: Llega a la capa de cavernas
		DetailedDescription: Sin sol, solo oscuridad y criaturas; aparece lava y más mineral; el abismo te mira.
	}

	ExploreCorruption: {
		DisplayName: Corrupción / Carmesí
		Description: Explora la Corrupción o el Carmesí
		QuestObjective.Description: Entra en la Corrupción o el Carmesí
		DetailedDescription: La tierra está enferma; hay que entrar en la guarida para escamas o muestras de tejido.
	}

	ExploreDesert: {
		DisplayName: Desierto ardiente
		Description: Entra en el desierto
		QuestObjective.Description: Llega al desierto
		DetailedDescription: Sol abrasador y arena dorada; lleva agua o la sequedad te vencerá.
	}

	ExploreFloatingIsland: {
		DisplayName: Islas flotantes
		Description: Encuentra islas en el cielo
		QuestObjective.Description: Llega a una isla flotante
		DetailedDescription: Tesoros sobre las nubes; busca anomalías gravitatorias o construye una torre.
	}

	ExploreGlowingMushroom: {
		DisplayName: Setas luminiscentes
		Description: Encuentra el bioma de setas luminiscentes
		QuestObjective.Description: Llega al bioma de setas luminiscentes
		DetailedDescription: Ecosistema subterráneo de luz azul; hogar de la trufa y bichos extraños.
	}

	ExploreUnderground: {
		DisplayName: Exploración subterránea
		Description: Adéntrate en cuevas
		QuestObjective.Description: Llega al subsuelo
		DetailedDescription: Raspar la superficie no basta; la aventura empieza bajo tierra.
	}

	FindLifeCrystal: {
		DisplayName: Fuente de vida
		Description: Encuentra un cristal de vida
		QuestObjective.Description: Encuentra un cristal de vida
		DetailedDescription: Cristal rojo de vitalidad; úsalo para fortalecer el cuerpo permanentemente.
	}

	FindShadowOrb: {
		DisplayName: Núcleo del mal
		Description: Encuentra un orbe sombrío o corazón carmesí
		QuestObjective.Description: Destruye un orbe sombrío o corazón carmesí
		DetailedDescription: En lo profundo del mal palpita corrupción u orbe; romper tres despertará algo terrible.
	}

	FirstPotion: {
		DisplayName: Introducción a alquimia
		Description: Prepara tu primera poción
		QuestObjective.Description: Prepara cualquier poción
		DetailedDescription: Botella sobre mesa y ya tienes alquimia; mezcla ingredientes y bebe la magia.
	}

	NPCVillage: {
		DisplayName: Aldea próspera
		Description: Atrae a varios NPC
		QuestObjective.Description: Ten cinco NPC
		DetailedDescription: La soledad pesa; con monedas y fuerza llegará gente; construye una comunidad.
	}

	QueenBeeQuest: {
		DisplayName: Abeja reina
		Description: Derrota a la Abeja reina
		DetailedDescription: Romper la larva en la colmena de la jungla enfurece a la reina; antídoto y esquivar aguijones.
	}

	CollectorQuest: {
		DisplayName: Asistente recolector
		Description: Obtén el recolector
		DetailedDescription: Recoge botín automáticamente; pieza clave de la logística automatizada.
	}

	LumberjackQuest: {
		DisplayName: Hora de talar
		Description: Obtén el leñador
		DetailedDescription: La madera es base industrial; esta máquina automatiza el bosque con electricidad.
	}

	LifeWeaverQuest: {
		DisplayName: Reforestación
		Description: Obtén el plantador de árboles
		DetailedDescription: Planta árboles con precisión eléctrica; última pieza del bosque automático.
	}

	IncineratorQuest: {
		DisplayName: Fundición eléctrica
		Description: Fabrica un incinerador eléctrico
		DetailedDescription: Arcos de alta tensión duplican el rendimiento mineral frente a hornos primitivos.
	}

	ItemPipelineQuest: {
		DisplayName: Sistema logístico
		Description: Fabrica una tubería de objetos
		DetailedDescription: Tuberías que conectan máquinas y cofres; olvida correr como un primitivo.
	}

	ThrowerQuest: {
		DisplayName: Asistente lanzador
		Description: Fabrica un lanzador
		DetailedDescription: Expulsa objetos de la red logística al mundo; útil para automatizar o desechar.
	}

	DeerclopsQuest: {
		// DisplayName: Deerclops
		// Description: Defeat Deerclops
		// DetailedDescription: Deep in the blizzard stands a one-eyed giant deer. It does not come looking for you; you insist on looking for it.
	}

	DukeFishronQuest: {
		// DisplayName: Duke Fishron
		// Description: Defeat Duke Fishron
		// DetailedDescription: Bait your hook with a truffle worm and a duke will bite. Pig, dragon, fish; three kinds of menace on a single face.
	}

	EmpressOfLightQuest: {
		// DisplayName: Empress of Light
		// Description: Defeat the Empress of Light
		// DetailedDescription: Step on a prismatic lacewing in the Hallow and the furious empress will come to settle the score herself. Anger her in daylight and every one of her attacks kills in one hit.
	}

	ZenithQuest: {
		// DisplayName: Zenith
		// Description: Forge the Zenith
		// DetailedDescription: From the copper shortsword to the Starwrath, every blade you ever swung remembers you. Melt them together, and this journey takes its final shape.
	}

	BloodMoonQuest: {
		// DisplayName: Night of Blood
		// Description: Live through a Blood Moon
		// QuestObjective.Description: Experience a Blood Moon
		// DetailedDescription: On nights when the moon turns red, monsters stop knocking; they open the door themselves. Survive until dawn.
	}

	TorchGodQuest: {
		// DisplayName: The Torch God
		// Description: Pass the Torch God's trial
		// QuestObjective.Description: Earn the Torch God's Favor
		// DetailedDescription: Plant a hundred torches underground and the master of flame will test you in person. Its favor hides within the extinguished lights.
	}

	GoblinArmyQuest: {
		// DisplayName: Goblin Invasion
		// Description: Repel the Goblin Army
		// QuestObjective.Description: Repel the Goblin Army
		// DetailedDescription: Smashing Shadow Orbs draws them in, and so does a growing settlement. Short, swarming, endless; but win, and you may pick up a captive who repairs gear.
	}

	OldOnesArmyQuest: {
		// DisplayName: Old One's Army
		// Description: Guard the Eternia Crystal and repel all three tiers of the Old One's Army

		QuestObjective: {
			Description: {
				// T1: Repel the Old One's Army Tier 1
				// T2: Repel the Old One's Army Tier 2
				// T3: Repel the Old One's Army Tier 3
			}
		}

		// DetailedDescription: The Tavernkeep brings a plea from another world. Set the crystal, hold the portals, and let nothing touch it. Three tiers, each meaner than the last.
	}

	PirateInvasionQuest: {
		// DisplayName: Pirate Invasion
		// Description: Repel the Pirate Invasion
		// QuestObjective.Description: Repel the Pirate Invasion
		// DetailedDescription: Once the world hardens, sails appear on the horizon. They come for your money; take theirs back, captain's belongings included.
	}

	SolarEclipseQuest: {
		// DisplayName: Eclipse Hunt
		// Description: Slay a Mothron during a Solar Eclipse
		// QuestObjective.Description: Slay a Mothron
		// DetailedDescription: On days the moon blots out the sun, daytime is deadlier than night. Everything from the horror films takes to the streets, and the fastest flier among them is called Mothron.
	}

	MartianMadnessQuest: {
		// DisplayName: Martian Madness
		// Description: Repel the Martian invasion
		// QuestObjective.Description: Repel the Martian invasion
		// DetailedDescription: Do not stare at the probe in the sky; it flies home and brings friends. Saucers, death rays, mind-control helmets; the full alien invasion package.
	}

	PumpkinMoonQuest: {
		// DisplayName: Pumpkin Moon
		// Description: Defeat Pumpking during the Pumpkin Moon
		// QuestObjective.Description: Defeat Pumpking
		// DetailedDescription: Wake Halloween night with a Pumpkin Moon Medallion. Scarecrows line up to collect heads, and the closer is a king carrying twin scythes.
	}

	FrostMoonQuest: {
		// DisplayName: Frost Moon
		// Description: Defeat the Ice Queen during the Frost Moon
		// QuestObjective.Description: Defeat the Ice Queen
		// DetailedDescription: Open the present that should have stayed wrapped and Christmas Eve goes sour. Tanks patrol the snow while the queen dives through the blizzard.
	}

	FishermanQuest: {
		// DisplayName: Angler's Errands
		// Description: Complete five Angler quests
		// QuestObjective.Description: Complete Angler quests
		// DetailedDescription: A bossy little brat lives by the sea, but his rewards are surprisingly solid. Where the fish are, the treasure is.
	}

	LifeMaxQuest: {
		// DisplayName: Fountain of Life
		// Description: Raise your max life to 400
		// QuestObjective.Description: Reach 400 max life
		// DetailedDescription: Heart crystals only carry you halfway. The rest of the road is fought and grown through. Four hundred life is the ticket to standing firm in Hardmode.
	}

	ManaMaxQuest: {
		// DisplayName: Heart of Mana
		// Description: Raise your max mana to 200
		// QuestObjective.Description: Reach 200 max mana
		// DetailedDescription: Press fallen stars into crystals and feed them to yourself one by one. Twenty points a sip, nine sips in all, and the night sky runs in your veins.
	}

	WingsQuest: {
		// DisplayName: Spread Your Wings
		// Description: Equip any pair of wings
		// QuestObjective.Description: Equip wings
		// DetailedDescription: Sky vaults, fairy feathers, demon membranes. Whatever the source, the moment wings sprout from your back, fall damage becomes history.
	}

	MoneyQuest: {
		// DisplayName: First Fortune
		// Description: Hold a Platinum Coin
		// QuestObjective.Description: Hold a Platinum Coin
		// DetailedDescription: A hundred gold coins pressed into one platinum. You probably died plenty of times earning it; merchants call that a handling fee.
	}

	ExploreAetherQuest: {
		// DisplayName: The Shimmering Lake
		// Description: Find the Aether
		// QuestObjective.Description: Reach the Shimmer
		// DetailedDescription: Tucked in a corner of the world is a lake that does not belong here. Drop something in and it comes back changed. Do not jump in to test it yourself.
	}

	HardmodeOresQuest: {
		// DisplayName: Three New Metals
		// Description: Gather the three tiers of Hardmode ore

		QuestObjective: {
			Description: {
				// T1: Collect Cobalt or Palladium Ore
				// T2: Collect Mythril or Orichalcum Ore
				// T3: Collect Adamantite or Titanium Ore
			}
		}

		// DetailedDescription: After the Wall of Flesh falls, smash the altars with a holy hammer and three new metals grow in the deep. Each is harder than everything that came before.
	}

	ChlorophyteQuest: {
		// DisplayName: Power of Chlorophyte
		// Description: Collect 30 Chlorophyte Ore
		// DetailedDescription: With the machines destroyed, a glowing green metal starts growing in the deep jungle mud. It has a will of its own, and it spreads on its own too.
	}

	CalamityLoreHub: {
		// DisplayName: Anomaly Survey
		// Description: Something is wrong with this world
		// QuestObjective.Description: Click to claim
		// DetailedDescription: The sea is acid, the crags are burning, and things no field guide knows grow in the crater a star left behind. Write it all down; this world's dark side is bigger than you think.
	}

	ExploreSulphurSea: {
		// DisplayName: Sulphurous Sea
		// Description: Explore the Sulphurous Sea
		// QuestObjective.Description: Reach the Sulphurous Sea
		// DetailedDescription: One side of the world has no blue ocean, only yellowed acid water. Rain fizzes where it lands and the fish come up venomous. Cover your mouth, and do not drink.
	}

	ExploreAbyss: {
		// DisplayName: Mouth of the Abyss
		// Description: Dive into the Abyss beneath the Sulphurous Sea
		// QuestObjective.Description: Enter the Abyss
		// DetailedDescription: A downward rift splits the floor of the sulphurous sea. Light cannot follow, neither can breath, and the deeper you go, the older the things that live there.
	}

	AbyssDeepQuest: {
		// DisplayName: Bottom of the Abyss
		// Description: Bring back Lumenyl and Voidstone from the Abyss
		// DetailedDescription: Where mining lamps cannot reach, blue-glowing crystal grows along the rock walls. Dig it out and surface alive; only then have you truly been to the Abyss.
	}

	ExploreSunkenSea: {
		// DisplayName: Sunken Sea
		// Description: Find the Sunken Sea deep beneath the desert
		// QuestObjective.Description: Reach the Sunken Sea
		// DetailedDescription: Beneath the desert hides a quiet stretch of blue. Prisms glow in the water and the clams are bigger than your house. This may be the gentlest corner of the world.
	}

	ExploreBrimstoneCrag: {
		// DisplayName: Brimstone Crags
		// Description: Set foot in the Brimstone Crags at the edge of the Underworld
		// QuestObjective.Description: Reach the Brimstone Crags
		// DetailedDescription: On one side of Hell stands a cliff that has burned longer than anyone remembers. Dark red fire seeps from the brickwork, and an elemental spirit sleeps in the ruins.
	}

	ExploreAstral: {
		// DisplayName: Astral Blight
		// Description: Explore the star-tainted land
		// QuestObjective.Description: Reach the Astral Infection
		// DetailedDescription: A star crashed into the world, and what grows in the crater belongs to no bestiary. The land is changing color, the creatures are changing shape, and this is only the beginning.
	}

	AcidRainQuest: {
		// DisplayName: Acid Rain
		// Description: Weather an acid rain
		// QuestObjective.Description: Experience the Acid Rain event
		// DetailedDescription: The clouds over the sulphurous sea are yellow. When it rains the whole sea boils, and the things in the water climb ashore with it. Bring an umbrella. Seriously.
	}

	DeliciousMeatQuest: {
		// DisplayName: Delicious Meat
		// Description: Obtain a piece of Delicious Meat
		// DetailedDescription: Nobody knows what animal it came from, and nobody cares. Tasty, filling, doubles as a building block. Stock up.
	}

	BrimlishQuest: {
		// DisplayName: Brimlish
		// Description: Fish up a Brimlish
		// DetailedDescription: Even the acid water has fish in it, and they look surprisingly lively. Cast your line into the sulphurous sea and see what bites.
	}

	GiantClamQuest: {
		// DisplayName: Giant Clam
		// Description: Defeat the Giant Clam
		// DetailedDescription: The largest shell in the Sunken Sea. Quiet as a rock most days; everyone who pried it open regretted it.
	}

	CragmawMireQuest: {
		// DisplayName: Cragmaw Mire
		// Description: Defeat the Cragmaw Mire during the Acid Rain
		// DetailedDescription: Once the world hardens, something bitey floats up through the acid rain. It has far too many teeth, and all of them point at you.
	}

	MaulerQuest: {
		// DisplayName: The Mauler
		// Description: Defeat the Mauler during the Acid Rain
		// DetailedDescription: A shark raised on acid, with a temper to match the pH. By the time it breaches, remembering to dodge is already too late.
	}

	NuclearTerrorQuest: {
		// DisplayName: Nuclear Terror
		// Description: Defeat the Nuclear Terror during the Acid Rain
		// DetailedDescription: At the deepest hour of the acid rain, something enormous and glowing hatches. Even the acid water pulls back from where it walks.
	}

	GreatSandSharkQuest: {
		// DisplayName: Great Sand Shark
		// Description: Defeat the Great Sand Shark
		// DetailedDescription: The fastest hunter in the desert; the dunes are its open sea. Cull enough of its kin and the king of the pack will show up in person.
	}

	LeviathanQuest: {
		// DisplayName: Anahita and the Leviathan
		// Description: Defeat Anahita and the Leviathan
		// DetailedDescription: The song comes first, the great shadow after. The siren's melody guides the deep-sea beast; do not stop to listen.
	}

	AstrumAureusQuest: {
		// DisplayName: Astrum Aureus
		// Description: Defeat Astrum Aureus
		// DetailedDescription: Deep in the astral blight crouches an infected war machine. It wakes at night, and nothing grows where its treads have passed.
	}

	RavagerQuest: {
		// DisplayName: Ravager
		// Description: Defeat the Ravager
		// DetailedDescription: A giant pieced together from flesh and masonry, every limb attacking on its own. Tear off all four before the body itself gets serious.
	}

	AstrumDeusQuest: {
		// DisplayName: Astrum Deus
		// Description: Defeat Astrum Deus
		// DetailedDescription: Lay an offering on the astral beacon and an infected god swims down out of the night sky. Only its death opens the astral ore to your pickaxe.
	}

	BossRushQuest: {
		// DisplayName: The Final Battle
		// Description: Clear a Boss Rush
		// QuestObjective.Description: Complete the Boss Rush
		// DetailedDescription: Crush the Terminus and everything you have ever slain lines up to find you again. Kill them all a second time to put the seal on this journey.
	}

	AerialiteQuest: {
		// DisplayName: Aerialite Gleam
		// Description: Forge Aerialite Bars
		// DetailedDescription: When the Desert Scourge dies, pale blue ore-dust settles from the sky. Light enough to float, yet sturdier than iron.
	}

	CryonicQuest: {
		// DisplayName: Cryonic Crystal
		// Description: Forge Cryonic Bars
		// DetailedDescription: With Cryogen shattered, blue veins crystallize in the deep ice of the tundra. It does not melt in your hand; it only gets colder.
	}

	PerennialQuest: {
		// DisplayName: Perennial Gift
		// Description: Forge Perennial Bars
		// DetailedDescription: Where Plantera wilted, a breathing green metal grows from the soil. The jungle repays its debts in its own way.
	}

	LifeAlloyQuest: {
		// DisplayName: Life Alloy
		// Description: Smelt Life Alloys
		// DetailedDescription: Three living metals melted into one; the ingot still carries a pulse. Every high-end frame is built on it.
	}

	AstralBarQuest: {
		// DisplayName: Astral Smelting
		// Description: Forge Astral Bars
		// DetailedDescription: With the god-worm dead, the astral veins finally yield to the pickaxe. The bars glow on their own in the dark.
	}

	UelibloomQuest: {
		// DisplayName: Uelibloom in Blossom
		// Description: Forge Uelibloom Bars
		// DetailedDescription: After the goddess's holy fire swept through, metal flowers bloomed in the jungle mud. Smelt the petals into bars; the light stays inside.
	}

	BloodstoneQuest: {
		// DisplayName: Bloodstone Tempering
		// Description: Gather Bloodstone Cores
		// DetailedDescription: With the goddess fallen, dark red stones float up through the lava of the Brimstone Crags. They are still beating, like hearts outside their bodies.
	}

	AscendantEssenceQuest: {
		// DisplayName: Ascendant Spirit
		// Description: Condense Ascendant Spirit Essence
		// DetailedDescription: Phantoms, stardust, moonlight, and a stubborn will that refuses to scatter. Press them into one essence; it is enough to light a legend.
	}

	YharonSoulQuest: {
		// DisplayName: Embers of the Dragon Soul
		// Description: Collect Yharon Soul Fragments
		// DetailedDescription: When the great dragon burned out, what remained in the flames was not ash but shards of soul, still hot. Mind your heart when you pick them up.
	}

	FruitQuest: {
		// DisplayName: Gifts of Life
		// Description: Gather all four life-enhancing fruits
		// DetailedDescription: Strange fruit sometimes ripens beside the corpses of mighty foes. Four kinds in all, and every one pushes your life to a new limit.
	}

	DraedonPowerCellQuest: {
		// DisplayName: Ancient Power
		// Description: Collect Power Cells
		// DetailedDescription: The lab ruins are littered with cells that still hold a charge. An energy density far beyond your generators; worth studying.
	}

	DraedonsForgeQuest: {
		// DisplayName: The Master's Forge
		// Description: Obtain the master craftsman's forge
		// DetailedDescription: At the end of industry stands a furnace that can smelt anything. Assemble it, and your workshop will never again meet something it cannot make.
	}

	ConquerorMilestone: {
		// DisplayName: Chronicle of Conquest
		// Description: Defeat every mighty foe of this world
		// QuestObjective.Description: Complete all hunt quests
		// DetailedDescription: From King Slime to the things at the world's end, finish every hard fight there is. Few ever fill this page.
	}

	EventMilestone: {
		// DisplayName: Peacekeeper
		// Description: Quell every invasion and anomaly
		// QuestObjective.Description: Complete all event quests
		// DetailedDescription: Armies, fleets, moons from other worlds. Whatever came in numbers, you sent home.
	}

	CompletionistMilestone: {
		// DisplayName: The Complete Codex
		// Description: Finish everything in this book
		// QuestObjective.Description: Complete all quests
		// DetailedDescription: The last page of this book is reserved for whoever reads it all. By the time you close it, this world holds nothing you have not seen.
	}
}
