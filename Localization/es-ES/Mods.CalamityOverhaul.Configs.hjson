CWRServerConfig: {
	DisplayName: Configuración de contenido
	Headers.CWRWorldGen: Ajustes de estructuras Overhaul

	GenWindGrivenGenerator: {
		Label: Generar aerogeneradores
		Tooltip: Coloca estructuras de generadores eólicos por el mundo
	}

	GenWGGCollector: {
		Label: Generar chatarreros
		Tooltip: Genera al azar estructuras hostiles de chatarreros por el mundo. Solo tiene efecto en mundos legendarios
	}

	GenJunkmanBase: {
		Label: Generar base de chatarreros
		Tooltip: Genera una base fortificada de chatarreros en páramos o bajo tierra
	}

	GenRocketHut: {
		Label: Generar cabaña del cohete
		Tooltip: Genera una cabaña misteriosa con piezas de cohete o reliquias tecnológicas
	}

	GenSylvanOutpost: {
		Label: Generar puesto silvano
		Tooltip: Genera un puesto de madera de elfos o guardianes del bosque en lo profundo del bosque
	}

	GenSHPCCradle: {
		Label: Generar isla de la cuna de SHPC
		Tooltip: Genera una isla flotante de cabina estrellada sobre el punto de aparición, con SHPC sellada en su interior. Si se desactiva, el arma solo podrá obtenerse en el laboratorio de Calamity
	}

	ConfigChangePrefix: Usuario
	ConfigChangeSuffix: ha modificado la configuración del servidor
}

CWRClientConfig: {
	DisplayName: Configuración del cliente
	Headers.CWRWeapon: Ajustes de armas Overhaul

	ScreenVibration: {
		Label: Vibración de pantalla en ataques especiales de armas
		Tooltip: Si se activa, algunos ataques harán vibrar la pantalla, lo que puede intensificar la sensación de impacto
	}

	DomainConciseDisplay: {
		Label: Dominio en modo minimalista
		Tooltip: Desactivado por defecto. Al activarlo, solo simplifica las puestas en escena de dominios como el Ciberespacio o el mar; no afecta al Reino espectral de Onikiri ni a efectos de armas e implantes como Desmembrar, efigie o Tiempo de hackeo
	}

	LensEasing: {
		Label: Suavizado de la cámara
		Tooltip: Al habilitarlo, los desplazamientos rápidos a larga distancia suavizan la cámara y evitan la sensación extraña de moverse demasiado rápido
	}

	AmbienceDensity: {
		Label: Densidad de ambiente
		Tooltip: Solo escala la densidad de partículas decorativas de ambiente; la visibilidad de avisos y peligros no se reduce nunca
	}
}
