GodSmithExecutionEndow: {
	EndowName: Tajo de ejecución
	EndowDesc:
		'''
		Al golpear a un enemigo por debajo del {0}% de vida, sueltas un tajo de ejecución
		El tajo inflige el {1}% de ese golpe
		'''
}

GodSmithOverkillEndow: {
	EndowName: Cadena de exceso
	EndowDesc:
		'''
		Al matar a un enemigo, un rayo carmesí salta a uno cercano
		Lleva el {0}% del daño excedente, más el {1}% de ese golpe
		'''
}

GodSmithCritMarkEndow: {
	EndowName: Sello crítico
	EndowDesc:
		'''
		Los golpes graban un sello; al llegar a {0} capas, detona
		La explosión es un crítico asegurado, de base el {1}% de ese golpe
		'''
}

GodSmithEchoSlashEndow: {
	EndowName: Eco del viento de espada
	EndowDesc:
		'''
		Un golpe alza un viento de espada que se abre alrededor
		Inflige el {0}% de ese golpe a los demás enemigos
		'''
}

GodSmithShockwaveEndow: {
	EndowName: Onda de choque
	EndowDesc:
		'''
		Cada 1.5 s, un golpe estalla una onda de choque
		Empuja a los enemigos cercanos e inflige el {0}% de ese golpe
		'''
}

GodSmithComboEndow: {
	EndowName: Estallido de combo
	EndowDesc:
		'''
		Los golpes seguidos acumulan ímpetu; el {0}.º golpe estalla
		Inflige en área el {1}% de ese golpe
		Soltar o cambiar de arma disipa el ímpetu
		'''
}

GodSmithAfterimageEndow: {
	EndowName: Tajo residual
	EndowDesc:
		'''
		Cada {0}.º uso, una posimagen taja hacia la mira
		Inflige el {1}% del daño del arma
		'''
}

GodSmithBallisticEndow: {
	EndowName: Trazadora perforanubes
	EndowDesc:
		'''
		Cada {0}.º disparo añade una trazadora
		Atraviesa enemigos e inflige el {1}% del daño del arma
		'''
}

GodSmithRicochetEndow: {
	EndowName: Rebote errante
	EndowDesc:
		'''
		Tras un impacto, una bala rebota hacia otro enemigo
		Inflige el {0}% de ese golpe
		'''
}

GodSmithPhantomVolleyEndow: {
	EndowName: Salva fantasma
	EndowDesc:
		'''
		Cada {0}.º disparo llama {1} proyectiles fantasma que acompañan la salva
		Cada uno inflige el {2}% del daño del arma
		'''
}

GodSmithManaRefluxEndow: {
	EndowName: Reflujo de maná
	EndowDesc:
		'''
		Un golpe tiene un {0}% de probabilidad de arrancar un hilo de maná que vuela hacia ti
		Atraparlo restaura {1} de maná
		'''
}

GodSmithOverloadEndow: {
	EndowName: Sobrecarga arcana
	EndowDesc:
		'''
		Por encima del {0}% de maná, un golpe detona arcos violeta
		Añaden el {1}% de ese golpe
		'''
}

GodSmithMythicEchoEndow: {
	EndowName: Canto estelar
	EndowDesc:
		'''
		Lanzar un hechizo llama un espíritu de estrella a tu lado
		De vez en cuando lanza proyectiles estelares a enemigos cercanos, por el {0}% del daño del arma
		'''
}

GodSmithDesperationEndow: {
	EndowName: Quemar las naves
	EndowDesc:
		'''
		Esta arma rota ruge en la adversidad
		Un golpe tiene un {0}% de probabilidad de estallar, inflige en área el {1}% de ese golpe
		Cuanto más ruin es el prefijo, más violento el estallido
		'''
}

GodSmithHiddenEdgeEndow: {
	EndowName: Filo oculto
	EndowDesc:
		'''
		Un arma torpe esconde su filo verdadero
		Cada {0}.º uso destella un tajo blanco que inflige el {1}% del daño del arma
		Cuanto más lenta y tosca es el arma, más cortante el filo oculto
		'''
}

GodSmithLuckyStarEndow: {
	EndowName: Estrella de la suerte
	EndowDesc:
		'''
		Un crítico hace caer una estrella de la suerte sobre el objetivo
		Inflige el {0}% de ese golpe
		'''
}

GodSmithMenaceEndow: {
	EndowName: Intención asesina
	EndowDesc:
		'''
		Los golpes acumulan intención asesina; el {0}.º golpe rasga una garra negro-roja
		Inflige el {1}% de ese golpe
		'''
}

GodSmithSwiftFootEndow: {
	EndowName: Viento de carrera
	EndowDesc:
		'''
		Correr unos {0} bloques carga el viento
		El siguiente golpe suelta una hoja de viento que atraviesa, por el {1}% de ese golpe
		'''
}

GodSmithViolentSurgeEndow: {
	EndowName: Estallido de furia
	EndowDesc:
		'''
		Los golpes cuerpo a cuerpo acumulan furia; al llegar a {0} capas, estalla un anillo de hojas carmesí
		Inflige en área el {1}% de ese golpe
		'''
}

GodSmithArcaneWardEndow: {
	EndowName: Amparo arcano
	EndowDesc:
		'''
		Al recibir un golpe, el maná teje un amparo rúnico
		Cada punto de maná bloquea {0} de daño, hasta el {1}% de ese golpe
		'''
}
