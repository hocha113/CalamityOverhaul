NeutronWand: {
	DisplayName: Light of the Star Tomb
	Tooltip:
		'''
		Left click hurls a pulsar at the cursor; it brakes to a halt and spins ever faster
		Its two magnetic beams sweep the field as it turns, and three may stand at once
		Hold right click to apply magnetic braking, forcing the spin's energy into the crust
		Release for a starquake: the crust splits, the magnetosphere reconnects, survivors overclock
		"The psychic meant to crush stars into black holes, but only ever made remnants
		frozen in degenerate matter. Nomads call that stretch of sky the Star Tomb."
		'''
}

DragonsWord: {
	DisplayName: Dragon's Word
	Tooltip:
		'''
		Fires dragon tears that spin for a while before homing in on enemies.
		Right-click to cast Dragon Command Magic at the cursor, issuing a death command to enemies within the area.
		"A dragon can shed tears only once in its lifetime."
		'''
}

UnderTheSand: {
	DisplayName: Beneath the Sand
	Tooltip:
		'''
		Hurls a pair of sand surges that arc downward under gravity
		On impact with the ground, a vertical sand spike erupts from beneath, launching enemies skyward
		'''
}

MelodyTheSand: {
	DisplayName: Song of the Sand
	Tooltip:
		'''
		Fires a small sand tornado that falls to the ground under gravity
		Once grounded, it patrols back and forth along the surface, reversing at walls and ledges
		Repeatedly hurls struck enemies into the sky
		'''
}

SandVortexOfTheDecayedSea: {
	DisplayName: Decayed Sea Sand Vortex
	Tooltip:
		'''
		Summons a colossal decayed sea vortex at the cursor
		The vortex relentlessly draws nearby enemies in and rends them, even unraveling hostile projectiles
		Periodically hurls outward homing decayed sea orbs
		Firing again refreshes the existing vortex; on natural collapse it bursts into a ring of orbs
		"The roar of the rotting depths churned into sand"
		'''
}

FocusingGrimoire: {
	DisplayName: Focusing Grimoire
	Tooltip:
		'''
		Left click fires homing thermal rings that mark enemies on impact
		Right click rapidly fires death rays, which deal bonus damage and always crit against marked enemies
		"Better than six books combined"
		'''
}

CommandersStaff: {
	DisplayName: Commander's Staff
	Tooltip:
		'''
		Fires a thermal disintegration beam that pierces enemies
		"Taken from that machine’s arm, how about using psionic energy instead of diesel?"
		'''
}

Eyetooth: {
	DisplayName: Eyetooth
	Tooltip:
		'''
		Hurls a fang torn from the Eye of Cthulhu at your foes
		On biting an enemy, the fang springs above its head, takes aim, then dives in for a second bite
		The dive deals 150% damage, and fang wounds keep weeping blood
		'''
}

CommandersStaffEX: {
	DisplayName: Commander's Staff EX
	Tooltip:
		'''
		Fires five overcharged beams that spiral and converge like a cutting drill
		"Suitable for cutting metal"
		'''
}

TomeofFungalDecay: {
	DisplayName: Tome of Fungal Decay
	Tooltip: Fires a ring of spore bursts
}

Pandemonium: {
	DisplayName: Pandemonium
	Tooltip:
		'''
		Left-click to charge and release Transcendent Magic
		Right-click to cast a Brimstone Rune at the cursor
		While held, two skill buttons light up at the bottom left of the screen
		Click them to unleash Brimstone Judgement or The End of All Demons
		'''
	SkillLeftName: Brimstone Judgement
	SkillLeftDesc: Calls down a field of brimstone fire pillars around the cursor
	SkillRightName: The End of All Demons
	SkillRightDesc: Unfolds a giant magic circle centered on you, pounding foes inside with lightning and fire
}

Elysium: {
	DisplayName: Elysium
	Tooltip:
		'''
		Hold left-click to channel the Serpent Rite
		Release to send out a wave of holy light, turning lesser foes it touches into sacred serpents that hunt for you
		Right-click to exalt a nearby town resident, calling them to your side as a disciple
		Disciples orbit you, each serving in their own office, and grant holy blessings
		Damage from bosses burns away one disciple, leaving one point of Martyrdom Power
		With eleven Martyrdom Power and John still in office, a skill button can unveil Revelation
		Once Revelation descends, right-click instead summons the Four Horsemen
		The skill buttons then become Celestial Meteor and the Judgement of the Last Seals
		With all twelve seats filled the blessing peaks, but near death you will meet Judas's blade
		Hold Shift while held to open the Rose Window; drag seats to reassign holy offices
		While held, two skill buttons light up at the bottom left of the screen
		'''
	SkillLeftName: Divine Thunder
	SkillLeftDesc: Calls down a holy bolt upon the foe nearest the cursor
	SkillRightName: Judgement of the Last Seals
	SkillRightDesc: Breaks the fifth, sixth and seventh seals in turn; the finale judges all foes and Revelation ends
	SkillRightLockedDesc: Only after Revelation descends may the seals be broken
	SkillOpenName: Unveil Revelation
	SkillOpenDesc: John shall ascend in martyrdom, and the Kingdom's domain shall descend
	SkillMeteorName: Celestial Meteor
	SkillMeteorDesc: Calls a celestial body down from the heavens upon the cursor
	NoConvertTargetText: No resident nearby can be exalted
	SeatsFullText: All twelve holy seats are filled
	JudasDeathReasonText: "{0} was sold out by Judas for thirty pieces of silver"
	DiscipleName_0: Peter
	DiscipleName_1: Andrew
	DiscipleName_2: James
	DiscipleName_3: John
	DiscipleName_4: Philip
	DiscipleName_5: Bartholomew
	DiscipleName_6: Thomas
	DiscipleName_7: Matthew
	DiscipleName_8: James the Less
	DiscipleName_9: Thaddaeus
	DiscipleName_10: Simon the Zealot
	DiscipleName_11: Judas
}

AriaofTheCosmos: {
	DisplayName: Aria of the Cosmos
	Tooltip:
		'''
		Hold left-click to charge a powerful quasar, dealing devastating damage upon release
		Right-click to release a miniature black hole that fires a barrage of gamma rays once formed
		While held, two skill buttons light up at the bottom left of the screen
		Click them to summon a Star Ring Guardian or trigger a Gamma Ray Burst
		'''
	SkillLeftName: Star Ring Guardian
	SkillLeftDesc: Summons an orbiting star ring whose nodes volley stardust at nearby enemies
	SkillRightName: Gamma Ray Burst
	SkillRightDesc: After a brief charge, unleashes nine gamma rays in a fan toward the cursor
}

WheezingWyrm: {
	DisplayName: Wheezing Wyrm
	Tooltip:
		'''
		Hold to breathe a stream of dragonfire
		The old head has seen better days, and needs a few smoky coughs before it catches
		Sustained breathing stokes the throat ever hotter, from dull red all the way to searing blue
		Brighter flame burns hotter; blue flame deals the highest damage and ignites hellfire
		"Not quite dead, just an old smoker clearing its throat"
		'''
}

Everdeep: {
	DisplayName: Everdeep
	Tooltip:
		'''
		Fires a ring of pressurized abyssal water
		The ring pierces through foes, coasts a short way, then curls back to strike again
		Hits build abyssal resonance, counted by the droplets orbiting the tome
		At full resonance, a giant maelstrom erupts from the ground beneath the victim
		"The deep does not part for you; it closes behind you"
		'''
}

BloomTome: {
	DisplayName: Bloomtome
	Tooltip:
		'''
		Fires a budding bolt
		The bolt blooms into a ring of petals when it strikes an enemy or the ground
		Every fourth cast becomes a full bloom with more petals, bursting two needles upward
		"Whichever page you open, that page blooms"
		'''
}
