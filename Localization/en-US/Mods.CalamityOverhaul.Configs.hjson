CWRServerConfig: {
	DisplayName: Content Config
	Headers.CWRWorldGen: World Gen Configs

	GenWindGrivenGenerator: {
		Label: Generate Wind-Driven Generator
		Tooltip: Places wind-powered generator structures throughout the world.
	}

	GenWGGCollector: {
		Label: Generate Scavenger Outposts
		Tooltip: Randomly spawns hostile scavenger structures throughout the world. This setting only takes effect in Legendary worlds.
	}

	GenJunkmanBase: {
		Label: Generate Junkman's Base
		Tooltip: Spawns a scavenger stronghold base in wastelands or underground.
	}

	GenRocketHut: {
		Label: Generate Rocket Hut
		Tooltip: Generates a mysterious shack containing rocket components or technological relics.
	}

	GenSylvanOutpost: {
		Label: Generate Sylvan Outpost
		Tooltip: Spawns wooden elven or forest guardian outposts deep within the forest.
	}

	GenSHPCCradle: {
		Label: Generate SHPC Cradle Island
		Tooltip: Generates a crashed vessel sky island above spawn with the SHPC sealed inside. When disabled, the weapon can only be found in Calamity's laboratory.
	}

	ConfigChangePrefix: User
	ConfigChangeSuffix: modified the server configuration
}

CWRClientConfig: {
	DisplayName: Client Config

	Headers: {
		CWRWeapon: Weapon Configs
		CWRDisplay: Display Configs
		CWRModCompat: Mod Compatibility Patches
	}

	ScreenVibration: {
		Label: Weapon Screen Vibration
		Tooltip: If turned on, the screen will vibrate during some attacks, which may make the hit feel more intense
	}

	DomainConciseDisplay: {
		Label: Domain Minimal Display
		Tooltip: Off by default. When enabled, only Cyberspace / Sea Domain style domain visuals are reduced. Onikiri's Oni Domain is unaffected, as are weapon and cyberware visuals such as dismember, omokage, and HackTime.
	}

	LensEasing: {
		Label: Lens Easing
		Tooltip: When enabled, long distance rapid displacement will slow the lens, which avoids the feeling of being moved too fast
	}

	AmbienceDensity: {
		Label: Ambience Density
		Tooltip: Scales decorative ambience particle density only; telegraphs and hazards are never reduced.
	}

	RarityTextEffects: {
		Label: Rarity Name Effects
		Tooltip: Animated item-name effects for this mod's rarities (Lapis, Jade, Copper, Gilt, Starsilver and the four Legends). When disabled, names are drawn in plain color.
	}

	CalamityRarityTextFix: {
		Label: Calamity: Fix black screen caused by name text effects
		Tooltip:
			'''
			Calamity's Burnished Auric / Exotic Rainbow rarities and [ceffect] tags swap render targets while a tooltip is being drawn,
			which discards the back buffer and blacks out the whole frame. When enabled, the effects are redrawn without render targets,
			which also fixes misalignment at non-100% UI scale and reduces per-frame overhead.
			'''
	}

	CalamityHolyBurnOrbFix: {
		Label: Calamity: Fix Profaned Guardians / Providence crash
		Tooltip:
			'''
			Calamity's holy orb trail drawer caches projectile references and keeps drawing them by their original type
			after the slot has been reused by another projectile, causing a NullReferenceException (common in multiplayer).
			When enabled, stale references are pruned right before drawing.
			'''
	}
}
