ModifyChargingStationItem: {
	DisplayName: Charging Station
	Tooltip:
		'''
		Uses electricity to charge electrical devices  
		Batteries can be placed inside to store electricity  
		Can be connected to pipelines for power transmission  
		Right-click the block while holding a rechargeable item to quickly insert it  
		Shift + Right-click to retrieve items
		'''
}

DyeVatItem: {
	DisplayName: "{$ItemName.DyeVat}"
	Tooltip:
		'''
		Used for crafting dyes
		Right-click after placing to open the control panel, allowing you to dye items
		Place a Water Bucket into the dye slot to wash dyes off items
		'''
}

RDemonConch: {
	DisplayName: Demon Conch
	Tooltip:
		'''
		Listen closely and you'll hear screams
		"Be careful."
		'''
}

RBloodButcherer: {
	DisplayName: "{$ItemName.BloodButcherer}"
	Tooltip:
		'''
		Heavy three-hit butcher combo, the third cut sweeps wider and harder
		Swings fling gouts of dark blood that arc down and splatter on impact
		Struck enemies are Blood Butchered
		'''
}

RTerraBlade: {
	DisplayName: "{$ItemName.TerraBlade}"
	Tooltip:
		'''
		Five-beat combo: two heavy vertical cleaves, two rapid elliptical sweeps, then one grand spin
		Every beat releases homing Terra Light along the blade path: 1 per cleave, 2 per sweep, 4 on the spin
		Terra Light that strikes an enemy calls forth one of the blade's forged souls, alternating light and night
		Light soul: a spectral True Excalibur descends from above and pierces the target
		Night soul: a spectral True Night's Edge whirls at the point of impact, striking repeatedly
		'''
}
