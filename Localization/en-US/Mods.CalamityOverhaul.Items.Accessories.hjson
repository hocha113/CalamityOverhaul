JusticeUnveiled: {
	DisplayName: Justice Unveiled
	Tooltip:
		'''
		Ranged attacks build charges of "Judgment Strike", up to a maximum of 5
		Press [UP] to expend 1 charge and call down a devastating holy impact
		"Should justice be summoned, I shall heed the call—wherever it leads."
		'''
}

EmblemOfDread: {
	DisplayName: Emblem of Dread
	Tooltip:
		'''
		Increases melee damage by 100%
		Increases melee critical strike chance by 100%
		Increases melee speed by 100%
		Increases defense by 100, ignoring all defense damage and reduction
		Reduces incoming damage by 75% and reflects 100x damage back to the attacker
		All melee attacks inflict the 'Void Erosion' debuff
		True melee attacks have a chance to instantly erase enemies with less than 250,000 HP
		Moving at high speeds leaves warp points in your path, dealing extreme damage to enemies
		Grants the ability to use Gravity Dash; press [KEY] to dash a long distance and release massive gravitational rays
		If you receive fatal damage, you immediately regain full HP and gain a Gravity Shield (60 second cooldown)
		Enemies are more likely to target you
		[c/d94fff:"A sanctified angel veils your gaze, whispering eternal, saccharine lies"]
		[c/ff4d4d:"A blood-soaked butcher raises your twin blades, declaring that only slaughter brings glory"]
		[c/4da6ff:"An azure dove pecks through your brow, mocking your insignificant struggle"]
		'''
}

Proverbs: {
	DisplayName: Proverb
	Tooltip:
		'''
		Generates a small brimstone rune behind you
		Grants immunity to most fire-based debuffs
		Most of your attacks inflict the Withered Curse debuff
		[Content]
		'''
	L1:
		'''
		Deals double damage to the Brimstone Witch; 
		her attacks have a chance to critically strike you
		'''
	L2:
		'''
		If you are reading this, then I am likely already gone.
		Throughout my long years, this ring was the only thing that felt truly cold.
		But somewhere along the way, it absorbed a mortal's warmth... and became... too hot to let go.
		I have returned to the Brimstone, reduced to the ashes of an era.
		I should have departed with nothing, 
		yet I found myself greedy for this singular warmth, wishing to preserve it.
		Wear it.
		And when you finally raise your blade against the gods...
		Know that even if the world freezes over, I will still be burning at your fingertips.
		'''
}

Unsunghero: {
	DisplayName: Unsung Hero
	Tooltip:
		'''
		Leaves a trail of black and white checkered squares behind you as you walk
		"What if you never return?"
		"Then I shall never return."
		'''
}

GodslayerScabbard: {
	DisplayName: Godslayer Scabbard
	Tooltip:
		'''
		Accumulates charge while holding a melee weapon without attacking
		Attacking with full charge grants 2 second of invulnerability
		"Though the blade remains sheathed, its killing intent is palpable.
		When the time is right, slaying a god takes but an instant."
		'''
}

FrogsparkBoots: {
	DisplayName: Frogspark Boots
	Tooltip:
		'''
		Allows flight, super fast running, and steady ice skating that won't break thin ice
		Walk on water, honey and lava, and gain immunity to the Burning debuff
		Grants 7 seconds of lava immunity, greatly reducing lava damage afterwards
		Increases jump speed by 48%, enables auto-jump, and greatly increases fall resistance
		"One frog kick, and flames clear the way"
		'''
}

CthulsparkBoots: {
	DisplayName: Cthulspark Boots
	Tooltip:
		'''
		Grants all the powers of the Frogspark Boots
		Gain cloud, blizzard and sandstorm extra jumps, increased jump height, and immunity to fall damage
		Double tap a direction to charge alongside the great eye, ramming foes out of the way
		"It floats overhead, watching every step for you"
		'''
}

NinjaCthulsparkBoots: {
	DisplayName: Ninja Cthulspark Boots
	Tooltip:
		'''
		Grants all the powers of the Cthulspark Boots
		Grants a 10% chance to dodge attacks, and the ability to climb and slide down walls
		Double tap a direction to perform a crimson shadow dash, faster and farther, trailing scarlet afterimages
		The charge bashes enemies aside like the Shield of Cthulhu, granting a moment of immunity on impact
		"The eye tied on its headband and swore never to blink again"
		'''
}
