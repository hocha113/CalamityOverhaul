HalibutText: {
	HalibutAtlas: {
		TitleText: A B Y S S A L  A T L A S
		NavSea: Skill Sea
		NavEyes: Domain Eyes
		TierName0: Shallows · Sunlit Zone
		TierName1: Open Sea · Twilight Zone
		TierName2: Deep Sea · Midnight Zone
		TierName3: Abyss · Lightless Zone
		DockLabel: Loadout {0} / {1} · Left-click to select, right-click to remove
		LockedNodeName: Unknown Silhouette
		LockedNodeHint: Research {0} at the Research Altar to light up this skill
		EquipBtn: Equip
		UnequipBtn: Remove
		SelectBtn: Select
		SelectedTag: Active
		EquippedTag: Equipped
		NodeEquipHint: Double-click to equip · Right-click works too · Or drag it into the loadout
		NodeUnequipHint: Already in the loadout · Right-click to remove
		DockSlotHint: Left-click to select · Right-click to remove · Drag to reorder
