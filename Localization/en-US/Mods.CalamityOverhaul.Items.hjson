RapidBarrelModule: {
	DisplayName: Rapid Barrel
	Tooltip:
		'''
		Sustained fire builds barrel heat: the hotter it runs, the faster it fires, searing beams red-hot into white-glowing incandescence that sheds molten cinders
		Redlining the gauge triggers an overheat vent for several seconds: peak fire rate with zero mana cost, steam blasting from the muzzle under a blaring alarm
		A forced cooldown follows with heavily reduced fire rate; heat slowly dissipates while holding fire - manage the heat, ride the redline
		'''
}

FocusBarrelModule: {
	DisplayName: Focus Barrel
	Tooltip: Forces the three tracking beams to converge into one catastrophic concentrated strike
}

PrecisionOpticModule: {
	DisplayName: Precision Optic
	Tooltip:
		'''
		Calibrated Judgment: eliminates all spread; consecutive hits without a miss build calibration
		At fifteen stacks, fires a guaranteed-crit piercing judgment ray — missing a beam resets calibration
		'''
}

OverloadCoreModule: {
	DisplayName: Overload Core
	Tooltip:
		'''
		Removes the orb's safety lock: keep charging past full to overload it — up to double damage and a wider blast
		Hold past the red line and the core ruptures in your hands, knocking you back and burning half your mana
		'''
}

SteadyStockModule: {
	DisplayName: Steady Stock
	Tooltip:
		'''
		Pauses between shots charge a voltage capacitor, shown on a gauge above your head; firing discharges it to empower that entire volley
		A full discharge adds pierce and voltage filigree, but full charge only holds for a short window before venting to zero - deliberate, paced shots gain the most, while holding the trigger barely charges at all
		In laser mode, igniting the beam dumps the stored charge for a brief surge of echo damage
		'''
}

HarmonyGripModule: {
	DisplayName: Harmony Grip
	Tooltip:
		'''
		Bio-conduction lowers mana cost; mana spilled on hit condenses into resonant wisps across the battlefield
		Wisps drift back to you — collecting one restores mana and stacks Harmonics for attack speed (up to 5)
		'''
}

ResonanceFrameModule: {
	DisplayName: Resonance Frame
	Tooltip:
		'''
		Standing-wave metronome: counts your shots, every fourth becomes a resonant beat beam — thicker, harder, piercing one extra target
		On hit, a beat beam slams out a ring-shaped oscillation wave, dealing area damage and gently knocking foes outward
		Keeping the rhythm stacks tempo to empower further beats; pausing too long resets the tempo
		In laser mode the column pulses to a fixed beat, landing hits inside the beat window also unleashes the wave
		'''
}

AdaptiveOpticModule: {
	DisplayName: Adaptive Optic
	Tooltip:
		'''
		Predictive fire control: analyzes target motion and projects a holographic lead marker at the intercept point
		Beams automatically deflect to lead their shots; hits against moving targets trigger bonus adaptive strikes
		'''
}

AssaultStockModule: {
	DisplayName: Assault Stock
	Tooltip:
		'''
		Twin combat pods are built into the stock: while wielding the weapon, a pair of hovering gun-arms deploys at your shoulders
		The arms sync with your trigger, alternating rapid support bolts with every shot you fire
		'''
}

BalancedGripModule: {
	DisplayName: Balanced Grip
	Tooltip:
		'''
		Twin Equilibrium Protocol: beam hits build Yang charge, charge orbs build Yin charge
		While both charges stay in balance the scales align — damage, fire rate and mana efficiency all rise
		'''
}

CapacitorBankModule: {
	DisplayName: Capacitor Bank
	Tooltip:
		'''
		Charging lights up a rack of six capacitor cells overhead, one by one as the orb fills
		Once the orb launches, the rack stays behind and discharges cell by cell, firing feed arcs at the flying orb
		Each arc that lands pumps extra damage and blast radius into the orb — the farther it flies, the harder it hits
		'''
}

CrystalGripModule: {
	DisplayName: Crystal Grip
	Tooltip:
		'''
		Synthetic crystal dielectric trims mana cost and boosts crit; critical impacts refract into matter —
		shards burst from the target in ballistic arcs, then curve toward nearby foes under lattice gravity
		'''
}

EfficientGripModule: {
	DisplayName: Efficient Grip
	Tooltip:
		'''
		Zero-Loss Loop protocol: beam and laser hits reclaim energy from each shot's mana cost, condensing recycle cells that orbit you
		At eight cells your next left-click becomes a Zero-Loss Shot — full mana refund, and every cell floods the muzzle to empower that volley
		In laser mode the Zero-Loss Shot instead dumps every cell at your cursor, detonating the reclaimed energy
		'''
}

HeavyBarrelModule: {
	DisplayName: Heavy Barrel
	Tooltip:
		'''
		Reinforced rifling crushes spread and cadence; every shot lands as a heavy gouge
		Beam and laser hits on the same target carve notches; the fourth notch hammers in a piledriving maul
		The maul deals a guaranteed crit scaled from your heaviest gouge and briefly sunders the target's armor (the sunder only benefits your own hits)
		'''
}

HighVoltageCoreModule: {
	DisplayName: High Voltage Core
	Tooltip:
		'''
		A high-voltage capacitor charges with every hit
		At full charge, your next hit discharges a piercing arc from your body through everything in its path
		'''
}

HoloOpticModule: {
	DisplayName: Holo Optic
	Tooltip:
		'''
		Tactical lattice projector: periodically deploys a holographic lattice at your cursor while fighting
		Hostile projectiles touching it dissolve; your beams passing through are recalibrated — empowered and re-aimed
		'''
}

HypersonicBarrelModule: {
	DisplayName: Hypersonic Barrel
	Tooltip:
		'''
		Ramjet rifling makes beams accelerate in flight; breaking the sound barrier detonates a mach-ring shockwave
		Past the barrier, beams go white-hot: bonus damage, extra pierce and a vapor condensation trail
		'''
}

KineticDamperModule: {
	DisplayName: Kinetic Damper Stock
	Tooltip:
		'''
		Hydraulic dampers store recoil from your hits as kinetic reserve; above half reserve you cannot be knocked back
		The moment you take damage, the full reserve erupts as a seismic counter-wave that blasts enemies away
		'''
}

LightStockModule: {
	DisplayName: Light Stock
	Tooltip:
		'''
		Segmented lightweight frame raises fire rate and turns every main beam into a crawling light-chain —
		two chain segments trail along the beam's path, each dealing its own damage
		'''
}

MultiCellFrameModule: {
	DisplayName: Multi-Cell Frame
	Tooltip:
		'''
		Matrix feed protocol: deploys a six-cell energy matrix around you; each volley that connects charges one cell, the prism laser charges more slowly
		Once all six cells are lit, the matrix primes and fires a salvo of six seeking beams at the target from its cell positions, then empties and briefly locks down to cool off
		'''
}

PlasmaInjectorModule: {
	DisplayName: Plasma Injector
	Tooltip:
		'''
		Injects high-enthalpy plasma into the orb: its detonation leaves behind a miniature plasma sun
		The sun scorches everything nearby and periodically lashes the closest enemy with solar flares
		'''
}

QuantumFrameModule: {
	DisplayName: Quantum Frame
	Tooltip:
		'''
		Entanglement protocol: hitting two different targets in succession quantum-entangles them for a few seconds
		Damage dealt to either is partially copied to the other; when one dies, the link collapses and slams the accumulated echo into the survivor
		'''
}

ScattershotBarrelModule: {
	DisplayName: Scattershot Barrel
	Tooltip:
		'''
		Fractured muzzle splits each shot into a spray of short-ranged beams; on its first hit or at the end of its flight, each beam shatters into a cone of glass-light shards
		Shards never home and their damage decays sharply over distance: a point-blank volley nails the whole cluster into one target, while distant shots only graze
		Detonating the charge orb also blasts an oversized shard burst along its flight path
		'''
}

ThermalOpticModule: {
	DisplayName: Thermal Optic
	Tooltip: Hits brand heat scars onto targets, searing prey from iron-red to incandescence in the thermal view; at full heat the white-hot lock engages, beams bite hard onto that target with bonus crit and sustained scorching
}

VolatileFrameModule: {
	DisplayName: Volatile Frame
	Tooltip:
		'''
		The frame's containment field destabilizes: every beam is born with a random chaotic mutation, marked by a glitch overlay in its mutation color
		Fission (cyan) forks mid-flight; Overload (red) doubles damage with a frantic trajectory; Unstable (orange) detonates on first hit; Aberrant (purple) veers toward the nearest enemy
		In laser mode the field surges periodically: Overload surges echo bonus damage, Unstable surges detonate on accumulated hits
		'''
}

NovaBarrelModule: {
	DisplayName: Nova Barrel
	Tooltip:
		'''
		An overcharged plasma muzzle detonates a micro-pulse where each beam lands
		The price is wider spread, weaker per-shot impact and heavier mana draw
		'''
}

PrismOpticModule: {
	DisplayName: Prism Optic
	Tooltip:
		'''
		A phase prism at the end of the optical path forks each beam into two splinters on expiration
		Primary beams travel a touch shorter in exchange for a sharper crit window
		'''
}

TeslaCoreModule: {
	DisplayName: Tesla Core
	Tooltip:
		'''
		High-voltage arcing lets struck beams leap to the nearest foe
		Each chained node inherits the on-hit behaviors, at a steeper mana cost
		'''
}

RecoilStockModule: {
	DisplayName: Recoil Stock
	Tooltip:
		'''
		An overload buffer converts orb detonations into kinetic propellant for the wielder
		Beam range is extended in tandem; the trigger feels a touch sluggish
		'''
}

SwarmGripModule: {
	DisplayName: Swarm Grip
	Tooltip:
		'''
		A neural-mesh grip releases a swarm of strongly homing micro-orbs the moment the orb detonates
		Orb velocity dips and mana draw climbs as compensation
		'''
}

GravityFrameModule: {
	DisplayName: Gravity Frame
	Tooltip:
		'''
		A miniature singularity ring turns the energy orb into a gravitic well
		It pulls nearby foes toward its core while charging and the detonation radius is greatly enlarged
		The precision chamber makes charging feel slightly heavier
		'''
}

LaserBarrelModule: {
	DisplayName: Prism Laser Barrel
	Tooltip: Converts the merged beam into a continuous prism laser column, at the cost of massive mana consumption and limited output power
}

OscillatorBarrelModule: {
	DisplayName: Oscillator Laser Barrel
	Tooltip:
		'''
		An embedded pulse capacitor detonates an energy pulse at the beam endpoint every 30 frames
		Direct damage is slightly reduced, but area bursts and lower mana cost compensate for sustained fire
		'''
}

ScorchBarrelModule: {
	DisplayName: Scorch Laser Barrel
	Tooltip:
		'''
		A high-enthalpy plasma nozzle sets struck enemies ablaze on laser contact
		Direct beam damage is slightly lower, but sustained burning offsets the direct output loss
		'''
}

ReflectionBarrelModule: {
	DisplayName: Reflection Laser Barrel
	Tooltip:
		'''
		A diamond prism at the impact point deflects part of the energy into two flanking beams
		Main beam damage increases, but the extreme mana draw makes sustained fire costly
		'''
}

EchoOpticModule: {
	DisplayName: Echo Optic
	Tooltip:
		'''
		A resonance element at the path end captures the energy echo when a beam expires
		Each beam death spawns three fan-spread homing sub-beams, offsetting the shortened range
		'''
}

FrostOpticModule: {
	DisplayName: Frost Optic
	Tooltip:
		'''
		A cryo-focusing lens inflicts Frostburn on struck targets
		Beam velocity is reduced but homing is more stable, with bonus pierce and crit
		'''
}

SingularityCoreModule: {
	DisplayName: Singularity Core
	Tooltip:
		'''
		A micro-gravity generator continuously steers the orb toward the nearest enemy in flight
		Explosion radius is greatly expanded, but the dense field drives up mana cost
		'''
}

ScrambleFieldModule: {
	DisplayName: Scramble Field Module
	Tooltip:
		'''
		A high-frequency coil fires a micro-shockwave around the orb every 40 frames while charging
		Blast scale is amplified at the cost of slower charge time and higher mana usage
		'''
}

BraceStockModule: {
	DisplayName: Brace Stock
	Tooltip:
		'''
		Standing still on solid ground for about a second auto-deploys a hydraulic tripod, anchoring into turret mode
		While deployed: beams gain zero spread, greatly extended range and velocity, extra pierce and ballistic stabilization, plus +8% crit chance
		Moving or leaving the ground instantly folds the rig; redeploying within 8 seconds keeps the hydraulics warm and is much faster
		Carried baseline grants -20% spread and -5% attack speed
		'''
}

LaunchStockModule: {
	DisplayName: Launch Stock
	Tooltip:
		'''
		An overloaded spring mechanism fires three fan-spread homing beams the instant the orb launches
		Orb velocity increases while mana cost rises in tandem
		'''
}

SentinelGripModule: {
	DisplayName: Sentinel Grip
	Tooltip:
		'''
		A smart-sensor grip auto-fires a homing beam at the nearest enemy every 20 frames while the orb is airborne
		Orb speed is slightly reduced and mana cost rises, but the continuous side-fire compensates
		'''
}

ConductorGripModule: {
	DisplayName: Conductor Grip
	Tooltip:
		'''
		Superconducting material boosts chain-arc hops to longer range and more jumps
		Each hit is accompanied by an arc-particle burst; slight damage and mana cost increase
		'''
}

PhantomFrameModule: {
	DisplayName: Phantom Frame
	Tooltip:
		'''
		A quantum-phase cavity teleports the beam to 80px from the nearest enemy every 30 frames
		Bypasses obstacles entirely; slight beam range and damage boost at increased mana cost
		'''
}

RecursiveFrameModule: {
	DisplayName: Recursive Frame
	Tooltip:
		'''
		A topological-loop chassis respawns each beam from the player position in its original direction on death
		Main beam damage rises but range is shortened; the echo has reduced damage and does not recurse
		'''
}

ForkBarrelModule: {
	DisplayName: Fork Barrel
	Tooltip:
		'''
		An internal splitting prism forks each beam into two angled sub-beams every 50 frames
		Slight damage and mana cost penalty
		'''
}

NullBarrelModule: {
	DisplayName: Null Barrel
	Tooltip:
		'''
		A data-erasure chamber drops damage to near-zero but grants virtually unlimited pierce
		Hits inject a virulent toxin that corrodes the target over time
		'''
}

HelixBarrelModule: {
	DisplayName: Helix Barrel
	Tooltip:
		'''
		Dual-channel optics force two beams to spiral around a shared axis
		Spread is zeroed; slight damage and speed penalty; great synergy with high-pierce setups
		'''
}

TargetPainterOpticModule: {
	DisplayName: Target Painter
	Tooltip:
		'''
		A laser designation system marks struck targets with corrosive ichor, reducing their defense
		Also boosts homing strength and critical strike chance
		'''
}

StrobeOpticModule: {
	DisplayName: Strobe Optic
	Tooltip:
		'''
		A phase-shift modulator rapidly cycles the beam between wall-piercing and solid states
		Has a 30% chance to confuse struck enemies; minor pierce and speed bonus
		'''
}

SniperOpticModule: {
	DisplayName: Sniper Optic
	Tooltip:
		'''
		Holding fire with a steady crosshair builds lock-on; a sniper guide line fades in from the muzzle
		Once chambered, your next shot is elevated into a Skypierce Ray: massive damage, full-line pierce, instant hit
		Firing resets the lock; jerking your aim drains progress, though moving freely does not
		Improved beam speed and range, at the cost of slower fire rate and homing reduced to nothing
		'''
}

StormCellModule: {
	DisplayName: Storm Cell
	Tooltip:
		'''
		During charge, releases a homing electric bolt toward the nearest enemy every 25 frames
		Faster charge and larger blast radius, but higher mana cost
		'''
}

CryoCoreModule: {
	DisplayName: Cryo Core
	Tooltip:
		'''
		A supercooled energy cell freezes all enemies caught in the orb's blast radius
		Slightly larger explosion, slightly slower charge
		'''
}

DarkMatterCoreModule: {
	DisplayName: Dark Matter Core
	Tooltip:
		'''
		A dark-matter field pulls nearby enemies toward the orb during its flight phase
		The orb simultaneously tracks targets; explosion radius significantly increased
		High mana cost
		'''
}

ErgonomicStockModule: {
	DisplayName: Ergonomic Stock
	Tooltip:
		'''
		The stock remembers your hands: sustained fire on one target (or roughly the same direction) builds Muscle Memory
		Proficiency tiers unlock growing returns: tighter spread, then faster fire rate, then full-bar Gun-Body Unity
		At Unity, hits on the memorized target refund a little mana, beams gain extra aim correction, and rhythmic afterimages trail you and the gun
		Switching targets or holding fire quickly bleeds the memory away
		'''
}

ExtenderStockModule: {
	DisplayName: Extender Stock
	Tooltip:
		'''
		An extended rail grants beams greater range and flight speed
		Terminal Cleave: once a beam has flown far enough, its residual energy unfolds sideways in place into a light blade perpendicular to its path, sweeping a fan-shaped area for finishing damage
		Beams that die early from exhausted pierce convert into a smaller blade scaled by distance flown; point-blank deaths trigger nothing
		In laser mode, sustain the beam briefly, then release the attack key to deliver a crosscut at the cursor's point on the column
		'''
}

StormStockModule: {
	DisplayName: Storm Stock
	Tooltip:
		'''
		Sustained fire builds a swirling storm field around you that dissipates when you stop shooting
		Hostile projectiles inside the field are blown off course by the cyclone, curving around you
		When the storm gauge fills, a bolt of lightning strikes down from above onto enemies within the field
		'''
}

VampireGripModule: {
	DisplayName: Vampire Grip
	Tooltip:
		'''
		A bio-electric grip converts a portion of beam damage into health recovery
		Laser hits are more frequent but restore less per tick; effective for sustained fights
		'''
}

ChronalGripModule: {
	DisplayName: Chronal Grip
	Tooltip:
		'''
		A phase-delay coil slows enemies on each hit
		Combined with improved homing, dense fire can maintain persistent crowd control
		'''
}

CascadeGripModule: {
	DisplayName: Cascade Grip
	Tooltip:
		'''
		Every 5 hits, spawns a hovering cascade node at the point of impact
		The node lingers ~2 seconds and fires 5 homing beams that hunt nearby enemies
		Slightly reduces base damage
		'''
}

MirrorFrameModule: {
	DisplayName: Mirror Frame
	Tooltip:
		'''
		A symmetric reflection cavity spawns a 180-degree mirror beam for every beam fired
		Mirror beams deal reduced damage; dual-directional coverage dramatically increases hit density
		'''
}

NullspaceFrameModule: {
	DisplayName: Nullspace Frame
	Tooltip:
		'''
		A void-rift generator leaves a micro-explosion echo along the beam's path every 20 frames
		Slightly extended range; minimal damage penalty
		'''
}

OverkillFrameModule: {
	DisplayName: Overkill Frame
	Tooltip:
		'''
		An overkill-sensing circuit stacks one Overkill charge per kill, up to 15; each stack adds 2% damage
		Stacks decay over time — the faster you slay, the stronger you become
		'''
}

GraviticBarrelModule: {
	DisplayName: Gravitic Barrel
	Tooltip:
		'''
		An embedded micro-singularity tugs nearby enemies toward each beam in flight
		Spread and homing tighten while range extends; muzzle velocity drops slightly
		'''
}

PrismaticBarrelModule: {
	DisplayName: Prismatic Barrel
	Tooltip:
		'''
		Dispersion prisms shed RGB tracers from every beam, scattering color shards on hit
		Adds one extra beam and a crit edge at the cost of a little damage and spread
		'''
}

ConcussionBarrelModule: {
	DisplayName: Concussion Muzzle
	Tooltip:
		'''
		An overload buffer detonates a small concussion ring at the impact point every 5 stacked hits
		Per-shot damage and spread tighten, but attack speed pays the toll
		'''
}

ObsidianBarrelModule: {
	DisplayName: Obsidian Barrel
	Tooltip:
		'''
		Hits carve obsidian cracks into targets; at full stacks they shatter into hunting volcanic glass
		Orb detonations rupture nearby cracks early, rewarding sustained pressure on clustered enemies
		'''
}

LifebloomBarrelModule: {
	DisplayName: Lifebloom Barrel
	Tooltip:
		'''
		Beams seed parasitic lifebuds that drain delayed damage and return a little life to the wielder
		When a host dies, the bud transfers to a nearby enemy and keeps growing
		'''
}

MagmaVentBarrelModule: {
	DisplayName: Magma Vent Barrel
	Tooltip:
		'''
		Hits and expired beams leave short-lived magma vents that periodically erupt into vertical heat columns
		Underworld and high-heat liquid conditions make the vents cycle faster for area denial
		'''
}

CumulusBarrelModule: {
	DisplayName: Cumulus Barrel
	Tooltip:
		'''
		Beam paths condense chargeable cloud nodes that feed on nearby SHPC beams and charge orbs
		Once full, each cloud drops three short rain-lightning beams for positional firepower
		'''
}

MossboundBarrelModule: {
	DisplayName: Mossbound Barrel
	Tooltip:
		'''
		Beams sow wet moss patches that slow enemies and build toward a brief root snare
		Flying charge orbs absorb nearby moss to enlarge their final blast
		'''
}

FrostfernBarrelModule: {
	DisplayName: Frostfern Barrel
	Tooltip:
		'''
		The first strike draws an ice-vein behind the target, sharing frost with enemies caught along the line
		It links crowds through branching fern geometry instead of simply freezing one victim
		'''
}

SandstormBarrelModule: {
	DisplayName: Sandstorm Barrel
	Tooltip:
		'''
		Sustained fire rolls a moving sand curtain forward, abrading enemies and softening hostile projectiles
		Beams gain extra pierce while mana draw rises to keep the storm moving
		'''
}

CoralReefBarrelModule: {
	DisplayName: Coral Reef Barrel
	Tooltip:
		'''
		Impact points grow coral anchors that connect into damaging reef lines
		Orb detonations make nearby anchors release synchronized circular surges
		'''
}

HiveBarrelModule: {
	DisplayName: Hive Barrel
	Tooltip:
		'''
		Left-click hits tag foes with pheromones, then orb detonations launch cyber bees at marked targets
		Spread markers across the fight to make the swarm split and cover the field
		'''
}

MoondewBarrelModule: {
	DisplayName: Moondew Barrel
	Tooltip:
		'''
		Beam trails condense dew prisms that refract later beams into short derived shots
		Night and near-full moons raise each prism's refraction ceiling and payoff
		'''
}

CrosslinkOpticModule: {
	DisplayName: Crosslink Optic
	Tooltip:
		'''
		On hit, a neural-link unit arcs a data tether from the struck target to the nearest other foe
		Chain count and chain range both extend, with a slight bump to mana cost
		'''
}

ZoomOpticModule: {
	DisplayName: Zoom Optic
	Tooltip:
		'''
		A long-focus magnetic lens pushes beams faster and farther at the cost of homing and attack speed
		Hits beyond 600 px trigger a bonus white-hot strike that scales with distance
		'''
}

PingOpticModule: {
	DisplayName: Ping Optic
	Tooltip: The signal-painter system applies Marked for Death on hit and grants bonus crit chance
}

CapacitorPulseModule: {
	DisplayName: Capacitor Pulse
	Tooltip:
		'''
		Dense capacitor stacks vent a micro-pulse detonation roughly twice a second while charging
		Explosion radius and charge time both rise, mana cost climbs
		'''
}

EntropyCoreModule: {
	DisplayName: Entropy Core
	Tooltip:
		'''
		The orb siphons "entropy" from nearby enemies during flight
		On detonation it releases a secondary aftershock scaled by accumulated entropy
		'''
}

ResonanceReactorModule: {
	DisplayName: Resonance Reactor
	Tooltip:
		'''
		Emits a resonance ring every ~0.75 s while charging
		Detonation triggers an extra resonance shock at the player's feet, covering melee gaps
		'''
}

OverwatchStockModule: {
	DisplayName: Overwatch Stock
	Tooltip:
		'''
		Standing still ramps up "Overwatch" stacks (max 5) that decay rapidly once you move
		Each stack grants +2.5% damage and +2% crit; a stoic posture trims attack speed and spread
		'''
}

MomentumStockModule: {
	DisplayName: Momentum Stock
	Tooltip:
		'''
		Moving fast ramps up "Momentum" stacks (max 6) that decay rapidly once you stop
		Each stack grants +5% attack speed and +8% beam speed — a mirror to Overwatch
		'''
}

BulwarkStockModule: {
	DisplayName: Bulwark Stock
	Tooltip:
		'''
		Holding the SHPC grants modest damage reduction
		The reinforced posture slightly slows charge time and reduces mana cost
		'''
}

CombatGripModule: {
	DisplayName: Combat Grip
	Tooltip:
		'''
		Killing blows with beams or laser stack "Combat" charges (max 5)
		Each stack grants +4% attack speed and +2% damage; charges decay between fights
		'''
}

TempestGripModule: {
	DisplayName: Tempest Grip
	Tooltip:
		'''
		After every few stacked hits, fires a Tempest Burst — multiple data arcs around the latest impact
		Per-shot damage trims and mana cost climbs in exchange for rhythmic clearing
		'''
}

AbsorberGripModule: {
	DisplayName: Absorber Grip
	Tooltip:
		'''
		Beam and laser hits return a slice of the damage dealt as mana
		Per-shot damage drops slightly and base mana cost rises in exchange
		'''
}

HarmonicFrameModule: {
	DisplayName: Harmonic Frame
	Tooltip:
		'''
		Multiple coexisting beams arc resonance tethers between each other for bonus damage
		Adds one extra beam at the cost of per-shot damage and a touch of spread
		'''
}

ReplicatorFrameModule: {
	DisplayName: Replicator Frame
	Tooltip:
		'''
		On expiration, a beam spawns a brief echo in place that flies on along its original heading
		Primary damage rises while range shortens; mana cost climbs
		'''
}

ArchiveFrameModule: {
	DisplayName: Archive Frame
	Tooltip:
		'''
		Accumulates SHPC damage; each time the threshold is crossed, an Archive blast detonates at the player's feet
		Per-shot damage rises slightly with a small mana surcharge
		'''
}

CWRItem: {
	TemperatureText: Combustion Temperature
	InternalStoredEnergy: Stored Energy
	DeathModeItemText: Death Mode
	LegendItemUpgradeDisable:
		'''
		This legendary weapon cannot be upgraded in the current world.
		Re-enter the world to lift this restriction.
		'''
	ItemLegendOnMouseLang: Press 'Shift' to hear its story...

	CWRItem: {
		TemperatureText: Combustion Temperature
		InternalStoredEnergy: Stored Energy
		DeathModeItemText: Death Mode
		LegendItemUpgradeDisable:
			'''
			This legendary weapon cannot be upgraded in the current world.
			Re-enter the world to lift this restriction.
			'''
		ItemLegendOnMouseLang: Press 'Shift' to hear its story...
	}
}

RMagicConch: {
	DontUseMagicConch: You're being watched by a powerful creature...

	RMagicConch: {
		DontUseMagicConch: You're being watched by a powerful creature...
		DisplayName: Magic Conch
		Tooltip: Listen closely and you'll hear the ocean
	}
}

GraniteTome: {
	DisplayName: Granite Tome
	Tooltip:
		'''
		Chants to gather three charging motes, then looses a fan of three gently homing granite energy orbs
		Orbs shatter into seeking crystal shards on impact
		'''
}

GraniteFlower: {
	DisplayName: Granite Bloom
	Tooltip:
		'''
		Lobs a crystal seed that blooms into a lingering energy flower where it lands
		The bloom pulses three times, spraying crystal petals at the nearest enemy
		Withers by shattering all its petals, spraying crystal shards in every direction
		'''
}

GraniteThrowingKnife: {
	DisplayName: Granite Throwing Knife
	Tooltip:
		'''
		Throws a piercing knife trailing a razor-sharp azure arc
		Striking an enemy leaps a miniature chain of lightning to another nearby foe
		Shatters into crystal shards on its last hit or against terrain
		'''
}

GraniteWalkingBoots: {
	DisplayName: Granite Walking Boots
	Tooltip:
		'''
		Greatly increases running speed and acceleration
		The soles surge with electricity the instant you reach full speed
		At full speed, sparks crackle underfoot and azure afterimages trail behind you
		'''
}

MarbleClub: {
	DisplayName: Marble Club
	Tooltip:
		'''
		A slow, crushing overhead slam with immense knockback
		Hits always briefly petrify foes, leaving them stone-bound and sluggish
		Striking the ground unleashes a full-power marble shockwave and a surging dust wave
		Midair slams only release a weakened shock
		'''
}

MarbleHuntingKnife: {
	DisplayName: Marble Hunting Knife
	Tooltip:
		'''
		Swift alternating slashes
		Every third strike becomes a wider finisher, lunging forward and spraying marble shards
		'''
}

MarbleDisc: {
	DisplayName: Marble Discus
	Tooltip:
		'''
		Hurls a spinning discus that ricochets between foes and walls
		Each ricochet into a new target gilds the discus, raising its damage by 10%, up to 30%
		Once its bounces are spent it curves back to your hand; up to two may fly at once
		'''
}

MarblePebble: {
	DisplayName: Marble Pebble
	Tooltip:
		'''
		An endless swift sling stone that bounces once off the ground
		Deals far greater damage to foes with high maximum life
		Striking a colossal foe bursts into golden light and a rock-shattering crack
		'''
}

MarbleShield: {
	DisplayName: Marble Aegis
	Tooltip:
		'''
		Slightly increases melee knockback
		Three orbiting marble shards form a stone guard, absorbing one incoming hit and shattering when ready
		Press [KEY] to raise your guard: a perfect block negates the hit, crushing nearby projectiles and hurling stone blades back
		A perfect block grants 10% increased melee damage for 5 seconds
		'''
}

MarbleBalloon: {
	DisplayName: Marble Balloon
	Tooltip:
		'''
		Press Down while airborne to slam down; the longer the fall, the stronger and wider the landing shockwave
		Negates fall damage
		'''
}

MarbleinaBottle: {
	DisplayName: Marble in a Bottle
	Tooltip: Grants a heavy, forceful second jump; hold Jump to rise higher
}

MarbleCloudBalloon: {
	DisplayName: Marble Cloud Balloon
	Tooltip:
		'''
		Grants a heavy, forceful second jump; hold Jump to rise higher
		Press Down while airborne to slam down; the longer the fall, the stronger and wider the landing shockwave
		Negates fall damage
		'''
}

TestItem: {
	DisplayName: Test Item
	Tooltip: ""
}

OniMeiRubbingHigekiri: {
	DisplayName: Higekiri
	Tooltip: Wounded foes take far more, and a personal kill refunds stance; weapon damage -2%
	Origin: The night of the clan's test cut, this blade took the head and the beard beneath the chin in one stroke — the whiskers were found still clinging to the edge. The old name Higekiri, the Beard-Cutter, was earned that night
	Power:
		'''
		Beard-Cutter: once a foe drops below 35% life, hits from the blade itself start scaling with the wound
		The thinner its life, the bigger the bonus: up to +60% on regular foes, up to +45% on bosses
		Finishing it yourself also refunds 8 stance, once per action
		'''
	Burden: Weapon damage -2%. While a foe is still healthy, this edge is duller than the original name
}

OniKeikoRune: {
	DisplayName: Keiko Rune
	Tooltip:
		'''
		Use it to open the Onikiri lesson from the beginning, or use it again mid-lesson to put the lesson away
		Left with you when the opening lesson is declined; the rune is not consumed and may be used again
		'''
	NeedBlade: Onikiri is not in your bag, so the rune has no lesson to open
	Closed: The lesson is put away; use the rune again to reopen
	NotNow: Something else holds the stage right now
}

OniMeiRubbingOnikiri: {
	DisplayName: Onikiri
	Tooltip: The original inscription. Nothing granted, nothing charged
	Origin: Watanabe no Tsuna carried it at the bridge of Ichijo-Modoribashi and cut an oni's arm clean off; the demon fled and never dared return for it. A blade that had cut an oni was named Onikiri for the feat, and the name has stayed nailed to the tang ever since
	Power: The original inscription. Everything this blade already has stays exactly as it is
	Burden: None
}

OniMeiRubbingShishinoko: {
	DisplayName: Shishi-no-ko
	Tooltip: Land all five beats and the fifth adds two crossing waves; beat interval +2%
	Origin: One night, left by its master's pillow, the blade roared on its own — a lion's cry, heard through the whole house. The master renamed it Shishi-no-ko, the Lion's Cub, and set the name in gold inlay to give that one roar its due
	Power:
		'''
		Lion's Roar: run all five combo beats through without a dash or a big art cutting in, and the fifth beat closes like a lion's jaws
		Two waves cross out of it, each for 22% of a blade hit
		'''
	Burden: Combo beat interval +2%. A roar has to be drawn in first, so the blade runs a touch slower
}

OniMeiRubbingTomokiri: {
	DisplayName: Tomokiri
	Tooltip: Dash-cancelling a combo leaves a Guilt slash behind; damage taken +6% while held
	Origin: Two treasured blades of the clan were tested edge against edge, and this one cut its companion clean in two. The fault was chiseled in as its name — Tomokiri, the Friend-Cutter — and its temper has run violent ever since
	Power:
		'''
		Guilt-Echo: when a Kamui flash step cuts your combo short, the interrupted swing stays behind
		It bites down on its own a moment later for 35% of a blade hit
		'''
	Burden:
		'''
		While you hold this blade, damage you take is +6%
		Every echo adds one layer of Guilt, up to three, and each layer makes your next dash cost 4 more vigor
		Land the Zanshin strike after a dash and the whole debt is paid off at once
		'''
}

OniMeiRubbingKazehi: {
	DisplayName: Kaze-hi
	Tooltip: Dashes cost 15% less vigor and Sakura Flight 20% less; ink brand damage -20%
	Origin: The edge-setter cut this groove long and straight, calling it a lane left open for the wind. Swing, and the wind arrives first — by the time you hear it, the blade is already back
	Power: Wind-Rider: Kamui flash step vigor cost -15%, Sakura Flight drain -20%
	Burden: Ink brands left by dashes deal -20% damage. This groove was cut for lightness, not for slaughter
}

OniMeiRubbingChihi: {
	DisplayName: Chi-hi
	Tooltip: Landing hits gives vigor back; natural regen -35%
	Origin: Other grooves are opened to lighten the blade; not this one. The edge-setter was blunt when he handed the sword over: this channel is for blood — the faster it runs, the faster your breath comes back
	Power:
		'''
		Bloodletting: the first hit of each combo beat returns 1 extra vigor
		Every Zanshin strike after a dash returns 4 extra
		'''
	Burden: Natural regen -35%, and you wait 0.3s longer before it starts back up after spending. No blood on the edge, little breath returned
}

OniMeiRubbingFudo: {
	DisplayName: Fudo
	Tooltip: Take a hit mid-art and spend stance to soften it; stance gain -15%
	Origin: The carver followed the brushwork of the seed syllable Kan and brought the Immovable One, flames at his back, onto the side of the blade. This deity's whole office is steadiness: whatever comes, he sits unmoved
	Power:
		'''
		Immovable: get hit during a Zanshin strike, Annihilating Flash, or Finale Slash, the arts you cannot pull out of, and the Immovable One takes it for you
		It spends 20 stance, leaves that hit at 65% damage and 25% knockback, then rests 2.5s
		'''
	Burden: Everyday stance gain -15%, since the guarding strength is skimmed off your build-up. Dismemberment backlash is never shielded
}

OniMeiRubbingKurikara: {
	DisplayName: Kurikara
	Tooltip: An execution banks three dragonfire layers, one spent per full combo; vigor cap -10%
	Origin: Carved on the blade is Kurikara the dragon king: a black dragon coiled around a sword, jaws open to swallow the point. It is an old subject of blade carving, with gold still set in the seams of the scales
	Power:
		'''
		Dragon-Coil: after an execution the blade lights three layers of dragonfire, good for ten seconds
		Every time you finish a full five-beat combo, the fifth beat burns one layer into a coiling slash for 50% of a blade hit
		'''
	Burden: Vigor cap -10%. Where the dragon coils, the breath runs narrow
}

OniMeiRubbingTessetsu: {
	DisplayName: Tessetsu
	Tooltip: First hit of each beat deals +25% to steel and machines; weapon damage -10%
	Origin: Someone inspected the blade and sneered: big name, edge like a length of raw iron. The smith took no offense and chiseled the heckle into the tang as it was — raw iron, then; iron against iron shows the true work
	Power: Iron-Cut: the first hit of each combo beat deals +25% damage to steel and machine foes, the ones that throw sparks when you cut them
	Burden: Weapon damage -10%. On flesh it really does feel like a length of dull iron
}

OniMeiRubbingKyushu: {
	DisplayName: Kyushu
	Tooltip: Heads only, and wounded heads harder than Higekiri manages; weapon damage -3%
	Origin: Some blades take a new name for every fine head they cut, and enjoy the parade each time. This inscription's bearer wanted none of it: heads fall as before, the name stays as before — a blade that cuts clean needs no new name to frighten anyone
	Power:
		'''
		Head-Hunt: the bonus only counts heads, or foes that have no separate segments to begin with
		Once it drops below 35% life your hits start scaling with the wound, and the thinner its life the bigger the bonus
		Up to +85% on regular foes, up to +60% on bosses
		'''
	Burden: Weapon damage -3%. Bodies, tails, and other segments do not count as a head
}

OniMeiRubbingIkiai: {
	DisplayName: Ikiai
	Tooltip: A full combo's fifth beat throws a sword arc along your aim; beat interval +4%
	Origin: Old swordsmen say that in a long standoff the two sides' breathing locks together, and whoever closes that breath first lands first. This inscription records the craft: hold it in, match the beat, drop the blade
	Power: Breath-Wave: finish a full five-beat combo and the fifth beat throws a curved sword arc along your aim for 55% of a blade hit, cutting up to three foes before it breaks up
	Burden: Combo beat interval +4%
}

OniMeiRubbingKyoko: {
	DisplayName: Kyoko
	Tooltip: Back off to bank a cut, then close in and it lands harder; hammering up close blurs your focus
	Origin: A blade tester roared into an empty valley and no echo came back — with no one around, the whole breath pressed itself back into the blade. This carving records that pent-up cry
	Power:
		'''
		Hollow-Roar: keep 16 tiles clear of enemies for 1.5s and the blade banks a cut for you
		Your next hit within 16 tiles deals +25%; hits landed further out do not spend it, so the banked cut keeps
		When the blade idles it rings on its own: 1.5s without landing a hit, or with nothing near you, it slows foes within 20 tiles for 0.4s every 1.5s
		'''
	Burden: Four close-range hits inside 0.6s blur your focus for 0.4s, and close-range damage drops 5% for that window
}

OniMeiRubbingKarikiri: {
	DisplayName: Karikiri
	Tooltip: A dash leaves a decoy that eats one hit for you; 4s before you get another
	Origin: A student copied his master's stance ten parts in ten, and the master gave one verdict: too alike — alike enough to read false at a glance. This inscription records that false body: however well it stands, it is only a shadow that takes the blade in your stead
	Power:
		'''
		False Body: starting a Kamui flash step leaves a frozen-pose decoy standing for 1.5s
		Anything that comes at you in that window, foe or projectile, is taken by the decoy instead
		Once it has spent itself, you wait 4s before you can leave another
		'''
	Burden:
		'''
		While the decoy stands, damage taken and dash cost are both +12%
		For 1s after it shatters, damage taken is +18%
		A decoy that simply runs out of time does not count as shattered
		'''
}

OniMeiRubbingMokukiri: {
	DisplayName: Mokukiri
	Tooltip: Finish a paid normal dash and the next cut deals +35%; a whiff spends it too
	Origin: The instant a flash step runs its course, everything around falls quiet. Old swordsmen know the next cut out of that silence is the heaviest. The name says it plainly: the silent cut
	Power: Silent-Kill: for 0.75s after a paid normal flash step runs its course, your next combo swing or Zanshin strike deals +35%
	Burden: A whiff spends it just the same, and dashing again clears it. Free execution dashes never bank it
}

OniMeiRubbingKumokiri: {
	DisplayName: Kumo-kiri
	Tooltip: Three cuts pin a web; closing it cuts everything inside; regen -25% while anchors stand
	Origin: Minamoto no Raiko lay sick in bed when a tsuchigumo, disguised as a priest, came to bind him in silk. He snatched up the blade, cut the threads and wounded the beast, and the next day followed the blood trail and destroyed its nest. The blade has been called Kumo-kiri, the Spider-Cutter, ever since
	Power:
		'''
		Ink-Silk: when the blade itself lands a hit, it pins a silk anchor at the cut point for 4s
		Spread them out: the same foe gives no second anchor within 0.4s, and two anchors need roughly six tiles between them
		The third anchor strings an ink-silk triangle that sags, then snaps toward its centre, cutting every foe it sweeps for 90% of a blade hit and binding them 1s
		After it closes, 1.5s pass before you can weave again
		'''
	Burden: While any anchor still stands, natural regen -25%. An anchor left to expire wastes the cut that set it
	DeedHint: Slay thirty arachnids — spiders, blood crawlers, sand scorpions, any eight-legged wall-crawler counts. Cut down enough and the blade learns that stench by itself
}

OniMeiRubbingOnimaru: {
	DisplayName: Oni-maru
	Tooltip: Stand still and the blade flies off to cut on its own; you have no blade while it is out
	Origin: Onimaru Kunitsuna, of the Five Great Swords. Its master was tormented night after night by a small oni in his dreams, until one night the blade toppled from its stand on its own and severed the oni head carved on the brazier's leg — the nightmares ended on the spot. The man does not move; the blade moves by itself
	Power:
		'''
		Self-Cut: stand nearly still for 1s and the blade goes on standby
		From then on it spends 10 of your vigor every 1.5s to fly at a foe within 40 tiles, cut for 140% of a blade hit, and return to the sheath
		'''
	Burden: The blade is out of your hands for the whole flight, so no combo, no flash step, no Sakura Flight. With nothing nearby it will not launch
	DeedHint: Hold the blade and stand dead still for ten seconds, without stepping away even when a hit lands — hold your ground, and the blade moves for you that once
}

OniMeiRubbingRaikiri: {
	DisplayName: Rai-kiri
	Tooltip: The fifth beat and the big arts call lightning under open sky; beat interval +6%, nothing indoors
	Origin: Tachibana Dosetsu was sheltering under a tree when a bolt of lightning came down on his head; he drew and cut back at it, and lived. The blade has been called Raikiri, the Thunder-Cutter, ever since
	Power:
		'''
		Thunder-Call: when the fifth beat, a Zanshin strike, Annihilating Flash, or Finale Slash lands and there is open sky overhead, a bolt drops from the top of the world
		The bolt deals 70% of a blade hit, and in a thunderstorm one strike can call up to three
		'''
	Burden: Combo beat interval +6%, sunny days included, because the wind-up is paid either way. Blocked overhead or underground, no bolt falls
	DeedHint: Slay a boss-tier foe in a storm under open sky, and the edge learns the bolt
}

OniMeiRubbingNuekiri: {
	DisplayName: Nue-kiri
	Tooltip: Finish a combo airborne and the fifth beat becomes a ground slam; no dashing for 0.7s after landing
	Origin: A nue coiled over the palace roof at night, and Minamoto no Yorimasa's arrow brought it down out of the clouds. The finishing cut, dealt the instant it hit the ground, drove straight down along the fall — and that plunge is what this inscription remembers
	Power:
		'''
		Nue-Dive: finish a full combo at least three tiles off the ground and the fifth beat stops swinging sideways, diving at the floor instead
		The landing opens a shock ring about 12 tiles across for 120% of a blade hit, and drags nearby foes toward the impact
		'''
	Burden: No flash steps for about 0.7s after you land. Fought close to the ground, the fifth beat stays an ordinary fifth beat
	DeedHint: At night, rise thirty tiles above the ground and slay a flying foe, and the blade learns that plunge
}

OniMeiRubbingKamihi: {
	DisplayName: Kami-hi
	Tooltip: Dashing through a foe drops a paper cutout; cutting the paper hits the foe; dashes cost more while paper stands
	Origin: A master paper-mounter's cut leaves paper as paper and shadow as shadow. This groove studied that hand: passing through a foe, it trims their silhouette off and leaves it standing where it was — while the paper stands, the account can be settled against it
	Power:
		'''
		Paper-Effigy: dashing through a foe leaves a paper cutout of it where you land, good for 7s, two on the field at most
		Cutting that paper deals 80% of a blade hit straight to the foe itself
		It also opens a wound on the foe for 1.5s, and your hits land 12% harder while that wound is open
		'''
	Burden: Dash vigor cost +12% while any effigy stands
	DeedHint: Sever twenty omokage paper silhouettes in the Ura world, and the hand learns how paper is cut
}

OniMeiRubbingSorahi: {
	DisplayName: Sora-hi
	Tooltip: One extra dash off the ground and double regen; the first 0.75s after landing gives nothing back
	Origin: The master who opened this groove kept an odd theory: breath is like people — the moment its feet touch the ground, it turns lazy. So he cut the blade featherlight, to keep you in the air a little longer; while you float, the breath comes looking for you
	Power:
		'''
		Air-Groove: natural regen doubles while both feet are off the ground, and you get one extra dash
		An air dash that runs out leaves you hovering at its endpoint for half a second
		'''
	Burden: Natural regen drops to zero for 0.75s after you land, and dashing on the ground costs 10% more vigor
	DeedHint: Stay off the ground for fifteen straight seconds and land at least five blade hits meanwhile, and the groove learns to float
}

OniMeiRubbingKagamihi: {
	DisplayName: Kagami-hi
	Tooltip: A dash endpoint stands a paper mirror that copies your next cut; weapon damage -5%
	Origin: Mirror polishers all know it: the figure in the glass looks synchronized, but always runs half a beat behind. The one who opened this groove wanted exactly that half beat — let the one in the mirror deal your follow-up cut. Late, but it arrives
	Power:
		'''
		Mirror-Echo: the endpoint of a Kamui flash step stands a paper mirror for 2s
		The next time you cut, the figure in the mirror repeats that same cut for 45% of a blade hit, then shatters
		'''
	Burden: Weapon damage -5%. The copy swings from wherever the mirror stands, so whether it connects is on you
	DeedHint: Finish a mimic with the Zanshin strike — Calamity's counterfeit counts among the imitators too
}

OniMeiRubbingAmahi: {
	DisplayName: Ama-hi
	Tooltip: Sakura Flight drips ink that pools and binds where it lands; Sakura drain +15%
	Origin: The gutter under the eaves is also called an amahi, a rain channel. The edge-setter cut this groove with the eaves in mind: rain you catch should not run off for nothing — fly on, and let it drip onto whoever waits under the blade
	Power:
		'''
		Ink-Rain: while cruising in Sakura Flight, a bead of ink drops every 0.1s for 12% of a blade hit
		Beads spread into puddles where they land, and foes that step in are bound for half a second
		'''
	Burden: Sakura Flight drain +15%. Carrying rain the whole way costs
	DeedHint: Fly Sakura Flight through the rain for ten straight seconds; petals must soak through before water will stay
}

OniMeiRubbingTsuzurihi: {
	DisplayName: Tsuzuri-hi
	Tooltip: Ink brands from one dash cut lines between each other; a lone brand deals -30%
	Origin: Tsuzuri is the bookbinder's stitch: one needle, one hole, and when the thread pulls tight the loose pages become a book. The one who opened this groove uses ink brands for stitch holes: string the marks together, and they close into a line
	Power: Mark-Stitch: ink brands from the same dash all go off together and cut lines between one another, each line for 35% of a blade hit
	Burden: A lone ink brand deals -30%. Catch only one foe per dash and this groove is a pure loss
	DeedHint: Pierce six different foes in one dash, and the marks stitch
}

OniMeiRubbingBonsho: {
	DisplayName: Bonsho
	Tooltip: Hold full stance without a Finale and the blade tolls itself; half your stance buys a ring of control
	Origin: A temple bell waits for someone to strike it; the one carved on this blade does not. The carver put it plainly: build your stance full and sit on it, and the bell will let it go for you
	Power:
		'''
		Bell-Toll: hold full stance for 3s without releasing Finale Slash and the blade tolls on its own
		Foes within 30 tiles each take 60% of a blade hit and are bound 1.5s, and your stance drops to 50
		'''
	Burden: Once the bell rings, that Finale is gone. Full stance forces you to pick one
	DeedHint: Bring a boss down without using Annihilating Flash or Finale Slash the whole fight — knock the bell down just like that
}

OniMeiRubbingHannya: {
	DisplayName: Hannya
	Tooltip: Drop low and the mask turns demon: heavier hits and lifesteal; frail while it is out, duller before it turns
	Origin: The hannya mask of Noh plays the instant a woman's grudge turns her face into a demon's. The carver set that mask into the steel: push a person to the very edge, and the face turns over on its own
	Power:
		'''
		Mask-Shift: below 35% of your own life the mask turns demon, blade damage +20%, and every hit restores 0.5% of your max life
		While the demon face is out, every third hit brings up a mask that bites for 50% of a blade hit
		'''
	Burden: Damage taken +15% while the demon face is out. In maiden form, weapon damage -4%
	DeedHint: Slay a boss while your own life sits below one tenth, and the mask can turn
}

OniMeiRubbingKaresansui: {
	DisplayName: Karesansui
	Tooltip: Plant your feet to rake a sand garden that stays put, cutting and feeding stance
	Origin: A garden master raises mountains and seas with nothing but sand and stone — not one drop of water. The carver cut that raked pattern into the blade, saying that a swordsman who stands firm enough can rake a sand garden underfoot with his blade's edge
	Power:
		'''
		Sand-Garden: stand nearly still for 1.5s and a sand field about 20 tiles across is raked at your feet, lasting 5s
		The field cuts every half second for 18% of a blade hit
		While you stand inside your own field, stance gain +30%
		'''
	Burden: You have to plant first, and moving clears what you have built up
	DeedHint: Hold one spot for thirty seconds of combat without taking a hit, and the sand can be raked
}

OniMeiRubbingSenju: {
	DisplayName: Senju
	Tooltip: Six ghost arms join the Finale Slash freeze; afterwards vigor zeroes and dashing is locked 3s
	Origin: The Thousand-Armed Kannon offers one hand to each soul it ferries. The carver cut the thousand hands into the blade and set its rule: every one the Finale sends off must have a hand there to receive them
	Power: Thousand-Arms: during the Finale Slash freeze, six sword-bearing ghost arms rise behind you and cut with it, each for 30% of a blade hit
	Burden: After the Finale your vigor drops to zero and you cannot flash step for 3s
	DeedHint: Send off eight different bosses with the Finale Slash, one hand for each name
}

OniMeiRubbingKogehi: {
	DisplayName: Koge-hi
	Tooltip: Dashes leave up to five burns along the whole path; weapon damage -4%
	Origin: The master who opened this groove lived by the lava shallows and had seen too many people who never watch their feet. This groove, he said, is cut for stepping clear of the heat: you run through, and the burn stays on the ground behind you — for whoever gives chase
	Power:
		'''
		Scorch-Trail: a Kamui flash step leaves up to five burns spread along its full path, each burning 1.5s
		A foe standing in one is scorched every half second for 14% of a blade hit
		A new burn dropped within two tiles of an old one just refreshes it
		'''
	Burden: Weapon damage -4%; make the difference back with the burns your footwork lays down
}

OniMeiRubbingKanhi: {
	DisplayName: Kan-hi
	Tooltip: Let the blade go cold and natural regen runs 2.25x; dash and Sakura costs +8%
	Origin: A long bench sits by the sword shop's door, and the master rests there listening to the street once the work is done. People must learn to rest, he says: quiet the ears, and the breath returns quicker. This groove is that bench
	Power: Quiet-Breath: after two seconds without cutting anything, natural regen runs at 2.25x
	Burden: Dash and Sakura Flight costs +8%. Breath earned in the quiet is repaid in motion
}

OniMeiRubbingTodohi: {
	DisplayName: Todo-hi
	Tooltip: Hits glue foes down for 0.6s; dashes take 0.1s longer to come back
	Origin: This groove came out of a strange quench: the edge drags sticky through flesh, and whatever takes the cut stalls a step. The edge-setter never called it a flaw — it is the other one that sticks, not you
	Power: Ink-Bound: a hit from the blade itself glues the foe down for 0.6s, dropping regular movement to 88% and boss movement to 96%
	Burden: Dashes take 0.1s longer to come back around. Ink-Bound and Numbed do not stack on the same foe, only the stronger one applies
}

OniMeiRubbingShiorihi: {
	DisplayName: Shiori-hi
	Tooltip: Finish one foe and the edge prunes the most wounded one nearby; natural regen -10%
	Origin: A gardener prunes by one rule: once the shears are out, take the wilted stems in the same pass and spare yourself a second trip. The one who opened this groove used to be a gardener
	Power:
		'''
		Petal-Prune: when your blade finishes a foe, it looks 15 tiles out from where that foe fell
		It picks another foe under half life, chases it down, and prunes for 25% of a blade hit
		Finding nobody starts no cooldown; a successful prune rests 0.75s
		'''
	Burden: Natural regen -10%. A Zanshin strike that hits nothing costs 2 extra vigor. Kills made by the pruning blade never set off another
}

OniMeiRubbingShiohi: {
	DisplayName: Shio-hi
	Tooltip: Swing on the tide for vigor and a heavier Zanshin; off-beat combos come out dull
	Origin: The edge-setter grew up by the sea and whets blades to the rhythm of the tide. The tide rises and falls, he says, and so does a man's breath: a cut made on the rising tide, the sea repays
	Power:
		'''
		Tide-Beat: a tide head runs under the vigor stroke on a 0.8s cycle, and the 0.2s at its crest is the on-tide window
		Combos started on the tide return 3 vigor on their first hit, and an on-tide Zanshin strike deals +8%
		'''
	Burden: Off-tide combos deal -3%. The tide is read the moment you press, so catching it on the hit does not count
}

OniMeiRubbingShibori: {
	DisplayName: Shibori
	Tooltip: Dashing through a foe or eating a hit mid-art numbs whatever touched you; stance gain -15%
	Origin: A numbed hand must not let go of the grip — that is the first year of sword school. The master who cut this carving turned the lesson around: numb me by one measure, and whatever touched me goes numb by ten
	Power:
		'''
		Numb-Counter: dashing through a foe numbs it outright
		Take contact damage during an art you cannot pull out of and you may spend 15 stance to leave that hit at 85% and numb whatever landed it, then rest 1.5s
		A numbed foe moves slower for 0.75s, down to 90% for regular foes and 98% for bosses, and its contact damage drops 10%
		'''
	Burden: Everyday stance gain -15%
}

OniMeiRubbingChinmei: {
	DisplayName: Chinmei
	Tooltip: Hostile projectile damage -12% and knockback -65%; stance gain -15%
	Origin: Arrows and stones fill a battlefield, and one ringing of the ears is enough to panic a man. The old soldier who cut this inscription left a single line: steady yourself first, stand firm, then move — what flies at you will hurt less
	Power: Quell: hostile projectiles that hit you deal -12% damage, and their knockback is left at 35%
	Burden: Stance gain -15%. In a pure melee scrap this carving mostly sits idle
}

OniMeiRubbingAshidome: {
	DisplayName: Ashidome
	Tooltip: Plant for 0.75s and your next big art or fifth beat deals +25%
	Origin: Every fencing master opens the first lesson the same way: stop swaying on your feet. Planted feet hold strength, and held strength gives the strike its weight. This inscription keeps that first lesson for you
	Power: Planted-Step: stand nearly still for 0.75s to bank a cut, and your next fifth beat, Zanshin strike, Annihilating Flash, or Finale Slash deals +25%
	Burden: The bank is spent the moment the art starts, whiff included. Moving clears it
}

OniMeiRubbingYoen: {
	DisplayName: Yoen
	Tooltip: Executions leave one patch of embers on the ground, never more than one; vigor cap -5%
	Origin: After a forge is banked for the night, the warmth in the chamber keeps till morning. The edge-setter borrowed that rule for the blade: the fire is out, the heat is not
	Power:
		'''
		Ember-Field: an execution leaves a field of embers at the focus, burning 3s
		The same foe is scorched every 0.75s for 16% of a blade hit
		There is only ever one field; another execution moves it somewhere new
		'''
	Burden: Vigor cap -5%. While the embers are still burning, dashes cost 10% more vigor
}

ScrapBeacon: {
	DisplayName: Scrap Beacon
	Tooltip:
		'''
		Summons the Scrap Commander at night
		"Scrap always answers to its foreman"
		'''
}

GaolCellKey: {
	DisplayName: Deep Gaol Cell Key
	Tooltip:
		'''
		Builds the Deep Gaol cell on the spot and seats the dormant skull (test item)
		"One turn of the key, and the walls remember their shape"
		'''
}

RustedGaolIrons: {
	DisplayName: Rusted Gaol Irons
	Tooltip:
		'''
		Summons the Deep Gaol Wraith (test item)
		"The cell number inside the cuff has been worn smooth"
		'''
}

UndrownedShackleCharm: {
	DisplayName: Sunken Shackle Band
	Tooltip:
		'''
		Water no longer slows you down; grants the ability to swim
		Greatly extends underwater breathing time
		"The anchor sank. The man kept breathing"
		'''
}

GaolAnchorWeapon: {
	DisplayName: Gaol Anchor
	Tooltip:
		'''
		Hurls a great anchor; while pinned into a wall, its chain becomes a damaging line
		"Execution tools do not retire"
		'''
}

SumpPearl: {
	DisplayName: Sump Pearl
	Tooltip:
		'''
		A matte pearl curdled from gaol water in a convict's bones
		The undead market accepts these
		'''
}

FloodGalleryKey: {
	DisplayName: Flood Gallery Key
	Tooltip:
		'''
		Builds the flood gallery on the spot and seats the anchored convict (test item)
		"The depth scale on the wall is his heartbeat chart"
		'''
}

ProofSealCharm: {
	DisplayName: Proofing Seal
	Tooltip:
		'''
		Trap projectiles deal 25% less damage and have a 15% chance to misfire
		"Stamped goods pass every mechanism unharassed"
		'''
	Misfire: Misfire
}

OverseerLogger: {
	DisplayName: Overseer's Logbook
	Tooltip:
		'''
		Grants danger sense; nearby traps and mechanisms are laid bare
		"It keeps the duty roster of every dart port"
		'''
}

ProofingHallKey: {
	DisplayName: Proofing Hall Key
	Tooltip:
		'''
		Builds the proofing hall on the spot and hangs the dust-caked rig (test item)
		"The inspection bell still rings"
		'''
}

WheezingWyrm: {
	DisplayName: Wheezing Wyrm
	Tooltip:
		'''
		Hold to breathe a stream of dragonfire
		The old head has seen better days, and needs a few smoky coughs before it catches
		Sustained breathing stokes the throat ever hotter, from dull red all the way to searing blue
		Brighter flame burns hotter; blue flame deals the highest damage and ignites hellfire
		"Not quite dead, just an old smoker clearing its throat"
		'''
}

Abyssrend: {
	DisplayName: Abyssrend
	Tooltip:
		'''
		Left-click alternates tip thrusts and side cuts; each strike tears off a homing ocean undercurrent
		Right-click clamps a foe in the pincer, crushing them until a high-pressure cavitation burst
		"It remembers the sound the deep makes when it breaks things"
		'''
}

SneezingWyrm: {
	DisplayName: Sneezing Wyrm
	Tooltip:
		'''
		Rapidly fires searing wyrmstrike rounds
		Sustained fire stokes the barrel hotter, pushing the tracers from orange toward blue-white
		Smoke tickles the old snout into intermittent sneezes that vent thick fumes to the side
		The fumes smolder in the air, slowly igniting into blooms of dragonfire
		"Don't stand on its sneezing side"
		'''
}

Everdeep: {
	DisplayName: Everdeep
	Tooltip:
		'''
		Fires a ring of pressurized abyssal water
		The ring pierces through foes, coasts a short way, then curls back to strike again
		Hits build abyssal resonance, counted by the droplets orbiting the tome
		At full resonance, a giant maelstrom erupts over the victim
		"The deep does not part for you; it closes behind you"
		'''
}
