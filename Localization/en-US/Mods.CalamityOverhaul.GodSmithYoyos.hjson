# GodSmith mode - Yoyos family descriptions
# Keys are composed by the framework: Mods.CalamityOverhaul.GodSmithYoyos.{SchemeClassName}.Desc
# Every yoyo shares the same right-click orbit command, so all entries carry the same text

GsWoodYoyo.Desc:
	'''
	Right click while the yoyo is out to make it circle around your cursor
	Right click again or let go to return to normal
	'''
