QuickHack: {
	SynapseBurn: {
		DisplayName: Surcharge synaptique
		Description: "Surcharge les synapses neuronales de la cible, infligeant des dégâts thermiques continus."
	}
	ShortCircuit: {
		DisplayName: Court-circuit
		Description: Libère une impulsion électromagnétique infligeant des dégâts instantanés et une brève paralysie.
	}
	Cyberpsychosis: {
		DisplayName: Cyberpsychose
		Description: Plonge la cible dans une frénésie et la pousse à attaquer toutes les unités alentour.
	}
	SystemReset: {
		DisplayName: Réinitialisation système
		Description: "Force un redémarrage du système de la cible, la paralysant complètement."
	}
	OpticOverload: {
		DisplayName: Surcharge optique
		Description: "Aveugle la cible, l'empêchant de percevoir son environnement."
	}
	MemoryWipe: {
		DisplayName: Effacement de mémoire
		Description: Efface les données d'hostilité de la cible et réinitialise sa liste d'agressivité.
	}
	Contagion: {
		DisplayName: Propagation
		Description: Implante un programme malveillant autoréplicatif qui se propage aux cibles voisines.
	}
	TileDetonate: {
		DisplayName: Détonation de bloc
		Description: Compromet l'intégrité structurelle et déclenche une explosion localisée.
	}
	TilePhase: {
		DisplayName: Protocole de virtualisation
		Description: "Altère les propriétés physiques d'un bloc, le rendant intangible pendant un certain temps."
	}
	TileMagPull: {
		DisplayName: Attraction magnétique
		Description: Génère un champ magnétique qui attire les objets au sol à proximité vers vous.
	}
	MachineShortCircuit: {
		DisplayName: Court-circuit mécanique
		Description: Vide l'énergie électrique de la machine ciblée et libère des arcs électriques blessant les entités voisines.
	}
	TurretHijack: {
		DisplayName: Piratage de tourelle
		Description: "Altère le module d'identification ami-ennemi, inversant temporairement l'allégeance de la tourelle."
	}
	FalseMemory: {
		DisplayName: Fausse mémoire
		Description: "Implante de faux souvenirs, interrompant brièvement la poursuite ou supprimant son schéma meurtrier."
	}
	SelfDismember: {
		DisplayName: Auto-démembrement
		Description: Force l'entité paranormale à se démembrer elle-même.
	}
	SystemHalt: {
		DisplayName: Blocage système
		Description: Plonge la cible dans un silence temporaire et l'immobilise complètement.
	}
	TurretCircuitOverload: {
		DisplayName: Surcharge de circuit
		Description: "Injecte un courant inverse dans le circuit d'alimentation de la tourelle, la rendant totalement inopérante longtemps."
	}
	TurretShortCircuit: {
		DisplayName: Court-circuit de tourelle
		Description: Décharge instantanément l'énergie de la tourelle pour un bref arrêt ; elle reprend le service dès la récupération.
	}
	VirusBroadcast: {
		DisplayName: Diffusion virale
		Description: "Injecte un ver dans la tour de signalisation, provoquant des ondes EMP cybernétiques qui court-circuitent toutes les tourelles à portée longtemps."
	}
	MeltdownProtocol: {
		DisplayName: Protocole de fusion
		Description: "Verrouille le circuit de refroidissement de la cible ; elle surchauffe et explose quatre secondes plus tard, touchant les ennemis proches."
	}
	ProjectileHijack: {
		DisplayName: Prise de contrôle balistique
		Description: Réassigne un projectile adverse et le renvoie d'où il vient.
	}
	ProjectileFreeze: {
		DisplayName: Gel balistique
		Description: Cloue un projectile en l'air ; il reprend sa course cinq secondes plus tard.
	}
	DataPurge: {
		DisplayName: Purge de données
		Description: Efface un projectile adverse et tous les projectiles du même type à proximité.
	}
	BallisticOverclock: {
		DisplayName: Surcadençage balistique
		Description: "Augmente les dégâts, le perçage et le temps de vol d'un de vos projectiles."
	}
	Electrolysis: {
		DisplayName: Électrolyse
		Description: "Électrifie cette nappe de liquide : les ennemis qui s'y trempent subissent des dégâts continus."
	}
	Cryostasis: {
		DisplayName: Cryostase
		Description: Gèle une zone de liquide en une fine glace praticable ; elle fond au bout de huit secondes.
	}
	LiquidPurge: {
		DisplayName: Vidange
		Description: Assèche le liquide alentour. La lave aussi.
	}
	ItemRecall: {
		DisplayName: Rappel à distance
		Description: Tire un objet au sol jusqu'à vos pieds.
	}
	Reappraise: {
		DisplayName: Réévaluation
		Description: Relance le préfixe de cet équipement au sol.
	}
	ArmorParse: {
		DisplayName: Analyse d'armure
		Description: Ramène la défense de la cible à zéro pendant six secondes.
	}
	Exorcise: {
		DisplayName: Déconnexion forcée
		Description: "Pose une marque de déconnexion : au cinquième coup reçu, la cible encaisse une blessure grave."
	}
	DataLeech: {
		DisplayName: Siphon de données
		Description: "Tant que c'est actif, frapper cette cible vous rend de la RAM, dans une limite totale."
	}
	SwarmLink: {
		DisplayName: Lien d'essaim
		Description: "Quand vous touchez la cible, jusqu'à cinq ennemis proches subissent 30% des dégâts."
	}
	MachineOverclock: {
		DisplayName: Surcadençage machine
		Description: "Pendant dix secondes, une réserve d'électricité fixe alimente la machine ; à l'échéance, elle brûle toute la charge."
	}
	GridBlackout: {
		DisplayName: Black-out du réseau
		Description: Emprunte la tour-signal pour couper l'alimentation de toutes les machines dans un large rayon.
	}
	PowerTransmute: {
		DisplayName: Conversion d'énergie
		Description: "Convertit la charge stockée de l'objet en main en RAM, puis la vide."
	}
	NeuralOverclock: {
		DisplayName: Surcadençage neural
		Description: "Vous frappez plus vite pendant huit secondes, mais la RAM cesse de se régénérer et vous perdez de la vie en continu."
	}
	WraithForceDrive: {
		DisplayName: Forçage de spectre
		Description: "Pendant dix secondes, les actions du spectre ne coûtent rien ; ensuite l'érosion s'aggrave et il s'endort."
	}
	IndexPreread: {
		DisplayName: Prélecture d'index
		Description: Lit tout le contenu d'un conteneur sans l'ouvrir et signale l'objet le plus précieux.
	}
	LockBurn: {
		DisplayName: Brûlure de serrure
		Description: "Ouvre ce coffre verrouillé sans clé, au prix de brûler un objet à l'intérieur."
	}
	DielSkip: {
		DisplayName: Saut jour-nuit
		Description: Avance le temps jusqu'au prochain lever ou coucher de soleil.
	}
	StormInject: {
		DisplayName: Injection d'orage
		Description: "Convoque un orage : la foudre ne frappe que les ennemis déjà sous un effet d'intrusion."
	}
	GravityInvert: {
		DisplayName: Inversion de gravité
		Description: "Inverse la gravité autour de vous : ennemis et objets au sol tombent vers le haut."
	}
	SegmentDelink: {
		DisplayName: Déconnexion de segment
		Description: "Les dégâts infligés à ce segment sont seulement comptabilisés ; à l'échéance, 60% sont versés au corps."
	}
	LimbSeizure: {
		DisplayName: Réquisition de membre
		Description: Retourne ce membre contre son propre corps pendant huit secondes.
	}
	CommandLinkCut: {
		DisplayName: Coupure de liaison
		Description: Coupe sa liaison avec ses alliés ; chacun se bat seul pendant dix secondes.
	}
	MunitionSwap: {
		DisplayName: Substitution de munitions
		Description: "La tourelle tire les munitions de votre inventaire, et les dégâts suivent les vôtres."
	}
	TurretMesh: {
		DisplayName: Maillage de tourelles
		Description: "Relie les tourelles proches en une salve vers votre curseur, quarante tirs en tout."
	}
	BeaconForge: {
		DisplayName: Balise falsifiée
		Description: La tour-signal envoie un faux appel de détresse et attire les monstres d'une vaste zone.
	}
	PrivilegeEscalate: {
		DisplayName: Élévation de privilèges
		Description: "Les protocoles coûtent moins, s'envoient plus vite et ignorent la distance ; la RAM ne se régénère plus."
	}
	ItemSalvage: {
		DisplayName: Démontage
		Description: Démonte cet objet au sol en environ 60% de ses matériaux.
	}
	DataBrand: {
		DisplayName: Marque de données
		Description: "Copie le préfixe de cet équipement, puis l'imprime sur la prochaine cible d'intrusion."
		HudTag: "Marque : {0}"
		DenyNoPrefix: Cet objet n'a aucun préfixe à copier
		DenyIncompatible: Le préfixe enregistré ne convient pas à cet objet
	}
	EntityMasquerade: {
		DisplayName: Mascarade
		Description: Les ennemis prennent cet objet au sol pour un joueur ; il encaisse à votre place pendant trente secondes.
	}
	TileConscript: {
		DisplayName: Réquisition de blocs
		Description: "Arrache ces blocs en huit plaques d'armure qui orbitent autour de vous, puis les lance à l'échéance."
	}
	VeinResonance: {
		DisplayName: Résonance de filon
		Description: Les filons du même minerai deviennent visibles à travers les murs ; les extraire double le butin mais attire des gardiens.
	}
	StressInvert: {
		DisplayName: Inversion de contrainte
		Description: Ces blocs sont indestructibles pendant dix secondes ; les ennemis qui s'y cognent subissent des dégâts.
	}
	PressureSurge: {
		DisplayName: Surpression
		Description: "Met cette nappe sous pression : tout ce qui s'y trempe est projeté vers le ciel."
	}
	MirrorSurface: {
		DisplayName: Surface miroir
		Description: "La surface devient un miroir : les projectiles ennemis qui la traversent sont copiés pour vous."
	}
	DelayFuse: {
		DisplayName: Fusée retardée
		Description: "Ce projectile ne disparaît plus : il reste en place trente secondes et devient une mine."
	}
	ProjectileTithe: {
		DisplayName: Dîme de projectiles
		Description: "Ce projectile avale les tirs ennemis proches, puis explose selon ce qu'il a avalé."
	}
	ProjectileSample: {
		DisplayName: Échantillon de projectile
		Description: "Échantillonne ce projectile ; pendant vingt secondes, un de vos tirs sur douze le reproduit."
	}
	CompensationProtocol: {
		DisplayName: Protocole de compensation
		Description: "Avance 10% de la vie de la cible ; si vous ne la tuez pas en huit secondes, c'est vous qui payez la dette."
	}
	PayloadRewrite: {
		DisplayName: Réécriture de charge
		Description: "Pendant dix secondes, tous les projectiles de la cible vous appartiennent et se règlent à vos dégâts."
	}
	PhaseDesync: {
		DisplayName: Décalage de phase
		Description: "Sépare le corps de la cible de sa zone de collision : les deux camps deviennent plus difficiles à toucher."
	}
	LiveCellTap: {
		DisplayName: Prise sur cellule vive
		Description: La cible ne peut plus bouger et ignore les dégâts ; sa vie se convertit en votre RAM.
	}
	FirmwareRollback: {
		DisplayName: Retour de micrologiciel
		Description: "Ramène la cible au comportement de sa phase précédente ; à l'échéance, elle s'emballe pendant cinq secondes."
	}
	ShellRequisition: {
		DisplayName: Réquisition de carcasse
		Description: Une cible tuée pendant la marque se relève et se bat pour vous pendant quinze secondes.
	}
	PositionCast: {
		DisplayName: Diffusion de coordonnées
		Description: "Pendant quinze secondes, sa position est visible pour toute votre équipe."
	}
	GaugePollution: {
		DisplayName: Pollution des jauges
		Description: "Salit son interface : les lectures de vie et de munitions sautent pendant huit secondes."
	}
	LinkTraceback: {
		DisplayName: Rétro-traçage
		Description: "Coupe les envois qui vous visent, brûle l'expéditeur et le marque."
	}
	ForceUninstall: {
		DisplayName: Désinstallation forcée
		Description: Arrache un protocole ennemi sur vous ; impossible d'en arracher un autre pendant une demi-minute.
	}
	MemoryScorch: {
		DisplayName: Brûlure mémoire
		Description: Brûle 3 points de RAM à la cible ; sa régénération reste à zéro pendant dix secondes.
		SealTag: RAM scellée
	}
	BuffSiphon: {
		DisplayName: Siphon de bonus
		Description: "Vole le bonus le plus long de la cible et vous le donne, jusqu'à trente secondes."
	}
	CombatSiphon: {
		DisplayName: Siphon de combat
		Description: "Pendant dix secondes, les dégâts que vous lui infligez se convertissent en RAM, au prorata."
	}
	BallisticTurncoat: {
		DisplayName: Retournement balistique
		Description: Ses trois prochains projectiles font demi-tour en vol et frappent leur tireur ; cesser le feu suffit à rester en sécurité.
		HijackCounter: "Balistique détournée {0}/{1}"
		DeathReason: "Le projectile de {0} a été retourné par {1} et lui est revenu"
	}
	MeltdownBrand: {
		DisplayName: Marque de fusion
		Description: "Une mèche de quatre secondes reste visible, puis explose pour 80 dégâts ; l'arracher à temps désamorce la charge."
		FuseTag: "Fusion {0}s"
		DeathReason: "{0} a été pulvérisé par la marque de fusion plantée par {1}"
	}
	MapBlackout: {
		DisplayName: Extinction de carte
		Description: "Sa carte se recouvre de neige pendant quinze secondes, épingles et marques d'équipe comprises."
	}
	ChannelScramble: {
		DisplayName: Brouillage de canal
		Description: "Pendant vingt secondes, son chat devient illisible et les noms d'alliés disparaissent de son écran."
	}
	StealthStrip: {
		DisplayName: Dévoilement
		Description: "Ôte toute invisibilité et furtivité ; pendant dix secondes, elle ne se reconstitue pas et son contour est visible pour tous."
	}
	CooldownInject: {
		DisplayName: Injection de recharge
		Description: "Pendant six secondes, la cible utilise ses objets 35% plus lentement ; une potion déjà en recharge gagne cinq secondes de plus."
	}
	CyberwareOffline: {
		DisplayName: Cyberware hors ligne
		Description: "Pendant huit secondes, tous ses Cyberware se coupent et passent hors ligne."
	}
}
