OniRainWorld: {
	OniRainWorldSystem: {
		InteractHint: "[Clic droit] Ouvrir l'ombrelle et entrer dans la pluie"
		DescendHint: "[Clic droit] Ouvrir l'ombrelle et descendre dans la pluie profonde"
		GrabHint: "[Clic droit] Saisir l'ombrelle"
		OniDeathReason: "{0} a été entraîné sous la pluie par ce qui se tenait sous l'ombrelle"
	}
}
GodSmithGunsEarly: {
	GsFlintlockPistol.Desc: 
		'''
		Reforgé : chargement à double chambre, le 2e coup part 40% plus vite ; la dernière chambre transforme une munition en double balle en V, recul doublé
		Clic droit pour recharger plus tôt ; visez la bande lumineuse, le coup suivant inflige 25% de dégâts en plus
		'''
	GsGunsEarlyPlayer: {
		Perfect: Rechargement parfait !
		HighNoon: Midi pile !
	}
	GsMusket.Desc: 
		'''
		Reforgé : un vrai fusil à chargement par la bouche ; chaque balle de plomb vole plus vite, perce mieux, et traverse 1 ennemi de plus
		Rechargement en trois temps : verser, tasser, amorcer ; clic droit sur le temps de tassement, le coup suivant inflige 30% de dégâts en plus et gagne une couche de perçage
		'''
	GsQuadBarrelShotgun.Desc: 
		'''
		Reforgé : les quatre canons tirent à tour de rôle, un par un ; le 4e envoie 8 plombs d'un coup, et le recul vous projette en arrière
		Tirer vers le bas vous propulse en l'air
		Clic droit pour briser le canon et recharger ; visez la bande lumineuse, chaque canon gagne 2 plombs au tour suivant
		'''
	GsRevolver.Desc: 
		'''
		Reforgé : barillet de six coups, la dernière chambre inflige toujours 40% de dégâts en plus
		Maintenez clic droit pour faire tourner le barillet : recharge instantanée de 1 à 6 cartouches au hasard
		Pile 6 cartouches, et le coup suivant est Midi pile : dégâts doublés, recul doublé
		'''
}
GodSmithGunsHard: {
	GsCandyCornRifle: {
		Desc: 
			'''
			Reforgé : clic droit pour changer d'enrobage
			Pluie de bonbons : la rafale classique reste, mais les tirs suivent un arc sucré
			Rafale collante : 3 balles de bonbon mou d'un coup ; chaque impact empile du glaçage, ralentit la cible et rend vos tirs sucrés plus douloureux
			'''
		ModeCandyRain: Pluie de bonbons
		ModeStickyBurst: Rafale collante
	}
	GsClockworkAssaultRifle: {
		Desc: 
			'''
			Reforgé : clic droit pour changer de mode de tir
			Rafale d'engrenages : la rafale classique de 3 coups reste, le 3e inflige 30% de dégâts en plus
			Surcadençage : cadence +40%, au prix de la chaleur ; trop chaud, les engrenages se coincent
			'''
		ModeGearBurst: Rafale d'engrenages
		ModeOverclock: Surcadençage
	}
	GsGatligator: {
		Desc: 
			'''
			Reforgé : clic droit pour changer de tempérament
			Émeute des marais : la dispersion sauvage reste, chaque balle rebondit une fois sur les blocs
			Rouleau mortel : quatre tirs serrés d'affilée ; le dernier ouvre une plaie saignante
			'''
		ModeSwampRiot: Émeute des marais
		ModeDeathRoll: Rouleau mortel
	}
	GsMegashark: {
		Desc: 
			'''
			Reforgé : clic droit pour changer de morsure
			Frénésie : plus vous maintenez la gâchette, plus la cadence monte ; Morsure de requin : resserre la dispersion, dégâts +15%
			50 impacts cumulés font couler le sang : pendant 3 secondes, chaque impact laisse une plaie saignante
			'''
		ModeFrenzy: Frénésie
		ModeSharkBite: Morsure de requin
	}
	GsOnyxBlaster: {
		Desc: 
			'''
			Reforgé : clic droit pour changer de charge
			Salve d'onyx : l'explosion laisse une tache sombre qui tire les ennemis vers le centre
			Charge singularité : cadence réduite, une énorme sphère d'onyx ; l'explosion attire tout vers le noyau et disperse vos balles en anneau
			'''
		ModeVolley: Salve d'onyx
		ModeSingularity: Charge singularité
	}
	GsSDMG: {
		Desc: 
			'''
			Reforgé : clic droit pour cycler trois modes de tir
			Marée du dauphin : la cadence légendaire reste telle quelle
			Rafale sonar : chaque 3e hit pose une marque sonar ; les dégâts à distance de toute l'équipe sur cette cible augmentent de 8%
			Guidage orbital : les balles suivent légèrement, dégâts -10%
			'''
		ModeDolphinTide: Marée du dauphin
		ModeSonarBurst: Rafale sonar
		ModeOrbitalGuide: Guidage orbital
	}
	GsShotgun: {
		Desc: 
			'''
			Reforgé : clic droit pour changer d'âme
			Âme large : 6 plombs en éventail large, avec une courbe de chute ; 3 plombs dans le même tir font pleuvoir du plomb au-dessus de la cible
			Âme serrée : 3 plombs lourds en ligne droite ; les 3 sur la même cible la corroient 1,5 s, et elle subit 12% de dégâts en plus de cette arme
			Chaque pression de gâchette ne consomme toujours qu'1 munition
			'''
		ModeWideBore: Âme large
		ModeTightChoke: Âme serrée
	}
	GsSniperRifle: {
		Desc: 
			'''
			Reforgé : tapotez clic droit pour changer de mode, maintenez pour viser
			Tir de précision : une ligne de visée perçante ; restez immobile pour retenir votre souffle, ce tir est alors un critique assuré
			Tir rapide : échange la puissance contre la cadence
			'''
		ModeSnipe: Tir de précision
		ModeRapid: Tir rapide
	}
	GsTacticalShotgun: {
		Desc: 
			'''
			Reforgé : clic droit pour changer de posture
			Éventail tactique : le cône de dispersion reste affiché, la couverture des 6 plombs se lit d'un coup d'œil
			Triple pompe : 3 pompes rapides puis un temps forcé ; la première envoie une onde de choc, et les ennemis heurtés subissent 10% de dégâts en plus de vos plombs pendant 1 s
			Chaque pompe consomme 1 munition comme d'habitude
			'''
		ModeFan: Éventail tactique
		ModeTriplePump: Triple pompe
	}
	GsUzi: {
		Desc: 
			'''
			Reforgé : clic droit pour changer de prise
			Tir à deux armes : cadence +30%, dispersion lâche ; Rafale : trois tirs serrés, chaque balle trouve sa place
			Chaque 4e coup (le dernier d'une rafale) est un traceur d'ambre : il allume la cible, et vos balles d'Uzi lui infligent 10% de dégâts en plus pendant 1,5 s
			'''
		ModeAkimbo: Tir à deux armes
		ModeBurst: Rafale
	}
	GsVenusMagnum: {
		Desc: 
			'''
			Reforgé : clic droit pour changer de floraison
			Focalisation : après un critique, le coup suivant traverse 1 ennemi de plus ; la ligne de visée s'allume pendant la fenêtre
			Triplet de pétales : une munition se fend en trois pétales en éventail
			'''
		ModeFocus: Focalisation
		ModeTriplet: Triplet de pétales
	}
	GsVortexBeater: {
		Desc: 
			'''
			Reforgé : clic droit pour changer de flux
			Balayage vortex : la pluie de balles classique reste, les roquettes suivent légèrement
			Canon vortex : tirs lourds lents chargés, 2,6 fois plus puissants ; l'impact déchire un vortex qui attire
			'''
		ModeSweep: Balayage vortex
		ModeCannon: Canon vortex
	}
	GsXenopopper: {
		Desc: 
			'''
			Reforgé : clic droit pour changer de bulle
			Grappe : 5 bulles convergent vers le curseur et explosent en croisement
			Vide : une grande bulle flotte vers le curseur, s'y tient un instant, puis crache 5 munitions d'un coup
			'''
		ModeCluster: Grappe
		ModeVacuum: Vide
	}
	GsShotgunLeadRainProj.DisplayName: Pluie de plomb
	GsTacticalShotgunBreachProj.DisplayName: Onde de choc
	GsUziTracerProj.DisplayName: Traceur d'ambre
}
GodSmithLaunchers: {
	GsElectrosphereLauncher: {
		Desc: 
			'''
			Reforgé : dès que deux sphères ou plus sont en jeu, des arcs Tesla se tendent entre elles, jusqu'à 3 segments ; un arc inflige la moitié des dégâts d'une sphère
			Clic droit : toutes les sphères surchargent, rayon +40%, et se déchargent en 2 secondes
			'''
		TipOverload: Surcharge !
	}
	GsGrenadeLauncher: {
		Desc: 
			'''
			Reforgé : les grenades se collent aux murs et aux ennemis, plus d'explosion automatique ; collées à la chair, dégâts +25%
			Clic droit pour tout faire sauter, jusqu'à 6 grenades posées
			'''
		TipDetonate: Tout faire sauter !
	}
	GsJackOLanternLauncher: {
		Desc: 
			'''
			Reforgé : clic droit, les citrouilles en roulement rient d'une voix et explosent, chacune lâchant 3 feux follets à tête chercheuse
			Chaque explosion laisse un champ de chandelles qui brûle les ennemis qui s'y tiennent
			'''
		TipGrin: Rictus collectif !
	}
	GsNailGun: {
		Desc: 
			'''
			Reforgé : les clous plantés dans la chair ne tombent plus, jusqu'à 5 par ennemi ; chacun lui fait subir 3% de dégâts en plus de toutes sources
			Clic droit arrache tous les clous avec la chair, en une gerbe d'éclats
			'''
		TipExtract: Arracher les clous !
	}
	GsProximityMineLauncher: {
		Desc: 
			'''
			Reforgé : le rayon de déclenchement des mines n'est visible que pour vous
			Clic droit les fait exploser en chaîne dans l'ordre de pose ; une mine oisive 60 secondes se récupère et rend une roquette
			'''
		TipChain: Domino !
		TipRecycle: Mine récupérée
	}
	GsRocketLauncher: {
		Desc: 
			'''
			Reforgé : clic droit pour faire exploser toutes les roquettes en vol
			Chaque explosion aérienne lance 3 dards perçants vers votre curseur
			'''
		TipDetonate: Explosion aérienne !
	}
	GsSnowmanCannon: {
		Desc: 
			'''
			Reforgé : clic droit pour changer de vecteur
			Essaim à tête chercheuse : l'impact grave un flocon, la cible subit 8% de dégâts en plus de cette arme
			Orbite de blizzard : les roquettes montent d'abord, puis plongent depuis au-dessus du curseur
			'''
		ModeHoming: "Vecteur : essaim à tête chercheuse"
		ModeOrbital: "Vecteur : orbite de blizzard"
	}
	GsStarCannon: {
		Desc: 
			'''
			Reforgé : clic droit pour changer de trajectoire
			Tir tendu : les étoiles volent droit ; Chute d'étoiles : elles montent d'abord, puis une pluie tombe autour du curseur et éclabousse de poussière d'étoile
			'''
		ModeDirect: "Trajectoire : tir tendu"
		ModeStarfall: "Trajectoire : chute d'étoiles"
	}
	GsStynger: {
		Desc: 
			'''
			Reforgé : clic droit pour cycler la fusée
			Impact : explose au contact ; Distance : explose à la distance du curseur, éclats en cône ; Ricochet : rebondit une fois sur un bloc avant de s'armer
			'''
		ModeImpact: "Fusée : impact"
		ModeRange: "Fusée : explosion à distance"
		ModeRicochet: "Fusée : ricochet"
	}
}
GodSmithMagicConduit: {
	GsHeatRay.Desc: 
		'''
		Reforgé : maintenez pour projeter un rayon brûlant ; à chaleur blanche le faisceau s'élargit, et 5 couches de fusion explosent
		Clic droit pour relâcher toute la chaleur en une lance corona
		'''
	GsMedusaHead.Desc: 
		'''
		Reforgé : maintenez pour déployer un cône de regard pétrifiant ; les couches de veines de pierre pétrifient brièvement, et à chaleur blanche le regard se resserre
		Clic droit pour relâcher toute la chaleur en regards de pierre dans huit directions
		'''
	GsSoulDrain: {
		Desc: 
			'''
			Reforgé : conduit sangsue, jusqu'à 3 ennemis liés et drainés ensemble ; la vraie régénération de vie n'arrive qu'à chaleur blanche
			Clic droit fait exploser le sang stocké au curseur ; une explosion en surcharge vous arrache 10 points de vie
			'''
		BloodPriceDeath: "{0} a été vidé par son propre conduit sangsue"
	}
}
GodSmithMagicMorph: {
	GsClingerStaff.Desc: 
		'''
		Reforgé : maintenez clic droit un instant pour poser un mur de lianes maudites d'environ 16 blocs dans l'axe de visée, à n'importe quel angle
		Si la charge déborde, chaque extrémité pousse encore un pan vertical
		'''
	GsCrimsonRod.Desc: 
		'''
		Reforgé : le nuage de sang devient un champ de pluie sacrificielle
		Les gouttes empilent l'érosion de sang ; à trois couches, ça explose ; les alliés dans le champ récupèrent lentement de la vie
		Clic droit déplace le champ vers le curseur pour un peu de mana
		'''
	GsCrystalSerpent.Desc: 
		'''
		Reforgé : les éclats pulvérisés rebondissent une fois de plus
		Maintenez clic droit pour charger, relâchez un python de cristal géant qui serpente et explose en une pluie d'éclats plus dense
		'''
	GsCrystalStorm.Desc: 
		'''
		Reforgé : maintenez clic droit pour charger un vortex de réfraction au curseur
		Vos éclats de cristal qui le traversent se réfractent, vont plus vite et percent 1 ennemi de plus
		'''
	GsFlamelash.Desc: 
		'''
		Reforgé : le guidage en vol tourne 25% plus vite
		Maintenez clic droit pour charger, relâchez un long serpent de flamme dont le corps suit votre guide et enflamme les ennemis sur le passage
		'''
	GsMagicMissile.Desc: 
		'''
		Reforgé : le guidage en vol tourne 25% plus vite
		Maintenez clic droit pour charger, relâchez trois missiles magiques qui escortent votre curseur en formation
		'''
	GsMeteorStaff.Desc: 
		'''
		Reforgé : les météores laissent un cratère brûlant à l'impact
		Maintenez clic droit pour charger, relâchez une salve de cinq météores le long du curseur
		'''
	GsNimbusRod.Desc: 
		'''
		Reforgé : quand les deux nuages sont en place, un couloir de pluie les relie, trempant et ralentissant les ennemis à l'intérieur
		Clic droit bascule entre pluie tiède et orage ; l'orage foudroie le long du couloir
		'''
	GsRainbowGun.Desc: 
		'''
		Reforgé : tant que l'arc-en-ciel tient, vos projectiles dans la bande au-dessus de l'arc infligent 8% de dégâts en plus, et l'arc répand des impulsions prismatiques à tête chercheuse
		Clic droit rapatrie l'arc-en-ciel et rend la moitié du mana
		'''
	GsRainbowRod.Desc: 
		'''
		Reforgé : le projectile guidé explose en éclats prismatiques à l'impact
		Maintenez clic droit pour charger, relâchez un pont arc-en-ciel : les ennemis qui le traversent souffrent, les alliés dessus accélèrent
		'''
	GsSkyFracture.Desc: 
		'''
		Reforgé : les lames magiques déchirent un éclair de fracture à l'envol
		Maintenez clic droit pour charger, relâchez trois failles autour du curseur qui lancent des lames convergentes
		'''
}
GodSmithSummonWhips: {
	GsCoolWhip.Desc: 
		'''
		Reforgé : les flocons nés d'une frappe cadencée sont plus grands et percent 1 ennemi de plus
		4 marques de givre scellent le sceau d'exécution ; la frappe cadencée suivante l'ouvre en une explosion de givre qui applique gelure
		'''
	GsDarkHarvest.Desc: 
		'''
		Reforgé : le saut d'énergie sombre se propage aux ennemis proches, une extra-cible par marque de récolte sur la victime
		4 marques scellent le sceau d'exécution ; la frappe cadencée suivante moissonne son âme et fauche en un éclair tous les ennemis marqués
		'''
	GsDurendal.Desc: 
		'''
		Reforgé : après 3 frappes cadencées d'affilée, chaque frappe cadencée suivante lance une onde d'épée dorée depuis le bout du fouet
		5 marques scellent le sceau d'exécution ; la frappe cadencée suivante fait descendre une lame de verdict sacré
		'''
	GsFirecracker.Desc: 
		'''
		Reforgé : conserve l'explosion classique déclenchée par les serviteurs
		Les frappes cadencées chargent des mèches sur la cible ; à 3 mèches, la prochaine explosion enchaîne 3 détonations de plus
		'''
	GsKaleidoscope.Desc: 
		'''
		Reforgé : la fenêtre de tempo est la plus étroite de tous les fouets ; un coup dans le vide remet le rythme à zéro
		Chaque marque allume une couleur prismatique ; les cinq réunies, la frappe cadencée suivante déploie cinq tailles prismatiques en kaléidoscope, et la cible subit ensuite des critiques assurés pendant 5 secondes
		'''
	GsLeatherWhip.Desc: 
		'''
		Reforgé : enchaînez les frappes cadencées pour accumuler le tempo, le fouet s'accélère
		3 marques scellent le sceau d'exécution ; la frappe cadencée suivante l'ouvre pour 200% de dégâts, puis vos serviteurs tabassent la cible pendant 2 secondes
		'''
	GsMorningStar.Desc: 
		'''
		Reforgé : chaque frappe cadencée frappe un cercle de choc au bout du fouet
		3 marques scellent le sceau d'exécution ; la frappe cadencée suivante fait tomber une masse d'étoile pile sur la tête de la cible
		'''
	GsSnapthorn.Desc: 
		'''
		Reforgé : les frappes cadencées plantent des marques d'épine sur la proie
		4 marques scellent le sceau d'exécution ; la frappe cadencée suivante fait exploser les épines et lance 4 dards venimeux à tête chercheuse
		'''
	GsSpinalTap.Desc: 
		'''
		Reforgé : une frappe cadencée qui touche 3 ennemis d'un coup fait résonner une onde d'os sur tous ceux qu'elle a manqués
		4 marques scellent le sceau d'exécution ; la frappe cadencée suivante fait surgir une flèche d'os depuis le sol
		'''
}
GodSmithAcc.GodSmithSharkToothNecklace.EffectDesc: 
	'''
	Dégâts +4%
	Déchirure : l'attaque fend la peau de la cible, chaque couche équivaut à 1 point de perçage d'armure, jusqu'à 8 couches, 3 secondes
	'''
GodSmithEndow: {
	GodSmithLegendaryEndow: {
		EndowName: Écho du saint d'épée
		EndowDesc: "Les coups ont {0}% de chances de lancer une onde d'épée dorée infligeant {1}% des dégâts de l'arme"
	}
	GodSmithWardingEndow: {
		EndowName: Serment du rempart
		EndowDesc: "Réduit les dégâts subis de {0}%"
	}
}
