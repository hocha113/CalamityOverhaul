	}

	OniMeiUI: {
		// TitleText: INSCRIPTION STAND
		// CloseTagText: SHEATHE
		// CloseHintFormat: ESC · {0} · click off the stand to sheathe
		// StatusFormat: '''{0} inscriptions · Present name "{1}"'''
		// SlotNakago: Tang Mei
		// SlotHi: Groove
		// SlotHorimono: Horimono
		// EmptyName: (vacant)
		// EmptyHintNakago: No name on the tang. A bare blade is fine — only, nothing answers it at night
		// EmptyHintHi: No groove opened. Each groove cut is a measure of weight gone
		// EmptyHintHorimono: The carving bed is bare. To invite a deity into the steel, first show it respect
		// EraseName: EFFACE
		// EraseHint: File this inscription away — a mei can be cut again, but the blade forgets no scar
		// OriginLabel: Provenance
		// PowerLabel: Bestowal
		// BurdenLabel: Price
		// CurrentMark: Present
		// GoldMark: Gold Inlay
		// RegisterTabText: Ghost Register
		// RegisterTabHint: Click to step over
		// TrayTitle: Satchel Rubbings
		// TrayEmpty: No rubbing for this seat in your satchel. Fan ribs of owned mei still carve
	}

	OniEngraveRiteUI: {
		// RiteTitle: ENGRAVE
		// RiteTitleRenew: RENEW THE PACT
		// RiteTitleResubdue: SUBDUE
		// RiteHint: Set down the brush · Roll the scroll
		// RiteHintResubdue: Force it back · Seal the scroll
	}

	// OniPlayerDismemberSystem.SelfHurtDeathReason: "{0} was severed by their own blade"

	OniTalismanHud: {
		// HudTitle: Sealing Talisman
		// HudHintFormat: "{0} or click the talisman for the Inscription Stand · click the sheath for the Ghost Register"
		// HudDangerLine: Ghost-fire under the talisman — something is restless
		// VigorTitle: Vigor
		// VigorValueFormat: "{0} / {1}"
		// StanceTitle: Stance
		// StanceValueFormat: "{0} / {1}"
		// StanceReadyLine: Stance complete — chain two dashes through a target
		// StanceHalfLine: Past the half — chain two dashes, then strike
		// StanceMeiHint: Click to open the Ghost Register
		// DomainTitle: Eye of the Oni Domain
		// DomainStateClosed: Shut — no domain unfolded
		// DomainStateOmote: Omote — the yellowed-paper world
		// DomainStateUra: Ura — the ink-wash netherworld
		// DomainStateShifting: Mid-rite — do not disturb
		// DomainToggleHintFormat: "{0} or Left Click: unfold / fold the domain"
		// DomainFlipHintFormat: "{0} or Right Click: flip Omote/Ura (unfolds if shut)"
	}

	OnikiriTutorialLead: {
		// HudTitle: Vigor & Stance
		// HudBody: While holding Onikiri, the vigor stroke and stance sheath stay at the lower left. Vigor fuels Flash Step; full Stance unlocks executions
		// HudPrompt: Learn these readouts; press {0} or click the talisman for the Inscription Stand
		// RegisterTitle: Ghost Register
		// RegisterBody: Click the stance sheath to open the Ghost Register — names, mastery, and attunement live here
		// RegisterPrompt: Click the highlighted sheath, or use the helper button
		// MeiTitle: Inscription Stand
		// MeiBody: Click the talisman, or step over from the Register. Tang, groove, and horimono decide the blade's bestowal
		// MeiPrompt: Press {0} or click the talisman, glance at the mei seats, then continue
		// ComboTitle: Crimson Five Beats
		// ComboBody: Hold left-click to drive Crimson Rend. Land all five beats on the training shade
		// ComboPrompt: Land a full five-beat combo on the training shade
		// DashTitle: Kamui Flash Step
		// DashBody: Spend Vigor to dash; a clean pass marks and sheathes. Only hits settle the judgment
		// DashPrompt: Press {0} and dash through the shade once
		// ZanshinTitle: Zanshin
		// ZanshinBody: After Sakura returns control, a short zanshin window opens. Land a hit inside it to reclaim resources
		// ZanshinPrompt: Hit the training shade inside the zanshin window
		// SakuraTitle: Sakura Flight
		// SakuraBody: Unfold the Omote domain, then release Sakura. The clone takes flight and returns control — prelude to zanshin
		// SakuraPrompt: Open the domain, release Sakura, wait for control to return
		// AnnihilateTitle: Annihilating Flash
		// AnnihilateBody: Past half Stance, chain two dashes then left-click for Annihilating Flash. Resources are prepared
		// AnnihilatePrompt: Chain two dashes and trigger Annihilating Flash
		// FinaleTitle: Finale Slash
		// FinaleBody: At full Stance, two dashes through a target unleash Finale Slash. Stance is filled for you
		// FinalePrompt: Dash through twice and release Finale Slash
		// DismemberTitle: Ura Dismember
		// DismemberBody: Flip to Ura, then land a dismember strike. The face-shadow shutters for you — aim the training shade
		// DismemberPrompt: Flip to Ura and land dismember on the shade
		// CloseTitle: Fold the Domain
		// CloseBody: Practice ends. Fold the domain; night settles — blade in sheath, name in the register
		// ClosePrompt: Press {0} or click the Domain Eye to fold
		// NextBtn: Understood
		// OpenRegisterBtn: Open Register
		// OpenMeiBtn: Open Stand
		// SkipBtn: Skip
	}
}

OnikiriOverride: {
	// DisplayName: 鬼切
	/* Tooltip:
		'''
		Hold left-click to drive the five-beat Crimson Rend combo
		[DASH] spends Vigor on Kamui Flash Step; above half Stance, dash again within one second for a free execution dash
		At full Stance, passing through a target unleashes Finale Slash; otherwise left-click after the dash for Annihilating Flash
		If neither execution is released, half of your remaining Vigor is lost
		[Lang4]
		legend_Text
		''' */
}

OnikiriTrialQuestLine: {
	// QuestCategory: Onikiri · Trial Cuts
	// TrackerWaiting: It isn't here yet. Wait, or we go ask for it
	// TrackerFighting: "{0}: {1:0%}"
	// TrackerBrief: Next cut: {0}
	// BossRushTargetName: Night That Won't Break
	// EventActiveFormat: "{0}: underway"
	// Trial_0: That Business in the Sky
	// Trial_1: Two Wrong Pulls in the Dirt
	// Trial_2: Clumped into One Blob
	// Trial_3: Heard It's a God
	// Trial_4: Whatever's Blocking the Road
	// Trial_5: That Brimstone Smell
	// Trial_6: Fire Pit Still Lit
	// Trial_7: The Big Name
	// Trial_8: Two Dots in a Pair
	// Trial_9: Old and New Mixed Up
	// Trial_10: Walks Too Much Like a Person
	// Trial_11: That One Down Below
	// Trial_12: The One in the Stone House
	// Trial_13: Mutterers at the Door
	// Trial_14: What's Pressing Up There
	// Trial_15: Heat from the Earth's Heart
	// Trial_16: A Clump in the Damp
	// Trial_17: Where It Feels Too Empty
	// Trial_18: Dragon Still Around
	// Trial_19: Where the Booming Hits the Ears
	// Trial_20: Where the Air Goes Heavy
	// Trial_21: Gathering Again
	/* TrialSummary_0:
		'''
		There's something going on up in the sky, and I can't say what
		Just feels like we're being watched, and the blade's getting restless too
		Go take a look, then come back and tell me what it even was
		Oh—and don't tip your head back too long. Neck'll ache
		''' */
	/* TrialSummary_1:
		'''
		Two wrong pulls from the dirt that way—I can't tell them apart
		Whichever sticks its head out first, cut that one. Don't stare at both
		The blade will know the taste is off. You go first
		''' */
	/* TrialSummary_2:
		'''
		Filth bunched into one blob over there—even the wind of it is annoying
		Don't stand around staring. Go deal with it
		Getting it done matters more than anything else when you're back
		''' */
	/* TrialSummary_3:
		'''
		Heard some puddle calls itself a god. Almost made me laugh
		If names were that easy, who'd bother working
		Go check. If it really calls itself that, take the name apart
		Hey—I'm not sending you to worship. Listen carefully
		''' */
	/* TrialSummary_4:
		'''
		Up ahead feels blocked shut, and I can't say by what
		Road's closed, so open it
		How it feels past that—we'll talk when you're back
		''' */
	/* TrialSummary_5:
		'''
		Smell off the brimstone sea is wrong. Something's churning
		Don't let it near the shore. Go cut it off
		If the blade stinks when you're back, then we'll talk
		''' */
	/* TrialSummary_6:
		'''
		Fire pit that way is still lit, like someone won't go out
		Put it out, and watch your feet while you're at it
		If you burn yourself, I can't blow on it for you
		''' */
	/* TrialSummary_7:
		'''
		There's a thing with a loud name. Sounds scary enough
		Iron's making noise—go poke it, see if it's all bluster
		Don't race it for whose name is bigger
		''' */
	/* TrialSummary_8:
		'''
		Two dots in the sky, like they agreed to come out together
		If they show up as a pair, handle them separate—don't take both glares
		When you're back you can complain whether they look human
		''' */
	/* TrialSummary_9:
		'''
		Old and new mixed together over there—feels wrong, but I haven't seen clear
		Go sort it out. Don't get bluffed
		We'll talk later which side was even real
		''' */
	/* TrialSummary_10:
		'''
		A shadow walking too much like a person—I haven't seen the face and I'm already annoyed
		Don't freeze staring. Go deal with it
		Who it's copying—we'll swear about that when you're back
		''' */
	/* TrialSummary_11:
		'''
		Something blooming down below that shouldn't. Smell's already wrong
		If it's spent, deal with it. Don't leave it to bother me
		Florist rules later. You go first
		''' */
	/* TrialSummary_12:
		'''
		Something in the stone house that doesn't like moving. Looks hard
		Knock it down. Don't bash the blade on stone—I feel that too
		If your hands go numb, rub them when you're back
		''' */
	/* TrialSummary_13:
		'''
		People muttering at the dungeon door, like they aren't finished
		Interrupt them. Spare the ears
		What they were chanting—we'll talk later. Don't believe it
		''' */
	/* TrialSummary_14:
		'''
		Something like it's pressing on the moon. Looking up feels heavy
		Go get rid of it. Don't just stand there staring up
		When you're back I'll ask if you're worn out
		''' */
	/* TrialSummary_15:
		'''
		Heat from the earth's heart that way—my side feels preheated too
		Go. The edge will run hot—know that ahead of time
		Don't linger in the heat. Finish and pull out
		''' */
	/* TrialSummary_16:
		'''
		Ghosts knotted in the damp over there. I'm not counting
		Handle the whole clump. Don't pick them one by one
		And don't overnight there—I'll nag you about that when you're back
		''' */
	/* TrialSummary_17:
		'''
		That direction feels too empty. I'm going heavy on my side too
		I can't say what it is. Just wrong
		Go. Don't stand there alone spacing out—if you can't see clear, look after yourself first
		We'll talk when you're back. Staying alive beats seeing clear
		''' */
	/* TrialSummary_18:
		'''
		Heard there's still a dragon like this. True or not, you go see
		Edge'll probably burn—don't sheath it in a hurry
		I don't want feathers. Just come back yourself
		''' */
	/* TrialSummary_19:
		'''
		One boom from far off and the ears quit first
		Go make them stop, and cover your ears on the way
		If they're still buzzing when you're back, find somewhere quiet
		''' */
	/* TrialSummary_20:
		'''
		Air over there goes heavy and stagnant, like a door that won't air out
		Go end it. Don't freeze in the doorway breathing that in
		When you're back I'll tell you how to clear your head
		''' */
	/* TrialSummary_21:
		'''
		They're gathering again, like nothing ever fully breaks apart
		This one'll run long. You take it. I'll watch
		Stand steady before you start—I'll nag you about swaying when you're back
		''' */
}

// OnikiriTutorialWraith.DisplayName: Training Shade
