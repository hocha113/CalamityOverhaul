ModifyChargingStationItem: {
	DisplayName: Station de charge
	Tooltip: 
		'''
		Utilise l'électricité pour charger les appareils
		On peut y insérer des batteries pour les charger en électricité
		Peut être reliée à des conduites pour le transfert d'électricité
		Clic droit avec un objet rechargeable pour l'insérer rapidement
		Maj + clic droit pour récupérer les objets
		'''
}
DyeVatItem: {
	DisplayName: "{$ItemName.DyeVat}"
	Tooltip: 
		'''
		Permet de fabriquer des teintures
		Clic droit après placement pour ouvrir le panneau de teinture
		Placez un seau d'eau dans l'emplacement pour déteindre
		'''
}
RDemonConch: {
	DisplayName: Conque démoniaque
	Tooltip: 
		'''
		Écoute bien et tu entendras des cris
		« Fais attention. »
		'''
}
RBloodButcherer: {
	DisplayName: "{$ItemName.BloodButcherer}"
	Tooltip: 
		'''
		Combo de boucherie en trois temps, massif; le troisième coup est plus large et plus cruel
		Les swings projettent plusieurs projectiles de sang sombre; le sang retombe en arc et éclabousse à l'impact
		Les ennemis tranchés subissent le Carnage sanglant
		'''
}
