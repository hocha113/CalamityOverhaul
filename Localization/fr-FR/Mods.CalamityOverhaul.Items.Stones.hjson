GraniteTome: {
	DisplayName: Grimoire de granite
	Tooltip:
		'''
		Invoque une orbe lente et autoguidée d'énergie de granite
		Se brise en éclats de cristal chercheurs à l'impact
		'''
}

GraniteFlower: {
	DisplayName: Fleur de granite
	Tooltip:
		'''
		Tire une graine de cristal qui éclot en une fleur d'énergie persistante
		La fleur pulse plusieurs fois, projetant des pétales de cristal tout autour
		'''
}

GraniteThrowingKnife: {
	DisplayName: Couteau de lancer en granite
	Tooltip:
		'''
		Lance un couteau perforant laissant une traînée d'énergie cristalline
		Se brise en éclats de cristal lors de son dernier coup ou contre le terrain
		'''
}

GraniteWalkingBoots: {
	DisplayName: Bottes de marche en granite
	Tooltip:
		'''
		Augmente grandement la vitesse de course et l'accélération
		Crépite d'étincelles bleues à pleine vitesse
		'''
}

MarbleClub: {
	DisplayName: Massue de marbre
	Tooltip:
		'''
		Un coup lent et lourd au recul écrasant
		Peut pétrifier les ennemis, les ralentissant brièvement
		Le premier impact de chaque attaque déclenche une onde de choc de marbre
		'''
}

MarbleHuntingKnife: {
	DisplayName: Couteau de chasse en marbre
	Tooltip:
		'''
		Frappes tranchantes rapides
		Chaque troisième frappe est une attaque finale plus large qui projette des éclats de marbre
		'''
}

MarbleDisc: {
	DisplayName: Disque de marbre
	Tooltip:
		'''
		Projette un disque tournoyant qui ricoche entre les ennemis et les murs
		Puis revient en courbe dans votre main ; jusqu'à deux peuvent voler à la fois
		'''
}

MarblePebble: {
	DisplayName: Caillou de marbre
	Tooltip:
		'''
		Une pierre de fronde inépuisable, rapide et sujette aux coups critiques
		Inflige bien plus de dégâts aux ennemis ayant beaucoup de vie maximale
		Rebondit une fois sur le sol
		'''
}

MarbleShield: {
	DisplayName: Égide de marbre
	Tooltip:
		'''
		Augmente la défense et la résistance au recul
		Maintient une garde de pierre régénérante qui absorbe un coup entrant en éclatant en fragments
		Préparez-vous à un blocage parfait qui renvoie les projectiles
		'''
}

MarbleBalloon: {
	DisplayName: Ballon de marbre
	Tooltip:
		'''
		Appuyez sur Bas en l'air pour s'écraser au sol, libérant une onde de choc à l'atterrissage
		Annule les dégâts de chute
		'''
}

MarbleinaBottle: {
	DisplayName: Marbre en bouteille
	Tooltip: Accorde un lourd second saut
}

MarbleCloudBalloon: {
	DisplayName: Ballon nuage de marbre
	Tooltip:
		'''
		Accorde un lourd second saut
		Appuyez sur Bas en l'air pour s'écraser au sol, libérant une onde de choc à l'atterrissage
		Annule les dégâts de chute
		'''
}
