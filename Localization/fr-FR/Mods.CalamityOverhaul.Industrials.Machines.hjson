Thrower: {
	NoEnergyText: Énergie insuffisante !
	NoItemText: Aucun objet à lancer !
	WorkingText: Lancement en cours...
	IdleText: En attente
	DisplayName: Lanceur
	Tooltip:
		'''
		Consomme de l'électricité pour lancer des objets
		Clic droit pour ouvrir le panneau de contrôle
		'''
}

PlayerLauncher: {
	NoEnergyText: Énergie insuffisante!
	DisplayName: Plateforme d'éjection
	Tooltip:
		'''
		Consomme de l'électricité pour éjecter le joueur qui s'y tient dans la direction réglée
		Après l'éjection, immunité brève aux dégâts de chute
		Clic droit pour ouvrir le panneau
		'''
}

PacifierTower: {
	FieldOnText: Champ activé
	FieldOffText: Champ désactivé
	NoEnergyText: Énergie insuffisante!
	DisplayName: Générateur de champ de quiétude
	Tooltip:
		'''
		Sous tension, réprime les apparitions naturelles à portée
		Clic droit ou signal de fil pour basculer le champ
		'''
}

PotionBeacon: {
	NoEnergyText: Énergie insuffisante!
	DisplayName: Balise de diffusion de potions
	Tooltip:
		'''
		Stocke des potions de gain et diffuse leur effet aux joueurs à portée
		Une fiole fournit deux fois la durée d'origine
		Clic droit pour ouvrir le panneau
		'''
}

HerbFarmer: {
	NoEnergyText: Énergie insuffisante!
	// FullText: Produce storage is full!
	DisplayName: Machine de culture d'herbes
	Tooltip:
		'''
		Consomme graines et électricité pour semer automatiquement sur le sol valide autour
		Récolte les herbes en fleur, produit herbes et graines
		Clic droit pour ouvrir le panneau
		'''
}

MushroomFarmer: {
	NoEnergyText: Énergie insuffisante!
	FullText: Entrepôt de production plein!
	DisplayName: Machine de culture de champignons
	Tooltip:
		'''
		Consomme de l'électricité pour cultiver des champignons ordinaires sur l'herbe proche, et des champignons lumineux sur l'herbe à champignons
		Récolte automatiquement, parfois une graine d'herbe à champignons
		Clic droit pour ouvrir le panneau
		'''
}

Apiary: {
	NoEnergyText: Énergie insuffisante!
	NoBottleText: Plus de bouteilles vides!
	FullText: Entrepôt de production plein!
	DisplayName: Ruche
	Tooltip:
		'''
		Insérez des bouteilles vides, l'essaim consomme de l'électricité pour brasser du miel en bouteille
		Près du miel ou dans la jungle, l'essaim est plus actif et le rendement monte
		Clic droit pour ouvrir le panneau
		'''
}

SlimeVat: {
	NoEnergyText: Énergie insuffisante!
	NoWaterText: Pas assez d'eau!
	FullText: Entrepôt de production plein!
	PourText: +{0} eau
	DisplayName: Cuve de culture de gelées
	Tooltip:
		'''
		Consomme eau et électricité pour cultiver du gel par cycles
		Puise dans les plans d'eau adjacents, ou versez à la main avec un seau
		Clic droit pour ouvrir le panneau
		'''
}

AutoFisher: {
	NoEnergyText: Énergie insuffisante!
	NoBaitText: Plus d'appât!
	NoWaterText: Pas d'eau pêchable à proximité!
	FullText: Cale de prises pleine!
	DisplayName: Pêcheur automatique
	Tooltip:
		'''
		Consomme appât et électricité pour pêcher automatiquement dans l'eau sous la machine
		Plus le plan d'eau est grand et l'appât bon, plus les prises sont riches
		Clic droit pour ouvrir le panneau
		'''
}
