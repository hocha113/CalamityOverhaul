GodSmithExecutionEndow: {
	EndowName: Entaille d'exécution
	EndowDesc: 
		'''
		Toucher un ennemi sous {0}% de vie relâche une taille d'exécution
		Elle inflige {1}% de ce coup
		'''
}
GodSmithOverkillEndow: {
	EndowName: Chaîne de surplus
	EndowDesc: 
		'''
		Tuer un ennemi envoie un éclair cramoisi vers un proche
		Il emporte {0}% des dégâts en surplus, plus {1}% de ce coup
		'''
}
GodSmithCritMarkEndow: {
	EndowName: Sceau critique
	EndowDesc: 
		'''
		Les coups gravent un sceau ; à {0} charges il explose
		L'explosion est un critique assuré, de base {1}% de ce coup
		'''
}
GodSmithEchoSlashEndow: {
	EndowName: Écho du vent d'épée
	EndowDesc: 
		'''
		Un coup soulève un vent d'épée qui s'ouvre autour
		Il inflige {0}% de ce coup aux autres ennemis
		'''
}
GodSmithShockwaveEndow: {
	EndowName: Onde de choc
	EndowDesc: 
		'''
		Toutes les 1.5 s, un coup projette une onde de choc
		Elle recule les ennemis proches et inflige {0}% de ce coup
		'''
}
GodSmithComboEndow: {
	EndowName: Éclat de combo
	EndowDesc: 
		'''
		Les coups d'affilée accumulent l'élan ; le {0}e explose
		Il inflige {1}% de ce coup en zone
		Lâcher ou changer d'arme dissipe l'élan
		'''
}
GodSmithAfterimageEndow: {
	EndowName: Frappe-rémanence
	EndowDesc: 
		'''
		Tous les {0} usages, une rémanence taille vers le viseur
		Elle inflige {1}% des dégâts de l'arme
		'''
}
GodSmithBallisticEndow: {
	EndowName: Traçante perce-nuée
	EndowDesc: 
		'''
		Tous les {0} tirs, une traçante s'ajoute
		Elle traverse les ennemis et inflige {1}% des dégâts de l'arme
		'''
}
GodSmithRicochetEndow: {
	EndowName: Rebond errant
	EndowDesc: 
		'''
		Après un impact, une balle rebondit vers un autre ennemi
		Elle inflige {0}% de ce coup
		'''
}
GodSmithPhantomVolleyEndow: {
	EndowName: Salve fantôme
	EndowDesc: 
		'''
		Tous les {0} tirs, {1} projectiles fantômes accompagnent la salve
		Chacun inflige {2}% des dégâts de l'arme
		'''
}
GodSmithManaRefluxEndow: {
	EndowName: Reflux de mana
	EndowDesc: 
		'''
		Un coup a {0}% de chances d'arracher un filet de mana qui revient vers vous
		Le rattraper rend {1} mana
		'''
}
GodSmithOverloadEndow: {
	EndowName: Surcharge occulte
	EndowDesc: 
		'''
		Au-dessus de {0}% de mana, un coup déclenche des arcs violets
		Ils ajoutent {1}% de ce coup
		'''
}
GodSmithMythicEchoEndow: {
	EndowName: Invocation stellaire
	EndowDesc: 
		'''
		Lancer un sort appelle un esprit d'étoile à vos côtés
		Il jette de temps à autre des éclats stellaires sur les ennemis proches, pour {0}% des dégâts de l'arme
		'''
}
GodSmithDesperationEndow: {
	EndowName: Vaisseau brûlé
	EndowDesc: 
		'''
		Cette arme brisée rugit dans l'adversité
		Un coup a {0}% de chances d'exploser pour {1}% de ce coup en zone
		Plus le préfixe est misérable, plus l'éclat est violent
		'''
}
GodSmithHiddenEdgeEndow: {
	EndowName: Fil caché
	EndowDesc: 
		'''
		Une lame maladroite cache son vrai fil
		Tous les {0} usages, un éclair blanc tranche pour {1}% des dégâts de l'arme
		Plus l'arme est lourde et lente, plus le fil caché est aigu
		'''
}
GodSmithLuckyStarEndow: {
	EndowName: Étoile porte-bonheur
	EndowDesc: 
		'''
		Un critique fait tomber une étoile porte-bonheur sur la cible
		Elle inflige {0}% de ce coup
		'''
}
GodSmithMenaceEndow: {
	EndowName: Intent meurtrier
	EndowDesc: 
		'''
		Les coups accumulent l'intent ; le {0}e déchire une griffe noir-rouge
		Elle inflige {1}% de ce coup
		'''
}
GodSmithSwiftFootEndow: {
	EndowName: Vent de course
	EndowDesc: 
		'''
		Courir environ {0} blocs charge le vent
		Le prochain coup relâche une lame de vent perçante, pour {1}% de ce coup
		'''
}
GodSmithViolentSurgeEndow: {
	EndowName: Éclat de fureur
	EndowDesc: 
		'''
		Les coups de mêlée accumulent la fureur ; à {0} charges un anneau de lames cramoisi éclate
		Il inflige {1}% de ce coup en zone
		'''
}
GodSmithArcaneWardEndow: {
	EndowName: Garde arcanique
	EndowDesc: 
		'''
		Subir un coup tisse une garde runique avec votre mana
		Chaque point de mana absorbe {0} dégâts, jusqu'à {1}% de ce coup
		'''
}
