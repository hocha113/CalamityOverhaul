		'''
		Une fois alimentée, puise le liquide du monde sous la machine dans son réservoir tampon
		Chaque case pompée coûte 2 UE ; le fluide part ensuite par les canalisations vers les réservoirs et les machines
		'''
}
FluidTank: {
	DisplayName: Réservoir de fluide
	Tooltip: 
		'''
		Stocke jusqu'à 32 cases de liquide ; le hublot affiche le niveau
		Communique avec les pompes et les machines par les canalisations
		Le démontage vide le contenu
		'''
}
LargeFluidTank: {
