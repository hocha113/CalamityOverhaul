		LegendItemUpgradeDisable:
			'''
			Cette arme légendaire a été désactivée pour les améliorations dans ce monde.
			Pour lever cette restriction, réentrez dans le monde.
			'''
		ItemLegendOnMouseLang: Appuyez sur [Maj] pour écouter l'histoire...
	}
}

RMagicConch: {
	DontUseMagicConch: Une créature puissante vous observe...

	RMagicConch: {
		DontUseMagicConch: Une créature puissante vous observe...
		DisplayName: Conque magique
		Tooltip: Écoutez attentivement, vous entendrez l'océan
	}
}

GraniteTome: {
	DisplayName: Grimoire de granite
	Tooltip:
		'''
		Invoque une orbe lente et autoguidée d'énergie de granite
		Se brise en éclats de cristal chercheurs à l'impact
		'''
}

GraniteFlower: {
	DisplayName: Fleur de granite
	Tooltip:
		'''
		Tire une graine de cristal qui éclot en une fleur d'énergie persistante
		La fleur pulse plusieurs fois, projetant des pétales de cristal tout autour
		'''
}

GraniteThrowingKnife: {
	DisplayName: Couteau de lancer en granite
	Tooltip:
		'''
		Lance un couteau perforant laissant une traînée d'énergie cristalline
		Se brise en éclats de cristal lors de son dernier coup ou contre le terrain
		'''
}

GraniteWalkingBoots: {
	DisplayName: Bottes de marche en granite
	Tooltip:
		'''
		Augmente grandement la vitesse de course et l'accélération
		Crépite d'étincelles bleues à pleine vitesse
		'''
}

MarbleClub: {
	DisplayName: Massue de marbre
	Tooltip:
		'''
		Un coup lent et lourd au recul écrasant
		Peut pétrifier les ennemis, les ralentissant brièvement
		Le premier impact de chaque attaque déclenche une onde de choc de marbre
		'''
}

MarbleHuntingKnife: {
	DisplayName: Couteau de chasse en marbre
	Tooltip:
		'''
		Frappes tranchantes rapides
		Chaque troisième frappe est une attaque finale plus large qui projette des éclats de marbre
		'''
}

MarbleDisc: {
	DisplayName: Disque de marbre
	Tooltip:
		'''
		Projette un disque tournoyant qui ricoche entre les ennemis et les murs
		Puis revient en courbe dans votre main ; jusqu'à deux peuvent voler à la fois
		'''
}

MarblePebble: {
	DisplayName: Caillou de marbre
	Tooltip:
		'''
		Une pierre de fronde inépuisable, rapide et sujette aux coups critiques
		Inflige bien plus de dégâts aux ennemis ayant beaucoup de vie maximale
		Rebondit une fois sur le sol
		'''
}

MarbleShield: {
	DisplayName: Égide de marbre
	Tooltip:
		'''
		Augmente la défense et la résistance au recul
		Maintient une garde de pierre régénérante qui absorbe un coup entrant en éclatant en fragments
		Préparez-vous à un blocage parfait qui renvoie les projectiles
		'''
}

MarbleBalloon: {
	DisplayName: Ballon de marbre
	Tooltip:
		'''
		Appuyez sur Bas en l'air pour s'écraser au sol, libérant une onde de choc à l'atterrissage
		Annule les dégâts de chute
		'''
}

MarbleinaBottle: {
	DisplayName: Marbre en bouteille
	Tooltip: Accorde un lourd second saut
}

MarbleCloudBalloon: {
	DisplayName: Ballon nuage de marbre
	Tooltip:
		'''
		Accorde un lourd second saut
		Appuyez sur Bas en l'air pour s'écraser au sol, libérant une onde de choc à l'atterrissage
		Annule les dégâts de chute
		'''
}

TestItem: {
	// DisplayName: Test Item
	// Tooltip: ""
}

OniMeiRubbingHigekiri: {
	// DisplayName: Higekiri
	Tooltip: Les coups directs de lame se renforcent contre les cibles blessées et les éliminations rendent de la posture ; dégâts de lame -2%
	// Origin: The night of the test cut, the head fell with the beard still clinging to the edge. The old name comes from that
	Power: Coupe-Barbe : Les coups directs de lame gagnent linéairement en puissance contre les cibles sous 35 % de vie (jusqu'à +60 %, ou +45 % contre les boss) ; une élimination directe rend 8 de posture une fois par action
	Burden: Dégâts de lame -2 % — contre une cible en bonne santé, ce fil est légèrement plus émoussé que l'inscription d'origine
}

OniKeikoRune: {
	// DisplayName: Keiko Rune
	/* Tooltip:
		'''
		Use it to open the Onikiri lesson from the beginning, or use it again mid-lesson to put the lesson away
		Left with you when the opening lesson is declined; the rune is not consumed and may be used again
		''' */
	// NeedBlade: Onikiri is not in your bag, so the rune has no lesson to open
	// Closed: The lesson is put away; use the rune again to reopen
	// NotNow: Something else holds the stage right now
}

OniMeiRubbingOnikiri: {
	// DisplayName: Onikiri
	Tooltip: Inscription d'origine : conserve la lame telle quelle, sans faveur ni prix
	// Origin: At Ichijo-Modoribashi, the oni that lost its arm never dared come back for it. The name has been nailed to the tang ever since
	Power: L'inscription d'origine. La lame reste exactement telle qu'elle est — rien d'accordé, rien de pris
	Burden: None
}

OniMeiRubbingShishinoko: {
	// DisplayName: Shishi-no-ko
	Tooltip: Deux vagues de mâchoires couronnent un combo complet de cinq coups ; intervalle du combo +2%
	// Origin: Left by the pillow at midnight, the blade roared like a lion. Inlaid in gold, to honor the name
	Power: Rugissement du Lion : Terminez cinq coups de combo sans interruption par une ruée ou un art ; le cinquième libère deux vagues de mâchoires convergentes infligeant chacune 22 % des dégâts de lame de base
	Burden: Intervalle du combo +2 % — il faut inspirer avant de rugir
}

OniMeiRubbingTomokiri: {
	// DisplayName: Tomokiri
	Tooltip: Les annulations par ruée laissent des entailles de Culpabilité retardées ; dégâts subis +6%
	// Origin: Crossed with a friendly blade in trial, it cut the friend in two. A name of blame, chiseled into the tang; the sword has run violent since
	Power: Coupe-Ami : Annuler un combo avec Kamui laisse une entaille fantôme qui mord après 6 ticks et inflige 35 % des dégâts de lame de base
	Burden: Dégâts subis +6 % ; chaque fantôme ajoute une Culpabilité (max. 3), augmentant de 4 la vigueur requise pour la prochaine ruée — un coup de Zanshin acquitte toute la dette
}

OniMeiRubbingKazehi: {
	// DisplayName: Kaze-hi
	Tooltip: Coût des ruées -15 %, consommation de Sakura -20 % ; dégâts des marques d'encre -20%
	// Origin: A groove opened like a wind channel; where the blade passes, only wind is heard, no blade is seen
	Power: Chevauche-Vent : Coût en vigueur du Pas Éclair -15 %, consommation du Vol Sakura -20 %
	Burden: Dégâts des marques éclair -20 % — la gorge fut creusée pour la légèreté, non pour le massacre
}

OniMeiRubbingChihi: {
	// DisplayName: Chi-hi
	Tooltip: Les impacts actifs rendent plus de vigueur ; régénération naturelle -35%
	// Origin: This groove is not for lightness, but for letting blood. So said the one who opened the edge
	Power: Saignée : Le premier impact de chaque coup du combo rend +1 de vigueur ; le premier impact de Zanshin d'une action en rend +4
	Burden: Régénération naturelle de vigueur -35 %, délai après dépense +0,3 s — sans sang sur le fil, peu de souffle revient
}

OniMeiRubbingFudo: {
	// DisplayName: Fudo
	Tooltip: Dépensez de la posture pour amortir les coups pendant une action engagée ; gain de posture -15%
	// Origin: Carved in the brushwork of the seed syllable Kan. The Immovable One sits by the edge, flames at his back
	Power: Immuable : Pendant une action engagée, dépensez 20 de posture pour réduire les dégâts de contact ou de projectile hostile à 65 % et le recul à 25 % (recharge de 2,5 s) ; le contrecoup du démembrement n'est jamais bloqué
	Burden: Gain de posture -15 % — la force défensive est prélevée sur votre accumulation
}

OniMeiRubbingKurikara: {
	// DisplayName: Kurikara
	Tooltip: Les exécutions accordent trois boucles de feu draconique ; limite de vigueur -10%
	// Origin: The dragon coils about the sword and would swallow it. An old horimono subject, its scales inlaid in gold
	Power: Spirale du Dragon : Une exécution accorde trois charges de feu draconique pendant 10 secondes ; chaque cinquième coup d'un combo complet en consomme une et libère une boucle infligeant 50 % des dégâts de lame de base
	Burden: Limite de vigueur -10 % — là où s'enroule le dragon, le souffle se resserre
}

OniMeiRubbingTessetsu: {
	// DisplayName: Tessetsu
	Tooltip: Le premier impact de chaque coup tranche l'acier ; dégâts de lame -10%
	// Origin: A grand name for a scrap of iron. Nailed into the tang as a joke that stuck
	Power: Coupe-Fer : Le premier impact de chaque coup du combo inflige ×1,25 dégâts aux ennemis d'acier ou cuirassés
	Burden: Dégâts de lame -10 % — sur la chair, elle semble faite de fer émoussé
}

OniMeiRubbingKyushu: {
	// DisplayName: Kyushu
	Tooltip: Puissants coups de grâce sur les vraies têtes blessées ; dégâts de lame -3%
	// Origin: The head is still the old one. Cut clean; no need for a scare-name
	Power: Chasse-Tête : Les coups directs de lame n'affectent que les corps indépendants ou les vraies têtes sous 35 % de vie, avec un bonus allant jusqu'à +85 % (+60 % contre les boss)
	Burden: Dégâts de lame -3 % ; les segments de corps, de queue et de corps alternatif ne déclenchent jamais Chasse-Tête
}

OniMeiRubbingIkiai: {
	// DisplayName: Ikiai
	Tooltip: Le cinquième coup libère un arc d'épée à 55 % ; intervalle du combo +4%
	// Origin: The breath you held while staring, then the blades met on the beat
	Power: Onde de Souffle : Le cinquième coup d'un combo complet lance un arc d'épée infligeant 55 % des dégâts de lame de base ; il vole 16 ticks et traverse au plus trois corps distincts
	Burden: Intervalle du combo +4%
}

OniMeiRubbingKyoko: {
	// DisplayName: Kyoko
	Tooltip: Le vide arme une coupe rapprochée et une onde de pression ; les actions rapprochées rapides troublent la concentration
	// Origin: A roar into empty air; the echo finds no place to land
	Power: Rugissement Creux : 90 ticks sans ennemi arment le prochain coup direct de lame à moins de 260 px pour ×1,25 dégâts ; au repos, une onde de pression de 24 ticks retentit tous les 90 ticks
	Burden: Quatre actions rapprochées en 36 ticks causent 24 ticks de déconcentration à ×0,95 dégâts rapprochés ; les impacts lointains ne consomment pas la coupe armée
}

OniMeiRubbingKarikiri: {
	// DisplayName: Karikiri
	Tooltip: Le faux corps esquive entièrement un coup ; il se réarme en 4 secondes
	// Origin: Learned so well it turned fake. An afterimage enters the tang
	Power: Faux Corps : Le début d'un Pas Éclair laisse pendant 90 ticks un leurre à la pose figée qui esquive entièrement un coup de PNJ ou projectile hostile ; il se réarme après 240 ticks
	Burden: Tant que le leurre vit, les dégâts subis et le coût des ruées sont ×1,12 ; après sa rupture, les dégâts subis sont ×1,18 pendant 60 ticks. Une expiration naturelle ne crée aucun vide
}

OniMeiRubbingMokukiri: {
	// DisplayName: Mokukiri
	Tooltip: La fin naturelle d'une ruée payée arme Mise à Mort Silencieuse ; une ruée ou un échec la consomme
	// Origin: The air sank. You got used to it. The guilt stayed
	Power: Mise à Mort Silencieuse : Pendant 45 ticks après la fin naturelle d'un Pas Éclair normal payé, la prochaine action de combo ou Zanshin inflige ×1,35 dégâts
	Burden: Une autre ruée ou une attaque manquée consomme Mise à Mort Silencieuse ; les ruées d'exécution gratuites ne l'arment jamais
}

OniMeiRubbingKumokiri: {
	// DisplayName: Kumo-kiri
	// Tooltip: Three cuts pin a web; closing it cuts everything inside; regen -25% while anchors stand
	// Origin: The earth-spider nested in the rafters. What was cut was not the spider, but the threads it hung from
	/* Power:
		'''
		Ink-Silk: when the blade itself lands a hit, it pins a silk anchor at the cut point for 4s
		Spread them out: the same foe gives no second anchor within 0.4s, and two anchors need roughly six tiles between them
		The third anchor strings an ink-silk triangle that sags, then snaps toward its centre, cutting every foe it sweeps for 90% of a blade hit and binding them 1s
		After it closes, 1.5s pass before you can weave again
		''' */
	// Burden: While any anchor still stands, natural regen -25%. An anchor left to expire wastes the cut that set it
	// DeedHint: Cut down thirty of the things that nest in the rafters, and the blade will learn that smell
}

OniMeiRubbingOnimaru: {
	// DisplayName: Oni-maru
	// Tooltip: Stand still and the blade flies off to cut on its own; you have no blade while it is out
	// Origin: One of the Five Great Swords that cut its own demon's leg off. Stand still, and it still moves
	/* Power:
		'''
		Self-Cut: stand nearly still for 1s and the blade goes on standby
		From then on it spends 10 of your vigor every 1.5s to fly at a foe within 40 tiles, cut for 140% of a blade hit, and return to the sheath
		''' */
	// Burden: The blade is out of your hands for the whole flight, so no combo, no flash step, no Sakura Flight. With nothing nearby it will not launch
	// DeedHint: Take a hit while standing still for ten seconds without moving, and the blade moves for you once
}

OniMeiRubbingRaikiri: {
	// DisplayName: Rai-kiri
	// Tooltip: The fifth beat and the big arts call lightning under open sky; beat interval +6%, nothing indoors
	// Origin: Tachibana Dosetsu cut thunder in the rain. The edge has to learn that bolt first
	/* Power:
		'''
		Thunder-Call: when the fifth beat, a Zanshin strike, Annihilating Flash, or Finale Slash lands and there is open sky overhead, a bolt drops from the top of the world
		The bolt deals 70% of a blade hit, and in a thunderstorm one strike can call up to three
		''' */
	// Burden: Combo beat interval +6%, sunny days included, because the wind-up is paid either way. Blocked overhead or underground, no bolt falls
	// DeedHint: Slay a boss-tier foe in a storm under open sky, and the edge learns the bolt
}

OniMeiRubbingNuekiri: {
	// DisplayName: Nue-kiri
	// Tooltip: Finish a combo airborne and the fifth beat becomes a ground slam; no dashing for 0.7s after landing
	// Origin: Minamoto no Yorimasa's shot came from above. The cut fell out of the sky
	/* Power:
		'''
		Nue-Dive: finish a full combo at least three tiles off the ground and the fifth beat stops swinging sideways, diving at the floor instead
		The landing opens a shock ring about 12 tiles across for 120% of a blade hit, and drags nearby foes toward the impact
		''' */
	// Burden: No flash steps for about 0.7s after you land. Fought close to the ground, the fifth beat stays an ordinary fifth beat
	// DeedHint: At night, cut down a flyer from great height, and the blade learns that plunge
}

OniMeiRubbingKamihi: {
	// DisplayName: Kami-hi
	// Tooltip: Dashing through a foe drops a paper cutout; cutting the paper hits the foe; dashes cost more while paper stands
	// Origin: Omokage silhouettes cut out for the surface world. While the paper stands, the blade keeps cutting it
	/* Power:
		'''
		Paper-Effigy: dashing through a foe leaves a paper cutout of it where you land, good for 7s, two on the field at most
		Cutting that paper deals 80% of a blade hit straight to the foe itself
		It also opens a wound on the foe for 1.5s, and your hits land 12% harder while that wound is open
		''' */
	// Burden: Dash vigor cost +12% while any effigy stands
	// DeedHint: Sever twenty omokage papers in Ura, and the hand learns how paper is cut
}

OniMeiRubbingSorahi: {
	// DisplayName: Sora-hi
	// Tooltip: One extra dash off the ground and double regen; the first 0.75s after landing gives nothing back
	// Origin: With no ground underfoot, breath floats. Touch down and it sinks away
	/* Power:
		'''
		Air-Groove: natural regen doubles while both feet are off the ground, and you get one extra dash
		An air dash that runs out leaves you hovering at its endpoint for half a second
		''' */
	// Burden: Natural regen drops to zero for 0.75s after you land, and dashing on the ground costs 10% more vigor
	// DeedHint: Stay airborne for fifteen seconds while still cutting, and the groove learns to float
}

OniMeiRubbingKagamihi: {
	// DisplayName: Kagami-hi
	// Tooltip: A dash endpoint stands a paper mirror that copies your next cut; weapon damage -5%
	// Origin: The cut in the mirror lands half a beat late
	/* Power:
		'''
		Mirror-Echo: the endpoint of a Kamui flash step stands a paper mirror for 2s
		The next time you cut, the figure in the mirror repeats that same cut for 45% of a blade hit, then shatters
		''' */
	// Burden: Weapon damage -5%. The copy swings from wherever the mirror stands, so whether it connects is on you
	// DeedHint: Finish a mimic with a Zanshin strike, and the mirror can write it back
}

OniMeiRubbingAmahi: {
	// DisplayName: Ama-hi
	// Tooltip: Sakura Flight drips ink that pools and binds where it lands; Sakura drain +15%
	// Origin: Petals must soak through before water will stay
	/* Power:
		'''
		Ink-Rain: while cruising in Sakura Flight, a bead of ink drops every 0.1s for 12% of a blade hit
		Beads spread into puddles where they land, and foes that step in are bound for half a second
		''' */
	// Burden: Sakura Flight drain +15%. Carrying rain the whole way costs
	// DeedHint: Fly in the rain for ten straight seconds with petals soaked through
}

OniMeiRubbingTsuzurihi: {
	// DisplayName: Tsuzuri-hi
	// Tooltip: Ink brands from one dash cut lines between each other; a lone brand deals -30%
	// Origin: Marks must string together before they become a line
	// Power: Mark-Stitch: ink brands from the same dash all go off together and cut lines between one another, each line for 35% of a blade hit
	// Burden: A lone ink brand deals -30%. Catch only one foe per dash and this groove is a pure loss
	// DeedHint: Pierce six different foes in one dash, and the marks stitch
}

OniMeiRubbingBonsho: {
	// DisplayName: Bonsho
	// Tooltip: Hold full stance without a Finale and the blade tolls itself; half your stance buys a ring of control
	// Origin: The bell does not wait to be struck. When stance is full, it rings itself
	/* Power:
		'''
		Bell-Toll: hold full stance for 3s without releasing Finale Slash and the blade tolls on its own
		Foes within 30 tiles each take 60% of a blade hit and are bound 1.5s, and your stance drops to 50
		''' */
	// Burden: Once the bell rings, that Finale is gone. Full stance forces you to pick one
	// DeedHint: Win a whole boss fight without a single execution, then knock the bell down
}

OniMeiRubbingHannya: {
	// DisplayName: Hannya
	// Tooltip: Drop low and the mask turns demon: heavier hits and lifesteal; frail while it is out, duller before it turns
	// Origin: When the face turns, it is not the same face anymore
	/* Power:
		'''
		Mask-Shift: below 35% of your own life the mask turns demon, blade damage +20%, and every hit restores 0.5% of your max life
		While the demon face is out, every third hit brings up a mask that bites for 50% of a blade hit
		''' */
	// Burden: Damage taken +15% while the demon face is out. In maiden form, weapon damage -4%
	// DeedHint: Slay a boss while you yourself have only a breath left, and the mask can turn
}

OniMeiRubbingKaresansui: {
	// DisplayName: Karesansui
	// Tooltip: Plant your feet to rake a sand garden that stays put, cutting and feeding stance
	// Origin: The rake pattern stays where you made it. Step in, and the blade follows
	/* Power:
		'''
		Sand-Garden: stand nearly still for 1.5s and a sand field about 20 tiles across is raked at your feet, lasting 5s
		The field cuts every half second for 18% of a blade hit
		While you stand inside your own field, stance gain +30%
		''' */
	// Burden: You have to plant first, and moving clears what you have built up
	// DeedHint: Hold one spot for thirty seconds of combat without taking a hit, and the sand can be raked
}

OniMeiRubbingSenju: {
	// DisplayName: Senju
	// Tooltip: Six ghost arms join the Finale Slash freeze; afterwards vigor zeroes and dashing is locked 3s
	// Origin: One hand, one name. Every boss sent off by Finale must be counted
	// Power: Thousand-Arms: during the Finale Slash freeze, six sword-bearing ghost arms rise behind you and cut with it, each for 30% of a blade hit
	// Burden: After the Finale your vigor drops to zero and you cannot flash step for 3s
	// DeedHint: Send off eight different bosses with Finale, one hand for each name
}

OniMeiRubbingKogehi: {
	// DisplayName: Koge-hi
	Tooltip: Les Pas Éclair brûlent tout leur trajet ; dégâts de lame -4%
	// Origin: Do not put your foot in the hot shallows. The groove is for stepping clear
	Power: Piste Brûlante : Une ruée laisse jusqu'à cinq brûlures réparties régulièrement pendant 90 ticks, chaque impact infligeant 14 % des dégâts de lame de base ; les brûlures à moins de 32 px sont renouvelées
	Burden: Dégâts de lame -4 % ; compensez la perte avec le sol brûlant laissé par vos déplacements
}

OniMeiRubbingKanhi: {
	// DisplayName: Kan-hi
	Tooltip: Régénération naturelle au calme ×2,25 ; coût des ruées et de Sakura +8%
	// Origin: Quiet by the door. Let the ears rest
	Power: Souffle Paisible : Après 120 ticks sans coup direct de lame, la régénération naturelle de vigueur est ×2,25
	Burden: Coût en vigueur des ruées et du vol Sakura +8 % — la récupération au calme se rembourse en mouvement
}

OniMeiRubbingTodohi: {
	// DisplayName: Todo-hi
	Tooltip: Les coups entravent pendant 36 ticks ; réarmement des ruées +6 ticks
	// Origin: A bit sticky. Keep contact to turn; break off and it stalls
	Power: Entrave Collante : Les coups directs de lame entravent la cible pendant 36 ticks et fixent la mobilité des ennemis normaux/boss à 0,88/0,96
	Burden: Réarmement des ruées +6 ticks ; Entrave et Engourdissement n'appliquent que le ratio de mouvement le plus fort
}

OniMeiRubbingShiorihi: {
	// DisplayName: Shiori-hi
	Tooltip: Les éliminations élaguent une cible blessée ; régénération naturelle -10 %, Zanshin vide coûte de la vigueur
	// Origin: Cut the spent flower to open the edge, not for looks
	Power: Taille-Pétale : Une élimination directe cible un autre corps à 50 % de vie ou moins dans un rayon de 240 px, le suit brièvement puis le tranche pour 25 % des dégâts de lame de base ; sans cible, aucun délai de 45 ticks ne commence
	Burden: Régénération naturelle de vigueur -10 % ; un Zanshin vide coûte 2 de vigueur. Les lames d'élagage ne peuvent pas s'enchaîner
}

OniMeiRubbingShiohi: {
	// DisplayName: Shio-hi
	Tooltip: À marée haute, gagnez de la vigueur ou des dégâts de Zanshin ; les combos à contretemps sont légèrement émoussés
	// Origin: Tide marks overnight. Wet contact feeds the return
	Power: Temps de Marée : Sur un cycle de 48 ticks avec une demi-fenêtre de 6 ticks, un combo en phase rend +3 de vigueur une fois par action et un Zanshin en phase inflige ×1,08 dégâts
	Burden: Dégâts de combo hors phase ×0,97 ; la phase de marée est saisie au début de l'action
}

OniMeiRubbingShibori: {
	// DisplayName: Shibori
	Tooltip: Une parade traversante ou un contact engagé engourdit ; gain de posture -15%
	// Origin: Guard even with numb hands. The blade hurts too
	Power: Contre Engourdissant : Une parade traversante engourdit directement ; un contact pendant une action engagée peut dépenser 15 de posture pour réduire le coup à 85 % et engourdir (recharge de 90 ticks). L'effet dure 45 ticks, fixe la mobilité normale/boss à 0,90/0,98 et les dégâts de contact à ×0,90
	Burden: Gain de posture -15%
}

OniMeiRubbingChinmei: {
	// DisplayName: Chinmei
	Tooltip: Dégâts de projectile -12 %, recul -65 % ; gain de posture -15%
	// Origin: When the ears buzz, settle first, then move
	Power: Apaisement : Dégâts des projectiles hostiles ×0,88 et recul ×0,35
	Burden: Inactif en combat purement rapproché ; gain de posture -15%
}

OniMeiRubbingAshidome: {
	// DisplayName: Ashidome
	Tooltip: Restez immobile 45 ticks, puis infligez ×1,25 dégâts avec la prochaine action engagée
	// Origin: Stand still. Guard lives where the feet stop
	Power: Pas Enraciné : Maintenez une vitesse au carré de 2,25 ou moins pendant 45 ticks ; le prochain cinquième coup, Zanshin, Éclair Ravage-Monde ou action Finale inflige ×1,25 dégâts
	Burden: La charge est consommée au début de l'action, même en cas d'échec ; tout mouvement efface la progression
}

OniMeiRubbingYoen: {
	// DisplayName: Yoen
	Tooltip: Les exécutions déplacent un unique champ de braises ; limite de vigueur -5%
	// Origin: Oven heat still on the edge. Fire out; burn not gone
	Power: Champ de Braises : Une exécution crée ou déplace votre unique champ de braises ; il dure 180 ticks et peut infliger au même corps 16 % des dégâts de lame de base toutes les 45 ticks
	Burden: Limite de vigueur -5 % ; coût des ruées ×1,10 tant que le champ existe
}

