}

FungalFeed: {
	DisplayName: Aliment fongique
	Tooltip:
		'''
		À lancer sur un crabe-spore pour l'apprivoiser
		Un crabe-spore apprivoisé vous suit et combat à vos côtés
		Peut être équipé d'une [i:CalamityOverhaul/MushroomSaddle] selle de champignon pour devenir une monture
		"Ils adorent les champignons"
		'''
}

MushroomSaddle: {
	DisplayName: Selle de champignon
	Tooltip:
		'''
		Équipable sur un crabe-spore apprivoisé avec de l'[i:CalamityOverhaul/FungalFeed] aliment fongique
		Clic gauche sur le crabe-spore en tenant la selle pour l'équiper
		Clic droit sur un crabe-spore équipé pour le monter
		'''
	UseCombat: Ne peut être placée que sur un crabe-spore
}

EncyclopediaofOceanicKnowledge: {
	DisplayName: Encyclopédie des connaissances océaniques
	Tooltip:
		'''
		Confère instantanément la connaissance de toutes les espèces de poissons
		Débloque toutes les compétences liées à la pêche
		[c/FFD700:La sagesse de l'océan va se rassembler en vous]
		'''
	Text1: Vous maîtrisez déjà tout le savoir
	Text2: "[NUM] espèces de poissons apprises !"
}

TheForgottenTome: {
	DisplayName: Livre du monde oublié
	Tooltip:
		'''
		À l'utilisation, efface instantanément toutes vos expériences terrestres
		Vie devenue spectre, chute éternelle ; tous les êtres sont coupables, aucune âme ne reviendra
		Je m'appelle [NAME]. Quand vous lirez ceci, je serai déjà mort.
		'''
	CompletionText: Vous avez tout oublié
	ConditionsText: Atteindre n'importe quelle fin d'histoire
}

Fishoil: {
	DisplayName: Huile de poisson en bouteille
	Tooltip:
		'''
		Augmente la puissance de pêche de 10 %
		Permet de respirer sous l'eau
		Offre une résistance supplémentaire contre certaines entités inquiétantes
		'''
}

SirenMusicalBox: {
	DisplayName: Boîte à musique de sirène
	Tooltip:
		'''
		Clic droit pour jouer une musique inquiétante de boîte à musique
		Tous les auditeurs sont maudits et ne peuvent mourir tant que la musique dure
		À la fin de la musique, ils subissent une attaque mortelle
		'''
	DeathText: "{0} s'est désintégré en chair putride sous une attaque inconnue"
}

StarflowPlatedBlock: {
	DisplayName: Bloc plaqué de flux stellaire
	Tooltip:
		'''
		Matériau de base pour construire la [i:CalamityOverhaul/DeploySignaltower] tour d'intrication quantique
		"Forger la lumière stellaire fluide en fondation immortelle"
		'''
}

