OniKeikoRune: {
	DisplayName: Sceau de keiko
	Tooltip:
		'''
		Utilisez pour rouvrir le tutoriel d'Onikiri ; utilisez à nouveau pendant le tutoriel pour le fermer
		Objet reçu en refusant le tutoriel initial ; n'est pas consommé et peut être réutilisé
		'''
	NeedBlade: Onikiri n'est pas dans l'inventaire ; impossible d'ouvrir le tutoriel
	Closed: Tutoriel fermé ; utilisez ce sceau à nouveau pour le rouvrir
	NotNow: Impossible d'ouvrir le tutoriel actuellement ; veuillez réessayer plus tard
}

ScrapBeacon: {
	DisplayName: Balise de ferraille
	Tooltip:
		'''
		Invoque le Commandant de ferraille la nuit
		"La ferraille reconnaît toujours son contremaître"
		'''
}

Deepclaw: {
	DisplayName: Pince abyssale
	Tooltip:
		'''
		Invoque un homard abyssal pour combattre à vos côtés
		Le homard fonce et déchire à coups de pinces
		Tous les trois coups de pince, il recule, ouvre les pinces et déclenche un claquement de cavitation
		Le claquement inflige des dégâts de zone et tire les ennemis vers le centre
		"Ce qui vit au fond ne desserre jamais"
		'''
}

SeaShrimpShell: {
	DisplayName: Carapace de crevette de cristal abyssal
	Tooltip:
		'''
		Une carapace dure mue par la Crevette de cristal abyssal
		Matériau indispensable de la série d'armes abyssales
		"Approchez-la de l'oreille, la fosse murmure encore"
		'''
}

DeepcrystalWarhelm: {
	DisplayName: Heaume de guerre en cristal abyssal
	Tooltip:
		'''
		Dégâts de mêlée +18%, chances de critique de mêlée +10%
		Vitesse d'attaque de mêlée +18%
		"Le poids de la carapace a poussé dans les os"
		'''
	SetBonus:
		'''
		Dégâts de mêlée +18%, mais dégâts subis +10%
		Frapper un ennemi condense des bulles en orbite ; à 5 elles s'effondrent toutes et déclenchent une lourde explosion de cavitation sur la cible
		Être touché brise les bulles déjà formées et répond par une contre-onde de cavitation (recharge)
		Mouillé, les bulles se forment plus vite et explosent plus fort
		'''
}

DeepcrystalVisor: {
	DisplayName: Visière en cristal abyssal
	Tooltip:
		'''
		Dégâts à distance +18%, chances de critique à distance +10%
		30% de chances de ne pas consommer de munitions
		"À travers la lentille de cristal, la fosse brille comme en plein jour"
		'''
	SetBonus:
		'''
		Dégâts à distance +18%, mais dégâts subis +10%
		Frapper un ennemi condense des bulles en orbite ; à 5 elles s'effondrent toutes et projettent une colonne d'eau perçante vers la cible
		Être touché brise les bulles déjà formées et répond par une contre-onde de cavitation (recharge)
		Mouillé, les bulles se forment plus vite et explosent plus fort
		'''
}

DeepcrystalCrown: {
	DisplayName: Couronne magique en cristal abyssal
	Tooltip:
		'''
		Dégâts magiques +18%, chances de critique magique +10%
		Coût en mana -18%
		"Un murmure de mer est scellé dans les cristaux"
		'''
	SetBonus:
		'''
		Dégâts magiques +18%, mais dégâts subis +10%
		Frapper un ennemi condense des bulles en orbite ; à 5 elles s'effondrent toutes et lancent trois boules d'eau guidées vers la cible
		Être touché brise les bulles déjà formées et répond par une contre-onde de cavitation (recharge)
		Mouillé, les bulles se forment plus vite et explosent plus fort
		'''
}

DeepcrystalFeelers: {
	DisplayName: Couronne de tentacules en cristal abyssal
	Tooltip:
		'''
		Dégâts d'invocation +18%
		Limite de serviteurs +2
		"Les tentacules savent où se cache la proie avant vous"
		'''
	SetBonus:
		'''
		Dégâts d'invocation +18%, mais dégâts subis +10%
		Frapper un ennemi condense des bulles en orbite ; à 5 elles s'effondrent toutes et lâchent quatre bulles à tête chercheuse
		Être touché brise les bulles déjà formées et répond par une contre-onde de cavitation (recharge)
		Mouillé, les bulles se forment plus vite et explosent plus fort
		'''
}

DeepcrystalBreastplate: {
	DisplayName: Plastron en cristal abyssal
	Tooltip:
		'''
		Tous les dégâts +10%, chances de critique +6%
		"La carapace contre la lame, le sang contre la marée"
		'''
}

DeepcrystalGreaves: {
	DisplayName: Jambières en cristal abyssal
	Tooltip:
		'''
		Vitesse de déplacement +15%, encore plus élevé une fois mouillé
		Vous vous déplacez librement dans l'eau
		"Marcher sur les vagues comme sur terre"
		'''
}

