		'''
		{$CommonItemTooltip.Whips}
		Brûle les ennemis avec le feu élémentaire
		"L'essence primordiale de Terra traverse le monde avec les éléments du cosmos"
		'''
}

AzureDragonRage: {
	DisplayName: Rage du Dragon Azur
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		Dégage une forte odeur d'herbe fraîche
		'''
}

BleedingScourge: {
	DisplayName: Fléau Saignant
	Tooltip: Marque de mort après avoir frappé un ennemi, faisant pleuvoir du sang
}

GhostFireWhip: {
	DisplayName: Fouet de Feu de Fantôme
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		Un long fouet tissé avec la rage des âmes injustement emprisonnées dans les donjons
		[c/d4bc75:Une passion pure émane des enfers, vous encourageant à découvrir qui vous a trahi]
