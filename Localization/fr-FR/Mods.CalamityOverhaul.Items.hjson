FssFesterBud: {
	DisplayName: Bourgeon pourri
	Tooltip:
		'''
		Utiliser à la surface du désert pour appeler le Serpent des dunes purulent
		"Le bourgeon n'est pas mort, il a appris à suppurer"
		'''
}

BloomCaller: {
	DisplayName: Cor d'appel des bourgeons
	Tooltip:
		'''
		Sonnez du cor pour appeler une jeune pousse des sables en fleur
		La pousse jette des épines tombantes sur les ennemis
		Tous les deux jets, le troisième devient une charge corporelle qui tournoie en anneau de pétales
		"Le cor n'est pas un ordre, c'est un arrosage"
		'''
}
