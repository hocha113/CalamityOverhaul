		'''
}
WGGMK2Wilderness: {
	DisplayName: Géantes éoliennes dans la nature
	Tooltip: ""
}
WGGWilderness: {
	DisplayName: Éoliennes dans la nature
	Tooltip: ""
}
TeslaElectromagneticTower: {
	DisplayName: Tour électromagnétique Tesla
	Tooltip: 
		'''
		Nécessite de l'électricité pour fonctionner
		Après placement au sol, clic droit pour basculer entre mode attaque et mode garde
		En mode attaque, émet des arcs électriques vers les ennemis proches
		En mode garde, inflige un débuff électrifié à tous les ennemis à portée ; si un joueur est à portée
		et tient un objet rechargeable, la tour émet des arcs pour le recharger à distance
		"Ingénieurs, tenez-vous à l'écart"
		'''
}
FlameTurret: {
	TurretOnText: Tourelle de flammes activée
	TurretOffText: Tourelle de flammes désactivée
	NoEnergyText: Énergie insuffisante!
	FuelLoadText: "Gel chargé x{0}"
	FuelTakeText: "Gel retiré x{0}"
	DisplayName: Tourelle lance-flammes
	Tooltip: 
		'''
		Nécessite de l'électricité pour fonctionner
		Crache sans cesse des langues de feu vers les ennemis proches ; le feu traverse les groupes et allume le Feu infernal
		Clic droit sur la tourelle en tenant du gel pour charger le carburant ; brûler du gel renforce le feu
		Maj + clic droit pour retirer le gel ; les canalisations d'objets peuvent aussi alimenter le slot
		Clic droit à main vide ou un signal de fil pour basculer la tourelle
		"Ça sent la gelée grillée"
		'''
}
CryoTurret: {
	TurretOnText: Tourelle de gel activée
	TurretOffText: Tourelle de gel désactivée
	NoEnergyText: Énergie insuffisante!
	DisplayName: Tourelle de gel
	Tooltip: 
		'''
		Nécessite de l'électricité pour fonctionner
		Répand sans cesse le froid sur tous les ennemis à portée, les givre et les ralentit
		Un ennemi baigné de froid pendant environ deux secondes est brièvement gelé
		Ralentir et geler, c'est le métier ; les dégâts ne sont qu'une lente brûlure de givre
		Clic droit ou un signal de fil pour basculer la tourelle
		"Calmez-vous"
		'''
}
LaserTurret: {
	TurretOnText: Tourelle laser activée
	TurretOffText: Tourelle laser désactivée
	NoEnergyText: Énergie insuffisante!
	DisplayName: Tourelle laser
	Tooltip: 
		'''
		Nécessite de l'électricité pour fonctionner
		Tire des faisceaux à hauts dégâts sur les ennemis en ligne de vue ; très longue portée, cadence lente
		Les cibles masquées par le terrain ne sont pas verrouillées ; priorise les boss
		Clic droit ou un signal de fil pour basculer la tourelle
		"Un tir, un à terre"
		'''
}
ShieldGenerator: {
	FieldOnText: Champ de bouclier activé
	FieldOffText: Champ de bouclier désactivé
	NoEnergyText: Énergie insuffisante!
	DisplayName: Générateur de bouclier
	Tooltip: 
		'''
		Nécessite de l'électricité pour fonctionner
		Sous tension, les joueurs à portée reçoivent un bouclier d'énergie
		Le bouclier se charge lentement, encaisse une part des dégâts, puis s'estompe hors de portée
		Plus il protège de joueurs, plus il consomme
		Clic droit ou un signal de fil pour basculer le champ
		'''
}
HealStation: {
	FieldOnText: Aura de soin activée
	FieldOffText: Aura de soin désactivée
	NoEnergyText: Énergie insuffisante!
	DisplayName: Station de soin
	Tooltip: 
		'''
		Nécessite de l'électricité pour fonctionner
		Sous tension, régénère lentement la vie de tous les joueurs à portée
		Clic droit ou un signal de fil pour basculer l'aura
		"Accident du travail ? Connais pas"
		'''
}
EmblemOfDread: {
	DisplayName: Emblème d'effroi
	Tooltip: 
		'''
		Augmente les dégâts de mêlée de 100 %
		Augmente les chances de coup critique de mêlée de 100 %
		Augmente la vitesse de mêlée de 100 %
		Augmente la défense de 100, en ignorant toute réduction de défense
		Réduit les dégâts subis de 75 % et renvoie 100 fois les dégâts à l'attaquant
		Toutes les attaques de mêlée infligent le débuff Érosion du vide
		Les attaques de mêlée réelles ont une chance d'effacer instantanément les ennemis ayant moins de 250 000 PV
		En vous déplaçant à grande vitesse, vous laissez des points de distorsion sur votre trajectoire, infligeant des dégâts extrêmes
		Accorde la capacité de Ruée gravitationnelle ; appuyez sur [KEY] pour foncer sur une longue distance et libérer d'immenses rayons gravitationnels
		En cas de dégâts mortels, vous regagnez immédiatement tous vos PV et obtenez un Bouclier gravitationnel (60 s de recharge)
		Les ennemis vous ciblent plus facilement
		[c/d94fff:"Un ange sanctifié voile votre regard et murmure d'éternelles douceurs mensongères"]
		[c/ff4d4d:"Un boucher ensanglanté brandit vos deux lames et proclame que seul le massacre apporte la gloire"]
		[c/4da6ff:"Une colombe azurée picore votre front et se moque de votre lutte insignifiante"]
		'''
}
ElectricMinRocket: {
	DisplayName: Mini-fusée électrique
	Tooltip: 
		'''
		Clic droit pour utiliser la fusée, ou placez-la au sol et clic droit pour décoller
		En l'air, flèches gauche/droite pour ajuster la direction
		Maintenez la flèche bas pour descendre lentement ; le vol consomme progressivement l'énergie
		Appuyez sur Espace pour interrompre le vol
		“Fabriquée en Union soviétique, solide et fiable — elle a failli atteindre la Lune”
		'''
}
TeleportStation: {
	NoEnergyText: Énergie insuffisante!
	TargetNoEnergyText: La station de destination n'a pas assez d'énergie de veille!
	UnnamedText: "Station sans nom ({0}, {1})"
	DisplayName: Station de téléportation
	Tooltip: 
		'''
		Forme un réseau avec les autres stations du monde
		Clic droit pour ouvrir le panneau, cliquez une destination pour voyager
		La téléportation consomme selon la distance ; la destination doit aussi garder un peu d'énergie de veille
		Vous pouvez nommer les stations pour les retrouver dans la liste
		'''
}
ElectricSundial: {
	NoEnergyText: Énergie insuffisante!
	BusyText: Le temps avance déjà!
	SkipBroadcast: "{0} a activé le cadran solaire électrique, le temps file jusqu'à l'aube"
	DisplayName: Cadran solaire électrique
	Tooltip: 
