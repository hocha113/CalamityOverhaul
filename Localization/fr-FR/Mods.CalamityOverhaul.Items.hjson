	Tooltip: 
		'''
		Vole droit un instant, puis plonge
		Frapper un ennemi y plante un bourgeon, qui s'ouvre bientôt en anneau de pétales
		Plusieurs dagues peuvent empiler des bourgeons sur la même cible
		Planté au sol, il fleurit sur place et projette trois aiguilles vers le haut
		"Sous les écailles du serpent, chacune veut fleurir"
		'''
}
Thornstring: {
	DisplayName: Corde d'épines
	Tooltip: 
		'''
		Transforme n'importe quelle flèche en flèche d'épines
		À l'impact, la flèche d'épines éclate en aiguilles courtes des deux côtés
		Maintenir le clic droit pour tendre ; à pleine tension, une flèche lourde perçante à 2,5 fois les dégâts
		La flèche lourde ouvre un anneau de pétales à chaque impact et à l'atterrissage
		"La corde est une liane, la flèche une épine, l'arc une fleur qui refuse de se flétrir"
		'''
}
BloomCaller: {
	DisplayName: Cor d'appel des bourgeons
	Tooltip: 
		'''
		Sonnez du cor pour appeler une jeune pousse des sables en fleur
		La pousse jette des épines tombantes sur les ennemis
		Tous les deux jets, le troisième devient une charge corporelle qui tournoie en anneau de pétales
		"Le cor n'est pas un ordre, c'est un arrosage"
		'''
}
Budcrown: {
	DisplayName: Couronne de bourgeon
	Tooltip: 
		'''
		Maintenir l'attaque fait tourner la tête autour de vous ; relâcher la jette vers le réticule
		La tête secoue des aiguilles en frappant les ennemis
		Tous les trois impacts, la tête s'emporte, explose en anneau de pétales et recule fort
		"Le bourgeon le plus lourd s'ouvre le plus fort"
		'''
}
BloomTome: {
	DisplayName: Grimoire des bourgeons
	Tooltip: 
		'''
		Lance un bolt-bourgeon qui fleurit
		À l'impact sur un ennemi ou au sol, il s'ouvre en anneau de pétales
		Un sort sur quatre devient un bolt en pleine floraison, plus de pétales, et deux aiguilles vers le haut
		"Quelle que soit la page, cette page fleurit"
		'''
}
