MapBlackoutChip: {
	DisplayName: Puce d'extinction de carte
}
ChannelScrambleChip: {
	DisplayName: Puce de brouillage de canal
}
StealthStripChip: {
	DisplayName: Puce de dépouillement d'invisibilité
}
CooldownInjectChip: {
