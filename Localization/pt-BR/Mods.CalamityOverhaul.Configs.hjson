CWRServerConfig: {
	DisplayName: Configuracao de Conteudo
	Headers.CWRWorldGen: Configuracoes de Geracao de Mundo de Overhaul

	GenWindGrivenGenerator: {
		Label: Gerar Gerador Eolico
		Tooltip: Coloca estruturas de geradores eolicos por todo o mundo.
	}

	GenWGGCollector: {
		Label: Gerar Postos Avancados de Sucateiros
		Tooltip: Gera aleatoriamente estruturas hostis de sucateiros por todo o mundo. Esta configuracao so tem efeito em mundos Lendarios.
	}

	GenJunkmanBase: {
		Label: Gerar Base do Sucateiro
		Tooltip: Gera uma base fortificada de sucateiros em terras devastadas ou subterraneas.
	}

	GenRocketHut: {
		Label: Gerar Cabana de Foguete
		Tooltip: Gera uma cabana misteriosa contendo componentes de foguete ou reliquias tecnologicas.
	}

	GenSylvanOutpost: {
		Label: Gerar Posto Avancado Silvano
		Tooltip: Gera postos avancados de madeira de elfos ou guardioes da floresta nas profundezas da floresta.
	}

	GenSHPCCradle: {
		// Label: Generate SHPC Cradle Island
		// Tooltip: Generates a crashed vessel sky island above spawn with the SHPC sealed inside. When disabled, the weapon can only be found in Calamity's laboratory.
	}

	ConfigChangePrefix: Usuario
	ConfigChangeSuffix: A configuracao do servidor foi modificada
}

CWRClientConfig: {
	DisplayName: Configuracao do Cliente

	Headers: {
		CWRWeapon: Configuracoes de Armas de Overhaul
		CWRDisplay: Configuracoes de Exibicao
		CWRModCompat: Patches de Compatibilidade com Mods
	}

	ScreenVibration: {
		Label: Vibracao de Tela da Arma
		Tooltip: Se ativado, a tela vibrara durante alguns ataques, o que pode tornar o impacto mais intenso
	}

	DomainConciseDisplay: {
		Label: Exibicao Minimalista do Dominio
		Tooltip: Desativado por padrao. Quando ativado, a maioria dos efeitos visuais dentro do dominio serao ocultados.
	}

	LensEasing: {
		Label: Suavizacao da Camera
		Tooltip: Quando ativado, deslocamentos rapidos de longa distancia suavizarao a camera, o que evita a sensacao de ser movido muito rapido
	}

	AmbienceDensity: {
		// Label: Ambience Density
		// Tooltip: Scales decorative ambience particle density only; telegraphs and hazards are never reduced.
	}

	RarityTextEffects: {
		Label: Efeitos de Nome por Raridade
		Tooltip: Efeitos animados no nome dos itens das raridades deste mod (Lapis, Jade, Cobre, Dourado, Prata Estelar e as quatro Lendas). Quando desativado, os nomes sao desenhados em cor simples.
	}

	CalamityRarityTextFix: {
		Label: Calamity: Corrigir tela preta causada pelos efeitos de texto do nome
		Tooltip:
			'''
			As raridades Burnished Auric / Exotic Rainbow e as tags [ceffect] do Calamity trocam o render target enquanto uma dica e desenhada,
			o que descarta o back buffer e deixa o quadro inteiro preto. Quando ativado, os efeitos sao redesenhados sem render targets,
			o que tambem corrige o desalinhamento com escala de interface diferente de 100% e reduz o custo por quadro.
			'''
	}

	CalamityHolyBurnOrbFix: {
		Label: Calamity: Corrigir travamento na luta contra os Guardioes Profanos / Providence
		Tooltip:
			'''
			O desenhador de rastros dos orbes sagrados do Calamity guarda referencias de projeteis e continua a desenha-los pelo tipo original
			depois que o slot foi reutilizado por outro projetil, causando uma NullReferenceException (comum no multijogador).
			Quando ativado, as referencias obsoletas sao removidas logo antes do desenho.
			'''
	}
}
