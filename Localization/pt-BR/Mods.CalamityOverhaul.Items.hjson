DeploySignaltower: {
	DisplayName: Torre de Entrelacamento Quantico
	Tooltip:
		'''
		Um importante dispositivo de comunicacao que atua como um farol no sub-espaco
		"Uma crianca selvagem ergue uma tocha na floresta, gritando Estou aqui"
		'''
}

StarflowPlatedBlock: {
	DisplayName: Bloco Revestido de Fluxo Estelar
	Tooltip:
