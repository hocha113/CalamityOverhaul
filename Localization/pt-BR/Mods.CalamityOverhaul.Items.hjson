NeutronGun: {
	DisplayName: Cacador Estelar
	Tooltip:
		'''
		Dispara projeteis gravitacionais que criam pontos de dobra ao atingir um alvo
		Clique direito alterna para modo sniper, disparando balas gravitacionais mais poderosas que invocam raios gama no impacto
		Cada tiro carrega a arma; totalmente carregada, o proximo disparo causa uma explosao de estrela de neutrons no cursor
		"Atire o sol para baixo!"
		'''
}

NeutronWand: {
	DisplayName: Luz da Tumba Estelar
	Tooltip:
		'''
		Dispara quatro estrelas gravitacionais poderosas
		Clique direito lanca magia gravitacional no cursor
		"Diz a lenda que, na antiguidade, um poderoso psiquico usou este cajado para comprimir estrelas em buracos negros,
		mas isso ja nao pode ser comprovado — resta apenas um fragmento de canto dos nomades interestelares"
		'''
}

FadingGlory: {
	DisplayName: Gloria Desvanecente
	Tooltip:
		'''
		Ataques corpo a corpo verdadeiros curam o jogador se o alvo for organico; se for inorganico, liberam muitas faiscas
		Fora de corpo a corpo verdadeiro, dispara laminas ativamente; ao acertar, gera um corte fantasma perseguidor extra e libera um tentaculo de sangue na explosao
		'''
}

NeutronScythe: {
	DisplayName: Mensageiro do Buraco Negro
	Tooltip:
		'''
		Foices de neutrons giram em alta velocidade, disparando raios gama contra inimigos proximos e deixando pontos de detonacao de dobra ao longo da trajetoria
		Clique direito libera uma erupcao de buraco negro, arremessando treze foices em um circulo completo
		'''
}

RebelBlade: {
