	Tooltip:
		'''
		Disparo continuo faz o cano superaquecer
		Converte balas de mosquete em balas perfurantes de armadura
		'''
}

DragonsWord: {
	DisplayName: Palavra do Dragao
	Tooltip:
		'''
		Dispara lagrimas de dragao que giram por um tempo antes de rastrear inimigos
		Clique direito lanca Magia de Comando do Dragao no cursor, emitindo ordem de morte aos inimigos na area
		"Um dragao so pode derramar lagrimas uma vez na vida"
		'''
}

SnowQuayMK2: {
	DisplayName: Naja da Neve MK2
