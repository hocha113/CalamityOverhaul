MiningMachine: {
	DisplayName: Maquina de Mineracao
	Tooltip:
		'''
		Perfura minerais consumindo energia eletrica
		Precisa ser colocada em um local apropriado para funcionar corretamente
		Minerais especiais podem ser extraidos em ambientes especiais
		'''
	DontWork: Precisa ser colocada em uma superficie dura para realizar operacoes de mineracao.
}

Collector: {
	DisplayName: Coletor
	Tooltip:
		'''
		Coleta automaticamente os objetos caidos ao redor e os coloca na caixa mais proxima
		Nao funcionara se nao houver caixas por perto
		'''
	Text1: Quantidade Excessiva!
	Text2: Nao ha caixas por perto!
	Text3: Falta de Eletricidade!
}

WGGCollector: {
	DisplayName: Sucateiro
	Tooltip:
		'''
		E apaixonado por reciclagem — incluindo voce.
		Para ele, nao ha diferenca real entre uma garrafa plastica e sua medula espinhal.
		'''
}

