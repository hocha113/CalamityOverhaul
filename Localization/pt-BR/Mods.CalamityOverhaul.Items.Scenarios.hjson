ScapegoatDoll: {
	DisplayName: Boneca substituta
	Tooltip:
		'''
		No inventário, pode bloquear uma morte no seu lugar
		Depois de bloquear, a boneca se parte e some
		'''
	ShatterText: A boneca substituta se partiu
}

ConstructionBlueprintQET: {
	DisplayName: Planta de Construcao (Torre de Entrelacamento Quantico)
	Tooltip:
		'''
		Use para aprender a fabricar o [i:CalamityOverhaul/CQETConstructor] Auto-Construtor
		"Suas maos forjarão a pedra angular e a torre que conectam dois mundos"
		'''
	L1: Aprendeu a fabricar o Auto-Construtor (Torre de Entrelacamento Quantico)!
	L2: Voce ja aprendeu esta planta!
}

CQETConstructor: {
	DisplayName: Auto-Construtor (Torre de Entrelacamento Quantico)
	Tooltip:
		'''
		Coloque para construir uma Torre de Entrelacamento Quantico
		Requer uma grande quantidade de [i:CalamityOverhaul/StarflowPlatedBlock] Blocos Revestidos de Fluxo Estelar
		'''
	UseConstructionBlueprint: Aprenda a Planta de Construcao (Torre de Entrelacamento Quantico)
}

DeploySignaltower: {
	DisplayName: Torre de Entrelacamento Quantico
	Tooltip:
		'''
		Um importante dispositivo de comunicacao que atua como um farol no sub-espaco
		"Uma crianca selvagem ergue uma tocha na floresta, gritando Estou aqui"
		'''
}

PQCD: {
	DisplayName: Comunicador Quantico Portatil
	Tooltip:
		'''
		Use para contatar Draedon e abrir a interface de compras holografica do Arsenal de Draedon
		"Teoricamente capaz de emitir uma Ordem de Exterminio, mas a autorizacao parece insuficiente"
		'''
	NeedSignalTowersText: Link de entrelacamento quantico incompleto! Requer todas as {0} Torres de Sinal implantadas.
	SignalTowerProgressText: Progresso da Implantacao da Torre de Sinal: {0}/{1}
}

Oceanfragments: {
	DisplayName: Fragmentos do Oceano
	Tooltip: Um adereco misterioso. O Velho Duque pode estar interessado nele.
}

OceanRaiders: {
	WorkingText: Trabalhando...
	NoWaterText: Deve ser colocado acima da agua para operar!
	NoEnergyText: Energia Insuficiente!
	DisplayName: Devorador do Oceano
	Tooltip:
		'''
		Consome energia para extrair recursos de corpos d'agua
		Clique direito para abrir o armazenamento interno
		'''
}

OldDuchest: {
	StorageText: Bau de Armazenamento Grande
	DisplayName: Velho Duque Bau
	Tooltip:
		'''
		Um bau de armazenamento com imensa capacidade
		"O antigo bau do Velho Duque. Se ele estiver por perto, pode jogar algumas coisas dentro."
		'''
}

MermanRod: {
	Text1: Um Poleiro do Sereiano ja foi colocado no mundo!
	DisplayName: Poleiro do Sereiano
	Tooltip:
		'''
		Aumenta o poder de pesca em 20 ao pescar nas proximidades
		O Velho Duque moverah seu acampamento para ca
		'''
}

Mewtwo: {
	DisplayName: Chip Mewtwo
	Tooltip: Usar para entrar em Mewtwo
}

