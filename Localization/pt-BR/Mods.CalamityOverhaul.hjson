	}
}

QuickHack: {
	SynapseBurn: {
		DisplayName: Queima de Sinapses
		Description: Sobrecarrega as sinapses neurais do alvo, causando dano termico continuo.
	}

	ShortCircuit: {
		DisplayName: Curto-Circuito
		Description: Libera um EMP causando dano instantaneo e paralisia breve.
	}

	Cyberpsychosis: {
		DisplayName: Ciberpsicose
		Description: Leva o alvo a uma fúria, atacando todas as unidades proximas.
	}

	SystemReset: {
		DisplayName: Reinicializacao do Sistema
		Description: Forca uma reinicializacao do sistema no alvo, paralisando-o completamente.
	}

	OpticOverload: {
		DisplayName: Sobrecarga Otica
		Description: Cega o alvo, tornando-o incapaz de perceber seu entorno.
	}

	MemoryWipe: {
		DisplayName: Limpeza de Memoria
		Description: Limpa os dados de hostilidade do alvo, reiniciando sua lista de agressao.
	}

	Contagion: {
		DisplayName: Contagio
		Description: Implanta um malware auto-replicante que se espalha para alvos proximos.
	}

	TileDetonate: {
		DisplayName: Detonacao de Bloco
		Description: Compromete a integridade estrutural, desencadeando uma explosao localizada.
	}

	TilePhase: {
		DisplayName: Protocolo de Fase
		Description: Altera as propriedades fisicas de um bloco, tornando-o intangivel por uma duracao.
	}

	TileMagPull: {
		DisplayName: Puxao Magnetico
		Description: Gera um campo magnetico, puxando itens dropados proximos em sua direcao.
	}

	MachineShortCircuit: {
		DisplayName: Curto-Circuito de Maquina
		Description: Drena a energia da maquina alvo, liberando arcos eletricos que danificam entidades proximas.
	}

	TurretHijack: {
		DisplayName: Sequestro de Torre
		Description: Interfere no modulo de reconhecimento IFF, invertendo temporariamente a identificacao de amigo ou inimigo da torre.
	}

	FalseMemory: {
		DisplayName: Falsa Memoria
		Description: Implanta memorias falsas, causando uma breve interrupcao na perseguicao ou suprimindo seu padrao de matanca.
	}

	SelfDismember: {
		DisplayName: Autodesmembramento
		Description: Forca a entidade paranormal a se desmembrar.
	}

	SystemHalt: {
		DisplayName: Parada do Sistema
		Description: Faz o alvo ficar brevemente em silencio e cessar todas as atividades.
	}

	TurretCircuitOverload: {
		DisplayName: Sobrecarga de Circuito
		Description: Injeta corrente reversa no circuito de energia da torre, desabilitando-a completamente por uma longa duracao.
	}

	TurretShortCircuit: {
		DisplayName: Curto-Circuito de Torre
		Description: Descarrega instantaneamente a energia da torre para engatilha-la brevemente, voltando a ficar online imediatamente apos a recuperacao.
	}

	VirusBroadcast: {
		DisplayName: Transmissao de Virus
		Description: Injeta codigo de worm na torre de sinal, fazendo-a emitir ondas eletromagneticas ciberneticas que causam curto-circuito em todas as torres dentro do alcance de transmissao por uma longa duracao.
	}

	MeltdownProtocol: {
		// DisplayName: Meltdown Protocol
		// Description: Locks the target's heat sinks shut; four seconds later it cooks off, catching nearby enemies.
	}

	ProjectileHijack: {
		// DisplayName: Ballistic Takeover
		// Description: Reassigns an incoming projectile and sends it back the way it came.
	}

	ProjectileFreeze: {
		// DisplayName: Ballistic Freeze
		// Description: Pins a projectile in midair for five seconds, then lets it go.
	}

	DataPurge: {
		// DisplayName: Data Purge
		// Description: Erases an incoming projectile and every nearby one of the same type.
	}

	BallisticOverclock: {
		// DisplayName: Ballistic Overclock
		// Description: Adds damage, pierce and flight time to one of your own projectiles.
	}

	Electrolysis: {
		// DisplayName: Electrolysis
		// Description: Runs current through the liquid; enemies soaking in it take damage over time.
	}

	Cryostasis: {
		// DisplayName: Cryostasis
		// Description: Freezes a patch of liquid into ice you can stand on for eight seconds.
	}

	LiquidPurge: {
		// DisplayName: Liquid Purge
		// Description: Drains the surrounding liquid. Works on lava too.
	}

	ItemRecall: {
		// DisplayName: Remote Recall
		// Description: Yanks a dropped item to your feet.
	}

	Reappraise: {
		// DisplayName: Reappraise
		// Description: Rerolls the prefix on that piece of gear on the ground.
	}

	ArmorParse: {
		// DisplayName: Armor Parse
		// Description: Drops the target's defense to zero for six seconds.
	}

	Exorcise: {
		// DisplayName: Forced Deletion
		// Description: Marks the target for deletion; the fifth hit it takes triggers a heavy strike.
	}

	DataLeech: {
		// DisplayName: Data Leech
		// Description: While active, hitting this target restores your RAM, up to a total cap.
	}

	SwarmLink: {
		// DisplayName: Swarm Link
		// Description: Hitting the target also deals thirty percent to up to five nearby enemies.
	}

	MachineOverclock: {
		// DisplayName: Machine Overclock
		// Description: Feeds the machine a fixed charge allowance for ten seconds, then burns it to nothing.
	}

	GridBlackout: {
		// DisplayName: Grid Blackout
		// Description: Uses the signal tower to cut power to every machine in a wide radius.
	}

	PowerTransmute: {
		// DisplayName: Power Transmute
		// Description: Convert your held item's stored charge into RAM, then drain it empty
	}

	NeuralOverclock: {
		// DisplayName: Neural Overclock
		// Description: Strike faster for eight seconds; RAM recovery halts and your health burns
	}

	WraithForceDrive: {
		// DisplayName: Wraith Force Drive
		// Description: Wraith acts cost nothing for ten seconds; then erosion deepens and it sleeps
	}

	IndexPreread: {
		// DisplayName: Index Preread
		// Description: Reads a container's full inventory without opening it, flagging the most valuable entry
	}

	LockBurn: {
		// DisplayName: Lock Burnthrough
		// Description: Opens this locked container without a key, at the cost of burning one item inside
	}

	DielSkip: {
		// DisplayName: Diel Skip
		// Description: Fast-forwards time to the nearest sunrise or sunset
	}

	StormInject: {
		// DisplayName: Storm Injection
		// Description: Summons a thunderstorm; bolts only strike enemies carrying any hack effect
	}

	GravityInvert: {
		// DisplayName: Gravity Inversion
		// Description: Inverts gravity around you; enemies and dropped items fall upward
	}

	SegmentDelink: {
		// DisplayName: Segment Delink
		// Description: Damage to this segment is only logged; 60% settles on the anchor at expiry
	}

	LimbSeizure: {
		// DisplayName: Limb Seizure
		// Description: Turns this limb against its own anchor for eight seconds
	}

	CommandLinkCut: {
		// DisplayName: Command Link Cut
		// Description: Severs its link to its partners; they fight alone for ten seconds
	}

	MunitionSwap: {
		// DisplayName: Munition Swap
		// Description: The turret fires ammo from your inventory, dealing your damage
	}

	TurretMesh: {
		// DisplayName: Turret Mesh
		// Description: Links nearby turrets into one volley at your cursor, forty shots total
	}

	BeaconForge: {
		// DisplayName: Beacon Forge
		// Description: The tower fakes a distress call, luring enemies from a wide area
	}

	PrivilegeEscalate: {
		// DisplayName: Privilege Escalation
		// Description: Protocols cost less, upload faster, ignore range; RAM stops recovering
	}

	ItemSalvage: {
		// DisplayName: Salvage
		// Description: Breaks this drop back into about 60% of its materials
	}

	DataBrand: {
		// DisplayName: Data Brand
		// Description: Copy this gear's modifier, then stamp it onto the next target
		// HudTag: Brand: {0}
		// DenyNoPrefix: Nothing on this item to copy
		// DenyIncompatible: The recorded modifier does not fit this item
	}

	EntityMasquerade: {
		// DisplayName: Masquerade
		// Description: Enemies read this drop as you; it draws their fire for thirty seconds
	}

	TileConscript: {
		// DisplayName: Tile Conscription
		// Description: Tears nearby blocks into eight armor plates orbiting you, launched when time is up
	}

	VeinResonance: {
		// DisplayName: Vein Resonance
		// Description: Reveals matching ore through walls; mining it drops double but calls wardens
	}

	StressInvert: {
		// DisplayName: Stress Inversion
		// Description: Makes this terrain unbreakable for ten seconds; enemies slamming into it take damage
	}

	PressureSurge: {
		// DisplayName: Pressure Surge
		// Description: Pressurizes this liquid; anything soaked in it is launched skyward
	}

	MirrorSurface: {
		// DisplayName: Mirror Surface
		// Description: The surface turns to a mirror; enemy shots crossing it are copied to your side
	}

	DelayFuse: {
		// DisplayName: Delay Fuse
		// Description: This projectile stops expiring and hovers in place for thirty seconds as a mine
	}

	ProjectileTithe: {
		// DisplayName: Projectile Tithe
		// Description: This shot swallows nearby enemy fire, then detonates by how much it ate
	}

	ProjectileSample: {
		// DisplayName: Projectile Sample
		// Description: Samples this shot; for twenty seconds every twelfth shot of yours echoes it
	}

	CompensationProtocol: {
		// DisplayName: Compensation Protocol
		// Description: Advance 10% of the target's life; kill it within eight seconds or pay the debt yourself
	}

	PayloadRewrite: {
		// DisplayName: Payload Rewrite
		// Description: For ten seconds the target's projectiles become yours, dealt at your damage
	}

	PhaseDesync: {
		// DisplayName: Phase Desync
		// Description: Splits the target's body from its hitbox; both sides become harder to hit
	}

	LiveCellTap: {
		// DisplayName: Live Cell Tap
		// Description: Pins the target immobile and immune, converting its life into your RAM
	}

	FirmwareRollback: {
		// DisplayName: Firmware Rollback
		// Description: Rolls the target back to its previous phase; it runs berserk for five seconds after
	}

	ShellRequisition: {
		// DisplayName: Shell Requisition
		// Description: Targets killed while marked rise again and fight for you for fifteen seconds
	}

	PositionCast: {
		// DisplayName: Position Cast
		// Description: Their position is visible to your whole team through walls for fifteen seconds
	}

	GaugePollution: {
		// DisplayName: Gauge Pollution
		// Description: Corrupt their interface; health and ammo readouts scramble for eight seconds
	}

	LinkTraceback: {
		// DisplayName: Link Traceback
		// Description: Sever every upload aimed at you, scorch the senders and mark them
	}

	ForceUninstall: {
		// DisplayName: Force Uninstall
		// Description: Rip one hostile protocol off yourself; can't rip again for half a minute
	}

	MemoryScorch: {
		// DisplayName: Memory Scorch
		// Description: Burns three of their RAM on landing; their recovery stays at zero for ten seconds
		// SealTag: RAM SEALED
	}

	BuffSiphon: {
		// DisplayName: Buff Siphon
		// Description: Steals their longest-lasting buff for yourself, up to thirty seconds
	}

	CombatSiphon: {
		// DisplayName: Combat Siphon
		// Description: For ten seconds the damage you deal them converts into your RAM
	}

	BallisticTurncoat: {
		// DisplayName: Ballistic Turncoat
		// Description: Their next three shots turn around mid-flight and hunt their owner; holding fire keeps them safe
		// HijackCounter: HIJACKED {0}/{1}
		// DeathReason: "{0}'s shot was turned by {1} and came home."
	}

	MeltdownBrand: {
		// DisplayName: Meltdown Brand
		// Description: Plants a visible four-second fuse that detonates for eighty damage; uninstalling it defuses the charge
		// FuseTag: MELTDOWN {0}s
		// DeathReason: "{0} was blown apart by the meltdown brand {1} planted."
	}

	MapBlackout: {
		// DisplayName: Map Blackout
		// Description: Buries their map under static for fifteen seconds, pins and team markers included
	}

	ChannelScramble: {
		// DisplayName: Channel Scramble
		// Description: Garbles their chat for twenty seconds and wipes teammate nameplates off their screen
	}

	StealthStrip: {
		// DisplayName: Stealth Strip
		// Description: Strips all their invisibility and stealth for ten seconds; their outline glows for everyone
	}

	CooldownInject: {
		// DisplayName: Cooldown Inject
		// Description: Slows their item use by 35% for six seconds; a ticking potion cooldown gains five more
	}

	CyberwareOffline: {
		// DisplayName: Cyberware Offline
		// Description: Knocks all their cyberware offline for eight seconds
	}
}

