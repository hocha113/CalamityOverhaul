	}

	KikasaPanoramaUI: {
		// Title: Lakeheart
		// HoundTitle: Hound · Ghost Dream
		// WispTitle: Gold Flame · Ghost Fire
		// ReflectAwake: The reflection is awake
		// ReflectAsleep: The reflection is still asleep
		// InDreamLine: You are in the Ghost Dream
		// DreamReturnFormat: Press {0} again to return
		// DreamEnterKeyFormat: "[Hold {0}] Enter the Ghost Dream"
		// DreamEnterClick: "[Click] Enter the Ghost Dream"
		// NeedDomainFormat: Press {0} to open the Blood Lake
		// NeedFullWater: The lake isn't full yet
		// HoundBonusFormat: Hound cap {0} · damage {1}%
		// WispBurning: Burning, scorching along the shore
		// WispIdle: Unlit; the flame waits on your word
		// WispBoil: Still burning in the rain
		// WispQuenchedLine: Being put out by Ghost Rain
		// WispBonusFormat: Burn {0}s · flame reach {1}
		// WispIgniteClick: "[Click] Light the flame"
		// WispSnuffClick: "[Click] Draw the fire back"
		// EdgeDreamFire: Dreamfire
		// EdgeBoilRain: Boiling Rain
		// EdgeRainNightmare: Rain-Nightmare
		// EdgeTriSeal: Three-Shade Seal
		// SeatsTitle: Three Seats
