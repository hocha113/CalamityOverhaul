NeutronWand: {
	DisplayName: Luz da Tumba Estelar
	Tooltip:
		'''
		Dispara quatro estrelas gravitacionais poderosas
		Clique direito lanca magia gravitacional no cursor
		"Diz a lenda que, na antiguidade, um poderoso psiquico usou este cajado para comprimir estrelas em buracos negros,
		mas isso ja nao pode ser comprovado — resta apenas um fragmento de canto dos nomades interestelares"
		'''
}

DragonsWord: {
	DisplayName: Palavra do Dragao
	Tooltip:
		'''
		Dispara lagrimas de dragao que giram por um tempo antes de rastrear inimigos
		Clique direito lanca Magia de Comando do Dragao no cursor, emitindo ordem de morte aos inimigos na area
		"Um dragao so pode derramar lagrimas uma vez na vida"
		'''
}

UnderTheSand: {
	DisplayName: Sob a Areia
	Tooltip:
		'''
		Lanca um par de ondas de areia que caem sob a gravidade
		Ao tocar o chao, um espinho de areia irrompe de baixo, arremessando inimigos para cima
		'''
}

MelodyTheSand: {
	DisplayName: Melodia da Areia
	Tooltip:
		'''
		Dispara um pequeno tornado de areia que cai ao chao pela gravidade
		Ao pousar, patrulha a superficie de um lado para o outro, invertendo ao bater em paredes ou bordas
		Arremessa repetidamente os inimigos atingidos para o ceu
		'''
}

SandVortexOfTheDecayedSea: {
	DisplayName: Vortice de Areia do Mar Decaido
	Tooltip:
		'''
		Invoca um vórtice colossal do mar decaído na posição do cursor
		O vórtice puxa e dilacera inimigos próximos, até desfazendo projéteis hostis
		Periodicamente arremessa orbes rastreadoras do mar decaído
		Disparar novamente renova o vórtice existente; ao se dissipar, libera um anel de orbes
		"O rugido das profundezas podres, agitado em areia"
		'''
}

FocusingGrimoire: {
	DisplayName: Grimorio de Foco
	Tooltip:
		'''
		Clique esquerdo para disparar aneis termicos homing
		Clique direito para disparar raios da morte rapidamente
		"Melhor do que seis livros combinados"
		'''
}

CommandersStaff: {
	DisplayName: Cajado do Comandante
	Tooltip:
		'''
		Dispara um raio de desintegracao termica que perfura inimigos
		"Peguei daquele braço da maquina, que tal usar energia psiquica em vez de diesel?"
		'''
}

Eyetooth: {
	// DisplayName: Eyetooth
	/* Tooltip:
		'''
		Hurls a fang torn from the Eye of Cthulhu at your foes
		On biting an enemy, the fang springs above its head, takes aim, then dives in for a second bite
		The dive deals 150% damage, and fang wounds keep weeping blood
		''' */
}

CommandersStaffEX: {
	DisplayName: Cajado do Comandante EX
	Tooltip:
		'''
		Dispara multiplos raios termicos de dispersao
		"Adequado para cortar metal"
		'''
}

TomeofFungalDecay: {
	DisplayName: Tomo da Decomposicao Fungica
	Tooltip: Pulveriza um anel de rajadas de esporos
}

Pandemonium: {
	DisplayName: Pandemonio
	Tooltip:
		'''
		Clique esquerdo para carregar e liberar Magia Transcendente
		Clique direito para lancar uma Runa de Enxofre no cursor
		Ao empunhar, dois botoes de habilidade acendem no canto inferior esquerdo da tela
		Clique para desencadear Julgamento de Enxofre ou O Fim de Todos os Demonios
		'''
	SkillLeftName: Julgamento de Enxofre
	SkillLeftDesc: Faz cair um campo de pilares de fogo de enxofre ao redor do cursor
	SkillRightName: O Fim de Todos os Demonios
	SkillRightDesc: Abre um circulo magico gigante centrado em voce, castigando os inimigos com raios e fogo
}

