AriaofTheCosmos: {
	DisplayName: Aria do Cosmos
	Tooltip:
		'''
		Segure o botao esquerdo para carregar um poderoso quasar, causando dano devastador ao soltar
		Clique direito para liberar um buraco negro em miniatura que dispara uma saraivada de raios gama uma vez formado
		Ao empunhar, dois botoes de habilidade acendem no canto inferior esquerdo da tela
		Clique para invocar um Guardiao do Anel Estelar ou gerar uma Explosao de Raio Gama
		'''
	SkillLeftName: Guardiao do Anel Estelar
	SkillLeftDesc: Invoca um anel estelar orbital cujos nos disparam poeira estelar nos inimigos proximos
	SkillRightName: Explosao de Raio Gama
	SkillRightDesc: Apos uma breve carga, dispara nove raios gama em leque na direcao do cursor
}

WheezingWyrm: {
	// DisplayName: Wheezing Wyrm
