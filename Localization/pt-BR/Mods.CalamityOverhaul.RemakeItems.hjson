ModifyChargingStationItem: {
	DisplayName: Estacao de Recarga
	Tooltip:
		'''
		Usa eletricidade para carregar dispositivos eletricos
		Baterias podem ser colocadas dentro para receber carga eletrica
		Pode ser conectada a dutos para transmissao de energia
		Clique direito no bloco enquanto segura um item recarregavel para inseri-lo rapidamente
		Shift + Clique direito para recuperar itens
		'''
}

DyeVatItem: {
	DisplayName: "{$ItemName.DyeVat}"
	Tooltip:
		'''
		Usado para fabricar tinturas
		Clique direito após colocar para abrir o painel de controle, permitindo que você tinga itens
		Coloque um Balde d'Agua no slot de tintura para lavar tinturas dos itens
		'''
}

RDemonConch: {
	DisplayName: Concha Demoníaca
	Tooltip:
		'''
		Escute com atenção e você ouvirá gritos
		"Cuidado."
		'''
}

