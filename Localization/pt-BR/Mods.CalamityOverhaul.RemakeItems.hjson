HalibutOverride: {
	DisplayName: Halibut
	Tooltip:
		'''
		Converte balas de mosquete em um fluxo de Corrente Oceanica
		[Lang4]
		texto_lenda
		'''
}

MurasamaOverride: {
	DisplayName: Murasama
	Tooltip:
		'''
		Clique direito para mirar e carregar a energia da espada.
		Quando um alvo e atingido com um ataque corpo a corpo verdadeiro usando o clique esquerdo, a energia da espada sera carregada.
		Se houver inimigos poderosos por perto, a energia da espada carregara lentamente por conta propria.
		Quando a energia da espada estiver totalmente carregada, pressione [KEY1] para liberar a lamina.
		Durante o voo da lamina, pressione o clique esquerdo para realizar um Corte Ascendente. [Lang1]
		Acertar um inimigo com o Corte Ascendente carregara a Arma 1.
		Pressione [KEY2] para consumir 1 ponto de carga da arma e realizar um golpe descendente. [Lang2]
		Quando a carga da arma atingir o valor maximo de 10 pontos,
		acertar um inimigo com o Corte Ascendente novamente desencadeara um golpe final. [Lang3]
		[c/ff4500:"Seria melhor se isso fosse uma espada motosserra"]
		[Lang4]
		texto_lenda
		'''
}

SHPCOverride: {
	DisplayName: SHPC
	Tooltip:
		'''
		Clique esquerdo para disparar tres feixes de laser
		Clique direito e segure para carregar energia
		Todos os ataques podem ser melhorados pelo campo
		[Lang4]
		texto_lenda
		'''
}

ModifyChargingStationItem: {
	DisplayName: Estacao de Recarga
	Tooltip:
		'''
		Usa eletricidade para carregar dispositivos eletricos
		Baterias podem ser colocadas dentro para armazenar eletricidade
		Pode ser conectada a dutos para transmissao de energia
		Clique direito no bloco enquanto segura um item recarregavel para inseri-lo rapidamente
		Shift + Clique direito para recuperar itens
		'''
}

DyeVatItem: {
	DisplayName: "{$ItemName.DyeVat}"
	Tooltip:
		'''
		Usado para fabricar tinturas
		Clique direito apos colocar para abrir o painel de controle, permitindo que voce tinge itens
		Coloque um Balde d'Agua no slot de tintura para lavar tinturas dos itens
		'''
}
