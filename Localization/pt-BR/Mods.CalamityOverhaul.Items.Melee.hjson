DivineSourceBlade: {
	DisplayName: Lamina Aniquiladora da Fonte Divina
	Tooltip:
		'''
		Encadeia dois golpes rapidos em um corte pesado carregado
		O corte pesado libera uma colossal meia-lua dourada de energia de espada
		"A vida nunca cessa"
		'''
}

CursedflameBloodfist: {
