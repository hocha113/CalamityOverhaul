OnikiriOverride: {
	DisplayName: 鬼切
	Tooltip:
		'''
		按住左键驱动绯红裂空斩五段连段
		右键消耗气力施展神威疾走，无敌帧穿过敌人视作格挡，为架势蓄势
		[KEY] 处决：架势蓄满斩出终结乱舞，过半则为灭世一闪
		[Lang4]
		legend_Text
		'''
}

OnikiriTrialQuestLine: {
	QuestCategory: 鬼切·试刃
	TrackerWaiting: 它还不在，等等，或我们去请
	TrackerFighting: "{0}: {1:0%}"
	TrackerBrief: 下一刀：{0}
	BossRushTargetName: 散不掉的夜
	EventActiveFormat: "{0}: 进行中"
	Trial_0: 天上那档子
	Trial_1: 土里两股劲
	Trial_2: 抱成一坨的
	Trial_3: 听说是神
	Trial_4: 堵路的那档
	Trial_5: 硫海那股味
	Trial_6: 火坑还亮着
	Trial_7: 名字很大的
	Trial_8: 成对的两点
	Trial_9: 新旧搅一起
	Trial_10: 走路太像的
	Trial_11: 底下那朵
	Trial_12: 石屋那尊
	Trial_13: 门口念叨的
	Trial_14: 上面压着的
	Trial_15: 地心发热
	Trial_16: 潮里一团
	Trial_17: 空得慌那边
	Trial_18: 还在的龙
	Trial_19: 轰耳朵那边
	Trial_20: 空气发沉那边
	Trial_21: 又聚回来的
	TrialSummary_0:
		'''
		天上有档子事，我也说不准是什么
		就觉得一直被盯着，刀里也跟着发躁
		你去看看，回来告诉我，到底是什么玩意
		哦对了，别仰头仰太久，脖子会酸
		'''
	TrialSummary_1:
		'''
		腐土那边两股不对劲，我分不清
		哪样先冒头你砍哪样，别两个一起盯
		刀会告诉你味不对，你先走
		'''
	TrialSummary_2:
		'''
		那边秽气抱成一坨，光闻风向就腻烦
		别在边上发呆，过去处理掉
		回来先搞定比什么都要紧
		'''
	TrialSummary_3:
		'''
		听说有摊东西自称神，我听着就想笑
		名字要是这么好取，谁还用上进啊
		我们去核实，要是真敢这么叫，就把它拆了
		哎，不是让你去拜，听清楚
		'''
	TrialSummary_4:
		'''
		前面像堵死了，我也说不上堵的是什么
		路不通就开路
		过去以后什么感觉，回来再聊
		'''
	TrialSummary_5:
		'''
		硫海那边味就不对，有东西在翻
		别让它靠岸，你去拦一拦
		回来刀要是一股味，那颗太混蛋了
		'''
	TrialSummary_6:
		'''
		火坑那边还亮着，像有人不肯熄
		你去弄灭，顺路看着点脚底下
		烫着了我可没法给你吹
		'''
	TrialSummary_7:
		'''
		有个名字叫得很响的家伙，听着唬人
		铁里有动静，你去碰碰看，是不是虚张声势
		别跟它比谁名字大
		'''
	TrialSummary_8:
		'''
		天上两点，像约好了一起出来
		成对出现的话，你分开应付，别两头挨瞪
		回来再吐槽它们长得像不像人
		'''
	TrialSummary_9:
		'''
		那边新旧搅一块，看着就违和，可我还没看清
		你去分分清楚，别被唬住
		回来再说它到底哪边是真的
		'''
	TrialSummary_10:
		'''
		有个影走路太像人了，我还没看清脸就先膈应
		别愣着对视，过去处理
		学谁的，回来再说
		'''
	TrialSummary_11:
		'''
		底下有朵不该开的，味就不对
		败了就处理掉，别留着烦我
		卖花的规矩回头再说，你先去
		'''
	TrialSummary_12:
		'''
		石屋里有尊不爱动的，看着就硬
		弄倒就行，刀别拿去硬磕，磕了我也不舒服
		手要是麻了回来揉揉
		'''
	TrialSummary_13:
		'''
		地牢门口有人念叨，像还没念完
		打断就行，省得耳朵跟着累
		念什么回来再说，反正别信
		'''
	TrialSummary_14:
		'''
		月亮上面像压着什么，仰头就沉
		你去弄掉，别在那儿光愣着仰
		回来我再问你累不累
		'''
	TrialSummary_15:
		'''
		地心那边发热，我这边也预热了似的
		你去，刃会烫，提前心里有数
		别在热气里杵太久，办完就撤
		'''
	TrialSummary_16:
		'''
		潮气那边鬼打成一团，我懒得数
		整团处理，别一根根捡
		别在那儿过夜的话，回来我再念叨你
		'''
	TrialSummary_17:
		'''
		那个方向空得慌，我这边也发沉
		我也说不上来是什么，就是不对劲
		你去，去了别一个人愣着，看不清也先顾着自己
		回来再说，活着比看清重要
		'''
	TrialSummary_18:
		'''
		听说还剩这么一条龙，真假你去看
		刃大概会烫，别急着收回来
		战利品什么的我不要，我们人能回来就行
		'''
	TrialSummary_19:
		'''
		远处一轰，耳朵先不干了
		你去让它们停，顺路护好耳
		回来要是还嗡，再找安静地
		'''
	TrialSummary_20:
		'''
		那边空气发沉，发滞，像门没开透
		去终止，别在门口愣着吸那口气
		回来再跟你说怎么换气
		'''
	TrialSummary_21:
		'''
		它们又聚回来了，像怎么都散不净
		这场会偏长
		开打前先自己站稳，回来我再啰嗦
		'''
}
