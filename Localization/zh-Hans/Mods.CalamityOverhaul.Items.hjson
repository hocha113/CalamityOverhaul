		右键物块可以快速放入燃料，Shft右键取出
		'''
}

ThermalBattery: {
	DisplayName: 热能电池
	Tooltip: 存储一定的电能
}

WindGrivenGenerator: {
	DisplayName: 风力发电机
	Tooltip: 随风而动，生产电能
	UnderstandWindGriven: 需要对风力发电的工作原理有初步的了解
	UnderstandWindGriven2: 需要在小行星上采掘破旧的风力机来了解它们的制作原理
}

WindGrivenGeneratorMK2: {
	DisplayName: 风力发电机MK2
	Tooltip: 随风而动，生产电能
	UnderstandWindGrivenMK2: 需要对风力发电的工作原理有深入的了解
	UnderstandWindGrivenMK2Remind: 需要挖掘小行星上的巨型风力涡轮机来了解它们的制作原理
}

ThermalGeneratorMK2: {
	DisplayName: 火力发电机MK2
	Tooltip:
		'''
		放入燃料进行发电
		右键物块可以快速放入燃料，Shft右键取出
		'''
}

WGGMK2Wilderness: {
	DisplayName: 荒野中的巨型风力发电机
	Tooltip: ""
}

WGGWilderness: {
	DisplayName: 荒野中的风力发电机
	Tooltip: ""
}

TeslaElectromagneticTower: {
	DisplayName: 特斯拉电磁塔
	Tooltip:
		'''
		需要电能才能工作
		放置到地面后右键可以在攻击模式和护卫模式之间切换
		攻击模式会向附近的敌人发射电弧
		护卫模式会对范围内的所有敌人造成带电减益，如果玩家在范围内，
		并手持可充能物品，电磁塔将发射电弧为玩家远程充能
		"工程师请勿靠近"
		'''
}

EmblemOfDread: {
	DisplayName: 惧亡者之证
	Tooltip:
		'''
		增加100%近战伤害
		增加100%近战暴击率
		增加100%近战攻速
		增加100点防御值，无视全部防御衰减
		受到的伤害减少75%，并让攻击者受到100倍的反弹伤害
		所有近战攻击将对敌人造成虚空侵蚀减益
		如果敌人的血量低于25万，真近战攻击将有可能直接抹杀敌人
		高速移动时会在路径上留下数个翘曲点，对接触到的敌人造成极高伤害
		获得重力突刺的能力，按下[KEY]进行超长距离突刺，并释放出大量引力射线
		如果受到了致死攻击，将立刻回复满血量并给予你一个重力护盾，该效果具有60秒冷却
		敌人将更容易以你为目标
		[c/d94fff:"圣洁的天使覆上了你的双眸，呢喃着永恒的甜蜜谎言"]
		[c/ff4d4d:"浴血的屠夫执起了你的双刃，宣告着杀戮方能成就荣耀"]
		[c/4da6ff:"湛蓝的信鸽啄破了你的额心，讥笑着你那微不足道的挣扎"]
		'''
}

ElectricMinRocket: {
	DisplayName: 电动迷你火箭
	Tooltip:
		'''
		右键使用火箭，或者放置在地上右键点击即可启动飞行
		空中按左右方向键调整方向
		长按向下方向键缓降，飞行会缓慢消耗电力
		按下空格键可以中断飞行
		"苏联制造，坚固耐用，当年差点飞去月球"
		'''
}

UEPipeline: {
	DisplayName: 能量管道
