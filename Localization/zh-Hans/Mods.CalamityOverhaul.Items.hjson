}

ShimmerTransmuter: {
	DisplayName: 微光转化槽
	Tooltip:
		'''
		放入物品，消耗微光将它转化，产物落入输出槽
		每次转化消耗10UE和64单位微光，微光需用泵从微光湖经管道送入
		支持物品转化和去合成，硬币或会放出生物的物品不收
		输入输出槽可对接物品管道，自动进出料
		'''
}

WindGrivenGenerator: {
	DisplayName: 风力发电机
