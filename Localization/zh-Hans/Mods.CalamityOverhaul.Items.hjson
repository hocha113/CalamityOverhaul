		DisplayName: 魔法海螺
		Tooltip: 仔细听，你会听到海洋的声音
	}
}

GraniteTome: {
	DisplayName: 花岗岩魔典
	Tooltip:
		'''
		吟咏汇聚三颗充能光点，充满后扇形齐射三发轻追踪的花岗能量球
		能量球命中后碎裂为追击的水晶碎片
		'''
}

GraniteFlower: {
	DisplayName: 花岗之花
	Tooltip:
		'''
		掷出一枚水晶种子，落点绽放成驻场的能量花
		花体三次脉冲，朝最近的敌人迸射水晶花瓣
		凋谢时花瓣尽数碎裂，向四周迸溅晶屑
		'''
}

GraniteThrowingKnife: {
	DisplayName: 花岗飞刀
	Tooltip:
		'''
		掷出可穿透的飞刀，拖曳锐利的青蓝电弧
		命中敌人时，会向附近另一名敌人跳跃一道微型链电
		末段命中或撞击地形时碎裂为水晶碎片
		'''
}

GraniteWalkingBoots: {
	DisplayName: 花岗行走靴
	Tooltip:
		'''
		大幅提升跑速与加速度
		达到全速的瞬间靴底通电，迸发电弧
		全速奔跑时脚下走火，身后拖曳青蓝残影
		'''
}

MarbleClub: {
	DisplayName: 大理石巨棍
	Tooltip:
		'''
		缓慢而沉重的过顶猛砸，击退极强
		命中必定使敌人短暂石化，化石迟滞
		砸中地面会掀起全威力的大理石冲击波与奔涌尘浪
		凌空挥砸则只余减弱的空气震荡
		'''
}

MarbleHuntingKnife: {
	DisplayName: 大理石猎刀
	Tooltip:
		'''
		迅捷的交替连斩
		每第三击化为更宽的终结斩，小步突进并迸射大理石碎片
		'''
}

MarbleDisc: {
	DisplayName: 大理石飞盘
	Tooltip:
		'''
		掷出旋转的飞盘，在敌人与墙壁间弹射
		每弹射至一名新目标，飞盘愈发鎏金，伤害提升10%，至多30%
		弹射耗尽后回旋归手，最多可同时存在两枚
		'''
}

MarblePebble: {
	DisplayName: 大理石卵石
	Tooltip:
		'''
		可无限使用的迅捷投石，撞地后弹射一次
		对生命上限越高的敌人造成越高的额外伤害
		击中庞然大物时金光迸裂、声如碎岩
		'''
}

MarbleShield: {
	DisplayName: 大理石战盾
	Tooltip:
		'''
		近战击退提升
		三块环绕的大理石碎片组成石卫护盾，就绪时吸收一次伤害并碎裂
		按[KEY]举盾格挡：完美格挡免除伤害，粉碎近旁弹幕并反掷石刃
		完美格挡后5秒内近战伤害提升10%
		'''
}

MarbleBalloon: {
	DisplayName: 大理石气球
	Tooltip:
		'''
		空中按↓砸向地面，下坠蓄势越久，落地冲击波越强、范围越广
		免疫摔落伤害
		'''
}

MarbleinaBottle: {
	DisplayName: 瓶中大理石
	Tooltip: 额外赋予一段沉重而有力的二段跳，按住跳跃键可跃得更高
}

MarbleCloudBalloon: {
	DisplayName: 大理石云朵气球
	Tooltip:
		'''
		额外赋予一段沉重而有力的二段跳，按住跳跃键可跃得更高
		空中按↓砸向地面，下坠蓄势越久，落地冲击波越强、范围越广
		免疫摔落伤害
		'''
}

TestItem: {
	// DisplayName: Test Item
	// Tooltip: ""
}

WraithDebugTool: {
	DisplayName: 厉鬼调试器
	Tooltip:
		'''
		右键轮换模式，左键执行
		模式覆盖：显形 / 死机 / 据点 / 绑定 / 反噬 / 侵蚀 / 必死 / 闹鬼 / 读簿
		走不了权威通道的模式在多人下明示不受理
		厉鬼框架开发调试用
		'''
	HauntOn: 调试闹鬼已开启（试件临时上目录）
	HauntOff: 调试闹鬼已关闭（试件恢复隐藏）
	ModePrefix: 模式：{0}
	ModeMaterialize: 显形（左键在光标处显形试件）
	ModeHalt: 死机（左键点鬼逼入死机，再点解除）
	ModeSite: 据点（左键落锚，Shift+左键拔锚，Ctrl+左键开关武装闸）
	ModeBind: 绑定（左键低驾驭上簿，Shift+左键高驾驭+续契）
	ModeBacklash: 反噬（左键强制簿上试件挣脱，须躁动）
	ModeErosion: 侵蚀（左键+0.2，Shift+左键清零）
	ModeOmen: 必死（左键对自己起三息预警拍）
	ModeHaunt: 闹鬼（左键翻转环境自动闹鬼闸门）
	ModeRegister: 读簿（左键打印随身簿面进度）
	HaltNoTarget: 光标下没有鬼
	SitePlanted: 调试据点已落锚——走近它等它显形
	SiteCleared: 调试据点已拔锚
	SiteArmed: 据点武装闸已开——动态锚定与活化条件放行
	SiteDisarmed: 据点武装闸已关——它不会应门
	BindDone: 试件已上簿，驾驭度 {0}，续签 {1}
	BacklashNeedBound: 簿上没有试件——先用绑定模式请它上簿
	BacklashNeedRestless: 试件不躁动，挣不出来——先低驾驭上簿
	EncounterBusy: 遭遇进行中——同屏只容一鬼
	ErosionValue: 侵蚀 {0}
	OmenStarted: 三息之后，命数当尽
	MultiplayerDenied: 该调试操作多人下不受理
	RegisterHeader: —— 随身簿面 ——
	RegisterLine: "{0}：{1}，驾驭 {2}，续签 {3}，遭遇 {4}"
	RegisterEmpty: 随身没有载体
}

OniMeiRubbingHigekiri: {
	DisplayName: 髭切
	Tooltip: 残血终结增强，斩杀返势；面板伤害 -10%
	Origin: 试斩那夜首级落地，颔下须髯犹连刃上。旧名由此而来
	Power: 「断首」残心与灭世一闪对生命低于35%的目标追加随伤势递增的终结伤害（至多+50%，首领+25%）；以此二式了结目标时，每式返还10点架势
	Burden: 面板伤害 -10%。目标健壮时，这把刀比原铭更钝
}

OniMeiRubbingOnikiri: {
	DisplayName: 鬼切
	Tooltip: 原铭，维持原有刀性，无赋效亦无代价
	Origin: 一条戾桥，断腕的鬼没敢回来讨。此名自此钉在茎上
	Power: 原铭。维持这把刀现有的一切，不增一分，不减一毫
	Burden: 无
}

OniMeiRubbingShishinoko: {
	DisplayName: 狮子之子
	Tooltip: 完整五连第五拍合颚刃波；连段变慢 10%
	Origin: 夜半置于枕边，刀作狮吼。金字象嵌，以荣其名
	Power: 「狮势」不被疾走或特殊技打断地连续完成五段连斩，第五拍狮口合颚，追加两道交叉刃波（合计约四成一斩之力）
	Burden: 连段排拍间隔 +10%。吼声要蓄，刀就得慢
}

OniMeiRubbingTomokiri: {
	DisplayName: 友切
	Tooltip: 疾走取消留延迟斩影；承伤 +10%，积咎耗气
	Origin: 与友刀相试，误断其身。咎名入茎，刀性自此暴烈
	Power: 「咎影」以神威疾走取消连段时，原地留下一道约三成五之力的延迟斩影，滞拍后咬合
	Burden: 手持期间承受的伤害 +10%；每道斩影积一层「咎」（至多三层），每层令下次疾走多耗6点气力，残心命中后偿清
}

OniMeiRubbingKazehi: {
	DisplayName: 风樋
	Tooltip: 身法省气；墨痕伤害 -25%
	Origin: 樋开如风道，挥刀过处只闻风声，不见刀影
	Power: 「顺风」神威疾走气力消耗 -25%，樱流巡航耗气 -30%
	Burden: 疾走墨痕伤害 -25%。樋为轻身而开，不为杀伐
}

OniMeiRubbingChihi: {
	DisplayName: 血樋
	Tooltip: 命中回气增强；自然回气减半
	Origin: 此樋不为轻身，为放血。开锋人如是说
	Power: 「回流」连段每拍首次命中额外回气 +2，残心命中再回气 +8
	Burden: 自然回气减半，招式消耗后的回气延迟 +0.4秒。刀不沾血，气就不回
}

OniMeiRubbingFudo: {
	DisplayName: 不动
	Tooltip: 承诺动作中耗架势挡伤；架势获取 -20%
	Origin: 以梵字カーン笔意入雕，不动尊坐镇刃侧，背负火焰
	Power: 「不动护」连段重拍、残心或处决中受击时，消耗20点架势削减该击40%伤害并免除击退（冷却约2秒）；肢解的反噬不受庇护
	Burden: 常规架势获取 -20%。护身的力，从蓄势里扣
}

OniMeiRubbingKurikara: {
	DisplayName: 倶利伽罗
	Tooltip: 处决后点燃龙火连段；气力上限 -20
	Origin: 龙缠剑而欲吞之。刀身雕的古题，金鳞入缝
	Power: 「龙火回环」灭世一闪或终结乱舞之后点燃雕纹；十秒内完成一套五段连斩，第五拍释放一道约四成之力的龙火回环斩
	Burden: 气力上限 100 → 80。龙盘着的那截刀身，气走不通
}

OniMeiRubbingTessetsu: {
	DisplayName: 铁截
	Tooltip: 破甲一截；血肉钝
	Origin: 名唬人，刃却像一截铁。拆台的旧话钉进茎里
	Power: 「截金」对钢铁/装甲体的连段首击多一截破
	Burden: 砍血肉时更像钝铁。面板伤害 -12%
}

OniMeiRubbingKyushu: {
	DisplayName: 旧首
	Tooltip: 专收头；杂鱼一般
	Origin: 头还是旧的。断得干脆，不必换名吓唬谁
	Power: 「取首」对主体/头颅的残血终结更深
	Burden: 清杂鱼时赋效冷清，一般目标略钝
}

OniMeiRubbingIkiai: {
	DisplayName: 息合
	Tooltip: 第五拍甩弧剑气；连段略慢
	Origin: 对视那一瞬憋住的气，合拍落刃
	Power: 「吐息」完整五连第五拍沿瞄准甩出一道行进弧形剑气（绯红月牙，穿透每敌一次）
	Burden: 连段略慢
}

OniMeiRubbingKyoko: {
	DisplayName: 虚吼
	Tooltip: 空场威压；贴身失焦
	Origin: 吼进空里，回声找不到落点
	Power: 「空鸣」空场时周期吼出墨压涟漪，波及之敌脚下一滞；远离再近的一刀更重
	Burden: 贴身砍太密会失焦变钝
}

OniMeiRubbingKarikiri: {
	DisplayName: 假切
	Tooltip: 残影骗伤；真身更险
	Origin: 学得像，越像越假。残影入茎
	Power: 「假身」疾走起步留下残影，替真身吸收一次接触或一层弹伤
	Burden: 影在时真身更脆、疾走更费；影碎后短真空更险
}

OniMeiRubbingMokukiri: {
	DisplayName: 默切
	Tooltip: 疾走结束后沉气一刀；连续疾走时难以兑现
	Origin: 空气沉下去了。习惯了，咎还在
	Power: 「默杀」神威疾走自然结束后的短窗内，下一刀更沉
	Burden: 永动疾走时赋效不亮
}

OniMeiRubbingKogehi: {
	DisplayName: 焦樋
	Tooltip: 疾走留下灼地；刀击伤害 -8%
	Origin: 烫滩旁别伸脚。樋为躲开热而开
	Power: 「焦痕」疾走路径留下短时灼地
	Burden: 刀击伤害 -8%，须以走位留下的灼地补足
}

OniMeiRubbingKanhi: {
	DisplayName: 闲樋
	Tooltip: 脱战快速回气；疾走与樱流耗气 +12%
	Origin: 门口清静，耳朵歇一会儿
	Power: 「闲息」脱战短歇后气力快速回一轮
	Burden: 疾走与樱流耗气 +12%。清静回气，要从行动上还
}

OniMeiRubbingTodohi: {
	DisplayName: 滞樋
	Tooltip: 黏敌；再走钝半拍
	Origin: 黏是黏了点。沾着转，脱开就滞
	Power: 「滞缚」命中把墨黏上脚，目标短暂难走（巨物略韧）
	Burden: 疾走过后，下一步疾走慢半拍才备好
}

OniMeiRubbingShiorihi: {
	DisplayName: 谢樋
	Tooltip: 了结溅花；自然回气 -15%，空残心耗气
	Origin: 剪败花，为开锋，不为好看
	Power: 「剪落」击杀或残心了结时刃花溅向周围残血
	Burden: 自然回气 -15%；空残心额外消耗2点气力
}

OniMeiRubbingShiohi: {
	DisplayName: 潮樋
	Tooltip: 合潮受益；错拍亏
	Origin: 潮痕过夜。湿着贴脸才回
	Power: 「潮拍」赶上潮汐节拍的命中更疼或更回气
	Burden: 总错拍则不如素刀
}

OniMeiRubbingShibori: {
	DisplayName: 痺雕
	Tooltip: 挡成功反麻；架势贵
	Origin: 麻着手也护一下。刀也疼
	Power: 「痺反」护身或穿身格挡成功反麻来手。麻着的手脚更慢，打人也不疼
	Burden: 架势账更苛
}

OniMeiRubbingChinmei: {
	DisplayName: 镇鸣
	Tooltip: 抗弹站稳；近搏一般
	Origin: 耳嗡的时候，先镇住再动
	Power: 「镇鸣」受弹时更站得住，弹击退大减、弹伤略减
	Burden: 纯近战肉搏时铭偏闲，架势获取 -15%
}

OniMeiRubbingAshidome: {
	DisplayName: 止足
	Tooltip: 站住开大；跑动无
	Origin: 站住别晃。脚定了，护才在
	Power: 「止足」立定片刻后，下一次承诺大招更重
	Burden: 边跑边砍几乎吃不到
}

OniMeiRubbingYoen: {
	DisplayName: 余炎
	Tooltip: 处决留灼地；气/走有价
	Origin: 烤箱余温还在刃上。火熄了，烫没熄
	Power: 「余烬」处决后留下一片持续灼地，无须再打满五连
	Burden: 气略紧，场在时疾走更烫更费
}
