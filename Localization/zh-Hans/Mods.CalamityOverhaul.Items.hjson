		"传说在远古时期，有一位强大的灵能者用这根法杖将恒星压缩成了黑洞，
		但已经无从考证，成为星际游牧者口中吟唱的残诗"
		'''
}

FadingGlory: {
	DisplayName: 残怨
	Tooltip:
		'''
		真近战击中目标，如果目标是有机体，将会治疗玩家，如果目标是无机体，将会释放大量火花
		非真近战时将会主动发射剑刃，击中目标后额外生成追踪的孤魂切并在爆炸时释放出一条血触手
		'''
}

