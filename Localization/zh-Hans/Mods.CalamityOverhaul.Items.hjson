	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		有一股浓厚的青草气味
		'''
}

BleedingScourge: {
	DisplayName: 血色鞭挞
	Tooltip: 击中敌人后进行死亡标记，并令血雨降下
}

GhostFireWhip: {
	DisplayName: 鬼火鞭
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		一把很长的鞭子，由地牢冤魂的怒火编制而成
		[c/d4bc75:纯粹的热情从地狱散发出来，鼓励你找出谁冤枉了你]
		'''
}

DivineSourceBlade: {
	DisplayName: 金源灭却刃
	Tooltip:
		'''
		四拍连击，先逆时针再顺时针挥出两记快斩
		随后沿立体椭圆轨迹环斩一周，终结时沿原路反斩
		每次挥舞射出数量递增的追踪光矢，反斩轰出巨型蔚蓝新月剑气
		伤害到敌人缓慢积攒充能，右键消耗整条充能强化武器 7 秒
		强化期间伤害大增，光矢更多更狠，特效镀上金源之色
		"生命不息"
		'''
}

FoodStallChair: {
	DisplayName: 大排档塑料椅子
	Tooltip: I AM THE CHAIR THAT IS APPROACHING!
}

Arbiter: {
	DisplayName: 断罪师
	ManifestInteractHint: "[右键] 拔出这柄斧"
	ManifestInventoryFullHint: 背包已满，腾出一个空位后再拔斧
	Tooltip:
		'''
		长按左键蓄力，高举断罪之斧
		松开后向下劈砍，在地面释放向两侧蔓延的火焰冲击波
		蓄力越久，火焰蔓延越远，威力越强
		"审判从烈火中升腾"
		'''
}

Cloudwalking: {
	DisplayName: 云端漫步
	Tooltip:
		'''
		长按左键蓄力高举大斧
		松开后斧头向前飞出，途中喷洒云雾
		自动飞回玩家手中
		'''
}

AnnihilatingUniverse: {
	DisplayName: 湮宇星矢
	Tooltip:
		'''
		箭矢击中敌人后在原地留下一颗璀璨之星
		右键以噬神者之力摧毁敌人
		'''
}

NeutronStarIngot: {
	DisplayName: 中子星锭
	Tooltip: 万物之重，聚合指尖
}

DawnshatterAzure: {
	DisplayName: 苍穹破晓
	Tooltip:
		'''
		按住左键使出连段，五段一轮，末段回旋燃起日冕
		右键举枪蓄力，向准星方向突进
		"烈火净化灵魂，将你的敌人彻底掠夺干净"
		'''
}

Flawless: {
	DisplayName: 化境
	Tooltip:
		'''
		四段连击：横扫、突刺、反扫、终结长刺，一段比一段重
		突刺段换上细矛尖，刺得更远，命中溅出霜晶
		"矛尖换了七次，靶上只有一个孔"
		'''
}

StormGoddessSpear: {
	DisplayName: 风暴女神之矛
	Tooltip:
		'''
		发射出带有毁灭电弧的风暴之吻
		手持时召唤风暴女神残魂协助作战
		[legend]
		'''
	Legend:
		'''
		阿莉娜，泰拉曾最为锐利的锋刃。
		她信仰坚定，勇猛骁战。铁屑银枪，丝发乱舞。雷暴之刃，呼啸而过。
		然而，再锋利的剑刃也会溃败崩摧，信仰却换来了神明的冷漠。
		当至高降下神罚，她的战友、亲族、誓言与荣耀一同化为灰烬。
		亲眼见证，何所谓正义践踏一切...血泪...尘土......何以借秩序的名义行驶最卑鄙的毁灭。
		神明啊......阿莉娜不再仰望神明。
		她退回深渊，摧毁了自己，让古老的禁忌之力任意蚕食她的灵魂
		阿莉娜的身甲融作深渊铁铸的残躯。那往日的残云、赤血遮日与过往交织，战友...还有亲族死前的凝视......阿莉娜...一切都已结束。
		她已不再是曾经的阿莉娜，那位守护泰拉的战神
		她的怒火如狂风般归来，卷入战场的蝼蚁，她的雷霆横空霹雳，洪声震开云与天空，裂开王座与大地。
		风暴女神，阿莉娜，无情地带来了毁灭与复仇。
		'''
}

DragonsScaleGreatsword: {
	DisplayName: 龙藻巨刃
	Tooltip:
		'''
		挥砍遵循三段连击，第三段释放更具龙威的终结重斩
		挥砍释放螺旋绿藻剑气，击中目标后炸成数团毒藻雾
		真近战攻击会生成大量毒藻雾
		右键召唤翠龙之魂撕咬光标方向的敌人，沿途散播毒藻雾
		'''
}

CosmicCalamity: {
	DisplayName: 银河之灾
	Tooltip: 攻击生成月牙型冲击波
}

SpearOfLonginus: {
	DisplayName: 朗基努斯之枪
	Tooltip:
		'''
		手持时身下浮现圣神十字架，自动汲取圣神能量
		每次能量条充满便完成一次充能，最高叠加到六重立场
		手持时对最近的敌人进行命运标记
		立场击中标记的敌人后将触发朝圣者之怒
		[legend]
		'''
	Legend:
		'''

		“破碎的神啊，请允许我赎还我的罪。”
		战争已经蔓延数个世纪，我，作为逃离伟大文明的溃败者，孤身在这宇宙边缘的荒凉星球上苟且生存。
		数万光年外，战争的巨械在碾碎星辰，残暴而可怖的攻击能在瞬息间清除数光年的星空，将其变为寂静之域。
		而这样的战争，持续了数百年，如今，我所属的伟大文明岌岌可危，我将成为宇宙中的罪人，成为那最为不敬的亵渎者。
		我的血肉已然腐朽，骨骸如同岁月的老化皱纹，我即将沦为我所创造的孱弱机械之一。
		在此之前，愿神赐予我宽恕，赦免我对这至高存在的不敬之罪，让我在灵魂陨落的那一刻，陷入炼狱的深渊，受那无尽的苦痛。
		然而，无论如何，为了我所属的文明，为了在这场跨越世纪的战争中取得胜利，我必须汲取这至高之物残缺的力量。
		为了引导它的神秘力量，我别无选择，只能将冰冷的机械灌注进它破碎的神体之中。
		这是一场不可避免的亵渎，为了文明的延续，为了战争的胜利，我不得不成为那至高之物最虔诚的信徒，有史以来最不敬的亵渎者。
		'''
}

BloodAltar: {
	DisplayName: 深红祭坛
	Tooltip:
		'''
		右键祭坛用血泪召唤血月
		自动收集世界上掉落的血泪与血珠存放到最近的箱子中
		"让世界被深红所注视"
		'''
}

BarrenBow: {
	DisplayName: 荒芜弓
	Tooltip: 发射出的箭矢在击中敌人时会爆发出荒芜电流
}

ElementMuzzleBrake: {
	DisplayName: 元素稳定器
	Tooltip:
		'''
		远程伤害增加12%
		远程暴击率增加15%
		远程射速增加12%
		敌人将更不容易发现你
		'''
}

EyeOfSingularity: {
	DisplayName: 奇点视界
	Tooltip:
		'''
		远程伤害增加100%
		远程暴击率增加100%
		远程射速增加100%，且不再消耗弹药
		将所有远程武器的暴击伤害倍率提升至500%
		你的远程弹幕将撕裂空间，在命中时产生微型黑洞吸附并绞杀周围敌人
		处于静止状态时，你将进入事件视界状态：
		  隐身且免疫一切接触伤害
		  射击时会额外释放出追踪敌人的伽马射线暴
		获得量子迁跃能力，按下[KEY]瞬移至光标位置并消除沿途敌人的弹幕
		右键点击可激活坍缩协议：
		  消耗所有魔力，在接下来10秒内，你的所有远程攻击将无视无敌帧并强制暴击
		  冷却时间60秒
		如果受到了致死攻击，自身将化为一颗超新星爆发，造成极高范围伤害，并在3秒后于安全位置重组
		该效果具有60秒冷却
		[c/33ff33:"沉睡的龙神触及了你的神经，万机之魂在祂眼中再无秘密"]
		[c/ffaa00:"贪婪的星宿啜饮着枪口的烈焰，恒星熄灭前的光辉尽归其腹"]
		[c/00ffff:"死神无声地跟在你的身后，祂收取每一个终将偿还的名字"]
		'''
}

ArcaneThroneOfEternity: {
	DisplayName: 永恒奥秘之座
	Tooltip:
		'''
		魔法伤害增加100%
		魔法暴击率增加100%
		魔法攻击速度增加100%
		魔力上限增加1000点，魔力恢复速度大幅提高且永不间断
		所有魔法弹幕获得无限穿透能力
		你的魔法攻击将撕开现实帷幕，在命中位置产生持续爆发的奥术裂隙
		所有魔法攻击都会附加随机的禁忌诅咒：
		  虚空侵蚀、时停、灵魂燃烧、引力坍缩、超位崩解
		当魔力高于90%时获得「全知」状态：
		  所有魔法弹幕将自动锁定敌人，暴击伤害倍率提升至1000%
		获得真理跃迁能力，按下[KEY]撕裂空间并进入高维领域：
		  短时间内免疫一切伤害并获得自由移动能力，离开时释放毁灭性的现实震荡
		  冷却时间30秒
		右键点击激活根源演算：
		  接下来10秒内，你的所有魔法攻击都会同时释放出5道镜像法术
		  冷却时间60秒
		如果受到致死攻击，时间将回溯至5秒之前的状态，恢复彼时的生命、魔力与位置
		该效果具有60秒冷却
		敌人将更容易以你为目标
		[c/b84dff:"无名的贤者翻开了你的颅骨，于群星之外书写着被遗忘的真理"]
		[c/ffdd66:"万变之主拨动了命运的经纬，将现实视作尚未完成的草稿"]
		[c/66ffff:"坐于黄金王座上的尸骸注视着你，而祂早已遗忘何为死亡"]
		'''
}

