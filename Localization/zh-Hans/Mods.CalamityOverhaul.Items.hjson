		在机械暴乱中击败叛乱机械以获取
		'''
}

DestroyersBladeEX: {
	DisplayName: 毁灭者之刃EX
	Tooltip:
		'''
		发射热能弹幕
		"摧毁永远比建造容易"
		'''
}

ThermalGenerator: {
	DisplayName: 火力发电机
	Tooltip:
		'''
