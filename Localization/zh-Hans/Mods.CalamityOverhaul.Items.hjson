	Tooltip: 随风而动，生产电能
	UnderstandWindGrivenMK2: 需要对风力发电的工作原理有深入的了解
	UnderstandWindGrivenMK2Remind: 需要挖掘小行星上的巨型风力涡轮机来了解它们的制作原理
}

ThermalGeneratorMK2: {
	DisplayName: 火力发电机MK2
	Tooltip:
		'''
		放入燃料进行发电
		右键物块可以快速放入燃料，Shft右键取出
		'''
}

WGGMK2Wilderness: {
	DisplayName: 荒野中的巨型风力发电机
	Tooltip: ""
}

WGGWilderness: {
	DisplayName: 荒野中的风力发电机
	Tooltip: ""
}

TeslaElectromagneticTower: {
	DisplayName: 特斯拉电磁塔
	Tooltip:
		'''
		需要电能才能工作
		放置到地面后右键可以在攻击模式和护卫模式之间切换
		攻击模式会向附近的敌人发射电弧
		护卫模式会对范围内的所有敌人造成带电减益，如果玩家在范围内，
		并手持可充能物品，电磁塔将发射电弧为玩家远程充能
		"工程师请勿靠近"
		'''
}

FlameTurret: {
	TurretOnText: 火焰塔启动
	TurretOffText: 火焰塔关闭
	NoEnergyText: 能量不足!
	FuelLoadText: 装入凝胶 x{0}
	FuelTakeText: 取出凝胶 x{0}
	DisplayName: 火焰喷射塔
	Tooltip:
		'''
		需要电能才能工作
		持续向靠近的敌人喷吐火舌，火焰可以穿透敌群并点燃狱火
		手持凝胶右键塔身可以装入燃料，燃烧凝胶时火力更猛
		按住Shift右键取出凝胶；物品管道也可以向燃料槽输送凝胶
		空手右键或电线信号开关塔
		"闻起来像烤史莱姆"
		'''
}

CryoTurret: {
	TurretOnText: 冰冻塔启动
	TurretOffText: 冰冻塔关闭
	NoEnergyText: 能量不足!
	DisplayName: 冰冻塔
	Tooltip:
		'''
		需要电能才能工作
		向范围内的所有敌人持续散布寒气，使其霜冻减速
		同一敌人被寒气覆盖约两秒后会被短暂冻结
		减速和冻结才是本职，伤害只有霜火慢烧的一点
		右键或电线信号开关塔
		"冷静一下"
		'''
