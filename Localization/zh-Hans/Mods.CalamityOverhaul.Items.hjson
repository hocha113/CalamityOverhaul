LaserTurret: {
	TurretOnText: 激光塔启动
	TurretOffText: 激光塔关闭
	NoEnergyText: 能量不足!
	DisplayName: 激光塔
	Tooltip:
		'''
		需要电能才能工作
		向视线内的敌人发射高伤害光束，射程极远但射速缓慢
		被地形挡住的目标不会被锁定，优先攻击Boss
		右键或电线信号开关塔
		"一发，一个"
		'''
}

ShieldGenerator: {
	FieldOnText: 护盾力场启动
	FieldOffText: 护盾力场关闭
	NoEnergyText: 能量不足!
	DisplayName: 护盾发生器
	Tooltip:
		'''
		需要电能才能工作
		通电运转时，范围内的玩家获得能量护盾
		护盾缓慢蓄能，受击时替你挡下一部分伤害，离开范围后逐渐消散
		守护的玩家越多，耗电越快
		右键或电线信号开关力场
		'''
}

HealStation: {
	FieldOnText: 治疗光环启动
	FieldOffText: 治疗光环关闭
	NoEnergyText: 能量不足!
	DisplayName: 治疗站
	Tooltip:
		'''
		需要电能才能工作
		通电运转时，缓慢回复范围内所有玩家的生命
		右键或电线信号开关光环
		"工伤？不存在的"
		'''
}

EmblemOfDread: {
	DisplayName: 惧亡者之证
	Tooltip:
		'''
		增加100%近战伤害
		增加100%近战暴击率
		增加100%近战攻速
		增加100点防御值，无视全部防御衰减
		受到的伤害减少75%，并让攻击者受到100倍的反弹伤害
		所有近战攻击将对敌人造成虚空侵蚀减益
		如果敌人的血量低于25万，真近战攻击将有可能直接抹杀敌人
		高速移动时会在路径上留下数个翘曲点，对接触到的敌人造成极高伤害
		获得重力突刺的能力，按下[KEY]进行超长距离突刺，并释放出大量引力射线
		如果受到了致死攻击，将立刻回复满血量并给予你一个重力护盾，该效果具有60秒冷却
		敌人将更容易以你为目标
		[c/d94fff:"圣洁的天使覆上了你的双眸，呢喃着永恒的甜蜜谎言"]
		[c/ff4d4d:"浴血的屠夫执起了你的双刃，宣告着杀戮方能成就荣耀"]
		[c/4da6ff:"湛蓝的信鸽啄破了你的额心，讥笑着你那微不足道的挣扎"]
		'''
}

ElectricMinRocket: {
	DisplayName: 电动迷你火箭
	Tooltip:
		'''
		右键使用火箭，或者放置在地上右键点击即可启动飞行
		空中按左右方向键调整方向
		长按向下方向键缓降，飞行会缓慢消耗电力
		按下空格键可以中断飞行
		"苏联制造，坚固耐用，当年差点飞去月球"
		'''
}

TeleportStation: {
