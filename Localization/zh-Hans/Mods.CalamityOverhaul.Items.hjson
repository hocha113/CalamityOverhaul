}

AzureDragonRage: {
	DisplayName: 青龙之怒
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		有一股浓厚的青草气味
		'''
}

BleedingScourge: {
	DisplayName: 血色鞭挞
