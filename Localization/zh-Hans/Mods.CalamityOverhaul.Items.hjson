			若需要解除禁用状态，请重新进入世界
			'''
		ItemLegendOnMouseLang: 按下'Shift'聆听故事...
	}
}

RMagicConch: {
	DontUseMagicConch: 你被一个强大的生物盯住了...

	RMagicConch: {
		DontUseMagicConch: 你被一个强大的生物盯住了...
		DisplayName: 魔法海螺
		Tooltip: 仔细听，你会听到海洋的声音
	}
}

GraniteTome: {
	DisplayName: 花岗岩魔典
	Tooltip:
		'''
		吟咏汇聚三颗充能光点，充满后扇形齐射三发轻追踪的花岗能量球
		能量球命中后碎裂为追击的水晶碎片
		'''
}

GraniteFlower: {
	DisplayName: 花岗之花
	Tooltip:
		'''
		掷出一枚水晶种子，落点绽放成驻场的能量花
		花体三次脉冲，朝最近的敌人迸射水晶花瓣
		凋谢时花瓣尽数碎裂，向四周迸溅晶屑
		'''
}

GraniteThrowingKnife: {
	DisplayName: 花岗飞刀
	Tooltip:
		'''
		掷出可穿透的飞刀，拖曳锐利的青蓝电弧
		命中敌人时，会向附近另一名敌人跳跃一道微型链电
		末段命中或撞击地形时碎裂为水晶碎片
		'''
}

GraniteWalkingBoots: {
	DisplayName: 花岗行走靴
	Tooltip:
		'''
		大幅提升跑速与加速度
		达到全速的瞬间靴底通电，迸发电弧
		全速奔跑时脚下走火，身后拖曳青蓝残影
		'''
}

MarbleClub: {
	DisplayName: 大理石巨棍
	Tooltip:
		'''
		缓慢而沉重的过顶猛砸，击退极强
		命中必定使敌人短暂石化，化石迟滞
		砸中地面会掀起全威力的大理石冲击波与奔涌尘浪
		凌空挥砸则只余减弱的空气震荡
		'''
}

MarbleHuntingKnife: {
	DisplayName: 大理石猎刀
	Tooltip:
		'''
		迅捷的交替连斩
		每第三击化为更宽的终结斩，小步突进并迸射大理石碎片
		'''
}

MarbleDisc: {
	DisplayName: 大理石飞盘
	Tooltip:
		'''
		掷出旋转的飞盘，在敌人与墙壁间弹射
		每弹射至一名新目标，飞盘愈发鎏金，伤害提升10%，至多30%
		弹射耗尽后回旋归手，最多可同时存在两枚
		'''
}

MarblePebble: {
	DisplayName: 大理石卵石
	Tooltip:
		'''
		可无限使用的迅捷投石，撞地后弹射一次
		对生命上限越高的敌人造成越高的额外伤害
		击中庞然大物时金光迸裂、声如碎岩
		'''
}

MarbleShield: {
	DisplayName: 大理石战盾
	Tooltip:
		'''
		近战击退提升
		三块环绕的大理石碎片组成石卫护盾，就绪时吸收一次伤害并碎裂
		按[KEY]举盾格挡：完美格挡免除伤害，粉碎近旁弹幕并反掷石刃
		完美格挡后5秒内近战伤害提升10%
		'''
}

MarbleBalloon: {
	DisplayName: 大理石气球
	Tooltip:
		'''
		空中按↓砸向地面，下坠蓄势越久，落地冲击波越强、范围越广
		免疫摔落伤害
		'''
}

MarbleinaBottle: {
	DisplayName: 瓶中大理石
	Tooltip: 额外赋予一段沉重而有力的二段跳，按住跳跃键可跃得更高
}

MarbleCloudBalloon: {
	DisplayName: 大理石云朵气球
	Tooltip:
		'''
		额外赋予一段沉重而有力的二段跳，按住跳跃键可跃得更高
		空中按↓砸向地面，下坠蓄势越久，落地冲击波越强、范围越广
		免疫摔落伤害
		'''
}

TestItem: {
	// DisplayName: Test Item
	// Tooltip: ""
}

OniMeiRubbingHigekiri: {
	DisplayName: 髭切
	Tooltip: 敌人越残这刀砍得越狠，亲手了结还返架势；面板伤害 -2%
	Origin: 源家试斩那一夜，这刀连首级带颔下须髯一并斩落，胡子还粘在刃口上。髭切这个旧名，就是那晚得下的
	Power:
		'''
		「断首」刀刃亲自砍中生命低于 35% 的敌人就开始加伤，命越薄加得越多
		普通敌人最多 +60%，首领最多 +45%
		亲手了结它还返 8 点架势，同一招只返一次
		'''
	Burden: 面板伤害 -2%。敌人血还厚的时候，这把刀比原铭钝一点
}

OniKeikoRune: {
	DisplayName: 稽古符
	Tooltip:
		'''
		使用后从头开讲鬼切教习，教习进行中再用一次则收起
		婉拒开场教习时留下的凭证，符不消耗，可反复开讲
		'''
	NeedBlade: 行囊里没有鬼切，符引不出教习
	Closed: 教习已收起，再用此符可重开
	NotNow: 此刻另有要事，符压不住场
}

OniMeiRubbingOnikiri: {
	DisplayName: 鬼切
	Tooltip: 原铭。不加赋效，也不收代价
	Origin: 渡边纲提它在一条戾桥斩落恶鬼一腕，那鬼遁走，再没敢回来讨。斩过鬼的刀从此得名鬼切，钉在茎上没再换过
	Power: 原铭。这把刀现有的一切原样留着，不多一分，不少一毫
	Burden: 无
}

OniMeiRubbingShishinoko: {
	DisplayName: 狮子之子
	Tooltip: 五段连斩不断，第五拍多甩两道交叉刃波；出刀间隔 +2%
	Origin: 一夜它被搁在主人枕边，半夜自己吼了一声，声如狮鸣，满府都听见了。主人给它改名狮子之子，金字嵌进茎里，给这一嗓子记功
	Power:
		'''
		「狮势」五段连斩一路打完、中途不被疾走或大招掐断，第五拍便狮口合颚
		交叉甩出两道刃波，每道伤害是一刀的 22%
		'''
	Burden: 连段出刀间隔 +2%。吼声要蓄，刀就慢那么一点
}

OniMeiRubbingTomokiri: {
	DisplayName: 友切
	Tooltip: 疾走掐掉连段，会在原地留一道咎影补刀；手持承伤 +6%
	Origin: 两把源家宝刀相并试锋，它一刀把对面那位朋友拦腰斩断。这桩过失被凿成了名字——友切，切了朋友的刀，性子也自此暴烈
	Power:
		'''
		「咎影」用神威疾走掐掉连段时，被打断的那一刀留在原地
		它随后自己咬合下去，伤害是一刀的 35%
		'''
	Burden:
		'''
		手持这把刀期间，你受到的伤害 +6%
		每留一道咎影积一层「咎」，最多三层，每层让下一次疾走多吃 4 点气力
		疾走后的残心追斩砍中，欠下的咎一次偿清
		'''
}

OniMeiRubbingKazehi: {
	DisplayName: 风樋
	Tooltip: 疾走省 15% 气、樱流省 20%；墨痕伤害 -20%
	Origin: 开锋人把这道樋开得又直又长，说是给风留的道。刀挥出去，风先到——听见风声的时候，刀已经收回来了
	Power: 「顺风」神威疾走的气力开销 -15%，樱流巡航的耗气 -20%
	Burden: 疾走留下的墨痕伤害 -20%。这道樋是为轻身开的，不为杀伐
}

OniMeiRubbingChihi: {
	DisplayName: 血樋
	Tooltip: 砍中就回气，砍得越勤气越足；自然回气 -35%
	Origin: 别的樋开出来是为了让刀身轻，这一道不是。开锋人交刀时说得直白：这道槽是给血留的，血走得快，你那口气才回得快
	Power:
		'''
		「回流」连段每一拍第一次砍中，额外回 1 点气力
		疾走后的残心追斩每次砍中，额外回 4 点
		'''
	Burden: 自然回气 -35%，出招之后要多等 0.3 秒才开始回。刀不沾血，气就难回
}

OniMeiRubbingFudo: {
	DisplayName: 不动
	Tooltip: 大招演出中挨打，扣架势换减伤；架势获取 -15%
	Origin: 雕师照梵字カーン的笔意下錾，把背负火焰的不动明王请上刃侧。这一尊管的就是一个稳字：任什么打过来，坐着不动
	Power:
		'''
		「不动护」残心追斩、灭世一闪、终结乱舞这些收不回手的招式演出中挨了一下，不动尊替你挡
		扣 20 点架势，那一击伤害只剩 65%，击退只剩 25%，挡完歇 2.5 秒
		'''
	Burden: 平时的架势获取 -15%，护身的力气是从蓄势里扣的。肢解反噬不在庇护范围内
}

OniMeiRubbingKurikara: {
	DisplayName: 倶利伽罗
	Tooltip: 处决后攒三层龙火，每次完整五连烧掉一层；气力上限 -10%
	Origin: 刀身雕的是倶利伽罗龙王：一条黑龙缠住剑身，张口欲吞剑锋。这是刀雕里的老题目，鳞缝里嵌着金
	Power:
		'''
		「龙火回环」处决之后刀身点起三层龙火，十秒内有效
		每打完一次完整五连，第五拍烧掉一层，甩出一道回环斩，伤害是一刀的 50%
		'''
	Burden: 气力上限 -10%。龙盘着的那截刀身，气走得窄了些
}

OniMeiRubbingTessetsu: {
	DisplayName: 铁截
	Tooltip: 砍钢铁与机械，每拍首刀 +25%；面板伤害 -10%
	Origin: 有人验完这刀撇嘴：名字唬人，刃倒像一截生铁。刀匠不恼，把这句拆台话原样凿进茎里——生铁就生铁，铁磕铁才见真章
	Power: 「截金」连段每一拍的第一刀砍在钢铁、机械这类砍上去冒火花的敌人身上，伤害 +25%
	Burden: 面板伤害 -10%。砍血肉的时候，它更像一截钝铁
}

OniMeiRubbingKyushu: {
	DisplayName: 旧首
	Tooltip: 只收头，残血的头收得比髭切更狠；面板伤害 -3%
	Origin: 有的刀断一颗好头就改一回名，风光一回。这一铭的主人不兴这套：头照断，名照旧，断得干脆的刀不靠新名字吓唬人
	Power:
		'''
		「取首」这道加成只认头部，或者本来就不分节的敌人
		它生命低于 35% 后你砍它就开始加伤，命越薄加得越多
		普通敌人最多 +85%，首领最多 +60%
		'''
	Burden: 面板伤害 -3%。躯干、尾巴和其余节体，砍着不算取首
}

OniMeiRubbingIkiai: {
	DisplayName: 息合
	Tooltip: 完整五连第五拍朝光标甩一道剑气；出刀间隔 +4%
	Origin: 老剑客说，对峙久了两边的呼吸会咬在一起，谁先合上那口气，谁的刀先到。这道铭刻的就是这门功夫：憋住，合拍，落刃
	Power: 「吐息」打完完整五连，第五拍顺着你瞄的方向甩出一道弧形剑气，伤害是一刀的 55%，最多切过三个敌人后散开
	Burden: 连段出刀间隔 +4%
}

OniMeiRubbingKyoko: {
	DisplayName: 虚吼
	Tooltip: 拉开距离攒一刀，回身贴脸砍更重；连着贴身猛砍会失焦
	Origin: 试刀人对着空谷吼了一声，没有回声——四下无人的时候，那口气全憋回了刀上。这道雕记的就是这口憋劲
	Power:
		'''
		「空鸣」身边 16 格内空无敌人满 1.5 秒，刀替你攒下一记
		之后第一次在 16 格内砍中，伤害 +25%；在更远处砍中不消耗它，那一记留着
		刀闲下来就自鸣：1.5 秒没砍中人、或身边没有敌人时，每 1.5 秒把 20 格内的敌人压慢 0.4 秒
		'''
	Burden: 0.6 秒里贴身砍满四次会失焦 0.4 秒，这期间贴身伤害 -5%
}

OniMeiRubbingKarikiri: {
	DisplayName: 假切
	Tooltip: 疾走留一具残影替你吃掉一次伤害；用掉要等 4 秒
	Origin: 学刀的把师父的架势学了个十成十，师父只评一句：太像了，像到一眼假。这道铭刻的就是那具假身——站得再像，也只是替你挨刀的影子
	Power:
		'''
		「假身」神威疾走起步时，原地留下一具定住姿势的残影，站 1.5 秒
		这期间任何敌人或弹幕打过来，残影替你完全挡掉一次
		挡掉之后要等 4 秒，才能再留一具
		'''
	Burden:
		'''
		残影在场时，你的承伤与疾走耗气都 +12%
		残影被打碎后的 1 秒里，承伤 +18%
		残影自己站满时间散掉的，不算被打碎
		'''
}

OniMeiRubbingMokukiri: {
	DisplayName: 默切
	Tooltip: 花气力的普通疾走跑完，下一刀 +35%；挥空也算用掉
	Origin: 疾走跑完的那一瞬，周遭会忽然安静下来。老刀客都知道，这份安静里出的下一刀最重。铭如其名：默着切
	Power: 「默杀」花气力的普通疾走自然跑完之后 0.75 秒内，你的下一记连段或残心追斩伤害 +35%
	Burden: 这一记挥空了也照样算用掉，中途再疾走同样清掉。免费的处决疾走不给默杀
}

OniMeiRubbingKumokiri: {
	DisplayName: 蜘蛛切
	Tooltip: 砍三刀钉出一张网，收网把网里的都割一遍；挂着锚回气 -25%
	Origin: 源赖光病卧在床，土蜘蛛化作法师来撒丝缚人。他抄刀斩丝伤蛛，翌日循着血迹把巢端了，刀从此改名蜘蛛切
	Power:
		'''
		「墨丝」刀刃亲自砍中，就在落刀处钉下一枚丝锚，能挂 4 秒
		锚要散着钉：同一个敌人 0.4 秒内不给第二枚，两枚锚之间也得隔开六格左右
		钉满三枚就连成墨丝三角，垂一下之后朝中心猛收，扫到的敌人各吃一刀的 90%，并被缚住 1 秒
		收完网歇 1.5 秒才能再织
		'''
	Burden: 场上还挂着锚时，自然回气 -25%。锚等到过期，那一刀就算白砍了
	DeedHint: 斩杀三十只蛛形之物——蜘蛛、血爬虫、沙蝎这类八脚爬墙的都算。斩够了，刀自然认得那股腥气
}

OniMeiRubbingOnimaru: {
	DisplayName: 鬼丸
	Tooltip: 站着别动，刀自己飞出去砍；它在外面时你手里没刀
	Origin: 天下五剑里的鬼丸国纲。主人夜夜被梦里的小鬼缠磨，一夜这刀自己从架上倒下，斩断了火盆脚上雕的鬼头，怪梦当场断根。人不动，它自己会动
	Power:
		'''
		「自斩」站定不动满 1 秒，刀进入待机
		之后每 1.5 秒扣你 10 点气力，自己飞向 40 格内的敌人，砍出一刀的 140% 再回鞘
		'''
	Burden: 刀在外面的整段时间都不在你手上，连段、疾走、樱流全都用不了。附近没有目标它就不飞
	DeedHint: 持刀站定不动满十秒，其间挨了打也没挪步——你站得住，刀就替你动那一次
}

OniMeiRubbingRaikiri: {
	DisplayName: 雷切
	Tooltip: 第五拍与大招在露天引雷贯敌；出刀间隔 +6%，洞里不落
	Origin: 立花道雪在大树下避雨，一道雷当头劈下，他拔刀迎着劈了回去，人活了下来。刀从此改名雷切
	Power:
		'''
		「斩雷」第五拍、残心追斩、灭世一闪、终结乱舞砍中敌人时，只要头顶看得见天，就从天顶劈下一道雷柱
		雷柱伤害是一刀的 70%；雷暴天里同一记最多劈三道
		'''
	Burden: 连段出刀间隔 +6%，晴天也一样慢，蓄雷的账总要付。头顶被物块挡住或人在洞里就不落雷
	DeedHint: 雷暴天在露天斩杀一名首领，刃才认得那口雷
}

OniMeiRubbingNuekiri: {
	DisplayName: 鵺切
	Tooltip: 空中打完五连，第五拍改成砸地俯冲；落地约 0.7 秒不能疾走
	Origin: 夜里宫顶盘着怪鸟鵺，源赖政一箭把它从云里射落，坠地那一刻补的那记刀，是顺着下坠之势砸下去的。这道铭记的就是那一落
	Power:
		'''
		「落鵺」离地三格以上打完完整五连，第五拍不再横挥，改成一记砸向地面的俯冲
		落点炸开约 12 格的冲击圈，伤害是一刀的 120%，还把周围的敌人往落点拽
		'''
	Burden: 落地后约 0.7 秒不能疾走。贴着地打的时候，第五拍还是普通的第五拍
	DeedHint: 夜里升到离地三十格以上，斩杀一只飞行的敌人，刀就认得那口俯冲
}

OniMeiRubbingKamihi: {
	DisplayName: 紙樋
	Tooltip: 疾走穿过敌人会掉下纸型，砍纸等于砍本体；有纸在场疾走更费气
	Origin: 裱纸匠的功夫到了家，一刀下去纸是纸、影是影。这道樋学的就是那一手：穿身而过时把对方的影子裁下来留在原地——纸还在，账就照着纸算
	Power:
		'''
		「表影」神威疾走穿过敌人时，在落点留下一张照着它裁的纸型，能挂 7 秒，场上最多同时两张
		砍这张纸，伤害是一刀的 80%，直接算到本体身上
		同时在本体身上开 1.5 秒的破口，破口期间它挨你的刀多吃 12%
		'''
	Burden: 场上有纸的时候，疾走耗气 +12%
	DeedHint: 在里世界斩够二十张面影纸型，手才知道纸该怎么裁
}

OniMeiRubbingSorahi: {
	DisplayName: 空樋
	Tooltip: 离地多一次疾走、回气翻倍；落地那 0.75 秒完全不回气
	Origin: 开这道樋的师傅有句怪论：气跟人一样，脚一沾地就犯懒。所以他把刀开得极轻，让人多在空里待一会儿——浮着的时候，气自己会来找你
	Power:
		'''
		「浮身」双脚离地时自然回气翻倍，并多给一次疾走
		空中疾走跑完，会在终点滞空半秒
		'''
	Burden: 落地后的 0.75 秒里自然回气归零。站在地上疾走要多花 10% 气力
	DeedHint: 连续十五秒不落地，其间刀刃至少砍中五下，樋才认得浮身
}

OniMeiRubbingKagamihi: {
	DisplayName: 鏡樋
	Tooltip: 疾走终点立一面纸镜，替你复刻下一刀；面板伤害 -5%
	Origin: 磨镜的师傅都知道，镜里的动作看着同步，其实总慢半拍。开这道樋的人偏要用这半拍：让镜里那位替你补一刀，迟到，但到
	Power:
		'''
		「镜写」神威疾走的终点立起一面纸镜，站 2 秒
		你之后第一次砍出去时，镜里的立像同步复刻同一刀，伤害是一刀的 45%，随后碎裂
		'''
	Burden: 面板伤害 -5%。复刻那一刀从镜子站的地方砍出去，砍不砍得到，看你把镜立在哪
	DeedHint: 用残心追斩了结一只宝箱怪——灾厄的仿造体也算学人样的东西
}

OniMeiRubbingAmahi: {
	DisplayName: 雨樋
	Tooltip: 樱流一路滴墨，落地摊成缚人的洼；樱流耗气 +15%
	Origin: 屋檐下接雨的槽也叫雨樋。开锋人照着屋檐给刀开了这道槽：接住的雨不白接，一路飞，一路滴，滴给底下挨刀的那些
	Power:
		'''
		「落雨」樱流巡航时每 0.1 秒甩下一枚墨滴，伤害是一刀的 12%
		墨滴落地摊成墨洼，踩进去的敌人被缚住半秒
		'''
	Burden: 樱流耗气 +15%。带着一路雨飞，费
	DeedHint: 雨天用樱流连着飞满十秒，樱瓣沾透了才留得住水
}

OniMeiRubbingTsuzurihi: {
	DisplayName: 綴樋
	Tooltip: 一次疾走的墨痕会互相连线切开；单枚墨痕伤害 -30%
	Origin: 綴是装帧师傅缝书的针法，一针一个眼，线一收，散页就订成一册。开这道樋的人把墨痕当针脚使：痕串起来，才收得成线
	Power: 「缀痕」同一次疾走留下的墨痕会同时引爆，并在彼此之间连出切线，每段伤害是一刀的 35%
	Burden: 单枚墨痕伤害 -30%。一次只穿中一个人的话，这道樋纯亏
	DeedHint: 一次疾走穿中六个不同的敌人，痕才缀得起来
}

OniMeiRubbingBonsho: {
	DisplayName: 梵鐘
	Tooltip: 架势满了憋住不放终结，刀自己撞钟；钟响耗去一半架势，换一圈缚敌控场
	Origin: 寺里的梵钟要人撞才响，刀上雕的这一口却不等人。雕师说得明白：势攒满了你不放，钟就替你放
	Power:
		'''
		「一撞」架势攒满后 3 秒内不放终结乱舞，刀就自己撞钟
		30 格内的敌人各吃一刀的 60%，并被缚住 1.5 秒，你的架势掉到 50
		'''
	Burden: 钟一响，这一次终结就没了。势满之后，你必须在两者之间挑一个
	DeedHint: 整场首领战不动用灭世一闪与终结乱舞，就这么把首领敲下来
}

OniMeiRubbingHannya: {
	DisplayName: 般若
	Tooltip: 自己残血翻鬼面，刀更重还吸血；鬼面期更脆，平时略钝
	Origin: 能乐里的般若面，演的是女子恨到极处、翻脸成鬼的那一瞬。雕师把这张面请上刀身：人被逼到绝处，面自己会翻过来
	Power:
		'''
		「面变」自己生命低于 35% 就翻出鬼面：刀伤 +20%，每次砍中回复 0.5% 最大生命
		鬼面期间每砍中三下，浮起一张鬼面咬合，伤害是一刀的 50%
		'''
	Burden: 鬼面期间承伤 +15%。还是女面的时候，面板伤害 -4%
	DeedHint: 自己的生命跌到一成以下时把首领斩了，面才翻得过来
}

OniMeiRubbingKaresansui: {
	DisplayName: 枯山水
	Tooltip: 立定耙出一片留在原地的砂纹场，场内持续割人还涨架势
	Origin: 庭园师不用一滴水，光凭砂石就耙出山海。雕师照那纹路入刀，说刀客站得够定，刀气也能在脚下耙出一片砂庭
	Power:
		'''
		「砂纹」站定不动满 1.5 秒，就在脚下耙出一片 20 格的砂纹场，留 5 秒
		场里每半秒割一次，伤害是一刀的 18%
		你自己站在场内时，架势获取 +30%
		'''
	Burden: 得先站定才耙得成，走动会把攒的清掉
	DeedHint: 钉在一处打满三十秒且一下没挨着，砂才耙得出来
}

OniMeiRubbingSenju: {
	DisplayName: 千手
	Tooltip: 终结乱舞定格时多浮六只鬼手同斩；终结后气力清零、3 秒不能疾走
	Origin: 千手观音一手渡一人。雕师把千手刻上刀身，给这刀立了规矩：终结送走的每一位，都得有一只手来接
	Power: 「千手」终结乱舞的定格期间，身后额外浮出六只持刀鬼手一起砍下，每只伤害是一刀的 30%
	Burden: 终结之后气力清零，并且 3 秒内不能疾走
	DeedHint: 用终结乱舞送走八种不同的首领，一手一位
}

OniMeiRubbingKogehi: {
	DisplayName: 焦樋
	Tooltip: 疾走整条路上留下最多五处灼地；面板伤害 -4%
	Origin: 开这道樋的师傅住在熔岩滩边，见惯了不看脚下的人。他说这樋是替你躲热开的：人跑过去，烫留在身后的地上，给追你的那位
	Power:
		'''
		「焦痕」神威疾走沿整条路径最多留下五处灼地，每处烧 1.5 秒
		站在灼地里的敌人每半秒被烫一次，伤害是一刀的 14%
		新灼地落在两格内的旧灼地上，只是把它刷新
		'''
	Burden: 面板伤害 -4%，少的那点要靠走位铺出来的灼地补回来
}

OniMeiRubbingKanhi: {
	DisplayName: 闲樋
	Tooltip: 刀冷下来时自然回气变成 2.25 倍；疾走与樱流耗气 +8%
	Origin: 刀铺门口有条长凳，师傅忙完就坐上去听街面的动静。他说人得会歇，耳朵清静下来，气才回得快。这道樋开的就是那条凳
	Power: 「闲息」两秒没有用刀砍中任何东西之后，自然回气速度变成 2.25 倍
	Burden: 疾走与樱流耗气 +8%。清静里回来的气，要从行动上还
}

OniMeiRubbingTodohi: {
	DisplayName: 滞樋
	Tooltip: 砍中就把敌人黏住 0.6 秒；疾走再起步多等 0.1 秒
	Origin: 这道樋淬得怪，刃口过肉时发黏，挨了刀的东西脚下都要滞上一滞。开锋人不认这是毛病：黏住的是它，又不是你
	Power: 「滞缚」刀刃亲自砍中就把敌人黏住 0.6 秒，普通敌人移动降到 88%，首领降到 96%
	Burden: 疾走的再起步要多等 0.1 秒。同一个敌人身上的滞缚与痺不叠加，只取更强的那个
}

OniMeiRubbingShiorihi: {
	DisplayName: 谢樋
	Tooltip: 亲手了结一个，顺手剪掉旁边最残的那个；自然回气 -10%
	Origin: 园丁剪花有个规矩：既然动了剪子，就把这一丛里蔫掉的一并剪了，省得回头再跑一趟。开这道樋的人，从前就是做园丁的
	Power:
		'''
		「剪落」用刀了结目标时，从它倒下的地方往外找 15 格
		挑一个生命不到一半的别的敌人，追过去剪一刀，伤害是一刀的 25%
		找不到人就不进冷却，剪成了歇 0.75 秒
		'''
	Burden: 自然回气 -10%。残心追斩挥空要多扣 2 点气力。剪刃自己剪出来的击杀，不会再触发一次
}

OniMeiRubbingShiohi: {
	DisplayName: 潮樋
	Tooltip: 踩着潮拍出刀回气、残心更重；错拍的连段略钝
	Origin: 开锋人是海边长大的，磨刀都按潮水的拍子来。他说潮有涨落，人的气也有：踩着涨潮出的刀，海会把力气还给你
	Power:
		'''
		「潮拍」气力笔道下有个 0.8 秒一轮的潮头，涨到顶那 0.2 秒是合潮窗
		合潮时出的连段，每一招首次砍中回 3 点气力；合潮时的残心追斩伤害 +8%
		'''
	Burden: 错拍出的连段伤害 -3%。合不合潮在你按下出招的那一刻就定了，砍中时再对上也不算
}

OniMeiRubbingShibori: {
	DisplayName: 痺雕
	Tooltip: 疾走穿身或大招硬挨都会反麻来手；架势获取 -15%
	Origin: 握刀的手被震麻了也不能松，这是学刀头一年就得吃的苦。雕这道铭的师傅把苦头反过来用：我麻一分，就叫碰我的那位麻十分
	Power:
		'''
		「痺反」疾走穿过敌人时，直接把它麻掉
		收不回手的招式演出中挨了接触伤，可以扣 15 点架势把那一击压到 85%，同时麻掉来手，之后歇 1.5 秒
		被麻的敌人 0.75 秒内移动变慢，普通敌人降到 90%，首领降到 98%，撞你的接触伤害也 -10%
		'''
	Burden: 平时的架势获取 -15%
}

OniMeiRubbingChinmei: {
	DisplayName: 镇鸣
	Tooltip: 敌方弹幕伤害 -12%、击退 -65%；架势获取 -15%
	Origin: 战阵上箭石乱飞，耳朵嗡一声人就慌了。刻这道铭的老兵只留下一句话：先镇住，站稳再动，飞来的东西就没那么疼
	Power: 「镇鸣」敌方弹幕打在你身上，伤害 -12%，击退只剩 35%
	Burden: 架势获取 -15%。纯贴身肉搏的场合，这道雕基本闲着
}

OniMeiRubbingAshidome: {
	DisplayName: 止足
	Tooltip: 站定 0.75 秒，下一记大招或第五拍 +25%
	Origin: 教剑的先生开课头一句：脚底下别晃。脚定了劲才存得住，存住的劲出手才有分量。这道铭替你记着这句开蒙话
	Power: 「止足」站定不动满 0.75 秒就蓄好一记，下一次第五拍、残心追斩、灭世一闪或终结乱舞伤害 +25%
	Burden: 招一出手就算用掉，挥空不退。走动会把攒的清空
}

OniMeiRubbingYoen: {
	DisplayName: 余炎
	Tooltip: 处决后地上留一片余烬，同时只留一片；气力上限 -5%
	Origin: 锻刀炉封火之后，炉膛里的余温还能焐一整夜。开锋人借这个理给刀留了一手：火熄了，烫没熄
	Power:
		'''
		「余烬」处决之后在焦点处留下一片余烬场，烧 3 秒
		同一个敌人每 0.75 秒被烫一次，伤害是一刀的 16%
		场只有一片，再处决就把它挪到新地方
		'''
	Burden: 气力上限 -5%。余烬场还在烧的时候，疾走耗气 +10%
}

ScrapBeacon: {
	DisplayName: 废钢信标
	Tooltip:
		'''
		在夜晚召唤废钢统帅
		"废料自会认领它的工头"
		'''
}

GaolCellKey: {
	DisplayName: 深牢禁室之钥
	Tooltip:
		'''
		就地筑起深牢禁室并安放蛰伏的枯颅（测试物品）
		"钥匙一转，墙就想起了自己的形状"
		'''
}

RustedGaolIrons: {
	DisplayName: 锈蚀的镣铐
	Tooltip:
		'''
		召唤深牢怨灵（测试物品）
		"铐环内侧的狱号已经磨平了"
		'''
}
