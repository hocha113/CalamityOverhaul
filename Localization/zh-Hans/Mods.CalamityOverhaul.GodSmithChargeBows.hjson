GsWoodenBow.Desc:
	'''
	重铸：持弓即蓄力，松手即放箭。半蓄之箭更快更痛，满蓄质变为木灵箭，过满命中裂为扇形箭雨
	弦上蓄力过久会失稳：回落满蓄威力，并附短暂疲劳
	'''
GsBorealWoodBow.Desc:
	'''
	重铸：三段引弓，满蓄质变，过满裂箭
	过满之箭凝着寒霜，命中冻滞较弱的敌人
	'''
GsPalmWoodBow.Desc:
	'''
	重铸：三段引弓，满蓄质变，过满裂箭
	过满之箭干燥利落，更易命中要害
	'''
GsRichMahoganyBow.Desc:
	'''
	重铸：三段引弓，满蓄质变，过满裂箭
	藤蔓多茎：过满命中多裂出一支木箭
	'''
GsEbonwoodBow.Desc:
	'''
	重铸：三段引弓，满蓄质变，过满裂箭
	过满之箭有几率点燃暗影焰
	'''
GsShadewoodBow.Desc:
	'''
	重铸：三段引弓，满蓄质变，过满裂箭
	过满之箭有几率割开血创，使敌持续失血
	'''
GsAshWoodBow.Desc:
	'''
	重铸：三段引弓，满蓄质变，过满裂箭
	过满之箭引燃敌人，迸散余烬
	'''
GsCopperBow.Desc:
	'''
	重铸：三段引弓，满蓄箭头淬火，命中迸溅金属火花并小范围波及
	过满加射一支免费副箭
	'''
GsTinBow.Desc:
	'''
	重铸：三段引弓，满蓄箭头淬火，命中迸溅金属火花并小范围波及
	过满加射一支免费副箭，火花更密
	'''
GsIronBow.Desc:
	'''
	重铸：三段引弓，满蓄箭头淬火，命中迸溅金属火花并小范围波及
	过满冲压箭：击退大增，短暂定住较弱的敌人
	'''
GsLeadBow.Desc:
	'''
	重铸：三段引弓，满蓄箭头淬火，命中迸溅金属火花并小范围波及
	过满冲压箭附铅毒：重击定滞并使敌中毒
	'''
GsSilverBow.Desc:
	'''
	重铸：三段引弓，满蓄箭头淬火，命中迸溅金属火花并小范围波及
	过满圣辉箭：命中后弹射向近旁的敌人，弹射一次
	'''
GsTungstenBow.Desc:
	'''
	重铸：三段引弓，满蓄箭头淬火，命中迸溅金属火花并小范围波及
	过满之箭可弹射两次，最后一击迸发小型爆裂
	'''
GsGoldBow.Desc:
	'''
	重铸：三段引弓，满蓄箭头淬火，命中迸溅金属火花并小范围波及
	过满王权箭更易暴击，暴击命中迸出几枚铜币
	'''
GsPlatinumBow.Desc:
	'''
	重铸：三段引弓，满蓄箭头淬火，命中迸溅金属火花并小范围波及
	过满金冠箭必定暴击，暴击迸出更多铜币
	'''
GsDemonBow.Desc:
	'''
	重铸：三段引弓。满蓄质变暗影箭，化为穿身的邪恶箭
	过满命中释出两缕追魂魔焰，缓缓追猎近旁的敌人
	'''
GsTendonBow.Desc:
	'''
	重铸：三段引弓。满蓄血栓箭割开血创，使敌持续失血
	过满血弦重击：箭体更沉，击退更猛，命中迸血珠并小口回血
	'''
GsBloodRainBow.Desc:
	'''
	重铸：箭矢依旧化作天降血雨。三段引弓
	满蓄追加四道血矢锁定准星落下，过满血洪八道，且主矢落点淤起血泊，踩踏减速滞敌
	'''
GsBeesKnees.Desc:
	'''
	重铸：木箭依旧化作蜂箭。三段引弓
	满蓄命中多放两只蜂，过满命中悬起蜂涡续放蜂群。同时最多驱使十二只蜂
	'''
GsHellwingBow.Desc:
	'''
	重铸：木箭依旧化作穿墙火蝠，引弓更快
	满蓄齐出三蝠成 V 字编队，过满六蝠螺旋散开再向前收拢
	'''
GsMoltenFury.Desc:
	'''
	重铸：木箭依旧化作烈焰箭。三段引弓
	满蓄熔核箭命中喷洒熔浆珠，过满火山术唤落五道熔雨砸向目标
	'''

GsChargeBleedBuff: {
	DisplayName: 放血
	Description: 血流不止
}
