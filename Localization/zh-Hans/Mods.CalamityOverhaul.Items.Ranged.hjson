AnnihilatingUniverse: {
	DisplayName: 湮宇星矢
	Tooltip:
		'''
		箭矢击中敌人后在原地留下一颗璀璨之星
		右键以噬神者之力摧毁敌人
		'''
}

BarrenBow: {
	DisplayName: 荒芜弓
	Tooltip: 发射出的箭矢在击中敌人时会爆发出荒芜电流
}

AvalancheM60: {
	DisplayName: 雪崩 M60
	Tooltip:
		'''
		使用雪球作为弹药
		发射大量雪球，火力随着弹药减少而变强
		每开火20次进入一次超频爆发，制造一次小型的雪崩
		"电次，我们来打雪仗吧"
		'''
}

CrystalDimming: {
	DisplayName: 冰河时代
	Tooltip:
		'''
		使用雪球作为弹药
		发射冰晶炮弹，命中处的大地上会拔起冰川晶柱
		晶柱在已有晶簇的附近会拔得更高
		右键释放冰河推进波，沿地表掀起一列不断增高的冰川山脊
		"大地记得每一次结冰"
		'''
}

DarkFrostSolstice: {
	DisplayName: 凛冬神性
	Tooltip:
		'''
		使用雪球作为弹药
		发射冰雹和极地幽火，攻击有概率冻住敌人
		每开火20次进入一次超频爆发，在鼠标处生成一个巨大的冰柱
		'''
}

SnowQuay: {
	DisplayName: 雪蝰
	Tooltip:
		'''
		使用雪球作为弹药
		按住左键鼓风吹雪，向敌人喷出密集的雪流
		吹雪的同时向压雪仓积蓄雪压
		松开左键时若雪压充足，将轰出一颗压实的大雪球
		"冬天的快乐，是从一台吹雪机开始的"
		'''
}

NeutronBow: {
	DisplayName: 洛希之弦
	Tooltip:
		'''
		发射重力箭矢，击中目标后生成数道伽马射线
		右键进行三级蓄力，蓄满能量后将发射三发强大的引力箭矢
		'''
	Lang1: 正在捕获重力
	Lang2: 正在使重力屈服
	Lang3: 就绪!!
}

NeutronGun: {
	DisplayName: 恒星猎手
	Tooltip:
		'''
		发射重力弹丸，击中目标后生成翘曲点
		右键切换为狙击形态，发射更为强大引力子弹，引力子弹击中目标后将让数道伽马射线降落
		每次开火都会给枪械充能，充能满格后再次开火会在鼠标处引发一次中子星爆炸
		"把太阳射下来!"
		'''
}

MG42: {
	DisplayName: MG42
	Tooltip:
		'''
		连续射击会让枪管过热
		将火枪子弹转化为穿甲弹
		'''
}

SnowQuayMK2: {
	DisplayName: 雪蝰MK2
	Tooltip:
		'''
		使用雪球作为弹药
		加装制冷压缩机的军用改型，把雪球压铸成高速冰锥
		左键三连点射冰锥钉，每组点射的最后一发为重锥，命中迸出冰晶
		右键超压霰射，扇形喷出一片短程冰锥
		"第二代雪蝰不再需要预热"
		'''
}

Starship: {
	DisplayName: 群星巨舰
	Tooltip:
		'''
		持续射击积累热度，射速随热度不断提升
		右键消耗弹药装填彗星弹，下次射击时发射，造成大量伤害并附加超级分解
		热度达到顶峰时，两架僚机开始伴飞并追踪射击星弹，同时周期性从身后抛出行星弹幕
		松开射击键触发终幕，14颗无视防御的追踪陨石与微型星系倾泻至鼠标位置
		'''
}

DuneStalker: {
	DisplayName: 荒漠猎行者
	Tooltip:
		'''
		发射一枚由锁链牵引的钩状枪头取代弹药本体
		枪头沿途持续撕扯敌人，命中或飞抵射程极限后自动回收
		'''
}

Snowblindness: {
	DisplayName: 雪盲症
	Tooltip:
		'''
		高频率发射雪球和极寒射线
		命中敌人后在四周生成数道EX极寒射线
		"迷失在暴雪中，永恒的等待，痛苦地图，弯道超车，
		冻裂的镜片，干涸的血迹，红色的冰，哭泣的海狸，冰中人影"
		'''
}

RaiderGun: {
	DisplayName: 突袭者
	Tooltip:
		'''
		将火枪子弹转化为高速子弹
		右键可以翻滚冲刺，并将弹匣填满
		翻滚后的第一发子弹会被转化为毁灭者榴弹
		"非常适合用于室内人质解救"
		'''
}

HyperionBarrage: {
	DisplayName: 海伯利昂自动炮
	Tooltip:
		'''
		发射热射巡航弹，命中处爆燃并点燃敌人
		每第四次扣动扳机改为垂直齐射三枚跃升导弹，俯冲扑向准星
		"物尽其用"
		'''
}

RaiderGunEX: {
	DisplayName: 突袭者EX
	Tooltip:
		'''
		将火枪子弹转化为高速子弹
		额外发射大量毁灭者归航弹
		右键可以翻滚冲刺，并将弹匣填满
		翻滚后的第一发子弹会被转化为毁灭者榴弹
		"狂轰滥炸"
		'''
}

Dicoria: {
	DisplayName: 重瞳
	Tooltip:
		'''
		发射双发子弹，射击可以蓄力
		蓄力满后会发射一道热能射线
		"话说我们这样会不会斗鸡眼"
		'''
}

BloodshotBomb: {
	DisplayName: 泣血瞳雷
	Tooltip:
		'''
		掷出克苏鲁炸弹轰炸敌人
		随着燃烧，引线长度会越来越短。同时爆炸会被逐渐增幅，迸出更多血肉
		引线燃尽时，它就会在你手里炸开
		"它舍不得你"
		'''
	SelfBoom: "{0}多看了一眼"
}

LaserPistol: {
	DisplayName: 镭射手枪
	Tooltip:
		'''
		消耗能量发射激光，穿透多个敌人
		"利用率并不高"
		'''
}

HyperionBarrageEX: {
	DisplayName: 海伯利昂自动炮EX
	Tooltip:
		'''
		发射重型巡航弹，殉爆时分裂为六枚自锁定的集束子弹
		"物超其用"
		'''
}

SporeBubbleBlaster: {
	DisplayName: 喷菇炮
	Tooltip: 喷射一串孢子气流
}

FungalRevolver: {
	DisplayName: 蘑菇左轮
	Tooltip:
		'''
		将火枪子弹转换为真菌子弹
		"洗干净后反而不能用了"
		'''
}

Pallbearer: {
	DisplayName: 扶柩者
	Tooltip:
		'''
		长按左键装填蓄力，射出近乎瞬发的重弩栓，贯穿猎物并留下血色烙印
		右键掷出棺弩，让棺椁的气息沾染客人
		同一目标积累三道烙印时，落棺收殓
		"也叫抬棺人"
		'''
}

UniversalFrost: {
	DisplayName: 万象霜天
	Tooltip:
		'''
		使用雪球作为弹药
		左键高速连发霜辉弹，每一发都为霜穹蓄能
		蓄能满后右键在光标上空展开极光霜幕
		霜幕会向幕下的敌人不断降下霜光贯击
		"当万象归于寂静，唯有极光仍在天际流转"
		'''
}

SneezingWyrm: {
	DisplayName: 嚏龙铳
	Tooltip:
		'''
		快速射出灼热的龙击弹
		连续射击让枪膛越烧越烫，弹色随之从橙红烧向蓝白
		每攒满一口气，龙会顺着弹道呵出一发蛇行寻敌的龙息弹
		龙鼻被烟气憋得发痒，间歇打个喷嚏，向侧面喷出一串浓烟
		"别站在它打喷嚏的那一侧"
		'''
}

TiroFinale: {
	DisplayName: 终焉圆舞曲
	Tooltip:
		'''
		同时享受远程与魔法伤害加成
		开火消耗弹药与魔力，每一发都会织出两支金色幻影燧发枪，环绕周身列阵
		枪阵至多八支，未满员时只列阵不开火
		阵满员后，每发主枪都会让最老的两支幻影枪紧随其后瞄准光标齐鸣
		幻影枪只响一发便散作金光，新枪随即原位补进
		右键收束阵中至少四支幻影枪，凝成一门巨炮奏响终曲，枪越多威力越大
		"礼数要周全，谢幕要盛大"
		'''
}

Undertow: {
	DisplayName: 潮渊
	Tooltip:
		'''
		将任意箭矢化为渊棘箭
		渊棘箭命中敌人时，水尾坍缩成小空化泡，再炸一次
		按住右键蓄力，拉满后松开，射出3倍伤害的渊压重箭
		重箭贯穿一切，沿途把敌人拽向弹道
		重箭停下时引爆一场空化内爆
		"海不推开你，它把你收进去"
		'''
}

Thornstring: {
	DisplayName: 棘弦
	Tooltip:
		'''
		将任意箭矢化为棘箭
		棘箭命中敌人时，向两侧崩出短针
		按住右键蓄力，拉满后松开，射出2.5倍伤害的贯穿重棘箭
		重棘箭每次命中与落点都会绽放一圈花瓣
		"弦是藤，箭是刺，弓是一株不肯枯的花"
		'''
}
