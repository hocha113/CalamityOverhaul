QuestNode: {
	FirstQuest: {
		DisplayName: 欢迎来到这个世界!
		Description: 旅途的起点
		DetailedDescription: 领取你的初始物资。这个世界有神明，也有怪物，而你现在两手空空。
		QuestObjective.Description: 点击领取初始道具
	}

	MiningQuest: {
		DisplayName: 挖掘起步
		Description: 获得十块{0}
		DetailedDescription: 工具得先有金属。地下的矿脉不会自己冒出来，得挖。
	}

	MiningQuestII: {
		DisplayName: 铁器时代
		Description: 收集五十块{0}
		DetailedDescription: 铜太软，砍两下就钝。铁矿埋得更深一些。
	}

	MiningQuestIII: {
		DisplayName: 黄金狂潮
		Description: 收集一百块{0}
		DetailedDescription: 黄金比铁软，但导魔性更好，延展性也更强。高级装备离不开它。
	}

	BrimstoneElementalQuest: {
		DisplayName: 硫磺火元素
		Description: 击败硫磺火元素
		DetailedDescription: 在硫磺火崖的废墟中，唤醒并击败那位沉睡的元素之灵。小心她的弹幕地狱。
	}

	CalamitasCloneQuest: {
		DisplayName: 灾厄之影
		Description: 击败灾厄之影
		DetailedDescription: 一个充满了仇恨与毁灭欲望的克隆体。连影子都打不过，就别想见到本人。
	}

	CrabulonQuest: {
		DisplayName: 菌生蟹
		Description: 击败菌生蟹
		DetailedDescription: 发光蘑菇地下生物群落中潜伏着一只被真菌寄生的巨蟹。它的孢子非常危险。
	}

	CryogenQuest: {
		DisplayName: 极地冰灵
		Description: 击败极地冰灵
		DetailedDescription: 曾经的御宇寒冰法师，被封在一块冰里。砸开它，它会带着一身冰晶醒过来。
	}

	DesertScourgeQuest: {
		DisplayName: 荒漠灾虫
		Description: 击败荒漠灾虫
		DetailedDescription: 曾经的海洋霸主如今在干涸的沙漠中苟延残喘。小心它巨大的颚部和随从。
	}

	EaterofWorldsQuest: {
		DisplayName: 世界吞噬者/克苏鲁之脑
		Description: 击败腐化或猩红之地的Boss
		QuestObjective.Description: 击败世界吞噬者或克苏鲁之脑
		DetailedDescription: 邪恶正在蔓延。深入世界的病灶，铲除盘踞在那里的巨型蠕虫或邪恶大脑。
	}

	EyeofCthulhuQuest: {
		DisplayName: 克苏鲁之眼
		Description: 击败克苏鲁之眼
		DetailedDescription: 只要你感到那股邪恶的注视，它就会出现。在夜里，从天上下来。
	}

	GolemQuest: {
		DisplayName: 石巨人
		Description: 击败石巨人
		DetailedDescription: 丛林神庙深处供奉着一台古老的战争机器。小心它的激光和重拳。
	}

	HiveMindQuest: {
		DisplayName: 腐巢意志/血肉宿主
		Description: 击败邪恶生物群落的真神
		QuestObjective.Description: 击败腐巢意志或血肉宿主
		DetailedDescription: 腐化和猩红各有一个脑子。不拔掉，蔓延就不会停。
	}

	KingSlimeQuest: {
		DisplayName: 史莱姆王
		Description: 击败史莱姆王
		DetailedDescription: 凝胶生物的统御者。虽然看起来有些滑稽，但不要被它巨大的体型压扁了。
	}

	LunaticCultistQuest: {
		DisplayName: 拜月教邪教徒
		Description: 击败拜月教邪教徒
		DetailedDescription: 在地牢门口，一群狂热的信徒正在试图阻止或引发末日。阻止他们的仪式。
	}

	MechanicalBossesQuest: {
		DisplayName: 机械三王
		Description: 击败所有机械Boss
		QuestObjective.Description: 击败所有机械Boss
		DetailedDescription: 有人用钢铁复刻了克苏鲁的器官。一对眼睛、一颗头骨、一条长虫。
	}

	MoonLordQuest: {
		DisplayName: 月球领主
		Description: 击败月球领主
		DetailedDescription: 这一切背后的幕后黑手，月球背面的恐怖。它的眼睛不长在该长的地方。
	}

	PlaguebringerGoliathQuest: {
		DisplayName: 瘟疫使者歌莉娅
		Description: 击败瘟疫使者歌莉娅
		DetailedDescription: 一只被纳米机械病毒改造的蜂后。它身上带着瘟疫，被蛰过之后还会继续掉血。
	}

	PlanteraQuest: {
		DisplayName: 世纪之花
		Description: 击败世纪之花
		DetailedDescription: 丛林深处沉睡着一朵巨大的食人花。打破花苞，面对丛林的愤怒。
	}

	SkeletronQuest: {
		DisplayName: 骷髅王
		Description: 击败骷髅王
		DetailedDescription: 只有击败这个被诅咒的老人，你才能安全地进入地牢探寻其中的秘密。
	}

	SlimeGodQuest: {
		DisplayName: 史莱姆之神
		Description: 击败史莱姆之神
		DetailedDescription: 史莱姆这一物种的顶点，古老而贪婪的神明。小心它的分身合击。
	}

	WallofFleshQuest: {
		DisplayName: 血肉墙
		Description: 击败血肉墙
		DetailedDescription: 世界的守门人。将向导的玩偶投入岩浆，释放这个世界的古老神灵，开启困难模式。
	}

	CeaselessVoidQuest: {
		DisplayName: 无尽虚空
		Description: 击败无尽虚空
		DetailedDescription: 神明吞噬者的哨兵之一，来自异维度的虚无之镜。
	}

	DevourerofGodsQuest: {
		DisplayName: 神明吞噬者
		Description: 击败神明吞噬者
		DetailedDescription: 一条渴望吞噬一切神性的宇宙之蛇。在虚空中与它决战，不要让它把你吞下。
	}

	DragonfollyQuest: {
		DisplayName: 痴愚金龙
		Description: 击败痴愚金龙
		DetailedDescription: 试图复活犽戎的失败产物，疯狂而带电的伪龙。
	}

	ExoMechsQuest: {
		DisplayName: 星流巨械
		Description: 击败星流巨械
		DetailedDescription: 嘉登造过的最好的东西。三台一起上，他自己站在旁边看。
	}

	OldDukeQuest: {
		DisplayName: 硫海遗爵
		Description: 击败硫海遗爵
		DetailedDescription: 硫磺海深处的古老霸主，变异与力量的结合体。小心它的剧毒蒸汽。
	}

	PolterghastQuest: {
		DisplayName: 噬魂幽花
		Description: 击败噬魂幽花
		DetailedDescription: 那些在地牢中死去的冤魂聚集而成的怪物。平息它们的愤怒。
	}

	PrimordialWyrmQuest: {
		DisplayName: 始源妖龙
		Description: 击败始源妖龙
		DetailedDescription: 深渊最底层的守护者。它是比神明更古老的存在，非必要请勿打扰。
	}

	ProfanedGuardiansQuest: {
		DisplayName: 亵渎使徒
		Description: 击败亵渎使徒
		DetailedDescription: 亵渎天神的忠诚守卫，击败它们以削弱女神的防御。
	}

	ProvidenceQuest: {
		DisplayName: 亵渎天神
		Description: 击败亵渎天神
		DetailedDescription: 掌控圣火与净化的女神。在神圣之地或地狱挑战她，但要小心被圣火焚尽。
	}

	SignusQuest: {
		DisplayName: 西格纳斯
		Description: 击败西格纳斯
		DetailedDescription: 神明吞噬者的哨兵之一，无形的刺客，虚空的幽灵。
	}

	StormWeaverQuest: {
		DisplayName: 风暴编织者
		Description: 击败风暴编织者
		DetailedDescription: 神明吞噬者的哨兵之一，以雷暴和闪电为食的空之虫。
	}

	SupremeCalamitasQuest: {
		DisplayName: 至尊灾厄
		Description: 击败至尊灾厄
		DetailedDescription: 硫火女巫本人。前面那些克隆体是她随手捏的。屏幕会被填满。
	}

	YharonQuest: {
		DisplayName: 丛林龙,犽戎
		Description: 击败丛林龙,犽戎
		DetailedDescription: 魔君的忠诚战友，拥有凤凰般重生能力的巨龙。打倒它一次不算完。
	}

	BatteryQuest: {
		DisplayName: 能源储存
		Description: 制作热能电池
		DetailedDescription: 电力生产出来后需要储存。制作电池是构建稳定电力网络的第一步。
	}

	HydroelectricQuest: {
		DisplayName: 清洁能源
		Description: 制作一台水力发电机
		DetailedDescription: 用流水发电。不烧燃料，只要水一直流，它就一直转。
	}

	IndustrialStartQuest: {
		DisplayName: 工业革命
		Description: 制作一台风力发电机
		DetailedDescription: 用风力驱动机器。这是第一台不用你守着的机器。
	}

	ItemFilterQuest: {
		DisplayName: 物流筛选
		Description: 制作一个物品过滤器
		DetailedDescription: 自动化产线需要秩序。使用过滤器来精准控制物品的流向。
	}

	MiningMachineQuest: {
		DisplayName: 自动化挖掘
		Description: 制作一台采矿机
		DetailedDescription: 不用再自己挖了。把它放在矿脉上，它会一直往下啃。
	}

	MiningMachineIIQuest: {
		DisplayName: 深层钻探
		Description: 制作一台采矿机MK2
		DetailedDescription: 动力核心换了，钻头转得更快。
	}

	PipelineQuest: {
		DisplayName: 能量传输
		Description: 制作通用能源管道
		DetailedDescription: 连接发电机与机器的血管。没有它，电力只是一潭死水。
	}

	TeslaTowerQuest: {
		DisplayName: 磁暴高塔
		Description: 制作一座特斯拉电磁塔
		DetailedDescription: 无线输电的杰作。这座塔能隔空送电，省掉一大半线。
	}

	ThermalPowerQuest: {
		DisplayName: 燃烧时刻
		Description: 制作一台火力发电机
		DetailedDescription: 燃烧燃料以获取大量电力。虽然不环保，但在早期它是最可靠的能源。
	}

	AnnihilatingUniverseQuest: {
		DisplayName: 寰宇湮灭
		Description: 获得“寰宇湮灭”
		DetailedDescription: 把一个星系压在弓弦上。拉满的时候，弓比箭更危险。
	}

	AriaofTheCosmosQuest: {
		DisplayName: 寰宇咏叹调
		Description: 获得“寰宇咏叹调”
		DetailedDescription: 演奏群星的乐章。这本魔法书能召唤黑洞与类星体，让敌人在宇宙的歌声中消逝。
	}

	NeutronBowQuest: {
		DisplayName: 中子弓
		Description: 获得中子弓
		DetailedDescription: 由中子星核心碎片打造的弓。每一箭都带着坍缩恒星的重力。
	}

	NeutronGlaiveQuest: {
		DisplayName: 中子战刃
		Description: 获得中子战刃
		DetailedDescription: 密度惊人的长柄武器。挥舞它需要巨大的力量，但没有任何护甲能阻挡它的斩击。
	}

	NeutronGunQuest: {
		DisplayName: 中子枪
		Description: 获得中子枪
		DetailedDescription: 发射微型中子流的枪械。由于其极高的密度，子弹几乎不会受到阻力影响。
	}

	NeutronScytheQuest: {
		DisplayName: 中子镰刀
		Description: 获得中子镰刀
		DetailedDescription: 死神的收割工具。它能轻易撕裂空间，像收割麦子一样收割生命。
	}

	NeutronStarIngotQuest: {
		DisplayName: 中子星锭
		Description: 获得中子星锭
		DetailedDescription: 宇宙中密度最大的物质之一。这块金属沉重得难以想象，散发着引力波动的嗡鸣。
	}

	NeutronWandQuest: {
		DisplayName: 中子杖
		Description: 获得中子杖
		DetailedDescription: 掌控重力的法杖。利用中子星的力量扭曲时空，粉碎你的敌人。
	}

	PandemoniumQuest: {
		DisplayName: 万魔殿
		Description: 获得“万魔殿”
		DetailedDescription: 无数灵魂熔在一起铸成的武器。握久了，能听见它们还在说话。
	}

	RockQuest: {
		DisplayName: 古恒石
		Description: 获得古恒石
		DetailedDescription: 一块看起来很普通的石头，从上一个终末里剩下来的。
	}

	TerminusQuest: {
		DisplayName: 终末石
		Description: 获得终末石
		DetailedDescription: 开启终末挑战的钥匙。捏碎它，世界上最强的东西会排着队来找你。
	}

	SpearOfLonginusQuest: {
		DisplayName: 朗基努斯
		Description: 获得朗基努斯
		DetailedDescription: 刺穿过神明的圣枪。力场、护盾、绝对领域，它一概不认。
	}

	DragonsWordQuest: {
		DisplayName: 龙言
		Description: 获得龙言
		DetailedDescription: 龙一生只流一次眼泪，那是死亡之时
	}

	RockQuestII: {
		DisplayName: 征战轮回
		Description: 通过终末之战五次，获得五块以上的古恒石
		DetailedDescription: 真正战士的象征
	}

	AdventurerQuests: {
		DisplayName: 冒险家
		Description: 世界任我走！
		QuestObjective.Description: 点击领取
		DetailedDescription: 穿上这双靴子。世界很大，脚程要紧。
	}

	ExploreDungeon: {
		DisplayName: 阴森地牢
		Description: 发现地牢入口
		QuestObjective.Description: 到达地牢
		DetailedDescription: 被诅咒的砖墙后面关着地牢的守卫。没打过骷髅王就进去的人，一般出不来。
	}

	ExploreHell: {
		DisplayName: 地狱深渊
		Description: 深入地狱
		QuestObjective.Description: 到达地狱
		DetailedDescription: 世界的最深处流淌着熔岩之河。那是恶魔的家园，也是黑曜石与狱石的产地。记得看路，别掉进去了。
	}

	ExploreJungle: {
		DisplayName: 丛林探险
		Description: 深入丛林生物群落
		QuestObjective.Description: 到达丛林
		DetailedDescription: 生机勃勃却又危机四伏的绿色迷宫。茂密的植被下掩盖着古老的庙宇和致命的蜂群。
	}

	ExploreOcean: {
		DisplayName: 世界尽头
		Description: 到达海洋生物群落
		QuestObjective.Description: 到达海洋
		DetailedDescription: 大陆的边缘。在这里，天与海交汇。深邃的蓝色之下埋藏着沉船与未知的海怪。
	}

	ExploreSnow: {
		DisplayName: 极寒之地
		Description: 探索雪原生物群落
		QuestObjective.Description: 到达雪原
		DetailedDescription: 常年冻着的地方，风大得站不稳。企鹅和狼都住在这儿，前者无害，后者不是。
	}

	ExploreSpace: {
		DisplayName: 星辰大海
		Description: 飞向太空
		QuestObjective.Description: 到达太空
		DetailedDescription: 摆脱重力的束缚，触摸群星。只有飞得够高，你才能看清这个世界的全貌。
	}

	HellLabSchematic: {
		DisplayName: 地狱蓝图
		Description: 在地狱嘉登实验室寻找加密图纸
		QuestObjective.Description: 获取地狱图纸
		DetailedDescription: 嘉登在地狱建立了一座前哨站，利用这里的地热进行实验。找到那里的图纸，或许能解锁新的武器科技。
	}

	IceLabSchematic: {
		DisplayName: 极地密码
		Description: 在雪原嘉登实验室寻找加密图纸
		QuestObjective.Description: 获取冰冻图纸
		DetailedDescription: 这里的低温是保存精密仪器的绝佳环境。深入冰原下的实验室，寻找那份被封存的极地科技。
	}

	JungleLabSchematic: {
		DisplayName: 丛林原案
		Description: 在丛林嘉登实验室寻找加密图纸
		QuestObjective.Description: 获取丛林图纸
		DetailedDescription: 茂密的丛林掩盖了嘉登的生物实验室。他在那里研究瘟疫与纳米病毒。找到那份图纸，揭开危险的真相。
	}

	PlanetoidLabSchematic: {
		DisplayName: 星流之谜
		Description: 在小行星嘉登实验室寻找加密图纸
		QuestObjective.Description: 获取小行星图纸
		DetailedDescription: 在高空的微重力环境下，嘉登的一座实验室正静静漂浮。去那里寻找关于星流巨械的早期设计图。
	}

	SunkenSeaLabSchematic: {
		DisplayName: 沉沦之海
		Description: 在沉沦之海嘉登实验室寻找加密图纸
		QuestObjective.Description: 获取沉沦之海图纸
		DetailedDescription: 在这片宁静的地下海中，嘉登遗留了一些关于棱晶能源的研究。潜入水下，取回那些宝贵的数据。
	}

	AquaticScourgeQuest: {
		DisplayName: 渊海灾虫
		Description: 击败渊海灾虫
		DetailedDescription: 曾经是清澈海洋中的和平巨兽，如今被硫磺海的剧毒所扭曲。在这片被污染的酸蚀海域中，小心它突如其来的冲撞和剧毒的云雾。
	}

	QueenSlimeQuest: {
		DisplayName: 史莱姆皇后
		Description: 击败史莱姆皇后
		DetailedDescription: 神圣之地的水晶女皇，统御着所有圣洁的凝胶生物。比起她的配偶，她更加敏捷致命，而且会飞。
	}

	BuildHouse: {
		DisplayName: 建筑大师
		Description: 建造合适的房屋
		QuestObjective.Description: 建造一个有效房屋
		DetailedDescription: 每个人都需要一个避风港。无论是向导还是其他流浪者，只要你提供一个拥有桌椅、光源和墙壁的房间，他们就会为你效力。
	}

	CollectEvilOres: {
		DisplayName: 邪恶矿藏
		Description: 收集邪恶矿石
		QuestObjective.Description: 收集魔矿或猩红矿
		DetailedDescription: 这种矿石散发着不祥的气息，触感冰冷且黏稠。虽然它们来自这个世界的病灶，但却是制作强力装备必不可少的材料。
	}

	CollectFallenStars: {
		DisplayName: 星辰收集者
		Description: 收集坠落之星
		QuestObjective.Description: 收集坠落之星
		DetailedDescription: 它们是夜空的眼泪，只有在夜晚才会从天而降。收集它们，不仅可以增加你的法力上限，还能作为强大的弹药或魔法材料。
	}

	CollectGems: {
		DisplayName: 宝石收藏家
		Description: 收集各种宝石
		QuestObjective.Description: 收集5种不同的宝石
		DetailedDescription: 埋藏在岩层中的璀璨结晶。除了作为装饰，它们也是制作法杖和抓钩的重要材料。当你集齐不同颜色的宝石时，也许能拼凑出彩虹的光辉。
	}

	CollectHerbs: {
		DisplayName: 草药学徒
		Description: 收集各种草药
		QuestObjective.Description: 收集3种不同的草药
		DetailedDescription: 炼金术的基础。不同的植物生长在不同的环境下：沙漠、雪原、甚至地狱。学会辨认它们，是成为炼金大师的第一步。
	}

	CollectOres: {
		DisplayName: 矿石采集
		Description: 收集基础矿石

		QuestObjective: {
			Description: {
				Iron: 收集铁矿或铅矿
				Copper: 收集铜矿或锡矿
			}
		}

		DetailedDescription: 挖掘是生存的根本。铜和铁虽然普通，但它们是你摆脱原始生活的基石。不要嫌弃它们，哪怕是传说中的英雄也是从挥舞铜镐开始的。
	}

	DeepExplorer: {
		DisplayName: 深渊探索者
		Description: 探索所有主要生物群落
		QuestObjective.Description: 完成所有探索任务
		DetailedDescription: 你已经走遍了世界的每一个角落，从最高的云端到最深的地狱。地图上再没有空白了。
	}

	ExploreCaverns: {
		DisplayName: 洞穴深处
		Description: 探索更深的洞穴层
		QuestObjective.Description: 到达洞穴层
		DetailedDescription: 这里没有阳光，只有黑暗和未知的生物。岩浆开始出现，矿藏也变得更加丰富。小心脚下，深渊在凝视着你。
	}

	ExploreCorruption: {
		DisplayName: 腐化之地
		Description: 探索腐化或猩红之地
		QuestObjective.Description: 进入腐化或猩红
		DetailedDescription: 这片土地病了。紫色的腐化或红色的血肉正在吞噬大地。尽管这里充满了嗜血的怪物，但只有深入虎穴，才能获得暗影鳞片或组织样本。
	}

	ExploreDesert: {
		DisplayName: 炎热荒漠
		Description: 踏入沙漠生物群落
		QuestObjective.Description: 到达沙漠
		DetailedDescription: 烈日灼烧着大地，金色的沙海下掩埋着古老的化石和凶猛的蚁狮。准备好充足的水，这里的干燥会夺走你的生命。
	}

	ExploreFloatingIsland: {
		DisplayName: 浮空岛屿
		Description: 找到天空中的浮空岛
		QuestObjective.Description: 到达浮空岛
		DetailedDescription: 云层之上飘着几座岛，上面有古代文明留下的宝库。找到重力反常的地方，或者自己搭塔上去。
	}

	ExploreGlowingMushroom: {
		DisplayName: 发光蘑菇
		Description: 找到发光蘑菇生物群落
		QuestObjective.Description: 到达蘑菇地
		DetailedDescription: 一个充满了迷幻色彩的地下生态。巨大的真菌发出蓝色的幽光，照亮了黑暗。这里是松露人和奇特虫子的家园。
	}

	ExploreUnderground: {
		DisplayName: 地下探险
		Description: 深入地下洞穴
		QuestObjective.Description: 到达地下洞穴
		DetailedDescription: 泥土层下面是石头层。带够火把，往下还有很多层。
	}

	FindLifeCrystal: {
		DisplayName: 生命之源
		Description: 寻找生命水晶
		QuestObjective.Description: 找到生命水晶
		DetailedDescription: 这种红色的水晶蕴含着生命力。打碎并使用它，能永久强健你的体魄。这是你在面对强大敌人时生存的关键。
	}

	FindShadowOrb: {
		DisplayName: 邪恶核心
		Description: 在邪恶之地深处寻找暗影珠或猩红之心
		QuestObjective.Description: 摧毁暗影珠或猩红之心
		DetailedDescription: 在邪恶裂隙的深处，搏动着腐败的心脏或暗影的球体。敲碎它们能获得武器，但要注意......如果你敲碎了三个，将会唤醒一些可怕的东西。
	}

	FirstPotion: {
		DisplayName: 炼金入门
		Description: 制作你的第一瓶药水
		QuestObjective.Description: 制作任意药水
		DetailedDescription: 将空瓶放在桌子上，你就有了一个简易的炼金站。并不需要复杂的咒语，只需要正确的材料混合。喝下去，感受魔法的力量。
	}

	NPCVillage: {
		DisplayName: 繁荣村落
		Description: 吸引多位NPC入住
		QuestObjective.Description: 拥有5位NPC
		DetailedDescription: 一个人在野外生存是孤独的。当你变得强大，持有更多的货币时，更多的人会慕名而来。建立一个繁荣的社区，让他们成为你的后盾。
	}

	QueenBeeQuest: {
		DisplayName: 蜂后
		Description: 击败蜂后
		DetailedDescription: 深入地下丛林的巨大蜂巢，打破其中的幼虫将会激怒整个蜂群的统治者。准备好抗毒药剂，小心她的毒刺和极速冲撞。
	}

	CollectorQuest: {
		DisplayName: 收集助手
		Description: 获得收集者
		DetailedDescription: 这个装置能自动拾取周围的掉落物，是自动化物流的入口。地上的东西不用再一件件捡。
	}

	LumberjackQuest: {
		DisplayName: 伐木时间
		Description: 获得伐木者
		DetailedDescription: 木材是工业与建筑的基石。告别原始的斧头，这台机器能通过消耗电力来自动化管理你的林场，确保持续不断的木材供应。
	}

	LifeWeaverQuest: {
		DisplayName: 植树造林
		Description: 获得植树者
		DetailedDescription: 森林的再生通常漫长而缓慢。这台机器能利用电力将树苗精准地植入土壤，让荒芜的土地迅速重焕生机。它是构建全自动循环林场的最后一块拼图。
	}

	IncineratorQuest: {
		DisplayName: 电动熔炼
		Description: 制作一台电力焚化炉
		DetailedDescription: 传统的熔炉效率低下，浪费了大量的矿物精华。这台机器利用高压电弧产生的极高温度，能将矿石彻底分解，提取出比以往多一倍的成品。这是迈向工业化的关键一步。
	}

	ItemPipelineQuest: {
		DisplayName: 物流系统
		Description: 制作一个物品管道
		DetailedDescription: 管道是工业的血管。接在机器和容器之间，物品会自己走到该去的地方，不用你再在箱子之间跑来跑去。
	}

	ThrowerQuest: {
		DisplayName: 投掷助手
		Description: 制作一个投掷者
		DetailedDescription: 并非所有物品都值得被珍藏。这个装置能将物品从物流网络中排出，将其抛掷到世界中。无论是为了特定的自动化合成（比如将物品丢入液体），还是单纯地作为垃圾排放口，它都能完美胜任。
	}

	DeerclopsQuest: {
		DisplayName: 巡游怪
		Description: 击败巡游怪
		DetailedDescription: 暴风雪的深处站着一只独眼巨鹿。它不主动找你，是你非要去找它。
	}

	DukeFishronQuest: {
		DisplayName: 猪龙鱼公爵
		Description: 击败猪龙鱼公爵
		DetailedDescription: 用松露虫做饵，海里会咬钩一位公爵。猪、龙、鱼，三种凶相长在同一张脸上。
	}

	EmpressOfLightQuest: {
		DisplayName: 光之女皇
		Description: 击败光之女皇
		DetailedDescription: 踩死神圣之地的七彩蝶，愤怒的女皇会亲自来讨说法。若在白昼激怒她，任何攻击都是一击致命。
	}

	ZenithQuest: {
		DisplayName: 天顶剑
		Description: 锻造天顶剑
		DetailedDescription: 从铜短剑到弑星者，你挥过的每一把剑都记得你。把它们熔在一起，这段旅途就有了形状。
	}

	BloodMoonQuest: {
		DisplayName: 血色之夜
		Description: 经历一次血月
		QuestObjective.Description: 经历一次血月
		DetailedDescription: 月亮变红的晚上，怪物不再敲门，它们直接开门。活过这一夜，天亮见。
	}

	TorchGodQuest: {
		DisplayName: 火把神
		Description: 通过火把神的试炼
		QuestObjective.Description: 获得火把神的恩宠
		DetailedDescription: 在地下插满一百支火把，火焰的主人会亲自考验你。熄灭的火光里藏着它的恩宠。
	}

	GoblinArmyQuest: {
		DisplayName: 哥布林入侵
		Description: 击退哥布林军队
		QuestObjective.Description: 击退哥布林军队
		DetailedDescription: 打碎暗影珠会引来它们，人多了也会。矮小、成群、没完没了，但打赢了能捡到一位会修装备的俘虏。
	}

	OldOnesArmyQuest: {
		DisplayName: 旧日军团
		Description: 守住埃特尼亚水晶，击退旧日军团三个阶段

		QuestObjective: {
			Description: {
				T1: 击退旧日军团 一阶
				T2: 击退旧日军团 二阶
				T3: 击退旧日军团 三阶
			}
		}

		DetailedDescription: 酒馆老板带来了异世界的求援。摆好水晶，守住传送门，别让任何东西碰到它。三个梯队，一波比一波狠。
	}

	PirateInvasionQuest: {
		DisplayName: 海盗入侵
		Description: 击退海盗入侵
		QuestObjective.Description: 击退海盗入侵
		DetailedDescription: 世界变硬之后，海平面上开始出现帆影。他们抢钱，你抢回来，顺便连船长的家当一起。
	}

	SolarEclipseQuest: {
		DisplayName: 日食讨伐
		Description: 在日食中击杀蛾怪
		QuestObjective.Description: 击杀蛾怪
		DetailedDescription: 月亮挡住太阳的日子，白天比夜晚更危险。恐怖电影里的东西全都上街了，其中飞得最快的那只叫蛾怪。
	}

	MartianMadnessQuest: {
		DisplayName: 火星暴乱
		Description: 击退火星人入侵
		QuestObjective.Description: 击退火星人入侵
		DetailedDescription: 别盯着天上的探测器看，它会回家叫人。飞碟、死光、脑控头盔，全套外星入侵的排场。
	}

	PumpkinMoonQuest: {
		DisplayName: 南瓜月
		Description: 在南瓜月中击败南瓜王
		QuestObjective.Description: 击败南瓜王
		DetailedDescription: 用南瓜月勋章唤醒万圣夜。稻草人排着队来收人头，压轴登场的是提着双镰的南瓜王。
	}

	FrostMoonQuest: {
		DisplayName: 霜月
		Description: 在霜月中击败冰雪女王
		QuestObjective.Description: 击败冰雪女王
		DetailedDescription: 拆开那份不该拆的礼物，圣诞夜就变了味。坦克在雪地里巡逻，女王在暴雪里俯冲。
	}

	FishermanQuest: {
		DisplayName: 渔夫的委托
		Description: 完成五次渔夫委托
		QuestObjective.Description: 完成渔夫委托
		DetailedDescription: 海边住着个使唤人的小鬼，但他给的报酬意外地实在。鱼在哪儿，宝贝就在哪儿。
	}

	LifeMaxQuest: {
		DisplayName: 生命之泉
		Description: 将生命上限提升到400
		QuestObjective.Description: 生命上限达到400
		DetailedDescription: 红心水晶只能带你走到一半。剩下的路，要靠不断的战斗与成长。四百点生命是站稳硬模式的门票。
	}

	ManaMaxQuest: {
		DisplayName: 魔力之心
		Description: 将魔力上限提升到200
		QuestObjective.Description: 魔力上限达到200
		DetailedDescription: 把坠落之星压成水晶，一颗一颗喂给自己。二十点一口，喝满九口，星空就在你血管里。
	}

	WingsQuest: {
		DisplayName: 展翅高飞
		Description: 装备任意一对翅膀
		QuestObjective.Description: 装备翅膀
		DetailedDescription: 云端的宝库、精灵的羽毛、恶魔的皮膜。不管哪种来路，背上长翅膀的那一刻，摔落伤害就成了历史。
	}

	MoneyQuest: {
		DisplayName: 第一桶金
		Description: 持有一枚铂金币
		QuestObjective.Description: 持有铂金币
		DetailedDescription: 一百个金币压成一枚铂金币。攒出它的路上，你大概已经死过很多次了，商人管这叫手续费。
	}

	ExploreAetherQuest: {
		DisplayName: 微光之湖
		Description: 找到微光湖
		QuestObjective.Description: 到达微光湖
		DetailedDescription: 世界的角落里藏着一汪不属于这里的湖。东西丢进去，捞上来就变了样子。别自己跳进去试。
	}

	HardmodeOresQuest: {
		DisplayName: 三色新矿
		Description: 收集硬模式的三阶矿石

		QuestObjective: {
			Description: {
				T1: 收集钴矿或钯金矿
				T2: 收集秘银矿或山铜矿
				T3: 收集精金矿或钛金矿
			}
		}

		DetailedDescription: 血肉墙倒下后，用神锤砸碎祭坛，地底会长出三种新的金属。它们比先前的一切都更硬。
	}

	ChlorophyteQuest: {
		DisplayName: 叶绿之力
		Description: 收集三十块叶绿矿
		DetailedDescription: 机械造物倒下后，丛林深处的泥土里开始生长会发光的绿色金属。它有自己的意志，还会自己繁殖。
	}

	CalamityLoreHub: {
		DisplayName: 异变调查
		Description: 这个世界不太对劲
		QuestObjective.Description: 点击领取
		DetailedDescription: 海是酸的，崖在烧，星星砸出的坑里长着不认识的东西。把见闻记下来，这个世界的暗面比想象中大得多。
	}

	ExploreSulphurSea: {
		DisplayName: 硫磺之海
		Description: 探索硫磺海
		QuestObjective.Description: 到达硫磺海
		DetailedDescription: 世界的一侧没有蓝色的海，只有泛黄的酸水。雨落进去会冒泡，鱼游上来带着毒。捂住口鼻，别喝水。
	}

	ExploreAbyss: {
		DisplayName: 深渊入口
		Description: 潜入硫磺海下的深渊
		QuestObjective.Description: 进入深渊
		DetailedDescription: 硫磺海底裂着一道往下的口子。光下不去，呼吸也下不去，越深的地方住着越古老的东西。
	}

	AbyssDeepQuest: {
		DisplayName: 深渊之底
		Description: 从深渊带回流明晶与虚空石
		DetailedDescription: 浅层的矿灯照不到的地方，岩壁上长着发蓝光的结晶。挖到它们再活着浮上来，才算真正下过深渊。
	}

	ExploreSunkenSea: {
		DisplayName: 沉沦之海
		Description: 找到地下荒漠深处的沉沦之海
		QuestObjective.Description: 到达沉沦之海
		DetailedDescription: 荒漠地底藏着一片安静的蓝。棱晶在水里发光，蛤蜊比你的房子还大。这里大概是这个世界最温柔的角落。
	}

	ExploreBrimstoneCrag: {
		DisplayName: 硫磺火崖
		Description: 踏入地狱边缘的硫磺火崖
		QuestObjective.Description: 到达硫磺火崖
		DetailedDescription: 地狱的一侧立着烧了不知多少年的崖壁。砖石的缝隙里渗出暗红的火，废墟的深处睡着一位元素之灵。
	}

	ExploreAstral: {
		DisplayName: 星染之地
		Description: 探索被星辉污染的土地
		QuestObjective.Description: 到达星染之地
		DetailedDescription: 一颗星星砸进世界，坑里长出的东西不属于任何图鉴。土地在变色，生物在变形，而这只是个开始。
	}

	AcidRainQuest: {
		DisplayName: 酸雨将至
		Description: 经历一场酸雨
		QuestObjective.Description: 经历酸雨事件
		DetailedDescription: 硫磺海上空的云是黄的。下雨的时候整片海都在沸腾，水里的东西会顺着雨爬上岸。带把伞，认真的。
	}

	DeliciousMeatQuest: {
		DisplayName: 美味肉排
		Description: 获得一块美味肉排
		DetailedDescription: 没人知道它是什么动物身上的肉，也没人在乎。好吃，管饱，还能当建材。多囤点。
	}

	BrimlishQuest: {
		DisplayName: 硫磺鱼
		Description: 钓起一条硫磺鱼
		DetailedDescription: 连酸水里都有鱼活着，而且长得意外地精神。把鱼钩抛进硫磺海，看看会咬上来什么。
	}

	GiantClamQuest: {
		DisplayName: 巨像蛤
		Description: 击败巨像蛤
		DetailedDescription: 沉沦之海最大的一枚贝壳。平时安静得像块石头，撬开它的人都后悔了。
	}

	CragmawMireQuest: {
		DisplayName: 泥沼颚吻
		Description: 在酸雨中击败泥沼颚吻
		DetailedDescription: 世界变硬后，酸雨里会浮上来一坨会咬人的淤泥。它长了太多牙，而且都朝着你。
	}

	MaulerQuest: {
		DisplayName: 血咬鲨
		Description: 在酸雨中击败血咬鲨
		DetailedDescription: 酸水泡大的鲨鱼，脾气和酸度成正比。它跃出水面的时候，记得已经太晚了。
	}

	NuclearTerrorQuest: {
		DisplayName: 核之恐惧
		Description: 在酸雨中击败核之恐惧
		DetailedDescription: 酸雨的最深处孵着一只发光的庞然大物。它走过的地方连酸水都会退开。
	}

	GreatSandSharkQuest: {
		DisplayName: 巨型沙鲨
		Description: 击败巨型沙鲨
		DetailedDescription: 沙漠里最快的猎手，沙丘是它的海面。杀够它的同类，族群的王者会亲自出面。
	}

	LeviathanQuest: {
		DisplayName: 阿娜希塔与利维坦
		Description: 击败阿娜希塔与利维坦
		DetailedDescription: 歌声先来，巨影后到。海妖的乐曲是给深海巨兽引路的，别停下来听。
	}

	AstrumAureusQuest: {
		DisplayName: 白金星舰
		Description: 击败白金星舰
		DetailedDescription: 星染之地深处趴着一台被感染的巨型机械。夜里它会醒，履带碾过的地方寸草不生。
	}

	RavagerQuest: {
		DisplayName: 毁灭魔像
		Description: 击败毁灭魔像
		DetailedDescription: 血肉与砖石拼出来的巨人，每个部件都会单独攻击。拆完它的四肢，本体才会认真起来。
	}

	AstrumDeusQuest: {
		DisplayName: 星神游龙
		Description: 击败星神游龙
		DetailedDescription: 在星染祭坛献上供品，星空里会游下来一条被感染的神明。杀死它，星染的矿脉才会向你敞开。
	}

	BossRushQuest: {
		DisplayName: 终末之战
		Description: 通过一次终末之战
		QuestObjective.Description: 完成终末之战
		DetailedDescription: 捏碎终末石，你杀过的所有东西会排着队回来找你。全部再杀一遍，才算给这段旅途盖章。
	}

	AerialiteQuest: {
		DisplayName: 天蓝之辉
		Description: 锻造天蓝锭
		DetailedDescription: 荒漠灾虫死后，天上会落下淡蓝色的矿尘。它轻得能浮起来，却比铁更结实。
	}

	CryonicQuest: {
		DisplayName: 极寒结晶
		Description: 锻造极寒神锭
		DetailedDescription: 冰灵碎裂后，雪原深处的坚冰里开始析出蓝色的矿脉。握在手里不化，反而更冷。
	}

	PerennialQuest: {
		DisplayName: 常青之赐
		Description: 锻造常青锭
		DetailedDescription: 世纪之花凋谢的地方，泥土里长出了会呼吸的绿色金属。丛林在用自己的方式回礼。
	}

	LifeAlloyQuest: {
		DisplayName: 生命合金
		Description: 熔铸生命合金
		DetailedDescription: 三种活着的金属熔在一起，锭子上还留着脉搏。高阶装备的骨架都用它打底。
	}

	AstralBarQuest: {
		DisplayName: 星幻熔铸
		Description: 锻造星幻锭
		DetailedDescription: 游龙死后，星染矿脉终于肯让镐子下嘴。熔出来的锭子在黑暗里自己发光。
	}

	UelibloomQuest: {
		DisplayName: 悠兰绽放
		Description: 锻造悠兰锭
		DetailedDescription: 女神的圣火烧过之后，丛林的泥土里开出了金属的花。花瓣熔成锭，锭里还带着光。
	}

	BloodstoneQuest: {
		DisplayName: 血石淬炼
		Description: 凝聚血石核心
		DetailedDescription: 女神倒下后，硫磺火崖的岩浆里浮起暗红的石头。它们还在跳，像一颗颗离体的心脏。
	}

	AscendantEssenceQuest: {
		DisplayName: 升华之魄
		Description: 凝聚升华精魄
		DetailedDescription: 幽魂、星尘、月光，再加一点不肯散去的执念。把它们压进一枚精魄里，足够点亮传说。
	}

	YharonSoulQuest: {
		DisplayName: 龙魂余烬
		Description: 收集犽戎魂魄碎片
		DetailedDescription: 巨龙燃尽之后，火焰里剩下的不是灰，是一片片还在发烫的魂。捡起来的时候小心别被燎到心。
	}

	FruitQuest: {
		DisplayName: 生命的馈赠
		Description: 集齐四枚强化生命的果实
		DetailedDescription: 强敌的尸骸旁偶尔会结出奇异的果实。一共四种，每一种都能把你的生命推向新的上限。
	}

	DraedonPowerCellQuest: {
		DisplayName: 远古动力
		Description: 收集动力电池
		DetailedDescription: 实验室的废墟里散落着还有余电的电池。这种能源密度远超你的发电机，值得研究。
	}

	DraedonsForgeQuest: {
		DisplayName: 巨匠熔炉
		Description: 得到巨匠的熔炉
		DetailedDescription: 工业的尽头是一台什么都能熔的炉子。组装好它，你的工坊从此不再有做不出的东西。
	}

	ConquerorMilestone: {
		DisplayName: 讨伐编年史
		Description: 击败这个世界的每一位强敌
		QuestObjective.Description: 完成所有讨伐任务
		DetailedDescription: 从史莱姆王到世界尽头的存在，把每一场硬仗都打完。写满这一页的人不多。
	}

	EventMilestone: {
		DisplayName: 事件平定者
		Description: 平定每一场入侵与异象
		QuestObjective.Description: 完成所有事件任务
		DetailedDescription: 军队、舰队、异界的月亮。凡是成群结队来的，都被你送了回去。
	}

	CompletionistMilestone: {
		DisplayName: 完典
		Description: 完成任务书上的一切
		QuestObjective.Description: 完成所有任务
		DetailedDescription: 这本书的最后一页留给读完全书的人。合上它的时候，这个世界已经没有你没见过的东西了。
	}
}
