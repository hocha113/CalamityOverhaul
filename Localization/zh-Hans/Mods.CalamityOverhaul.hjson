GodSmithGunsEarly: {
	GsFlintlockPistol.Desc:
		'''
		重铸：双膛装填，第 2 发出膛快 40%；末膛把一发弹药打成 V 形双弹，击退翻倍
		右键提前装填；掐准亮带，下一发伤害提高 25%
		'''

	GsGunsEarlyPlayer: {
		Perfect: 完美装填！
		HighNoon: 正午时刻！
	}

	GsMusket.Desc:
		'''
		重铸：货真价实的前装枪，每发铅弹都是更快更穿的碎石弹，多贯穿 1 名敌人
		装填分三拍：倒药、压弹、上火；在压弹拍按右键，下一发伤害提高 30%，贯穿再加一层
		'''
	GsQuadBarrelShotgun.Desc:
		'''
		重铸：四管改为快速轮放，一次一管；第 4 管 8 粒齐轰，后坐力把你猛推出去
		朝下开火可以借力起跳
		右键折开枪管装填；掐准亮带，下轮每管多 2 粒
		'''
	GsRevolver.Desc:
		'''
		重铸：六发弹巢，末膛一发威力永远高 40%
		按住右键转轮盘：立刻装回随机 1 至 6 发
		恰好转出 6 发时，下一枪就是正午时刻：伤害翻倍，击退翻倍
		'''
}

GodSmithGunsHard: {
	GsCandyCornRifle: {
		Desc:
			'''
			重铸：右键切换糖衣
			糖果雨：经典速射不变，弹道带上甜腻的下坠弧线
			黏糖三连：一次吐出 3 粒软糖弹；命中叠加糖霜，减速目标并让你的糖弹打得更痛
			'''
		ModeCandyRain: 糖果雨
		ModeStickyBurst: 黏糖三连
	}

	GsClockworkAssaultRifle: {
		Desc:
			'''
			重铸：右键切换射击模式
			齿轮点射：保留经典三连发，第 3 发威力提高 30%
			超频：射速加快 40%，代价是积热；打得太热齿轮会卡壳
			'''
		ModeGearBurst: 齿轮点射
		ModeOverclock: 超频
	}

	GsGatligator: {
		Desc:
			'''
			重铸：右键切换性子
			沼泽乱涌：狂野散射不变，每发子弹能在物块上弹跳一次
			死亡翻滚：改为收束的四连串射，链末一发撕开流血伤口
			'''
		ModeSwampRiot: 沼泽乱涌
		ModeDeathRoll: 死亡翻滚
	}

	GsMegashark: {
		Desc:
			'''
			重铸：右键切换咬合
			狂食：扣住扳机越久，射速越快；鲨咬：收束散布，威力提高 15%
			累计命中 50 发即见血：3 秒内每发命中都会留下流血伤口
			'''
		ModeFrenzy: 狂食
		ModeSharkBite: 鲨咬
	}

	GsOnyxBlaster: {
		Desc:
			'''
			重铸：右键切换装药
			玛瑙齐射：暗球爆点留下驻留的暗渍，把敌人向内拖拽
			奇点装药：射速放慢，改掷一颗巨型玛瑙球；爆炸把万物拽向核心，并向四周环洒你的子弹
			'''
		ModeVolley: 玛瑙齐射
		ModeSingularity: 奇点装药
	}

	GsSDMG: {
		Desc:
			'''
			重铸：右键循环三种射击模式
			海豚奔潮：传说级射速原样保留
			声呐点射：每第 3 发命中挂上声呐标记，全队远程对该目标伤害提高 8%
			轨道导引：子弹轻微追踪，威力降低 10%
			'''
		ModeDolphinTide: 海豚奔潮
		ModeSonarBurst: 声呐点射
		ModeOrbitalGuide: 轨道导引
	}

	GsShotgun: {
		Desc:
			'''
			重铸：右键切换喉径
			宽喉：6 粒带铅坠弧线的宽扇；单次射击命中满 3 粒，目标上空炸开一阵坠落铅雨
			收颈：3 粒精束直线，每粒更重；3 粒全中同一目标使其铅蚀 1.5 秒，受本枪伤害提高 12%
			每次扣扳机仍只消耗 1 发弹药
			'''
		ModeWideBore: 宽喉
		ModeTightChoke: 收颈
	}

	GsSniperRifle: {
		Desc:
			'''
			重铸：轻点右键切换射击模式，按住右键开镜
			狙击：亮出贯穿瞄准线；站定不动即可屏息，屏息后的一枪必定暴击
			速射：用威力换射速
			'''
		ModeSnipe: 狙击
		ModeRapid: 速射
	}

	GsTacticalShotgun: {
		Desc:
			'''
			重铸：右键切换战术姿态
			战术扇面：常亮散布锥标线，6 粒的覆盖面一目了然
			压制三泵：快速连打 3 泵后强制歇泵；首泵推出破门冲击气浪，被撞开的敌人 1 秒内受本枪弹丸伤害提高 10%
			每泵照常消耗 1 发弹药
			'''
		ModeFan: 战术扇面
		ModeTriplePump: 压制三泵
	}

	GsUzi: {
		Desc:
			'''
			重铸：右键切换握持
			双持乱射：射速加快三成，弹道松散；高速点射：三连收束，弹弹咬点
			每第 4 发（点射档为链末发）是琥珀曳光弹：曳光命中点亮目标，1.5 秒内你的乌兹子弹对其伤害提高 10%
			'''
		ModeAkimbo: 双持乱射
		ModeBurst: 高速点射
	}

	GsVenusMagnum: {
		Desc:
			'''
			重铸：右键切换花期
			金蕊聚焦：打出暴击后，下一发额外贯穿 1 名敌人，窗口期内瞄准线会亮起
			花瓣三裂：一发弹药裂成扇形三瓣
			'''
		ModeFocus: 金蕊聚焦
		ModeTriplet: 花瓣三裂
	}

	GsVortexBeater: {
		Desc:
			'''
			重铸：右键切换流态
			星旋扫射：经典弹雨不变，火箭带轻微追踪
			星旋炮击：改射缓慢的充能重弹，单发威力 2.6 倍；重击落点撕开一个牵引旋涡
			'''
		ModeSweep: 星旋扫射
		ModeCannon: 星旋炮击
	}

	GsXenopopper: {
		Desc:
			'''
			重铸：右键切换泡型
			集束：吹出 5 只气泡，向光标处收拢并交叉引爆
			真空：吹出一只大泡飘向光标，悬停片刻后 5 发弹药一次性喷出
			'''
		ModeCluster: 集束
		ModeVacuum: 真空
	}

	GsShotgunLeadRainProj.DisplayName: 坠落铅雨
	GsTacticalShotgunBreachProj.DisplayName: 破门气浪
	GsUziTracerProj.DisplayName: 琥珀曳光弹
}

GodSmithLaunchers: {
	GsElectrosphereLauncher: {
		Desc:
			'''
			重铸：场上有两颗以上电球时，球间架起特斯拉电弧，最多连 3 段，电弧造成电球一半的伤害
			右键让全部电球过载：半径扩大 40%，2 秒内放电殆尽
			'''
		TipOverload: 过载！
	}

	GsGrenadeLauncher: {
		Desc:
			'''
			重铸：榴弹改为黏附墙面与敌身，不再自动起爆；黏在血肉上的榴弹伤害提高 25%
			右键统一引爆，场上最多布设 6 枚
			'''
		TipDetonate: 全部引爆！
	}

	GsJackOLanternLauncher: {
		Desc:
			'''
			重铸：右键让滚动中的南瓜齐声狞笑并炸裂，每颗放出 3 缕追踪鬼火
			每处爆点留下一片烛火场，持续灼烧站在里面的敌人
			'''
		TipGrin: 齐声狞笑！
	}

	GsNailGun: {
		Desc:
			'''
			重铸：钉子钉进血肉不再脱落，每名敌人最多钉 5 枚，每枚使其受到的所有伤害提高 3%
			右键把全部钉子连肉拔出，炸成一蓬弹片
			'''
		TipExtract: 连肉拔钉！
	}

	GsProximityMineLauncher: {
		Desc:
			'''
			重铸：地雷的触发半径只对你可见
			右键按布设顺序连环引爆；闲置 60 秒的地雷自行回收，退还一发火箭
			'''
		TipChain: 多米诺！
		TipRecycle: 地雷已回收
	}

	GsRocketLauncher: {
		Desc:
			'''
			重铸：右键引爆所有飞行中的火箭
			每次空爆朝你的光标方向甩出 3 枚贯穿镖
			'''
		TipDetonate: 空爆！
	}

	GsSnowmanCannon: {
		Desc:
			'''
			重铸：右键切换载具
			追踪蜂群：命中给敌人烙上雪花印，受本武器伤害提高 8%
			暴雪轨道：火箭先升空，再从光标上方俯冲而下
			'''
		ModeHoming: 载具：追踪蜂群
		ModeOrbital: 载具：暴雪轨道
	}

	GsStarCannon: {
		Desc:
			'''
			重铸：右键切换弹道
			平射：星辰直线飞行；坠星：星辰先升空，再绕光标一带落下星雨，命中溅开星尘
			'''
		ModeDirect: 弹道：平射
		ModeStarfall: 弹道：坠星
	}

	GsStynger: {
		Desc:
			'''
			重铸：右键循环引信
			触发：命中即炸；定距：飞到光标距离处空爆，弹片收束成锥；跳弹：先在物块上弹跳一次再解除保险
			'''
		ModeImpact: 引信：触发
		ModeRange: 引信：定距空爆
		ModeRicochet: 引信：跳弹
	}
}

GodSmithMagicConduit: {
	GsHeatRay.Desc:
		'''
		重铸：按住持续照射灼热射线；白热时光束变宽，熔蚀叠满 5 层即引爆
		右键泄压，把全部热量化作一道日冕闪矛
		'''
	GsMedusaHead.Desc:
		'''
		重铸：按住展开石化凝视锥；石纹叠满会短暂石化敌人，白热时凝视收束成聚焦瞪视
		右键泄压，向八方射出石化目光
		'''

	GsSoulDrain: {
		Desc:
			'''
			重铸：蛭吸导管，最多拴住 3 名敌人一同抽取；白热期间才有真实的生命回复
			右键在光标处引爆储存的血量；过载引爆会反噬你 10 点生命
			'''
		BloodPriceDeath: "{0}被自己的蛭吸导管抽干了"
	}
}

GodSmithMagicMorph: {
	GsClingerStaff.Desc:
		'''
		重铸：按住右键片刻，沿瞄准方向铺一道约 16 格长的诅咒藤墙，角度随意
		蓄力过满时，藤墙两端再各生出一段垂直裙墙
		'''
	GsCrimsonRod.Desc:
		'''
		重铸：血云化作献祭雨场
		雨滴叠加血蚀，叠满三层即溃爆；站在场内的友方缓缓回血
		右键花少量魔力把雨场挪到光标处
		'''
	GsCrystalSerpent.Desc:
		'''
		重铸：迸裂的碎晶可以多弹跳一次
		按住右键蓄力，松开放出巨大的水晶巨蟒，蜿蜒游进并炸开更丰厚的碎晶雨
		'''
	GsCrystalStorm.Desc:
		'''
		重铸：按住右键在光标处蓄起一座折射旋涡
		你的水晶碎片穿过旋涡就会折射，飞得更快，并多贯穿 1 名敌人
		'''
	GsFlamelash.Desc:
		'''
		重铸：手控飞行的转向灵敏 25%
		按住右键蓄力，松开放出一条火焰长蛇，蛇身尾随你的指引游走，点燃沿途敌人
		'''
	GsMagicMissile.Desc:
		'''
		重铸：手控飞行的转向灵敏 25%
		按住右键蓄力，松开放出三连魔弹，列队护送你的光标
		'''
	GsMeteorStaff.Desc:
		'''
		重铸：流星落点留下持续灼烧的弹坑
		按住右键蓄力，松开在光标一线召下五连流星弹幕
		'''
	GsNimbusRod.Desc:
		'''
		重铸：两朵雨云同时在场时，云间架起一条雨廊，淋湿并减速廊内敌人
		右键在暖雨与雷暴间切换；雷暴会沿雨廊劈下闪电
		'''
	GsRainbowGun.Desc:
		'''
		重铸：彩虹驻场期间，你在虹弧上方带内的弹幕伤害提高 8%，虹弧还会洒下追踪棱光脉冲
		右键收回彩虹，退还一半魔力
		'''
	GsRainbowRod.Desc:
		'''
		重铸：手控光弹命中时炸成棱彩碎光
		按住右键蓄力，松开架起一道彩虹桥，敌人穿桥受伤，友方踩桥提速
		'''
	GsSkyFracture.Desc:
		'''
		重铸：魔刃出手时撕开一瞬裂空闪光
		按住右键蓄力，松开在光标周围裂开三道裂隙，射出向心收拢的魔刃
		'''
}

GodSmithSummonWhips: {
	GsCoolWhip.Desc:
		'''
		重铸：踩拍鞭击生成的雪花更大，多贯穿 1 名敌人
		4 道霜痕落成处决印，下一记踩拍命中将其绽成冰霜爆发，附加霜冻
		'''
	GsDarkHarvest.Desc:
		'''
		重铸：暗能跃迁会扩散到周围敌人，目标身上每有一道收割鞭痕就多跳一路
		4 道鞭痕落成处决印，下一记踩拍命中收割其魂，对场上所有带鞭痕的敌人闪现补镰
		'''
	GsDurendal.Desc:
		'''
		重铸：连续踩拍 3 次后，之后每记踩拍挥击都从鞭梢放出金色剑波
		5 道鞭痕落成处决印，下一记踩拍命中召下一柄神圣裁决之刃
		'''
	GsFirecracker.Desc:
		'''
		重铸：保留经典的仆从引爆炸响
		踩拍鞭击往目标身上装填引信，攒到 3 根后，下一次炸响会接连引发 3 次追加爆炸
		'''
	GsKaleidoscope.Desc:
		'''
		重铸：节拍窗口全鞭最严，挥空一次就清空节奏
		每道鞭痕点亮一种棱彩，集齐五色后，下一记踩拍命中展开万花筒五连棱光斩，目标其后 5 秒必定被暴击
		'''
	GsLeatherWhip.Desc:
		'''
		重铸：踩着节拍连挥可以攒节奏，鞭速越攒越快
		3 道鞭痕落成处决印，下一记踩拍命中将其炸开，造成 200% 伤害，随后你的仆从围殴目标 2 秒
		'''
	GsMorningStar.Desc:
		'''
		重铸：每记踩拍挥击都在鞭梢砸出一圈震荡
		3 道鞭痕落成处决印，下一记踩拍命中从天召落一颗坠星锤，正中目标头顶
		'''
	GsSnapthorn.Desc:
		'''
		重铸：踩拍鞭击在猎物身上种下荆棘鞭痕
		4 道鞭痕落成处决印，下一记踩拍命中引爆荆棘，并射出 4 枚追踪毒刺
		'''
	GsSpinalTap.Desc:
		'''
		重铸：一次踩拍横扫抽中 3 名敌人时，震出骨响余波，扫及所有没被抽中的敌人
		4 道鞭痕落成处决印，下一记踩拍命中从地底顶出一根骨刺尖塔
		'''
}

