# For Language Pack Creators:
# The keys here were previously in Items. Since EcTypeItem has been removed, all localization keys similar to "ItemNameEcType" have been moved here.
# The corresponding format is "ItemNameEcType" → "RItemName" or "ItemNameOverride".
# Apart from the class name change, the DisplayName and Tooltip remain the same as in the previous version.
# So if you need to migrate your language pack to the new version, simply copy and paste the entries here and update the class names accordingly.

Arcanes: {
	Items: {
		ArcaneTransformer: {
			DisplayName: 奥术转换器
			Tooltip: ""
		}
	}
}

Resurrections: {
	ResurrectionDeath: {
		DeathText: "{0}死于深渊复苏"
		WarningCombatText: 深渊正在吞噬你...
		DeathNoticeText: 你被深渊吞噬了...
		MarkRemainText: 深渊的印记依然缠绕着你...
		RetainValueFormat: 复苏值: {0}%
	}
}

QuickHack: {
	SynapseBurn: {
		DisplayName: 突触焚毁
		Description: 超载目标神经突触，造成持续热伤害
	}

	ShortCircuit: {
		DisplayName: 短路
		Description: 释放电磁脉冲造成即时伤害并短暂麻痹
	}

	Cyberpsychosis: {
		DisplayName: 赛博精神病
		Description: 使目标陷入癫狂，攻击周围一切单位
	}

	SystemReset: {
		DisplayName: 系统重置
		Description: 强制重启目标系统，使其完全瘫痪
	}

	OpticOverload: {
		DisplayName: 视觉过载
		Description: 致盲目标，使其无法感知周围环境
	}

	MemoryWipe: {
		DisplayName: 记忆清除
		Description: 清除目标的敌意数据，重置仇恨列表
	}

	Contagion: {
		DisplayName: 蔓延
		Description: 植入自我复制的恶意程序，向周围目标扩散
	}

	TileDetonate: {
		DisplayName: 物块爆破
		Description: 瓦解结构完整性，触发区域性爆炸
	}

	TilePhase: {
		DisplayName: 虚化协议
		Description: 篡改物块物理属性，使其在一段时间内变为虚体
	}

	TileMagPull: {
		DisplayName: 磁力牵引
		Description: 生成磁场，将附近掉落物吸引向你
	}

	MachineShortCircuit: {
		DisplayName: 机械短路
		Description: 清空目标机械电能，释放电弧伤害附近实体
	}

	TurretHijack: {
		DisplayName: 炮塔劫持
		Description: 篡改IFF识别模块，临时翻转炮塔敌我判定
	}

	FalseMemory: {
		DisplayName: 记忆修改
		Description: 植入虚假记忆，令其短暂中断追杀行为或抑制其杀人规律
	}

	SelfDismember: {
		DisplayName: 自我肢解
		Description: 令其肢解自身的灵异
	}

	SystemHalt: {
		DisplayName: 死机
		Description: 令目标短暂陷入沉寂并停止一切活动
	}

	TurretCircuitOverload: {
		DisplayName: 电路过载
		Description: 向炮台供电回路灌入反向电流，令其长时间彻底失效
	}

	TurretShortCircuit: {
		DisplayName: 炮台短路
		Description: 瞬时泄放炮台电能使其短暂停摆，恢复后立即重新上线
	}

	VirusBroadcast: {
		DisplayName: 病毒广播
		Description: 向信号塔注入蠕虫代码，令其向四周发射赛博电磁冲击波，长时间短路广播范围内的所有炮台
	}

	MeltdownProtocol: {
		DisplayName: 熔毁协议
		Description: 锁死散热回路，四秒后过热炸开并波及近处敌人
	}

	ProjectileHijack: {
		DisplayName: 弹道接管
		Description: 改判来袭弹幕的归属，让它掉头打回去
	}

	ProjectileFreeze: {
		DisplayName: 弹道冻结
		Description: 把一发弹幕钉在半空，五秒后放行
	}

	DataPurge: {
		DisplayName: 数据清除
		Description: 抹除来袭弹幕，附近的同型弹一并清掉
	}

	BallisticOverclock: {
		DisplayName: 弹道超频
		Description: 给自己的一发弹幕加伤害、加穿透、加飞行时间
	}

	Electrolysis: {
		DisplayName: 电解水域
		Description: 给这片液体通电，泡在里面的敌人持续受伤
	}

	Cryostasis: {
		DisplayName: 冷凝固化
		Description: 把一片液体冻成能踩的薄冰，八秒后化开
	}

	LiquidPurge: {
		DisplayName: 液体抽排
		Description: 抽干周围一片液体，岩浆同样吃
	}

	ItemRecall: {
		DisplayName: 远程回收
		Description: 把掉落物拽到你脚边
	}

	Reappraise: {
		DisplayName: 品质重掷
		Description: 重掷地上这件装备的前缀
	}

	ArmorParse: {
		DisplayName: 装甲解析
		Description: 把目标防御压到零，持续六秒
	}

	Exorcise: {
		DisplayName: 强制注销
		Description: 挂上注销标记，累计挨五次打后触发一次重伤
	}

	DataLeech: {
		DisplayName: 数据榨取
		Description: 期间打这个目标回流RAM，总量有上限
	}

	SwarmLink: {
		DisplayName: 蜂群链接
		Description: 打中目标时，附近至多五个敌人同吃三成伤害
	}

	MachineOverclock: {
		DisplayName: 机械超频
		Description: 十秒内用定额电托住机器，到期把电烧空
	}

	GridBlackout: {
		DisplayName: 电网瘫痪
		Description: 借信号塔切断大范围内所有机械的供电
	}

	PowerTransmute: {
		DisplayName: 电能折算
		Description: 把手里东西的存电折成RAM，随即放空
	}

	NeuralOverclock: {
		DisplayName: 神经超频
		Description: 八秒内出手更快，但RAM停止回复且持续掉血
	}

	WraithForceDrive: {
		DisplayName: 役鬼强驱
		Description: 十秒内役鬼出手不花代价，之后侵蚀加深并休眠
	}

	IndexPreread: {
		DisplayName: 索引预读
		Description: 不开箱读完里面的东西，最值钱那件标出来
	}

	LockBurn: {
		DisplayName: 锁芯烧穿
		Description: 不用钥匙开这个箱子，代价是烧掉里面一件
	}

	DielSkip: {
		DisplayName: 昼夜跳转
		Description: 把时间快进到最近的日出或日落
	}

	StormInject: {
		DisplayName: 雷暴注入
		Description: 招来雷暴，落雷只砸身上带骇入效果的敌人
	}

	GravityInvert: {
		DisplayName: 重力反转
		Description: 你周围一片的重力反过来，敌人和掉落物往上掉
	}

	SegmentDelink: {
		DisplayName: 节段离网
		Description: 这一节的伤害只记账，到期折六成算给本体
	}

	LimbSeizure: {
		DisplayName: 肢体征收
		Description: 让这条肢体转过去打它自己的本体，持续八秒
	}

	CommandLinkCut: {
		DisplayName: 协同断链
		Description: 切断它和同伴的联络，十秒内各打各的
	}

	MunitionSwap: {
		DisplayName: 弹药置换
		Description: 炮台改打你背包里的弹药，伤害按你的算
	}

	TurretMesh: {
		DisplayName: 炮台联网
		Description: 附近炮台连成一组齐射你指的地方，共四十发
	}

	BeaconForge: {
		DisplayName: 信标伪造
		Description: 信号塔发出假求救信号，把大片地方的怪招过来
	}

	PrivilegeEscalate: {
		DisplayName: 提权
		Description: 协议变便宜变快且不限距离，期间RAM不回复
	}

	ItemSalvage: {
		DisplayName: 拆解
		Description: 把地上这件东西拆回六成材料
	}

	DataBrand: {
		DisplayName: 数据烙印
		Description: 抄下这件装备的前缀，下次骇入印到另一件上
		HudTag: 烙印: {0}
		DenyNoPrefix: 这件东西上没有前缀可抄
		DenyIncompatible: 记录的前缀贴不上这件东西
	}

	EntityMasquerade: {
		DisplayName: 身份伪装
		Description: 让这件掉落物在敌人眼里像玩家，替你挨三十秒
	}

	TileConscript: {
		DisplayName: 物块征用
		Description: 把这片物块拆成八块护甲绕着你转，到期打出去
	}

	VeinResonance: {
		DisplayName: 矿脉共振
		Description: 同种矿脉透墙可见，挖到双倍掉落但会招来看守
	}

	StressInvert: {
		DisplayName: 应力反转
		Description: 十秒内这片物块不可破坏，撞上去的敌人会受伤
	}

	PressureSurge: {
		DisplayName: 增压水域
		Description: 给这片液体加压，泡在里面的东西被顶上天
	}

	MirrorSurface: {
		DisplayName: 镜像水面
		Description: 液面变镜，穿过它的敌方弹幕复制一份归你
	}

	DelayFuse: {
		DisplayName: 延迟引信
		Description: 这发弹幕不再消失，原地悬停三十秒变成雷
	}

	ProjectileTithe: {
		DisplayName: 弹幕征收
		Description: 这发弹幕会吞掉靠近的敌弹，到期按吞的量炸开
	}

	ProjectileSample: {
		DisplayName: 弹幕采样
		Description: 采下这发弹幕，二十秒内你每十二发复刻它一发
	}

	CompensationProtocol: {
		DisplayName: 代偿协议
		Description: 预支目标一成生命，八秒内没打死就自己还账
	}

	PayloadRewrite: {
		DisplayName: 载荷改写
		Description: 十秒内目标射出的弹幕全部归你，按你的伤害结算
	}

	PhaseDesync: {
		DisplayName: 相位偏移
		Description: 把目标的躯体和判定分开，双方都更难打中
	}

	LiveCellTap: {
		DisplayName: 活体电源
		Description: 目标不能动也免疫伤害，拿自身生命换你的RAM
	}

	FirmwareRollback: {
		DisplayName: 固件回滚
		Description: 让目标退回上一阶段的行为，到期后暴走五秒
	}

	ShellRequisition: {
		DisplayName: 躯壳征用
		Description: 标记期间被打死的目标会站起来替你打十五秒
	}

	PositionCast: {
		DisplayName: 坐标广播
		Description: 十五秒对方位置对你全队透明
	}

	GaugePollution: {
		DisplayName: 读数污染
		Description: 污染对方的界面，血量弹药读数乱跳八秒
	}

	LinkTraceback: {
		DisplayName: 链路回溯
		Description: 掐断瞄着你的上传，烧他并标出他
	}

	ForceUninstall: {
		DisplayName: 强制卸载
		Description: 拔掉你身上一条敌方协议，半分钟内不能再拔
	}

	MemoryScorch: {
		DisplayName: 内存烧蚀
		Description: 烧掉对方三点RAM，十秒内他的回复归零
		SealTag: RAM回复被封
	}

	BuffSiphon: {
		DisplayName: 增益抽取
		Description: 抽走对方剩余最久的一个增益归你，最长三十秒
	}

	CombatSiphon: {
		DisplayName: 战术榨取
		Description: 十秒内打他造成的伤害按比例回你的RAM
	}

	BallisticTurncoat: {
		DisplayName: 弹道倒戈
		Description: 对方接下来射出的三发弹幕半路调头打回原主，停火即安全
		HijackCounter: 弹道已劫持 {0}/{1}
		DeathReason: "{0}射出的弹幕被{1}调头送了回来"
	}

	MeltdownBrand: {
		DisplayName: 熔断标记
		Description: 四秒引信全程可见，烧完炸他八十点，中途拔除可拆弹
		FuseTag: 熔断 {0}s
		DeathReason: "{0}被{1}种下的熔断标记炸开了"
	}

	MapBlackout: {
		DisplayName: 地图熄灭
		Description: 对方的地图糊成雪花十五秒，图钉队标一并熄灭
	}

	ChannelScramble: {
		DisplayName: 信道乱码
		Description: 二十秒内对方的聊天变乱码，队友名牌从他屏幕上消失
	}

	StealthStrip: {
		DisplayName: 隐身剥离
		Description: 剥掉对方一切隐身潜行，十秒内积不回来，轮廓全员可见
	}

	CooldownInject: {
		DisplayName: 冷却注入
		Description: 六秒内对方出手慢三成半，进行中的药水冷却再加五秒
	}

	CyberwareOffline: {
		DisplayName: 义体离线
		Description: 八秒内对方全部义体断电离线
	}
}

