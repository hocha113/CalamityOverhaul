GsMinishark: {
	Desc:
		'''
		重铸：按住扳机鲨腥上头，射速越打越快，弹道也越打越野
		狂乱吃满后每第四发化作鲨齿弹，撕开伤口再补一记咬合
		五十发弹鼓整鼓拔插；掐准亮带换鼓，下一鼓自带半程狂乱
		'''
	Frenzy: 狂潮！
}

GsPhoenixBlaster: {
	Desc:
		'''
		重铸：命中喂养火巢，枪身羽焰随火种渐亮，击杀喂得更快
		攒满 24 点火种，下一发化作凤凰俯冲爆燃，再裂出三只追猎的雏凤
		装填时飞散的火星倒卷回膛；掐准亮带装填，直接白得 8 点火种
		'''
	Nirvana: 涅槃！
}

GsBoomstick.Desc:
	'''
	重铸：每管 4 粒铅弹朝准星收拢，不再乱喷
	弹粒在准星处交汇咬合，站在那里的东西会被狠狠咬一口
	折管换弹两壳齐飞；掐准亮带，下一匣每管多 1 粒
	'''

GsHandgun: {
	Desc:
		'''
		重铸：对同一目标连中 3 发，第 4 发自动化作点穴弹，伤害大增且无视 15 点防御
		末发清膛弹更重更远
		匣式速装：有余弹时换匣极快，完美亮带也最宽
		'''
	PointShot: 点穴！
}

GsTheUndertaker.Desc:
	'''
	重铸：击杀敌人或打到濒死，枪会收下一盏魂灯，魂灯飞回为你补血，每匣一次
	末发是鸣钟重弹，命中震出哀鸣冲击，击退翻倍
	逐膛装填可随时开火打断，装几发打几发
	'''

GsRedRyder: {
	Desc:
		'''
		重铸：铜珠会在物块间弹跳两次，每跳摇响一声铃
		短时间内对同一目标连响五铃，下一发化作礼物弹，爆开彩屑重击
		杠杆逐发压弹，压几发打几发
		'''
	Gift: 礼物弹！
}

GsPewMaticHorn: {
	Desc:
		'''
		重铸：一匣七发按音阶上行，每发一色一音
		对同一目标连中三音奏成和弦，按第三个音的颜色炸出调色爆
		装填是一段上行音阶；掐准高音处的亮带，本匣和弦更大更痛
		'''
	Chord: 和弦！
}

GsSandgun: {
	Desc:
		'''
		重铸：连续喷沙给沙斗蓄热，热满后沙在膛里烧成玻璃镖
		玻璃镖更快更穿，命中迸溅棱片脆响；停手会慢慢冷却
		普通沙弹保持原版脾气；掐准亮带装填，沙斗直接烧满
		'''
	Molten: 熔琉！
}

GsBlowpipe.Desc:
	'''
	重铸：命中同一目标穿一缕毒引，穿满三缕炸开滞留毒雾
	装填是回气，一口一镖可随时打断；站着不动回气快四分之一
	掐准亮带回气，下一镖命中立刻引爆毒引
	'''
GsBlowgun.Desc:
	'''
	重铸：一口长息连吹五镖，一镖比一镖快、一镖比一镖狠
	第五镖吹尽肺腑，命中炸开一大片毒雾
	回气逐口可打断，站定回气更快；掐准亮带，整匣从第三口的势头起吹
	'''
GsHarpoon.Desc:
	'''
	重铸：链叉去而复返，收链回手就是装填
	叉中重敌成锚，再扣一次扳机让绞盘把你拽飞过去
	叉中轻敌则反着来，回程的链把它拖到你面前
	'''
GsFlareGun.Desc:
	'''
	重铸：红绿蓝白四色信管轮转，钉进敌人身上持续燃照
	被钉住的敌人受你的一切伤害提高 12%，白色压轴信管提到 16%
	旋换药罐两拍装好；掐准亮带，下一发双信管齐射
	'''
GsFlintlockPistol.Desc:
	'''
	重铸：双膛装填，第 2 发出膛快 40%；末膛把一发弹药打成 V 形双弹，击退翻倍
	掐准亮带装填，下一发伤害提高 25%
	'''
GsMusket.Desc:
	'''
	重铸：货真价实的前装枪，每发铅弹都是更快更穿的碎石弹，多贯穿 1 名敌人
	装填分三拍：倒药、压弹、上火
	'''
GsQuadBarrelShotgun.Desc:
	'''
	重铸：四管改为快速轮放，一次一管；第 4 管 8 粒齐轰，后坐力把你猛推出去
	朝下开火可以借力起跳
	折开枪管装填；掐准亮带，下轮每管多 2 粒
	'''
GsRevolver.Desc: 重铸：六发弹巢，末膛一发威力永远高 40%

GsCandyCornRifle: {
	Desc: 重铸：经典速射不变，弹道带上甜腻的下坠弧线
	ModeCandyRain: 糖果雨
}

GsClockworkAssaultRifle: {
	Desc: 重铸：保留经典三连发，第 3 发威力提高 30%
	ModeGearBurst: 齿轮点射
}

GsGatligator: {
	Desc: 重铸：狂野散射不变，每发子弹能在物块上弹跳一次
	ModeSwampRiot: 沼泽乱涌
}

GsMegashark: {
	Desc:
		'''
		重铸：扣住扳机越久，射速越快
		累计命中 50 发即见血：3 秒内每发命中都会留下流血伤口
		'''
	ModeFrenzy: 狂食
}

GsOnyxBlaster: {
	Desc:
		'''
		重铸：右键切换装药
		玛瑙齐射：暗球爆点留下驻留的暗渍，把敌人向内拖拽
		奇点装药：射速放慢，改掷一颗巨型玛瑙球；爆炸把万物拽向核心，并向四周环洒你的子弹
		'''
	ModeVolley: 玛瑙齐射
	ModeSingularity: 奇点装药
}

GsSDMG: {
	Desc: 重铸：传说级射速原样保留
	ModeDolphinTide: 海豚奔潮
}

GsShotgun: {
	Desc:
		'''
		重铸：6 粒带铅坠弧线的宽扇；单次射击命中满 3 粒，目标上空炸开一阵坠落铅雨
		每次扣扳机仍只消耗 1 发弹药
		'''
	ModeWideBore: 宽喉
}

GsSniperRifle: {
	Desc:
		'''
		重铸：轻点右键切换射击模式，按住右键开镜
		狙击：亮出贯穿瞄准线；站定不动即可屏息，屏息后的一枪必定暴击
		速射：用威力换射速
		'''
	ModeSnipe: 狙击
	ModeRapid: 速射
}

GsTacticalShotgun: {
	Desc:
		'''
		重铸：常亮散布锥标线，6 粒的覆盖面一目了然
		每泵照常消耗 1 发弹药
		'''
	ModeFan: 战术扇面
}

GsUzi: {
	Desc:
		'''
		重铸：射速加快三成，弹道松散
		每第 4 发是琥珀曳光弹：曳光命中点亮目标，1.5 秒内你的乌兹子弹对其伤害提高 10%
		'''
	ModeAkimbo: 双持乱射
}

GsVenusMagnum: {
	Desc: 重铸：打出暴击后，下一发额外贯穿 1 名敌人，窗口期内瞄准线会亮起
	ModeFocus: 金蕊聚焦
}

GsVortexBeater: {
	Desc: 重铸：经典弹雨不变，火箭带轻微追踪
	ModeSweep: 星旋扫射
}

GsXenopopper: {
	Desc: 重铸：吹出 5 只气泡，向光标处收拢并交叉引爆
	ModeCluster: 集束
}

GsShotgunLeadRainProj.DisplayName: 坠落铅雨
GsUziTracerProj.DisplayName: 琥珀曳光弹
