GsBatScepter: {
	Desc:
		'''
		重铸：命中积攒夜幕，集满后右键召唤万蝠临渊
		月轮升起，蝠群成波扑向敌人，余下的绕你结成护环
		'''
}

GsRazorpine: {
	Desc:
		'''
		重铸：命中积攒松脂，集满后右键掀起针叶风暴
		针叶旋涡绕身收紧，散场后在脚下铺一层松针毯
		'''
}

GsBlizzardStaff: {
	Desc:
		'''
		重铸：命中积攒风雪，集满后右键在光标处降下白灾
		特大暴雪轰击区域，散场后地面留下冰晶棘
		'''
}

GsStaffofEarth: {
	Desc:
		'''
		重铸：命中积攒地怒，集满后右键在光标处发动造山
		岩柱成波自地面顶升，碎石横飞，余下熔岩脉滩
		'''
}

GsBetsysWrath: {
	Desc:
		'''
		重铸：命中积攒龙焰，集满后右键唤来龙王孽焰
		贝特西的影子俯冲三趟拖出焰幕，留下一片咒火滩
		'''
}

GsNightglow: {
	Desc:
		'''
		重铸：命中积攒曦光，集满后右键在光标上空展开极光帷幕
		帷幕灼烧帘中之敌，并向下方垂落光矛
		'''
}

GsStellarTune: {
	Desc:
		'''
		重铸：命中积攒乐章，集满后右键开演星海终章
		星和弦踩着节拍自动奏向敌人，演奏时你的脚步更轻快
		'''
}

GsResonanceScepter: {
	Desc:
		'''
		重铸：命中积攒共振，集满后右键在光标区引发谐振崩解
		五道驻波交叉驻留，波节点持续打击滞留之敌
		'''
}

GsNebulaArcanum: {
	Desc:
		'''
		重铸：命中积攒奥秘，集满后右键旋开星云漩臂
		三条旋臂绕你公转碾磨敌人，小敌被缓缓拽向臂心
		'''
}

GsNebulaBlaze: {
	Desc:
		'''
		重铸：命中积攒烈焰，集满后右键在光标附近的目标上标记新星
		三层环爆错拍引爆，中心引力窟吞吸小敌
		'''
}

GsLunarFlare: {
	Desc:
		'''
		重铸：命中积攒月相，集满后右键升起月蚀审判
		蚀盘倾泻十二连月焰瀑，每第三落补一道幻影月光柱
		'''
}

