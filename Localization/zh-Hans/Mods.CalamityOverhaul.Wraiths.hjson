NoFace: {
	DisplayName: 无面女
	Origin: 雨夜桥头，她借走了你的脸
	Power: 「借颜」窃取目标的相貌，短暂复制其能力
	DeathReason: "{0}触犯了不可触犯之物"
}

LanternBoy: {
	DisplayName: 提灯童子
	Origin: 山道尽头有灯，灯下无人，再看已是灯中人
	Power: 「引路」三盏鬼灯环绕持有者，灯影会错拍复刻鬼切的普通斩击，合计拥有六成威力。
	DeathReason: "{0}触犯了不可触犯之物"
}

CrimsonBride: {
	DisplayName: 绯嫁
	Origin: 花轿在门前停了七夜
	Power: 「迎亲」花轿循着血迹而来，将垂死之人迎入无人的喜堂。
	DeathReason: "{0}触犯了不可触犯之物"
}

ScapeGhost: {
	DisplayName: 替死鬼
	Origin: 它生前没有名字，只记得替别人死过很多次。簿页翻动时，它的生辰与你写在一处
	Power: 「替死」死亡降临的瞬间，它会从远处攥来一条活命，把你的死按进那副躯壳
	DeathReason: "{0}触犯了不可触犯之物"
}

HeadlessShade: {
	DisplayName: 无头鬼影
	Origin: 你脚下的黑影抽动着，在灯火摇晃的夜里，影子的肩膀以上空无一物
	Power: 「肢解」它潜伏在你的身后，嗅到活物便扑杀而出，将其躯体撕成数段
	DeathReason: "{0}触犯了不可触犯之物"
}

GhostHand: {
	DisplayName: 焦黑枯手
	Origin: 一截焦黑枯瘦的恐怖手臂
	Power: 「攥」被掐住的目标会被压制，并限制其行动
	DeathReason: "{0}被攥进了墙里"
}

WellThing: {
	DisplayName: 井中鸣
	Origin: ———
	Power: ———
	DeathReason: "{0}触犯了不可触犯之物"
}

