ModifyChargingStationItem: {
	DisplayName: 充能站
	Tooltip:
		'''
		使用电力对电器进行充能
		可以将电池放入其中灌输电力
		也可以连接管道进行电力输送
		手持需要充能的物品右键物块可以快捷放入
		Shft右键可以拿出物品
		'''
}

DyeVatItem: {
	DisplayName: "{$ItemName.DyeVat}"
	Tooltip:
		'''
		用于制作染料
		放置后右键打开操作面板，允许给物品染色
		将水桶放置到染料槽中可以洗掉物品的染色
		'''
}

RDemonConch: {
	DisplayName: 恶魔海螺
	Tooltip:
		'''
		仔细听，你会听到尖叫声
		“小心”
		'''
}
