GraniteTome: {
	DisplayName: 花岗岩魔典
	Tooltip:
		'''
		吟咏汇聚三颗充能光点，充满后扇形齐射三发轻追踪的花岗能量球
		能量球命中后碎裂为追击的水晶碎片
		'''
}

GraniteFlower: {
	DisplayName: 花岗之花
	Tooltip:
		'''
		掷出一枚水晶种子，落点绽放成驻场的能量花
		花体三次脉冲，朝最近的敌人迸射水晶花瓣
		凋谢时花瓣尽数碎裂，向四周迸溅晶屑
		'''
}

GraniteThrowingKnife: {
	DisplayName: 花岗飞刀
	Tooltip:
		'''
		掷出可穿透的飞刀，拖曳锐利的青蓝电弧
		命中敌人时，会向附近另一名敌人跳跃一道微型链电
		末段命中或撞击地形时碎裂为水晶碎片
		'''
}

GraniteWalkingBoots: {
	DisplayName: 花岗行走靴
	Tooltip:
		'''
		大幅提升跑速与加速度
		达到全速的瞬间靴底通电，迸发电弧
		全速奔跑时脚下走火，身后拖曳青蓝残影
		'''
}

MarbleClub: {
	DisplayName: 大理石巨棍
	Tooltip:
		'''
		缓慢而沉重的过顶猛砸，击退极强
		命中必定使敌人短暂石化，化石迟滞
		砸中地面会掀起全威力的大理石冲击波与奔涌尘浪
		凌空挥砸则只余减弱的空气震荡
		'''
}

MarbleHuntingKnife: {
	DisplayName: 大理石猎刀
	Tooltip:
		'''
		迅捷的交替连斩
		每第三击化为更宽的终结斩，小步突进并迸射大理石碎片
		'''
}

MarbleDisc: {
	DisplayName: 大理石飞盘
	Tooltip:
		'''
		掷出旋转的飞盘，在敌人与墙壁间弹射
		每弹射至一名新目标，飞盘愈发鎏金，伤害提升10%，至多30%
		弹射耗尽后回旋归手，最多可同时存在两枚
		'''
}

MarblePebble: {
	DisplayName: 大理石卵石
	Tooltip:
		'''
		可无限使用的迅捷投石，撞地后弹射一次
		对生命上限越高的敌人造成越高的额外伤害
		击中庞然大物时金光迸裂、声如碎岩
		'''
}

MarbleShield: {
	DisplayName: 大理石战盾
	Tooltip:
		'''
		近战击退提升
		三块环绕的大理石碎片组成石卫护盾，就绪时吸收一次伤害并碎裂
		按[KEY]举盾格挡：完美格挡免除伤害，粉碎近旁弹幕并反掷石刃
		完美格挡后5秒内近战伤害提升10%
		'''
}

MarbleBalloon: {
	DisplayName: 大理石气球
	Tooltip:
		'''
		空中按↓砸向地面，下坠蓄势越久，落地冲击波越强、范围越广
		免疫摔落伤害
		'''
}

MarbleinaBottle: {
	DisplayName: 瓶中大理石
	Tooltip: 额外赋予一段沉重而有力的二段跳，按住跳跃键可跃得更高
}

MarbleCloudBalloon: {
	DisplayName: 大理石云朵气球
	Tooltip:
		'''
		额外赋予一段沉重而有力的二段跳，按住跳跃键可跃得更高
		空中按↓砸向地面，下坠蓄势越久，落地冲击波越强、范围越广
		免疫摔落伤害
		'''
}
