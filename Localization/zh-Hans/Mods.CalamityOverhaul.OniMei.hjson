MeiHigekiri: {
	DisplayName: 髭切
	Origin: 试斩那夜首级落地，颔下须髯犹连刃上——旧名由此而来
	Power: 「断首」残心与灭世一闪对生命低于35%的目标追加随伤势递增的终结伤害（至多+50%，首领+25%）；以此二式了结目标时，每式返还10点架势
	Burden: 面板伤害 -10%——目标健壮时，这把刀比原铭更钝
	Summary: 残血终结增强，斩杀返势；面板伤害 -10%
}

MeiOnikiri: {
	DisplayName: 鬼切
	Origin: 一条戾桥，断腕的鬼没敢回来讨。此名自此钉在茎上
	Power: 原铭。维持这把刀现有的一切——不增一分，不减一毫
	Burden: ———
	Summary: 原铭，维持原有刀性，无赋效亦无代价
}

MeiShishinoko: {
	DisplayName: 狮子之子
	Origin: 夜半置于枕边，刀作狮吼。金字象嵌，以荣其名
	Power: 「狮势」不被疾走或特殊技打断地连续完成五段连斩，第五拍狮口合颚，追加两道交叉刃波（合计约四成一斩之力）
	Burden: 连段排拍间隔 +10%——吼声要蓄，刀就得慢
	Summary: 完整五连第五拍合颚刃波；连段变慢 10%
}

MeiTomokiri: {
	DisplayName: 友切
	Origin: 与友刀相试，误断其身。咎名入茎，刀性自此暴烈
	Power: 「咎影」以神威疾走取消连段时，原地留下一道约三成五之力的延迟斩影，滞拍后咬合
	Burden: 手持期间承受的伤害 +10%；每道斩影积一层「咎」（至多三层），每层令下次疾走多耗6点气力，残心命中后偿清
	Summary: 疾走取消留延迟斩影；承伤 +10%，积咎耗气
}

MeiKazehi: {
	DisplayName: 风樋
	Origin: 樋开如风道，挥刀过处只闻风声，不见刀影
	Power: 「顺风」神威疾走气力消耗 -25%，樱流巡航耗气 -30%
	Burden: 疾走墨痕伤害 -25%——樋为轻身而开，不为杀伐
	Summary: 身法省气；墨痕伤害 -25%
}

MeiChihi: {
	DisplayName: 血樋
	Origin: 此樋不为轻身，为放血——开锋人如是说
	Power: 「回流」连段每拍首次命中额外回气 +2，残心命中再回气 +8
	Burden: 自然回气减半，招式消耗后的回气延迟 +0.4秒——刀不沾血，气就不回
	Summary: 命中回气增强；自然回气减半
}

MeiFudo: {
	DisplayName: 不动
	Origin: 以梵字カーン笔意入雕，不动尊坐镇刃侧，背负火焰
	Power: 「不动护」连段重拍、残心或处决中受击时，消耗20点架势削减该击40%伤害并免除击退（冷却约2秒）；肢解的反噬不受庇护
	Burden: 常规架势获取 -20%——护身的力，从蓄势里扣
	Summary: 承诺动作中耗架势挡伤；架势获取 -20%
}

MeiKurikara: {
	DisplayName: 倶利伽罗
	Origin: 龙缠剑而欲吞之——刀身雕的古题，金鳞入缝
	Power: 「龙火回环」灭世一闪或终结乱舞之后点燃雕纹；十秒内完成一套五段连斩，第五拍释放一道约四成之力的龙火回环斩
	Burden: 气力上限 100 → 80——龙盘着的那截刀身，气走不通
	Summary: 处决后点燃龙火连段；气力上限 -20
}
MeiTessetsu: {
	DisplayName: 铁截
	Origin: 名唬人，刃却像一截铁——拆台的旧话钉进茎里
	Power: 「断首」残心与灭世一闪对残血目标追加终结伤害；面板更钝
	Burden: 面板伤害 -15%——收残血痛快，满血更笨
	Summary: 残血终结；面板伤害 -15%
}

MeiKyushu: {
	DisplayName: 旧首
	Origin: 头还是旧的。断得干脆，不必换名吓唬谁
	Power: 「断首」残心与灭世一闪对残血目标追加终结伤害
	Burden: 面板伤害 -8%——旧法收头，税略轻
	Summary: 残血终结；面板伤害 -8%
}

MeiIkiai: {
	DisplayName: 息合
	Origin: 对视那一瞬憋住的气，合拍落刃
	Power: 「狮势」不被打断地完成连斩，末拍合颚刃波
	Burden: 连段排拍间隔 +5%——浅蓄，非金荣名
	Summary: 连斩合颚；连段略慢
}

MeiKyoko: {
	DisplayName: 虚吼
	Origin: 吼进空里，回声找不到落点
	Power: 「狮势」完整连斩末拍合颚刃波
	Burden: 连段排拍间隔 +14%——失焦时更慢
	Summary: 连斩合颚；连段更慢
}

MeiKarikiri: {
	DisplayName: 假切
	Origin: 学得像，越像越假。咎影学步入茎
	Power: 「咎影」疾走取消连段时留下延迟斩影
	Burden: 承伤 +12%；积咎耗气——假步乱闪更痛
	Summary: 取消留影；承伤 +12%
}

MeiMokukiri: {
	DisplayName: 默切
	Origin: 空气沉下去了。习惯了，咎还在
	Power: 「咎影」疾走取消连段时留下延迟斩影
	Burden: 承伤 +8%；积咎耗气——沉着闪仍咬，慌闪仍崩
	Summary: 取消留影；承伤 +8%
}

MeiKogehi: {
	DisplayName: 焦樋
	Origin: 烫滩旁别伸脚。樋为躲开热而开
	Power: 「顺风」疾走耗气更省，樱流略省
	Burden: 墨痕伤害更低——站桩更亏
	Summary: 走位更省气；墨痕伤更弱
}

MeiKanhi: {
	DisplayName: 闲樋
	Origin: 门口清静，耳朵歇一会儿
	Power: 「顺风」樱流巡航更省气，疾走略省
	Burden: 墨痕伤害略降——闲时走，战中勿硬刚
	Summary: 巡航更省；墨痕略弱
}

MeiTodohi: {
	DisplayName: 滞樋
	Origin: 黏是黏了点。沾着转，脱开就滞
	Power: 「回流」连段命中回气略多
	Burden: 自然回气更差，回气延迟更长——脱战更旱
	Summary: 贴脸回气；脱战更滞
}

MeiShiorihi: {
	DisplayName: 谢樋
	Origin: 剪败花，为开锋，不为好看
	Power: 「回流」残心命中回气更厚，连段回气略薄
	Burden: 自然回气仍差——瞎挥不养刀
	Summary: 残心多回气；自然回气差
}

MeiShiohi: {
	DisplayName: 潮樋
	Origin: 潮痕过夜。湿着贴脸才回
	Power: 「回流」命中与残心回气拉长
	Burden: 自然回气更差——过夜式脱战更旱
	Summary: 湿命中回气；脱战更旱
}

MeiShibori: {
	DisplayName: 痺雕
	Origin: 麻着手也护一下。刀也疼
	Power: 「不动护」承诺动作中耗架势挡伤
	Burden: 架势获取 -30%——厚护从蓄势里多扣
	Summary: 承诺招挡伤；架势获取 -30%
}

MeiChinmei: {
	DisplayName: 镇鸣
	Origin: 耳嗡的时候，先镇住再动
	Power: 「不动护」承诺动作中耗架势挡伤
	Burden: 架势获取 -15%——歇着护，猛攻攒势慢
	Summary: 承诺招挡伤；架势获取 -15%
}

MeiAshidome: {
	DisplayName: 止足
	Origin: 站住别晃。脚定了，护才在
	Power: 「不动护」承诺动作中耗架势挡伤
	Burden: 架势获取 -22%——边跑边砍护不住的感觉仍在
	Summary: 承诺招挡伤；架势获取 -22%
}

MeiYoen: {
	DisplayName: 余炎
	Origin: 烤箱余温还在刃上。火熄了，烫没熄
	Power: 「龙火回环」处决后点燃，窗内完整连段末拍龙火
	Burden: 气力上限略降——余烬也能烧空气
	Summary: 处决后龙火连段；气上限略降
}
