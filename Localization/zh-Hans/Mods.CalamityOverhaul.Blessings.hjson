System: {
	UnlockBroadcast: 死神颔首，「{0}」已入往生轮
	KindleLabel: 点燃
	SnuffLabel: 熄灭
	BurningCounter: 燃焰 {0}/{1}
	SlotFullNotice: 灯座已满，先熄灭一盏，才能点燃新的祝福
	LockedHint: 在修罗降世时讨伐它，魂焰才会归位
	HudName: 引魂灯
	HudOpenHint: 点击打开往生轮
	WheelTitle: 往生轮
