CWRServerConfig: {
	DisplayName: 内容设置

	WeaponOverhaul: {
		Label: 武器大修
		Tooltip:
			'''
			启用后会修改大部分的武器
			[c/FF0000:如果您希望可以最优化的体验灾厄大修的内容，请开启它！]
			'''
	}

	ScreenVibration: {
		Label: 武器特殊攻击屏幕振动效果
		Tooltip: 如果开启，在进行一些攻击时会让屏幕发生振动，这或许可以让打击感更加强烈
	}

	DomainConciseDisplay: {
		Label: 领域简约显示
		Tooltip: 默认关闭，开启后会屏蔽掉领域内大多数的视觉效果
	}

	Headers: {
		CWRSystem: 大修系统设置
		CWRWeapon: 大修武器设置
		CWRWorldGen: 大修结构设置
	}

	LensEasing: {
		Label: 镜头缓动
		Tooltip: 启用后，长距离快速位移会让镜头具有缓动，这避免了移动过快所带来的违和感
	}

	BiologyOverhaul: {
		Label: 生物大修[c/06e33f:(实验性)]
		Tooltip:
			'''
			[c/c20909:未完成]
			默认开启，会修改一些生物的AI行为，比如死亡模组下的BossAI
			这可能会让游戏的挑战性剧增，可以根据个人喜好选择是否关闭
			'''
	}

	QuestLog: {
		Label: 任务书指引
		Tooltip:
			'''
			启用后，在游戏进程中将会有任务书指引玩家
			可以使用任务书物品、背包中的启动UI，或者快捷键打开任务书界面查看当前任务
			默认开启，禁用后将不会有任何任务指引
			'''
	}

	DialogueBox_Scale_Value: {
		Label: 对话框缩放
		Tooltip: 调整对话框的整体大小
	}

	GenWindGrivenGenerator: {
		Label: 生成风力发电机
		Tooltip: 在世界中放置风力驱动的发电机结构
	}

	GenWGGCollector: {
		Label: 生成拾荒者
		Tooltip: 在世界各处随机生成拾荒者敌对建筑，这个设置只会在传奇世界中生效
	}

	GenJunkmanBase: {
		Label: 生成拾荒者基地
		Tooltip: 在荒原或地下生成拾荒者的据点基地
	}

	GenRocketHut: {
		Label: 生成火箭小屋
		Tooltip: 生成一个含有火箭零件或科技遗物的神秘小屋
	}

	GenSylvanOutpost: {
		Label: 生成森之哨站
		Tooltip: 在森林深处生成木制的精灵或森林守卫哨站
	}

	ConfigChangePrefix: 用户
	ConfigChangeSuffix: 修改了服务端配置
}
