CWRServerConfig: {
	DisplayName: 内容设置
	Headers.CWRWorldGen: 大修结构设置

	GenWindGrivenGenerator: {
		Label: 生成风力发电机
		Tooltip: 在世界中放置风力驱动的发电机结构
	}

	GenWGGCollector: {
		Label: 生成拾荒者
		Tooltip: 在世界各处随机生成拾荒者敌对建筑，这个设置只会在传奇世界中生效
	}

	GenJunkmanBase: {
		Label: 生成拾荒者基地
		Tooltip: 在荒原或地下生成拾荒者的据点基地
	}

	GenRocketHut: {
		Label: 生成火箭小屋
		Tooltip: 生成一个含有火箭零件或科技遗物的神秘小屋
	}

	GenSylvanOutpost: {
		Label: 生成森之哨站
		Tooltip: 在森林深处生成木制的精灵或森林守卫哨站
	}

	GenSHPCCradle: {
		Label: 生成SHPC坠舱空岛
		Tooltip: 在出生点上空生成一座坠毁舱段空岛，其中封存着SHPC。关闭后该武器将只能从灾厄的实验室获取
	}

	ConfigChangePrefix: 用户
	ConfigChangeSuffix: 修改了服务端配置
}

CWRClientConfig: {
	DisplayName: 客户端设置

	Headers: {
		CWRWeapon: 大修武器设置
		CWRDisplay: 显示设置
		CWRModCompat: 模组兼容补丁
	}

	ScreenVibration: {
		Label: 武器特殊攻击屏幕振动效果
		Tooltip: 如果开启，在进行一些攻击时会让屏幕发生振动，这或许可以让打击感更加强烈
	}

	DomainConciseDisplay: {
		Label: 领域简约显示
		Tooltip: 默认关闭。开启后仅简化赛博空间、海域等领域演出，不影响鬼切鬼域，以及肢解、面影、黑客时间等武器与植入体效果
	}

	LensEasing: {
		Label: 镜头缓动
		Tooltip: 启用后，长距离快速位移会让镜头具有缓动，这避免了移动过快所带来的违和感
	}

	AmbienceDensity: {
		Label: 氛围密度
		Tooltip: 只缩放装饰性氛围粒子的密度，预告与危害的可见性永不受影响
	}

	RarityTextEffects: {
		Label: 稀有度名称特效
		Tooltip: 本模组稀有度（青金、翠玉、赤铜、鎏金、星银与四传奇）的物品名动态特效。关闭后只保留纯色名字
	}

	CalamityRarityTextFix: {
		Label: 灾厄：修复特效名称文字导致的黑屏
		Tooltip:
			'''
			灾厄的燃金、异域彩虹稀有度以及 [ceffect] 标签的名称特效会在绘制提示框时切换渲染目标，
			导致后备缓冲被清空、整帧画面变黑。开启后改用不依赖渲染目标的等效绘制，
			同时修正非 100% UI 缩放下的错位并降低每帧开销
			'''
	}

	CalamityHolyBurnOrbFix: {
		Label: 灾厄：修复亵渎守卫 / 亵渎天神战斗崩溃
		Tooltip:
			'''
			灾厄的圣焰球拖尾绘制器会缓存弹幕引用，弹幕槽位被其他弹幕复用后仍按原类型绘制，
			引发空引用崩溃（多人模式尤为常见）。开启后在绘制前剔除失效引用
			'''
	}
}
