OnikiriStyleDemo: {
	// MayoName: 绯村真夜
	// L1: 月亮升起来了。绯红的,和我离开那晚一模一样
	// L2: (纸垂在夜风里轻轻晃动,某种视线落在你肩上)
	// L3: 别紧张,刀还在鞘里
	// L4: 这块面板是新裱的:和纸吃了墨,边框是一笔收出来的,顶上那条绸子……嗯,是我系的。你要是盯着这行字看,应该能看到最新的字迹还带着一点没干透的绯色
	// ChoicePrompt: 那么——想先看哪一样?
	// C1: 看看奖励弹窗(绘马)
	// C2: 把刚才的话再演一遍
	// C3: 解开鬼切的封印
	// C4: 今晚就到这里
	// SealedHint: 封印中
	// RewardLine: 拿好。普通的刀而已,但挂牌的样子你看到了
	// ReplayLine1: 好,再来一遍。注意看说话人换行时,朱印是怎么重新盖下去的
	// ReplayLine2: (无名的低语——这一行没有名牌,也没有印)
	// Farewell1: 夜还长,茶就不留你了
	// Farewell2: 下次再见时,希望是在正式的故事里
}

FirstMetHimayo: {
	SpeakerName: 鬼切
	Line1: ……我还活着？
	Line2: 等等，先确认一下……这是招魂吗？
	Line3: 不对
	Line4: 为什么我的意识，现在在一把刀里面？
	Line5: 头疼……我的状态很奇怪
	Line6: 完全搞不懂发生了什么……
	Line7: 不过从今天开始，就请多多关照了
}

ToriiSealedDialogue: {
	L1: （你握住刀柄，指节都攥白了——刀身却纹丝不动，像是和整片大地铸在了一起）
	L2: （刀镡下传来一声几不可闻的叹息，仿佛浅眠的人翻了个身）
	L3: （……现在还不行。这把刀似乎在等一场大火烧到尽头的那天）
}

ToriiShrine: {
	InteractHint: "[右键] 拔刀"
	SealedHint: "[右键] 握住刀柄"
	// InventoryFullHint: 背包已满，腾出一格再来拔刀
}

ItCametoThis: {
	// Line1: 真不想走到这一步啊
	// Line2: 从现在开始，这个世界我接管了
}

//==== 礼物场景（第一版草稿，对齐细纲；文学精修另轮）====
HimayoEyeOfCthulhuGift: {
	L0: 我们那儿以前有个人，睡觉眼睛不合上
	L1: 被子盖得好好的，就那么对着房梁瞪着
	L2: 看着就困。算了，不说了
}

HimayoEvilBossGift: {
	L0Worm: 一截一截挤在土里……腥得慌
	L0Brain: 脑子不该露在外面的。湿乎乎的
}

HimayoCalamityEvilGift: {
	L0: 哎，你袖口
	L1: 鞋边也沾上了吧
	L2: 先去洗手。别到处摸
}

HimayoSlimeGodGift: {
	L0: 外面倒是干了。别蹭我
	L1: 拿着。别问
}

HimayoWallOfFleshGift: {
	L0: 墙倒了
	L1: 后面会不一样。像要变天那样
}

HimayoAquaticScourgeGift: {
	L0: 刃上全是腥的。我住里面，闻着难受
	L1: 下次别整柄往味里杵
}

HimayoBrimstoneElementalGift: {
	L0: 热气还没散。先别碰那滩
}

HimayoDestroyerGift: {
	L0: 叫毁灭者……不就是很长的铁吗
	L1: 那个，别掉地上
}

HimayoTwinsGift: {
	L0: 两个人对视太久，会忍不住笑
	L1: 你懂吧。越忍越想笑那种
}

HimayoSkeletronPrimeGift: {
	L0: 头像旧的，身子却是新拼的……别扭
}

HimayoCalamitasCloneGift: {
	L0: 学走路学得那么像，烦
	L1: 拿着
}

HimayoPlanteraGift: {
	L0: 花开败了，就该剪掉
	L1: 梗留着也没意思
}

HimayoGolemGift: {
	L0: 手腕还麻吗。肩膀也缓缓
	L1: 刀别拿去硬磕石头，刃会崩
}

HimayoCultistGift: {
	L0: 门口总算清静了
}

HimayoMoonLordGift: {
	L0: 上面那摊没了
	L1: 你还站得住吗
}

HimayoProvidenceGift: {
	L0: 空气还烫，手背都热
	L1: 拿着
}

HimayoPolterghastGift: {
	L0: 潮气重的地方，东西爱霉
	L1: 别在这儿过夜
}

HimayoDevourerOfGodsGift: {
	L0: 太大了。空得发虚
	L1: 别看太久
}

HimayoYharonGift: {
	L0: 刃还烫。我这边也热
	L1: 先别急着入鞘
	L2: 这个，先搁一边
}

HimayoExoMechsGift: {
	L0: 轰完了，耳朵里还在嗡
	L1: 要不要先避一下吵的地方
}

HimayoSupremeCalamitasGift: {
	L0: 那边弄得夜发黏
	L1: 去吹吹风，或者洗把脸。别愣着
}

HimayoBossRushGift: {
	L0: 先站住
}
