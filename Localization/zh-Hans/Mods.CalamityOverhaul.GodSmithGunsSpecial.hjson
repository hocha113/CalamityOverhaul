GsFlamethrower: {
	Desc:
		'''
		重铸：持续焰流双档。扇焰横扫宽锥并在地面留下燃烧余焰，喷枪聚成贯穿长矛
		右键切换档位。持续压喷会耗尽气压令焰程缩短，松一口气即可回压
		'''
	Mode0: 扇焰
	Mode1: 喷枪
}

GsElfMelter: {
	Desc:
		'''
		重铸：节日焰流双档。融雪扇焰喷洒混着融雪水汽的红绿宽焰，礼物投射聚成窄矛并每 0.8 秒抛出一只燃烧礼物盒，价值 8 份凝胶
		右键切换档位。气压规则依旧：长喷会让焰程缩水
		'''
	Mode0: 融雪扇焰
	Mode1: 礼物投射
}

GsChainGun: {
	Desc:
		'''
		重铸：按住起转进入全域压制，射速一路爬升到全泰拉最快，压满 8 秒枪管红热被迫减速直到松手散热
		右键切换到链式收束：免转管，射速放缓但精准而沉重。压制开火时移动速度下降
		'''
	Mode0: 全域压制
	Mode1: 链式收束
}

GsDartPistol: {
	Desc:
		'''
		重铸：双射击档。双针点射打出两连快镖，第二支 70% 伤害；静息狙杀要求站定 0.8 秒，换来一支 +60% 伤害且镖速翻倍的伏击镖
		右键切换档位。镖类弹药特效完整保留
		'''
	Mode0: 双针点射
	Mode1: 静息狙杀
}

GsDartRifle: {
	Desc:
		'''
		重铸：双射击档。贯穿蓄射按住蓄力，瞄准线渐显，松开放镖：满蓄 1 秒时镖速翻倍、贯穿 +2、伤害 +50%；三镖扇一次打出 ±6 度三镖，各 60% 伤害，只耗 1 支镖
		右键切换档位。镖类弹药特效完整保留
		'''
	Mode0: 贯穿蓄射
	Mode1: 三镖扇
}

GsPiranhaGun: {
	Desc:
		'''
		重铸：双狩猎档。咬附是经典的锁定啃咬；鱼群巡域派鱼群绕光标盘旋撕咬 6 秒，环带内的一切都会挨咬，随后游回巢中
		右键切换档位。巡域鱼每口 85% 伤害，同时在场至多 9 条
		'''
	Mode0: 咬附
	Mode1: 鱼群巡域
}

GsToxikarp: {
	Desc:
		'''
		重铸：双吐泡档。毒泡流是经典速射；脓疱以约三倍用时憋出一颗 2.4 倍伤害的臃肿大泡，破裂时炸出 6 枚孢子泡并留下滞留毒雾
		右键切换档位。依旧不吃弹药
		'''
	Mode0: 毒泡流
	Mode1: 脓疱
}

GsCoinGun: {
	Desc:
		'''
		重铸：右键循环面额，只能选中身上带着的币。铜币打出三连溅射，银币多贯穿一个目标，金币伤害 +10%，铂金币命中爆出金光
		投资回报：击杀返还 1 枚该面额硬币，每秒封顶 3 枚
		'''
	Denom0: 铜币溅射
	Denom1: 银币贯穿
	Denom2: 金币分量
	Denom3: 铂金爆华
	NoCoins: 没有可装填的硬币！
}
