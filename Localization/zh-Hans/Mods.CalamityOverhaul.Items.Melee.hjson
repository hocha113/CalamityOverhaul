DivineSourceBlade: {
	DisplayName: 金源灭却刃
	Tooltip:
		'''
		挥舞金源巨刃斩击敌人
		每一段挥砍都沿刀路甩出追踪光矢，最后一段释放强大的新月剑气
		伤害敌人为你的武器缓慢充能，右键消耗充能强化武器 7 秒
		期间金源将增幅你的武器，光矢化作巨型光枪，可贯穿 3 名敌人
		"金源之蕴引导至你的刃尖...不息"
		'''
}

CursedflameBloodfist: {
	DisplayName: 咒焰血拳
	Tooltip:
		'''
		左右开弓灌出高速连打，散出成串的飞行火焰拳，施加诅咒之焰
		同时享受近战与魔法加成
		"这条手臂原本长在谁身上？已经烧得看不出来了"
		'''
}

Arbiter: {
	DisplayName: 断罪师
	ManifestInteractHint: "[右键] 拔出这柄斧"
	ManifestInventoryFullHint: 背包已满，腾出一个空位后再拔斧
	Tooltip:
		'''
		长按左键蓄力，高举断罪之斧
		松开后向下劈砍，在地面释放向两侧蔓延的火焰冲击波
		蓄力越久，火焰蔓延越远，威力越强
		"审判从烈火中升腾"
		'''
}

Cloudwalking: {
	DisplayName: 云端漫步
	Tooltip:
		'''
		长按左键蓄力高举大斧
		松开后斧头向前飞出，途中喷洒云雾
		自动飞回玩家手中
		'''
}

DawnshatterAzure: {
	DisplayName: 苍穹破晓
	Tooltip:
		'''
		按住左键使出连段，五段一轮，末段回旋燃起日冕
		右键举枪蓄力，向准星方向突进
		"烈火净化灵魂，将你的敌人彻底掠夺干净"
		'''
}

Flawless: {
	DisplayName: 化境
	Tooltip:
		'''
		连续挥舞化境四连斩击，最后一击进行强力突刺
		"矛尖换了七次，靶上只有一个孔"
		'''
}

StormGoddessSpear: {
	DisplayName: 风暴女神之矛
	Tooltip:
		'''
		发射出带有毁灭电弧的风暴之吻
		手持时召唤风暴女神残魂协助作战
		[legend]
		'''
	Legend:
		'''
		阿莉娜，泰拉曾最为锐利的锋刃。
		她信仰坚定，勇猛骁战。铁屑银枪，丝发乱舞。雷暴之刃，呼啸而过。
		然而，再锋利的剑刃也会溃败崩摧，信仰却换来了神明的冷漠。
		当至高降下神罚，她的战友、亲族、誓言与荣耀一同化为灰烬。
		亲眼见证，何所谓正义践踏一切...血泪...尘土......何以借秩序的名义行驶最卑鄙的毁灭。
		神明啊......阿莉娜不再仰望神明。
		她退回深渊，摧毁了自己，让古老的禁忌之力任意蚕食她的灵魂
		阿莉娜的身甲融作深渊铁铸的残躯。那往日的残云、赤血遮日与过往交织，战友...还有亲族死前的凝视......阿莉娜...一切都已结束。
		她已不再是曾经的阿莉娜，那位守护泰拉的战神
		她的怒火如狂风般归来，卷入战场的蝼蚁，她的雷霆横空霹雳，洪声震开云与天空，裂开王座与大地。
		风暴女神，阿莉娜，无情地带来了毁灭与复仇。
		'''
}

DragonsScaleGreatsword: {
	DisplayName: 龙藻巨刃
	Tooltip:
		'''
		挥砍遵循三段连击，第三段释放更具龙威的终结重斩
		挥砍释放螺旋绿藻剑气，击中目标后炸成数团毒藻雾
		真近战攻击会生成大量毒藻雾
		右键召唤翠龙之魂撕咬光标方向的敌人，沿途散播毒藻雾
		'''
}

CosmicCalamity: {
	DisplayName: 银河之灾
	Tooltip: 攻击生成月牙型冲击波
}

SpearOfLonginus: {
	DisplayName: 朗基努斯之枪
	Tooltip:
		'''
		手持时身下浮现圣神十字架，自动汲取圣神能量
		每次能量条充满便完成一次充能，最高叠加到六重立场
		手持时对最近的敌人进行命运标记
		立场击中标记的敌人后将触发朝圣者之怒
		[legend]
		'''
	Legend:
		'''

		“破碎的神啊，请允许我赎还我的罪。”
		战争已经蔓延数个世纪，我，作为逃离伟大文明的溃败者，孤身在这宇宙边缘的荒凉星球上苟且生存。
		数万光年外，战争的巨械在碾碎星辰，残暴而可怖的攻击能在瞬息间清除数光年的星空，将其变为寂静之域。
		而这样的战争，持续了数百年，如今，我所属的伟大文明岌岌可危，我将成为宇宙中的罪人，成为那最为不敬的亵渎者。
		我的血肉已然腐朽，骨骸如同岁月的老化皱纹，我即将沦为我所创造的孱弱机械之一。
		在此之前，愿神赐予我宽恕，赦免我对这至高存在的不敬之罪，让我在灵魂陨落的那一刻，陷入炼狱的深渊，受那无尽的苦痛。
		然而，无论如何，为了我所属的文明，为了在这场跨越世纪的战争中取得胜利，我必须汲取这至高之物残缺的力量。
		为了引导它的神秘力量，我别无选择，只能将冰冷的机械灌注进它破碎的神体之中。
		这是一场不可避免的亵渎，为了文明的延续，为了战争的胜利，我不得不成为那至高之物最虔诚的信徒，有史以来最不敬的亵渎者。
		'''
}

NeutronGlaive: {
	DisplayName: 黑域斩切
	Tooltip:
		'''
		挥舞将发射强大的引力波剑气，击中目标后生成一次中子星爆炸
		右键持剑蓄力，蓄力完成后松开可以在光标处引发一次大型的中子星爆炸
		蓄力未完成松开则会让能量倾泻而出
		'''
}

NeutronScythe: {
	DisplayName: 黑洞使者
	Tooltip:
		'''
		高速旋飞的中子飞镰，飞行途中会朝最近的敌人发射伽马射线，并沿轨迹留下数个翘曲爆破点
		右键释放黑洞爆发，向四周同时投出十三柄飞镰
		'''
}

RebelBlade: {
	DisplayName: 叛逆之刃
	Tooltip:
		'''
		真近战会在目标周围生成大量恶魔光球
		右键操控剑刃飞行，并向光标处进行斩切
		'''
}

WeaverGrievances: {
	DisplayName: 纠缠之怨
	RitualInteractHint: "[右键] 拔出这把刀"
	RitualInventoryFullHint: 背包已满，腾出一个空位后再拔刀
	Tooltip:
		'''
		释放大量怨灵之爪，在地狱、地牢环境中拥有特殊效果
		挥砍遵循三段连击，第三段将化为大范围的终结回旋斩
		右键向光标方向翻滚，化作怨魂风车，翻滚过程中撞击到敌人会给予玩家无敌帧
		近距离翻滚将视为一次完美闪避
		[legend]
		'''
	Legend:
		'''
		恒古不变的地牢横亘大地，其墙壁刻满古战士的铭文与嘶喊。每一块砖石都渗透凝滞的怨念，宛如亡魂的锁链，将其困缚于时间尽头的无尽黑夜。  
		这些战士曾是君王的利刃，为其征战四方。他们的剑光曾照亮无数战场，鲜血浇筑泰拉的巍峨。他们的忠诚如星辰恒久，信念如铁石坚不可摧。
		然而，当战争终结，魔君的旗帜在君王脚下撕裂，和平降临的瞬间，君王却下令将他们投入黑暗深渊。  
		“吾辈未曾背叛，君王却叛于我！”怨灵的哀号撕裂虚空，贯穿亘古的寂静。他们的英灵未能归于尘土，而是被囚于虚无深渊，成为永夜的见证者。
		那些不休的哭喊化作无声的指控，刺向星界的尽头。  
		传言，君王因恐惧他们的忠诚与怒火，听从魔君术士的低语，选择将这些战士化为历史的阴影。
		可怨念如潮，扭曲了地牢的现实。他们的痛苦撼动时空屏障，编织出复仇的预言：  
		“魔君终将归来，虚空将被撕裂，吾辈怒焰将焚尽一切！”  
		当泰拉再度面临覆灭的危机，这些亡灵将从黑暗中崛起。他们的剑将不再为泰拉的荣耀而战，而是为了审判背叛者。  
		荣耀与忠诚早已湮灭，复仇的烈焰终将吞噬一切。
		'''
}

SandDagger: {
	DisplayName: 潜沙匕首
	Tooltip:
		'''
		直线掷出，飞行时受重力轻微下坠
		撞地后嵌入；若插入沙地则蓄势上冲，引爆地脉冲击波并喷射黄沙利刺
		'''
}

WastelandFang: {
	DisplayName: 荒芜牙猎
	Tooltip:
		'''
		与物块发生反弹，并加速收回
		会张开嘴吐出几团沙球
		'''
}

SeasonalKunai: {
	DisplayName: 季节苦无
	Tooltip:
		'''
		一次掷出四把扇形主苦无，主苦无具备高穿透并随飞行渐渐扩张
		命中或寿命终结时迸裂为三把次级飞刃做扇形扫荡
		日间附加破晓灼烧，夜间附加夜衰
		"映射四季"
		'''
}

WraithKunai: {
	DisplayName: 幽魂苦无
	Tooltip:
		'''
		一次掷出三把扇形猩红飞刀，飞刀先疾飞短停，再从远处加速冲撞最近敌人
		冲锋命中时引发猩红冲击与屏幕震颤，寿命终结时炸裂为灼魂火浪
		日间附加灼烧，夜间附加灵魂燃烧
		'''
}

CommandersChainsaw: {
	DisplayName: 统帅链锯
	Tooltip:
		'''
		击中目标时生成火花
		"多加点柴油"
		'''
}

GeminisTribute: {
	DisplayName: 双生彼岸
	Tooltip:
		'''
		交替投掷激光眼与魔焰眼飞镰，沿正弦波路径来回切割
		右键同时释放双镰交叉飞行，命中目标处会凝结融合魔眼向四周轰射双色脉冲
		"只能存在一个主人格，很明显是魔焰眼胜利了"
		'''
}

DestroyersBlade: {
	DisplayName: 毁灭者之刃
	Tooltip:
		'''
		发射热能弹幕
		"蕴含着毁灭者强大的能量核心"
		'''
}

Observer: {
	DisplayName: 观察者
	Tooltip: '''"它还在盯着你"'''
}

Shatterfang: {
	DisplayName: 崩牙獠刃
	Tooltip:
		'''
		每次挥舞投掷小型牙齿碎片，持续挥舞会摧毁你的武器，并释放崩坏斩
		崩坏斩将投掷大块牙齿碎片
		长按右键以修复你的武器
		"从瞳魔口中崩落的獠牙，仍带着咬合的执念"
		'''
}

CommandersClaw: {
	DisplayName: 统帅之钳
	Tooltip:
		'''
		掷出装饰精美的统帅长矛，枪尖始终朝向飞行方向
		命中时迸发金属火星与冲击波，并使屏幕轻微震颤
		长矛可同时存在多支，撞墙后插入地形，刺中敌人时则贴附其上短暂保留
		'''
}

CommandersChainsawEX: {
	DisplayName: 统帅链锯EX
	Tooltip: '''"切碎挡在你面前的一切"'''
}

DestroyersBladeEX: {
	DisplayName: 毁灭者之刃EX
	Tooltip:
		'''
		沉重挥舞,劈出裹挟着光束与暗影的黑红斩击
		不攻击时进入潜猎协议，获得移速提升，伺机接近猎物
		潜猎中按右键将化身毁灭者之鄂，向附近的敌人或鼠标方向撕咬
		撕咬得手造成巨额伤害,并进入歼灭协议。弹幕获得毁灭之力强化,额外发射毁灭者之颅
		"摧毁永远比建造容易"
		'''
}

EnergySword: {
	DisplayName: 能量剑
	Tooltip:
		'''
		消耗能量发射激光，穿透多个敌人
		"利用率并不高"
		'''
}

SporeboundRoller: {
	DisplayName: 牵滚菌
	Tooltip:
		'''
		击中敌人后生成一个飘逸的小蘑菇
		"它们喜欢滚来滚去"
		'''
}

SporeburstPouch: {
	DisplayName: 菌泡囊
	Tooltip:
		'''
		投出一颗旋转下坠的菌孢手雷，命中或寿命结束时引爆
		迸发毒雾冲击波并向四周喷射追踪孢子破片，命中目标使其中毒
		'''
}

Heartcarver: {
	DisplayName: 刻心者
	Tooltip:
		'''
		刺击出手时掷出旋转的血匕，循着伤口的气味追猎
		右键进行短距离弧线突刺
		吸收剜出的心脏可获得短暂攻速提升，并凝成环绕血刃
		血刃会循着你下一次剜心击的声音扑向伤口
		'''
	CarveTip:
		'''
		手持时，刀会带着你的心一起跳
		攻击落在两次心跳之间的间隙，即构成剜心击
		以剜心击完成终结斩，能把心脏完整地剜出来
		'''
}

OniMachete: {
	DisplayName: 鬼面刀
	Tooltip:
		'''
		左键挥出三段连击，第三刀为滞拍蓄势的金崩重斩
		手持时唤出六只鬼手协助战斗
		'''
	SuppressTip:
		'''
		挥砍与命中积累硫火压制，六只鬼手的每次出击都在消耗它
		压制熄灭时鬼手躁动：它们打得更凶，也随时会回头掐住你的脖子
		'''
}

AncientStormGoddessSpear: {
	DisplayName: 远古风暴女神之矛
	Tooltip:
		'''
		发射出带有毁灭电弧的风暴之吻
		"它已经是时代的过去了，但仍旧管用"
		[legend]
		'''
	Legend:
		'''
		阿莉娜，泰拉曾最为锐利的锋刃。
		她信仰坚定，勇猛骁战。铁屑银枪，丝发乱舞。雷暴之刃，呼啸而过。
		然而，再锋利的剑刃也会溃败崩摧，信仰却换来了神明的冷漠。
		当至高降下神罚，她的战友、亲族、誓言与荣耀一同化为灰烬。
		亲眼见证，何所谓正义践踏一切...血泪...尘土......何以借秩序的名义行驶最卑鄙的毁灭。
		神明啊......阿莉娜不再仰望神明。
		她退回深渊，摧毁了自己，让古老的禁忌之力任意蚕食她的灵魂
		阿莉娜的身甲融作深渊铁铸的残躯。
		那往日的残云、赤血遮日与过往交织，战友...还有亲族死前的凝视......阿莉娜...一切都已结束。
		她已不再是曾经的阿莉娜，那位守护泰拉的战神
		她的怒火如狂风般归来，卷入战场的蝼蚁，她的雷霆横空霹雳，洪声震开云与天空，裂开王座与大地。
		风暴女神，阿莉娜，无情地带来了毁灭与复仇。
		'''
}

Abyssrend: {
	DisplayName: 裂渊
	Tooltip:
		'''
		左键交替用尖端戳刺与侧面斩击，每一击都会撕出追踪猎物的海洋暗流
		右键掀起深渊吸流，把面前的敌人拽到钳口，高举后狠狠砸向近前的地面，引爆高压空化
		被砸中与被空化波及的敌人会陷入渊压，行动大幅迟滞
		"它记得深海把一切压碎时的声音"
		'''
}

TideReaper: {
	DisplayName: 镰渊
	Tooltip:
		'''
		掷出自旋的深渊飞镰，出手后自动回旋归手
		飞行途中不断甩出镰渊新月，新月会追猎附近的敌人
		右键掷出漩涡锚：镰刀钉在前方旋成漩涡
		漩涡把敌人拽向中心，并加速甩出新月，随后返回
		"退潮之后，滩上只剩白骨"
		'''
}

BudPiercer: {
	DisplayName: 蕾锋
	Tooltip:
		'''
		掷出后短暂直飞，随后下坠
		命中敌人时种下花蕾，片刻后绽放一圈花瓣
		多把飞匕可以在同一目标上叠加花蕾
		插进地面时就地开花，向上喷出三根荒针
		"沙蟒的鳞下，每一片都想开花"
		'''
}

Budcrown: {
	DisplayName: 蕾冠
	Tooltip:
		'''
		按住攻击键让锤头绕身悬旋，松开朝准星掷出
		锤头命中敌人时抖落荒针
		每攒满三次命中，锤头怒放，炸出一圈花瓣并猛烈击退
		"最重的花苞，开得最响"
		'''
}
