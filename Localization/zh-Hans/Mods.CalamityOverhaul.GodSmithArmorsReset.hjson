// Godsmith reset armors (R3 identity rework): per-piece lines remain only for pre-hardmode ore chestplates (mining speed);
// every other set keeps its vanilla piece stats. Set bonus lines open with the vanilla bonus, followed by the signature mechanic on a new line.

// Pre-hardmode ores: metal-property ladder (defense only while worn, the property is inherited through helmet nesting)
GsCopperArmor: {
	BodyLine: 挖掘速度提高5%
	SetBonusLine:
		'''
		防御力增加2
		每第6次命中向最近的另一名敌人跳出一道静电弧，造成这次命中40%的伤害
		'''
}

GsTinArmor: {
	BodyLine: 挖掘速度提高6%
	SetBonusLine:
		'''
		防御力增加2
		受到伤害时发出锡鸣震开周围的敌人，每5秒一次
		'''
}

GsIronArmor: {
	BodyLine: 挖掘速度提高8%
	SetBonusLine:
		'''
		防御力增加3
		站立不动1秒后进入铸铁站姿：防御力增加5，穿甲增加10，免疫击退，移动即解除
		'''
}

GsLeadArmor: {
	BodyLine: 挖掘速度提高9%
	SetBonusLine:
		'''
		防御力增加3
		命中敌人有25%概率造成铅毒，每秒造成2点伤害，持续4秒
		'''
}

GsSilverArmor: {
	BodyLine: 挖掘速度提高11%
	SetBonusLine:
		'''
		防御力增加3
		受到伤害后4秒内生命再生速度大幅提高
		'''
}

GsTungstenArmor: {
	BodyLine: 挖掘速度提高12%
	SetBonusLine:
		'''
		防御力增加3
		武器击退提高30%，穿甲增加4
		'''
}

GsGoldArmor: {
	BodyLine: 挖掘速度提高14%
	SetBonusLine:
		'''
		防御力增加4
		每第8次命中向目标掷出3枚金币，每枚造成这次命中35%的伤害
		'''
}

GsPlatinumArmor: {
	BodyLine: 挖掘速度提高15%
	SetBonusLine:
		'''
		防御力增加4
		免疫中毒、流血、虚弱与黑暗
		'''
}

// Armor mark debuffs
GsLeadPoisonBuff: {
	DisplayName: 铅毒
	Description: 每秒损失2点生命，无法自然回复
}

GsAmberSlowBuff: {
	DisplayName: 琥珀凝滞
	Description: 移动速度降低30%
}

GsWebSlowBuff: {
	DisplayName: 蛛丝缠缚
	Description: 移动速度降低30%
}

GsObsidianMarkBuff: {
	DisplayName: 曜岩印
	Description: 被仆从命中时受到额外伤害
}

// The eight wood sets
GsWoodArmor.SetBonusLine:
	'''
	防御力增加1
	砍树时有机会掉落额外的木材
	'''
GsBorealWoodArmor.SetBonusLine:
	'''
	防御力增加1
	砍树时有机会掉落额外的木材
	'''
GsRichMahoganyArmor.SetBonusLine:
	'''
	防御力增加1
	砍树时有机会掉落额外的木材
	'''
GsPalmWoodArmor.SetBonusLine:
	'''
	防御力增加1
	砍树时有机会掉落额外的木材
	'''
GsEbonwoodArmor.SetBonusLine:
	'''
	防御力增加1
	砍树时有机会掉落额外的木材
	'''
GsShadewoodArmor.SetBonusLine:
	'''
	防御力增加1
	砍树时有机会掉落额外的木材
	'''
GsAshWoodArmor.SetBonusLine:
	'''
	防御力增加1，受到的岩浆伤害减半
	砍树时有机会掉落额外的木材
	'''
GsPearlwoodArmor.SetBonusLine:
	'''
	防御力增加1
	砍树时有机会掉落额外的木材
	'''
// Other pre-hardmode sets
GsCactusArmor.SetBonusLine:
	'''
	触碰你的敌人会受到荆棘反伤
	受到伤害时向四周迸射5根仙人掌尖针
	'''
GsEskimoArmor.SetBonusLine:
	'''
	免疫寒冷与冰冻，在雪原环境防御力增加3
	受到伤害时抖落寒雪，使周围敌人寒冷2秒，每3秒一次
	'''
GsPinkEskimoArmor.SetBonusLine:
	'''
	免疫寒冷与冰冻，在雪原环境防御力增加3
	受到伤害时抖落寒雪，使周围敌人寒冷2秒，每3秒一次
	'''
GsAnglerArmor.SetBonusLine:
	'''
	手持鱼竿时敌怪生成率降低
	每次抛竿多甩出3根鱼线，且有机会钓上异地鱼类或增益药水包
	'''
GsNinjaArmor.SetBonusLine:
	'''
	移动速度提高20%
	飞刀、手里剑与尖球不再消耗，投掷速度提高15%，伤害增加3并造成流血
	'''
GsFossilArmor.SetBonusLine:
	'''
	20%概率不消耗弹药，飞刀、手里剑与尖球不再消耗
	远程命中有20%概率使敌人陷入琥珀凝滞2秒，移速降低30%
	'''
GsShadowArmor.SetBonusLine:
	'''
	奔跑速度与加速度大幅提高
	攻击暴击时会使敌人附带暗影焰灼烧2秒
	'''
GsCrimsonArmor.SetBonusLine:
	'''
	生命再生速度大幅提高
	命中半血以下敌人有20%概率放出回旋血蛭，咬中后返回治疗3点生命
	'''
GsMeteorArmor.SetBonusLine:
	'''
	太空枪不消耗魔力
	魔法命中有15%概率引落一颗爆燃的小陨石坠向目标
	'''
GsNecroArmor.SetBonusLine:
	'''
	远程暴击率提高10%
	远程命中时有20%概率向目标掷出穿透骸骨，击杀敌人时尸体会爆裂出3根碎骨
	'''
GsJungleArmor.SetBonusLine:
	'''
	魔力消耗降低16%
	魔法命中后在目标处滞留一团毒孢子，孢子每次造成伤害为你回复2点魔力
	'''
GsBeeArmor.SetBonusLine:
	'''
	召唤伤害提高10%
	3只巨蜂护卫环绕身侧自动扑咬近身敌人，受到伤害时它们会立刻群起反击
	'''
GsObsidianArmor.SetBonusLine:
	'''
	召唤伤害提高15%，鞭子攻速提高15%，攻击范围增加30%，可在狱石与陨石上行走
	鞭子命烙上曜岩印3秒，仆从命中带印敌人额外造成4点固定伤害
	'''
GsMoltenArmor.SetBonusLine:
	'''
	近战伤害提高10%，免疫着火了，近战攻击必定点燃敌人
	每第6次近战命中在目标脚下喷发出一柱升腾的熔岩地火
	'''
// Hardmode ores: the helmet's vanilla class set bonus stays, one metal property is layered on top
GsCobaltArmor.SetBonusLine:
	'''
	头盔对应的原版职业套装奖励照常生效
	5秒内未受伤进入疾影步，移速提高8%，每第5次命中释放一道穿梭的钴蓝剑气
	'''
GsPalladiumArmor.SetBonusLine:
	'''
	命中敌人仍会触发原版的快速生命回复
	连续攻击同一敌人6次时催生出一枚寄生光珠，吸取精气后折返为你回复8点生命
	'''
GsMythrilArmor.SetBonusLine:
	'''
	头盔对应的原版职业套装奖励照常生效
	每第8次命中在身后铸出一柄秘银灵剑，短暂悬停后向目标迅猛突刺
	'''
GsOrichalcumArmor.SetBonusLine:
	'''
	命中敌人时仍会飘落原版的追踪落英
	同一敌人被花瓣击中5次时，第5片花瓣将分裂出两片额外的追踪落樱
	'''
GsTitaniumArmor.SetBonusLine:
	'''
	击中敌人仍会唤起钛金风暴屏障
	环绕的风暴碎片越多，手持武器暴击率至多提高15%，伤害至多提高10%
	受击后屏障碎片仍会全数碎裂
	'''
GsAdamantiteArmor.SetBonusLine:
	'''
	头盔对应的原版职业套装奖励照常生效
	命中不断积蓄锻炉热量，叠至12层时下一次攻击在目标处爆出6颗迸射的精金余烬
	'''
// Remaining hardmode and endgame sets
GsSpiderArmor.SetBonusLine:
	'''
	召唤伤害提高12%
	仆从命中有20%概率吐出粘稠蛛网缠缚敌人2秒，受到伤害时朝攻击者反喷3道蛛网
	'''
GsFrostArmor.SetBonusLine:
	'''
	近战与远程攻击附带霜冻，伤害提高10%，免疫霜冻、寒冷与冰冻
	近战与远程命中有20%概率从天顶坠下一柄破空冰锥
	受到伤害时释放极寒霜潮冰冻周围普通敌人1秒，每10秒一次
	'''
GsCrystalAssassinArmor.SetBonusLine:
	'''
	伤害与暴击率各提高10%，允许进行水晶冲刺
	冲刺撞击敌人时从其体内迸出5枚锐利的水晶碎片
	每次冲刺后，接下来的3次攻击必定触发暴击
	'''
GsHallowedArmor.SetBonusLine:
	'''
	圣光庇护照常生效，神圣兜帽仍提供2个召唤栏
	圣光闪避成功时向四周引爆6颗穿透圣星，并在接下来的5秒内提升10%伤害与暴击率
	'''
GsBeetleScaleArmor.SetBonusLine:
	'''
	连击不断累积甲虫力量，至多叠加20层，2秒未命中重置
	每层提供1%近战伤害与0.5%近战攻速，满层时攻击有20%概率唤来一只圣甲虫俯冲突袭
	'''
GsBeetleShellArmor.SetBonusLine:
	'''
	受到伤害累积一层甲虫甲壳，至多3层，每层提供6点防御与6%伤害减免，10秒未受击消散
	叠满3层再次受击将震碎甲壳，向伤害来源扇形激射出5片坚硬壳片
	'''
GsTurtleArmor.SetBonusLine:
	'''
	受到的伤害降低15%，近战接触伤害受到双倍反弹
	受到伤害时向全方位射出8根反击棘刺，每根造成防御力2倍的近战伤害，每3秒一次
	'''
GsTikiArmor.SetBonusLine:
	'''
	召唤栏增加1，召唤伤害提高10%，鞭子攻击范围增加20%
	仆从与鞭子攻击有20%概率呼唤一团图腾魂火追踪焚敌并附带剧毒
	'''
GsSpectreHoodArmor.SetBonusLine:
	'''
	魔法攻击造成伤害时仍会吸取治愈灵球，魔法伤害降低40%
	最大魔力值增加100点，魔力自然回复速度加快
	受到伤害时有40%概率即刻回复10%最大生命值，每8秒一次
	'''
GsSpectreMaskArmor.SetBonusLine:
	'''
	魔法攻击造成伤害时仍会释放死灵怨魂，魔力消耗降低15%
	魔法伤害与魔法暴击率各提高10%
	魔法暴击时有30%概率额外激发一枚强力幽魂之火锁敌追击
	'''
GsShroomiteArmor.SetBonusLine:
	'''
	静止时的潜行隐匿能力照常生效，远程暴击率提高15%，30%概率不消耗弹药
	处于深度潜行时，远程命中目标有30%概率在其立足处催生一株连射追踪孢子的菌丝塔
	'''
GsSolarArmor.SetBonusLine:
	'''
	日耀烈阳护盾与猛烈冲撞照常生效
	每层护盾额外提供8点防御力与4%伤害减免
	日耀冲撞击中敌人时，引爆一次更剧烈的烈阳大爆炸
	'''
GsVortexArmor.SetBonusLine:
	'''
	星旋潜行隐形照常生效，潜行期间不消耗弹药，现身时移速提高15%，远程暴击率提高10%
	潜行状态下远程攻击有40%概率在敌人之间弹跳传导一道狂暴的星旋电链
	'''
GsNebulaArmor.SetBonusLine:
	'''
	星云伤害、生命与魔力强化焰照常生效
	每级强化焰额外提供5%魔法伤害、2点生命回复与10%魔力减耗
	魔法攻击有25%概率在目标身上唤醒一朵连续释放两次脉冲能量的星云之花
	'''
GsStardustArmor.SetBonusLine:
	'''
	星尘守卫者照常降临守护
	召唤栏增加3，召唤伤害提高15%
	仆从命中有20%概率从深空引召一枚破空而来的星尘彗星精准轰击
	'''
