GsFlamethrower: {
	Desc:
		'''
		Umschmiedung: Dauerflamme in zwei Gängen. Fächerflamme fegt einen breiten Kegel und hinterlässt Bodenbrand, Strahlrohr bündelt sich zur durchschlagenden Lanze
		Rechtsklick wechselt den Gang. Dauerndes Sprühen leert den Druck und verkürzt die Flamme, eine Atempause baut Druck auf
		'''
	Mode0: Fächerflamme
	Mode1: Strahlrohr
}

GsElfMelter: {
	Desc:
		'''
		Umschmiedung: Festtagsflamme in zwei Gängen. Schneeschmelz-Fächer sprüht breite rot-grüne Flammen mit Schmelzwasserdampf, Geschenkwurf bündelt sich zur schmalen Lanze und wirft alle 0,8 s eine brennende Geschenkbox, Wert 8 Gel
		Rechtsklick wechselt den Gang. Druckregel wie gehabt: langes Sprühen lässt die Flamme schrumpfen
		'''
	Mode0: Schneeschmelz-Fächer
	Mode1: Geschenkwurf
}

GsChainGun: {
	Desc:
		'''
		Umschmiedung: Halten spinnt hoch in die Gebietsunterdrückung, Schussfolge steigt zur schnellsten in ganz Terraria, nach 8 s voller Last glüht der Lauf rot und zwingt dich langsamer, bis du loslässt und er kühlt
		Rechtsklick wechselt zur Kettenbündelung: kein Hochdrehen, langsamere Folge, aber präzise und schwer. Unterdrückungsfeuer senkt deine Bewegungsgeschwindigkeit
		'''
	Mode0: Gebietsunterdrückung
	Mode1: Kettenbündelung
}

GsDartPistol: {
	Desc:
		'''
		Umschmiedung: Zwei Schussgänge. Doppelnadel feuert zwei schnelle Darts, der zweite mit 70% Schaden; Standschuss verlangt 0,8 s Stillstand und gibt einen Hinterhalt-Dart: +60% Schaden, doppelte Geschwindigkeit
		Rechtsklick wechselt den Gang. Dart-Munitionseffekte bleiben vollständig erhalten
		'''
	Mode0: Doppelnadel
	Mode1: Standschuss
}

GsDartRifle: {
	Desc:
		'''
		Umschmiedung: Zwei Schussgänge. Durchschlag-Aufladung: halten lädt, die Visierlinie erscheint, Loslassen schickt den Dart. Volle 1 s Ladung: doppelte Geschwindigkeit, Durchschlag +2, Schaden +50%. Dreierfächer schickt drei Darts bei ±6 Grad, je 60% Schaden, verbraucht nur 1 Dart
		Rechtsklick wechselt den Gang. Dart-Munitionseffekte bleiben vollständig erhalten
		'''
	Mode0: Durchschlag-Aufladung
	Mode1: Dreierfächer
}

GsPiranhaGun: {
	Desc:
		'''
		Umschmiedung: Zwei Jagdgänge. Anbeißen ist der klassische Lockbiss; Schwarmrevier schickt den Schwarm 6 s um den Cursor kreisen und beißen, alles im Ring wird gebissen, dann schwimmen sie zurück ins Nest
		Rechtsklick wechselt den Gang. Revierschwärme beißen mit 85% Schaden, höchstens 9 gleichzeitig
		'''
	Mode0: Anbeißen
	Mode1: Schwarmrevier
}

GsToxikarp: {
	Desc:
		'''
		Umschmiedung: Zwei Blasgänge. Giftblasenstrom ist das klassische Schnellfeuer; Eiterblase braucht etwa dreimal so lang und presst eine geschwollene Blase mit 2,4-fachem Schaden, die beim Platzen 6 Sporenblasen und stehenden Giftnebel hinterlässt
		Rechtsklick wechselt den Gang. Verbraucht weiterhin keine Munition
		'''
	Mode0: Giftblasenstrom
	Mode1: Eiterblase
}

GsCoinGun: {
	Desc:
		'''
		Umschmiedung: Rechtsklick wechselt den Nennwert, nur Münzen die du trägst. Kupfermünzen feuern Dreier-Spritzer, Silbermünzen durchschlagen ein Ziel extra, Goldmünzen +10% Schaden, Platinmünzen explodieren in Goldlicht
		Rendite: eine Tötung gibt 1 Münze dieses Nennwerts zurück, höchstens 3 pro Sekunde
		'''
	Denom0: Kupferspritzer
	Denom1: Silberdurchschlag
	Denom2: Goldgewicht
	Denom3: Platinexplosion
	NoCoins: Keine Münzen zum Laden!
}
