JusticeUnveiled: {
	DisplayName: Offenbarung der Gerechtigkeit
	Tooltip:
		'''
		Fernkampftreffer sammeln „Gerechtigkeitsschlag“-Ladungen, maximal fünf
		[UP] drücken verbraucht eine Ladung und ruft einen gewaltigen heiligen Einschlag herab
		„Wenn Gerechtigkeit gerufen wird, folge ich – wohin auch immer sie führt“
		'''
}

EmblemOfDread: {
	DisplayName: Abzeichen des Todesfürchtenden
	Tooltip:
		'''
		Erhöht Nahkampfschaden um 100 %
		Erhöht Nahkampf-Krit-Chance um 100 %
		Erhöht Nahkampftempo um 100 %
		Erhöht Verteidigung um 100, ignoriert alle Verteidigungsabzüge
		Reduziert erlittenen Schaden um 75 % und reflektiert 100-fachen Schaden auf den Angreifer
		Alle Nahkampfangriffe belegen Gegner mit dem Debuff „Leererosion“
		Bei Gegnern unter 250.000 LP können echte Nahkampftreffer sie direkt auslöschen
		Bei hoher Bewegungsgeschwindigkeit hinterlässt du Verzerrungspunkte auf dem Weg mit extremem Schaden
		Gewährt Gravitationsstoß; [KEY] drücken für extremen Stoß und massive Gravitationsstrahlen
		Bei tödlichem Treffer sofort volle LP und Gravitationsschild (60 s Abklingzeit)
		Gegner zielen leichter auf dich
		[c/d94fff:„Ein geheiligter Engel hüllt deine Augen und flüstert ewige, süße Lügen“]
		[c/ff4d4d:„Ein blutgetränkter Metzger hebt deine Zwillingsklingen und verkündet: Nur Schlachten bringt Ruhm“]
		[c/4da6ff:„Eine azurblaue Taube pickt deine Stirn auf und verspottet deinen kleinen Kampf“]
		'''
}

Proverbs: {
	DisplayName: Spruch
	Tooltip:
		'''
		Erzeugt hinter dir eine kleine Schwefelbrand-Rune
		Immunität gegen die meisten Feuer-Debuffs
		Die meisten Angriffe belegen Gegner mit dem Verwelkungsfluch
		[Content]
		'''
	L1: Doppelter Schaden an der Schwefelbrand-Hexe; ihre Angriffe können dich kritisch treffen
	L2:
		'''
		Wenn du das liest, bin ich wohl schon nicht mehr da.
		Dieser Ring war in meinen langen Jahren das Einzige, das sich wirklich kalt anfühlte.
		Doch irgendwann nahm er sterbliche Wärme auf und wurde … zu heiß zum Loslassen.
		Ich bin zum Schwefelbrand zurückgekehrt, zur Asche einer Ära.
		Ich hätte mit leeren Händen gehen sollen, doch diese eine Wärme ließ mich gierig werden, sie zu bewahren.
		Trage ihn.
		Wenn du dein Schwert gegen die Götter erhebst …
		Selbst wenn die Welt erfriert, brenne ich noch an deinen Fingerspitzen.
		'''
}

Unsunghero: {
	DisplayName: Unbesungener Held
	Tooltip:
		'''
		Hinterlässt beim Gehen eine Spur aus schwarz-weißen Schachbrettfeldern
		„Was, wenn du nicht zurückkommst?“
		„Dann komme ich nicht zurück.“
		'''
}

GodslayerScabbard: {
	DisplayName: Götterschlächter-Scheide
	Tooltip:
		'''
		Beim Halten einer Nahkampfwaffe ohne Angriff sammelt sich Zieh-Ladung
		Bei voller Ladung gewährt der nächste Angriff 2 Sekunden Unverwundbarkeit
		„Die Klinge ruht in der Scheide, doch die Tötungsabsicht ist spürbar
		Wenn die Zeit reif ist, genügt ein Augenblick, einen Gott zu fällen“
		'''
}

FrogsparkBoots: {
	DisplayName: Froschsprung-Glanzstiefel
	Tooltip:
		'''
		Flug, Übersprint, auf Eis sicherer und zerbricht dünnes Eis nicht mehr
		Laufen auf Wasser, Honig und Lava, immun gegen Verbrennung
		Bei Lavakontakt 7 s Immunität, danach stark verminderter Lavaschaden
		Sprungtempo +48 %, Autosprung, stark erhöhte Fallresistenz
		"Ein Froschbeinschlag, und die Flamme bahnt den Weg"
		'''
}

CthulsparkBoots: {
	DisplayName: Cthulhu-Glanzstiefel
	Tooltip:
		'''
		Alle Fähigkeiten der Froschsprung-Glanzstiefel
		Drei Extra-Sprünge: Wolke, Schneesturm, Sandsturm; höhere Sprünge, immun gegen Fallschaden
		Doppeltipp in eine Richtung: stoße mit dem Großen Auge und räume Feinde auf der Bahn
		"Es schwebt über dir und wacht über jeden Schritt"
		'''
}

NinjaCthulsparkBoots: {
	DisplayName: Ninja-Cthulhu-Glanzstiefel
	Tooltip:
		'''
		Alle Fähigkeiten der Cthulhu-Glanzstiefel
		10 % Chance, Angriffe zu weichen; an Wänden klettern und langsam gleiten
		Doppeltipp: Ninja-Scharlachsturm, schneller und weiter, mit scharlachrotem Nachbild
		Der Stoß räumt wie der Cthulhu-Schild und gibt im Trefferaugenblick kurze Unverwundbarkeit
		"Das Große Auge hat sich ein Stirnband gebunden und geschworen, nie wieder zu blinzeln"
		'''
}
