GsElectrosphereLauncher: {
	Desc: Reforged: two or more of your spheres link up with tesla arcs (up to 3, half sphere damage)
	TipOverload: Überladung!
}

GsGrenadeLauncher: {
	Desc: Reforged: grenades stick to walls and foes (+25% damage when stuck on flesh); up to 6 planted, the oldest pops to make room
	TipDetonate: Alle zünden!
}

GsJackOLanternLauncher: {
	Desc: Reforged: every blast leaves a candle field that scorches whoever stands in it
	TipGrin: Gemeinsames Grinsen!
}

GsNailGun: {
	Desc: Reforged: nails embed into flesh (up to 5 per victim), each making the victim take +3% damage from all sources
	TipExtract: Nägel rausreißen!
}

GsProximityMineLauncher: {
	Desc: Reforged: mines show their trigger radius to you; mines idle for 60s refund a rocket and self-clear
	TipChain: Domino!
	TipRecycle: Mine zurückgeholt
}

GsRocketLauncher: {
	Desc: Reforged: shots kick you back, and direct hits hit harder
	TipDetonate: Luftdetonation!
}

GsSnowmanCannon: {
	Desc: Reforged: hits brand victims with a snowflake (+8% from this weapon)
	ModeHoming: Träger: Verfolgender Schwarm
	ModeOrbital: Träger: Blizzard-Orbit
}

GsStarCannon.Desc:
	'''
	Umschmiedung: wechselt die Bahn
	Direkt: Sterne fliegen gerade; Sternfall: Sterne steigen, dann fällt um das Fadenkreuz Sternenregen, Treffer spritzen Sternenstaub
	'''

GsStynger: {
	Desc: Reforged: detonates on hit, with a kick on the shot. Stynger bolts and shrapnel stay as they were
	ModeImpact: Zünder: Aufschlag
	ModeRange: Zünder: Distanz-Luftdetonation
	ModeRicochet: Zünder: Abpraller
}
