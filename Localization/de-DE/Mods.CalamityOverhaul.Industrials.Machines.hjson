	InputHint: Waffe, Rüstung oder Zubehör einlegen
	OutputHint: Klicken, um Barren zu holen
	EstimateLabel: Geschätzter Ausstoß:
	PowerUnit: UE
}

AutoCrafter: {
	DisplayName: Auto-Werkbank
	Tooltip:
		'''
		Rechtsklick öffnet das Panel; Probe einlegen und ein Rezept festnageln
		Die Maschine holt Material aus nahen Truhen und Maschinen und fertigt selbst
		Benötigte Werkstationen müssen in der Nähe stehen
		Fertiges geht zuerst ins nahe Lager, sonst bleibt es im Fertigschlitz
		'''
}

AutoCrafterUI: {
	TitleText: Auto-Werkbank
