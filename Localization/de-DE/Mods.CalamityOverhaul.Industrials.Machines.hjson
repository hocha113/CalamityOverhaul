Thrower: {
	NoEnergyText: Energiemangel!
	NoItemText: Nichts zum Werfen!
	WorkingText: Wirft …
	IdleText: Bereit
	DisplayName: Werfer
	Tooltip:
		'''
		Verbraucht Strom zum Werfen von Gegenständen
		Rechtsklick öffnet das Bedienfeld
		'''
}

PlayerLauncher: {
	NoEnergyText: Energie reicht nicht!
	DisplayName: Schleuderplattform
	Tooltip:
		'''
		Schleudert den darauf stehenden Spieler unter Strom in die eingestellte Richtung
		Kurz nach dem Abschuss immun gegen Fallschaden
		Rechtsklick öffnet das Bedienpanel
		'''
}

PacifierTower: {
	FieldOnText: Feld an
	FieldOffText: Feld aus
	NoEnergyText: Energie reicht nicht!
	DisplayName: Ruhefeld-Generator
	Tooltip:
		'''
		Unter Strom unterdrückt natürliches Spawnen im Bereich
		Rechtsklick oder Drahtsignal schaltet das Feld
		'''
}

PotionBeacon: {
	NoEnergyText: Energie reicht nicht!
	DisplayName: Trank-Streubake
	Tooltip:
		'''
		Stärkungstränke einlegen, die Wirkung dauernd an Spieler im Bereich streuen
		Eine Flasche reicht für die doppelte ursprüngliche Wirkdauer
		Rechtsklick öffnet das Bedienpanel
		'''
}

HerbFarmer: {
	NoEnergyText: Energie reicht nicht!
	DisplayName: Kräuterfarm
	Tooltip:
		'''
		Sät mit Samen und Strom automatisch auf zulässigem Boden in der Umgebung
		Erntet blühende Kräuter, bringt Kräuter und Samen
		Rechtsklick öffnet das Bedienpanel
		'''
}

MushroomFarmer: {
	NoEnergyText: Energie reicht nicht!
	FullText: Ausstoßlager voll!
	DisplayName: Pilzfarm
	Tooltip:
		'''
		Zieht unter Strom gewöhnliche Pilze auf Gras, leuchtende Pilze auf Pilzgras
		Erntet selbst ins Lager, selten auch Pilzgrassamen
		Rechtsklick öffnet das Bedienpanel
		'''
}

Apiary: {
	NoEnergyText: Energie reicht nicht!
	NoBottleText: Keine leere Flasche!
	FullText: Ausstoßlager voll!
	DisplayName: Bienenstock
	Tooltip:
		'''
		Leere Glasflaschen einlegen; der Schwarm braut unter Strom Honigflaschen
		Neben Honig oder im Dschungel ist der Schwarm lebhafter, die Rate steigt
		Rechtsklick öffnet das Bedienpanel
		'''
}

SlimeVat: {
	NoEnergyText: Energie reicht nicht!
	NoWaterText: Zu wenig Wasser!
	FullText: Ausstoßlager voll!
	PourText: +{0} Wasser
	DisplayName: Schleimzuchtbecken
	Tooltip:
		'''
		Züchtet periodisch Gel aus Wasser und Strom
		Zieht selbst aus nahem Wasser oder per Rechtsklick mit einem Wassereimer
		Rechtsklick öffnet das Bedienpanel
		'''
}

AutoFisher: {
	NoEnergyText: Energie reicht nicht!
	NoBaitText: Kein Köder!
	NoWaterText: Kein angelbares Wasser in der Nähe!
	FullText: Fanglager voll!
	DisplayName: Auto-Angel
	Tooltip:
		'''
		Erntet mit Köder und Strom automatisch aus dem Wasser unter dem Gehäuse
		Je größer das Gewässer und je besser der Köder, desto reicher der Fang
		Rechtsklick öffnet das Bedienpanel
		'''
}
