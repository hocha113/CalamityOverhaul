QuestNode: {
	FirstQuest: {
		DisplayName: Willkommen in dieser Welt!
		Description: Der Beginn der Reise
		DetailedDescription: Jede Legende beginnt klein. Hol dir deine Startausrüstung und bereite dich auf eine Welt voller Götter und Monster vor.
		QuestObjective.Description: Klicke, um Startgegenstände abzuholen
	}

	MiningQuest: {
		DisplayName: Mining-Grundlagen
		Description: Erhalte zehn {0}
		DetailedDescription: Unter der Erde liegt unendlicher Reichtum. Zuerst brauchen wir Grundmetalle für Werkzeuge.
	}

	MiningQuestII: {
		DisplayName: Eisenzeit
		Description: Sammle fünfzig {0}
		DetailedDescription: Kupfer ist zu weich — wir brauchen härtere Metalle. Grabe tiefer nach Eisenerz.
	}

	MiningQuestIII: {
		DisplayName: Goldrausch
		Description: Sammle hundert {0}
		DetailedDescription: Gold ist nicht nur Währung — es leitet Magie gut und ist formbar. Weicher als Eisen, aber wichtig für fortgeschrittene Ausrüstung.
	}

	BrimstoneElementalQuest: {
		DisplayName: Schwefelelementar
		Description: Besiege den Schwefelelementar
		DetailedDescription: In den Ruinen der Schwefelfeuerklippe erwecke und besiege den schlummernden Elementargeist. Hüte dich vor ihrem Bullet-Hell.
	}

	CalamitasCloneQuest: {
		DisplayName: Calamitas-Klon
		Description: Besiege den Calamitas-Klon
		DetailedDescription: Ein Klon voller Hass und Zerstörungswut. Besiege ihn und beweise, dass du der wahren Hexe gewachsen bist.
	}

	CrabulonQuest: {
		DisplayName: Crabulon
		Description: Besiege Crabulon
		DetailedDescription: Im leuchtenden Pilz-Untergrund lauert eine von Pilzen befallene Riesenkrabbe. Ihre Sporen sind äußerst gefährlich.
	}

	CryogenQuest: {
		DisplayName: Kryogen
		Description: Besiege Kryogen
		DetailedDescription: Der einstige Erzmagier des Kosmos liegt in ewigem Eis gefangen. Befreie und besiege ihn.
	}

	DesertScourgeQuest: {
		DisplayName: Wüstenplage
		Description: Besiege die Wüstenplage
		DetailedDescription: Der einstige Herrscher der Meere ringt in der ausgetrockneten Wüste um Luft. Hüte dich vor seinen gewaltigen Kiefern und Dienern.
	}

	EaterofWorldsQuest: {
		DisplayName: Weltenfresser / Gehirn von Cthulhu
		Description: Besiege den Boss der Verderbnis oder Purpur
		QuestObjective.Description: Besiege den Weltenfresser oder das Gehirn von Cthulhu
		DetailedDescription: Das Böse breitet sich aus. Dringe in die Wunden der Welt vor und beseitige den Riesenwurm oder das verderbte Gehirn.
	}

	EyeofCthulhuQuest: {
		DisplayName: Auge von Cthulhu
		Description: Besiege das Auge von Cthulhu
		DetailedDescription: Sobald du den bösen Blick spürst, erscheint es. Deine erste echte Prüfung der Stärke.
	}

	GolemQuest: {
		DisplayName: Golem
		Description: Besiege den Golem
		DetailedDescription: Tief im Dschungeltempel thront eine uralte Kriegsmaschine. Hüte dich vor Lasern und schweren Schlägen.
	}

	HiveMindQuest: {
		DisplayName: Der Schwarmgeist / Die Perforatoren
		Description: Besiege den wahren Gott des bösen Bioms
		QuestObjective.Description: Besiege den Schwarmgeist oder die Perforatoren
		DetailedDescription: Sie sind die Verkörperung des Bewusstseins von Verderbnis und Purpur. Ohne sie gibt es keinen Frieden.
	}

	KingSlimeQuest: {
		DisplayName: Schleimkönig
		Description: Besiege den Schleimkönig
		DetailedDescription: Der Herrscher aller Glibberwesen. Er wirkt komisch — lass dich von der Größe nicht zerquetschen.
	}

	LunaticCultistQuest: {
		DisplayName: Lunatischer Kultist
		Description: Besiege den lunatischen Kultisten
		DetailedDescription: Am Dungeon-Eingang versuchen fanatische Kultisten, das Ende herauf- oder abzubeschwören. Stoppe ihr Ritual.
	}

	MechanicalBossesQuest: {
		DisplayName: Mechanische Bosse
		Description: Besiege alle mechanischen Bosse
		QuestObjective.Description: Besiege alle mechanischen Bosse
		DetailedDescription: Jemand hat Cthulhus Organe in Stahl nachgebaut. Ein Augenpaar, ein Schädel und ein langer Wurm.
	}

	MoonLordQuest: {
		DisplayName: Mondherr
		Description: Besiege den Mondherrn
		DetailedDescription: Der Drahtzieher hinter allem — der Schrecken auf der Mondrückseite. Beende diesen langen Albtraum.
	}

	PlaguebringerGoliathQuest: {
		DisplayName: Seuchenbringer-Goliath
		Description: Besiege den Seuchenbringer-Goliath
		DetailedDescription: Eine von Nanoviren umgebaute Bienenkönigin — tödlich und mit gefährlicher Seuche beladen.
	}

	PlanteraQuest: {
		DisplayName: Plantera
		Description: Besiege Plantera
		DetailedDescription: Tief im Dschungel schläft eine riesige Menschenfresserblume. Zerbrich die Knospe und stelle dich dem Zorn des Dschungels.
	}

	SkeletronQuest: {
		DisplayName: Skeletron
		Description: Besiege Skeletron
		DetailedDescription: Nur wenn du den verfluchten Alten besiegst, kannst du sicher den Dungeon erkunden.
	}

	SlimeGodQuest: {
		DisplayName: Schleim-Gott
		Description: Besiege den Schleim-Gott
		DetailedDescription: Der Gipfel der Schleimart — ein uralter, gieriger Gott. Hüte dich vor kombinierten Angriffen seiner Avatare.
	}

	WallofFleshQuest: {
		DisplayName: Fleischwand
		Description: Besiege die Fleischwand
		DetailedDescription: Der Torwächter der Welt. Wirf die Voodoopuppe des Guides in die Lava, entfessle die uralte Gottheit dieser Welt und eröffne den Hardmode.
	}

	CeaselessVoidQuest: {
		DisplayName: Unendliche Leere
		Description: Besiege die Unendliche Leere
		DetailedDescription: Einer der Wächter des Verschlingers der Götter — ein Spiegel der Leere aus einer anderen Dimension.
	}

	DevourerofGodsQuest: {
		DisplayName: Der Verschlinger der Götter
		Description: Besiege den Verschlinger der Götter
		DetailedDescription: Eine kosmische Schlange, die alles Göttliche verschlingen will. Kämpfe in der Leere — lass dich nicht fressen.
	}

	DragonfollyQuest: {
		DisplayName: Drachen-Torheit
		Description: Besiege die Drachen-Torheit
		DetailedDescription: Ein gescheiterter Yharon-Klon — ein wahnsinniger, elektrisierter Pseudo-Drache.
	}

	ExoMechsQuest: {
		DisplayName: Exo-Mechs
		Description: Besiege die Exo-Mechs
		DetailedDescription: Draedons Meisterwerke — der Gipfel terranischer Technologie. Überlebe diese perfekte Vorstellung.
	}

	OldDukeQuest: {
		DisplayName: Alter Herzog
		Description: Besiege den Alten Herzog
		DetailedDescription: Der uralte Herrscher der Schwefelsee-Tiefen — Mutation und Macht in einem. Hüte dich vor giftigem Dampf.
	}

	PolterghastQuest: {
		DisplayName: Polterghast
		Description: Besiege den Polterghast
		DetailedDescription: Ein Monster aus den im Dungeon gestorbenen Seelen. Besänftige ihren Zorn.
	}

	PrimordialWyrmQuest: {
		DisplayName: Urwyrm
		Description: Besiege den Urwyrm
		DetailedDescription: Der Wächter des tiefsten Abgrunds — älter als die Götter. Störe ihn nur bei Bedarf.
	}

	ProfanedGuardiansQuest: {
		DisplayName: Geschändete Wächter
		Description: Besiege die Geschändeten Wächter
		DetailedDescription: Loyale Wächter der geschändeten Göttin. Besiege sie, um ihre Verteidigung zu schwächen.
	}

	ProvidenceQuest: {
		DisplayName: Providenz, die geschändete Göttin
		Description: Besiege Providenz
		DetailedDescription: Die Göttin heiligen Feuers und der Reinigung. Fordere sie im Heiligen Land oder der Unterwelt heraus — aber hüte dich vor dem heiligen Brand.
	}

	SignusQuest: {
		DisplayName: Signus, Gesandter des Verschlingers der Götter
		Description: Besiege Signus
		DetailedDescription: Einer der Wächter des Verschlingers der Götter — ein formloser Assassine, ein Geist der Leere.
	}

	StormWeaverQuest: {
		DisplayName: Sturmflechter
		Description: Besiege den Sturmflechter
		DetailedDescription: Einer der Wächter des Verschlingers der Götter — ein Himmelswurm, der von Gewittern und Blitzen lebt.
	}

	SupremeCalamitasQuest: {
		DisplayName: Oberhexe Calamitas
		Description: Besiege Oberhexe Calamitas
		DetailedDescription: Die legendäre Schwefelfeuer-Hexe. Ende deiner Reise — oder ein neuer Anfang? Bereite dich auf echtes Bullet-Hell vor.
	}

	YharonQuest: {
		DisplayName: Yharon, Drache der Wiedergeburt
		Description: Besiege Yharon
		DetailedDescription: Der loyale Gefährte des Tyrannen — ein Drache mit phönixartiger Wiedergeburt. Eine Prüfung der Seele.
	}

	BatteryQuest: {
		DisplayName: Energiespeicher
		Description: Stelle eine Thermobatterie her
		DetailedDescription: Strom muss gespeichert werden. Batterien sind der erste Schritt zu einem stabilen Netz.
	}

	HydroelectricQuest: {
		DisplayName: Saubere Energie
		Description: Stelle einen Wasserkraftgenerator her
		DetailedDescription: Nutze fließendes Wasser für Strom — sauber und nachhaltig.
	}

	IndustrialStartQuest: {
		DisplayName: Industrielle Revolution
		Description: Stelle einen Windgenerator her
		DetailedDescription: Der erste Schritt zur Automatisierung. Wind treibt deine Maschinen an und befreit deine Hände.
	}

	ItemFilterQuest: {
		DisplayName: Logistik-Sortierung
		Description: Stelle einen Itemfilter her
		DetailedDescription: Automatisierte Linien brauchen Ordnung. Filter steuern den Gegenstandsfluss präzise.
	}

	MiningMachineQuest: {
		DisplayName: Automatisiertes Graben
		Description: Stelle eine Mining-Maschine her
		DetailedDescription: Schluss mit mühsamem Handabbau. Diese Maschine frisst Erzadern mit erstaunlicher Effizienz.
	}

	MiningMachineIIQuest: {
		DisplayName: Tiefbohrung
		Description: Stelle eine Mining-Maschine MK2 her
		DetailedDescription: Ein verstärkter Kern bringt unvergleichliche Geschwindigkeit.
	}

	PipelineQuest: {
		DisplayName: Energieübertragung
		Description: Stelle universelle Energieleitungen her
		DetailedDescription: Die Adern zwischen Generatoren und Maschinen. Ohne sie ist Strom nur stehendes Wasser.
	}

	TeslaTowerQuest: {
		DisplayName: Magnetsturm-Turm
		Description: Stelle einen Tesla-Turm her
		DetailedDescription: Ein Wunderwerk kabelloser Energie. Der Turm überträgt Strom durch die Luft und spart dir den Großteil der Verkabelung.
	}

	FluidPumpQuest: {
		DisplayName: Flüssigkeitsbau
		Description: Stelle eine Flüssigkeitspumpe her
		DetailedDescription: Wasser und Lava sind auch Ressourcen. Die Pumpe holt sie aus der Welt.
	}

	FluidPipelineQuest: {
		DisplayName: Adern aus Flüssigkeit
		Description: Stelle Flüssigkeitsleitungen her
		DetailedDescription: Flüssigkeiten brauchen ein eigenes Netz. Flüssigkeitsrohre transportieren nur Flüssigkeiten und lassen das Stromnetz in Ruhe.
	}

	FluidTankQuest: {
		DisplayName: Gefäß der Vorräte
		Description: Stelle einen Flüssigkeitstank her
		DetailedDescription: Schnell pumpen nützt nichts ohne Lagerplatz. Der Tank ist die Batterie des Flüssigkeitsnetzes.
	}

	MagmaGeneratorQuest: {
		DisplayName: Magmawärme
		Description: Stelle einen Magma-Wärmegenerator her
		DetailedDescription: Das gepumpte Magma hat endlich einen Zweck. An Lava verdient er ein bisschen, mit vollem Tank läuft er auf voller Leistung.
	}

	ShimmerTransmuterQuest: {
		DisplayName: Schimmer-Alchemie
		Description: Stelle einen Schimmer-Umwandler her
		DetailedDescription: Pumpe Schimmer in die Maschine, und die Form von Gegenständen lässt sich am Fließband umschreiben.
	}

	CrusherQuest: {
		DisplayName: Erz aus Schutt
		Description: Stelle einen Erzbrecher her
		DetailedDescription: Zwei Teile Erz werden zu drei. Vor dem Verbrennungsofen liegt jetzt ein Schritt mehr Ausbeute.
	}

	RecyclerQuest: {
		DisplayName: Aus Schrott wird Wert
		Description: Stelle einen Wiederverwerter her
		DetailedDescription: Wirf ausgediente Ausrüstung nicht weg. Zerlege sie nach Seltenheit in Barren und schick sie zurück in den Ofen.
	}

	AutoCrafterQuest: {
		DisplayName: Automatische Montage
		Description: Stelle einen Autofertiger her
		DetailedDescription: Hefte ein Rezept an; Materialien kommen von selbst, Fertigteile gehen von selbst. Die Werkbank braucht dich nicht mehr daneben.
	}

	MushroomFarmerQuest: {
		DisplayName: Pilzzucht
		Description: Stelle eine Pilzzuchtmaschine her
		DetailedDescription: Ernten auf Gras und Pilzgras sind ihr Geschäft. Leuchtende Pilze inklusive.
	}

	ApiaryQuest: {
		DisplayName: Süße Industrie
		Description: Stelle einen Bienenstock her
		DetailedDescription: Leere Flaschen rein, Honigflaschen raus. In der Nähe von Honig oder im Dschungel arbeiten die Bienen härter.
	}

	SlimeVatQuest: {
		DisplayName: Gel-Massenfertigung
		Description: Stelle einen Schleimzuchtbottich her
		DetailedDescription: Wasser und Strom gegen Gel. Der Bottich ist die erste Rohstoffmaschine des Landwirtschaftskreislaufs.
	}

	BiomassGeneratorQuest: {
		DisplayName: Geschlossener Kreislauf
		Description: Stelle einen Biomassegenerator her
		DetailedDescription: Verschwende den Überschuss der Farm nicht. Stopf ihn in den Brenner und hol Strom; der Anbau-Verbrennung-Kreis beginnt zu laufen.
	}

	FlameTurretQuest: {
		DisplayName: Flammenlinie
		Description: Stelle einen Flammenwerferturm her
		DetailedDescription: Eine Nahbereichs-Feuerwand gegen Gruppen. Lade Gel, dann brennt sie härter.
	}

	CryoTurretQuest: {
		DisplayName: Frostsperre
		Description: Stelle einen Frostturm her
		DetailedDescription: Nicht zum Töten gebaut, sondern zum Einfrieren. Feinde unter dem Turm werden immer langsamer, bis sie kaum noch einen Schritt tun.
	}

	LaserTurretQuest: {
		DisplayName: Lichtgeschwindigkeitsscharfschütze
		Description: Stelle einen Laserturm her
		DetailedDescription: Was in Sichtlinie liegt, ist einen Strahl entfernt. Längste Reichweite der Familie, und er bevorzugt große Ziele.
	}

	ShieldGeneratorQuest: {
		DisplayName: Energiewall
		Description: Stelle einen Schildgenerator her
		DetailedDescription: Jeder in Reichweite bekommt eine Schicht absorbierenden Schild. Mehr Verbündete, schnellerer Verbrauch.
	}

	HealStationQuest: {
		DisplayName: Feldmedizin
		Description: Stelle eine Heilstation her
		DetailedDescription: Steh in der Aura, und Wunden schließen sich langsam. Das Wort Arbeitsunfall gehört von heute an der Vergangenheit an.
	}

	TeleportStationQuest: {
		DisplayName: Teleportnetz
		Description: Stelle eine Teleportstation her
		DetailedDescription: Zwei Stationen sind der Anfang, dann ist die ganze Karte verbunden. Je weiter der Sprung, desto teurer die Maut.
	}

	ElectricSundialQuest: {
		DisplayName: Sonnenuhr vorspulen
		Description: Stelle eine elektrische Sonnenuhr her
		DetailedDescription: Lade tausend Einheiten Strom, dann überspringst du die Nacht mit einem Tastendruck. Der ganze Server bekommt deine Meldung.
	}

	SolarPanelQuest: {
		DisplayName: Der Sonne entgegen
		Description: Stelle ein Solarmodul her
		DetailedDescription: Tagsüber Strom, mittags am stärksten. Halte den Himmel frei; Regen und Sonnenfinsternis sind seine arbeitsfreien Tage.
	}

	CapacitorMatrixQuest: {
		DisplayName: Riesenspeicher
		Description: Stelle eine Kondensatormatrix her
		DetailedDescription: Vierzigtausend Einheiten in einer Bank. Das Schwungrad des Netzes und das Ende der Stromausfall-Ära.
	}

	WeatherControllerQuest: {
		DisplayName: Regenmacher
		Description: Stelle eine Wettersteuerung her
		DetailedDescription: Fünfhundert Strom kaufen einen Regen, noch einmal drücken macht ihn wieder klar. Der Wind hört nicht auf sie.
	}

	WireInterfaceQuest: {
		DisplayName: Mechanikbrücke
		Description: Stelle Mechanikschnittstellen her
		DetailedDescription: Mechanikdraht und Stromnetz sprechen endlich. Signale schalten Maschinen, und Maschinen können Signale zurückschicken.
	}

	SensorQuest: {
		DisplayName: Elektronisches Wachauge
		Description: Stelle einen Multimodus-Sensor her
		DetailedDescription: Ladestand, Feinde und Blutmonde entgehen seinem Blick nicht. Sobald die Bedingung gilt, geht ein Mechaniksignal raus.
	}

	GridSwitchQuest: {
		DisplayName: Netzleitung
		Description: Stelle einen Netzhauptschalter her
		DetailedDescription: Ein Hauptschalter in der Leitung. Klapp ihn auf, und das ganze Netz stromabwärts verstummt sofort.
	}

	ThermalPowerQuest: {
		DisplayName: Zeit zu brennen
		Description: Stelle einen Wärmegenerator her
		DetailedDescription: Verbrenne Brennstoff für viel Strom. Nicht umweltfreundlich, aber früh am zuverlässigsten.
	}

	AnnihilatingUniverseQuest: {
		DisplayName: Universum der Vernichtung
		Description: Erhalte „Universum der Vernichtung"
		DetailedDescription: Galaxienkraft auf der Sehne. Zerstört Dimensionen — der ultimative Beweis für einen Jäger.
	}

	AriaofTheCosmosQuest: {
		DisplayName: Aria des Kosmos
		Description: Erhalte „Aria des Kosmos"
		DetailedDescription: Spiele die Symphonie der Sterne. Beschwört Schwarze Löcher und Quasare — Feinde verschwinden im Kosmosgesang.
	}

	NeutronBowQuest: {
		DisplayName: Neutronenbogen
		Description: Erhalte Neutronenbogen
		DetailedDescription: Aus Neutronenstern-Kernfragmenten. Jeder Pfeil trägt die Schwerkraft eines kollabierenden Sterns.
	}

	NeutronGlaiveQuest: {
		DisplayName: Neutronengleve
		Description: Erhalte Neutronengleve
		DetailedDescription: Unglaubliche Dichte. Keine Rüstung hält dem Hieb stand.
	}

	NeutronGunQuest: {
		DisplayName: Neutronengewehr
		Description: Erhalte Neutronengewehr
		DetailedDescription: Schießt Mikro-Neutronenströme — kaum vom Widerstand beeinflusst.
	}

	NeutronScytheQuest: {
		DisplayName: Neutronensense
		Description: Erhalte Neutronensense
		DetailedDescription: Die Sense des Schnitters — reißt Raum auf wie Weizen.
	}

	NeutronStarIngotQuest: {
		DisplayName: Neutronensternbarren
		Description: Erhalte Neutronensternbarren
		DetailedDescription: Eines der dichtesten Materialien — summt von Gravitationswellen.
	}

	NeutronWandQuest: {
		DisplayName: Neutronenstab
		Description: Erhalte Neutronenstab
		DetailedDescription: Kontrolliert Schwerkraft — verdreht Raum-Zeit und zermalmt Feinde.
	}

	PandemoniumQuest: {
		DisplayName: Pandämonium
		Description: Erhalte „Pandämonium"
		DetailedDescription: Ultimative Waffe aus unzähligen Seelen und Calamity-Kraft — Schlüssel zu Hölle und Abgrund.
	}

	RockQuest: {
		DisplayName: Uralter Ewigkeitsstein
		Description: Erhalte uralte Ewigkeitssteine
		DetailedDescription: Ein scheinbar gewöhnlicher Stein, Zeuge unzähliger Boss-Rush-Zyklen — Symbol ewiger Ausdauer.
	}

	TerminusQuest: {
		DisplayName: Terminus
		Description: Erhalte Terminus
		DetailedDescription: Schlüssel zum Boss-Rush. Blicke in den Stein und stelle dich der stärksten Wesen der Welt.
	}

	SpearOfLonginusQuest: {
		DisplayName: Lanze des Longinus
		Description: Erhalte Lanze des Longinus
		DetailedDescription: Die heilige Lanze, die ein Gott durchbohrte — durchdringt alle Felder. Selbst die Kausalität weicht ihr.
	}

	DragonsWordQuest: {
		DisplayName: Drachenwort
		Description: Erhalte Drachenwort
		DetailedDescription: Ein Drache weint nur einmal im Leben — im Moment des Todes.
	}

	RockQuestII: {
		DisplayName: Kreislauf der Eroberung
		Description: Schließe Boss-Rush fünfmal ab und erhalte mindestens fünf uralte Ewigkeitssteine
		DetailedDescription: Das Symbol eines wahren Kriegers.
	}

	AdventurerQuests: {
		DisplayName: Abenteurer
		Description: Die Welt gehört mir!
		QuestObjective.Description: Klicke zum Abholen
		DetailedDescription: Eine Reise von tausend Meilen beginnt mit einem Schritt. Miss die weite Welt mit diesen Stiefeln.
	}

	ExploreDungeon: {
		DisplayName: Düsterer Dungeon
		Description: Entdecke den Dungeon-Eingang
		QuestObjective.Description: Erreiche den Dungeon
		DetailedDescription: Hinter verfluchten Mauern lauern Geheimnisse und Gefahren. Nur die Mutigsten betreten dieses Reich der Toten.
	}

	ExploreHell: {
		DisplayName: Abgrund der Unterwelt
		Description: Steige in die Unterwelt hinab
		QuestObjective.Description: Erreiche die Unterwelt
		DetailedDescription: In den Tiefen fließen Lavaflüsse — Heimat der Dämonen, Quelle von Obsidian und Höllenstein. Pass auf!
	}

	ExploreJungle: {
		DisplayName: Dschungel-Expedition
		Description: Erkunde das Dschungel-Biom
		QuestObjective.Description: Erreiche den Dschungel
		DetailedDescription: Ein lebendiges, gefährliches grünes Labyrinth — Tempel und tödliche Bienenschwärme im Dickicht.
	}

	ExploreOcean: {
		DisplayName: Weltende
		Description: Erreiche das Ozean-Biom
		QuestObjective.Description: Erreiche den Ozean
		DetailedDescription: Am Rand des Kontinents treffen Himmel und Meer. Unter dem Blau liegen Wracks und Ungeheuer.
	}

	ExploreSnow: {
		DisplayName: Gefrorenes Ödland
		Description: Erkunde das Schnee-Biom
		QuestObjective.Description: Erreiche das Schnee-Biom
		DetailedDescription: Ewiger Permafrost. Beißender Wind — hier existiert Leben hartnäckig.
	}

	ExploreSpace: {
		DisplayName: Sternenmeer
		Description: Fliege ins All
		QuestObjective.Description: Erreiche den Weltraum
		DetailedDescription: Befreie dich von der Schwerkraft und berühre die Sterne. Nur hoch genug siehst du die ganze Welt.
	}

	HellLabSchematic: {
		DisplayName: Höllen-Bauplan
		Description: Finde den verschlüsselten Bauplan im Draedon-Labor der Unterwelt
		QuestObjective.Description: Erhalte Höllen-Bauplan
		DetailedDescription: Draedon nutzte Geothermie in der Unterwelt. Finde den Bauplan für neue Waffentechnologie.
	}

	IceLabSchematic: {
		DisplayName: Polar-Code
		Description: Finde den verschlüsselten Bauplan im Draedon-Labor der Schneelandschaft
		QuestObjective.Description: Erhalte Eis-Bauplan
		DetailedDescription: Niedrige Temperaturen bewahren Präzisionsinstrumente. Finde die versiegelte Polar-Technologie.
	}

	JungleLabSchematic: {
		DisplayName: Dschungel-Entwurf
		Description: Finde den verschlüsselten Bauplan im Draedon-Labor des Dschungels
		QuestObjective.Description: Erhalte Dschungel-Bauplan
		DetailedDescription: Der Dschungel verbirgt Draedons Biolabor — Seuchen und Nanoviren. Finde die gefährliche Wahrheit.
	}

	PlanetoidLabSchematic: {
		DisplayName: Exo-Rätsel
		Description: Finde den verschlüsselten Bauplan im Draedon-Labor auf dem Planetoiden
		QuestObjective.Description: Erhalte Planetoiden-Bauplan
		DetailedDescription: In der Mikrogravitation schwebt ein Labor — frühe Exo-Mech-Entwürfe.
	}

	SunkenSeaLabSchematic: {
		DisplayName: Versunkenes Meer
		Description: Finde den verschlüsselten Bauplan im Draedon-Labor des Versunkenen Meeres
		QuestObjective.Description: Erhalte Versunkenes-Meer-Bauplan
		DetailedDescription: In diesem ruhigen Unterwassermeer hinterließ Draedon Prismenergie-Forschung. Tauche und hole die Daten.
	}

	AquaticScourgeQuest: {
		DisplayName: Aquatische Plage
		Description: Besiege die Aquatische Plage
		DetailedDescription: Einst ein friedliches Meeresungeheuer — verdreht durch die Schwefelsee-Toxizität. Hüte dich vor Stößen und Giftwolken.
	}

	QueenSlimeQuest: {
		DisplayName: Schleimkönigin
		Description: Besiege die Schleimkönigin
		DetailedDescription: Die Kristallkaiserin des Heiligen Landes — agiler und tödlicher als ihr Gemahl. Bereite dich auf prächtiges Bullet-Hell vor.
	}

	BuildHouse: {
		DisplayName: Baumeister
		Description: Baue ein geeignetes Haus
		QuestObjective.Description: Baue ein gültiges Haus
		DetailedDescription: Jeder braucht Zuflucht. Mit Möbeln, Licht und Wänden dienen dir NPCs.
	}

	CollectEvilOres: {
		DisplayName: Böse Erze
		Description: Sammle böse Erze
		QuestObjective.Description: Sammle Dämonit- oder Purpurerz
		DetailedDescription: Unheilvolle Erze aus den Wunden der Welt — essenziell für mächtige Ausrüstung.
	}

	CollectFallenStars: {
		DisplayName: Sternensammler
		Description: Sammle Sternschnuppen
		QuestObjective.Description: Sammle Sternschnuppen
		DetailedDescription: Tränen des Nachthimmels — erhöhen Mana und dienen als Munition oder Magiematerial.
	}

	CollectGems: {
		DisplayName: Edelsteinsammler
		Description: Sammle verschiedene Edelsteine
		QuestObjective.Description: Sammle 5 verschiedene Edelsteine
		DetailedDescription: Funkelnde Kristalle im Gestein — wichtig für Stäbe und Enterhaken. Regenbogen aus Farben.
	}

	CollectHerbs: {
		DisplayName: Kräuterlehrling
		Description: Sammle verschiedene Kräuter
		QuestObjective.Description: Sammle 3 verschiedene Kräuter
		DetailedDescription: Grundlage der Alchemie. Wüste, Schnee, Unterwelt — lerne sie zu erkennen.
	}

	CollectOres: {
		DisplayName: Erzsammlung
		Description: Sammle Grunderze

		QuestObjective: {
			Description: {
				Iron: Sammle Eisen- oder Bleierz
				Copper: Sammle Kupfer- oder Zinnerz
			}
		}

		DetailedDescription: Abbau ist Überleben. Kupfer und Eisen sind der Ausstieg aus der Steinzeit.
	}

	DeepExplorer: {
		DisplayName: Tiefenforscher
		Description: Erkunde alle Hauptbiome
		QuestObjective.Description: Schließe alle Erkundungsaufträge ab
		DetailedDescription: Von den Wolken bis zur Unterwelt — die ganze Welt liegt zu deinen Füßen.
	}

	ExploreCaverns: {
		DisplayName: Höhlentiefen
		Description: Erkunde tiefere Höhlenschichten
		QuestObjective.Description: Erreiche die Höhlenschicht
		DetailedDescription: Kein Sonnenlicht — nur Dunkelheit und Unbekanntes. Lava und reichere Erze. Der Abgrund starrt zurück.
	}

	ExploreCorruption: {
		DisplayName: Die Verderbnis
		Description: Erkunde Verderbnis oder Purpur
		QuestObjective.Description: Betrete Verderbnis oder Purpur
		DetailedDescription: Krankes Land — violette Verderbnis oder purpurnes Fleisch. Nur im Versteck der Bestie gibt es Schattenschuppen.
	}

	ExploreDesert: {
		DisplayName: Glühende Wüste
		Description: Betrete das Wüsten-Biom
		QuestObjective.Description: Erreiche die Wüste
		DetailedDescription: Goldener Sand, Fossilien und Ameisenlöwen. Nimm Wasser mit — die Trockenheit tötet.
	}

	ExploreFloatingIsland: {
		DisplayName: Schwebende Inseln
		Description: Finde schwebende Inseln am Himmel
		QuestObjective.Description: Erreiche eine schwebende Insel
		DetailedDescription: Über den Wolken Schätze alter Zivilisationen. Suche Gravitationsanomalien oder baue einen Turm.
	}

	ExploreGlowingMushroom: {
		DisplayName: Leuchtende Pilze
		Description: Finde das leuchtende Pilz-Biom
		QuestObjective.Description: Erreiche das Pilz-Biom
		DetailedDescription: Psychedelisches Untergrund-Ökosystem — blaues Leuchten, Heimat des Trüffelmanns.
	}

	ExploreUnderground: {
		DisplayName: Untergrund-Expedition
		Description: Erkunde unterirdische Höhlen
		QuestObjective.Description: Erreiche den Untergrund
		DetailedDescription: Oberfläche reicht nicht. Wahres Abenteuer beginnt darunter — nimm Fackeln mit.
	}

	FindLifeCrystal: {
		DisplayName: Lebensquelle
		Description: Finde einen Lebenskristall
		QuestObjective.Description: Finde einen Lebenskristall
		DetailedDescription: Roter Kristall voller Lebenskraft — stärkt dauerhaft deinen Körper.
	}

	FindShadowOrb: {
		DisplayName: Kern des Bösen
		Description: Finde Schattenkugel oder Purpurherz tief im bösen Biom
		QuestObjective.Description: Zerstöre Schattenkugel oder Purpurherz
		DetailedDescription: Tief in der Kluft pulsiert Verderben. Drei Zerstörungen wecken Schreckliches.
	}

	FirstPotion: {
		DisplayName: Alchemie-Grundlagen
		Description: Braue deinen ersten Trank
		QuestObjective.Description: Braue einen beliebigen Trank
		DetailedDescription: Leere Flasche auf den Tisch — einfache Alchemie. Richtige Zutaten, kein Zauber.
	}

	NPCVillage: {
		DisplayName: Blühendes Dorf
		Description: Locke mehrere NPCs an
		QuestObjective.Description: Habe 5 NPCs
		DetailedDescription: Allein in der Wildnis ist einsam. Baue eine Gemeinschaft — sie werden deine Stütze.
	}

	QueenBeeQuest: {
		DisplayName: Bienenkönigin
		Description: Besiege die Bienenkönigin
		DetailedDescription: Im Dschungel-Untergrund erzürnt das Zerbrechen der Larve den Schwarm. Antigift und Vorsicht vor Stichen.
	}

	CollectorQuest: {
		DisplayName: Sammelassistent
		Description: Erhalte den Sammler
		DetailedDescription: Kein Bücken mehr — sammelt Drops automatisch. Kern der Logistik-Automatisierung.
	}

	LumberjackQuest: {
		DisplayName: Holzzeit
		Description: Erhalte den Holzfäller
		DetailedDescription: Holz ist Industrie-Basis. Diese Maschine automatisiert deinen Forst mit Strom.
	}

	LifeWeaverQuest: {
		DisplayName: Aufforstung
		Description: Erhalte den Baumpflanzer
		DetailedDescription: Setzlinge präzise pflanzen — letztes Puzzleteil für vollautomatischen Forst.
	}

	IncineratorQuest: {
		DisplayName: Elektrisches Schmelzen
		Description: Stelle einen elektrischen Verbrennungsofen her
		DetailedDescription: Hochspannungsbögen verdoppeln die Erzausbeute — Schlüssel zur Industrialisierung.
	}

	ItemPipelineQuest: {
		DisplayName: Logistiksystem
		Description: Stelle eine Itemleitung her
		DetailedDescription: Leitungen sind Industrieadern — Gegenstände fließen automatisch.
	}

	ThrowerQuest: {
		DisplayName: Wurfassistent
		Description: Stelle einen Werfer her
		DetailedDescription: Wirft Items aus dem Netz — für Automatisierung oder als Abfallauslass.
	}

	DeerclopsQuest: {
		DisplayName: Hirschklopse
		Description: Besiege Hirschklopse
		DetailedDescription: Tief im Schneesturm steht ein einäugiger Riesenhirsch. Er kommt nicht zu dir; du bestehst darauf, ihn zu suchen.
	}

	DukeFishronQuest: {
		DisplayName: Herzog Fischron
		Description: Besiege Herzog Fischron
		DetailedDescription: Köder den Haken mit einem Trüffelwurm, und ein Herzog beißt an. Schwein, Drache, Fisch; drei bedrohliche Fratzen in einem Gesicht.
	}

	EmpressOfLightQuest: {
		DisplayName: Kaiserin des Lichts
		Description: Besiege die Kaiserin des Lichts
		DetailedDescription: Tritt im Heiligen Land eine prismatische Spitzenflüglerin tot, und die wütende Kaiserin kommt selbst, um die Rechnung zu begleichen. Reizst du sie bei Tag, tötet jeder ihrer Angriffe mit einem Treffer.
	}

	ZenithQuest: {
		DisplayName: Zenit
		Description: Schmiede den Zenit
		DetailedDescription: Vom Kupferkurzschwert bis zum Sternenzorn erinnert sich jedes Schwert, das du je geschwungen hast. Schmelz sie zusammen, und diese Reise bekommt ihre Form.
	}

	BloodMoonQuest: {
		DisplayName: Blutige Nacht
		Description: Überstehe einen Blutmond
		QuestObjective.Description: Erlebe einen Blutmond
		DetailedDescription: In Nächten, in denen der Mond rot wird, klopfen Monster nicht mehr; sie öffnen die Tür selbst. Überlebe bis zum Morgengrauen.
	}

	TorchGodQuest: {
		DisplayName: Fackelgott
		Description: Bestehe die Prüfung des Fackelgottes
		QuestObjective.Description: Erhalte die Gunst des Fackelgottes
		DetailedDescription: Steck unter der Erde hundert Fackeln, und der Herr der Flammen prüft dich persönlich. In den erloschenen Lichtern liegt seine Gunst.
	}

	GoblinArmyQuest: {
		DisplayName: Goblininvasion
		Description: Schlage die Goblinarmee zurück
		QuestObjective.Description: Schlage die Goblinarmee zurück
		DetailedDescription: Schattenkugeln zu zertrümmern lockt sie, und eine wachsende Siedlung ebenso. Klein, in Schwärmen, ohne Ende; aber wenn du gewinnst, findest du vielleicht einen Gefangenen, der Ausrüstung repariert.
	}

	OldOnesArmyQuest: {
		DisplayName: Armee des Alten
		Description: Bewache den Eternia-Kristall und schlage alle drei Stufen der Armee des Alten zurück

		QuestObjective: {
			Description: {
				T1: Schlage die Armee des Alten zurück, Stufe 1
				T2: Schlage die Armee des Alten zurück, Stufe 2
				T3: Schlage die Armee des Alten zurück, Stufe 3
			}
		}

		DetailedDescription: Der Schankwirt bringt eine Bitte aus einer anderen Welt. Stell den Kristall auf, halte die Portale und lass nichts ihn berühren. Drei Staffeln, jede härter als die letzte.
	}

	PirateInvasionQuest: {
		DisplayName: Pirateninvasion
		Description: Schlage die Pirateninvasion zurück
		QuestObjective.Description: Schlage die Pirateninvasion zurück
		DetailedDescription: Sobald die Welt hart wird, erscheinen Segel am Horizont. Sie wollen dein Geld; nimm ihres zurück, das Hab und Gut des Kapitäns inklusive.
	}

	SolarEclipseQuest: {
		DisplayName: Sonnenfinsternisjagd
		Description: Töte während einer Sonnenfinsternis ein Mottron
		QuestObjective.Description: Töte ein Mottron
		DetailedDescription: An Tagen, an denen der Mond die Sonne verdeckt, ist der Tag gefährlicher als die Nacht. Alles aus den Horrorfilmen geht auf die Straße, und der schnellste Flieger darunter heißt Mottron.
	}

	MartianMadnessQuest: {
		DisplayName: Marsianerwahnsinn
		Description: Schlage die Marsianerinvasion zurück
		QuestObjective.Description: Schlage die Marsianerinvasion zurück
		DetailedDescription: Starr nicht die Sonde am Himmel an; sie fliegt nach Hause und holt Verstärkung. Untertassen, Todesstrahlen, Gedankenkontrollhelme; das volle Programm einer Alieninvasion.
	}

	PumpkinMoonQuest: {
		DisplayName: Kürbismond
		Description: Besiege während des Kürbismonds den Kürbiskönig
		QuestObjective.Description: Besiege den Kürbiskönig
		DetailedDescription: Wecke die Halloween-Nacht mit einem Kürbismond-Medaillon. Vogelscheuchen stehen Schlange um Köpfe, und zum Finale kommt ein König mit zwei Sensen.
	}

	FrostMoonQuest: {
		DisplayName: Frostmond
		Description: Besiege während des Frostmonds die Eiskönigin
		QuestObjective.Description: Besiege die Eiskönigin
		DetailedDescription: Öffne das Geschenk, das zugewickelt hätte bleiben sollen, und Heiligabend bekommt einen schalen Beigeschmack. Panzer patrouillieren im Schnee, die Königin stürzt durch den Schneesturm.
	}

	FishermanQuest: {
		DisplayName: Aufträge des Anglers
		Description: Erledige fünf Angleraufträge
		QuestObjective.Description: Erledige Angleraufträge
		DetailedDescription: Am Meer wohnt ein kommandierender Bengel, aber seine Belohnungen sind überraschend solide. Wo die Fische sind, da ist der Schatz.
	}

	LifeMaxQuest: {
		DisplayName: Lebensbrunnen
		Description: Hebe dein Lebensmaximum auf 400
		QuestObjective.Description: Erreiche 400 maximales Leben
		DetailedDescription: Herzkristalle bringen dich nur die Hälfte des Weges. Den Rest musst du erkämpfen und wachsen. Vierhundert Leben sind die Eintrittskarte, um im Hardmode festzustehen.
	}

	ManaMaxQuest: {
		DisplayName: Herz des Manas
		Description: Hebe dein Manamaximum auf 200
		QuestObjective.Description: Erreiche 200 maximales Mana
		DetailedDescription: Press Sternschnuppen zu Kristallen und fütter sie dir eine nach der anderen. Zwanzig Punkte pro Schluck, neun Schlucke insgesamt, und der Nachthimmel läuft in deinen Adern.
	}

	WingsQuest: {
		DisplayName: Flügel ausbreiten
		Description: Rüste ein beliebiges Flügelpaar aus
		QuestObjective.Description: Rüste Flügel aus
		DetailedDescription: Himmelsschätze, Feenfedern, Dämonenhaut. Egal woher, in dem Moment, in dem dir Flügel wachsen, gehört Fallschaden der Vergangenheit an.
	}

	MoneyQuest: {
		DisplayName: Das erste Vermögen
		Description: Halte eine Platinmünze
		QuestObjective.Description: Halte eine Platinmünze
		DetailedDescription: Hundert Goldmünzen gepresst zu einer Platinmünze. Auf dem Weg dahin bist du vermutlich oft gestorben; Händler nennen das Gebühr.
	}

	ExploreAetherQuest: {
		DisplayName: Der Schimmersee
		Description: Finde den Schimmersee
		QuestObjective.Description: Erreiche den Schimmersee
		DetailedDescription: In einer Ecke der Welt liegt ein See, der nicht hierhergehört. Wirf etwas hinein, und es kommt verändert wieder. Spring nicht selbst hinein, um es zu testen.
	}

	HardmodeOresQuest: {
		DisplayName: Drei neue Metalle
		Description: Sammle die drei Stufen Hardmode-Erz

		QuestObjective: {
			Description: {
				T1: Sammle Kobalt- oder Palladiumerz
				T2: Sammle Mithril- oder Orikalerz
				T3: Sammle Adamantit- oder Titanerz
			}
		}

		DetailedDescription: Nach dem Fall der Fleischwand zerschlägst du die Altäre mit einem heiligen Hammer, und in der Tiefe wachsen drei neue Metalle. Jedes ist härter als alles zuvor.
	}

	ChlorophyteQuest: {
		DisplayName: Macht des Chlorophyts
		Description: Sammle dreißig Chlorophyterz
		DetailedDescription: Nach dem Fall der Maschinen wächst im tiefen Dschungelschlamm ein leuchtendes grünes Metall. Es hat einen eigenen Willen und vermehrt sich von selbst.
	}

	CalamityLoreHub: {
		DisplayName: Anomalie-Untersuchung
		Description: Mit dieser Welt stimmt etwas nicht
		QuestObjective.Description: Klicke zum Abholen
		DetailedDescription: Das Meer ist Säure, die Klippen brennen, und im Krater eines Sterns wächst, was in keinem Bestimmungsbuch steht. Schreib alles auf; die dunkle Seite dieser Welt ist größer, als du denkst.
	}

	ExploreSulphurSea: {
		DisplayName: Schwefelsee
		Description: Erkunde die Schwefelsee
		QuestObjective.Description: Erreiche die Schwefelsee
		DetailedDescription: Auf einer Seite der Welt gibt es kein blaues Meer, nur vergilbtes Säurewasser. Regen zischt, wo er landet, und die Fische kommen giftig herauf. Halte Mund und Nase zu, und trink nicht.
	}

	ExploreAbyss: {
		DisplayName: Mund des Abgrunds
		Description: Tauche in den Abgrund unter der Schwefelsee
		QuestObjective.Description: Betrete den Abgrund
		DetailedDescription: Im Boden der Schwefelsee klafft ein Riss nach unten. Licht kommt nicht mit, Atem auch nicht, und je tiefer du gehst, desto älter sind die Dinge, die dort leben.
	}

	AbyssDeepQuest: {
		DisplayName: Grund des Abgrunds
		Description: Bring Lumenyl und Leerenstein aus dem Abgrund mit
		DetailedDescription: Wo Grubenlampen nicht hinreichen, wächst blau leuchtender Kristall an den Felswänden. Grab ihn und komm lebend wieder hoch; erst dann warst du wirklich im Abgrund.
	}

	ExploreSunkenSea: {
		DisplayName: Versunkenes Meer
		Description: Finde das Versunkene Meer tief unter der Wüste
		QuestObjective.Description: Erreiche das Versunkene Meer
		DetailedDescription: Unter der Wüste liegt ein stilles Stück Blau. Prismen leuchten im Wasser, und die Muscheln sind größer als dein Haus. Das ist vielleicht die sanfteste Ecke dieser Welt.
	}

	ExploreBrimstoneCrag: {
		DisplayName: Schwefelfeuerklippe
		Description: Betrete die Schwefelfeuerklippe am Rand der Unterwelt
		QuestObjective.Description: Erreiche die Schwefelfeuerklippe
		DetailedDescription: An einer Seite der Hölle steht eine Klippe, die länger brennt, als irgendwer sich erinnert. Dunkelrotes Feuer sickert aus dem Mauerwerk, und in den Ruinen schläft ein Elementargeist.
	}

	ExploreAstral: {
		DisplayName: Sternenfleck
		Description: Erkunde das sternenbefallene Land
		QuestObjective.Description: Erreiche die Astralinfektion
		DetailedDescription: Ein Stern ist in die Welt gekracht, und was im Krater wächst, steht in keinem Bestiarium. Das Land wechselt die Farbe, die Kreaturen die Gestalt, und das ist erst der Anfang.
	}

	AcidRainQuest: {
		DisplayName: Säureregen naht
		Description: Überstehe einen Säureregen
		QuestObjective.Description: Erlebe das Säureregen-Ereignis
		DetailedDescription: Die Wolken über der Schwefelsee sind gelb. Wenn es regnet, kocht das ganze Meer, und was im Wasser lebt, klettert mit dem Regen an Land. Nimm einen Schirm mit. Im Ernst.
	}

	DeliciousMeatQuest: {
		DisplayName: Köstliches Fleisch
		Description: Erhalte ein Stück köstliches Fleisch
		DetailedDescription: Niemand weiß, von welchem Tier es stammt, und niemanden interessiert es. Schmeckt, sättigt, taugt sogar als Baustein. Leg Vorrat an.
	}

	BrimlishQuest: {
		DisplayName: Schwefelfisch
		Description: Angle einen Schwefelfisch
		DetailedDescription: Sogar im Säurewasser leben Fische, und sie wirken überraschend munter. Wirf die Leine in die Schwefelsee und sieh, was anbeißt.
	}

	GiantClamQuest: {
		DisplayName: Riesenmuschel
		Description: Besiege die Riesenmuschel
		DetailedDescription: Die größte Schale im Versunkenen Meer. Meistens still wie ein Stein; jeder, der sie aufgebrochen hat, hat es bereut.
	}

	CragmawMireQuest: {
		DisplayName: Schlammrachen
		Description: Besiege während des Säureregens den Schlammrachen
		DetailedDescription: Sobald die Welt hart wird, treibt im Säureregen etwas herauf, das beißt. Es hat viel zu viele Zähne, und alle zeigen auf dich.
	}

	MaulerQuest: {
		DisplayName: Blutbeißerhai
		Description: Besiege während des Säureregens den Blutbeißerhai
		DetailedDescription: Ein Hai, großgezogen in Säure, mit einem Temperament passend zum pH-Wert. Wenn er aus dem Wasser schießt, ist Ausweichen schon zu spät.
	}

	NuclearTerrorQuest: {
		DisplayName: Nuklearer Schrecken
		Description: Besiege während des Säureregens den Nuklearen Schrecken
		DetailedDescription: In der tiefsten Stunde des Säureregens schlüpft etwas Riesiges und Leuchtendes. Sogar das Säurewasser weicht zurück, wo es geht.
	}

	GreatSandSharkQuest: {
		DisplayName: Großer Sandhai
		Description: Besiege den Großen Sandhai
		DetailedDescription: Der schnellste Jäger der Wüste; die Dünen sind seine offene See. Töte genug seiner Art, und der König des Rudels erscheint persönlich.
	}

	LeviathanQuest: {
		DisplayName: Anahita und Leviathan
		Description: Besiege Anahita und Leviathan
		DetailedDescription: Zuerst kommt der Gesang, dann der große Schatten. Die Melodie der Sirene führt das Tiefseebestie; bleib nicht stehen und hör zu.
	}

	AstrumAureusQuest: {
		DisplayName: Astrum Aureus
		Description: Besiege Astrum Aureus
		DetailedDescription: Tief in der Astralinfektion kauert eine infizierte Kriegsmaschine. Nachts wacht sie auf, und wo ihre Ketten durchgefahren sind, wächst nichts.
	}

	RavagerQuest: {
		DisplayName: Verwüster
		Description: Besiege den Verwüster
		DetailedDescription: Ein Riese aus Fleisch und Mauerwerk, jedes Glied greift für sich an. Reiß alle vier Extremitäten ab, bevor der Rumpf ernst macht.
	}

	AstrumDeusQuest: {
		DisplayName: Astrum Deus
		Description: Besiege Astrum Deus
		DetailedDescription: Lege ein Opfer auf den Astralaltar, und ein infizierter Gott schwimmt aus dem Nachthimmel herab. Erst sein Tod öffnet die Astralerze deiner Spitzhacke.
	}

	BossRushQuest: {
		DisplayName: Endkampf
		Description: Bestehe einen Endkampf
		QuestObjective.Description: Schließe den Endkampf ab
		DetailedDescription: Zerdrücke den Terminus, und alles, was du je getötet hast, stellt sich wieder in die Reihe. Töte sie alle ein zweites Mal, dann ist diese Reise besiegelt.
	}

	AerialiteQuest: {
		DisplayName: Himmelsglanz
		Description: Schmiede Aerialite-Barren
		DetailedDescription: Stirbt die Wüstenplage, fällt blassblauer Erzstaub vom Himmel. Leicht genug zum Schweben, aber fester als Eisen.
	}

	CryonicQuest: {
		DisplayName: Polar-Kristall
		Description: Schmiede Kryonit-Barren
		DetailedDescription: Nach dem Zerbrechen Kryogens kristallisieren in tiefem Tundraeis blaue Adern. In der Hand schmilzt es nicht; es wird nur kälter.
	}

	PerennialQuest: {
		DisplayName: Immergrünes Geschenk
		Description: Schmiede Perennial-Barren
		DetailedDescription: Wo Plantera welkte, wächst atmendes grünes Metall aus der Erde. Der Dschungel dankt auf seine Weise.
	}

	LifeAlloyQuest: {
		DisplayName: Lebenslegierung
		Description: Schmelze Lebenslegierungen
		DetailedDescription: Drei lebende Metalle zu einem; der Barren trägt noch einen Puls. Jedes hochwertige Gerüst baut darauf.
	}

	AstralBarQuest: {
		DisplayName: Astralschmelze
		Description: Schmiede Astralbarren
		DetailedDescription: Ist der Gotteswurm tot, geben die Astraladern endlich der Spitzhacke nach. Die Barren leuchten von selbst im Dunkeln.
	}

	UelibloomQuest: {
		DisplayName: Uelibloom in Blüte
		Description: Schmiede Uelibloom-Barren
		DetailedDescription: Nach dem heiligen Feuer der Göttin blühten Metallblumen im Dschungelschlamm. Schmelz die Blüten zu Barren; das Licht bleibt drin.
	}

	BloodstoneQuest: {
		DisplayName: Blutsteinhärten
		Description: Sammle Blutsteinkerne
		DetailedDescription: Nach dem Fall der Göttin steigen dunkelrote Steine aus der Lava der Schwefelfeuerklippe. Sie schlagen noch, wie Herzen außerhalb des Körpers.
	}

	AscendantEssenceQuest: {
		DisplayName: Aufgestiegener Geist
		Description: Kondensiere aufgestiegene Geisteressenz
		DetailedDescription: Geister, Sternenstaub, Mondlicht und ein Wille, der sich nicht zerstreuen lässt. Press sie in eine Essenz; das reicht, um eine Legende zu entzünden.
	}

	YharonSoulQuest: {
		DisplayName: Glut der Drachenseele
		Description: Sammle Yharon-Seelenfragmente
		DetailedDescription: Als der große Drache verbrannt war, blieb in den Flammen keine Asche, sondern noch heiße Seelensplitter. Pass auf dein Herz auf, wenn du sie aufhebst.
	}

	FruitQuest: {
		DisplayName: Gaben des Lebens
		Description: Sammle alle vier lebensstärkenden Früchte
		DetailedDescription: Neben den Leichen mächtiger Feinde reifen manchmal seltsame Früchte. Vier Arten insgesamt, und jede schiebt dein Leben an eine neue Grenze.
	}

	DraedonPowerCellQuest: {
		DisplayName: Uralte Energie
		Description: Sammle Energiezellen
		DetailedDescription: In den Laborruinen liegen Zellen, die noch Ladung halten. Eine Energiedichte weit über deinen Generatoren; das lohnt sich zu untersuchen.
	}

	DraedonsForgeQuest: {
		DisplayName: Gigantenschmiede
		Description: Erhalte die Schmiede des Giganten
		DetailedDescription: Am Ende der Industrie steht ein Ofen, der alles schmelzen kann. Bau ihn zusammen, und deine Werkstatt trifft nie wieder auf etwas, das sie nicht herstellen kann.
	}

	ConquerorMilestone: {
		DisplayName: Chronik der Eroberung
		Description: Besiege jeden mächtigen Feind dieser Welt
		QuestObjective.Description: Schließe alle Jagdaufträge ab
		DetailedDescription: Vom Schleimkönig bis zu den Wesen am Ende der Welt, beende jeden harten Kampf. Wenige füllen je diese Seite.
	}

	EventMilestone: {
		DisplayName: Ereignisfriedensstifter
		Description: Befriede jede Invasion und jede Anomalie
		QuestObjective.Description: Schließe alle Ereignisaufträge ab
		DetailedDescription: Armeen, Flotten, Monde aus anderen Welten. Was in Scharen kam, hast du zurückgeschickt.
	}

	CompletionistMilestone: {
		DisplayName: Vollständiger Kodex
		Description: Erledige alles in diesem Buch
		QuestObjective.Description: Schließe alle Aufträge ab
		DetailedDescription: Die letzte Seite dieses Buchs ist für den, der es ganz liest. Wenn du es zuklappst, hält diese Welt nichts mehr, das du nicht gesehen hast.
	}
}
