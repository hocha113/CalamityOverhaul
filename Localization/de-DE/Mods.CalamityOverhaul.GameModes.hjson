GameModeText: {
	BrutalName: Grausame Welt
	AsuraName: Asura-Hölle
	AnnihilationName: Des Todes Ewigkeit
	GodSmithName: Göttliches Werk
	BrutalOnLine: Diese Welt ist grausam, und doch liebst du sie noch immer
	BrutalOffLine: Die Welt zieht ihre Fänge ein. Ihre Milde ist nur eine Atempause
	AsuraOnLine: Der Asura-Pfad öffnet sich. Jeder Schmerz, den du zufügst, wird voll vergolten
	AsuraOffLine: Der Asura-Pfad schließt sich. Alle Schulden sind beglichen
	AnnihilationOnLine: Alles wird vergehen; nur der Tod lebt ewig
	AnnihilationOffLine: Der Tod ruht kurz; die Lebenden stehlen einen Atemzug
	GodSmithOnLine: Der Gottesschmied hebt den Hammer; jedes gemeine Eisen wird umgeschmiedet
	GodSmithOffLine: Das Schmiedefeuer erlischt; alle Waffen kehren zu ihrer alten Gestalt zurück
	BrutalDesc:
		'''
		Entfesselt die überarbeitete, rasende Boss-KI. Ihre Werte stehen auf Meister-Schwierigkeit
		Alle Feinde erhalten 50% mehr Leben und Schaden; kleinere Gegner werden schneller und bleiben rasend
		'''
	AsuraDesc:
		'''
		Die Verstärkung steigt auf 100%. Feinde gewöhnen sich an wiederholte Angriffe derselben Art,
		und jeder Schaden, den du zufügst, wird zur Untergrenze ihres Gegenschlags.
		Nahkampfangriffe gewöhnen sie sich schwerer ab, die Klinge selbst besonders;
		je näher der Nahkampf am Feind, desto höher der Schaden
		'''
	AnnihilationDesc:
		'''
		Die letzte Gestalt der Asura-Hölle in einer Zenit-Welt. Jeder Schrecken verdoppelt sich erneut:
		Feinde gewöhnen sich schneller, und der Schmerz, den du zufügst, wird doppelt vergolten
		'''
	BrutalCreationDesc: Meister ist die Untergrenze: überarbeitete Bosse erwachen, alle Feinde um die Hälfte verstärkt
	AsuraCreationDesc: Meister ist die Untergrenze: Feinde gewöhnen sich an deine Schläge und spiegeln deinen Schmerz
	GodSmithDesc:
		'''
		Alle Vanilla-Waffen erhalten völlig neue Angriffe,
		Vanilla-Rüstungen eine zu ihrer Natur passende Göttergabe.
		Feindstärke bleibt unberührt; der Schalter steht für sich und berührt keine andere Welt
		'''
	GodSmithRecastTitle: Gottesschmied-Umschmiedung
	GodSmithEndowPrefix: "Göttergabe: "
	StateOn: Aktiv
	StateOff: Schlummernd
	HintEnable: Klicken zum Erwecken
	HintDisable: Klicken zum Versiegeln
	BossRefuse: Ein Boss lebt noch. Der Pakt kann jetzt nicht geändert werden
	AsuraNeedBrutal: Zuerst die Grausame Welt erwecken
}

SporeshineAmbience.DazeDeathReason: "{0} ist tief im Sporennebel betrunken umgesunken"
