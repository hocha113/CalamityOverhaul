FishSwarm: {
	DisplayName: Fischschwarm-Metamorphose
	Tooltip:
		'''
		Rechtsklick: Verwandle dich in einen Fischschwarm und stürme voran.
		Linksklick: Schicke den Schwarm in Richtung des Cursors.
		'''
	Studied: Ein unscheinbarer Fisch — aber mit beträchtlichem Potenzial.
}

FishSparkling: {
	DisplayName: Königlicher Funkeltanz
	Tooltip:
		'''
		Beschwört beim Schießen periodisch mehrere Funkelköniginnenfische für einen Salvenangriff.
		Die Abklingzeit lädt während des Schießens nicht auf.
		'''
	Studied: Ich glaube, die Erforschung dieses Exemplars könnte Laserpointer-Technologie voranbringen.
}

FishZombie: {
	DisplayName: Erwachte Flut
	Tooltip:
		'''
		Rechtsklick: Beschwöre eine Horde ertrunkener Toter, die auf Feinde stürmt.
		Sie explodieren, wenn sie ein Ziel erreichen.
		'''
	Studied: Ein übel riechender Fisch. Ist er überhaupt … lebendig?
}

FishCloud: {
	DisplayName: Wolkenreiter
	Tooltip:
		'''
		Rechtsklick: Reite auf einer Regenwolke mit hoher Geschwindigkeit.
		Während des Reitens kannst du durch Wände und Waffen einsetzen.
		Hinterlässt eine Spur aus Regen.
		'''
	Studied: Sieht aus wie ein Fisch, ist aber technisch gesehen eine schwimmende Wolke.
}

FishVoodoo: {
	DisplayName: Voodoo-Schutz
	Tooltip:
		'''
		Wenn diese Fähigkeit ausgerüstet ist, verhinderst du bei einem tödlichen Treffer den Tod
		und überträgst den Schaden auf einen nahen Feind; löst Abklingzeit aus.
		Ist eine Domäne aktiv, geht der Schaden auf *alle* Feinde darin über.
		'''
	Studied: Ein nützliches Exemplar. Es gibt mir … interessante Ideen für neue Experimente.
}

FishDemonicHell: {
	DisplayName: Inferno-Ausbruch
	Tooltip:
		'''
		Beschwört beim Schießen periodisch ein Inferno-Siegel.
		Bei voller Aufladung feuert das Siegel eine Höllenfeuerkugel ab,
		die nach kurzer Flugzeit explodiert.
		'''
	Studied: Er brennt im Inferno.
}

FishDynamite: {
	DisplayName: Dynamitfisch
	Tooltip:
		'''
		Rechtsklick: Wirf einen Dynamitfisch, der der Schwerkraft unterliegt.
		Der Fisch explodiert bei Feindkontakt oder nach kurzer Zeit.
		'''
	Studied: Seine innere Anatomie ist höchst komplex — hauptsächlich aus dem Teil, das „BOOM" macht.
}

FishBone: {
	DisplayName: Knochenzyklon
	Tooltip:
		'''
		Erzeugt beim Schießen periodisch umkreisende Knochen.
		Nach einer Runde fliegen sie zu Feinden und kehren zurück.
		Bei Schaden zerspringen die Knochen.
		'''
	Studied: Damit eine Suppe zu kochen wäre vielleicht nicht schlecht — schmackhaft und kalziumreich.
}

FishHarpy: {
	DisplayName: Harpyienfeder
	Tooltip:
		'''
		Erzeugt beim Schießen periodisch umkreisende Harpyienfedern.
		Bei anhaltendem Feuer fliegen sie nach einer Weile in alle Richtungen.
		'''
	Studied: Ich glaube nicht, dass dieser Fisch fliegt — aber er hat definitiv Flügel.
}

FishFallenStar: {
	DisplayName: Sternenregen-Fisch
	Tooltip:
		'''
		Beim Schießen werden Sterne abgefeuert, umgeben von Begleitsternen.
		Nach einer bestimmten Anzahl wird ein Sternenregen herabgerufen.
		'''
	Studied: Bei Tageslicht würde er vielleicht wie ein Stern verschwinden.
}

FishHunger: {
	DisplayName: Hungriger Geist
	Tooltip:
		'''
		Erzeugt beim Schießen periodisch umkreisende Hungergeister.
		Bei maximaler Anzahl folgen sie deiner Führung und zerfleischen Feinde.
		'''
	Studied: Er sieht sehr hungrig aus.
}

FishBat: {
	DisplayName: Fledermausschwarm
	Tooltip:
		'''
		Rechtsklick: Verwandle dich in einen Fledermausschwarm für schnelle Bewegung.
		Angriffe beenden die Verwandlung.
		'''
	Studied: Schläft dieser Fisch kopfüber ein?
}

FishEaterofPlankton: {
	DisplayName: Planktonfresser-Spur
	Tooltip:
		'''
		Beim Schießen werden kleine Seelenfresser abgefeuert.
		Sie winden sich unaufhörlich und greifen Feinde an.
		'''
	Studied: Dieser Fisch hat Würmer!
}

FishAmanita: {
	DisplayName: Giftsporenblase
	Tooltip:
		'''
		Beim Schießen vier rotierende Pilzgeschosse; jeder Schuss wechselt zur nächsten Munition.
		Explosionspilz: Streut 3 Explosionspilze, die bei Treffer kleinflächig explodieren.
		Verfolgungsspore: Streut 5 Verfolgungssporen zum nächsten Ziel.
		Giftnebelpilz: Streut 2 Giftnebelpilze, die bei Treffer Giftnebel erzeugen.
		Blitzspore: Streut 5 Blitzsporen, die bei Treffer reflektieren.
		'''
	Studied: Dieser Fisch repräsentiert das Ökosystem des Pilzbioms.
}

FishHoney: {
	DisplayName: Honigbienenschwarm
	Tooltip:
		'''
		Rechtsklick: Beschwöre einen Schwarm umkreisender Bienen.
		Sobald sie Feinde entdecken, greifen sie aktiv an.
		'''
	Studied: Aus irgendeinem Grund hat er Angst vor Welsen.
}

Fishotroning: {
	DisplayName: Skelettkönig-Faust
	Tooltip:
		'''
		Beim Schießen wächst eine Skelettkönig-Hand zur Unterstützung; bei Schaden geht eine verloren.
		Auf Distanz wirft die Hand geladene Knochen.
		In Nahdistanz schlägt sie auf das Ziel.
		'''
	Studied: Er hat mehr als vier Hände!
}

FishIchorn: {
	DisplayName: Ichor-Ätzung
	Tooltip:
		'''
		Beim Schießen werden Ichor-Strahlen gestreut.
		Treffer belegen das Ziel mit Ichor.
		'''
	Studied: Der Speichel dieses Fisches ist sehr nützlich!
}

FishCursed: {
	DisplayName: Fluchflammen-Ausbruch
	Tooltip:
		'''
		Beim Schießen werden verfluchte Flammen gestreut.
		Nach dem Abschuss fallen sie entgegen der Schwerkraft.
		'''
	Studied: Er verbrennt die Angel gar nicht!?
}

FishSlime: {
	DisplayName: Schleimspur
	Tooltip:
		'''
		Beim Bewegen werden Schleimgel-Klumpen geworfen.
		Sie haften an getroffenen Zielen.
		'''
	Studied: Er wirkt sehr „schleimig".
}

FishBunny: {
	DisplayName: Hoppelbombe
	Tooltip:
		'''
		Rechtsklick: Wirf hüpfende Hasenfische, die der Schwerkraft unterliegen.
		Sie explodieren bei Feindkontakt oder nach kurzer Zeit.
		'''
	Studied: Gefährliches Flausch!
}

FishCat: {
	DisplayName: Miau-Torpedo
	Tooltip:
		'''
		Rechtsklick: Wirf hüpfende Welse, die bei jedem Sprung miauen.
		Sie explodieren bei Feindkontakt oder nach kurzer Zeit.
		'''
	Studied: Dieser Fisch scheint Honig sehr zu lieben.
}

FishDirt: {
	DisplayName: Erdfisch-Kreisel
	Tooltip:
		'''
		Beim Bewegen kreisen Erdfische um dich.
		Bei genügender Anzahl kann ein Erdball abgefeuert werden.
		Der Erdball springt und rollt am Boden mit anhaltendem Schaden.
		Nur ein Erdball gleichzeitig möglich.
		'''
	Studied:
		'''
		Der Geschmack von Erde erinnert mich an den Meeresboden der Heimat.
		Diese Kleinen halten sich gern zusammen.
		'''
}

FishMud: {
	DisplayName: Schlammwächter
	Tooltip:
		'''
		Beim Schießen werden Schlammfisch-Wächter aus dem Boden beschworen.
		Sie schießen schwerkraftabhängige Schlammkugeln und verschwinden danach.
		'''
	Studied: Diese Kerle können sich ausgezeichnet verstecken.
}

FishPeng: {
	DisplayName: Kamikaze-Pinguin
	Tooltip:
		'''
		Beim Schießen werden Pinguine über Feinden beschworen.
		Sie stürzen vom Himmel und verursachen Flächenschaden und Rückstoß.
		'''
	Studied: Sie kommen vielleicht aus Madagaskar.
}

FishDrizzle: {
	DisplayName: Schwefelfeuer-Flamme
	Tooltip:
		'''
		Beschwört beim Schießen periodisch mehrere Schwefelfeuer-Spucker.
		Die Abklingzeit lädt während des Schießens nicht auf.
		'''
	Studied: Ich glaube, er taugt für mehr als nur ein Lagerfeuer.
}

FishofCthulu: {
	DisplayName: Abgrundblick
	Tooltip:
		'''
		Beim Schießen werden Beobachtungsaugen beschworen.
		Nähern sie sich Feinden, wechseln sie die Form und stürmen zu.
		'''
	Studied: Er starrt dich ständig an …
}

FishJewel: {
	DisplayName: Regenbogen-Ouvertüre
	Tooltip:
		'''
		Beim Schießen werden Edelstein-Geschosse in fester Reihenfolge abgefeuert.
		Jeder Edelstein hat einen eigenen Sound beim Abschuss.
		'''
	Studied: Eine Sechs-Farben-Ouvertüre … vielleicht wirklich ein Regenbogenkonzert.
}

FishTunabeard: {
	DisplayName: Strömungsschnitt
	Tooltip:
		'''
		Rechtsklick: Schneller Langstreckenstoß zur Mausposition.
		Während des Stoßes bist du unverwundbar und kannst durch Wände.
		'''
	Studied: Gibt es für Fische einen Unterschied zwischen Piraten und Räubern?
}

FishBloodyManowar: {
	DisplayName: Purpur-Urteil
	Tooltip:
		'''
		Beim Schießen werden blutige Quallen beschworen, die sich um Feinde sammeln.
		Die Ansammlung verursacht großflächigen Schaden.
		'''
	Studied: Symbiose oder Hierarchie?
}

FishUnicorn: {
	DisplayName: Regenbogen-Durchstoß
	Tooltip:
		'''
		Rechtsklick: Schneller horizontaler Langstreckenstoß.
		Während des Stoßes bist du unverwundbar und kannst durch Wände.
		'''
	Studied: Der Legende nach kann nur ein reines Mädchen ihn angeln!
}

FishWyverntail: {
	DisplayName: Weißdrachen-Schatten
	Tooltip:
		'''
		Nach dem Schießen werden für eine Weile Weißdrachen beschworen.
		Sie stürmen schnell auf Feinde und verursachen Schaden.
		'''
	Studied: Ich glaube, er gehört zu den legendären Kreaturen.
}

FishScorpio: {
	DisplayName: Sandskorpion-Wächter
	Tooltip:
		'''
		Beim Schießen werden Skorpion-Wächter am Boden beschworen.
		Sie feuern Sandstürme auf Feinde.
		'''
	Studied: In seinem Inneren ist alles Sand.
}

FishPrismite: {
	DisplayName: Regenbogen-Schock
	Tooltip:
		'''
		Beim Schießen werden Kugeln zu prismatischen Schockwellen.
		Bei Treffer auf Feind oder Block teilen sie sich und fliegen weiter.
		'''
	Studied: Die Schönheit dieses Fisches kommt vom Schwermetall-Überschuss.
}

FishObsidian: {
	DisplayName: Obsidian-Festung
	Tooltip:
		'''
		Beim Schießen kreisen Obsidianfische um dich.
		Sie schaden berührten Feinden fortlaufend.
		Bei jedem Treffer zerbricht ein Obsidianfisch.
		'''
	Studied: Obsidian ist eigentlich ziemlich spröde.
}

FishRock: {
	DisplayName: Fels-Hammerschlag
	Tooltip:
		'''
		Erzeugt periodisch Felsfisch-Hämmer, die Feinde verfolgen.
		Über dem Ziel laden sie auf und schlagen nach unten.
		'''
	Studied: Hat noch niemand gefragt, ob das arme Ding als Hammer dienen will.
}

FishVariegatedLard: {
	DisplayName: Bunte Ölflecken
	Tooltip:
		'''
		Bei Treffer spritzt Öl vom Feind.
		Das Öl haftet an Blöcken oder Feinden und erzeugt mehr Öl.
		'''
	Studied: Ich brauche ganz viel Spülmittel.
}

FishPrincess: {
	DisplayName: Prinzessinnen-Märchen
	Tooltip:
		'''
		Beim Schießen kämpft eine Prinzessinnenfisch für dich.
		Sie feuert gestreute Magiegeschosse auf Feinde.
		'''
	Studied: Offensichtlich ist sie kein Prinz.
}

FishCrimsonTiger: {
	DisplayName: Purpur-Tigerpatrouille
	Tooltip:
		'''
		Rechtsklick: Beschwöre Purpur-Tigerfische, die dir folgen.
		Sobald sie Feinde entdecken, greifen sie aktiv an.
		'''
	Studied: Sie wirken ziemlich aggressiv.
}

FishTropicalBarracuda: {
	DisplayName: Tropischer Durchflug
	Tooltip:
		'''
		Beim Schießen werden Tropen-Barrakudenschwärme vom Bildschirmrand beschworen.
		Sie durchqueren den Bildschirm aus zufälliger Richtung.
		'''
	Studied: Sie sind unglaublich schnell.
}

FishNeonTetra: {
	DisplayName: Neon-Spur
	Tooltip:
		'''
		Beim Bewegen hinterlässt du leuchtende Neonfische.
		Sie erhellen Feinde auf dem Weg und verursachen Schaden.
		'''
	Studied: Ich mag ihre Schuppen.
}

FishBrimlish: {
	DisplayName: Schwefelfeuer-Entweichung
	Tooltip:
		'''
		Beschwört beim Schießen periodisch einen kleinen Schwefelfeuerfisch.
		Er spuckt viele gestreute Schwefelfeuerkugeln auf Feinde.
		'''
	Studied: Die Temperatur ist erschreckend hoch.
}

FishDoubleCod: {
	DisplayName: Doppel-Dorsch-Gefährten
	Tooltip:
		'''
		Beim Schießen werden periodisch verfolgende Dorsche abgefeuert.
		Sie verfolgen Feinde und verursachen Kontaktschaden.
		'''
	Studied: Eine sehr merkwürdige Fischart.
}

FishFrostMinnow: {
	DisplayName: Frost-Dekret
	Tooltip:
		'''
		Beschwört beim Schießen periodisch einen Frostfisch.
		Er spuckt viele gestreute Frostkugeln auf Feinde.
		'''
	Studied: Finger einfrieren!
}
