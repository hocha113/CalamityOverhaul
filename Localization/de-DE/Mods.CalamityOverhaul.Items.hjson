RMagicConch: {
	DontUseMagicConch: Du wirst von einer mächtigen Kreatur beobachtet...

	RMagicConch: {
		DontUseMagicConch: Du wirst von einer mächtigen Kreatur beobachtet...
		DisplayName: Magische Muschel
		Tooltip: Hör genau hin, dann hörst du das Meer
	}
}

GraniteTome: {
	DisplayName: Granitfoliant
	Tooltip:
		'''
		Beschwört eine langsame, zielsuchende Kugel aus Granitenergie
		Zerbricht beim Aufprall in zielsuchende Kristallsplitter
		'''
}

GraniteFlower: {
	DisplayName: Granitblüte
	Tooltip:
		'''
		Verschießt einen Kristallsamen, der zu einer verweilenden Energieblume erblüht
		Die Blüte pulsiert mehrmals und versprüht ringsum Kristallblütenblätter
		'''
}

GraniteThrowingKnife: {
	DisplayName: Granit-Wurfmesser
	Tooltip:
		'''
		Wirft ein durchdringendes Messer, das kristalline Energie hinter sich herzieht
		Zerbricht bei seinem letzten Treffer oder an Gelände in Kristallsplitter
		'''
}

GraniteWalkingBoots: {
	DisplayName: Granit-Wanderstiefel
	Tooltip:
		'''
		Erhöht Laufgeschwindigkeit und Beschleunigung erheblich
		Knistert bei voller Geschwindigkeit mit blauen Funken
		'''
}

MarbleClub: {
	DisplayName: Marmorkeule
	Tooltip:
		'''
		Ein langsamer, schwerer Schwung mit zermalmendem Rückstoß
		Kann Feinde versteinern und sie kurz verlangsamen
		Der erste Treffer jedes Schwungs entfesselt eine Marmor-Schockwelle
		'''
}

MarbleHuntingKnife: {
	DisplayName: Marmor-Jagdmesser
	Tooltip:
		'''
		Schnelle, schneidende Hiebe
		Jeder dritte Schlag ist ein breiterer Abschluss, der Marmorsplitter versprüht
		'''
}

MarbleDisc: {
	DisplayName: Marmordiskus
	Tooltip:
		'''
		Schleudert einen rotierenden Diskus, der zwischen Feinden und Wänden abprallt
		Kehrt dann in einem Bogen in deine Hand zurück; bis zu zwei können gleichzeitig fliegen
		'''
}

MarblePebble: {
	DisplayName: Marmorkiesel
	Tooltip:
		'''
		Ein endloser Schleuderstein, schnell und anfällig für kritische Treffer
		Verursacht weitaus mehr Schaden an Feinden mit hoher maximaler Lebenskraft
		Prallt einmal vom Boden ab
		'''
}

MarbleShield: {
	DisplayName: Marmor-Ägis
	Tooltip:
		'''
		Erhöht Verteidigung und Rückstoßwiderstand
		Erhält einen sich regenerierenden Steinschild, der einen eingehenden Treffer absorbiert und in Splitter zerbirst
		Stemme dich für einen perfekten Block, der Projektile reflektiert
		'''
}

MarbleBalloon: {
	DisplayName: Marmorballon
	Tooltip:
		'''
		Drücke in der Luft Abwärts, um herabzustürzen und bei der Landung eine Schockwelle freizusetzen
		Hebt Fallschaden auf
		'''
}

MarbleinaBottle: {
	DisplayName: Marmor in der Flasche
	Tooltip: Gewährt einen schweren zweiten Sprung
}

MarbleCloudBalloon: {
	DisplayName: Marmor-Wolkenballon
	Tooltip:
		'''
		Gewährt einen schweren zweiten Sprung
		Drücke in der Luft Abwärts, um herabzustürzen und bei der Landung eine Schockwelle freizusetzen
		Hebt Fallschaden auf
		'''
}

TestItem: {
	// DisplayName: Test Item
	// Tooltip: ""
}

OniMeiRubbingHigekiri: {
	// DisplayName: Higekiri
	Tooltip: Direkte Klingentreffer verstärken sich gegen schwer verletzte Ziele und erstatten bei Tötung Haltung; Klingenschaden -2%
	// Origin: The night of the test cut, the head fell with the beard still clinging to the edge. The old name comes from that
	Power: Bartschneider: Direkte Klingentreffer skalieren bei Zielen unter 35 % Leben mit deren Verletzung (bis +60 %, gegen Bosse +45 %); eine Tötung durch einen direkten Klingentreffer erstattet einmal pro Aktion 8 Haltung
	Burden: Klingenschaden -2 % — gegen gesunde Ziele ist diese Schneide etwas stumpfer als die ursprüngliche Inschrift
}

OniKeikoRune: {
	// DisplayName: Keiko Rune
	/* Tooltip:
		'''
		Use it to open the Onikiri lesson from the beginning, or use it again mid-lesson to put the lesson away
		Left with you when the opening lesson is declined; the rune is not consumed and may be used again
		''' */
	// NeedBlade: Onikiri is not in your bag, so the rune has no lesson to open
	// Closed: The lesson is put away; use the rune again to reopen
	// NotNow: Something else holds the stage right now
}

OniMeiRubbingOnikiri: {
	// DisplayName: Onikiri
	Tooltip: Ursprüngliche Inschrift: Die Klinge bleibt unverändert, ohne Gabe und ohne Preis
	// Origin: At Ichijo-Modoribashi, the oni that lost its arm never dared come back for it. The name has been nailed to the tang ever since
	Power: Die ursprüngliche Inschrift. Die Klinge bleibt genau, wie sie ist — nichts wird gewährt, nichts genommen
	Burden: ———
}

OniMeiRubbingShishinoko: {
	// DisplayName: Shishi-no-ko
	Tooltip: Zwei Kieferwellen krönen eine vollständige Fünferkombo; Kombointervall +2%
	// Origin: Left by the pillow at midnight, the blade roared like a lion. Inlaid in gold, to honor the name
	Power: Löwengebrüll: Schließe fünf Komboschläge ohne Unterbrechung durch einen Spurt oder eine Kunst ab; der fünfte Schlag entfesselt zwei zusammenlaufende Kieferwellen mit je 22 % des Basisklingenschadens
	Burden: Kombointervall +2 % — ein Brüllen muss eingeatmet werden, bevor es hervorbricht
}

OniMeiRubbingTomokiri: {
	// DisplayName: Tomokiri
	Tooltip: Spurtabbrüche hinterlassen verzögerte Schuldhiebe; erlittener Schaden +6%
	// Origin: Crossed with a friendly blade in trial, it cut the friend in two. A name of blame, chiseled into the tang; the sword has run violent since
	Power: Freundschneider: Wird eine Kombo mit Kamui abgebrochen, bleibt ein Phantomhieb zurück, der nach 6 Ticks mit 35 % des Basisklingenschadens zuschnappt
	Burden: Erlittener Schaden +6 %; jedes Phantom fügt eine Schuld hinzu (max. 3), die den nächsten Spurt je 4 Vigor kostet — ein Zanshin-Treffer tilgt alle Schulden
}

OniMeiRubbingKazehi: {
	// DisplayName: Kaze-hi
	Tooltip: Spurtkosten -15 %, Sakura-Verbrauch -20 %; Schaden der Tintenmale -20%
	// Origin: A groove opened like a wind channel; where the blade passes, only wind is heard, no blade is seen
	Power: Windreiter: Vigor-Kosten des Blitzschritts -15 %, Verbrauch im Sakura-Flug -20 %
	Burden: Schaden der Blitzmale -20 % — die Hohlkehle wurde für Leichtigkeit geschnitten, nicht zum Schlachten
}

OniMeiRubbingChihi: {
	// DisplayName: Chi-hi
	Tooltip: Aktive Treffer stellen mehr Vigor wieder her; natürliche Regeneration -35%
	// Origin: This groove is not for lightness, but for letting blood. So said the one who opened the edge
	Power: Aderlass: Der erste Kombotreffer jedes Schlags stellt +1 Vigor wieder her; der erste Zanshin-Treffer einer Aktion stellt +4 wieder her
	Burden: Natürliche Vigor-Regeneration -35 %, Regenerationsverzögerung nach Verbrauch +0,3 s — ohne Blut an der Schneide kehrt wenig Atem zurück
}

OniMeiRubbingFudo: {
	// DisplayName: Fudo
	Tooltip: Verbrauche Haltung, um Treffer während gebundener Aktionen abzumildern; Haltungsgewinn -15%
	// Origin: Carved in the brushwork of the seed syllable Kan. The Immovable One sits by the edge, flames at his back
	Power: Unbeweglich: Verbrauche während einer gebundenen Aktion 20 Haltung, um feindlichen Kontakt- oder Projektilschaden auf 65 % und Rückstoß auf 25 % zu senken (2,5 s Abklingzeit); der Rückschlag der Zerstückelung wird nie abgewehrt
	Burden: Haltungsgewinn -15 % — die Kraft der Abwehr wird dem Aufbau entnommen
}

OniMeiRubbingKurikara: {
	// DisplayName: Kurikara
	Tooltip: Hinrichtungen gewähren drei Drachenfeuerschleifen; Vigor-Limit -10%
	// Origin: The dragon coils about the sword and would swallow it. An old horimono subject, its scales inlaid in gold
	Power: Drachenschlinge: Eine Hinrichtung gewährt drei Drachenfeuerschichten für 10 Sekunden; jeder vollständige fünfte Komboschlag verbraucht eine und entfesselt eine Schleife mit 50 % des Basisklingenschadens
	Burden: Vigor-Limit -10 % — wo sich der Drache windet, wird der Atem eng
}

OniMeiRubbingTessetsu: {
	// DisplayName: Tessetsu
	Tooltip: Der erste Treffer jedes Schlags durchtrennt Stahl; Klingenschaden -10%
	// Origin: A grand name for a scrap of iron. Nailed into the tang as a joke that stuck
	Power: Eisenschnitt: Der erste Kombotreffer jedes Schlags verursacht bei stählernen oder gepanzerten Gegnern ×1,25 Schaden
	Burden: Klingenschaden -10 % — auf Fleisch fühlt sich die Klinge wie stumpfes Eisen an
}

OniMeiRubbingKyushu: {
	// DisplayName: Kyushu
	Tooltip: Tiefe Todesstöße gegen echte Köpfe bei wenig Leben; Klingenschaden -3%
	// Origin: The head is still the old one. Cut clean; no need for a scare-name
	Power: Kopfjagd: Direkte Klingentreffer wirken nur auf eigenständige Körper oder echte Köpfe unter 35 % Leben und skalieren bis +85 % (+60 % gegen Bosse)
	Burden: Klingenschaden -3 %; Körper-, Schwanz- und alternative Körpersegmente lösen Kopfjagd nie aus
}

OniMeiRubbingIkiai: {
	// DisplayName: Ikiai
	Tooltip: Der fünfte Schlag entfesselt eine Schwertwelle mit 55 % Schaden; Kombointervall +4%
	// Origin: The breath you held while staring, then the blades met on the beat
	Power: Atemwelle: Der fünfte Schlag einer vollständigen Kombo schleudert eine Schwertwelle mit 55 % des Basisklingenschadens; sie fliegt 16 Ticks und durchdringt höchstens drei verschiedene Körper
	Burden: Kombointervall +4%
}

OniMeiRubbingKyoko: {
	// DisplayName: Kyoko
	Tooltip: Leerer Raum lädt einen Nahhieb und eine Druckwelle; schnelle Nahaktionen trüben den Fokus
	// Origin: A roar into empty air; the echo finds no place to land
	Power: Hohlgebrüll: 90 feindfreie Ticks laden den nächsten direkten Klingentreffer innerhalb von 260 px auf ×1,25 Schaden; solange es ruhig bleibt, ertönt alle 90 Ticks eine 24 Ticks anhaltende Druckwelle
	Burden: Vier Nahaktionen innerhalb von 36 Ticks verursachen 24 Ticks Fokusverlust mit ×0,95 Nahschaden; Fernangriffe verbrauchen den geladenen Hieb nicht
}

OniMeiRubbingKarikiri: {
	// DisplayName: Karikiri
	Tooltip: Der falsche Körper weicht einem Treffer vollständig aus; Wiederaufladung in 4 Sekunden
	// Origin: Learned so well it turned fake. An afterimage enters the tang
	Power: Falscher Körper: Der Beginn eines Blitzschritts hinterlässt für 90 Ticks ein Abbild in eingefrorener Pose, das einem Treffer eines feindlichen NPCs oder Projektils vollständig ausweicht; nach 240 Ticks ist es wieder bereit
	Burden: Solange das Abbild lebt, sind erlittener Schaden und Spurtkosten ×1,12; nach dem Zerbrechen ist der erlittene Schaden 60 Ticks lang ×1,18. Natürliches Vergehen erzeugt kein Vakuum
}

OniMeiRubbingMokukiri: {
	// DisplayName: Mokukiri
	Tooltip: Das natürliche Ende eines bezahlten Spurts lädt den Stillen Schnitt; Spurt oder Fehlschlag verbrauchen ihn
	// Origin: The air sank. You got used to it. The guilt stayed
	Power: Stiller Schnitt: Für 45 Ticks nach dem natürlichen Ende eines bezahlten normalen Blitzschritts verursacht die nächste Kombo- oder Zanshin-Aktion ×1,35 Schaden
	Burden: Ein weiterer Spurt oder ein Fehlschlag verbraucht den Stillen Schnitt; kostenlose Hinrichtungsspurts laden ihn nie auf
}

OniMeiRubbingKumokiri: {
	// DisplayName: Kumo-kiri
	// Tooltip: Three cuts pin a web; closing it cuts everything inside; regen -25% while anchors stand
	// Origin: The earth-spider nested in the rafters. What was cut was not the spider, but the threads it hung from
	/* Power:
		'''
		Ink-Silk: when the blade itself lands a hit, it pins a silk anchor at the cut point for 4s
		Spread them out: the same foe gives no second anchor within 0.4s, and two anchors need roughly six tiles between them
		The third anchor strings an ink-silk triangle that sags, then snaps toward its centre, cutting every foe it sweeps for 90% of a blade hit and binding them 1s
		After it closes, 1.5s pass before you can weave again
		''' */
	// Burden: While any anchor still stands, natural regen -25%. An anchor left to expire wastes the cut that set it
	// DeedHint: Cut down thirty of the things that nest in the rafters, and the blade will learn that smell
}

OniMeiRubbingOnimaru: {
	// DisplayName: Oni-maru
	// Tooltip: Stand still and the blade flies off to cut on its own; you have no blade while it is out
	// Origin: One of the Five Great Swords that cut its own demon's leg off. Stand still, and it still moves
	/* Power:
		'''
		Self-Cut: stand nearly still for 1s and the blade goes on standby
		From then on it spends 10 of your vigor every 1.5s to fly at a foe within 40 tiles, cut for 140% of a blade hit, and return to the sheath
		''' */
	// Burden: The blade is out of your hands for the whole flight, so no combo, no flash step, no Sakura Flight. With nothing nearby it will not launch
	// DeedHint: Take a hit while standing still for ten seconds without moving, and the blade moves for you once
}

OniMeiRubbingRaikiri: {
	// DisplayName: Rai-kiri
	// Tooltip: The fifth beat and the big arts call lightning under open sky; beat interval +6%, nothing indoors
	// Origin: Tachibana Dosetsu cut thunder in the rain. The edge has to learn that bolt first
	/* Power:
		'''
		Thunder-Call: when the fifth beat, a Zanshin strike, Annihilating Flash, or Finale Slash lands and there is open sky overhead, a bolt drops from the top of the world
		The bolt deals 70% of a blade hit, and in a thunderstorm one strike can call up to three
		''' */
	// Burden: Combo beat interval +6%, sunny days included, because the wind-up is paid either way. Blocked overhead or underground, no bolt falls
	// DeedHint: Slay a boss-tier foe in a storm under open sky, and the edge learns the bolt
}

OniMeiRubbingNuekiri: {
	// DisplayName: Nue-kiri
	// Tooltip: Finish a combo airborne and the fifth beat becomes a ground slam; no dashing for 0.7s after landing
	// Origin: Minamoto no Yorimasa's shot came from above. The cut fell out of the sky
	/* Power:
		'''
		Nue-Dive: finish a full combo at least three tiles off the ground and the fifth beat stops swinging sideways, diving at the floor instead
		The landing opens a shock ring about 12 tiles across for 120% of a blade hit, and drags nearby foes toward the impact
		''' */
	// Burden: No flash steps for about 0.7s after you land. Fought close to the ground, the fifth beat stays an ordinary fifth beat
	// DeedHint: At night, cut down a flyer from great height, and the blade learns that plunge
}

OniMeiRubbingKamihi: {
	// DisplayName: Kami-hi
	// Tooltip: Dashing through a foe drops a paper cutout; cutting the paper hits the foe; dashes cost more while paper stands
	// Origin: Omokage silhouettes cut out for the surface world. While the paper stands, the blade keeps cutting it
	/* Power:
		'''
		Paper-Effigy: dashing through a foe leaves a paper cutout of it where you land, good for 7s, two on the field at most
		Cutting that paper deals 80% of a blade hit straight to the foe itself
		It also opens a wound on the foe for 1.5s, and your hits land 12% harder while that wound is open
		''' */
	// Burden: Dash vigor cost +12% while any effigy stands
	// DeedHint: Sever twenty omokage papers in Ura, and the hand learns how paper is cut
}

OniMeiRubbingSorahi: {
	// DisplayName: Sora-hi
	// Tooltip: One extra dash off the ground and double regen; the first 0.75s after landing gives nothing back
	// Origin: With no ground underfoot, breath floats. Touch down and it sinks away
	/* Power:
		'''
		Air-Groove: natural regen doubles while both feet are off the ground, and you get one extra dash
		An air dash that runs out leaves you hovering at its endpoint for half a second
		''' */
	// Burden: Natural regen drops to zero for 0.75s after you land, and dashing on the ground costs 10% more vigor
	// DeedHint: Stay airborne for fifteen seconds while still cutting, and the groove learns to float
}

OniMeiRubbingKagamihi: {
	// DisplayName: Kagami-hi
	// Tooltip: A dash endpoint stands a paper mirror that copies your next cut; weapon damage -5%
	// Origin: The cut in the mirror lands half a beat late
	/* Power:
		'''
		Mirror-Echo: the endpoint of a Kamui flash step stands a paper mirror for 2s
		The next time you cut, the figure in the mirror repeats that same cut for 45% of a blade hit, then shatters
		''' */
	// Burden: Weapon damage -5%. The copy swings from wherever the mirror stands, so whether it connects is on you
	// DeedHint: Finish a mimic with a Zanshin strike, and the mirror can write it back
}

OniMeiRubbingAmahi: {
	// DisplayName: Ama-hi
	// Tooltip: Sakura Flight drips ink that pools and binds where it lands; Sakura drain +15%
	// Origin: Petals must soak through before water will stay
	/* Power:
		'''
		Ink-Rain: while cruising in Sakura Flight, a bead of ink drops every 0.1s for 12% of a blade hit
		Beads spread into puddles where they land, and foes that step in are bound for half a second
		''' */
	// Burden: Sakura Flight drain +15%. Carrying rain the whole way costs
	// DeedHint: Fly in the rain for ten straight seconds with petals soaked through
}

OniMeiRubbingTsuzurihi: {
	// DisplayName: Tsuzuri-hi
	// Tooltip: Ink brands from one dash cut lines between each other; a lone brand deals -30%
	// Origin: Marks must string together before they become a line
	// Power: Mark-Stitch: ink brands from the same dash all go off together and cut lines between one another, each line for 35% of a blade hit
	// Burden: A lone ink brand deals -30%. Catch only one foe per dash and this groove is a pure loss
	// DeedHint: Pierce six different foes in one dash, and the marks stitch
}

OniMeiRubbingBonsho: {
	// DisplayName: Bonsho
	// Tooltip: Hold full stance without a Finale and the blade tolls itself; half your stance buys a ring of control
	// Origin: The bell does not wait to be struck. When stance is full, it rings itself
	/* Power:
		'''
		Bell-Toll: hold full stance for 3s without releasing Finale Slash and the blade tolls on its own
		Foes within 30 tiles each take 60% of a blade hit and are bound 1.5s, and your stance drops to 50
		''' */
	// Burden: Once the bell rings, that Finale is gone. Full stance forces you to pick one
	// DeedHint: Win a whole boss fight without a single execution, then knock the bell down
}

OniMeiRubbingHannya: {
	// DisplayName: Hannya
	// Tooltip: Drop low and the mask turns demon: heavier hits and lifesteal; frail while it is out, duller before it turns
	// Origin: When the face turns, it is not the same face anymore
	/* Power:
		'''
		Mask-Shift: below 35% of your own life the mask turns demon, blade damage +20%, and every hit restores 0.5% of your max life
		While the demon face is out, every third hit brings up a mask that bites for 50% of a blade hit
		''' */
	// Burden: Damage taken +15% while the demon face is out. In maiden form, weapon damage -4%
	// DeedHint: Slay a boss while you yourself have only a breath left, and the mask can turn
}

OniMeiRubbingKaresansui: {
	// DisplayName: Karesansui
	// Tooltip: Plant your feet to rake a sand garden that stays put, cutting and feeding stance
	// Origin: The rake pattern stays where you made it. Step in, and the blade follows
	/* Power:
		'''
		Sand-Garden: stand nearly still for 1.5s and a sand field about 20 tiles across is raked at your feet, lasting 5s
		The field cuts every half second for 18% of a blade hit
		While you stand inside your own field, stance gain +30%
		''' */
	// Burden: You have to plant first, and moving clears what you have built up
	// DeedHint: Hold one spot for thirty seconds of combat without taking a hit, and the sand can be raked
}

OniMeiRubbingSenju: {
	// DisplayName: Senju
	// Tooltip: Six ghost arms join the Finale Slash freeze; afterwards vigor zeroes and dashing is locked 3s
	// Origin: One hand, one name. Every boss sent off by Finale must be counted
	// Power: Thousand-Arms: during the Finale Slash freeze, six sword-bearing ghost arms rise behind you and cut with it, each for 30% of a blade hit
	// Burden: After the Finale your vigor drops to zero and you cannot flash step for 3s
	// DeedHint: Send off eight different bosses with Finale, one hand for each name
}

OniMeiRubbingKogehi: {
	// DisplayName: Koge-hi
	Tooltip: Blitzschritte versengen ihren gesamten Weg; Klingenschaden -4%
	// Origin: Do not put your foot in the hot shallows. The groove is for stepping clear
	Power: Brandspur: Ein Spurt hinterlässt bis zu fünf gleichmäßig verteilte Brandstellen für 90 Ticks, deren Treffer je 14 % des Basisklingenschadens verursachen; Brandstellen innerhalb von 32 px werden erneuert
	Burden: Klingenschaden -4 %; gleiche den Verlust durch den beim Bewegen hinterlassenen brennenden Boden aus
}

OniMeiRubbingKanhi: {
	// DisplayName: Kan-hi
	Tooltip: Natürliche Regeneration in Ruhe ×2,25; Spurt- und Sakura-Kosten +8%
	// Origin: Quiet by the door. Let the ears rest
	Power: Ruhiger Atem: Nach 120 Ticks ohne direkten Klingentreffer ist die natürliche Vigor-Regeneration ×2,25
	Burden: Vigor-Kosten für Spurt und Sakura-Flug +8 % — die ruhige Erholung wird in Bewegung zurückgezahlt
}

OniMeiRubbingTodohi: {
	// DisplayName: Todo-hi
	Tooltip: Treffer binden 36 Ticks lang; Spurt-Wiederaufladung +6 Ticks
	// Origin: A bit sticky. Keep contact to turn; break off and it stalls
	Power: Klebebindung: Direkte Klingentreffer binden Ziele 36 Ticks lang und setzen die Bewegungsrate normaler Gegner/Bosse auf 0,88/0,96
	Burden: Spurt-Wiederaufladung +6 Ticks; Bindung und Taubheit verwenden nur die stärkere Bewegungsrate
}

OniMeiRubbingShiorihi: {
	// DisplayName: Shiori-hi
	Tooltip: Tötungen beschneiden ein schwer verletztes Ziel; natürliche Regeneration -10 %, leeres Zanshin kostet Vigor
	// Origin: Cut the spent flower to open the edge, not for looks
	Power: Blütenschnitt: Eine Tötung durch einen direkten Klingentreffer wählt innerhalb von 240 px einen anderen Körper mit höchstens 50 % Leben, verfolgt ihn kurz und schneidet ihn für 25 % des Basisklingenschadens; ohne Ziel beginnt keine Abklingzeit von 45 Ticks
	Burden: Natürliche Vigor-Regeneration -10 %; ein leeres Zanshin kostet 2 Vigor. Beschneidungsklingen können keine Kette auslösen
}

OniMeiRubbingShiohi: {
	// DisplayName: Shio-hi
	Tooltip: Im Gezeitenfenster Vigor oder Zanshin-Schaden; Kombos außerhalb des Takts sind leicht stumpf
	// Origin: Tide marks overnight. Wet contact feeds the return
	Power: Gezeitentakt: In einem Zyklus von 48 Ticks mit einem Halbfenster von 6 Ticks stellt eine Kombo im Takt einmal pro Aktion +3 Vigor wieder her, und Zanshin im Takt verursacht ×1,08 Schaden
	Burden: Kombos außerhalb des Gezeitentakts verursachen ×0,97 Schaden; die Gezeitenphase wird beim Start der Aktion festgehalten
}

OniMeiRubbingShibori: {
	// DisplayName: Shibori
	Tooltip: Durchquerungsparaden oder gebundener Kontakt betäuben; Haltungsgewinn -15%
	// Origin: Guard even with numb hands. The blade hurts too
	Power: Taubheitskonter: Eine Durchquerungsparade betäubt direkt; Kontakt während einer gebundenen Aktion kann 15 Haltung verbrauchen, um den Treffer auf 85 % zu senken und zu betäuben (90 Ticks Abklingzeit). Taubheit hält 45 Ticks an, setzt die Bewegungsrate normaler Gegner/Bosse auf 0,90/0,98 und Kontaktschaden auf ×0,90
	Burden: Haltungsgewinn -15%
}

OniMeiRubbingChinmei: {
	// DisplayName: Chinmei
	Tooltip: Projektilschaden -12 %, Rückstoß -65 %; Haltungsgewinn -15%
	// Origin: When the ears buzz, settle first, then move
	Power: Dämpfung: Feindlicher Projektilschaden ×0,88 und Rückstoß ×0,35
	Burden: Im reinen Nahkampf wirkungslos; Haltungsgewinn -15%
}

OniMeiRubbingAshidome: {
	// DisplayName: Ashidome
	Tooltip: Bleibe 45 Ticks stehen, dann verursacht die nächste gebundene Aktion ×1,25 Schaden
	// Origin: Stand still. Guard lives where the feet stop
	Power: Fester Schritt: Bleibe 45 Ticks bei einem Geschwindigkeitsquadrat von höchstens 2,25; der nächste fünfte Komboschlag, Zanshin, Weltenreißende Blitz oder Finale verursacht ×1,25 Schaden
	Burden: Die Ladung wird beim Start der Aktion verbraucht, selbst bei einem Fehlschlag; Bewegung löscht den Fortschritt
}

OniMeiRubbingYoen: {
	// DisplayName: Yoen
	Tooltip: Hinrichtungen versetzen ein einzelnes Glutfeld; Vigor-Limit -5%
	// Origin: Oven heat still on the edge. Fire out; burn not gone
	Power: Glutfeld: Eine Hinrichtung erzeugt oder versetzt dein einziges Glutfeld; es hält 180 Ticks an und kann demselben Körper alle 45 Ticks 16 % des Basisklingenschadens zufügen
	Burden: Vigor-Limit -5 %; Spurtkosten ×1,10, solange das Feld besteht
}

