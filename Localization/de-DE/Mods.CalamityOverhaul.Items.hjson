NeutronGlaive: {
	DisplayName: Neutronengleve
	Tooltip:
		'''
		Schwingen Sie einen starken Gravitationswellenschwertstoß, der bei Treffer eine Neutronensternexplosion erzeugt
		Halten Sie die rechte Maustaste gedrückt, um das Schwert aufzuladen. Wenn die Ladung vollständig ist und Sie die Maustaste loslassen, wird in der Nähe des Mauszeigers eine große Neutronensternexplosion ausgelöst. Wenn die Ladung nicht vollständig ist, wird die Energie freigesetzt
		'''
}

NeutronBow: {
	DisplayName: Neutronenbogen
	Tooltip:
		'''
		Feuern Sie Gravitationspfeile ab, die bei Treffer Gammastrahlen erzeugen
		Halten Sie die rechte Maustaste für Dreistufenladung gedrückt. Wenn die Energie vollständig aufgeladen ist, werden drei starke Gravitationspfeile abgefeuert
		'''
	// Lang1: Trapping gravity
	// Lang2: Is making gravity yield
	// Lang3: Finished!!
}

NeutronGun: {
	DisplayName: Sternenjäger
	Tooltip:
		'''
		Feuern Sie Gravitationsgeschosse ab, die bei Treffer einen Verzerrungspunkt erzeugen
		Drücken Sie die rechte Maustaste, um in den Scharfschützenmodus zu wechseln und stärkere Gravitationsgeschosse abzufeuern. Die Geschosse erzeugen bei Treffer Gammastrahlen, die herabregnen
		Jeder Schuss lädt die Waffe auf. Wenn die Ladung vollständig ist und erneut geschossen wird, wird an der Mausposition eine Neutronensternexplosion ausgelöst
		"Schießen Sie die Sonne herunter!"
		'''
}

NeutronWand: {
	DisplayName: Sternengraberlicht
	Tooltip:
		'''
		Feuern Sie vier starke Gravitationssterne ab
		Halten Sie die rechte Maustaste gedrückt, um an der Mausposition Gravitationsmagie auszuführen
		"Es wird erzählt, dass ein mächtiger psychischer Begabter in der Antike diesen Stab benutzte, um Sterne zu einem Schwarzen Loch zu komprimieren, aber es gibt keine Bestätigung, nur ein Fragment von einem alten Gedicht, das von den interstellaren Nomaden gesungen wird"
		'''
}

FadingGlory: {
	DisplayName: Verblassende Herrlichkeit
	Tooltip:
		'''
		Bei echten Nahkämpfen heilt es den Spieler, wenn das Ziel ein Organismus ist, oder es löst viele Funken aus, wenn das Ziel anorganisch ist
		Bei nicht echten Nahkämpfen feuert es automatisch Schwertklingen ab, die das Ziel durchdringen und beim Explodieren zusätzliche Seelenfragmente und einen Bluttentakel freisetzen
		'''
}

NeutronScythe: {
	DisplayName: Planetenbote
