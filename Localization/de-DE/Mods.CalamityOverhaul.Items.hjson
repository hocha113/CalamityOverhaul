SeaShrimpTreasureBag: {
	DisplayName: Schatzbeutel (Abgrundkristall-Garnele)
	Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
}

SeaShrimpTestItem: {
	DisplayName: Garnelen-Beobachtungskäfig
	Tooltip: Entwicklungstest: beschwört die Abgrundkristall-Garnele überall
}

BssBloomBud: {
	DisplayName: Dornige Knospe
	Tooltip:
		'''
		An der Wüstenoberfläche benutzen, ruft die Wüstenblüten-Sandschlange
		"Die Wurzel der Düne hungert, wenn sie blüht"
		'''
}

FssFesterBud: {
	DisplayName: Eiterknospe
	Tooltip:
		'''
		An der Wüstenoberfläche benutzen, ruft die Eiterknospen-Sandschlange
		"Die Knospe ist nicht tot. Sie hat gelernt zu eitern"
		'''
}

BudPiercer: {
	DisplayName: Knospenschneide
	Tooltip:
		'''
		Fliegt nach dem Wurf kurz gerade, dann fällt sie
		Trifft sie, pflanzt sie eine Knospe, die kurz darauf einen Blütenkranz öffnet
		Mehrere Dolche können Knospen auf demselben Ziel stapeln
		Im Boden öffnet sie an Ort und Stelle und spritzt drei Wüstennadeln nach oben
		"Unter jeder Schuppe der Sandschlange will eine Blüte sitzen"
		'''
}

Thornstring: {
	DisplayName: Dornensehne
	Tooltip:
		'''
		Wandelt beliebige Pfeile in Dornpfeile
		Beim Treffer spritzen kurze Nadeln zu beiden Seiten
		Rechtsklick halten lädt; voll und los, ein 2,5-fach durchdringender Schwerdornpfeil
		Der schwere Pfeil öffnet bei jedem Treffer und am Aufschlag einen Blütenkranz
		"Die Sehne ist Ranke, der Pfeil ist Dorn, der Bogen eine Blume, die nicht welken will"
		'''
}

BloomCaller: {
	DisplayName: Knospenruf
	Tooltip:
		'''
		Bläst das Horn und ruft Wüstenblüten-Jungknospen an deine Seite
		Die Jungknospen werfen fallende Stacheln
		Jeder zweite Wurf, der dritte ein Rammstoß, danach ein wirbelnder Blütenkranz
		"Der Ton ist kein Befehl. Er ist Gießen"
		'''
}

Budcrown: {
	DisplayName: Knospenkrone
	Tooltip:
		'''
		Angriffstaste halten lässt den Hammerkopf um dich kreisen; loslassen wirft zum Fadenkreuz
		Beim Treffer schüttelt er Wüstennadeln ab
		Nach drei Treffern blüht er auf, sprengt einen Blütenkranz und stößt hart zurück
		"Die schwerste Knospe öffnet sich am lautesten"
		'''
}

BloomTome: {
	DisplayName: Knospenfoliant
	Tooltip:
		'''
		Feuert eine Knospenkugel, die aufblüht
		Trifft sie oder landet sie, öffnet sie einen Blütenkranz
		Jede vierte wird zur Vollblüte: mehr Blätter und zwei Wüstennadeln nach oben
		"Welche Seite du aufschlägst, die blüht"
		'''
}
