		'''
}

EyekiteStaff: {
	DisplayName: Augendrachen
	Tooltip:
		'''
		Beschwört ein kleines Auge von Cthulhu, das an roten und weißen Blutleinen an dir hängt
		Es treibt wie ein Drachen in der Luft, zerrt manchmal fort und wird von der Leine zurückgerissen
		Sind Feinde in der Nähe, stürzt es sich auf sie und wird zum Abschluss hart zurückgezerrt
		Mehrere können zugleich beschworen werden
		'''
}

BloodshotBomb: {
	DisplayName: Weinende Pupillenbombe
	Tooltip:
		'''
		In der Hand zündet die Lunte; drei Stufen, jede etwa zwei Sekunden
		Je kürzer die Lunte, desto röter das Auge, desto heftiger die Explosion, desto mehr Fleisch spritzt
		Linksklick wirft jederzeit; beim Aufschlag explodiert sie, Fleischfetzen nur, wenn sie Fleisch beißt
		Brennt die Lunte herunter und du lässt nicht los, explodiert sie in deiner Hand
		"Sie kann dich nicht gehen lassen"
		'''
	SelfBoom: "{0} hat noch einmal hingesehen"
}

Eyetooth: {
	DisplayName: Weinender Pupillenzahn
	Tooltip:
		'''
		Wirft den vom Auge von Cthulhu gerissenen Hauer auf Feinde
		Nach dem Biss springt der Zahn auf den Scheitel, fokussiert kurz und reißt dann von oben zu
		Der Sturzbiss richtet 150 % Schaden an; die aufgerissene Wunde blutet weiter
		'''
}

Shatterfang: {
	DisplayName: Bruchzahnklinge
	Tooltip:
		'''
		Drei gewöhnliche Schwünge, dann ein Erschütterungshieb, der die Klinge stark abnutzt
		Ist die Klinge leer, zerbricht genau dieser Hieb und schleudert große Zahntrümmer
		Zwischen gewöhnlichen Schwüngen wirft sie kleine, der Schwerkraft folgende Zahnsplitter
		Im Halbklingen-Zustand schwingt sie leichter, richtet aber weniger Schaden an und wirft keine Splitter mehr
		Dauerangriffe machen die Klinge instabil, bis sie lautlos zerspringt
		Rechtsklick flickt die Klinge einen Moment; im Leerlauf heilt sie langsam, bei voller Heilung ein helles Klingeln
		"Ein Hauer, der aus dem Augenmaul brach und noch immer zubeißen will"
		'''
}

CommandersClaw: {
	DisplayName: Kommandeur-Klaue
	Tooltip:
