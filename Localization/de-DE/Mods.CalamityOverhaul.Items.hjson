		"Ans Ohr gehalten, hört man noch das Wasser des Grabens"
		'''
}

DeepcrystalWarhelm: {
	DisplayName: Abgrundkristall-Kriegshelm
	Tooltip:
		'''
		Nahkampfschaden +18 %, kritische Nahkampftreffer +10 %
		Nahkampftempo +18 %
		"Das Gewicht des Panzers ist in die Knochen gewachsen"
		'''
	SetBonus:
		'''
		Nahkampfschaden +18 %, erlittener Schaden +10 %
		Treffer verdichten Kreisblasen; bei 5 Stück stürzen alle ein und lösen am Ziel eine schwere Kavitation aus
		Ein Treffer auf dich zerbricht gesammelte Blasen und stößt nahe Feinde mit Kavitationsrückschlag zurück (Abklingzeit)
		Nass sammelst du schneller, die Detonation trifft härter
		'''
}

DeepcrystalVisor: {
	DisplayName: Abgrundkristall-Visier
	Tooltip:
		'''
		Fernschaden +18 %, kritische Fernkampftreffer +10 %
		30 % Chance, keine Munition zu verbrauchen
		"Durch die Kristallhaut ist der Graben hell wie der Tag"
		'''
	SetBonus:
		'''
		Fernschaden +18 %, erlittener Schaden +10 %
		Treffer verdichten Kreisblasen; bei 5 Stück stürzen alle ein und spritzen eine durchdringende Wassersäule auf das Ziel
		Ein Treffer auf dich zerbricht gesammelte Blasen und stößt nahe Feinde mit Kavitationsrückschlag zurück (Abklingzeit)
		Nass sammelst du schneller, die Detonation trifft härter
		'''
}

DeepcrystalCrown: {
	DisplayName: Abgrundkristall-Zauberkrone
	Tooltip:
		'''
		Magieschaden +18 %, kritische Magietreffer +10 %
		Manakosten -18 %
		"Im Büschel steckt ein Flüstern des Meeres"
		'''
	SetBonus:
		'''
		Magieschaden +18 %, erlittener Schaden +10 %
		Treffer verdichten Kreisblasen; bei 5 Stück stürzen alle ein und schicken drei gelenkte Wasserkugeln auf das Ziel
		Ein Treffer auf dich zerbricht gesammelte Blasen und stößt nahe Feinde mit Kavitationsrückschlag zurück (Abklingzeit)
		Nass sammelst du schneller, die Detonation trifft härter
		'''
}

DeepcrystalFeelers: {
	DisplayName: Abgrundkristall-Fühlerkrone
	Tooltip:
		'''
		Beschwörungsschaden +18 %
		Dienerobergrenze +2
		"Die Fühler wissen die Richtung der Beute vor dir"
