	Tooltip:
		'''
		Erhöht Fernschaden um 5%
		Erhöht kritische Trefferchance auf Distanz um 5%
		Erhöht Fernkampf-Feuerrate um 5%
		Gegner entdecken dich schwerer
		'''
}

HalibutItem: {
	DisplayName: Heilbutt
	Tooltip: ""
}

HalibutPilotChart: {
	DisplayName: Lotsenkarte
	Tooltip:
		'''
		Benutzen, um die Heilbutt-Einführung von vorn zu halten; während der Führung erneut benutzen, um sie wegzulegen
		Bleibt zurück, wenn du die Eröffnung ablehnst; die Karte wird nicht verbraucht und kann immer wieder aufgeschlagen werden
		'''
	NeedFish: Kein Heilbutt im Gepäck, die Karte hat nichts zu lotsen
	HoldFish: Die Karte liegt aufgeschlagen; nimm den Heilbutt in die Hand, dann beginnt die Führung
	Closed: Die Führung ist weggelegt; benutze die Karte erneut, um sie wieder zu öffnen
	NotNow: Gerade liegt etwas anderes an, die Karte lässt sich nicht ausbreiten
}

OnikiriItem: {
	DisplayName: Onikiri
	Tooltip: ""
}

KikasaItem: {
	DisplayName: Kikasa
	Tooltip: ""
}

KikasaTalismanLin: {
	DisplayName: Nieseltalisman
	Tooltip: Tintenregen-Takt wird schneller, ununterbrochener Regen wird immer dichter; jeder Tropfen etwas leichter
	Origin: Der alte Talismanmeister sagte: Um Regen zu erbitten, muss man den Drachenkönig nicht bemühen, ein Nieseltalisman reicht. Kleinere Tropfen sind egal, Hauptsache, er hört nicht auf
	Power: »Nieselregen« Tintenregen-Takt +20 %, Tropfen folgen dicht aufeinander; etwa zehn Sekunden ununterbrochener Regen bilden »Landregen«: unter dem Schirm hängt ein Nieselschleier, der Takt beschleunigt noch einmal um 10 %; hörst du auf, löst sich der Aufbau, holst du den Schirm ein, fällt er sofort auf die Hälfte
	Burden: Einzeltropfenschaden -6 %
}

KikasaTalismanLao: {
	DisplayName: Tintenlachen-Talisman
	Tooltip: Tintentropfen bilden beim Landen immer eine Tintenlache; die Lache trinkt den Regen, steigt und läuft über; Direkttreffer etwas leichter
	Origin: Dem Talismanmeister war es zuwider, dass Regen im Moment des Aufschlags schon trocknet und eine ganze Tintenflut umsonst war. Also zeichnete er diesen Talisman, damit der Regen länger auf dem Boden bleibt. Jeder Augenblick extra zählt
	Power: »Lachenbildung« Tintentropfen bilden beim Landen immer eine Tintenlache (vierte Stufe ›See kippen‹ nicht nötig), Lachen halten +50 % länger und greifen +30 % weiter aus; Tropfen, die in eine bestehende Lache fallen, heben den Pegel, die dritte füllt sie zum Überlaufen: die Fläche weitet sich einen Schritt und schlägt Überlaufwellen nach beiden Seiten (je 50 % Lachenschaden)
	Burden: Direktschaden der Tropfen -5 %
}

KikasaTalismanPei: {
	DisplayName: Platzregen-Talisman
	Tooltip: Umgedrehtes Aufladen geht schneller; ist die Schale voll, kippt sie wie ein geöffnetes Wehr; gewöhnlicher Regen etwas langsamer
	Origin: Beim Bitten um Regen ist halbherziges Nieseln das Schlimmste. Dieser Talisman erfüllt nur eine Bitte: wenn es regnet, dann in Strömen
	Power: »Platzregen« Tempo des umgedrehten Aufladens +35 %, Tintenquell-Schaden +20 %; bei voller Ladung perlen Tropfen am Schalenrand und es summt leise, und genau dann zu gießen öffnet das Wehr: am Ursprung des Falls explodiert ein Stoß (80 % Fallschaden) und der Tintenfall wird breiter
	Burden: Tintenregen-Takt 8 % langsamer
}

KikasaTalismanSha: {
	DisplayName: Eilregen-Talisman
	Tooltip: Der Schirm steigt fast sofort; der erste Takt wirft drei schnelle Tropfen hintereinander; der Takt danach hinkt etwas
	Origin: Der Talismanmeister traf nachts auf der Straße Räuber: Schirm auf, Regen nieder, Schirm weg, alles in einem Lidschlag. Danach schrieb er dieses eine Wort »schnell« in einen Talisman
	Power: »Eilregen« Aufsteigzeit des Schirms -75 %; der erste Takt wirft immer drei schnelle Tropfen (je 75 % Schaden)
	Burden: Nach der Dreierfolge Intervall des nächsten Takts +40 %
}

KikasaTalismanYin: {
	DisplayName: Tintenblüten-Talisman
	Tooltip: Tropfentreffer stapeln Tintenspuren; bei fünf Stapeln blühen sie zu einem Ausbruch auf; Direkttreffer etwas leichter
	Origin: Ein Tintentropfen auf nassem Papier, den man nicht wischt, blüht von selbst zur Blüte. Der Talismanmeister sagte, Feinde seien dasselbe: ein paar Tropfen mehr, und sie blühen
	Power: »Tintenblüte« Tintentropfen hinterlassen bei Treffern Spuren (höchstens fünf Stapel, jeder zapft Leben); bei fünf Stapeln blüht die Tinte auf, richtet 160 % Tropfenschaden an und löscht die Stapel
	Burden: Direktschaden der Tropfen -8 %
}

KikasaTalismanLu: {
	DisplayName: Süßtau-Talisman
	Tooltip: Tropfentreffer verdichten manchmal Tautropfen; aufheben stellt Leben wieder her; Regentakt etwas langsamer
	Origin: In den Schriften fällt Süßtau vom Himmel und wehrt jede Krankheit ab. Der Talismanmeister hat dieses Wunder nie erbeten bekommen und nahm das Nächstbeste: in jedem Tropfen ein wenig Süße ansammeln
	Power: »Süßtau« Tintentropfen verdichten bei Treffer mit 12 % Chance einen Tautropfen; aufheben stellt 2 Leben wieder her; höchstens drei auf dem Feld
	Burden: Tintenregen-Takt 6 % langsamer
}

KikasaTalismanFei: {
	DisplayName: Nebelbinde-Talisman
	Tooltip: Jeder dritte Tropfen wird zum Nebeltropfen und hinterlässt am Aufschlag verlangsamenden, ätzenden Tintennebel; der Nebeltropfen selbst ist leichter
	Origin: Bergregen wird oft auf halber Strecke zu Nebel, der sich an einen klammert und nicht loslässt. Der Talismanmeister fand dieses Klammern hartnäckiger als jeden Tropfen, packte es in den Talisman und ließ es für sich arbeiten
	Power: »Nebelbinde« jeder dritte Tintentropfen wird zum Nebeltropfen: am Treffer bleibt zwei Sekunden Tintennebel, Feinde darin nehmen Dauerschaden und verlieren 10 % Tempo
	Burden: Schaden des Nebeltropfens -30 %
}

KikasaTalismanXian: {
	DisplayName: Spritzperlen-Talisman
	Tooltip: Große Tropfen zerspringen beim Landen in fünf hüpfende Tintenperlen; Tintenlachen etwas kleiner
	Origin: Starkregen auf Steinplatten schleudert Perlen hüfthoch und durchnässt einen komplett. Der Talismanmeister schrieb diesen Sprung in den Talisman und brachte den Perlen das Beißen bei
	Power: »Spritzperlen« große Tropfen zerspringen beim Landen in fünf Tintenperlen (je 30 % Schaden), jede kann noch zweimal hüpfen
	Burden: Lachenradius -15 %
}

KikasaTalismanXi: {
	DisplayName: Gezeitentalisman
	Tooltip: Tintenlachen atmen mit der Tide und wogen von selbst auf nahe Feinde zu; Lachenleben etwas kürzer
	Origin: Der Talismanmeister lebte drei Jahre am Meer und lernte genau eine Sache: Wasser wartet nicht, bis jemand hineintritt. Es kommt von selbst
	Power: »Gezeiten« Tintenlachen gewinnen Tide: sie schwellen und ebben, und frische Tinte, die in eine Lache fällt, schickt sie auf den nächsten Feind zu; der Wellenrand richtet 50 % Lachenschaden an
	Burden: Lachenleben -20 %
}

KikasaTalismanZi: {
	DisplayName: Tränk-Talisman
	Tooltip: Feinde, die in Tintenlachen stehen, sammeln Tränkschichten und nehmen tieferen Tintenschaden; die Lache selbst ist leichter
	Origin: Stoff muss drei volle Tage in der Küpe liegen, bevor die Farbe greift. Der Talismanmeister hat selbst gefärbt und weiß besser als jeder, was »einweichen« vermag
	Power: »Tränkung« Feinde in einer Tintenlache sammeln ununterbrochen Tränkschichten (höchstens acht); jede Schicht erhöht den Tintenschaden, den sie nehmen, um 2,5 %
	Burden: Lachenschaden -25 %
}

KikasaTalismanTing: {
	DisplayName: Donnerquell-Talisman
	Tooltip: Tintenquellen werden zu Donnersäulen und ketten Blitze an nahe Feinde; Tintenfälle wecken beim Aufschlag manchmal einen kleinen Donnerquell; Aufladen etwas langsamer
	Origin: Ein See in der Gewitternacht ist das Fürchterlichste. Der Blitz schlägt ins Wasser, und der ganze See leuchtet mit. Der Talismanmeister zeichnete genau dieses Bild
	Power: »Donnerquell« Quellsäulen +50 % höher, Treffer ketten Blitze an bis zu zwei nahe Feinde (je 50 % Quellschaden); selbst ein nicht voll aufgeladener Tintenfall weckt beim Aufschlag mit 25 % Chance einen kleinen Donnerquell
	Burden: Tempo des umgedrehten Aufladens -13 %
}

KikasaTalismanHong: {
	DisplayName: Regenbogenbrücken-Talisman
	Tooltip: Nach dem Tintenfall spannt sich eine Regenbogenbrücke: Segen darunter, Brand auf der Spanne; der Fall etwas schmaler
	Origin: Ein Regenbogen nach dem Regen ist ein gutes Zeichen. Der Talismanmeister zeichnete das Zeichen einfach in den Talisman: hört der Regen auf, steht die Brücke, und wer darunter steht, teilt das Glück
	Power: »Regenbogenbrücke« nach dem Tintenfall spannt sich fünf Sekunden eine Brücke über dem Aufschlag: darunter Bewegungstempo +10 %, Beschwörungsschaden +10 %; Feinde, die die Spanne kreuzen, nehmen alle halbe Sekunde 40 % Fallschaden
	Burden: Fallbreite -10 %
}

KikasaTalismanHang: {
	DisplayName: Nachtmiasma-Talisman
	Tooltip: Nachts steigt der Tintenschaden, Tintenlachen dampfen Miasmasäulen; bei Tag etwas schwächer
	Origin: Der alte Spruch heißt: nächtlichen Dunst nicht anrühren. Der Talismanmeister füllte trotzdem eine Flasche, und der Spruch stimmte. Dann sollen eben die Feinde ihn anrühren
	Power: »Nachtmiasma« nachts Tintenschaden +15 %, Tintenlachen dampfen ununterbrochen Miasmasäulen (alle halbe Sekunde 30 % Tropfenschaden)
	Burden: Bei Tag Tintenschaden -5 %
}

KikasaTalismanBao: {
	DisplayName: Hageltalisman
	Tooltip: Jeder vierte Takt wird ganz zu Riesenhagel: rüstungsbrechende Schläge, keine Lachen; gewöhnliche Takte etwas leichter
	Origin: Hagel ist das jähzornige Temperament des Regens, zerschlägt Ziegel und Becken, und niemand hält ihn auf. Der Talismanmeister wollte ihn nicht zähmen; er handelte nur: alle vier Takte gehört ihm einer
	Power: »Hagel« jeder vierte Takt ist eine volle Salve, alle Tropfen werden zu Riesenhagel: Größe x1,6, Schaden x2,2, Treffer brechen Rüstung und stoßen hart zurück; Riesenhagel hinterlässt keine Tintenlachen
	Burden: Tropfenschaden gewöhnlicher Takte -8 %
}

KikasaTalismanShu: {
	DisplayName: Rettungsregen-Talisman
	Tooltip: Drei Sekunden nach einem Treffer verdichtet sich der Regen und jeder Tropfen heilt; gewöhnlicher Takt etwas langsamer
	Origin: In den Geschichten heißt, wer genau dann kommt, wenn Hilfe braucht, »Rettungsregen«. Dieser Talisman folgt derselben Regel: sobald der Schirmherr einen Schlag abbekommt, muss der Regen sofort da sein
	Power: »Rettungsregen« drei Sekunden nach einem Treffer halbieren sich die Taktabstände, der Regen wird gold, und jeder Treffertropfen stellt 1 Leben wieder her; zwölf Sekunden Abklingzeit
	Burden: Gewöhnlicher Taktabstand +5 %
}

KikasaTalismanLong: {
	DisplayName: Sturzflut-Talisman
	Tooltip: Der Tintenfall wird zum Sturzbach und schiebt Feinde mit der Strömung; der Fall hält kürzer
	Origin: Kommt die Sturzflut den Berg herab, behält niemand den Stand. Der Talismanmeister sah das einmal vom Fels und schrieb daheim nur das eine Wort »stürzen« in den Talisman
	Power: »Sturzflut« der Tintenfall wird zum Sturzbach: der Körper schiebt Feinde auf der Falllinie mit der Strömung, Direkttreffer des Falls stoßen +35 % stärker zurück
	Burden: Falldauer -20 %
}

KikasaTalismanShuang: {
	DisplayName: Frostspiegel-Talisman
	Tooltip: Tintenlachen gefrieren zu Frostspiegeln: Betreten verlangsamt, Tropfen zerschlagen den Spiegel zum Ausbruch; Lachen lassen sich nicht erneuern
	Origin: Nach dem Reiffall gefriert das Lachenwasser über Nacht zu dünnem Eis, sieht aus wie ein Spiegel, bis man hineintritt. Was der Talismanmeister sammelte, war genau diese Schicht »sieht harmlos aus«
	Power: »Frostspiegel« große Tropfen gefrieren beim Landen von selbst zur Frostlache (vierte Stufe ›See kippen‹ nicht nötig); die Lache wird zum Spiegel: sie ätzt nicht mehr, Betreten verlangsamt um 40 %; trifft ein Tintentropfen die Fläche, zerspringt der Spiegel sofort, der Ausbruch richtet Schaden nach verbleibender Spiegellebenszeit an und stellt Eiszapfen auf
	Burden: Jeder Spiegel steht für sich; Tintenlachen können nicht verschmelzen, um die Lebenszeit zu erneuern
}

KikasaTalismanZha: {
	DisplayName: Regentrommel-Talisman
	Tooltip: Sieben Takte hintereinander treffen, dann schlägt der achte mit dreifachem Tropfenschaden; danach setzt der Regen einen Takt aus
	Origin: Tropfen auf dem Schirm sind schon eine Trommel. Der Talismanmeister hörte den Trick: kein Takt darf fehlen, dann klingt der achte am lautesten
	Power: »Regentrommel« über der Krone hängt ein Sieben-Punkt-Trommelring: trifft mindestens ein Tropfen in jedem von sieben Takten, schlägt der achte mit allen Tropfen x3, wie ein Trommelschlag; fehlt ein Takt, zählt es von vorn
	Burden: Nach dem schweren Schlag setzt der Regen einen Takt aus
}

KikasaTalismanNi: {
	DisplayName: Dreifarb-Talisman
	Tooltip: Tropfen färben reihum drei Farben: Rot explodiert, Cyan verlangsamt, Violett vertieft Wunden; Tropfenschaden etwas geringer
	Origin: »Tinte hat fünf Farben«, heißt es im Handwerk. Der Talismanmeister konnte sich nur drei leisten. Gut, dass Rot sprengt, Cyan klammert und Violett ätzt; das reicht
	Power: »Dreifarb« Tintentropfen färben der Reihe nach drei Farben: rote Tropfen explodieren beim Treffer (40 % Flächenschaden), cyanfarbene verlangsamen Feinde um 15 %, violette erhöhen den Tintenschaden, den sie nehmen, um 5 %
	Burden: Tropfenschaden -5 %
}

KikasaTalismanWen: {
	DisplayName: Wolkenschrift-Talisman
	Tooltip: Drei Schriftsterne am Schirmrand laden sich bei Treffern; ist einer voll, wirft er sich als verfolgende Tintenbolzen; Regentakt etwas langsamer
	Origin: Wolkenschrift ist die Schrift, die der Dao auf Wolken setzt; keine sterbliche Hand kopiert sie. Der Talismanmeister kopierte, was er konnte: die Zeichen kamen schief, aber sie lernten fliegen
	Power: »Wolkenschrift« drei Wolkenschrift-Sterne kreisen am Schirmrand und laden sich mit jedem Tropfentreffer; ist die Ladung voll, wirft sich der diensthabende Stern als verfolgende Tintenbolzen (120 % Tropfenschaden)
	Burden: Taktabstand +8 %
}

KikasaTalismanPo: {
	DisplayName: Mondseelen-Talisman
	Tooltip: Nachttreffer füllen einen Tintenmond; bei Vollmond wird der nächste Tintenfall zum Mondfall; bei Tag wirkungslos
	Origin: Nachts beim Üben merkte der Talismanmeister einen kleinen Mond über dem Schirm: je mehr er traf, desto runder wurde er. Bis zum Fünfzehnten nähren, und er gießt einen großen Fall
	Power: »Mondseele« nachts hängt ein Tintenmond über dem Schirm und wird mit jedem Treffer voller; bei Vollmond wird der nächste Tintenfall zum Mondfall: Breite x1,5, seine Schläge hinterlassen Mondspur-Ausbrüche (35 % Flächenschaden)
	Burden: Dieser Talisman wirkt bei Tag nicht
}

KikasaTalismanXiao: {
	DisplayName: Neunhimmel-Talisman
	Tooltip: Der Schirm steigt hoch; Tropfen stürzen schneller und härter; Regentakt etwas langsamer
	Origin: Derselbe Tropfen macht vom Dachrand einen Spritzer und vom neunten Himmel einen Krater. Die Rechnung des Talismanmeisters war genau so schlicht
	Power: »Neun Himmel« Schwebhöhe des Schirms verdoppelt, Tropfen stürzen aus der Höhe: Endgeschwindigkeit +40 %, Schaden +25 %, am Aufschlag taucht zuerst ein Regenschattenring auf
	Burden: Taktabstand +10 %
}

KikasaTalismanMei: {
	DisplayName: Schimmelregen-Talisman
	Tooltip: Tropfentreffer stapeln Schimmelfraß; Schimmelfeinde platzen im Tod zu ansteckenden Sporen; Direkttreffer etwas leichter
	Origin: Vierzig Tage Pflaumenregen, und im Talismankasten wuchs Schimmel. Der Talismanmeister konnte sich nicht überwinden, ihn abzuwischen. Auch das hat der Regen großgezogen, also zählt es als Familie
	Power: »Schimmelregen« Tintentropfen hängen bei Treffer »Schimmelfraß« an (höchstens zehn Stapel, jeder zapft Leben); stirbt ein Schimmelfeind, sprüht er Sporennebel, gibt die Hälfte der Stapel an nahe Feinde weiter und richtet kleinen Schaden an
	Burden: Direktschaden der Tropfen -10 %
}

KikasaTalismanPi: {
	DisplayName: Himmelsdonner-Talisman
	Tooltip: Zehn Sekunden nach einem gegossenen Tintenfall rufen Tropfentreffer manchmal einen Blitz gerade herab; Tintenquellen etwas leichter
	Origin: Die Fünf-Donner-Methode des Dao lehrt »mit dem Regen den Blitz ziehen«. Der Talismanmeister beherrschte nur die zweite Hälfte. Zum Glück hat er Regen im Überfluss
	Power: »Himmelsdonner« nach jedem gegossenen Tintenfall öffnet sich ein zehnsekündiges Fenster: darin rufen Tropfentreffer mit 20 % Chance einen Blitz gerade auf den Trefferpunkt (180 % Schaden, durch die ganze Blitzbahn)
	Burden: Quellschaden -20 %
}

KikasaTalismanXia: {
	DisplayName: Glutdämmer-Talisman
	Tooltip: In der Dämmerung steigt der Tintenschaden stark, Tropfen zünden Glutflamme; mittags und tief in der Nacht etwas schwächer
	Origin: Abendrot ist Regen, der am Himmelrand brennt. Der Talismanmeister schöpfte eine Handvoll vor Sonnenaufgang; das Papier briet sich gelb, der Talisman aber war fertig
	Power: »Glutdämmer« je eineinhalb Doppelstunden um Sonnenaufgang und Sonnenuntergang: Tintenschaden +18 %, Tropfentreffer zünden kurz »Glutflamme«; in der Dämmerung färbt sich das ganze Regenzeug orange-gold
	Burden: Mittags und tief in der Nacht Tintenschaden -6 %
}

KikasaTalismanJi: {
	DisplayName: Aufklar-Talisman
	Tooltip: Treffer bei aufgespanntem Schirm sammeln Klarheit; holst du ihn ein, kracht am Fadenkreuz ein Himmelsstrahl nieder; solange der Schirm oben ist, etwas weniger Schaden
	Origin: Im Augenblick, in dem Regen dem Klaren weicht, fällt durch die Wolkennaht eine Lichtsäule. Der Talismanmeister hockte einen halben Monat und rieb sie ab, bevor die Wolken sich schlossen
	Power: »Aufklaren« Treffer bei aufgespanntem Schirm sammeln Klarheit; im Moment des Einholens reißt eine Wolkenlücke, und am Fadenkreuz kracht ein Himmelsstrahl nieder; der Schaden richtet sich nach dem Gesammelten, am vollsten am heftigsten
	Burden: Solange der Schirm oben ist, Tintenschaden -8 %
}

KikasaTalismanYu: {
	DisplayName: Regentanz-Talisman
	Tooltip: Treffer sammeln Ritualzahl; ist sie voll, öffnet sich der Altar: dichter Regen, härtere Tropfen, Lachen und Quellen voll auf, zum Schluss drei Quellen zugleich; außerhalb des großen Ritus etwas stumpfer
	Origin: Die Alten baten um Regen, bauten einen Altar, tanzten und sangen alle acht Klänge; das Ritual hieß »Regentanz«. Der Talismanmeister faltete das ganze Fest in einen Talisman: der Schirm ist der Schamane, der Regen die Antwort
	Power: »Großer Yu« Tintenregentreffer sammeln Ritualzahl; ist sie voll, öffnet sich von selbst zehn Sekunden der »Große Yu«: Taktabstände halbiert, Tropfen in Regenbogentinte bei +15 % Schaden, alle bilden Lachen, Tintenquellen voll auf; schließt das Ritual, brechen unter dem Schirm drei Quellen zugleich aus
	Burden: Außerhalb des Großen Yu Tintenschaden -10 %
}

SHPCItem: {
	DisplayName: SHPC
	Tooltip: ""
}

AvalancheM60: {
	DisplayName: Lawine M60
	Tooltip:
		'''
		Verwendet Schneebälle als Munition
		Feuert eine große Menge Schneebälle ab; die Feuerkraft steigt mit abnehmender Munition
		Alle 20 Schüsse löst eine Überlastexplosion aus, die eine kleine Lawine erzeugt
		"Denji, lass uns eine Schneeballschlacht machen"
		'''
}

CrystalDimming: {
	DisplayName: Eiszeit
	Tooltip:
		'''
		Verwendet Schneebälle als Munition
		Feuert Kristallgeschosse ab, die am Einschlagpunkt Gletschersäulen aus dem Boden emporsteigen lassen
		Säulen wachsen höher, wenn sie in der Nähe bestehender Kristallcluster auftauchen
		Rechtsklick entfesselt eine Gletscherwelle, die entlang des Geländes einen stetig wachsenden Eisgrat auftürmt
		"Die Erde erinnert sich an jeden Frost"
		'''
}

DarkFrostSolstice: {
	DisplayName: Dunkelfrostflut
	Tooltip:
		'''
		Verwendet Schneebälle als Munition
		Feuert Hagel und Polarflammen ab
		Angriffe können Gegner einfrieren
		Alle 20 Schüsse löst eine Überlastexplosion aus und erzeugt am Cursor eine gewaltige Eissäule
		'''
}

SnowQuay: {
	DisplayName: Schneequay M16
	Tooltip:
		'''
		Verwendet Schneebälle als Munition
		Linksklick gedrückt halten, um einen dichten Schneestrom auf Feinde zu blasen
		Beim Blasen sammelt sich Druck in der Verdichtungskammer
		Linksklick loslassen mit genügend Druck, um eine verdichtete Schneekugel abzufeuern
		"Der Winterspaß beginnt mit einem Schneepustgerät"
		'''
}

NeutronGlaive: {
	DisplayName: Neutronengleve
	Tooltip:
		'''
		Schwinge einen starken Gravitationswellenschwertstoß, der bei Treffer eine Neutronensternexplosion erzeugt
		Halte die rechte Maustaste gedrückt, um das Schwert aufzuladen; bei voller Ladung und Loslassen entsteht am Cursor eine große Neutronensternexplosion, sonst wird die gespeicherte Energie freigesetzt
		'''
}

NeutronBow: {
	DisplayName: Neutronenbogen
	Tooltip:
		'''
		Feuere Gravitationspfeile ab, die bei Treffer Gammastrahlen erzeugen
		Halte die rechte Maustaste für Dreistufenladung gedrückt. Wenn die Energie vollständig aufgeladen ist, werden drei starke Gravitationspfeile abgefeuert
		'''
	Lang1: Fängt Schwerkraft ein
	Lang2: Zwingt Schwerkraft in die Knie
	Lang3: Bereit!!
}

NeutronGun: {
	DisplayName: Sternenjäger
	Tooltip:
		'''
		Feuere Gravitationsgeschosse ab, die bei Treffer einen Verzerrungspunkt erzeugen
		Drücke die rechte Maustaste, um in den Scharfschützenmodus zu wechseln und stärkere Gravitationsgeschosse abzufeuern. Die Geschosse erzeugen bei Treffer Gammastrahlen, die herabregnen
		Jeder Schuss lädt die Waffe auf. Wenn die Ladung vollständig ist und erneut geschossen wird, wird an der Mausposition eine Neutronensternexplosion ausgelöst
		"Schieße die Sonne herunter!"
		'''
}

NeutronWand: {
	DisplayName: Sternengraberlicht
	Tooltip:
		'''
		Feuere vier starke Gravitationssterne ab
		Halte die rechte Maustaste gedrückt, um an der Mausposition Gravitationsmagie auszuführen
		"Es wird erzählt, dass ein mächtiger psychischer Begabter in der Antike diesen Stab benutzte, um Sterne zu einem Schwarzen Loch zu komprimieren, aber es gibt keine Bestätigung, nur ein Fragment von einem alten Gedicht, das von den interstellaren Nomaden gesungen wird"
		'''
}

NeutronScythe: {
	DisplayName: Schwarzloch-Bote
	Tooltip:
		'''
		Eine mit hoher Geschwindigkeit rotierende Neutronensense, die Gammastrahlen auf nahe Feinde abfeuert und entlang ihrer Flugbahn Verzerrungs-Detonationspunkte hinterlässt
		Rechtsklick: Entfesselt einen Schwarzlochausbruch, der dreizehn Sensen in einem vollen Kreis ausschleudert
		'''
}

RebelBlade: {
	DisplayName: Rebellionsschwert
	Tooltip:
		'''
		Bei echtem Nahkampf erzeugt es eine Vielzahl von Dämonenlichtkugeln um das Ziel
		Rechtsklick steuert den Schwertflug und führt einen Schnitt zum Cursor hin aus
		'''
}

MG42: {
	DisplayName: MG42
	Tooltip:
		'''
		Dauerfeuer überhitzt das Maschinengewehr
		Verwandelt Gewehrkugeln in Panzerungsdurchschlagsgeschosse
		'''
}

DragonsWord: {
	DisplayName: Drachensprache
	Tooltip:
		'''
		Schieße Drachen Tränen ab, die nach einer Weile der Drehung den Feind verfolgen.
		Rechtsklick, um Drachenbefehl Magie am Cursor auszuführen und den Feinden im Bereich den Todesbefehl zu erteilen.
		"Ein Drache kann nur einmal im Leben weinen."
		'''
}

SnowQuayMK2: {
	DisplayName: Schneequay MK2
	Tooltip:
		'''
		Verwendet Schneebälle als Munition
		Eine militärische Umrüstung mit Kryo-Kompressor, der Schneebälle in hochgeschwindige Eiszapfen presst
		Linksklick feuert Drei-Schuss-Bursts; die letzte Kugel ist ein schwerer Zapfen, der beim Treffer in Kristalle zerspringt
		Rechtsklick entlädt einen Überdruck-Streuschuss kurzreichweitiger Eiszapfen
		„Die Schneequay der zweiten Generation braucht kein Vorheizen mehr“
		'''
}

JusticeUnveiled: {
	DisplayName: Offenbarung der Gerechtigkeit
	Tooltip:
		'''
		Fernkampftreffer sammeln „Gerechtigkeitsschlag“-Ladungen, maximal fünf
		[UP] drücken verbraucht eine Ladung und ruft einen gewaltigen heiligen Einschlag herab
		„Wenn Gerechtigkeit gerufen wird, folge ich – wohin auch immer sie führt“
		'''
}

WeaverGrievances: {
	DisplayName: Gewebe der Groll
	RitualInteractHint: "[Rechtsklick] Dieses Schwert herausziehen"
	RitualInventoryFullHint: Inventar voll; mach einen Platz frei, bevor du das Schwert ziehst
	Tooltip:
		'''
		Entfesselt zahlreiche Klauen der Grollgeister mit Spezialeffekten in Unterwelt und Kerker
		Rechtsklick rollt zum Cursor; Treffer während des Rollens gewähren Unverwundbarkeitsframes
		Kurzer Rollen als perfektes Ausweichen
		[legend]
		'''
	Legend:
		'''
		Seit jeher erstreckt sich der Kerker über das Land, seine Wände bedeckt mit Inschriften und Schreien alter Krieger. Jeder Stein tränkt stillstehenden Groll, wie Ketten der Toten, gefesselt an die endlose Nacht am Ende der Zeit.
		Diese Krieger waren einst die Klingen ihres Königs und zogen in alle Welt. Ihr Schwertlicht erhellte Schlachtfelder, ihr Blut errichtete Terras Türme. Ihre Treue war sternenhaft, ihr Glaube eisern.
		Doch als die Kriege endeten und die Banner des Dämonfürsten vor dem König zerrissen wurden, befahl der König in dem Moment des Friedens, sie in die dunkle Tiefe zu werfen.
		„Wir haben nicht verraten, doch der König hat uns verraten!“ Die Klage der Verdammten riss die Stille der Ewigkeit.
		Ihre edlen Geister kehrten nicht zur Erde zurück, sondern wurden Zeugen der ewigen Nacht in der Leere.
		Das unaufhörliche Wehklagen wurde zum stillen Vorwurf bis ans Ende der Sterne.
		Man sagt, der König fürchtete ihre Treue und ihren Zorn und folgte den Flüstern der Dämonfürsten-Sorcerer, sie zur Schatten der Geschichte zu machen.
		Doch der Groll wie eine Flut verzerrte die Realität des Kerkers. Ihr Leid erschütterte die Schranken der Zeit und webte eine Racheprophezeiung:
		„Der Dämonfürst wird zurückkehren, die Leere wird zerreißen, unsere Flammen werden alles verzehren!“
		Wenn Terra erneut dem Untergang nahe, werden diese Untoten aus der Finsternis erstehen. Ihre Klingen kämpfen nicht mehr für Terras Ruhm, sondern zum Urteil des Verräters.
		Ruhm und Treue sind längst vernichtet – nur die Flammen der Rache bleiben.
		'''
}

Starship: {
	DisplayName: Sternenriese
	Tooltip:
		'''
		Dauerfeuer baut Hitze auf, Feuerrate steigt mit der Hitze
		Rechtsklick lädt Kometengeschoss, nächster Schuss mit massivem Schaden und Hyper-Zersetzung
		Bei Spitzenhitze begleiten zwei Flügeljäger mit zielsuchenden Sternbolzen; periodisch Planetensalven von hinten
		Loslassen des Abzugs: Finale – 14 verteidigungsignorierende Meteore und Miniaturgalaxie am Cursor
		'''
}

SandDagger: {
	DisplayName: Sandklinge
	Tooltip:
		'''
		Wird in gerader Linie geschleudert und durch Schwerkraft leicht abgelenkt
		Bohrt sich beim Aufprall ein; trifft sie auf Sand, lädt sie sich auf und schießt dann nach oben, um eine Erdbebenwelle und Sandstacheln freizusetzen
		'''
}

UnderTheSand: {
	DisplayName: Unter dem Sand
	Tooltip:
		'''
		Schleudert ein Paar Sandwogen, die unter Schwerkraft fallen
		Beim Aufprall schießt ein vertikaler Sandspeer aus dem Boden und schleudert Gegner empor
		'''
}

WastelandFang: {
	DisplayName: Ödlandzahn
	Tooltip:
		'''
		Prallt von Blöcken ab und beschleunigt beim Einholen
		Sperrt den Mund auf und spuckt mehrere Sandkugeln
		'''
}

MelodyTheSand: {
	DisplayName: Lied des Sandes
	Tooltip:
		'''
		Feuert einen kleinen Sandwirbel, der unter Schwerkraft zur Erde fällt
		Am Boden patrouilliert er hin und her, wendet an Wänden und Abstürzen um
		Schleudert getroffene Gegner wiederholt in die Höhe
		'''
}

SandVortexOfTheDecayedSea: {
	DisplayName: Sandwirbel des Verfallenen Meeres
	Tooltip:
		'''
		Beschwört am Cursor einen gewaltigen verfallenen Meereswirbel
		Der Wirbel saugt Gegner an und zerreißt sie, stört feindliche Projektile
		Wirft periodisch zielsuchende verfallene Meereskugeln aus
		Erneuter Klick erneuert den Wirbel; beim Verblassen ein Ring aus Meereskugeln
		„Das Brüllen der faulenden Tiefe, in Sand gewälzt“
		'''
}

DuneStalker: {
	DisplayName: Dünenjäger
	Tooltip:
		'''
		Feuert einen kettengebundenen Haken statt der Munition selbst
		Der Haken zerreißt Gegner auf seinem Weg und kehrt nach Treffer oder Reichweitenende automatisch zurück
		'''
}

SeasonalKunai: {
	DisplayName: Jahreszeiten-Kunai
	Tooltip:
		'''
		Wirft vier Hauptkunai in einem Fächer; jede durchbohrt mehrere Gegner und wächst während des Fluges
		Bei Treffer oder Ablauf der Lebenszeit zerbricht jede Klinge in drei sekundäre Kunai, die auseinanderfegen
		Tagsüber Tagesanbruch, nachts Nachtwelken
		"Spiegel der vier Jahreszeiten"
		'''
}

WraithKunai: {
	DisplayName: Geisterkunai
	Tooltip:
		'''
		Schleudert drei karmesinrote Klingen in einem Fächer; jede schwebt kurz, bevor sie mit hoher Geschwindigkeit auf den nächsten Gegner zustürmt
		Sturmtreffer entfesseln karmesinrote Funken und Bildschirmbeben, am Ende ihres Fluges detonieren die Klingen in seelenbrennenden Schockwellen
		Tagsüber Brand, nachts Seelenbrand
		'''
}

CalSelfPortrait: {
	DisplayName: Vergessenes Foto
	Tooltip:
		'''
		Ein vergessenes Foto
		[legend]
		'''
	Legend: Was willst du denn noch sehen? :)
}

WUTIVSelfPortrait: {
	DisplayName: Danke, Wuti
	Tooltip: ""
}

HandmadeDoll: {
	DisplayName: Handgenähte Puppe
	Tooltip:
		'''
		In der Unterwelt benutzen, um die Fleischwand zu beschwören
		Lebt der Führer, wird er beim Benutzen geopfert
		„Handarbeit – der Führer weiß nichts davon“
		'''
}

ScapegoatDoll: {
	DisplayName: Sündenbockpuppe
	Tooltip:
		'''
		Im Inventar fängt sie einmal den Tod für dich ab
		Danach zerbricht die Puppe und ist weg
		'''
	ShatterText: Die Sündenbockpuppe ist zerbrochen
}

Snowblindness: {
	DisplayName: Schneeblindheit
	Tooltip:
		'''
		Hochfrequentes Abschießen von Schneebällen und eisigen Strahlen
		Erzeugt nach dem Treffen mit Feinden mehrere EX-eisige Strahlen um sich herum
		"Verloren im Schneesturm, ewiges Warten, Schmerzen auf der Karte, Überholen in Kurven,
		Gefrorene Risse, vertrocknete Blutflecken, rotes Eis, weinender Biber, Gestalten im Eis"
