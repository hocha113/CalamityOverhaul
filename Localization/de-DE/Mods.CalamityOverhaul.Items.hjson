}

SwarmVortexBeacon: {
	DisplayName: Schwarmstrudel-Bake
	Tooltip:
		'''
		Treffer legen Bienenmarken; bei 8 Schichten reißt der Strudel das Ziel hinein
		Der Strudel würgt 5 s, 4 Bienenbisse pro Sekunde, je 18 Grundschaden
		Hineingezogene werden stark verlangsamt, Bosse nur wenig
		Weitere Treffer auf das Strudelziel verlängern auf bis zu 8 s
		Nur ein Strudel zugleich; ein neues voll markiertes Ziel holt den Schwarm
		Stirbt das Ziel, wechselt der Strudel auf einen nahen Feind
		Mit Bienenstock-Rucksack Bissschaden +25 %
		Stehst du still, kehrt der Schwarm heim und bildet Wachsrüstung auf dir
