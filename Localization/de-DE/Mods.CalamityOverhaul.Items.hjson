Deepclaw: {
	DisplayName: Abgrundzange
	Tooltip:
		'''
		Beschwört einen Abgrundhummer, der für dich kämpft
		Der Hummer stößt mit der Schere vor und reißt zu
		Nach drei Scherentreffern öffnet er die Schere und löst den Kavitationsknall aus
		Der Knall richtet Flächenschaden an und zerrt Feinde in den Mittelpunkt
		"Was in der Tiefe lebt, lässt die Schere nicht los"
		'''
}

SeaShrimpShell: {
	DisplayName: Abgrundkristall-Garnelenschale
	Tooltip:
