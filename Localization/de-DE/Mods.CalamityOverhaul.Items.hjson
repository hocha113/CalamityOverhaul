MoldProcessingTable: {
	DisplayName: Formverarbeitungstisch
	Tooltip:
		'''
		Rechtsklick öffnet den Formverarbeitungstisch
		Zerlegen: Überzählige gleichartige Modifikationsteile in Fragmente schmelzen
		Umgießen: Fragmente verbrauchen für neue Formen; Ziel im Index sperrbar
		'''
}

