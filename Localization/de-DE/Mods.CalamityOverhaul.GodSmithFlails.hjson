GsBallOHurt.Desc:
	'''
	Umschmiedung: Schwingen lädt auf, die geworfene Stachelkugel streut schwebende Widerhaken
	Trifft der volle Schwung, platzt ein Widerhakenring am Ziel
	'''
GsChainKnife.Desc:
	'''
	Umschmiedung: Trifft die Klinge, erhältst du 7 s Schwung
	Jeder Stapel steigert Schwung- und Wurfgeschwindigkeit, höchstens drei
	'''
GsTheMeatball.Desc:
	'''
	Umschmiedung: Der volle Schwungwurf sprengt Blutnebel
	Der Nebel zerreißt Umstehende und legt Blutung auf
	'''
GsBlueMoon.Desc:
	'''
	Umschmiedung: Der aufgeladene Wurf schießt durchschlagende Mondsicheln
	Halber Schwung eine, voller Schwung drei
	'''
GsSunfury.Desc:
	'''
	Umschmiedung: Der geworfene Hammerkopf brennt schwebende Brandmale entlang des Wegs
	Die Male bleiben am Ort und brennen Berührende mit Höllenfeuer
	'''
GsMace.Desc:
	'''
	Umschmiedung: Der volle Schwungwurf knackt die Rüstung, Verteidigung halbiert für einige Sekunden
	Jeder Schlag trägt schwereren Rückstoß
	'''
GsFlamingMace.Desc:
	'''
	Umschmiedung: Beim Schwingen fliegen brennende Funken nach außen
	Je schneller die Drehung, desto schärfer und weiter die Funken, sie entzünden Getroffene
	'''
GsDaoofPow.Desc:
	'''
	Umschmiedung: Würfe wechseln zwischen Yin und Yang, Yin brennt ein Mal und verlangsamt
	Trifft Yang ein gezeichnetes Ziel, detoniert das Mal und spritzt Licht-Tinte
	'''
GsFlowerPow.Desc:
	'''
	Umschmiedung: Beim Schwingen blühen Blütenblätter um den Hammerkopf, höchstens fünf
	Nach einem Wurf-Treffer werden alle Blätter zu verfolgenden Klingen und stürzen auf das Ziel
	'''
GsDripplerFlail.Desc:
	'''
	Umschmiedung: Bei hoher Drehzahl und auf jedem Wurf tropft der Kopf schwerkraftgebundene Blutperlen
	Berühren sie Feinde oder den Boden, platzen sie zu stechenden Blutdornen
	'''

GsKOCannon: {
	Desc:
		'''
		Umschmiedung: Ein aufgeladener Geradeschlag; landest du in vier Sekunden drei Faustschläge auf dasselbe Ziel,
		ist die dritte Faust das KO: doppelter Schaden, doppelter Rückstoß, plus eine Stoßwelle
		'''
	TipKO: KO!
}

GsChainGuillotines.Desc:
	'''
	Umschmiedung: Beide Guillotinen fliegen zugleich und falten sich unterwegs auf
	Kreuzen sich die Klingen, schneiden sie und sprengen ein Kreuzschnittmal in der Mitte
	'''
GsGolemFist.Desc:
	'''
	Umschmiedung: Volle Fausttreffer häufen Hitze (höchstens 3 Stapel, je +8% Schaden, 8 s ohne Treffer kühlt ab); bei voller Hitze ist die Faust schmelzend, Treffer spritzen 3 Schmelzsteine
	Jeder schwere Schlag gegen Feind oder Wand schlägt eine steinerne Stoßwelle
	'''
GsFlairon.Desc:
	'''
	Umschmiedung: Beim Schwingen und im Flug quetscht die Kette ständig verfolgende Blasenklingen (höchstens 8 auf dem Feld, je 40% Schaden)
	Trifft ein voller Schwung hart, legt er sechs Blasenklingen ringförmig um das Ziel
	'''
