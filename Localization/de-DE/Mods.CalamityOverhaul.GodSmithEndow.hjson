GodSmithExecutionEndow: {
	EndowName: Hinrichtungsschnitt
	EndowDesc:
		'''
		Triffst du einen Feind unter {0}% Leben, folgt ein Hinrichtungsschnitt
		Der Schnitt verursacht {1}% des Schlags
		'''
}

GodSmithOverkillEndow: {
	EndowName: Überkill-Kette
	EndowDesc:
		'''
		Beim Töten springt blutrotes Licht zu nahen Feinden
		Es trägt {0}% des überschüssigen Schadens plus {1}% dieses Schlags
		'''
}

GodSmithCritMarkEndow: {
	EndowName: Treffermal
	EndowDesc:
		'''
		Treffer ritzen Male ins Ziel; bei {0} Stapeln detonieren sie
		Die Explosion ist immer kritisch, Grundlage {1}% des Schlags
		'''
}

GodSmithEchoSlashEndow: {
	EndowName: Klingenwinds Echo
	EndowDesc:
		'''
		Treffer wecken einen Klingenwind, der nach außen schlägt
		Andere Feinde erleiden {0}% des Schlags
		'''
}

GodSmithShockwaveEndow: {
	EndowName: Stoßwelle
	EndowDesc:
		'''
		Alle 1,5 Sekunden schlägt ein Treffer eine Stoßwelle
		Sie stößt nahe Feinde zurück und verursacht {0}% des Schlags
		'''
}

GodSmithComboEndow: {
	EndowName: Komboausbruch
	EndowDesc:
		'''
		Treffer in Folge häufen Schwung; der {0}. Schlag bricht aus
		Umgebungsschaden in Höhe von {1}% des Schlags
		Hält die Hand inne oder wechselt die Waffe, zerfällt der Schwung
		'''
}

GodSmithAfterimageEndow: {
	EndowName: Schattenhieb
	EndowDesc:
		'''
		Jeder {0}. Angriff schickt ein Nachbild zum Fadenkreuz
		Es verursacht {1}% des Waffenschadens
		'''
}

GodSmithBallisticEndow: {
	EndowName: Wolkendurchstoß
	EndowDesc:
		'''
		Jeder {0}. Schuss legt eine Leuchtspur nach
		Sie durchschlägt Feinde und verursacht {1}% des Waffenschadens
		'''
}

GodSmithRicochetEndow: {
	EndowName: Springgeschoss
	EndowDesc:
		'''
		Nach einem Munitionstreffer springt ein Geschoss zu einem anderen Feind
		Es verursacht {0}% des Schlags
		'''
}

GodSmithPhantomVolleyEndow: {
	EndowName: Phantomsalve
	EndowDesc:
		'''
		Jeder {0}. Schuss ruft {1} Phantomgeschosse zur Salve
		Jedes verursacht {2}% des Waffenschadens
		'''
}

GodSmithManaRefluxEndow: {
	EndowName: Manarückfluss
	EndowDesc:
		'''
		Treffer haben {0}% Chance, einen Manafaden abzulösen, der zu dir fliegt
		Auffangen gibt {1} Mana zurück
		'''
}

GodSmithOverloadEndow: {
	EndowName: Arkanüberladung
	EndowDesc:
		'''
		Liegt Mana über {0}%, detoniert ein Treffer violette Arkanblitze
		Zusätzlich {1}% des Schlags
		'''
}

GodSmithMythicEchoEndow: {
	EndowName: Sternengeist
	EndowDesc:
		'''
		Zaubern ruft Sternengeister, die dich umkreisen
		Sie werfen von Zeit zu Zeit Sternengeschosse auf nahe Feinde, {0}% des Waffenschadens
		'''
}

GodSmithDesperationEndow: {
	EndowName: Verbrannte Schiffe
	EndowDesc:
		'''
		Eine ramponierte Waffe brüllt in der Not
		Treffer haben {0}% Chance auf einen Ausbruch, {1}% des Schlags als Flächenschaden
		Je schlechter das Präfix, desto heftiger der Ausbruch
		'''
}

GodSmithHiddenEdgeEndow: {
	EndowName: Stumpfe Schneide, wahrer Stahl
	EndowDesc:
		'''
		Stumpfe Klingen bergen eine echte Schneide
		Jeder {0}. Angriff blitzt weiß auf und verursacht {1}% des Waffenschadens
		Je träger die Waffe, desto schärfer das Verborgene
		'''
}

GodSmithLuckyStarEndow: {
	EndowName: Glücksstern
	EndowDesc:
		'''
		Bei kritischen Treffern fällt ein Glücksstern auf das Ziel
		Er verursacht {0}% des Schlags
		'''
}

GodSmithMenaceEndow: {
	EndowName: Tötungsdruck
	EndowDesc:
		'''
		Treffer häufen Tötungswillen; der {0}. Schlag reißt schwarzrote Krallen
		Sie verursachen {1}% des Schlags
		'''
}

GodSmithSwiftFootEndow: {
	EndowName: Laufwind
	EndowDesc:
		'''
		Etwa {0} Felder Lauf füllen den Wind
		Der nächste Treffer entlässt eine durchschlagende Windklinge, {1}% des Schlags
		'''
}

GodSmithViolentSurgeEndow: {
	EndowName: Raserei
	EndowDesc:
		'''
		Nahkampftreffer häufen Raserei; bei {0} Stapeln bricht ein blutroter Klingenring aus
		Flächenschaden in Höhe von {1}% des Schlags
		'''
}

GodSmithArcaneWardEndow: {
	EndowName: Arkaner Schutz
	EndowDesc:
		'''
		Bei Treffer webt Mana eine Runenwehr
		Jedes Mana punktet {0} Schaden, höchstens {1}% dieses Schlags
		'''
}
