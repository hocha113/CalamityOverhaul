AbandonedPortalStrings: {
	Title: Ruinen-Portal-Konsole
	BrokenSubtitle: Struktur gebrochen · Kern offline
	RepairingSubtitle: Selbstreparatur läuft
	RepairedSubtitle: Kanal stabil · Leeren-Koordinaten verfügbar
	BrokenBody: Schwache Subraum-Echos hallen noch im zerbrochenen Türrahmen. Nach Start der Selbstreparatur baut das Portal den Positionierungsring in wenigen Minuten wieder auf.
	RepairingBody: Nanolasernähte rekonstruieren den Riss-Begrenzer. Halte die Umgebung stabil und warte auf die Kalibrierung.
	RepairedBody: Selbstreparatur abgeschlossen. Die Teleportsequenz öffnet zuerst einen Riss und sendet dich dann in die Leere.
	StartRepair: ▷ Selbstreparatur starten
	Teleport: ▷ Teleport starten
	Close: ✕ Schließen
	ProgressFormat: Reparaturfortschritt {0}%
	StatusBroken: STATUS  ▌ OFFLINE
	StatusRepairing: STATUS  ▌ KALIBRIERUNG
	StatusRepaired: STATUS  ▌ ONLINE
	DiagnosticHeader: "[DIAG]"
	DiagnosticBroken: ERR-0xC4: Positionierungsring gebrochen / Hauptstromkreis getrennt
	DiagnosticRepairing: INFO: Nano-Schweiß-Array synchronisiert… Portalbasis nicht bewegen
	DiagnosticRepaired: OK: Alle Subsysteme online / Koordinatenanalyse bereit
}

