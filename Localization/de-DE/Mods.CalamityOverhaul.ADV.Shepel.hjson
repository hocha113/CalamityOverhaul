CybCourseIntroDialogue: {
	Line1: Meister, willkommen im neuronalen Trainingsknoten.
	Line2: Dies ist ein geschlossener Trainingsraum.
	Line3: Die SHPC ist eine mächtige intelligente Waffe. Hier lernen Sie, ihr HUD zu bedienen.
	Line4: Sind Sie bereit, Ihr Bewusstsein mit meinem zu verbinden? Halten Sie meine Hand fest — wir beginnen.
}

CybTutorialLead: {
	Step0_Title: SHPC verbinden
	Step0_Body: Rüste die SHPC aus und halte sie in der Waffenleiste — der HUD-Kernknoten erscheint unten links.
	Step1_Title: Kernknoten
	Step1_Body: Klicke unten links auf den Kernknoten, um das Bedienfeld zu öffnen oder zu schließen.
	Step2_Title: CYBER DOMAIN
	Step2_Body:
		'''
		Domäne: Mehrschichtige Domänenstrukturen bereitstellen und verwalten.
		Klicke den hervorgehobenen Sektor, um dieses Panel zu öffnen.
		'''
	Step3_Title: MODIFY
	Step3_Body:
		'''
		Modul-Modifikation: Modifikationsteile für die SHPC installieren oder entfernen.
		Klicke den hervorgehobenen Sektor, um dieses Panel zu öffnen.
		'''
	Step4_Title: CYBERWARE
	Step4_Body:
		'''
		Kyberware-Implantate: Körperverbesserungsmodule anzeigen und verwalten.
		Klicke den hervorgehobenen Sektor, um diese Oberfläche zu öffnen.
		'''
	Step5_Title: TALK
	Step5_Body:
		'''
		Neuronale Verbindung: Direktkommunikation mit der SHPC aufbauen und Dialog starten.
		Klicke den hervorgehobenen Sektor, um mit ihr zu sprechen.
		'''
	Step6_Title: ENGRAM CALIBRATED
	Step6_Body:
		'''
		Alle Schnittstellen wurden aufgelöst.
		Neuronale Verbindung stabil. SHPC ist bereit.
		'''
	Calibrating: CALIBRATING...
	NextBtn: NEXT  >
	HintStuck: HINT: Versuche, den hervorgehobenen Zielbereich anzuklicken
}

CybCourseHackIntroDialogue: {
	Line1: Schnittstellen aufgelöst. Nächste Trainingsphase: Hack Time.
	Line2: Sobald Hack Time aktiv ist, steht die Welt in deinen Augen still. Nimm dir Zeit für Ziele und Protokolle. Standardtaste: {0}.
	Line3: Die Testeinheit voraus ist fixiert. Drücke {0} für Hack Time und klicke, um sie zu fixieren.
}

HackTimeTutorialLead: {
	HT_Waiting: AWAITING INPUT...
	HT_Calibrating: DISCONNECTING...
	HT_NextBtn: NEXT  >
	HT_HintStuck: HINT: Klicke NEXT zum Überspringen
	HT_KeyUnbound: N (temporärer Schalter)
	HT_KeyHintUnbound: Hinweis: Ist die Hack Time-Taste unbelegt, kannst du in diesem Tutorial [N] nutzen; lege sie unter Einstellungen > Steuerung fest.
	HT_S00_Title: Hack-Modus aktivieren
	HT_S01_Title: NPC-Ziel fixieren
	HT_S02_Title: Hack-Protokoll-Panel
	HT_S03_Title: Zur Upload-Warteschlange
	HT_S04_Title: Hack Time verlassen zum Ausführen
	HT_S05_Title: Protokoll läuft
	HT_S06_Title: Hack Time erneut aktivieren
	HT_S07_Title: Block-Ziel fixieren
	HT_S08_Title: Block-Protokoll einreihen
	HT_S09_Title: Hack Time verlassen zum Ausführen
	HT_S10_Title: Block-Protokoll läuft
	HT_S11_Title: Training abgeschlossen
	HT_S00_Body:
		'''
		Drücke {0}, um den Hack Time-Modus zu betreten.
		Die Zeit friert ein, ein Cyber-Filter legt sich über dein Bild.
		'''
	HT_S01_Body:
		'''
		Bewege den Cursor über den hervorgehobenen Santa-NK1
		und klicke links, um ihn als Hack-Ziel zu fixieren.
		'''
	HT_S02_Body:
		'''
		Das rechte Panel zeigt verfügbare Hack-Protokolle für das Ziel.
		Verschiedene Protokolle verbrauchen unterschiedlich viel RAM und wirken unterschiedlich.
		'''
	HT_S03_Body:
		'''
		Klicke rechts ein Protokoll, um es der Upload-Warteschlange links hinzuzufügen.
		In Hack Time wird nur eingereiht — noch nicht ausgeführt.
		'''
	HT_S04_Body:
		'''
		Drücke {0} erneut, um Hack Time zu verlassen.
		Die Protokolle beginnen in Echtzeit hochzuladen und zu wirken.
		'''
	HT_S05_Body:
		'''
		Upload läuft … Beobachte die Protokollwirkung am Ziel.
		Nächste Phase, sobald die Warteschlange leer ist.
		'''
	HT_S06_Body:
		'''
		Im Korridor voraus steht ein Wärmegenerator MK2.
		Drücke {0} erneut für Hack Time und Block-Scan.
		'''
	HT_S07_Body:
		'''
		Bewege den Cursor über den hervorgehobenen Generator
		und klicke links, um ihn als Scan-Ziel zu fixieren.
		'''
	HT_S08_Body:
		'''
		Das rechte Panel zeigt blockexklusive Protokolle.
		Klicke ein Protokoll, um es der Upload-Warteschlange hinzuzufügen.
		'''
	HT_S09_Body:
		'''
		Drücke {0} erneut, um Hack Time zu verlassen.
		Block-Protokolle werden in Echtzeit ausgeführt.
		'''
	HT_S10_Body:
		'''
		Upload läuft … Beobachte die Protokollwirkung am Generator.
		Training endet, sobald die Warteschlange leer ist.
		'''
	HT_S11_Body:
		'''
		Hack-Training abgeschlossen.
		Scan, Protokoll, Upload, Ausführung — der Ablauf sitzt.
		'''
	HT_Observing: UPLOADING...
}

CybCourseWheelIntroDialogue: {
	// Line1: Both core protocols check out. One last thing — a gesture that puts them both at your fingertips.
	// Line2: Hold {0} and the radial wheel unfolds — the three domain layers sit on the ring, and dead center is the Hack Time shortcut.
	// Line3: Go ahead. Hold {0}, fling the cursor toward the layer you want, and let go.
}

WheelTutorialLead: {
	// RW_S00_Title: Summon the Radial Wheel
