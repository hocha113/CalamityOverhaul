CWRServerConfig: {
	DisplayName: Inhalts-Einstellungen
	Headers.CWRWorldGen: Overhaul-Struktureinstellungen

	GenWindGrivenGenerator: {
		Label: Windkraftgeneratoren erzeugen
		Tooltip: Platziert windbetriebene Generatorstrukturen in der Welt.
	}

	GenWGGCollector: {
		Label: Plünderer-Außenposten erzeugen
		Tooltip: Spawnt zufällig feindliche Plünderer-Gebäude in der Welt. Diese Einstellung wirkt nur in Legendären Welten.
	}

	GenJunkmanBase: {
		Label: Plünderer-Basis erzeugen
		Tooltip: Spawnt eine Plünderer-Festung in Ödlanden oder unter der Erde.
	}

	GenRocketHut: {
		Label: Raketenhütte erzeugen
		Tooltip: Erzeugt eine mysteriöse Hütte mit Raketenteilen oder technologischen Relikten.
	}

	GenSylvanOutpost: {
		Label: Waldelfen-Außenposten erzeugen
		Tooltip: Spawnt hölzerne Elfen- oder Waldschützer-Außenposten tief im Wald.
	}

	GenSHPCCradle: {
		Label: SHPC-Absturzinsel erzeugen
		Tooltip: Erzeugt über dem Spawnpunkt eine Himmelsinsel mit einer abgestürzten Kapsel, in der die SHPC versiegelt ist. Ist dies deaktiviert, ist die Waffe nur in Calamitys Labor zu finden
	}

	ConfigChangePrefix: Benutzer
	ConfigChangeSuffix: hat die Serverkonfiguration geändert
}

CWRClientConfig: {
	DisplayName: Client-Einstellungen

	Headers: {
		CWRWeapon: Overhaul-Waffeneinstellungen
		CWRDisplay: Anzeigeeinstellungen
		CWRModCompat: Mod-Kompatibilitätspatches
	}

	ScreenVibration: {
		Label: Bildschirmvibration für spezielle Waffenangriffe
		Tooltip: Wenn aktiviert, vibriert der Bildschirm bei bestimmten Angriffen, um den Schlag stärker zu betonen
	}

	DomainConciseDisplay: {
		Label: Knappes Domänendisplay
		Tooltip: Standardmäßig aus. Vereinfacht nur die Inszenierung von Domänen wie Cyberspace und Meeresgebiet; Onikiris Geisterreich sowie Zergliederung, Omokage, Hackerzeit und ähnliche Waffen- und Implantateffekte bleiben unberührt
	}

	LensEasing: {
		Label: Objektiv-Easing
		Tooltip: Bei Aktivierung wird bei schnellen Langstreckenbewegungen ein Easing-Effekt auf das Objektiv angewendet, um ein unnatürliches Gefühl zu vermeiden
	}

	AmbienceDensity: {
		Label: Atmosphärendichte
		Tooltip: Skaliert nur die Dichte dekorativer Atmosphärenpartikel; Vorzeichen und Gefahren bleiben immer sichtbar
	}

	RarityTextEffects: {
		Label: Seltenheits-Namenseffekte
		Tooltip: Animierte Gegenstandsnamen-Effekte für die Seltenheiten dieses Mods (Lapis, Jade, Kupfer, Vergoldet, Sternsilber und die vier Legenden). Wenn deaktiviert, werden Namen in einfacher Farbe gezeichnet.
	}

	CalamityRarityTextFix: {
		Label: Calamity: Schwarzen Bildschirm durch Namens-Texteffekte beheben
		Tooltip:
			'''
			Die Seltenheiten Burnished Auric / Exotic Rainbow und [ceffect]-Tags von Calamity wechseln beim Zeichnen eines Tooltips das Render-Target,
			wodurch der Back-Buffer verworfen wird und das gesamte Bild schwarz wird. Wenn aktiviert, werden die Effekte ohne Render-Targets gezeichnet,
			was zugleich die Fehlausrichtung bei UI-Skalierung ungleich 100 % behebt und den Aufwand pro Frame senkt.
			'''
	}

	CalamityHolyBurnOrbFix: {
		Label: Calamity: Absturz im Kampf gegen Entweihte Wächter / Providence beheben
		Tooltip:
			'''
			Calamitys Zeichner für die Spuren heiliger Kugeln speichert Projektilreferenzen und zeichnet sie weiter nach ihrem ursprünglichen Typ,
			nachdem der Slot bereits von einem anderen Projektil belegt wurde – das verursacht eine NullReferenceException (häufig im Mehrspieler).
			Wenn aktiviert, werden veraltete Referenzen direkt vor dem Zeichnen entfernt.
			'''
	}
}
