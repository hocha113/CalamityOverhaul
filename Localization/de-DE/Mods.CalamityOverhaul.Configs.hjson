CWRServerConfig: {
	DisplayName: Inhalts-Einstellungen

	WeaponOverhaul: {
		Label: Waffen Überholung
		Tooltip:
			'''
			Durch Aktivierung werden die meisten Waffen geändert.
			[c/FF0000:wenn Sie die optimale Erfahrung des Katastrophe-Overhaul-Inhalts wünschen, aktivieren Sie es bitte!]
			'''
	}

	ScreenVibration: {
		Label: Bildschirmvibration für spezielle Waffenangriffe
		Tooltip: Wenn aktiviert, vibriert der Bildschirm bei bestimmten Angriffen, um den Schlag stärker zu betonen
	}

	MurasamaSpaceFragmentationBool: {
		Label: Murasama-Endeffekt der Raumfragmentierung
		Tooltip:
			'''
			Standardmäßig aktiviert, erzeugt Murasama bei der Ausführung von Endtechniken einen Bildschirmeffekt der Fragmentierung, um den Schlag zu verstärken
			Durch Deaktivieren werden diese Effekte ausgeschaltet, je nach persönlichen Vorlieben einstellbar
			'''
	}

	DomainConciseDisplay: {
		Label: Domain-Minimalanzeige
		Tooltip: Standardmäßig aus. Wenn aktiviert, werden die meisten visuellen Effekte innerhalb der Domain ausgeblendet.
	}

	Headers: {
		CWRSystem: Großreparatursystemeinstellungen
		CWRWeapon: Großreparaturwaffeneinstellungen
		CWRUI: Großreparatur-UI-Einstellungen
		CWRWorldGen: Großreparatur-Struktureinstellungen
	}

	LensEasing: {
		Label: Objektiv-Easing
		Tooltip: Bei Aktivierung wird bei schnellen Langstreckenbewegungen ein Easing-Effekt auf das Objektiv angewendet, um ein unnatürliches Gefühl zu vermeiden
	}

	BiologyOverhaul: {
		Label: Biologische Verhaltensüberlagerung[c/06e33f:(Experimentell)]
		Tooltip:
			'''
			[c/c20909:Nicht vollständig implementiert]
			Standardmäßig aktiviert, ändert das Verhalten einiger Kreaturen, z. B. Boss-KIs unter dem Einfluss des Tod-Moduls
			Dies kann die Spielherausforderung erhöhen, je nach Vorliebe kann dies deaktiviert werden
			'''
	}

	MuraUIStyleType: {
		Label: Mura UI-Stil Auswahl
		Tooltip:
			'''
			Stil 1: Verfeinert - Schwebend über dem Kopf
			Stil 2: Verfeinert - Kompakt
			Stil 3: Klassisch - Schwebend über dem Kopf
			Stil 4: Klassisch - Kompakt
			Stil 5: Conceal
			'''
	}

	MuraPosStyleType: {
		Label: Mura UI-Position Auswahl
		Tooltip:
			'''
			Voreinstellung 1: Unten rechts
			Voreinstellung 2: Unten links
			Voreinstellung 3: Oben zentriert
			'''
	}

	QuestLog: {
		Label: Questbuch-Anleitung
		Tooltip:
			'''
			Wenn aktiviert, führt dich das Questbuch durch den Spielfortschritt
			Du kannst die Quest-Oberfläche über das Questbuch-Item, die Inventar-UI oder eine Tastenkombination öffnen, um aktuelle Quests anzuzeigen
			Standardmäßig aktiviert. Deaktivieren entfernt jegliche Quest-Anleitung
			'''
	}

	DialogueBox_Scale_Value: {
		Label: Dialogfeld-Skalierung
		Tooltip: Passt die Gesamtgröße des Dialogfelds an
	}

	GenWindGrivenGenerator: {
		Label: Windkraftgeneratoren erzeugen
		Tooltip: Platziert windbetriebene Generatorstrukturen in der Welt.
	}

	GenWGGCollector: {
		Label: Plünderer-Außenposten erzeugen
		Tooltip: Spawnt zufällig feindliche Plünderer-Gebäude in der Welt. Diese Einstellung wirkt nur in Legendären Welten.
	}

	GenJunkmanBase: {
		Label: Plünderer-Basis erzeugen
		Tooltip: Spawnt eine Plünderer-Festung in Ödlanden oder unter der Erde.
	}

	GenRocketHut: {
		Label: Raketenhütte erzeugen
		Tooltip: Erzeugt eine mysteriöse Hütte mit Raketenteilen oder technologischen Relikten.
	}

	GenSylvanOutpost: {
		Label: Waldelfen-Außenposten erzeugen
		Tooltip: Spawnt hölzerne Elfen- oder Waldschützer-Außenposten tief im Wald.
	}

	ConfigChangePrefix: Benutzer
	ConfigChangeSuffix: hat die Serverkonfiguration geändert
}
