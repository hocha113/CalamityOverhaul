ModifyChargingStationItem: {
	DisplayName: Ladestation
	Tooltip:
		'''
		Nutzt Strom, um elektrische Geräte aufzuladen
		Batterien können hineingelegt werden, um Strom zu speichern
		Kann an Rohrleitungen angeschlossen werden, um Strom zu übertragen
		Rechtsklick auf den Block mit einem aufladbaren Item in der Hand, um es schnell einzulegen
		Umschalt + Rechtsklick, um Items herauszunehmen
		'''
}

DyeVatItem: {
	DisplayName: "{$ItemName.DyeVat}"
	Tooltip:
		'''
		Wird zum Herstellen von Farbstoffen verwendet
		Nach dem Platzieren Rechtsklick, um das Bedienfeld zu öffnen und Items einzufärben
		Lege einen Wassereimer in den Farbstoff-Slot, um Farben von Items zu entfernen
		'''
}

RDemonConch: {
	DisplayName: Dämonenmuschel
	Tooltip:
		'''
		Hör genau hin – du wirst Schreie hören
		„Vorsicht.“
		'''
}
