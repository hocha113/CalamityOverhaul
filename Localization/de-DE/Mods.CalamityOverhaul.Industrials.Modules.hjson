	DisplayName: Isolierfutter-Modul
	Tooltip:
		'''
		Am Wärmekraftwerk: Wärmeabgabe auf 55 %
		Drei Lagen Asbest, die Hitze kommt nicht raus
		'''
}

ForcedDraftModule: {
	DisplayName: Zwangszug-Modul
	Tooltip:
		'''
		Am Wärmekraftwerk: Brennrate +45 %, Feuer heißer und schneller
		Ein Druck am Blasebalg, und die Glut richtet sich auf
		'''
}

SlowBurnValveModule: {
	DisplayName: Langsambrand-Ventil
	Tooltip:
		'''
		Am Wärmekraftwerk: Brennrate auf 60 %, jede Ladung hält länger
