ExcavationBoosterModule: {
	DisplayName: Aushub-Verstärker
	Tooltip:
		'''
		An der Fördermaschine: Arbeitszyklus -30 %
		Die Zahnräder haben härtere Zähne bekommen
		'''
}

PickPowerBoosterModule: {
	DisplayName: Hackkraft-Verstärker
	Tooltip:
		'''
		An der Fördermaschine: Hackkraft +60 %
		Damit knabbert eine Blechmaschine selbst Mithril
		'''
}

ChlorophyteDrillModule: {
	DisplayName: Chlorophyt-Bohr-Modul
	Tooltip: Der Bohrer selbst ist aus Chlorophytbarren gegossen: Erz fördert Erz
}

EfficiencyModule: {
	DisplayName: Effizienz-Modul
	Tooltip:
		'''
		An der Fördermaschine: Energie pro Zyklus auf 60 %
		Die fest gewickelte Kupferspule wird nicht mehr heiß
		'''
}

YieldBoosterModule: {
	DisplayName: Ertrags-Verstärker
	Tooltip:
		'''
		An der Fördermaschine: Chance auf Förderertrag +35 %
		Das Sieb ist eine Nummer dichter
		'''
}

ProspectorModule: {
	DisplayName: Prospektor-Modul
	Tooltip:
		'''
		An der Fördermaschine: Gewicht seltener Nebenprodukte wie Edelsteine, Fossilien und Meteoriten verdreifacht
		Unter der Linse hat selbst Kies Rang und Namen
		'''
}

SurveyArrayModule: {
	DisplayName: Erkundungsarray-Modul
	Tooltip:
		'''
		An der Fördermaschine: Erkundungsreichweite +50 %
		Das Echo kommt vor dem Bohrer
		'''
}

VeinFocusModule: {
	DisplayName: Aderfokus-Modul
	Tooltip:
		'''
		An der Fördermaschine: Bonus echter Adern auf den Ertrag +60 %
		Der Ader folgen, nicht mit dem Stein streiten
		'''
}

DoubleLoadModule: {
	DisplayName: Doppelladungs-Modul
	Tooltip:
		'''
		An der Fördermaschine: 25 % Chance, dass jede Förderung verdoppelt
		Die Förderwanne ist eine Runde breiter geschweißt
		'''
}

OverdriveCoreModule: {
	DisplayName: Overdrive-Kern
	Tooltip:
		'''
		An der Fördermaschine: Arbeitszyklus -45 %, Verbrauch +60 %
		Bevor das Lager glüht, denkt sie nicht ans Anhalten
		'''
}

ThrottleValveModule: {
	DisplayName: Drosselventil-Modul
	Tooltip:
		'''
		An der Fördermaschine: Arbeitszyklus +50 %, Verbrauch auf 45 %
		Langsam, aber die ganze Nacht gehört ihr
		'''
}

ChestLinkModule: {
	DisplayName: Truhenanbindung
	Tooltip:
		'''
		An der Fördermaschine: Ertrag wandert direkt in die nächste Truhe, fällt nur zu Boden, wenn nichts mehr reinpasst
		Spart das Bücken
		'''
}

SmelterModule: {
	DisplayName: Vor-Ort-Schmelz-Modul
	Tooltip:
		'''
		An der Fördermaschine: Erz wird nach Schmelzofenrezept zu Barren, Verbrauch +40 %
		Am Schachtmund kommen schon Barren raus
		'''
}

MachineModuleText: {
	TagText: Maschinen-Aufrüstmodul
	TargetsLine: Passt zu: {0}
	HowToText: Rechtsklick auf die passende Maschine öffnet das Panel; in den Modulschlitz, dann wirkt es
	SocketOnly: Diese Maschine nimmt dieses Modul nicht!
	SocketDuplicate: Ein Modul dieser Art steckt schon!
	SocketEmptyHint: Aufrüstmodul einlegen
	SlotLabel: Modul
	NameMining: Fördermaschine
	NameThermal: Wärmekraftwerk
	NameWind: Windgenerator
	NameHydro: Wassergenerator
	NameIncinerator: Verbrennungsofen
	NameCrusher: Brecher
	NameRecycler: Recycler
	NameMagma: Magma-Wärmekraftwerk
	NameBiomass: Biomassegenerator
	NameTurret: Wehrturm
	NameSolar: Solarplatte
}

