	// Godsmith armor resets: per-piece stat lines and set bonus lines
	// Pre-hardmode ore sets: chestplates grant mining speed, one set bonus each
	// BodyLine: 5% faster mining speed
	// SetBonusLine: Attacks have a 30% chance to deal 2 extra fixed damage
}

GsTinArmor: {
	// BodyLine: 6% faster mining speed
	// SetBonusLine: 10% increased movement speed and 50 more maximum mana
}

GsIronArmor: {
	// BodyLine: 8% faster mining speed
	// SetBonusLine: 5 more defense and 10 armor penetration, but 20% reduced movement speed
}

GsLeadArmor: {
	// BodyLine: 9% faster mining speed
	// SetBonusLine: Attacks have a 50% chance to inflict Lead Poisoning (4 damage per second for 6 seconds); +1 minion slot
}

GsSilverArmor: {
	// BodyLine: 11% faster mining speed
	// SetBonusLine: 3 more defense
}

GsTungstenArmor: {
	// BodyLine: 12% faster mining speed
	// SetBonusLine: 3 more defense
}

GsGoldArmor: {
	// BodyLine: 14% faster mining speed
	// SetBonusLine: 15% increased damage, but 20 less defense
}

GsPlatinumArmor: {
	// BodyLine: 15% faster mining speed
	// SetBonusLine: 10 more defense and +1 minion slot, but 15% reduced damage
}

GsLeadPoisonBuff: {
	// DisplayName: Lead Poisoning
