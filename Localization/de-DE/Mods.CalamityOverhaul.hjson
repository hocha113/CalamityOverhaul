	GsMagicMissile.Desc:
		'''
		Umschmiedung: Gesteuerte Flugbahn lenkt 25% schärfer
		Rechtsklick halten lädt; Loslassen entlässt drei Magiegeschosse, die dein Fadenkreuz in Formation geleiten
		'''
	GsMeteorStaff.Desc:
		'''
