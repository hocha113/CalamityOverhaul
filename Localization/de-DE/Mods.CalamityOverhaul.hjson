# For Language Pack Creators:
# The keys here were previously in Items. Since EcTypeItem has been removed, all localization keys similar to "ItemNameEcType" have been moved here.
# The corresponding format is "ItemNameEcType" → "RItemName" or "ItemNameOverride".
# Apart from the class name change, the DisplayName and Tooltip remain the same as in the previous version.
# So if you need to migrate your language pack to the new version, simply copy and paste the entries here and update the class names accordingly.

Arcanes: {
	Items: {
		ArcaneTransformer: {
			DisplayName: Arkaner Transformator
			Tooltip: ""
		}
	}
}

Resurrections: {
	ResurrectionDeath: {
		DeathText: "{0} starb durch Abgrund-Wiederbelebung"
		WarningCombatText: Der Abgrund verschlingt dich …
		DeathNoticeText: Du wurdest vom Abgrund verschlungen …
		MarkRemainText: Das Mal des Abgrunds umschlingt dich noch immer …
		RetainValueFormat: Wiederbelebungswert: {0}%
	}
}

QuickHack: {
	SynapseBurn: {
		DisplayName: Synapsen-Überlastung
		Description: Überlastet die neuronalen Synapsen des Ziels und verursacht fortlaufenden thermischen Schaden.
	}

	ShortCircuit: {
		DisplayName: Kurzschluss
		Description: Entlädt einen EMP, der sofortigen Schaden und kurze Lähmung verursacht.
	}

	Cyberpsychosis: {
		DisplayName: Cyberpsychose
		Description: Treibt das Ziel in Raserei und lässt es alle nahen Einheiten angreifen.
	}

	SystemReset: {
		DisplayName: Systemneustart
		Description: Erzwingt einen Systemneustart am Ziel und lähmt es vollständig.
	}

	OpticOverload: {
		DisplayName: Optische Überlastung
		Description: Blendet das Ziel, sodass es seine Umgebung nicht mehr wahrnehmen kann.
	}

	MemoryWipe: {
		DisplayName: Speicherlöschung
		Description: Löscht die Feindseligkeitsdaten des Ziels und setzt die Aggro-Liste zurück.
	}

	Contagion: {
		DisplayName: Ausbreitung
		Description: Implantiert sich selbst replizierende Malware, die sich auf nahe Ziele ausbreitet.
	}

	TileDetonate: {
		DisplayName: Block-Sprengung
		Description: Untergräbt die strukturelle Integrität und löst eine lokale Explosion aus.
	}

	TilePhase: {
		DisplayName: Phasierungsprotokoll
		Description: Verändert die physikalischen Eigenschaften eines Blocks und macht ihn für eine Zeit immateriell.
	}

	TileMagPull: {
		DisplayName: Magnetische Anziehung
		Description: Erzeugt ein Magnetfeld, das nahe liegende Drops zu dir zieht.
	}

	MachineShortCircuit: {
		DisplayName: Maschinen-Kurzschluss
		Description: Entleert die elektrische Energie der Zielmaschine und entlädt Lichtbögen, die nahe Wesen treffen.
	}

	TurretHijack: {
		DisplayName: Geschütz-Übernahme
		Description: Manipuliert das IFF-Erkennungsmodul und kehrt vorübergehend die Freund-Feind-Erkennung des Geschützes um.
	}

	FalseMemory: {
		DisplayName: Falsche Erinnerung
		Description: Implantiert falsche Erinnerungen, die Verfolgung kurz unterbrechen oder Tötungsmuster unterdrücken.
	}

	SelfDismember: {
		DisplayName: Selbstverstümmelung
		Description: Zwingt das paranormale Wesen, sich selbst zu zerstückeln.
	}

	SystemHalt: {
		DisplayName: Systemstillstand
		Description: Lässt das Ziel kurz verstummen und jede Aktivität einstellen.
	}

	TurretCircuitOverload: {
		DisplayName: Schaltkreis-Überlastung
		Description: Speist Gegenstrom in den Stromkreis des Geschützes ein und deaktiviert es lange Zeit vollständig.
	}

	TurretShortCircuit: {
		DisplayName: Geschütz-Kurzschluss
		Description: Entlädt die Energie des Geschützes sofort für einen kurzen Stillstand; nach der Erholung geht es sofort wieder online.
	}

	VirusBroadcast: {
		DisplayName: Virus-Broadcast
		Description: Injiziert Wurmcode in den Signalturm, sodass er Cyber-EMP-Wellen aussendet und alle Geschütze im Sendebereich lange Zeit kurzschließt.
	}

	MeltdownProtocol: {
		DisplayName: Schmelzprotokoll
		Description: Sperrt den Kühlkreislauf; nach vier Sekunden kocht das Ziel über, explodiert und trifft nahe Feinde.
	}

	ProjectileHijack: {
		DisplayName: Ballistik-Übernahme
		Description: Übernimmt ein ankommendes Projektil und schickt es zurück.
	}

	ProjectileFreeze: {
		DisplayName: Ballistik-Einfrieren
		Description: Nagelt ein Projektil fünf Sekunden in der Luft fest und lässt es dann wieder los.
	}

	DataPurge: {
		DisplayName: Datenlöschung
		Description: Löscht ein ankommendes Projektil und alle nahen Geschosse desselben Typs.
	}

	BallisticOverclock: {
		DisplayName: Ballistik-Übertaktung
		Description: Gibt einem deiner eigenen Projektile mehr Schaden, Durchschlag und Flugzeit.
	}

	Electrolysis: {
		DisplayName: Elektrolyse
		Description: Leitet Strom durch diese Flüssigkeit; Feinde darin nehmen fortlaufend Schaden.
	}

	Cryostasis: {
		DisplayName: Kryostase
		Description: Friert eine Fläche Flüssigkeit zu betretbarem Dünneis; nach acht Sekunden taut es auf.
	}

	LiquidPurge: {
		DisplayName: Flüssigkeitsabfluss
		Description: Pumpt die umliegende Flüssigkeit leer. Wirkt auch auf Lava.
	}

	ItemRecall: {
		DisplayName: Fernrückholung
		Description: Zieht den Drop an deine Füße.
	}

	Reappraise: {
		DisplayName: Neuwertung
		Description: Würfelt das Präfix dieser Ausrüstung am Boden neu.
	}

	ArmorParse: {
		DisplayName: Rüstungsanalyse
		Description: Setzt die Verteidigung des Ziels sechs Sekunden lang auf null.
	}

	Exorcise: {
		DisplayName: Zwangsaustragung
		Description: Setzt ein Löschmal; nach fünf erlittenen Treffern folgt ein schwerer Schlag.
	}

	DataLeech: {
		DisplayName: Datenabsaugung
		Description: Solange aktiv, gibt Treffer gegen dieses Ziel RAM zurück, mit einer Gesamtobergrenze.
	}

	SwarmLink: {
		DisplayName: Schwarmkopplung
		Description: Trifft das Ziel, erleiden bis zu fünf nahe Feinde dreißig Prozent des Schadens mit.
	}

	MachineOverclock: {
		DisplayName: Maschinen-Übertaktung
		Description: Speist die Maschine zehn Sekunden mit einem festen Stromkontingent und brennt sie danach leer.
	}

	GridBlackout: {
		DisplayName: Netzausfall
		Description: Nutzt den Signalturm, um allen Maschinen in weitem Umkreis den Strom zu kappen.
	}

	PowerTransmute: {
		DisplayName: Energieumwandlung
		Description: Rechnet den gespeicherten Strom des gehaltenen Items in RAM um und leert es danach.
	}

	NeuralOverclock: {
		DisplayName: Neural-Übertaktung
		Description: Acht Sekunden lang schnellerer Einsatz; RAM regeneriert nicht und du verlierst fortlaufend Leben.
	}

	WraithForceDrive: {
		DisplayName: Dienstgeist-Zwangsantrieb
		Description: Zehn Sekunden kosten Dienstgeist-Aktionen nichts; danach vertieft sich die Erosion und er schläft.
	}

	IndexPreread: {
		DisplayName: Index-Vorlesen
		Description: Liest den Inhalt ohne Öffnen und markiert den wertvollsten Eintrag.
	}

	LockBurn: {
		DisplayName: Schlossbrand
		Description: Öffnet diese Truhe ohne Schlüssel, verbrennt dafür einen Gegenstand darin.
	}

	DielSkip: {
		DisplayName: Tag-Nacht-Sprung
		Description: Spult die Zeit zum nächsten Sonnenauf- oder -untergang vor.
	}

	StormInject: {
		DisplayName: Sturm-Injektion
		Description: Ruft ein Gewitter; Blitze treffen nur Feinde mit einem Hacker-Effekt.
	}

	GravityInvert: {
		DisplayName: Schwerkraftumkehr
		Description: Kehrt die Schwerkraft um dich um; Feinde und Drops fallen nach oben.
	}

	SegmentDelink: {
		DisplayName: Segment-Abkopplung
		Description: Schaden an diesem Segment wird nur verbucht; beim Ablauf gehen sechzig Prozent auf den Anker.
	}

	LimbSeizure: {
		DisplayName: Gliedmaßen-Beschlagnahme
		Description: Dreht dieses Glied acht Sekunden gegen seinen eigenen Anker.
	}

	CommandLinkCut: {
		DisplayName: Befehlsketten-Schnitt
		Description: Kappt die Verbindung zu seinen Partnern; zehn Sekunden kämpft jeder für sich.
	}

	MunitionSwap: {
		DisplayName: Munitionstausch
		Description: Das Geschütz feuert Munition aus deinem Inventar und rechnet mit deinem Schaden.
	}

	TurretMesh: {
		DisplayName: Geschütz-Netz
		Description: Koppelt nahe Geschütze zu einer Salve auf deine Markierung, insgesamt vierzig Schüsse.
	}

	BeaconForge: {
		DisplayName: Bake fälschen
		Description: Der Turm sendet einen falschen Notruf und lockt Gegner aus weitem Umkreis.
	}

	PrivilegeEscalate: {
		DisplayName: Rechteausweitung
		Description: Protokolle werden billiger, schneller und reichweitenlos; RAM regeneriert nicht.
	}

	ItemSalvage: {
		DisplayName: Ausschlachten
		Description: Zerlegt diesen Drop in etwa sechzig Prozent seiner Materialien.
	}

	DataBrand: {
		DisplayName: Datenbrandmal
		Description: Kopiert das Präfix dieser Ausrüstung und stempelt es beim nächsten Hack auf ein anderes Item.
		HudTag: Brandmal: {0}
		DenyNoPrefix: An diesem Item gibt es kein Präfix zum Kopieren
		DenyIncompatible: Das gespeicherte Präfix passt nicht auf dieses Item
	}

	EntityMasquerade: {
		DisplayName: Identitätsmaske
		Description: Feinde sehen diesen Drop als dich; er fängt dreißig Sekunden lang das Feuer ab.
	}

	TileConscript: {
		DisplayName: Block-Einzug
		Description: Reißt diese Blöcke zu acht Panzerplatten, die dich umkreisen und beim Ablauf hinausgeschossen werden.
	}

	VeinResonance: {
		DisplayName: Ader-Resonanz
		Description: Macht gleiche Erze durch Wände sichtbar; Abbau gibt Doppeldrops, ruft aber Wächter.
	}

	StressInvert: {
		DisplayName: Spannungs-Umkehr
		Description: Macht dieses Terrain zehn Sekunden unzerstörbar; Feinde, die dagegenprallen, nehmen Schaden.
	}

	PressureSurge: {
		DisplayName: Druckschub
		Description: Setzt diese Flüssigkeit unter Druck; alles darin wird in den Himmel gedrückt.
	}

	MirrorSurface: {
		DisplayName: Spiegeloberfläche
		Description: Die Oberfläche wird zum Spiegel; feindliche Projektile, die sie durchqueren, werden für dich kopiert.
	}

	DelayFuse: {
		DisplayName: Verzögerungszünder
		Description: Dieses Projektil verschwindet nicht; es schwebt dreißig Sekunden als Mine.
	}

	ProjectileTithe: {
		DisplayName: Projektil-Zehent
		Description: Dieses Geschoss verschlingt nahe Feindgeschosse und explodiert am Ende nach der Menge.
	}

	ProjectileSample: {
		DisplayName: Projektil-Probe
		Description: Kopiert dieses Geschoss; zwanzig Sekunden lang wiederholt jeder zwölfte deiner Schüsse es.
	}

	CompensationProtocol: {
		DisplayName: Ausgleichsprotokoll
		Description: Nimmt dem Ziel zehn Prozent Leben voraus; tötest du es nicht in acht Sekunden, zahlst du die Schuld selbst.
	}

	PayloadRewrite: {
		DisplayName: Nutzlast-Umschreibung
		Description: Zehn Sekunden gehören die Geschosse des Ziels dir und rechnen mit deinem Schaden.
	}

	PhaseDesync: {
		DisplayName: Phasenversatz
		Description: Trennt Körper und Trefferbox des Ziels; beide Seiten treffen schwerer.
	}

	LiveCellTap: {
		DisplayName: Lebendzelle
		Description: Das Ziel ist bewegungsunfähig und immun; sein Leben wird in dein RAM umgewandelt.
	}

	FirmwareRollback: {
		DisplayName: Firmware-Rücksetzung
		Description: Setzt das Ziel auf das Verhalten der vorigen Phase zurück; danach rast es fünf Sekunden.
	}

	ShellRequisition: {
		DisplayName: Hüllen-Beschlagnahme
		Description: Ziele, die während der Markierung sterben, stehen auf und kämpfen fünfzehn Sekunden für dich.
	}

	PositionCast: {
		DisplayName: Positionsfunk
		Description: Fünfzehn Sekunden ist seine Position für dein ganzes Team durch Wände sichtbar.
	}

	GaugePollution: {
		DisplayName: Anzeigenverschmutzung
		Description: Verschmutzt seine Oberfläche; Lebens- und Munitionswerte springen acht Sekunden.
	}

	LinkTraceback: {
		DisplayName: Verbindungsrückverfolgung
		Description: Kappt jeden Upload auf dich, verbrennt die Sender und markiert sie.
	}

	ForceUninstall: {
		DisplayName: Zwangsdeinstallation
		Description: Reißt ein feindliches Protokoll von dir; eine halbe Minute lang geht das nicht noch einmal.
	}

	MemoryScorch: {
		DisplayName: Speicherbrand
		Description: Verbrennt drei RAM des Gegners; zehn Sekunden bleibt seine Regeneration bei null.
		SealTag: RAM-Regeneration gesperrt
	}

	BuffSiphon: {
		DisplayName: Buff-Abzug
		Description: Stiehlt seinen langlebigsten Buff, höchstens dreißig Sekunden.
	}

	CombatSiphon: {
		DisplayName: Kampfabsaugung
		Description: Zehn Sekunden wird der Schaden, den du ihm zufügst, anteilig in dein RAM umgerechnet.
	}

	BallisticTurncoat: {
		DisplayName: Ballistik-Verrat
		Description: Seine nächsten drei Geschosse drehen unterwegs um und jagen den Absender; wer nicht schießt, bleibt sicher.
		HijackCounter: Ballistik übernommen {0}/{1}
		DeathReason: "{0}s Geschoss wurde von {1} umgedreht und kam zurück"
	}

	MeltdownBrand: {
		DisplayName: Schmelzmal
		Description: Vier Sekunden sichtbarer Zünder, dann achtzig Schaden; mittendrin abziehen entschärft die Ladung.
		FuseTag: Schmelze {0}s
		DeathReason: "{0} wurde durch das Schmelzmal von {1} gesprengt"
	}

	MapBlackout: {
		DisplayName: Kartenausfall
		Description: Seine Karte wird fünfzehn Sekunden zu Rauschen; Nadeln und Teammarken erlöschen mit.
	}

	ChannelScramble: {
		DisplayName: Kanal-Verwürfelung
		Description: Zwanzig Sekunden wird sein Chat zu Zeichensalat; Namen von Teamkameraden verschwinden von seinem Bildschirm.
	}

	StealthStrip: {
		DisplayName: Tarnungsentzug
		Description: Entzieht alle Unsichtbarkeit und Schleicherei; zehn Sekunden baut sie nicht nach, die Kontur ist für alle sichtbar.
	}

	CooldownInject: {
		DisplayName: Abkling-Injektion
		Description: Sechs Sekunden ist sein Einsatz um 35% langsamer; eine laufende Trankabklingzeit erhält fünf Sekunden extra.
	}

	CyberwareOffline: {
		DisplayName: Cyberware offline
		Description: Acht Sekunden sind alle seine Cyberware vom Strom und offline.
	}
}

