	GsRainbowGun.Desc:
		'''
		Umschmiedung: Solange der Regenbogen steht, +8% Schaden deiner Projektile im Band über dem Bogen; der Bogen streut verfolgende Prisma-Impulse
		Rechtsklick holt den Regenbogen zurück und erstattet die Hälfte des Manas
		'''
	GsRainbowRod.Desc:
		'''
		Umschmiedung: Gesteuerte Lichtgeschosse platzen beim Treffer in Prismasplitter
		Rechtsklick halten lädt; Loslassen spannt eine Regenbogenbrücke, Feinde beim Überqueren nehmen Schaden, Verbündete darauf werden schneller
		'''
	GsSkyFracture.Desc:
		'''
		Umschmiedung: Magieklingen reißen beim Start einen kurzen Rissblitz
		Rechtsklick halten lädt; Loslassen öffnet drei Risse um das Fadenkreuz, die Klingen zum Zentrum schleudern
		'''
}

GodSmithSummonWhips: {
	GsCoolWhip.Desc:
		'''
		Umschmiedung: Schneeflocken aus Takt-Hieben werden größer und durchschlagen 1 Feind extra
		4 Frostmale werden zum Hinrichtungsmal; der nächste Takt-Treffer lässt es als Frostausbruch aufgehen und fügt Frostbrand zu
		'''
	GsDarkHarvest.Desc:
		'''
		Umschmiedung: Dunkelsprünge greifen auf nahe Feinde über, ein Sprung extra je Ernte-Peitschenmal auf dem Ziel
		4 Male werden zum Hinrichtungsmal; der nächste Takt-Treffer erntet die Seele und blitzt Sicheln auf alle gezeichneten Feinde im Feld
		'''
	GsDurendal.Desc:
		'''
		Umschmiedung: Nach 3 Takt-Hieben in Folge sendet jeder weitere Takt-Schwung eine goldene Schwertwelle von der Peitschenspitze
		5 Male werden zum Hinrichtungsmal; der nächste Takt-Treffer ruft eine heilige Richtklinge
		'''
	GsFirecracker.Desc:
		'''
		Umschmiedung: Behält die klassische Diener-Detonation
		Takt-Hiebe laden Zünder ins Ziel; bei 3 Zündern kettet der nächste Knall 3 Extra-Explosionen
		'''
	GsKaleidoscope.Desc:
		'''
