}

OverseerLogger: {
	DisplayName: Aufseher-Schreiber
	Tooltip:
		'''
		Gefahrenwahrnehmung: nahe Fallen und Mechaniken haben keinen Winkel mehr
		"Den Schichtplan jeder Bolzenluke hat er im Kopf"
		'''
}

ProofingHallKey: {
	DisplayName: Schlüssel der Abnahmehalle
	Tooltip:
		'''
		Errichtet an Ort und Stelle die Abnahmehalle und hängt den staubigen Kran auf (Testgegenstand)
		"Die Schichtglocke am Prüftisch kann noch läuten"
		'''
	Placed: Die Abnahmehalle steht. Willst du die Abnahme beginnen, stell dich auf den linken Prüftisch und rühr dich nicht, bis die Glocke fertig gezählt hat.
