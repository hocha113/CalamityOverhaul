ScapegoatDoll: {
	DisplayName: Sündenbockpuppe
	Tooltip:
		'''
		Im Inventar fängt sie einmal den Tod für dich ab
		Danach zerbricht die Puppe und ist weg
		'''
	ShatterText: Die Sündenbockpuppe ist zerbrochen
}

ConstructionBlueprintQET: {
	DisplayName: Konstruktionsbauplan (Quantenverschränkungsturm)
	Tooltip:
		'''
		Nach Gebrauch lernst du, den [i:CalamityOverhaul/CQETConstructor] Selbstkonstruktor herzustellen
		„Deine Hände werden den Grundstein und den Turm schmieden, die zwei Welten verbinden“
		'''
	L1: Wissen zum Herstellen des Selbstkonstruktors (Quantenverschränkungsturm) erlangt!
	L2: Du hast diesen Bauplan bereits gelernt!
}

CQETConstructor: {
	DisplayName: Selbstkonstruktor (Quantenverschränkungsturm)
	Tooltip:
		'''
		Nach dem Platzieren zum Bau eines Quantenverschränkungsturms
		Benötigt große Mengen [i:CalamityOverhaul/StarflowPlatedBlock] Sternstrom-Plattierungsblöcke
		'''
	UseConstructionBlueprint: Konstruktionsbauplan lernen (Quantenverschränkungsturm)
}

DeploySignaltower: {
	DisplayName: Quantenverschränkungsturm
	Tooltip:
		'''
		Wichtiges Kommunikationsgerät, das als Leuchtfeuer im Subraum dient
		„Ein Wildkind hebt eine Fackel im Wald und ruft: Ich bin hier“
		'''
}

PQCD: {
	DisplayName: Tragbarer Quantenkommunikator
	Tooltip:
		'''
		Benutzen kontaktiert Draedon und öffnet Draedons Arsenal-Hologramm-Shop
		„Theoretisch für ein Exterminationsdekret – scheinbar fehlt die Berechtigung“
		'''
	NeedSignalTowersText: Quantenverschränkungsverbindung unvollständig! Alle {0} Signaltürme müssen deployt sein
	SignalTowerProgressText: Signalturm-Fortschritt: {0}/{1}
}

Oceanfragments: {
	DisplayName: Meeresfragmente
	Tooltip: Ein mysteriöses Kleinod – Der Alte Herzog könnte Interesse haben
}

OceanRaiders: {
	WorkingText: Arbeitet …
