Mewtwo: {
	DisplayName: Braindance-Chip
	Tooltip: Nutzen, um eine Braindance zu betreten
}

GaolCellKey: {
	DisplayName: Schlüssel der Tiefenzelle
	Tooltip:
		'''
		Errichtet an Ort und Stelle die Tiefenzelle; auf dem Altar liegt ein schlummernder Dörrschädel (Testgegenstand)
		Tritt an den Altar, um ihn zu wecken; während des Kampfs versiegeln Geisterpulver-Gitter die Seitentüren
		Nach dem Sieg über den Zellengeist erlischt die Zelle für immer; ein entkommener Geist schlummert nach wenigen Sekunden wieder
		"Dreh den Schlüssel, und die Wände erinnern sich an ihre Form"
		'''
	BuiltHint: Die Zelle steht; der Dörrschädel auf dem Altar wartet, bis du näherkommst
}

RustedGaolIrons: {
	DisplayName: Verrostete Fußfesseln
	Tooltip:
		'''
		Verteidigung +3, immun gegen Rückstoß
		Nach einem Treffer kurz höheres Bewegungstempo
		"Die Zellennummer innen am Ring ist schon glattgeschliffen"
		'''
}

UndrownedShackleCharm: {
	DisplayName: Ankerring der Versunkenen
	Tooltip:
		'''
		Im Wasser wie auf festem Boden, Schwimmfähigkeit
		Atemzeit unter Wasser stark verlängert
		"Der Anker liegt am Grund, der Mensch atmet noch"
		'''
}

GaolAnchorWeapon: {
