		'''
}

FloodGalleryKey: {
	DisplayName: Schlüssel der Fluthalle
	Tooltip:
		'''
		Errichtet an Ort und Stelle die Fluthalle und setzt den Anker-Toten ein (Testgegenstand)
		"Die Wasserstandsmarken an der Wand sind seine Pulsuhr"
		'''
	Placed: Die Fluthalle steht. Willst du ihn wecken, stell dich auf das linke Ventilpodest und rühr dich nicht.
}

ProofSealCharm: {
	DisplayName: Prüfstempel
