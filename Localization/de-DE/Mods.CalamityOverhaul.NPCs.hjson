SeaShrimpBoss: {
	DisplayName: Abgrundkristallgarnele
	Bestiary: Der Panzer-Tyrann der tiefsten Rinne. Seine Riesenschere schlägt schneller, als Schall im Wasser läuft; wo die Faust fährt, reißt das Meer ein Vakuum, und die implodierende Blase blitzt hell wie der Tag. Fischer sagen, die Wasserfontänen, die grundlos aus ruhiger See schießen, sind nur sein Fausttraining in der Tiefe.
	ChecklistSpawnInfo: Im Ozean kristallisierten Garnelenköder zum Beschwören benutzen
}

BssHead: {
	DisplayName: Wildblüten-Sandschlange
	Bestiary: Eine Riesenschlange, die unter den Dünen zieht. Kakteen haben in ihrem Rückenpanzer Wurzeln geschlagen, die roten Blüten saufen sich an ihrem Blut satt und blühen umso prächtiger. Man sagt, wenn ein Sandsturm aufzieht, wälzt sie sich darunter um.
	ChecklistSpawnInfo: Nach dem Sieg über das Auge von Cthulhu eine dornige Blütenknospe an der Wüstenoberfläche zum Beschwören benutzen
	BossChecklistIntegration.EntryName: Wildblüten-Sandschlange
}

BssBody.DisplayName: Wildblüten-Sandschlange
BssTail.DisplayName: Wildblüten-Sandschlange

FssHead: {
	DisplayName: Eiterknospen-Sandschlange
	Bestiary: Eine Mutation der Wildblüten-Sandschlange. Schatten sickerte in den Sand, die roten Blüten faulen zu Geschwüren, Ichor trat an die Stelle des Blutes in ihren Adern. Sie ist länger als früher und hungriger. Die goldglänzenden Pfützen in der Wüste sind kein Regen, das ist ihr Speichel.
	ChecklistSpawnInfo: Eine vereiterte Blütenknospe an der Wüstenoberfläche zum Beschwören benutzen
	BossChecklistIntegration.EntryName: Eiterknospen-Sandschlange
}

FssBody.DisplayName: Eiterknospen-Sandschlange
FssTail.DisplayName: Eiterknospen-Sandschlange
