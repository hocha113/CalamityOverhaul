GsMinishark: {
	Desc:
		'''
		Umschmiedung: Hältst du den Abzug, steigt der Hai ins Blut, die Schussfolge wird immer schneller, die Bahn immer wilder
		Ist die Raserei voll, wird jeder vierte Schuss zum Haizahn, reißt die Wunde auf und beißt nach
		Fünfzig-Schuss-Trommel, als Ganzes gewechselt; triffst du beim Wechsel das Leuchtband, startet die nächste Trommel mit halber Raserei
		'''
	Frenzy: Flutwelle!
}

GsPhoenixBlaster: {
	Desc:
		'''
		Umschmiedung: Treffer füttern das Feuernest, die Federflamme der Waffe leuchtet mit den Funken auf, Tötungen füttern schneller
		Bei 24 Funken wird der nächste Schuss zum Phönixsturz, explodiert brennend und spaltet drei jagende Jungvögel
		Beim Nachladen wirbeln versprühte Funken zurück in den Lauf; triffst du das Leuchtband, erhältst du 8 Funken gratis
		'''
	Nirvana: Nirwana!
}

GsBoomstick.Desc:
	'''
	Umschmiedung: Jeder Lauf schickt 4 Schrotkörner zum Fadenkreuz, kein wildes Sprühen mehr
	Die Körner treffen sich am Fadenkreuz und beißen zu, was dort steht, bekommt einen harten Biss
	Knickt den Lauf und lädt beide Hülsen; triffst du das Leuchtband, gibt die nächste Ladung +1 Korn pro Lauf
	'''

GsHandgun: {
	Desc:
		'''
		Umschmiedung: Triffst du dasselbe Ziel dreimal hintereinander, wird der 4. Schuss automatisch zum Druckpunktgeschoss, deutlich mehr Schaden und ignoriert 15 Verteidigung
		Der letzte Kammerreiniger fliegt schwerer und weiter
		Magazin-Schnellwechsel: bei Restmunition wechselt das Magazin extrem schnell, das perfekte Leuchtband ist am breitesten
		'''
	PointShot: Druckpunkt!
}

GsTheUndertaker.Desc:
	'''
	Umschmiedung: Tötest du einen Feind oder bringst ihn an den Rand des Todes, nimmt die Waffe eine Seelenlaterne auf, sie fliegt zurück und heilt dich, einmal pro Magazin
	Der letzte Schuss ist eine Glocken-Schwere, Treffer schlagen eine Klagewelle, Rückstoß verdoppelt
	Kammerweise laden, jederzeit durch Feuern unterbrechbar, so viele Schüsse wie geladen
	'''

GsRedRyder: {
	Desc:
		'''
		Umschmiedung: Die Kupferkugel prallt zweimal zwischen Blöcken, jeder Sprung läutet eine Glocke
		Läuten fünf Glocken in kurzer Zeit am selben Ziel, wird der nächste Schuss zum Geschenk und platzt in buntem Konfetti mit schwerem Schlag
		Hebel lädt Schuss für Schuss, so viele Schüsse wie gedrückt
		'''
	Gift: Geschenk!
}

GsPewMaticHorn: {
	Desc:
		'''
		Umschmiedung: Sieben Schüsse pro Magazin steigen die Tonleiter, jeder Schuss eine Farbe und ein Ton
		Triffst du dasselbe Ziel mit drei Tönen, erklingt ein Akkord und explodiert in der Farbe des dritten Tons
		Nachladen ist eine aufsteigende Tonleiter; triffst du das Leuchtband am hohen Ton, wird der Akkord dieses Magazins größer und schmerzhafter
		'''
	Chord: Akkord!
}

GsSandgun: {
	Desc:
		'''
		Umschmiedung: Dauerndes Sandstrahlen heizt den Sandtrichter, ist er heiß, brennt der Sand im Lauf zu Glasbolzen
		Glasbolzen sind schneller und durchschlagen, Treffer spritzen klirrende Splitter; lässt du los, kühlt es langsam
		Normale Sandgeschosse behalten ihren alten Charakter; triffst du das Leuchtband, brennt der Trichter sofort voll
		'''
	Molten: Schmelzglas!
}

GsBlowpipe.Desc:
	'''
	Umschmiedung: Treffer am selben Ziel ziehen einen Giftfaden, bei drei Fäden platzt stehender Giftnebel
	Nachladen ist Atemholen, ein Dart pro Zug, jederzeit unterbrechbar; stillstehen holt ein Viertel schneller Atem
	Triffst du das Leuchtband, zündet der nächste Treffer die Giftfäden sofort
	'''
GsBlowgun.Desc:
	'''
	Umschmiedung: Ein langer Atem bläst fünf Darts, jeder schneller und härter als der letzte
	Der fünfte Dart leert die Lunge und platzt in eine große Giftwolke
	Atemzug für Atemzug, unterbrechbar, stillstehen holt schneller Atem; triffst du das Leuchtband, startet das ganze Magazin mit dem Schwung des dritten Zugs
	'''
GsHarpoon.Desc:
	'''
	Umschmiedung: Die Kettengabel fliegt hin und zurück, die Kette einholen ist das Nachladen
	Triffst du einen schweren Feind, wird er zum Anker, noch einmal Abzug, und die Winde reißt dich hin
	Triffst du einen leichten Feind, umgekehrt: die Rückkette zerrt ihn vor dich
	'''
GsFlareGun.Desc:
	'''
	Umschmiedung: Rot, Grün, Blau, Weiß, vier Signalhülsen im Wechsel, nageln sich ins Ziel und brennen weiter
	Genagelte Feinde erleiden 12% mehr Schaden von dir, die weiße Schluss-Hülse hebt das auf 16%
	Dreht den Behälter und lädt in zwei Takten; triffst du das Leuchtband, feuert der nächste Schuss zwei Hülsen
	'''
GsFlintlockPistol.Desc:
	'''
	Reforged: two chambers, the second shot comes 40% faster;
	the last chamber fires a V-shaped double ball from a single bullet with doubled knockback.
	Hit the sweet spot when reloading for +25% on the next shot
	'''
GsMusket.Desc:
	'''
	Reforged: a true muzzle-loader; every ball is a stone-piercer that flies faster and punches through one more foe.
	Reload in three beats: pour, ram, prime
	'''
GsQuadBarrelShotgun.Desc:
	'''
	Umschmiedung: Vier Läufe feuern nacheinander im Schnellwechsel, einer nach dem anderen; der 4. Lauf donnert 8 Schrotkörner auf einmal und der Rückstoß schleudert dich weg
	Nach unten feuern stößt dich in die Luft
	Klappt die Läufe zum Laden auf; triffst du das Leuchtband, gibt die nächste Runde jedem Lauf 2 Körner extra
	'''
GsRevolver.Desc: Reforged: a six-round cylinder; the final chamber always hits +40% harder.

GsCandyCornRifle: {
	Desc: Reforged: the classic spray now droops on a sweet arc
	ModeCandyRain: Zuckerregen
}

GsClockworkAssaultRifle: {
	Desc: Reforged: keeps the classic three round burst, the third round bites 30% harder
	ModeGearBurst: Zahnrad-Salve
}

GsGatligator: {
	Desc: Reforged: keeps the wild spray but every round skips once off blocks
	ModeSwampRiot: Sumpfwoge
}

GsMegashark: {
	Desc:
		'''
		Reforged: fire rate climbs the longer you hold the trigger
		Land 50 hits to draw blood: for 3 seconds every hit leaves a bleeding wound
		'''
	ModeFrenzy: Fressrausch
}

GsOnyxBlaster: {
	Desc:
		'''
		Umschmiedung: Rechtsklick wechselt die Ladung
		Onyx-Salve: Am Detonationspunkt bleibt ein dunkler Fleck, der Feinde nach innen zieht
		Singularitätsladung: Langsamer, wirft eine riesige Onyxkugel; die Explosion zieht alles zum Kern und sprüht deine Kugeln im Ring
		'''
	ModeVolley: Onyx-Salve
	ModeSingularity: Singularitätsladung
}

GsSDMG: {
	Desc: Reforged: keeps the legendary fire rate
	ModeDolphinTide: Delfinflut
}

GsShotgun: {
	Desc:
		'''
		Reforged: six drooping pellets in a broad fan; landing 3 pellet hits in one blast bursts a rain of lead over the target
		Every trigger pull still costs one shell
		'''
	ModeWideBore: Weite Mündung
}

GsSniperRifle: {
	Desc:
		'''
		Umschmiedung: Kurzer Rechtsklick wechselt den Feuermodus, Halten zoomt
		Scharfschuss: Zeichnet eine durchschlagende Visierlinie; stillstehen hält den Atem an, der gehaltene Schuss ist immer kritisch
		Schnellfeuer: Tauscht Kraft gegen Tempo
		'''
	ModeSnipe: Scharfschuss
	ModeRapid: Schnellfeuer
}

GsTacticalShotgun: {
	Desc: Reforged: paints the spread cone so you know exactly what the six pellets cover
	ModeFan: Taktischer Fächer
}

GsUzi: {
	Desc:
		'''
		Reforged: sprays 30% faster with a loose pattern
		Every 4th round is an amber tracer: tracer hits light the target up, and your Uzi rounds dig 10% deeper into lit targets
		'''
	ModeAkimbo: Beidhändig-Sperrfeuer
}

GsVenusMagnum: {
	Desc: Reforged: after a crit the next round pierces one extra foe, the aim line lights up for the window
	ModeFocus: Goldkelch-Fokus
}

GsVortexBeater: {
	Desc: Reforged: keeps the classic storm, rockets gently home in
	ModeSweep: Vortex-Sperrfeuer
}

GsXenopopper: {
	Desc: Reforged: pops five bubbles that converge and burst in a crossfire on your cursor
	ModeCluster: Bündel
}

GsShotgunLeadRainProj.DisplayName: Fallender Bleiregen
GsUziTracerProj.DisplayName: Bernstein-Leuchtspur
