KikasaTrialQuestLine: {
	QuestCategory: Prüfung
	TrackerWaiting: Noch nicht am Platz
	TrackerFighting: "{0}: {1:0%}"
	TrackerBrief: Nächster Platz: {0}
	BossRushTargetName: Schlacht von Terminus
	EventActiveFormat: "{0}: im Gange"
	Trial_0: Weiches erstes Gericht
	Trial_1: Nachtauge am Himmel
	Trial_2: Doppelfäulnis der Erde
	Trial_3: Moder unter der Erde
	Trial_4: Süßer Saft und störrische Hufe
	Trial_5: Alte Knochen vor der Tür
	Trial_6: Bunter Götterleim
	Trial_7: Heißes Fleisch quer über den Weg
	Trial_8: Geflügeltes Rosagel
	Trial_9: Goldener Geifer im faulen Sand
	Trial_10: Drei Eisen
	Trial_11: Rote Dschungelblüte
	Trial_12: Kristallschale, federndes Fleisch
	Trial_13: Tempelstein
	Trial_14: Wellenschlagendes Flügelschwein
	Trial_15: Nachtglanz
	Trial_16: Restgesang vor der Tür
	Trial_17: Spiegel hinter dem Mond
	Trial_18: Artgenossen am Tisch
	Trial_19: Alter im Säuremeer
	Trial_20: Götterfresser jenseits des Himmels
	Trial_21: Ungelöschte Feuerfeder
	Trial_22: Höchstes Eisen, höchstes Feuer
	Trial_23: Volles Schlussmahl
	TrialSummary_0:
		'''
		Am Bergfuß liegt etwas Weiches, blau, wackelt ohne Ende
		Der See hat noch nie Gel gekostet. Er will wissen, wie der Biss klingt
		Lock es unter den Schirm. Klebrig ist egal
		Läuft es aus, nenn es Suppe
		'''
	TrialSummary_1:
		'''
		Nachts ein Auge, das sehr unhöflich starrt
		Der See runzelt sich, sobald er den Blick fängt. Die Schirmrippen jucken
		Geh und drück diesen Blick ins Wasser
		Was schaut, muss irgendwann die Augen schließen
		'''
	TrialSummary_2:
		'''
		Aus der Erde: eins lang, oder ein nasses Hirn
		Beide stinken. Der See weist niemanden ab. Was dir über den Weg läuft, das nimmst du
		Stücke nicht auflesen. Die fließen von selbst
		'''
	TrialSummary_3:
		'''
		Unter der Erde fault ein Gedanke, oder ein Nest, das Herzen frisst
		Am Wind merkst du: verdorben
		Der See sagt, verdorben ist auch ein Geschmack. Bring es
		Handschuhe anlassen. Der Saft bleibt kleben
		'''
	TrialSummary_4:
		'''
		Im Regenwald sickert Süßes, im Schnee trotzt etwas
		Bring eins. Der See hat heute für beide Geschmäcker Platz
		Süßes sticht, Trotziges stampft
		Komm nicht mit leeren Händen
		'''
	TrialSummary_5:
		'''
		Vor dem Kerker hängt ein alter Wächter, dem das Wachen zur Sucht wurde
		Knochen weichen nicht auf, der See weiß das. Er will nur das Knacken hören
		Nimm ihm den Atem, behalt den Schlüssel
		Knochensplitter setzen sich. Gut zum Pflastern
		'''
	TrialSummary_6:
		'''
		Ein Gelhaufen kann reden und springen, rot und violett durcheinander
		Wasser hat der See genug. Ihm fehlt ein Bissen so groß
		Reiß es auseinander, sieh, wozu es zerläuft
		Nicht trinken. Das ist nicht für dich
		'''
	TrialSummary_7:
		'''
		In der Hölle steht eine Wand aus Gesichtsfleisch quer über allen Wegen
		Heiß ist gut. Der See kühlt
		Stirbt sie, dreht sich die Welt. Das lastet nicht auf dir
		Die Schirmfläche hält Funken ab. Geh ruhig
		'''
	TrialSummary_8:
		'''
		Über dem Heiligen Land hängt rosa Gel, mit Wache
		Bodengel hat der See schon. Fliegendes noch nicht
		Zieh sie herunter, Knochen und alles
		Tritt nicht auf die Splitter. Die scheuern die Rippen
		'''
	TrialSummary_9:
		'''
		Die Sandschlange ist zurück, rote Blüten zu Eiterbeulen
		Tritt nicht in die goldenen Pfützen. Das ist ihr Speichel
		Der See nimmt jeden Geschmack. Ihm stinkt nur, dass sie den Sand hat sauer werden lassen
		Geh, lad sie auf den Grund, schüttle den Schirm sauber, dann komm
		'''
	TrialSummary_10:
		'''
		Jemand hat drei Eisen gemacht: eine Kette, zwei Lampen, ein Vierarmgestell
		Eisen sinkt nicht durch. Lange genug eingeweicht stinkt es nach Rost
		Der See mag das nicht, aber am Tisch dürfen sie nicht fehlen
		Eins nach dem anderen. Lass sie nicht in derselben Nacht erschrecken
		'''
	TrialSummary_11:
		'''
		Im Regenwald sitzt eine große rote Blume und schläft
		Wer sie weckt, kommt selten ganz zurück
		Der See will ihren Saft. Im Wasser sitzt die Farbe richtig
		Ranken am Schirm einfach schneiden. Keine Höflichkeit
		'''
	TrialSummary_12:
		'''
		Unter dem Strand sitzt eine große Garnele, Kristallpanzer, häutet sich
		Wenn die Schere zuschnappt, knallt das Wasser, eine halbe See weit hörbar
		Der See will diesen federnden Bissen schon lange. Geh, lad sie ein
		Die Schale wechselt sie selbst. Den Schlag pass du auf
		'''
	TrialSummary_13:
		'''
		Im Tempel hockt ein Vierkantkopf
		Stein sinkt am schnellsten. Der Sammlung fehlt genau eins
		Mach die Mechanik kaputt, bring die Schale ganz
		Die Gischt, die dabei aufsteht, ist dein Lohn
		'''
	TrialSummary_14:
		'''
		Auf dem Meer ein Schwein mit Flügeln, das Wellen schlägt wie ein Mensch
		Der See mag das nicht. Das Temperament des Wassers steht keinem Schwein zu
		In welches Wasser du es drückst, sagst du
		Den Köder geb ich. Den Wurm angelst du
		'''
	TrialSummary_15:
		'''
		Nachts fliegt über Heiligem Land etwas Leuchtendes, das Temperament folgt der Sonne
		Der See hält ihr Bild nicht. Zu hell bleibt nicht auf dem Wasser
		Geh nachts, knete das Licht dunkel und bring es
		Reizt du sie am Tag, trägst du die Folge selbst
		'''
	TrialSummary_16:
		'''
		Vor dem Kerker murmelt einer, als ginge der Himmel auf
		Der See versteht keine Sutren. Er versteht nur, dass etwas hereingelassen werden soll
		Unterbrich ihn. Lass das Ritual auf halbem Weg verfaulen
		Fallen Perlen, nicht aufheben. Der See nimmt keine Fälschungen
		'''
	TrialSummary_17:
		'''
		Der hinter dem Mond ist heruntergekommen, überall Augen
		Was vom Himmel fällt, ist im See nur ein Spiegelbild
		Geh, hol das Original des Spiegels
		Das Mondlicht in jener Nacht wird gut sein. Sieh einmal für mich hin
		'''
	TrialSummary_18:
		'''
		Tief im Kerker treibt eine Seele, Jahrhunderte lang geflickt
		Sogar die Geister im See ziehen sich in die Rippen zurück
		Artgenossen umbringen klingt hässlich. Nenn es einen gemeinsamen Tisch
		Nach diesem Auftrag wird es unter dem Schirm enger. Halt durch
		'''
	TrialSummary_19:
		'''
		Unter dem Schwefelmeer liegt ein Altes, sauer im Leib, saurer im Temperament
		Der See und er gehen Jahre nebeneinander. Keiner achtet des anderen Wasser
		Geh und richte aus: der Tisch steht, er möge sinken
		Er beißt, die Zähne sitzen noch. Pass auf
		'''
	TrialSummary_20:
		'''
		Ein langer Wurm kreist jenseits des Himmels, die Sterne weichen aus
		Er hat Götter verschluckt. Der See will wissen, wie ein Gott schmeckt
		Lass ihn einmal in Wasser tauchen, das ihm nicht zusteht
		Die Schale gehört dir. Das Fleisch dem See
		'''
	TrialSummary_21:
		'''
		Am anderen Ende des Dschungels nährt jemand ein Feuer, das brennt, wer weiß wie lange
		Feuer und See sind alte Gegner. Diesmal soll Schluss sein
		Drück das Feuer aus. Die letzte Kelle gießt der See selbst
		Nasse Federn steigen nicht. Lass keine zurück
		'''
	TrialSummary_22:
		'''
		Die letzten zwei Tische zusammen: einer nur Eisen, einer nur Feuer
		Stolz des Handwerkers, Zwang der Hexe. Der See will beide auf dem Grund sehen
		Die Reihenfolge ist deine. Lebend am Tisch reichen
		Nach dieser Mahlzeit ist der See fast voll
		'''
	TrialSummary_23:
		'''
		Sie sind alle wieder da, oder das Alte im Abgrund ist aufgewacht
		Ein voller Tisch. Der See hat vom Warten schon Wasser gezogen
		Du hältst den Schirm. Eins nach dem anderen
		Ist diese Mahlzeit vorbei, hört der Regen auf
		'''
}

