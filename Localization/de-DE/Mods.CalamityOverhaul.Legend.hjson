OnikiriTrialQuestLine: {
	QuestCategory: Prüfung
	TrackerWaiting: Es ist noch nicht da
	TrackerFighting: "{0}: {1:0%}"
	TrackerBrief: Nächster Schnitt: {0}
	BossRushTargetName: Schlacht von Terminus
	EventActiveFormat: "{0}: im Gange"
	Trial_0: Himmelsauge
	Trial_1: Zwei Schändlichkeiten der Erde
	Trial_2: Zusammengeballter Unrat
	Trial_3: Anmaßender Gott
	Trial_4: Fleischwand der Grenze
	Trial_5: Eiternde Sandschuppen
	Trial_6: Abgrundglut
	Trial_7: Dröhnende Eisenschlange
	Trial_8: Zwillingsdämonenaugen
	Trial_9: Alte und neue Trümmer
	Trial_10: Nachgeahmter Schatten
	Trial_11: Dschungelblüte
	Trial_12: Tempeltrotzkopf
	Trial_13: Irrer Gesang am Tor
	Trial_14: Lastender Mond
	Trial_15: Glut des Erdkerns
	Trial_16: Feuchtes Geisterknäuel
	Trial_17: Leerenverschlinger
	Trial_18: Zurückgelassener Feuerdrache
	Trial_19: Sternenstrom-Donner
	Trial_20: Erstickende Kalamität
	Trial_21: Nacht, die sich wieder sammelt
	TrialSummary_0:
		'''
		Am Himmel ist irgendwas, ich weiß auch nicht was
		Fühlt sich an, als würde uns jemand anstarren, und die Klinge wird unruhig
		Geh nachsehen, komm zurück und sag mir, was das überhaupt war
		Ach ja, nicht zu lange den Kopf in den Nacken. Tut der Nacken weh
		'''
	TrialSummary_1:
		'''
		Aus der Erde kommen zwei schiefe Sachen, ich unterscheide sie nicht
		Was zuerst den Kopf rausstreckt, das schneidest du. Nicht beide zugleich anstarren
		Die Klinge merkt, wenn der Geschmack nicht stimmt. Du gehst vor
		'''
	TrialSummary_2:
		'''
		Da hat sich Unrat zu einem Klumpen geballt, schon der Wind davon nervt
		Steh nicht rum und glotz. Geh das wegmachen
		Wenn du zurückkommst, zählt zuerst, dass es erledigt ist
		'''
	TrialSummary_3:
		'''
		Irgendwas nennt sich Gott. Da muss ich schon lachen
		Wären Namen so leicht, würde sich niemand mehr anstrengen
		Geh nachprüfen. Wenn es sich wirklich so nennt, nimm ihm den Namen auseinander
		Hey, ich schick dich nicht zum Beten. Hör zu
		'''
	TrialSummary_4:
		'''
		Vorne ist wie zugemauert, ich sag nicht womit
		Ist der Weg zu, mach ihn auf
		Wie es sich dahinter anfühlt, reden wir, wenn du zurück bist
		'''
	TrialSummary_5:
		'''
		Die Wüste riecht anders, faule Blüten mit Eiter, da wühlt was
		Lass es nicht tiefer graben. Geh und schneid es ab
		Und stoß die Klinge nicht in die Beulen, hier wohnt noch jemand
		'''
	TrialSummary_6:
		'''
		Die Feuergrube da drüben brennt noch, als wollte jemand nicht ausgehen
		Mach sie aus, und pass auf die Füße auf
		Verbrennst du dich, kann ich nicht pusten
		'''
	TrialSummary_7:
		'''
		Da hat eins einen lauten Namen, klingt erst mal furchteinflößend
		Im Eisen rührt sich was. Geh und stoß nach, ob das nur große Töne sind
		Wett nicht mit ihm, wessen Name größer ist
		'''
	TrialSummary_8:
		'''
		Zwei Punkte am Himmel, als hätten sie sich verabredet
		Kommen sie als Paar, trenn sie. Lass dich nicht von beiden anstarren
		Wenn du zurück bist, kannst du meckern, ob sie wie Menschen aussehen
		'''
	TrialSummary_9:
		'''
		Alt und neu durcheinander, sieht schief aus, aber ich hab's noch nicht klar
		Geh und sortier das. Lass dich nicht bluffen
		Wenn du zurück bist, reden wir, welche Seite überhaupt echt war
		'''
	TrialSummary_10:
		'''
		Ein Schatten läuft zu sehr wie ein Mensch. Das Gesicht hab ich nicht gesehen, und schon ekelt's mich
		Steh nicht da und starr. Geh das wegmachen
		Wen es nachmacht, das schimpfen wir, wenn du zurück bist
		'''
	TrialSummary_11:
		'''
		Unten blüht was, das nicht blühen sollte. Der Geruch stimmt schon nicht
		Ist sie verblüht, mach sie weg. Lass sie nicht hier, um mich zu nerven
		Blumenhändlerregeln später. Du gehst zuerst
		'''
	TrialSummary_12:
		'''
		Im Steinhaus sitzt eins, das sich nicht gern bewegt. Sieht hart aus
		Wirf es um. Schlag die Klinge nicht gegen Stein, das spür ich auch
		Werden die Hände taub, reib sie, wenn du zurück bist
		'''
	TrialSummary_13:
		'''
		Vor dem Kerker murmelt jemand, als wäre er noch nicht fertig
		Unterbrich das, die Ohren sollen nicht mitmüde werden
		Was er gemurmelt hat, später. Glaub es jedenfalls nicht
		'''
	TrialSummary_14:
		'''
		Auf dem Mond lastet irgendwas. Den Kopf heben fühlt sich schon schwer an
		Geh das wegmachen. Steh nicht nur da und starr nach oben
		Wenn du zurück bist, frag ich, ob du kaputt bist
		'''
	TrialSummary_15:
		'''
		Vom Erdkern her wird's heiß, bei mir fühlt sich's auch vorgewärmt an
		Geh. Die Schneide wird heiß, das weißt du vorher
		Bleib nicht zu lange in der Hitze. Fertig, dann weg
		'''
	TrialSummary_16:
		'''
		In der Feuchte da haben sich Geister zu einem Knäuel geballt. Ich zähl nicht
		Nimm den ganzen Klumpen, nicht eins nach dem anderen
		Übernachte da nicht. Wenn du zurück bist, nörgle ich nochmal
		'''
	TrialSummary_17:
		'''
		Die Richtung ist zu leer, bei mir wird's auch schwer
		Ich kann nicht sagen, was es ist. Es stimmt einfach nicht
		Geh. Steh nicht allein da und glotz. Siehst du nichts klar, pass zuerst auf dich auf
		Reden wir, wenn du zurück bist. Leben geht vor klarsehen
		'''
	TrialSummary_18:
		'''
		Es soll noch so einen Drachen geben. Wahr oder nicht, du gehst hin
		Die Schneide wird wohl heiß. Steck sie nicht gleich weg
		Federn will ich nicht. Hauptsache, du kommst zurück
		'''
	TrialSummary_19:
		'''
		Ein Knall von weit weg, und die Ohren machen zuerst schlapp
		Geh und mach, dass sie aufhören, und schütz die Ohren unterwegs
		Summt's noch, wenn du zurück bist, suchen wir uns was Stilleres
		'''
	TrialSummary_20:
		'''
		Die Luft da ist schwer und stockt, als ginge eine Tür nicht auf
		Geh und mach Schluss. Steh nicht in der Tür und atme das ein
		Wenn du zurück bist, sag ich dir, wie man durchatmet
		'''
	TrialSummary_21:
		'''
		Sie sammeln sich wieder, als ginge nie etwas ganz auseinander
		Das hier wird länger
		Steh fest, bevor es losgeht. Wackeln nörgle ich, wenn du zurück bist
		'''
}

KikasaOverride: {
	DisplayName: Kikasa
	Tooltip:
		'''
		Linke Taste halten, den Schirm über den Kopf heben, im Takt fällt Tintenregen, der Feinde verfolgt
		Rechte Taste halten, den Schirm umdrehen und Tinte sammeln; loslassen gießt einen Tintenfall
		Regen und Fall, die du selbst führst, stempeln ein Tintenmal; Diener treffen Malträger härter
		'''
	GhostCountLine: Beschwörungsplätze {0} · {1}
	TierName0: Niesel
	TierName1: Seitwurf
	TierName2: Salve
	TierName3: Seekippen
