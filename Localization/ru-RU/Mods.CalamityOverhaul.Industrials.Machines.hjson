}

WGGLifeWeaver: {
	TurretBatteryDepleted: Батарея разряжена
	DisplayName: Сажатель деревьев пустошей
	Tooltip: ""
}

Incinerator: {
	DisplayName: Электрический инсинератор
	Tooltip:
		'''
		Потребляет энергию для переплавки предметов
		Нажмите ПКМ, чтобы открыть панель управления
		Shift + ПКМ позволяет быстро положить сырье или забрать результат переплавки
		Переплавка предметов дает удвоенное количество материалов
		'''
}

Crusher: {
	DisplayName: Рудодробилка
	Tooltip:
		'''
		Тратит электричество и дробит руду: из двух порций выходят три той же руды
		ПКМ открывает панель
		Shift+ПКМ быстро кладёт руду или забирает дроблёнку
		Дроблёнка, снова брошенная в мусоросжигатель, даёт на половину больше слитков из той же руды
		'''
}

