HerbFarmer: {
	NoEnergyText: Нехватка энергии!
	DisplayName: Травяная ферма
	Tooltip:
		'''
		Тратит семена и электричество и сама сеет на подходящей почве вокруг
		Собирает цветущие травы — даёт травы и семена
		ПКМ открывает панель
		'''
}

MushroomFarmer: {
	NoEnergyText: Нехватка энергии!
	FullText: Бункер выхода полон!
	DisplayName: Грибная ферма
	Tooltip:
		'''
