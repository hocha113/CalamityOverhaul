ExcavationBoosterModule: {
	DisplayName: Модуль ускорения выработки
	Tooltip:
		'''
		На добывающей машине цикл работы короче на 30%
		У шестерён зубы стали жёстче
		'''
}

PickPowerBoosterModule: {
	DisplayName: Модуль силы кирки
	Tooltip:
		'''
		На добывающей машине сила кирки +60%
		Железная коробка начинает грызть мифрил
		'''
}

ChlorophyteDrillModule: {
	DisplayName: Хлорофитовый буровой модуль
	Tooltip: Само сверло отлито из хлорофитовых слитков — руду добывают рудой
}

EfficiencyModule: {
	DisplayName: Модуль КПД
	Tooltip:
		'''
		На добывающей машине расход энергии за цикл падает до 60%
		Тугая медная катушка больше не обжигает пальцы
		'''
}

YieldBoosterModule: {
	DisplayName: Модуль выхода
	Tooltip:
		'''
		На добывающей машине шанс успешной добычи +35%
		Сито на номер гуще
		'''
}

ProspectorModule: {
	DisplayName: Модуль разведки
	Tooltip:
		'''
		На добывающей машине вес редких побочных продуктов — самоцветов, окаменелостей, метеорита — утраивается
		Под линзой даже гравий делится на сорта
		'''
}

SurveyArrayModule: {
	DisplayName: Модуль разведывательной решётки
	Tooltip:
		'''
		На добывающей машине радиус разведки +50%
		Эхо приходит раньше сверла
		'''
}

VeinFocusModule: {
	DisplayName: Модуль фокуса жилы
	Tooltip:
		'''
		На добывающей машине бонус настоящей жилы к выходу +60%
		Идите по жиле, не спорьте с камнем
		'''
}

DoubleLoadModule: {
	DisplayName: Модуль двойной загрузки
	Tooltip:
		'''
		На добывающей машине каждый выход с шансом 25% удваивается
		Ковш приварили шире на круг
		'''
}

OverdriveCoreModule: {
	DisplayName: Модуль ядра перегруза
	Tooltip:
		'''
		На добывающей машине цикл короче на 45%, расход энергии +60%
		Пока подшипник не раскалился — останавливаться не собирается
		'''
}

ThrottleValveModule: {
	DisplayName: Модуль дросселя
	Tooltip:
		'''
		На добывающей машине цикл длиннее на 50%, расход энергии падает до 45%
		Медленно, но ей принадлежит вся ночь
		'''
}

ChestLinkModule: {
	DisplayName: Модуль контейнерной связки
	Tooltip:
		'''
		На добывающей машине выход сразу кладётся в ближайший сундук; на землю — только если не влезло
		Не надо нагибаться
		'''
}

SmelterModule: {
	DisplayName: Модуль плавки на месте
	Tooltip:
		'''
		На добывающей машине руда плавится в слитки по рецепту печи, расход энергии +40%
		Из шахты сразу слиток
		'''
}

MachineModuleText: {
	TagText: Модуль улучшения машины
	TargetsLine: Подходит: {0}
	HowToText: ПКМ по нужной машине открывает панель; положите модуль в слот — и он заработает
	SocketOnly: Эта машина не примет этот модуль!
	SocketDuplicate: Модуль того же типа уже стоит!
	SocketEmptyHint: Положите модуль улучшения
