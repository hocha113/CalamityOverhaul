	NameCrusher: Дробилка
	NameRecycler: Переработчик
	NameMagma: Магмовый теплогенератор
	NameBiomass: Биогенератор
	NameTurret: Оборонительная башня
	NameSolar: Солнечная панель
}

InsulationLiningModule: {
	DisplayName: Модуль теплоизоляции
	Tooltip:
		'''
		На теплогенераторе теплопотери падают до 55%
		Три слоя асбеста — жару наружу не выйти
		'''
}

ForcedDraftModule: {
	DisplayName: Модуль принудительной тяги
	Tooltip:
		'''
		На теплогенераторе горение +45%: огонь злее и топливо кончается быстрее
		Мехи нажали — угли встали дыбом
		'''
}

SlowBurnValveModule: {
	DisplayName: Модуль медленного горения
	Tooltip:
		'''
		На теплогенераторе горение падает до 60%: одна порция топлива живёт дольше
		Пламя ужали, один уголь тянет полночи
		'''
}

HeatRecoveryModule: {
	DisplayName: Модуль возврата тепла
	Tooltip:
		'''
		На теплогенераторе тепло от топлива +25%
		В дымоходе два лишних колена — убежавшее тепло тащат назад
		'''
}

AutoFeedHopperModule: {
	DisplayName: Автоматический бункер подачи
	Tooltip:
		'''
		На теплогенераторе, мусоросжигателе или биогенераторе сам докладывает сырьё из соседнего хранилища
		Бункер берёт только пустые слоты — руку больше не суют
		'''
}

ExtendedBladesModule: {
	DisplayName: Модуль удлинённых лопастей
	Tooltip:
		'''
		На ветрогенераторе выход +30%
		Лишний кончик лопасти ловит ветер задаром
		'''
}

LowWindGearboxModule: {
	DisplayName: Модуль низкоскоростной коробки
	Tooltip:
		'''
		На ветрогенераторе нижняя граница множителя ветра поднимается с 0.8 до 1.3
		Передаточное мельче — и слабый ветер крутит
		'''
}

TallTowerModule: {
	DisplayName: Модуль высокой мачты
	Tooltip:
		'''
		На ветрогенераторе выход +15%, складывается с удлинёнными лопастями
		На десять метров выше — ветер на ступень сильнее
		'''
}

FlowShroudModule: {
	DisplayName: Модуль направляющего кожуха
	Tooltip:
		'''
		На гидрогенераторе выход +30%
		Раструб собирает разбросанную воду в одну струю
		'''
}

QuickSpinModule: {
	DisplayName: Модуль быстрого разгона
	Tooltip:
		'''
		На гидрогенераторе набор оборотов утраивается
		Завели пружину — вода упала, и уже рабочие обороты
		'''
}

DeepBearingModule: {
	DisplayName: Модуль глубоководного подшипника
	Tooltip:
		'''
		На гидрогенераторе выход +15%, складывается с направляющим кожухом
		Вал воду не ест — вся сила колесу
		'''
}

HighTempElectrodeModule: {
	DisplayName: Модуль высокотемпературных электродов
	Tooltip:
		'''
		На мусоросжигателе плавка +45%
		Два стержня сошлись — дуга приходит раньше печного жара
		'''
}

EconomizerCoilModule: {
	DisplayName: Модуль экономной катушки
	Tooltip:
		'''
		На мусоросжигателе расход на плавку падает до 60%
		Поставили тонкий лак — счётчик крутится вежливее
		'''
}

TwinCrucibleModule: {
	DisplayName: Модуль сдвоенного тигля
	Tooltip:
		'''
		На мусоросжигателе каждая плавка с шансом 25% даёт двойной выход
		Один огонь — две чаши
		'''
}

AutoEjectChuteModule: {
	DisplayName: Автоматический жёлоб выгрузки
	Tooltip:
		'''
		На мусоросжигателе готовое само уходит в соседнее хранилище
		Жёлоб положили — из печи сразу на склад
		'''
}

CapacityCellModule: {
	DisplayName: Модуль расширенной батареи
	Tooltip:
		'''
		На любой машине потолок запаса +50%
		Эти пластины узнает любая розетка
		'''
}

TurretRangefinderModule: {
	DisplayName: Модуль дальномерных линз
	Tooltip:
		'''
		На оборонительной башне радиус захвата +25%
		Для щитовых и лечебных башен расширяет ауру
		Линза видит врага раньше дула
		'''
}

TurretAutoloaderModule: {
	DisplayName: Модуль быстрой перезарядки
	Tooltip:
		'''
		На оборонительной башне темп огня +30%
		У башен-аур нет ритма стрельбы — модуль им ни к чему
		Предыдущий выстрел ещё не сел — следующий уже в патроннике
		'''
}

TurretPowerSaverModule: {
	DisplayName: Модуль экономии огневого контура
	Tooltip:
		'''
		На оборонительной башне расход энергии падает до 75%
		И разовый, и постоянный расход его слушаются
		На осаде счётчик наконец крутится медленнее
		'''
}

