ThermalBattery: {
	DisplayName: Тепловая батарея
	Tooltip: Хранит определённое количество электрической энергии
}

FluidPipeline: {
	DisplayName: Жидкостная труба
	Tooltip:
		'''
		Переносит воду, лаву, мёд или Мерцание
		Одна труба в один момент несёт только одну жидкость; сменит вид, лишь когда опустеет
		ПКМ быстро демонтирует
		'''
}

FluidTank: {
	DisplayName: Жидкостный резервуар
	Tooltip:
		'''
		Хранит до 32 клеток жидкости; смотровое окно на корпусе показывает уровень
		Соединён жидкостными трубами с насосами и машинами
		При демонтаже жидкость внутри теряется
		'''
}

LargeFluidTank: {
	DisplayName: Большой жидкостный резервуар
	Tooltip:
		'''
		Хранит до 128 клеток жидкости; смотровое окно на корпусе показывает уровень
		Соединён жидкостными трубами с насосами и машинами
		При демонтаже жидкость внутри теряется
		'''
}

FluidText: {
	WaterName: Вода
	LavaName: Лава
	HoneyName: Мёд
	ShimmerName: Мерцание
	EmptyName: Пусто
	BarFormat: "{0} {1}/{2}"
}

CapacitorMatrix: {
	DisplayName: Конденсаторная матрица
	Tooltip:
		'''
		Большой шкаф запаса на 40000 энергии
		Заряд и разряд далеко превосходят тепловую батарею — буфер большой сети
		'''
}

UEPipeline: {
	DisplayName: Трубопровод подачи энергии
	Tooltip:
		'''
		Используется для передачи электрической энергии
		Щёлкните ПКМ, чтобы быстро демонтировать и забрать трубопровод в месте курсора
		Подключается к генераторам и другим источникам питания для передачи энергии в батареи или электрические устройства
		'''
}

LaserEnergyTrans: {
	DisplayName: Лазерный Энергопередатчик
	Tooltip:
		'''
		Дистанционная передача энергии.
		После установки щёлкните правой кнопкой мыши, чтобы активировать лазерную навигацию,
		затем щёлкните ПКМ по другим энергетическим сооружениям для их подключения.
		Чем больше расстояние передачи, тем выше потери энергии.
		Максимальная потеря — 100%.
		'''
}

CreativeUEPipeline: {
	DisplayName: Энергопровод Бога
	Tooltip: ""
}

ItemPipeline: {
	DisplayName: Логистическая труба
	Tooltip:
		'''
		Используется для транспортировки предметов
		Нажмите ПКМ, чтобы быстро демонтировать и забрать трубу (работает, когда труба в руках)
		Нажмите ПКМ по концу трубы, чтобы переключить режим Входа/Выхода (работает, когда в руках нет трубы)
		Труба в режиме Выхода извлекает предметы из контейнера и передает их в контейнер, подключенный к трубе в режиме Входа
		'''
}
