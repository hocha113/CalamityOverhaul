	// DeedHint: Hold one spot for thirty seconds of combat without taking a hit, and the sand can be raked
}

OniMeiRubbingSenju: {
	// DisplayName: Senju
	// Tooltip: Six ghost arms join the Finale Slash freeze; afterwards vigor zeroes and dashing is locked 3s
	// Origin: One hand, one name. Every boss sent off by Finale must be counted
