QuestLogBook: {
	DisplayName: Книга заданий
	Tooltip: Используйте, чтобы открыть или закрыть интерфейс заданий
}

MermanRod: {
	Text1: В этом мире уже установлена Удочка рыболюда!
	DisplayName: Удочка рыболюда
	Tooltip:
		'''
		Увеличивает силу рыбалки на 20, если находится рядом
		Старый герцог перенесет свой лагерь в это место
		'''
}

MiningMachineMk2: {
	DontWork: Требуется размещение на твердой поверхности для бурения
	DisplayName: Буровая установка MK2
	Tooltip:
		'''
		Потребляет энергию для добычи руды
		Должна быть размещена в подходящем месте для корректной работы
		В особых биомах может добывать уникальные минералы
		'''
}

UniversalFrost: {
	DisplayName: Вселенская стужа
	Tooltip:
		'''
		Использует снежки в качестве боеприпасов
		Выстреливает градом и ледяными новами. Кристальные сферы отскакивают, наводятся и испускают морозные лучи при взрыве
		Непрерывная стрельба накапливает морозную энергию. При полном заряде следующий выстрел вызовет Ледниковый период
		Ледниковый период призывает массивные ледяные шипы и снежную бурю в месте курсора
		"Когда всё сущее умолкнет, лишь вечный иней покроет мир"
		'''
}

GodslayerScabbard: {
	DisplayName: Ножны Богоубийцы
	Tooltip:
		'''
		Накапливает заряд "Иайдо", когда вы держите оружие ближнего боя, но не атакуете
		Атака при полном заряде дает 2 секунды неуязвимости
		"Клинок еще в ножнах, но жажда убийства уже пронзает холод.
		Когда придет час, убийство бога займет лишь мгновение"
		'''
}

Lumberjack: {
	Text1: Слишком много предметов!
	Text2: Недостаточно энергии!
	CycleModeText: Цикличный режим
	ClearModeText: Режим очистки
	DisplayName: Дровосек
	Tooltip:
		'''
		Потребляет энергию для вырубки леса
		Автоматически рубит деревья вокруг
		Нажмите ПКМ для переключения между Цикличным режимом и Режимом очистки
		Цикличный режим непрерывно рубит деревья и позволяет саженцам расти заново
		Режим очистки только рубит деревья, не позволяя саженцам расти
		'''
}

LifeWeaver: {
	NoValidPositionText: Рядом нет места для посадки!
	NoEnergyText: Недостаточно энергии!
	DisplayName: Ткач жизни
	Tooltip: Потребляет энергию для посадки деревьев вокруг
}

WGGLumberjack: {
	DisplayName: Дровосек пустошей
	Tooltip: ""
}

WGGLifeWeaver: {
	DisplayName: Ткач жизни пустошей
	Tooltip: ""
}

Incinerator: {
	DisplayName: Электрический инсинератор
	Tooltip:
		'''
		Потребляет энергию для переплавки предметов
		Нажмите ПКМ, чтобы открыть панель управления
		Shift + ПКМ позволяет быстро положить сырье или забрать результат переплавки
		Переплавка предметов дает удвоенное количество материалов
		'''
}

ItemPipeline: {
	DisplayName: Логистическая труба
	Tooltip:
		'''
		Используется для транспортировки предметов
		Нажмите ПКМ, чтобы быстро демонтировать и забрать трубу (работает, когда труба в руках)
		Нажмите ПКМ по концу трубы, чтобы переключить режим Входа/Выхода (работает, когда в руках нет трубы)
		Труба в режиме Выхода извлекает предметы из контейнера и передает их в контейнер, подключенный к трубе в режиме Входа
		'''
}

Thrower: {
	NoEnergyText: Недостаточно энергии!
	NoItemText: Нет предметов для броска!
	WorkingText: Бросок...
	IdleText: Ожидание
	DisplayName: Выбрасыватель
	Tooltip:
		'''
		Потребляет энергию для выбрасывания предметов
		Нажмите ПКМ, чтобы открыть панель управления
		'''
}

Elysium: {
	DisplayName: Элизиум
	Tooltip: ""
	DiscipleName_0: Симон Петр
	DiscipleName_1: Святой Андрей
	DiscipleName_2: Иаков
	DiscipleName_3: Святой Иоанн
	DiscipleName_4: Филипп
	DiscipleName_5: Варфоломей
	DiscipleName_6: Фома
	DiscipleName_7: Святой Матфей
	DiscipleName_8: Иаков Алфеев
	DiscipleName_9: Фаддей
	DiscipleName_10: Симон Зилот
	DiscipleName_11: Иуда
	HorsemanName_0: Чума
	HorsemanName_1: Война
	HorsemanName_2: Голод
	HorsemanName_3: Смерть
	DiscipleFullText: Максимум апостолов
	NoConvertTargetText: Поблизости нет жителей для обращения
	DiscipleFallbackText: Апостол
	RevelationText: Откровение
	RevelationEndText: Откровение прервано
	CelestialMeteorText: Небесный метеорит
	SealStarsText: Пятая звезда Шестая звезда Седьмая звезда
	HorsemenFullText: Четыре всадника в сборе
	HorsemanArrivalText: "{0} прибыл"
	DiscipleJoinedText: "{0} присоединился"
	JudasBetrayalText: Предательство Иуды!
	JudasDeathReasonText: Иуда предал {0}
	DiscipleMartyrText: "{0} принял мученическую смерть"
