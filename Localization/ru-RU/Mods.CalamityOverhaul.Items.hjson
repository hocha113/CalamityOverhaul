		DisplayName: Волшебная раковина
		Tooltip: Прислушайся — услышишь шум океана
	}
}

GraniteTome: {
	DisplayName: Гранитный том
	Tooltip:
		'''
		Призывает медленную самонаводящуюся сферу гранитной энергии
		При ударе рассыпается на самонаводящиеся кристальные осколки
		'''
}

GraniteFlower: {
	DisplayName: Гранитный цветок
	Tooltip:
		'''
		Выпускает кристальное семя, которое распускается в долговечный энергетический цветок
		Цветок несколько раз пульсирует, разбрасывая вокруг кристальные лепестки
		'''
}

GraniteThrowingKnife: {
	DisplayName: Гранитный метательный нож
	Tooltip:
		'''
		Метает пронзающий нож, оставляющий след кристаллической энергии
		Рассыпается на кристальные осколки при последнем попадании или о рельеф
		'''
}

GraniteWalkingBoots: {
	DisplayName: Гранитные сапоги-скороходы
	Tooltip:
		'''
		Значительно повышает скорость бега и ускорение
		На полной скорости потрескивает синими искрами
		'''
}

MarbleClub: {
	DisplayName: Мраморная дубина
	Tooltip:
		'''
		Медленный, тяжёлый замах с сокрушительным отбрасыванием
		Может обращать врагов в камень, ненадолго замедляя их
		Первое попадание каждого замаха высвобождает мраморную ударную волну
		'''
}

MarbleHuntingKnife: {
	DisplayName: Мраморный охотничий нож
	Tooltip:
		'''
		Стремительные режущие удары
		Каждый третий удар — более широкий завершающий взмах, разбрасывающий мраморные осколки
		'''
}

MarbleDisc: {
	DisplayName: Мраморный диск
	Tooltip:
		'''
		Метает вращающийся диск, рикошетящий между врагами и стенами
		Затем по дуге возвращается в руку; одновременно могут лететь до двух
		'''
}

MarblePebble: {
	DisplayName: Мраморный камешек
	Tooltip:
		'''
		Бесконечный камень для пращи, быстрый и склонный к критическим ударам
		Наносит гораздо больше урона врагам с высоким запасом здоровья
		Один раз отскакивает от земли
		'''
}

MarbleShield: {
	DisplayName: Мраморная эгида
	Tooltip:
		'''
		Повышает защиту и сопротивление отбрасыванию
		Поддерживает восстанавливающийся каменный щит, который поглощает входящий удар, разлетаясь на осколки
		Приготовьтесь к идеальному блоку, отражающему снаряды
		'''
}

MarbleBalloon: {
	DisplayName: Мраморный шар
	Tooltip:
		'''
		Нажмите «вниз» в воздухе, чтобы рухнуть вниз и при приземлении выпустить ударную волну
		Сводит на нет урон от падения
		'''
}

MarbleinaBottle: {
	DisplayName: Мрамор в бутылке
	Tooltip: Даёт тяжёлый второй прыжок
}

MarbleCloudBalloon: {
	DisplayName: Мраморный облачный шар
	Tooltip:
		'''
		Даёт тяжёлый второй прыжок
		Нажмите «вниз» в воздухе, чтобы рухнуть вниз и при приземлении выпустить ударную волну
		Сводит на нет урон от падения
		'''
}

