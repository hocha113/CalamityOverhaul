}

OmniElectricFoot: {
	DisplayName: Всеэлектрическая киберстопа
	Tooltip:
		'''
		Высокопроизводительный локомоторный киберимплант с электромагнитной отдачей и плотным тяговым гелем
		Даёт двойной прыжок в воздухе
		Наведите сектор «Зарядный прыжок» в радиальном меню киберимплантов, удерживайте и отпустите
		Полный заряд — более чем вдвое выше обычного прыжка
		'''
	SkillHint: Наведите «Зарядный прыжок» в радиальном меню {0}, чтобы зарядить
	SkillName: Зарядный прыжок
	SkillDesc:
		'''
		Взрывной прыжок на электромагнитной тяге
		Нужно стоять на земле; время наведения = время зарядки
		Отпустите клавишу — до 2,5× высоты обычного прыжка при полном заряде
		'''
}

PlowSteelClampArm: {
	DisplayName: Плугостальная клещевая рука
	Tooltip:
		'''
		Промышленный киберимплант с магнитным подбором и жёсткими клещами
		Значительно увеличивает дистанцию копания и установки блоков
		Постоянно включает магнитный подбор предметов и монет
		Навык: выпускает раскалённую мономолекулярную нить из ладони
		Короткое нажатие — короткая нить, долгое — длинная; враги на пути горят
		'''
	SkillHint: "[c/8AC4E8:{1}] Открыть радиальное меню киберимплантов · [c/F5C56A:{0}] Выпустить нить (короткое/долгое нажатие)"
	SkillName: Мономолекулярная нить
	SkillDesc:
		'''
		Выпускает раскалённую мономолекулярную нить из ладони. Враги на пути непрерывно горят.
		[c/8AC4E8:Короткое нажатие] — ~12 блоков к курсору, 2 секунды, без якоря
		[c/F5C56A:Долгое нажатие] — крепится к блоку у курсора, 5 секунд; без якоря — короткая нить
		Урон растёт с общим бонусом урона игрока
		'''
}

SelfHealingSkelent: {
