	// Burden: After the Finale your vigor drops to zero and you cannot flash step for 3s
	// DeedHint: Send off eight different bosses with Finale, one hand for each name
}

OniMeiRubbingKogehi: {
	// DisplayName: Koge-hi
	Tooltip: Молниеносные шаги выжигают весь свой путь; урон клинка -4%
	// Origin: Do not put your foot in the hot shallows. The groove is for stepping clear
	Power: Опаляющий след: Рывок оставляет до пяти равномерно распределённых ожогов на 90 тиков, каждое попадание наносит 14 % базового урона клинка; ожоги в пределах 32 пикс. обновляются
	Burden: Урон клинка -4 %; компенсируйте потерю горящей землёй, оставленной движением
}

OniMeiRubbingKanhi: {
	// DisplayName: Kan-hi
	Tooltip: Естественное восстановление в покое ×2,25; стоимость рывка и Sakura +8%
	// Origin: Quiet by the door. Let the ears rest
	Power: Тихое дыхание: После 120 тиков без прямого попадания клинком естественное восстановление энергии становится ×2,25
	Burden: Стоимость энергии рывка и Полёта Сакуры +8 % — спокойное восстановление оплачивается движением
}

OniMeiRubbingTodohi: {
	// DisplayName: Todo-hi
	Tooltip: Попадания связывают на 36 тиков; перезарядка рывка +6 тиков
	// Origin: A bit sticky. Keep contact to turn; break off and it stalls
	Power: Липкие путы: Прямые удары клинком связывают цель на 36 тиков и устанавливают скорость обычных врагов/боссов на 0,88/0,96
	Burden: Перезарядка рывка +6 тиков; Путы и Онемение используют только более сильный коэффициент движения
}

OniMeiRubbingShiorihi: {
	// DisplayName: Shiori-hi
	Tooltip: Убийства подрезают раненую цель; естественное восстановление -10 %, пустой Zanshin расходует энергию
	// Origin: Cut the spent flower to open the edge, not for looks
	Power: Обрезка лепестков: Прямое убийство выбирает другое тело с не более чем 50 % здоровья в радиусе 240 пикс., недолго преследует его и режет на 25 % базового урона клинка; без цели перезарядка в 45 тиков не начинается
	Burden: Естественное восстановление энергии -10 %; пустой Zanshin стоит 2 энергии. Обрезающие клинки не могут срабатывать цепочкой
}

OniMeiRubbingShiohi: {
	// DisplayName: Shio-hi
	Tooltip: В прилив даёт энергию или урон Zanshin; серии вне ритма слегка тупеют
	// Origin: Tide marks overnight. Wet contact feeds the return
	Power: Ритм прилива: В цикле из 48 тиков с полуокном в 6 тиков серия в прилив один раз за действие восстанавливает +3 энергии, а Zanshin в прилив наносит ×1,08 урона
	Burden: Урон серии вне прилива ×0,97; фаза прилива фиксируется в начале действия
}

OniMeiRubbingShibori: {
	// DisplayName: Shibori
	Tooltip: Сквозное парирование или контакт во время решающего действия вызывает онемение; получение стойки -15%
	// Origin: Guard even with numb hands. The blade hurts too
	Power: Ответное онемение: Сквозное парирование сразу вызывает онемение; контакт во время решающего действия может потратить 15 стойки, снизить удар до 85 % и вызвать онемение (перезарядка 90 тиков). Эффект длится 45 тиков, устанавливает скорость обычных врагов/боссов на 0,90/0,98 и контактный урон на ×0,90
	Burden: Получение стойки -15%
}

OniMeiRubbingChinmei: {
	// DisplayName: Chinmei
	Tooltip: Урон снарядов -12 %, отбрасывание -65 %; получение стойки -15%
	// Origin: When the ears buzz, settle first, then move
	Power: Усмирение: Урон вражеских снарядов ×0,88 и отбрасывание ×0,35
	Burden: Бездействует в чистом ближнем бою; получение стойки -15%
}

OniMeiRubbingAshidome: {
	// DisplayName: Ashidome
	Tooltip: Стойте неподвижно 45 тиков, затем нанесите ×1,25 урона следующим решающим действием
	// Origin: Stand still. Guard lives where the feet stop
	Power: Укоренённый шаг: Удерживайте квадрат скорости не выше 2,25 в течение 45 тиков; следующий пятый удар, Zanshin, Вспышка, разящая мир, или действие Финала наносит ×1,25 урона
	Burden: Заряд расходуется в начале действия даже при промахе; движение сбрасывает прогресс
}

OniMeiRubbingYoen: {
	// DisplayName: Yoen
	Tooltip: Казни перемещают единственное поле углей; предел энергии -5%
	// Origin: Oven heat still on the edge. Fire out; burn not gone
	Power: Поле углей: Казнь создаёт или перемещает ваше единственное поле углей; оно существует 180 тиков и может наносить одному телу 16 % базового урона клинка каждые 45 тиков
	Burden: Предел энергии -5 %; стоимость рывка ×1,10, пока существует поле
}
