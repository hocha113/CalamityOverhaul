	Tooltip_JudasWarningText: Предупреждение: предательство Иуды уже скрывается рядом с вами
}

SandevistansItem: {
	DisplayName: Сандевистан Mk.5
	Tooltip: Замедляет восприятие времени на 70% в течение 5 секунд. Перезарядка 15 секунд.
}

MimicPerchedAuxBrain: {
	DisplayName: Мимикрирующий вспомогательный мозг
	Tooltip:
		'''
		Разделяет носителя на четыре иллюзии, блуждающие вокруг него.
		При получении удара настоящее тело, скрытое среди иллюзий, вызовет замешательство, станет невосприимчивым к этой атаке и избежит урона.
		Одновременно с этим иллюзии бросятся на атакующего и взорвутся, нанося урон, зависящий от базовой атаки врага.
		"Хаос, свирепость, злобные взгляды... но всё это прямо у тебя на затылке."
		'''
}

CstmVisualEye: {
	// DisplayName: Cstm Visual Eye
	// Tooltip: ""
}

RamCapacityUpgradeChip: {
	DisplayName: Чип расширения памяти ОЗУ
	Tooltip: Использование навсегда увеличивает базовый предел ОЗУ на 1 единицу
}

RamRecoveryUpgradeChip: {
	DisplayName: Чип ускорения восстановления ОЗУ
	Tooltip: Использование навсегда увеличивает базовую скорость восстановления ОЗУ на 0.05 ед./сек
}

Mewtwo: {
	DisplayName: Чип брейнданса
	Tooltip: Использование погружает в брейнданс
}

RapidBarrelModule: {
	DisplayName: Скорострельный ствол
	Tooltip: Удлиненная возвратная пружина обеспечивает обжигающие импульсы ценой стабильности и урона за выстрел.
}

FocusBarrelModule: {
	DisplayName: Фокусирующий ствол
	Tooltip: Три самонаводящихся луча принудительно сливаются в один, нанося разрушительный концентрированный удар.
}

PrecisionOpticModule: {
	DisplayName: Точный прицел
	Tooltip: Лазерный помощник прицеливания полностью устраняет разброс лучей и дает дополнительный шанс критического удара.
}

OverloadCoreModule: {
	DisplayName: Перегруженное ядро
	Tooltip: Заменяет буферизацию более быстрой логикой цикла, что позволяет быстрее заряжать энергосферу и ускоряет её полет.
}

SteadyStockModule: {
	DisplayName: Стабилизирующий приклад
	Tooltip: Тяжелый композитный приклад поглощает отдачу, обменивая часть скорострельности на дополнительный урон каждого выстрела.
}

HarmonyGripModule: {
	DisplayName: Резонирующая рукоять
	Tooltip: Биоэлектрическая проводящая рукоять использует тело для передачи маны, значительно снижая её расход.
}

ResonanceFrameModule: {
	DisplayName: Резонансная ствольная коробка
	Tooltip: Гармоническое наложение позволяет генерировать дополнительный луч, делая шквал огня более плотным.
}

AdaptiveOpticModule: {
	DisplayName: Адаптивный прицел
	Tooltip: Нейросетевые алгоритмы постоянно корректируют траекторию, обеспечивая быстрое и точное попадание каждого луча.
}

AssaultStockModule: {
	DisplayName: Штурмовой приклад
	Tooltip: Адреналиновые опоры активируются при агрессивной стрельбе, повышая огневую мощь ценой повышенного расхода энергии.
}

BalancedGripModule: {
	DisplayName: Сбалансированная рукоять
	Tooltip: Перераспределение веса слегка улучшает скорострельность, урон и стабильность.
}

CapacitorBankModule: {
	DisplayName: Массив конденсаторов
	Tooltip: Стек конденсаторов высокой плотности заряжает энергосферу за более короткий цикл, но снижает кинетическую энергию на выходе.
}

CrystalGripModule: {
	DisplayName: Кристальная рукоять
	Tooltip: Синтетический кристалл резонирует с отдачей, экономя ману и повышая шанс крита, но замедляя ритм зарядки.
}

EfficientGripModule: {
	DisplayName: Эффективная рукоять
	Tooltip: Инженерная эргономичная рукоять оптимизирует как энергопотребление, так и ритм нажатия на спусковой крючок.
}

HeavyBarrelModule: {
	DisplayName: Тяжелый ствол
	Tooltip: Утолщенные нарезы подавляют разброс и скорострельность, превращая каждый выстрел в тяжелый удар.
}

HighVoltageCoreModule: {
	DisplayName: Высоковольтное ядро
	Tooltip: Повышает выходное напряжение, значительно увеличивая общий урон и урон от сфокусированного удара ценой расхода маны.
}

HoloOpticModule: {
	DisplayName: Голографический прицел
	Tooltip: Голографическая сетка фиксирует точку попадания, сильно снижая разброс и ускоряя ритм стрельбы. Слегка повышает энергопотребление.
}

HypersonicBarrelModule: {
	DisplayName: Сверхзвуковой ствол
	Tooltip: Звуковой удар разгоняет луч до предельной скорости, но делает точное самонаведение невозможным.
}

KineticDamperModule: {
	DisplayName: Кинетический демпфирующий приклад
	Tooltip: Жидкостный демпфер поглощает отдачу, сводя разброс почти к нулю и давая небольшой бонус к криту.
}

LightStockModule: {
	DisplayName: Легкий приклад
	Tooltip: Карбоновый каркас заметно повышает скорострельность, но слегка снижает стабильность и урон от одного выстрела.
}

MultiCellFrameModule: {
	DisplayName: Многокамерная ствольная коробка
	Tooltip: Параллельные камеры охлаждения испускают два луча одновременно, расширяя зону поражения, но снижая урон за попадание.
}

PlasmaInjectorModule: {
	DisplayName: Плазменный инжектор
	Tooltip: Впрыск высокоэнтальпийной плазмы значительно увеличивает скорость энергосферы и сфокусированный урон, слегка замедляя зарядку.
}

QuantumFrameModule: {
	DisplayName: Квантовая ствольная коробка
	Tooltip: Квантовые контуры направленности позволяют лучам умнее огибать препятствия, а энергосферам — летать быстрее. Расход маны немного увеличен.
}

ScattershotBarrelModule: {
	DisplayName: Дробовой ствол
	Tooltip: Рассекатель на дуле разделяет выстрел на несколько лучей-дробинок, резко увеличивая охват, но критически снижая урон одного луча.
}

ThermalOpticModule: {
	DisplayName: Тепловизионный прицел
	Tooltip: Инфракрасный захват заставляет лучи вгрызаться в цель, как гончие, повышая как точность, так и шанс крита.
}

VolatileFrameModule: {
	DisplayName: Нестабильная ствольная коробка
	Tooltip: Перегруженная структура охлаждения выдает дополнительные лучи и шанс крита, но потребление энергии и разброс взлетают до небес.
}

NovaBarrelModule: {
	DisplayName: Ствол "Нова"
	Tooltip:
		'''
		Перегруженное плазменное дуло заставляет каждый луч при попадании вызывать микроимпульсный взрыв.
		Это достигается ценой снижения дульной стабильности, ослабления урона каждого луча и повышенного расхода маны.
		'''
}

PrismOpticModule: {
	DisplayName: Призматический прицел
	Tooltip:
		'''
		Фазовая призма на конце оптического пути разделяет луч на два побочных.
		Дальность полета основного луча немного сокращается, но появляется дополнительное окно для точных критических попаданий.
		'''
}

TeslaCoreModule: {
	DisplayName: Ядро Теслы
	Tooltip:
		'''
		Высоковольтная дуга заставляет луч после попадания перескакивать на ближайшего врага.
		Каждый узел в цепи наследует эффекты попадания, но расход маны возрастает пропорционально.
		'''
}

RecoilStockModule: {
	DisplayName: Реактивный приклад
	Tooltip:
		'''
		Амортизатор перегрузки преобразует ударную волну от взрыва энергосферы в кинетическую энергию, отталкивающую игрока.
		Дальность полета луча также увеличивается, но темп стрельбы слегка замедляется.
		'''
}

SwarmGripModule: {
	DisplayName: Рукоять "Рой"
	Tooltip:
		'''
		Нейросетевая рукоять выпускает несколько самонаводящихся мини-сфер в момент взрыва энергосферы.
		Начальная скорость энергосферы и расход маны приносятся в жертву этому эффекту.
		'''
}

GravityFrameModule: {
	DisplayName: Гравитационная ствольная коробка
	Tooltip:
		'''
		Микросингулярное кольцо превращает энергосферу в притягивающее устройство.
		Во время зарядки она непрерывно стягивает ближайших врагов к центру сферы, а радиус взрыва значительно увеличивается.
		Однако сложная конструкция немного замедляет ритм зарядки.
		'''
}

LaserBarrelModule: {
	DisplayName: Призм-лазерный ствол
	Tooltip: Заменяет левую кнопку мыши непрерывным лазерным столбом, следящим за курсором
}

OscillatorBarrelModule: {
	DisplayName: Осциллирующий лазерный ствол
	Tooltip:
		'''
		Призматический канал со встроенными импульсными конденсаторами вызывает энергетический импульс в конечной точке луча каждые 30 кадров.
		Урон за кадр слегка снижен, но урон по области и меньший расход маны компенсируют недостатки непрерывного облучения.
		'''
}

ScorchBarrelModule: {
	DisplayName: Обжигающий лазерный ствол
	Tooltip:
		'''
		Модифицированное дуло с высокоэнтальпийной плазмой позволяет лазеру поджигать цель при попадании.
		Собственный урон луча незначительно ослаблен, но длительное горение и меньший расход маны восполняют нехватку прямого урона.
		'''
}

ReflectionBarrelModule: {
	DisplayName: Преломляющий лазерный ствол
	Tooltip:
		'''
		Ромбовидная призма преломляет часть энергии в две побочные струи в точке попадания.
		Урон основного луча увеличен, но крайне высокий расход маны делает непрерывное ведение огня дорогостоящим.
		'''
}

EchoOpticModule: {
	DisplayName: Резонансный прицел
	Tooltip:
		'''
		Компоненты на конце оптического пути улавливают остаточное эхо энергии при затухании луча.
		При исчезновении каждого луча высвобождаются три веерных самонаводящихся луча, компенсируя сокращенную дальность полета.
		'''
}

FrostOpticModule: {
	DisplayName: Морозный прицел
	Tooltip:
		'''
		Система охлаждающей фокусировки при попадании погружает цель в состояние обморожения.
		Скорость луча слегка снижена, но самонаведение более стабильно; добавлены бонусы к пробиванию и критическому шансу.
		'''
}

SingularityCoreModule: {
	DisplayName: Ядро сингулярности
	Tooltip:
		'''
		Миниатюрный генератор гравитационного поля постоянно отклоняет траекторию летящей энергосферы в сторону ближайшего врага.
		Радиус взрыва значительно увеличен, но из-за высокой плотности магнитного поля расход маны возрастает пропорционально.
		'''
}

ScrambleFieldModule: {
	DisplayName: Ядро помехового поля
	Tooltip:
		'''
		Катушки высокочастотного поля создают микро-ударную волну вокруг сферы каждые 40 кадров во время зарядки.
		Масштаб взрыва увеличен ценой замедления ритма зарядки и повышенных затрат маны.
		'''
}

BraceStockModule: {
	DisplayName: Упорный приклад
	Tooltip: Тяжелый стабилизирующий упор полностью устраняет разброс и увеличивает дальность луча, обменивая часть скорострельности на высочайшую точность.
}

LaunchStockModule: {
	DisplayName: Пусковой приклад
	Tooltip:
		'''
		Перегруженный пружинный механизм выпускает три дополнительных веерных самонаводящихся луча в момент выстрела энергосферы.
		Скорость энергосферы увеличена, расход маны также возрастает.
		'''
}

SentinelGripModule: {
	DisplayName: Сторожевая рукоять
	Tooltip:
		'''
		Интеллектуальная сенсорная рукоять автоматически выпускает самонаводящийся луч в ближайшего врага каждые 20 кадров полета энергосферы.
		Начальная скорость сферы снижена, расход маны увеличен, но постоянная огневая поддержка компенсирует эти потери.
		'''
}

