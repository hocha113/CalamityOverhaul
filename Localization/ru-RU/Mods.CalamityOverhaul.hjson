GodSmithGunsEarly: {
	GsFlintlockPistol.Desc:
		'''
		Перековка: двуствольная зарядка, 2-й выстрел вылетает на 40% быстрее; последний патронник бьёт одной пулей как V-образную пару, отбрасывание удваивается
		ПКМ — досрочная перезарядка; поймайте светящуюся полосу — следующий выстрел наносит на 25% больше урона
		'''

	GsGunsEarlyPlayer: {
		Perfect: Идеальная перезарядка!
		HighNoon: Высокий полдень!
	}

	GsMusket.Desc:
		'''
		Перековка: настоящий дульнозарядник; каждая свинцовая пуля — более быстрый и пробивной каменный заряд, пробивает на 1 врага больше
		Перезарядка в три такта: порох, досылка, капсюль; ПКМ на такте досылки — следующий выстрел на 30% сильнее и ещё на один пробивает
		'''
	GsQuadBarrelShotgun.Desc:
		'''
		Перековка: четыре ствола стреляют по очереди, по одному; 4-й ствол бьёт 8 дробин сразу, отдача резко отбрасывает вас
		Выстрел вниз даёт прыжок от отдачи
		ПКМ — перелом и перезарядка; поймайте светящуюся полосу — в следующем цикле каждый ствол даёт на 2 дробины больше
		'''
	GsRevolver.Desc:
		'''
		Перековка: барабан на шесть патронов; последний патронник всегда бьёт на 40% сильнее
		Удерживайте ПКМ, чтобы крутить барабан: мгновенно заряжает случайно от 1 до 6 патронов
		Если выпало ровно 6, следующий выстрел — Высокий полдень: урон и отбрасывание удваиваются
		'''
}

GodSmithGunsHard: {
	GsCandyCornRifle: {
		Desc:
			'''
			Перековка: ПКМ переключает глазурь
			Конфетный дождь: классическая скорострельность на месте, траектория получает сладкую дугу вниз
			Липкая тройка: за раз выплёвывает 3 жевательные пули; попадания копят сахарную глазурь, замедляют цель и делают ваши конфетные пули больнее
			'''
		ModeCandyRain: Конфетный дождь
		ModeStickyBurst: Липкая тройка
	}

	GsClockworkAssaultRifle: {
		Desc:
			'''
			Перековка: ПКМ переключает режим огня
			Шестерённая очередь: классическая тройка на месте, 3-й выстрел на 30% сильнее
			Разгон: скорострельность выше на 40% ценой нагрева; перегреете — шестерни заклинят
			'''
		ModeGearBurst: Шестерённая очередь
		ModeOverclock: Разгон
	}

	GsGatligator: {
		Desc:
			'''
			Перековка: ПКМ переключает нрав
			Болотная свара: дикий разброс на месте, каждая пуля один раз рикошетит от блоков
			Смертельный переворот: плотная четвёрка, последний выстрел цепи рвёт кровоточащую рану
			'''
		ModeSwampRiot: Болотная свара
		ModeDeathRoll: Смертельный переворот
	}

	GsMegashark: {
		Desc:
			'''
			Перековка: ПКМ переключает хватку
			Бешеная кормёжка: чем дольше держите спуск, тем быстрее стрельба; Акулья хватка: сужает разброс, сила выше на 15%
			Наберите 50 попаданий — и кровь: 3 секунды каждое попадание оставляет кровоточащую рану
			'''
		ModeFrenzy: Бешеная кормёжка
		ModeSharkBite: Акулья хватка
	}

	GsOnyxBlaster: {
		Desc:
			'''
			Перековка: ПКМ переключает заряд
			Ониксовый залп: в точке взрыва тёмного шара остаётся пятно, тянущее врагов внутрь
			Заряд сингулярности: стрельба медленнее, вместо этого летит огромный ониксовый шар; взрыв тянет всё к ядру и кольцом разбрасывает ваши пули
			'''
		ModeVolley: Ониксовый залп
		ModeSingularity: Заряд сингулярности
	}

	GsSDMG: {
		Desc:
			'''
			Перековка: ПКМ циклически переключает три режима огня
			Прилив дельфина: легендарная скорострельность как есть
			Гидролокаторная очередь: каждое 3-е попадание вешает метку сонара, дальний урон всей команды по этой цели выше на 8%
			Орбитальное наведение: пули слегка самонаводятся, сила ниже на 10%
			'''
		ModeDolphinTide: Прилив дельфина
		ModeSonarBurst: Гидролокаторная очередь
		ModeOrbitalGuide: Орбитальное наведение
	}

	GsShotgun: {
		Desc:
			'''
			Перековка: ПКМ переключает чок
			Широкий чок: 6 дробин широким веером со свинцовой дугой; если за один выстрел попали 3 дробины, над целью рвётся падающий свинцовый дождь
			Узкий чок: 3 тяжёлые дробины прямой кучей; все 3 в одну цель травят её свинцом на 1.5 секунды, урон этой пушки выше на 12%
			Каждый спуск по-прежнему тратит 1 патрон
			'''
		ModeWideBore: Широкий чок
		ModeTightChoke: Узкий чок
	}

	GsSniperRifle: {
		Desc:
			'''
			Перековка: короткое нажатие ПКМ переключает режим, удерживание ПКМ открывает прицел
			Снайперский: рисует пробивающую линию прицела; стойте неподвижно, чтобы задержать дыхание, после этого выстрел всегда критический
			Скорострельный: меняет силу на темп
			'''
		ModeSnipe: Снайперский
		ModeRapid: Скорострельный
	}

	GsTacticalShotgun: {
		Desc:
			'''
			Перековка: ПКМ переключает тактическую стойку
			Тактический веер: конус разброса горит постоянно, покрытие 6 дробин видно сразу
			Тройной помповый: три быстрых качка, затем принудительная пауза; первый качок бьёт пробивной ударной волной, отброшенные враги 1 секунду получают на 10% больше урона дроби этой пушки
			Каждый качок по-прежнему тратит 1 патрон
			'''
		ModeFan: Тактический веер
		ModeTriplePump: Тройной помповый
	}

	GsUzi: {
		Desc:
			'''
			Перековка: ПКМ переключает хват
			Парный разброс: скорострельность выше на треть, кучность свободная; Скоростная очередь: тройка в точку, каждая пуля кусает прицел
			Каждый 4-й выстрел (в очереди — последний цепи) — янтарная трассирующая: попадание подсвечивает цель, 1.5 секунды пули вашего узи бьют её на 10% больнее
			'''
		ModeAkimbo: Парный разброс
		ModeBurst: Скоростная очередь
	}

	GsVenusMagnum: {
		Desc:
			'''
			Перековка: ПКМ переключает пору цветения
			Золотая сердцевина: после критического удара следующий выстрел пробивает ещё 1 врага, в окне линия прицела загорается
			Тройной лепесток: один патрон раскалывается на три лепестка веером
			'''
		ModeFocus: Золотая сердцевина
		ModeTriplet: Тройной лепесток
	}

	GsVortexBeater: {
		Desc:
			'''
			Перековка: ПКМ переключает поток
			Вихревой обстрел: классический ливень пуль на месте, ракеты слегка самонаводятся
			Вихревая пушка: медленные зарядные тяжёлые снаряды, разовый удар в 2.6 раза сильнее; в точке удара рвётся тянущий вихрь
			'''
		ModeSweep: Вихревой обстрел
		ModeCannon: Вихревая пушка
	}

	GsXenopopper: {
		Desc:
			'''
			Перековка: ПКМ переключает форму пузыря
			Кластер: выдувает 5 пузырей, они сходятся к курсору и взрываются крест-накрест
			Вакуум: выдувает один большой пузырь к курсору, зависает и разом выплёвывает 5 патронов
			'''
		ModeCluster: Кластер
		ModeVacuum: Вакуум
	}

	GsShotgunLeadRainProj.DisplayName: Падающий свинцовый дождь
	GsTacticalShotgunBreachProj.DisplayName: Пробивная ударная волна
	GsUziTracerProj.DisplayName: Янтарная трассирующая
}

GodSmithLaunchers: {
	GsElectrosphereLauncher: {
		Desc:
			'''
			Перековка: когда на поле две и больше электросфер, между ними встают дуги Теслы, максимум 3 звена; дуга бьёт на половину урона сферы
			ПКМ перегружает все сферы: радиус больше на 40%, за 2 секунды разряжаются в ноль
			'''
		TipOverload: Перегрузка!
	}

	GsGrenadeLauncher: {
		Desc:
			'''
			Перековка: гранаты липнут к стенам и к врагам, сами больше не взрываются; прилипшие к плоти бьют на 25% сильнее
			ПКМ подрывает все сразу, на поле не больше 6
			'''
		TipDetonate: Подрыв всех!
	}

	GsJackOLanternLauncher: {
		Desc:
			'''
			Перековка: ПКМ заставляет катящиеся тыквы скалиться хором и рваться, каждая выпускает 3 самонаводящихся блуждающих огонька
			В каждой точке взрыва остаётся поле свечей, которое жжёт стоящих внутри врагов
			'''
		TipGrin: Хором скалятся!
	}

	GsNailGun: {
		Desc:
			'''
			Перековка: гвозди входят в плоть и больше не выпадают, на враге не больше 5, каждый повышает весь получаемый урон на 3%
			ПКМ вырывает все гвозди с мясом, взрывая их веером осколков
			'''
		TipExtract: Вырвать с мясом!
	}

	GsProximityMineLauncher: {
		Desc:
			'''
			Перековка: радиус срабатывания мин виден только вам
			ПКМ подрывает их цепью в порядке установки; мины, простоявшие 60 секунд, сами возвращаются и отдают одну ракету
			'''
		TipChain: Домино!
		TipRecycle: Мина возвращена
	}

	GsRocketLauncher: {
		Desc:
			'''
			Перековка: ПКМ подрывает все летящие ракеты
			Каждый воздушный разрыв швыряет к курсору 3 пробивающих дротика
			'''
		TipDetonate: Воздушный разрыв!
	}

	GsSnowmanCannon: {
		Desc:
			'''
			Перековка: ПКМ переключает носитель
			Самонаводящийся рой: попадание клеймит врага снежинкой, урон этого оружия выше на 8%
			Орбита метели: ракеты сначала уходят вверх, затем пикируют сверху от курсора
			'''
		ModeHoming: Носитель: самонаводящийся рой
		ModeOrbital: Носитель: орбита метели
	}

	GsStarCannon: {
		Desc:
			'''
			Перековка: ПКМ переключает траекторию
			Прямой выстрел: звёзды летят прямо; Звездопад: звёзды сначала уходят вверх, затем сыплются вокруг курсора и при попадании брызжут звёздной пылью
			'''
		ModeDirect: Траектория: прямой выстрел
		ModeStarfall: Траектория: звездопад
	}

	GsStynger: {
		Desc:
			'''
			Перековка: ПКМ циклически переключает взрыватель
			Ударный: рвётся при попадании; Дистанционный: воздушный разрыв на дистанции курсора, осколки собираются в конус; Рикошет: один отскок от блока, затем снимает предохранитель
			'''
		ModeImpact: Взрыватель: ударный
		ModeRange: Взрыватель: дистанционный разрыв
		ModeRicochet: Взрыватель: рикошет
	}
}

GodSmithMagicConduit: {
	GsHeatRay.Desc:
		'''
		Перековка: удерживайте, чтобы жечь раскалённым лучом; на белом накале луч шире, 5 слоёв оплавления взрываются
		ПКМ сбрасывает давление и превращает весь жар в коронное копьё-вспышку
		'''
	GsMedusaHead.Desc:
		'''
		Перековка: удерживайте, чтобы раскрыть конус окаменяющего взгляда; полный набор каменных меток ненадолго каменеет врагов, на белом накале взгляд сжимается в точечный
		ПКМ сбрасывает давление и бьёт окаменяющим взором на все восемь сторон
		'''

	GsSoulDrain: {
		Desc:
			'''
			Перековка: пиявковый канал, одновременно держит до 3 врагов и тянет их вместе; настоящее лечение только на белом накале
			ПКМ взрывает запасённую кровь у курсора; перегруженный взрыв отнимает у вас 10 здоровья
			'''
		BloodPriceDeath: "{0} высосало собственной пиявкой"
	}
}

GodSmithMagicMorph: {
	GsClingerStaff.Desc:
		'''
		Перековка: ненадолго удерживайте ПКМ, чтобы вдоль прицела выложить стену проклятых лоз примерно на 16 клеток, угол любой
		Если перетянуть заряд, с обоих концов стены вырастают ещё и вертикальные юбки
		'''
	GsCrimsonRod.Desc:
		'''
		Перековка: кровавое облако становится жертвенным дождём
		Капли копят кровяную эрозию, три слоя рвутся; союзники в поле медленно лечатся
		ПКМ за малое количество маны переносит поле к курсору
		'''
	GsCrystalSerpent.Desc:
		'''
		Перековка: осколки взрыва рикошетят ещё один раз
		Удерживайте ПКМ для заряда, отпустите — выйдет огромный кристальный питон, извиваясь влетит и рванётся ещё более густым дождём осколков
		'''
	GsCrystalStorm.Desc:
		'''
		Перековка: удерживайте ПКМ, чтобы у курсора нарастить преломляющий вихрь
		Ваши кристальные осколки, проходя сквозь него, преломляются, летят быстрее и пробивают ещё 1 врага
		'''
	GsFlamelash.Desc:
		'''
		Перековка: ручное управление поворачивает на 25% отзывчивее
		Удерживайте ПКМ для заряда, отпустите — выйдет огненный змей, тело следует за вашей указкой и поджигает врагов на пути
		'''
	GsMagicMissile.Desc:
		'''
		Перековка: ручное управление поворачивает на 25% отзывчивее
		Удерживайте ПКМ для заряда, отпустите — выйдет тройка магических снарядов, которые строем сопровождают курсор
		'''
	GsMeteorStaff.Desc:
		'''
		Перековка: в точке падения метеора остаётся горящий кратер
		Удерживайте ПКМ для заряда, отпустите — по линии курсора падает залп из пяти метеоров
		'''
	GsNimbusRod.Desc:
		'''
		Перековка: когда на поле обе тучи, между ними встаёт дождевой коридор, мочит и замедляет врагов внутри
		ПКМ переключает тёплый дождь и грозу; гроза бьёт молниями вдоль коридора
		'''
	GsRainbowGun.Desc:
		'''
		Перековка: пока радуга стоит, ваши снаряды в полосе над дугой бьют на 8% сильнее, а дуга сыплет самонаводящимися призматическими импульсами
		ПКМ забирает радугу и возвращает половину маны
		'''
	GsRainbowRod.Desc:
		'''
		Перековка: управляемый световой снаряд при попадании рвётся в призматическую крошку
		Удерживайте ПКМ для заряда, отпустите — встаёт радужный мост: враги, переходя его, получают урон, союзники на нём ускоряются
		'''
	GsSkyFracture.Desc:
		'''
		Перековка: при выходе магические клинки рвут вспышку разлома
		Удерживайте ПКМ для заряда, отпустите — вокруг курсора открываются три трещины и выпускают клинки к центру
		'''
}

GodSmithSummonWhips: {
	GsCoolWhip.Desc:
		'''
		Перековка: снежинки от ударов в такт крупнее и пробивают ещё 1 врага
		4 морозных следа складываются в печать казни; следующее попадание в такт распускает её морозным взрывом с обморожением
		'''
	GsDarkHarvest.Desc:
		'''
		Перековка: тёмный скачок перекидывается на ближайших врагов — по одному скачку за каждый след жатвы на цели
		4 следа складываются в печать казни; следующее попадание в такт жнёт душу и вспышкой добирает косой всех помеченных на поле
		'''
	GsDurendal.Desc:
		'''
		Перековка: после 3 ударов в такт каждый следующий взмах в такт выпускает с кончика золотую волну клинка
		5 следов складываются в печать казни; следующее попадание в такт призывает клинок священного приговора
		'''
	GsFirecracker.Desc:
		'''
		Перековка: классический взрыв от слуг на месте
		Удары в такт заряжают в цель взрыватели; набрав 3, следующий взрыв цепью даёт ещё 3 дополнительных
		'''
	GsKaleidoscope.Desc:
		'''
		Перековка: окно такта самое жёсткое из всех хлыстов, промах обнуляет ритм
		Каждый след зажигает один цвет призмы; собрав пять, следующее попадание в такт раскрывает калейдоскоп из пяти призматических рассечений, цель следующие 5 секунд получает гарантированные критические удары
		'''
	GsLeatherWhip.Desc:
		'''
		Перековка: серия взмахов в такт копит ритм, хлыст всё быстрее
		3 следа складываются в печать казни; следующее попадание в такт рвёт её на 200% урона, затем слуги две секунды бьют цель толпой
		'''
	GsMorningStar.Desc:
		'''
		Перековка: каждый взмах в такт бьёт кольцом сотрясения с кончика
		3 следа складываются в печать казни; следующее попадание в такт роняет звёздный молот точно на голову цели
		'''
	GsSnapthorn.Desc:
		'''
		Перековка: удары в такт сажают на добычу терновые следы
		4 следа складываются в печать казни; следующее попадание в такт взрывает тернии и выпускает 4 самонаводящихся жала
		'''
	GsSpinalTap.Desc:
		'''
		Перековка: если один взмах в такт задевает 3 врагов, костяное эхо добивает всех, кого кнут не коснулся
		4 следа складываются в печать казни; следующее попадание в такт выталкивает из земли костяной шпиль
		'''
}

