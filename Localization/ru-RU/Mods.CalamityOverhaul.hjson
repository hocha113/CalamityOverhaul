# For Language Pack Creators:
# The keys here were previously in Items. Since EcTypeItem has been removed, all localization keys similar to "ItemNameEcType" have been moved here.
# The corresponding format is "ItemNameEcType" → "RItemName" or "ItemNameOverride".
# Apart from the class name change, the DisplayName and Tooltip remain the same as in the previous version.
# So if you need to migrate your language pack to the new version, simply copy and paste the entries here and update the class names accordingly.

Arcanes: {
	Items: {
		ArcaneTransformer: {
			DisplayName: Чародейский преобразователь
			Tooltip: ""
		}
	}
}

Resurrections: {
	ResurrectionDeath: {
		DeathText: "{0} погибает от Возрождения Бездны"
		WarningCombatText: Бездна поглощает вас...
		DeathNoticeText: Вас поглотила Бездна...
		MarkRemainText: Метка Бездны всё ещё опутывает вас...
		RetainValueFormat: Значение Возрождения: {0}%
	}
}

QuickHack: {
	SynapseBurn: {
		DisplayName: Сжигание синапсов
		Description: Перегружает нейронные синапсы цели, нанося продолжительный термический урон.
	}

	ShortCircuit: {
		DisplayName: Замыкание
		Description: Выпускает электромагнитный импульс, наносящий мгновенный урон и кратковременно парализующий цель.
	}

	Cyberpsychosis: {
		DisplayName: Киберпсихоз
		Description: Доводит цель до безумия, заставляя атаковать все сущности вокруг.
	}

	SystemReset: {
		DisplayName: Сброс системы
		Description: Принудительно перезагружает систему цели, полностью ее парализуя.
	}

	OpticOverload: {
		DisplayName: Перегрузка зрения
		Description: Ослепляет цель, лишая ее возможности воспринимать окружение.
	}

	MemoryWipe: {
		DisplayName: Стирание памяти
		Description: Удаляет данные о враждебности цели, сбрасывая список агрессии.
	}

	Contagion: {
		DisplayName: Распространение
		Description: Внедряет самовоспроизводящуюся вредоносную программу, распространяющуюся на ближайшие цели.
	}

	TileDetonate: {
		DisplayName: Подрыв блока
		Description: Разрушает структурную целостность, вызывая локальный взрыв.
	}

	TilePhase: {
		DisplayName: Протокол фазирования
		Description: Искажает физические свойства блока, делая его бестелесным на некоторое время.
	}

	TileMagPull: {
		DisplayName: Магнитное притяжение
		Description: Генерирует магнитное поле, притягивающее к вам ближайшие выпавшие предметы.
	}

	MachineShortCircuit: {
		DisplayName: Замыкание механизмов
		Description: Опустошает запас энергии механической цели, высвобождая электрическую дугу, наносящую урон ближайшим сущностям.
	}

	TurretHijack: {
		DisplayName: Взлом турели
		Description: Взламывает модуль распознавания «свой-чужой», временно заставляя турель атаковать своих.
	}

	FalseMemory: {
		DisplayName: Подмена памяти
		Description: Внедряет ложные воспоминания, заставляя цель ненадолго прекратить преследование или подавляя её инстинкт убийцы.
	}

	SelfDismember: {
		DisplayName: Саморасчленение
		Description: Заставляет паранормальную сущность расчленить саму себя.
	}

	SystemHalt: {
		DisplayName: Зависание
		Description: Заставляет цель ненадолго замереть и прекратить любые действия.
	}

	TurretCircuitOverload: {
		DisplayName: Перегрузка цепи
		Description: Подает обратный ток в цепь питания турели, полностью выводя ее из строя на длительное время.
	}

	TurretShortCircuit: {
		DisplayName: Короткое замыкание турели
		Description: Мгновенно сбрасывает энергию турели, вызывая кратковременную остановку, после чего она сразу же возвращается в строй.
	}

	VirusBroadcast: {
		DisplayName: Вирусная трансляция
		Description: Внедряет код червя в сигнальную башню, заставляя ее излучать кибер-электромагнитные импульсы, надолго замыкающие все турели в радиусе действия.
	}

	MeltdownProtocol: {
		DisplayName: Протокол расплавления
		Description: Блокирует контур охлаждения; через четыре секунды цель перегревается, взрывается и задевает ближайших врагов.
	}

	ProjectileHijack: {
		DisplayName: Перехват баллистики
		Description: Меняет принадлежность летящего снаряда и разворачивает его обратно.
	}

	ProjectileFreeze: {
		DisplayName: Заморозка баллистики
		Description: Пригвождает снаряд в воздухе; через пять секунд отпускает.
	}

	DataPurge: {
		DisplayName: Очистка данных
		Description: Стирает летящий снаряд и все ближайшие того же типа.
	}

	BallisticOverclock: {
		DisplayName: Разгон баллистики
		Description: Добавляет одному вашему снаряду урон, пробивание и время полёта.
	}

	Electrolysis: {
		DisplayName: Электролиз вод
		Description: Пускает ток через эту жидкость; враги внутри получают урон со временем.
	}

	Cryostasis: {
		DisplayName: Криозаморозка
		Description: Замораживает участок жидкости в тонкий лёд, по которому можно ходить; через восемь секунд тает.
	}

	LiquidPurge: {
		DisplayName: Откачка жидкости
		Description: Осушает жидкость вокруг. На лаву тоже действует.
	}

	ItemRecall: {
		DisplayName: Дистанционный возврат
		Description: Тянет выпавший предмет к вашим ногам.
	}

	Reappraise: {
		DisplayName: Переброс качества
		Description: Заново бросает префикс этой экипировки на земле.
	}

	ArmorParse: {
		DisplayName: Разбор брони
		Description: Обнуляет защиту цели на шесть секунд.
	}

	Exorcise: {
		DisplayName: Принудительное удаление
		Description: Вешает метку удаления; после пяти попаданий срабатывает тяжёлая рана.
	}

	DataLeech: {
		DisplayName: Выжимка данных
		Description: Пока действует, удары по этой цели возвращают RAM; есть общий потолок.
	}

	SwarmLink: {
		DisplayName: Связь роя
		Description: Попадание по цели заставляет до пяти ближайших врагов получить 30% того же урона.
	}

	MachineOverclock: {
		DisplayName: Разгон машины
		Description: Десять секунд держит машину фиксированным зарядом, затем выжигает всю энергию.
	}

	GridBlackout: {
		DisplayName: Паралич сети
		Description: Через сигнальную башню отключает питание всех механизмов в широком радиусе.
	}

	PowerTransmute: {
		DisplayName: Конвертация энергии
		Description: Пересчитывает запас энергии в руке в RAM, затем опустошает его.
	}

	NeuralOverclock: {
		DisplayName: Нейронный разгон
		Description: Восемь секунд бьёте быстрее, но RAM не восстанавливается и здоровье тает.
	}

	WraithForceDrive: {
		DisplayName: Принуждение ведомого
		Description: Десять секунд действия ведомого ничего не стоят; затем эрозия углубляется, и он засыпает.
	}

	IndexPreread: {
		DisplayName: Предчтение индекса
		Description: Читает содержимое контейнера, не открывая его, и помечает самое ценное.
	}

	LockBurn: {
		DisplayName: Прожиг замка
		Description: Открывает этот сундук без ключа ценой сжигания одной вещи внутри.
	}

	DielSkip: {
		DisplayName: Скачок суток
		Description: Перематывает время к ближайшему восходу или закату.
	}

	StormInject: {
		DisplayName: Инъекция грозы
		Description: Призывает грозу; молнии бьют только врагов с любым эффектом взлома.
	}

	GravityInvert: {
		DisplayName: Инверсия гравитации
		Description: Вокруг вас гравитация переворачивается; враги и дроп падают вверх.
	}

	SegmentDelink: {
		DisplayName: Отвязка сегмента
		Description: Урон по этому сегменту только учитывается; по истечении 60% записывается на тело.
	}

	LimbSeizure: {
		DisplayName: Реквизиция конечности
		Description: Заставляет эту конечность восемь секунд бить своё же тело.
	}

	CommandLinkCut: {
		DisplayName: Разрыв связи
		Description: Рвёт связь с союзниками; десять секунд каждый дерётся сам по себе.
	}

	MunitionSwap: {
		DisplayName: Подмена боеприпасов
		Description: Турель стреляет патронами из вашего инвентаря, урон считается вашим.
	}

	TurretMesh: {
		DisplayName: Сеть турелей
		Description: Ближайшие турели бьют залпом в указанную точку, всего сорок выстрелов.
	}

	BeaconForge: {
		DisplayName: Поддельный маяк
		Description: Сигнальная башня шлёт ложный сигнал бедствия и сзывает тварей с большой площади.
	}

	PrivilegeEscalate: {
		DisplayName: Повышение прав
		Description: Протоколы дешевле, быстрее и без ограничения дальности; RAM в это время не восстанавливается.
	}

	ItemSalvage: {
		DisplayName: Разбор
		Description: Разбирает эту вещь на земле обратно примерно в 60% материалов.
	}

	DataBrand: {
		DisplayName: Клеймо данных
		Description: Списывает префикс этой экипировки и в следующий взлом ставит его на другую.
		HudTag: Клеймо: {0}
		DenyNoPrefix: На этой вещи нет префикса, который можно скопировать
		DenyIncompatible: Записанный префикс не ложится на эту вещь
	}

	EntityMasquerade: {
		DisplayName: Маскировка личности
		Description: Для врагов этот дроп выглядит как игрок и тридцать секунд принимает удары вместо вас.
	}

	TileConscript: {
		DisplayName: Реквизиция блоков
		Description: Разбирает эти блоки в восемь пластин брони вокруг вас; по истечении выбрасывает их.
	}

	VeinResonance: {
		DisplayName: Резонанс жилы
		Description: Одноимённые жилы видны сквозь стены; добыча даёт двойной дроп, но зовёт стражей.
	}

	StressInvert: {
		DisplayName: Инверсия напряжения
		Description: Десять секунд эти блоки неразрушимы; враги, врезавшиеся в них, получают урон.
	}

	PressureSurge: {
		DisplayName: Нагнетание вод
		Description: Нагнетает давление в этой жидкости; всё, что в ней, выбрасывает в небо.
	}

	MirrorSurface: {
		DisplayName: Зеркальная гладь
		Description: Поверхность становится зеркалом; вражеские снаряды, прошедшие сквозь неё, копируются вам.
	}

	DelayFuse: {
		DisplayName: Задержанный взрыватель
		Description: Этот снаряд больше не исчезает и тридцать секунд висит на месте как мина.
	}

	ProjectileTithe: {
		DisplayName: Подать со снарядов
		Description: Этот снаряд поглощает ближайшие вражеские и по истечении взрывается по съеденному количеству.
	}

	ProjectileSample: {
		DisplayName: Проба снаряда
		Description: Снимает образец этого снаряда; двадцать секунд каждая двенадцатая ваша пуля его повторяет.
	}

	CompensationProtocol: {
		DisplayName: Протокол компенсации
		Description: Авансом снимает 10% жизни цели; не убьёте за восемь секунд — долг возвращаете сами.
	}

	PayloadRewrite: {
		DisplayName: Перепись нагрузки
		Description: Десять секунд снаряды цели принадлежат вам и считаются вашим уроном.
	}

	PhaseDesync: {
		DisplayName: Сдвиг фазы
		Description: Разделяет тело цели и её хитбокс; попасть становится труднее обеим сторонам.
	}

	LiveCellTap: {
		DisplayName: Живой источник
		Description: Цель не может двигаться и иммунна к урону, меняя свою жизнь на ваш RAM.
	}

	FirmwareRollback: {
		DisplayName: Откат прошивки
		Description: Откатывает цель к поведению предыдущей фазы; по истечении пять секунд бесится.
	}

	ShellRequisition: {
		DisplayName: Реквизиция оболочки
		Description: Цель, убитая под меткой, встаёт и пятнадцать секунд бьёт за вас.
	}

	PositionCast: {
		DisplayName: Трансляция координат
		Description: Пятнадцать секунд позиция цели видна всей вашей команде.
	}

	GaugePollution: {
		DisplayName: Загрязнение показаний
		Description: Портит интерфейс цели; восемь секунд здоровье и боезапас скачут.
	}

	LinkTraceback: {
		DisplayName: Обратный след канала
		Description: Обрывает загрузки, нацеленные на вас, жжёт отправителя и помечает его.
	}

	ForceUninstall: {
		DisplayName: Принудительная деинсталляция
		Description: Срывает с вас один вражеский протокол; полминуты нельзя срывать снова.
	}

	MemoryScorch: {
		DisplayName: Выжигание памяти
		Description: Сжигает у цели 3 RAM; десять секунд её восстановление равно нулю.
		SealTag: Восстановление RAM заблокировано
	}

	BuffSiphon: {
		DisplayName: Выкачка усиления
		Description: Забирает у цели самое долгое усиление себе, максимум на тридцать секунд.
	}

	CombatSiphon: {
		DisplayName: Боевая выжимка
		Description: Десять секунд урон по этой цели пропорционально возвращает вам RAM.
	}

	BallisticTurncoat: {
		DisplayName: Баллистический переворот
		Description: Следующие три снаряда цели разворачиваются на полпути и бьют хозяина; кто не стреляет — в безопасности.
		HijackCounter: Баллистика перехвачена {0}/{1}
		DeathReason: "{0}: снаряд развернул {1} и вернул обратно"
	}

	MeltdownBrand: {
		DisplayName: Метка перегорания
		Description: Четырёхсекундный взрыватель виден всё время, в конце взрывает на 80 урона; снятие по пути обезвреживает.
		FuseTag: Перегорание {0}s
		DeathReason: "{0} разорвало меткой перегорания, которую поставил {1}"
	}

	MapBlackout: {
		DisplayName: Гашение карты
		Description: Карта цели пятнадцать секунд сыпется снегом; булавки и метки команды гаснут вместе с ней.
	}

	ChannelScramble: {
		DisplayName: Помехи канала
		Description: Двадцать секунд чат цели превращается в кашу, таблички союзников пропадают с её экрана.
	}

	StealthStrip: {
		DisplayName: Срыв скрытности
		Description: Срывает всю невидимость и скрытность цели; десять секунд её не накопить, контур виден всем.
	}

	CooldownInject: {
		DisplayName: Инъекция перезарядки
		Description: Шесть секунд цель действует на 35% медленнее; идущие перезарядки зелий удлиняются ещё на пять секунд.
	}

	CyberwareOffline: {
		DisplayName: Киберимпланты офлайн
		Description: Восемь секунд все киберимпланты цели обесточены и отключены.
	}
}

