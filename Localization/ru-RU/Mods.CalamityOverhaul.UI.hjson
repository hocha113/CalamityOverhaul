CyberwareGuideLead: {
	// SelectTitle: Cyberware Skill Online
	// SelectBody: Active cyberware detected. Hold {0} to summon the radial wheel — every eligible wheel appears together, and the cursor belongs to whichever is closest.
	// SelectPrompt: Fling the cursor toward the cyberware sector, left-click or release to confirm
	// TriggerTitle: Fire the Skill
	// TriggerBody: Selecting only loads the skill onto your fingertip — firing takes the trigger key. Charge-type skills are held, then released.
	// TriggerPrompt: Press {0} to fire the current cyberware skill
	// SkipBtn: Skip
	// WheelKeyUnbound: The radial wheel key is unbound, so the wheel cannot open. Bind it under Settings > Controls first, or click Skip.
	// TriggerKeyUnbound: The trigger key is unbound. Bind it under Settings > Controls first, or click Skip.
}

