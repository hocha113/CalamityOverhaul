KingSlimeBlessing: {
	DisplayName: Корона желе
	Description: Гель облекает тело; контактный урон врагов снижен на 12%
}

EyeOfCthulhuBlessing: {
	DisplayName: Око бездны
	Description: Шанс критического удара +5%, ночью ещё +3%
}

EaterOfWorldsBlessing: {
	DisplayName: Кольцо порчи
	Description: Ваши атаки разъедают цель: защита −10 на 5 секунд
}

BrainOfCthulhuBlessing: {
	DisplayName: Сочувствие боли
	Description: После получения урона ваши атаки наносят на 12% больше урона в течение 5 секунд
}

QueenBeeBlessing: {
	DisplayName: Регенерация улья
	Description: Восстановление от лечебных предметов увеличено на 15%
}

SkeletronBlessing: {
	DisplayName: Стража костей
	Description: Каждые 45 секунд собирается стража: следующий полученный урон уменьшается вдвое
}

DeerclopsBlessing: {
	DisplayName: Зимний шаг
	Description: Лёд больше не скользит, скорость передвижения +8%, иммунитет к холоду
}

WallOfFleshBlessing: {
	DisplayName: Завет плоти
	Description: После получения урона 20% от него медленно возвращается в течение 8 секунд
}

QueenSlimeBlessing: {
	DisplayName: Кристальное перо
	Description: Иммунитет к урону от падения, сила прыжка повышена
}

TwinsBlessing: {
	DisplayName: Дуэт зрачков
	Description: Повторные попадания по одной цели повышают урон на 2% за раз, до 5 слоев
}

DestroyerBlessing: {
	DisplayName: Контур зондов
	Description: Убийство врага восстанавливает 3 маны; выстрелы с вероятностью 1/12 не тратят боеприпасы
}

SkeletronPrimeBlessing: {
	DisplayName: Перегруженный скелет
	Description: Скорость использования предметов +5%
}

PlanteraBlessing: {
	DisplayName: Возрождение терновника
	Description: Регенерация жизни повышена; ещё сильнее в течение 3 секунд после получения урона
}

GolemBlessing: {
	DisplayName: Каменное сердце
	Description: Защита +8, иммунитет к отбрасыванию
}

DukeFishronBlessing: {
	DisplayName: Яростный прилив
	Description: При здоровье ниже половины скорость передвижения +12%, урон +8%
}

EmpressBlessing: {
	DisplayName: Приговор дневного света
	Description: Днём критический урон +18%
}

LunaticCultistBlessing: {
	DisplayName: Щит лунной фазы
	Description: Каждые 40 секунд сгущается щит лунной фазы, полностью блокирующий один вражеский снаряд
}

MoonLordBlessing: {
	DisplayName: Резонанс звёздного ядра
	Description: Весь наносимый урон +8%
}
