QuestNode: {
	FirstQuest: {
		DisplayName: Добро пожаловать в этот мир!
		Description: Начало путешествия
		DetailedDescription: Заберите стартовые припасы. В этом мире есть боги и есть чудовища, а у вас сейчас пустые руки.
		QuestObjective.Description: Нажмите, чтобы получить стартовые предметы
	}

	MiningQuest: {
		DisplayName: Начало раскопок
		Description: Добыть 10 ед. {0}
		DetailedDescription: Сначала нужен металл для инструментов. Жилы сами не вылезут — копайте.
	}

	MiningQuestII: {
		DisplayName: Железный век
		Description: Собрать 50 ед. {0}
		DetailedDescription: Медь слишком мягкая, тупится за пару ударов. Железо лежит глубже.
	}

	MiningQuestIII: {
		DisplayName: Золотая лихорадка
		Description: Собрать 100 ед. {0}
		DetailedDescription: Золото мягче железа, но лучше проводит магию и ковче. Без него не обойтись в снаряжении высокого уровня.
	}

	BrimstoneElementalQuest: {
		DisplayName: Серный элементаль
		Description: Победить Серного элементаля
		DetailedDescription: В руинах Серных скал пробудите и победите дремлющего духа стихий. Остерегайтесь её пулевого ада.
	}

	CalamitasCloneQuest: {
		DisplayName: Клон Каламитас
		Description: Победить Клона Каламитас
		DetailedDescription: Клон, полный ненависти и жажды уничтожения. Не одолеете даже тень — до самой ведьмы вам не добраться.
	}

	CrabulonQuest: {
		DisplayName: Крабулон
		Description: Победить Крабулона
		DetailedDescription: В подземном биоме светящихся грибов скрывается гигантский краб, пораженный грибком. Его споры очень опасны.
	}

	CryogenQuest: {
		DisplayName: Криоген
		Description: Победить Криогена
		DetailedDescription: Некогда владыка льдов, запечатанный в глыбе. Разбейте её — он проснётся весь в кристаллах.
	}

	DesertScourgeQuest: {
		DisplayName: Пустынный бич
		Description: Победить Пустынного бича
		DetailedDescription: Бывший повелитель морей, ныне влачащий жалкое существование в высохшей пустыне. Остерегайтесь его огромных челюстей и миньонов.
	}

	EaterofWorldsQuest: {
		DisplayName: Пожиратель миров / Мозг Ктулху
		Description: Победить босса Порчи или Багрянца
		QuestObjective.Description: Победить Пожирателя миров или Мозг Ктулху
		DetailedDescription: Зло распространяется. Проникните в очаг болезни этого мира и искорените гигантского червя или зловещий мозг, обитающий там.
	}

	EyeofCthulhuQuest: {
		DisplayName: Глаз Ктулху
		Description: Победить Глаз Ктулху
		DetailedDescription: Стоит почувствовать этот злой взгляд — и он явится. Ночью. С неба.
	}

	GolemQuest: {
		DisplayName: Голем
		Description: Победить Голема
		DetailedDescription: В глубинах Храма джунглей покоится древняя машина войны. Берегитесь его лазеров и тяжелых кулаков.
	}

	HiveMindQuest: {
		DisplayName: Разум улья / Перфораторы
		Description: Победить истинное божество злого биома
		QuestObjective.Description: Победить Разум улья или Перфораторов
		DetailedDescription: У Порчи и Багрянца по своему мозгу. Пока не вырвете — зараза не остановится.
	}

	KingSlimeQuest: {
		DisplayName: Король слизней
		Description: Победить Короля слизней
		DetailedDescription: Повелитель гелевых существ. Хоть он и выглядит комично, не дайте его огромному телу раздавить вас.
	}

	LunaticCultistQuest: {
		DisplayName: Лунатик-культист
		Description: Победить Лунатика-культиста
		DetailedDescription: У входа в Темницу группа фанатиков пытается предотвратить — или вызвать — конец света. Остановите их ритуал.
	}

	MechanicalBossesQuest: {
		DisplayName: Механические боссы
		Description: Победить всех механических боссов
		QuestObjective.Description: Победить всех механических боссов
		DetailedDescription: Кто-то воссоздал органы Ктулху из стали. Пара глаз, череп и длинный червь.
	}

	MoonLordQuest: {
		DisplayName: Лунный лорд
		Description: Победить Лунного лорда
		DetailedDescription: Кукловод за всем этим, ужас с обратной стороны Луны. Глаза у него не там, где положено.
	}

	PlaguebringerGoliathQuest: {
		DisplayName: Предвестница чумы, Голиаф
		Description: Победить Предвестницу чумы, Голиаф
		DetailedDescription: Пчелиная матка, переделанная нановирусом. Она несёт чуму: после укуса здоровье продолжает таять.
	}

	PlanteraQuest: {
		DisplayName: Плантера
		Description: Победить Плантеру
		DetailedDescription: В глубине джунглей дремлет гигантский цветок-людоед. Разбейте бутон и столкнитесь с яростью джунглей.
	}

	SkeletronQuest: {
		DisplayName: Скелетрон
		Description: Победить Скелетрона
		DetailedDescription: Только победив этого проклятого старика, вы сможете безопасно войти в Темницу и исследовать её тайны.
	}

	SlimeGodQuest: {
		DisplayName: Бог слизней
		Description: Победить Бога слизней
		DetailedDescription: Вершина эволюции слизней, древнее и ненасытное божество. Остерегайтесь комбинированных атак его частей.
	}

	WallofFleshQuest: {
		DisplayName: Стена плоти
		Description: Победить Стену плоти
		DetailedDescription: Страж этого мира. Бросьте куклу гида в лаву, чтобы освободить древних духов и начать Хардмод.
	}

	CeaselessVoidQuest: {
		DisplayName: Нескончаемая пустота
		Description: Победить Нескончаемую пустоту
		DetailedDescription: Один из стражей Пожирателя богов, зеркало небытия из иного измерения.
	}

	DevourerofGodsQuest: {
		DisplayName: Пожиратель богов
		Description: Победить Пожирателя богов
		DetailedDescription: Космический змей, жаждущий поглотить всю божественность. Сразитесь с ним в пустоте и не дайте себя сожрать.
	}

	DragonfollyQuest: {
		DisplayName: Псевдодракон
		Description: Победить Псевдодракона
		DetailedDescription: Неудачный продукт попытки воскресить Ярона, безумный и наэлектризованный лжедракон.
	}

	ExoMechsQuest: {
		DisplayName: Экзо-механизмы
		Description: Победить Экзо-механизмы
		DetailedDescription: Лучшее, что когда-либо собрал Дрэйдон. Все три сразу, а он стоит рядом и смотрит.
	}

	OldDukeQuest: {
		DisplayName: Герцог-реликт Серного моря
		Description: Победить герцога-реликта Серного моря
		DetailedDescription: Древний владыка глубин Серного моря, сочетание мутации и силы. Остерегайтесь его ядовитого пара.
	}

	PolterghastQuest: {
		DisplayName: Полтергаст
		Description: Победить Полтергаста
		DetailedDescription: Монстр, созданный из скопления душ, погибших в Темнице. Усмирите их гнев.
	}

	PrimordialWyrmQuest: {
		DisplayName: Первозданный змий
		Description: Победить Первозданного змия
		DetailedDescription: Страж глубочайшего слоя Бездны. Существо более древнее, чем сами боги. Не беспокойте его без необходимости.
	}

	ProfanedGuardiansQuest: {
		DisplayName: Оскверненные стражи
		Description: Победить Оскверненных стражей
		DetailedDescription: Верные защитники Оскверненной богини. Победите их, чтобы ослабить защиту божества.
	}

	ProvidenceQuest: {
		DisplayName: Провиденс
		Description: Победить Провиденс
		DetailedDescription: Богиня, управляющая священным огнем и очищением. Бросьте ей вызов в Святых землях или в Аду, но берегитесь её испепеляющего пламени.
	}

	SignusQuest: {
		DisplayName: Сигнус
		Description: Победить Сигнуса
		DetailedDescription: Один из стражей Пожирателя богов, невидимый убийца, призрак пустоты.
	}

	StormWeaverQuest: {
		DisplayName: Штормовой ткач
		Description: Победить Штормового ткача
		DetailedDescription: Один из стражей Пожирателя богов, небесный червь, питающийся грозами и молниями.
	}

	SupremeCalamitasQuest: {
		DisplayName: Высшая Каламитас
		Description: Победить Высшую Каламитас
		DetailedDescription: Сама серная ведьма. Тех клонов она слепила между делом. Экран будет забит.
	}

	YharonQuest: {
		DisplayName: Ярон, Дракон джунглей
		Description: Победить Ярона, Дракона джунглей
		DetailedDescription: Верный соратник Тирана, дракон с фениксовым возрождением. Повалить его один раз — ещё не конец.
	}

	BatteryQuest: {
		DisplayName: Хранение энергии
		Description: Создать термальную батарею
		DetailedDescription: Произведенное электричество нужно хранить. Создание батареи — первый шаг к построению стабильной энергосети.
	}

	HydroelectricQuest: {
		DisplayName: Чистая энергия
		Description: Создать гидроэлектрогенератор
		DetailedDescription: Электричество из текущей воды. Топливо не жжёт: пока течёт вода, он крутится.
	}

	IndustrialStartQuest: {
		DisplayName: Промышленная революция
		Description: Создать ветряной генератор
		DetailedDescription: Ветер крутит машины. Это первый механизм, которому не нужно, чтобы вы стояли рядом.
	}

	ItemFilterQuest: {
		DisplayName: Сортировка логистики
		Description: Создать предметный фильтр
		DetailedDescription: Автоматизированные линии требуют порядка. Используйте фильтры для точного контроля потока предметов.
	}

	MiningMachineQuest: {
		DisplayName: Автоматизированная добыча
		Description: Создать буровую установку
		DetailedDescription: Копать самому больше не нужно. Поставьте на жилу — будет грызть вниз без остановки.
	}

	MiningMachineIIQuest: {
		DisplayName: Глубокое бурение
		Description: Создать буровую установку MK2
		DetailedDescription: Силовое ядро заменили, бур крутится быстрее.
	}

	PipelineQuest: {
		DisplayName: Передача энергии
		Description: Создать универсальный энергопровод
		DetailedDescription: Кровеносные сосуды, соединяющие генераторы и машины. Без них электричество — это лишь застоявшаяся вода.
	}

	TeslaTowerQuest: {
		DisplayName: Башня магнитной бури
		Description: Создать Башню Теслы
		DetailedDescription: Чудо беспроводной передачи энергии. Башня передаёт энергию по воздуху и избавляет от большей части проводки.
	}

	FluidPumpQuest: {
		DisplayName: Жидкостная инженерия
		Description: Создать жидкостный насос
		DetailedDescription: Вода и лава тоже ресурсы. Насос вытаскивает их из мира.
	}

	FluidPipelineQuest: {
		DisplayName: Жилы жидкости
		Description: Создать жидкостные трубы
		DetailedDescription: Жидкостям нужна своя сеть. Жидкостные трубы возят только жидкости и не мешают энергосети.
	}

	FluidTankQuest: {
		DisplayName: Сосуд запасов
		Description: Создать резервуар для жидкости
		DetailedDescription: Какой бы быстрый ни был насос, нужно куда складывать. Резервуар — батарея жидкостной сети.
	}

	MagmaGeneratorQuest: {
		DisplayName: Магмовая теплоэнергия
		Description: Создать магмовый теплогенератор
		DetailedDescription: Откачанная магма наконец нашла применение. Касание лавы даёт чуть-чуть, полная цистерна — полную мощность.
	}

	ShimmerTransmuterQuest: {
		DisplayName: Алхимия мерцания
		Description: Создать чан мерцающей трансмутации
		DetailedDescription: Закачайте мерцание в машину — и форму предметов можно будет переписывать на конвейере.
	}

	CrusherQuest: {
		DisplayName: Руда из щебня
		Description: Создать рудодробилку
		DetailedDescription: Две порции руды дробятся в три. Перед инсинератором появляется ещё одна ступень прироста.
	}

	RecyclerQuest: {
		DisplayName: Отходы в ценность
		Description: Создать переработчик
		DetailedDescription: Списанное снаряжение не выбрасывайте. Разберите по редкости на слитки и снова в печь.
	}

	AutoCrafterQuest: {
		DisplayName: Автосборка
		Description: Создать автоверстак
		DetailedDescription: Закрепите рецепт: материалы входят сами, изделия выходят сами. У верстака больше не нужно дежурить.
	}

	MushroomFarmerQuest: {
		DisplayName: Грибоводство
		Description: Создать грибную ферму
		DetailedDescription: Урожай с травы и грибной травы — её работа. Светящиеся грибы тоже в списке.
	}

	ApiaryQuest: {
		DisplayName: Сладкая индустрия
		Description: Создать улей
		DetailedDescription: Пустые банки входят, банки мёда выходят. Рядом с мёдом или в джунглях рой работает усерднее.
	}

	SlimeVatQuest: {
		DisplayName: Массовое производство геля
		Description: Создать чан для слизней
		DetailedDescription: Вода и электричество в обмен на гель. Чан — первая сырьевая машина сельскохозяйственного цикла.
	}

	BiomassGeneratorQuest: {
		DisplayName: Замкнутая экология
		Description: Создать биомассовый генератор
		DetailedDescription: Излишки фермы не выбрасывайте. Киньте в бункер и сожгите в электричество — цикл посев-сжигание пойдёт.
	}

	FlameTurretQuest: {
		DisplayName: Огненная линия
		Description: Создать огнемётную башню
		DetailedDescription: Ближняя стена огня против толпы. Зарядите гелем — жжёт больнее.
	}

	CryoTurretQuest: {
		DisplayName: Морозная блокада
		Description: Создать ледяную башню
		DetailedDescription: Не для убийства, а чтобы заморозить. Враги под башней всё медленнее, пока не перестанут ступать.
	}

	LaserTurretQuest: {
		DisplayName: Снайпер на скорости света
		Description: Создать лазерную башню
		DetailedDescription: Что в зоне видимости — то в одном луче. Дальность самая большая в семействе, целит в крупных.
	}

	ShieldGeneratorQuest: {
		DisplayName: Энергетический бастион
		Description: Создать генератор щита
		DetailedDescription: Каждому союзнику в радиусе — слой поглощающего щита. Чем больше людей, тем быстрее садится энергия.
	}

	HealStationQuest: {
		DisplayName: Полевая медицина
		Description: Создать станцию лечения
		DetailedDescription: Стоите в ауре — раны медленно сходятся. Слово «производственная травма» отныне в прошлом.
	}

	TeleportStationQuest: {
		DisplayName: Сеть телепортов
		Description: Создать телепорт-станцию
		DetailedDescription: Две станции — уже сеть на всю карту. Чем дальше прыжок, тем дороже проезд.
	}

	ElectricSundialQuest: {
		DisplayName: Завести солнечные часы
		Description: Создать электрический солнечный диск
		DetailedDescription: Накопите 1000 единиц энергии и одним нажатием перескочите ночь. Весь сервер получит уведомление.
	}

	SolarPanelQuest: {
		DisplayName: Лицом к солнцу
		Description: Создать солнечную панель
		DetailedDescription: Днём даёт ток, в полдень — пик. Не загораживайте небо; в дождь и затмение ищите другой источник.
	}

	CapacitorMatrixQuest: {
		DisplayName: Гигантский накопитель
		Description: Создать конденсаторную матрицу
		DetailedDescription: Гигантская батарея на 40000 единиц. Маховик сети и конец эпохи отключений.
	}

	WeatherControllerQuest: {
		DisplayName: Призвать дождь
		Description: Создать контроллер погоды
		DetailedDescription: 500 энергии за дождь, ещё одно нажатие в дождь — и снова ясно. Ветер ей не подчиняется.
	}

	WireInterfaceQuest: {
		DisplayName: Мост проводки
		Description: Создать интерфейс проводки
		DetailedDescription: Проводка и энергосеть наконец говорят. Сигнал включает машины, машины шлют сигнал обратно.
	}

	SensorQuest: {
		DisplayName: Электронный дозор
		Description: Создать мультирежимный датчик
		DetailedDescription: Заряд, враги, кровавая луна — от его глаз не уйти. Условие сработало — сигнал проводки уходит сразу.
	}

	GridSwitchQuest: {
		DisplayName: Диспетчер сети
		Description: Создать главный рубильник сети
		DetailedDescription: Главный выключатель, врезанный в линии. Размыкаете — и вся сеть ниже мгновенно затихает.
	}

	ThermalPowerQuest: {
		DisplayName: Время сжигать
		Description: Создать тепловой электрогенератор
		DetailedDescription: Сжигайте топливо для получения большого количества энергии. Пусть это и не экологично, но на ранних этапах это самый надежный источник энергии.
	}

	AnnihilatingUniverseQuest: {
		DisplayName: Вселенское аннигилирование
		Description: Получить "Вселенское аннигилирование"
		DetailedDescription: Целая галактика, сжатая на тетиве. Когда лук натянут до предела, он опаснее стрелы.
	}

	AriaofTheCosmosQuest: {
		DisplayName: Ария Космоса
		Description: Получить "Арию Космоса"
		DetailedDescription: Сыграйте симфонию звезд. Эта магическая книга призывает черные дыры и квазары, заставляя врагов исчезать под песнь вселенной.
	}

	NeutronBowQuest: {
		DisplayName: Нейтронный лук
		Description: Получить нейтронный лук
		DetailedDescription: Лук, выкованный из осколков ядра нейтронной звезды. Каждая стрела несет в себе гравитацию коллапсирующей звезды.
	}

	NeutronGlaiveQuest: {
		DisplayName: Нейтронная глефа
		Description: Получить нейтронную глефу
		DetailedDescription: Древковое оружие невероятной плотности. Чтобы владеть им, нужна огромная сила, но ни одна броня не выдержит его удара.
	}

	NeutronGunQuest: {
		DisplayName: Нейтронная пушка
		Description: Получить нейтронную пушку
		DetailedDescription: Оружие, стреляющее потоками микро-нейтронов. Из-за сверхвысокой плотности пули практически не испытывают сопротивления.
	}

	NeutronScytheQuest: {
		DisplayName: Нейтронная коса
		Description: Получить нейтронную косу
		DetailedDescription: Инструмент жатвы самой Смерти. Она легко разрывает пространство, скашивая жизни, словно пшеницу.
	}

	NeutronStarIngotQuest: {
		DisplayName: Нейтронный слиток
		Description: Получить нейтронный слиток
		DetailedDescription: Одно из самых плотных веществ во вселенной. Этот металл невообразимо тяжел и гудит от гравитационных колебаний.
	}

	NeutronWandQuest: {
		DisplayName: Нейтронный жезл
		Description: Получить нейтронный жезл
		DetailedDescription: Посох, управляющий гравитацией. Используйте силу нейтронной звезды, чтобы искажать пространство-время и сокрушать врагов.
	}

	PandemoniumQuest: {
		DisplayName: Пандемониум
		Description: Получить "Пандемониум"
		DetailedDescription: Оружие, выплавленное из несчётных душ. Подержите подольше — услышите, как они всё ещё говорят.
	}

	RockQuest: {
		DisplayName: Древний вечный камень
		Description: Получить Древний вечный камень
		DetailedDescription: С виду обычный камень. Остался от прошлого конца света.
	}

	TerminusQuest: {
		DisplayName: Терминус
		Description: Получить Терминус
		DetailedDescription: Ключ к финальному испытанию. Раздавите его — и сильнейшие существа мира выстроятся к вам в очередь.
	}

	SpearOfLonginusQuest: {
		DisplayName: Копье Лонгина
		Description: Получить Копье Лонгина
		DetailedDescription: Святое копьё, пронзившее бога. Силовые поля, щиты, абсолютные барьеры — для него их нет.
	}

	DragonsWordQuest: {
		DisplayName: Слово дракона
		Description: Получить Слово дракона
		DetailedDescription: Дракон плачет лишь раз в жизни — в момент своей смерти.
	}

	RockQuestII: {
		DisplayName: Цикл войны
		Description: Пройти финальную битву 5 раз и получить более 5 древних вечных камней
		DetailedDescription: Символ истинного воина.
	}

	AdventurerQuests: {
		DisplayName: Искатель приключений
		Description: Мир у моих ног!
		QuestObjective.Description: Нажмите, чтобы получить
		DetailedDescription: Наденьте эти сапоги. Мир велик, а шаг решает многое.
	}

	ExploreDungeon: {
		DisplayName: Жуткая темница
		Description: Найти вход в Темницу
		QuestObjective.Description: Дойти до Темницы
		DetailedDescription: За проклятыми кирпичами стоит страж Темницы. Кто зашёл, не победив Скелетрона, обычно не выходит.
	}

	ExploreHell: {
		DisplayName: Адская бездна
		Description: Спуститься в Ад
		QuestObjective.Description: Дойти до Ада
		DetailedDescription: В самой глубине мира текут реки лавы. Это дом демонов, а также месторождение обсидиана и адского камня. Смотрите под ноги, не упадите.
	}

	ExploreJungle: {
		DisplayName: Экспедиция в джунгли
		Description: Углубиться в биом джунглей
		QuestObjective.Description: Дойти до джунглей
		DetailedDescription: Полный жизни, но смертельно опасный зеленый лабиринт. Густая растительность скрывает древние храмы и смертоносные рои пчел.
	}

	ExploreOcean: {
		DisplayName: Край света
		Description: Дойти до биома океана
		QuestObjective.Description: Дойти до океана
		DetailedDescription: Край континента. Здесь небо встречается с морем. Под глубокой синевой скрываются затонувшие корабли и неизвестные морские чудовища.
	}

	ExploreSnow: {
		DisplayName: Ледяные земли
		Description: Исследовать снежный биом
		QuestObjective.Description: Дойти до снегов
		DetailedDescription: Здесь вечная мерзлота, ветер сбивает с ног. Живут пингвины и волки: первые безвредны, вторые — нет.
	}

	ExploreSpace: {
		DisplayName: Море звезд
		Description: Полететь в космос
		QuestObjective.Description: Дойти до космоса
		DetailedDescription: Избавьтесь от оков гравитации и прикоснитесь к звездам. Только взлетев достаточно высоко, можно увидеть этот мир целиком.
	}

	HellLabSchematic: {
		DisplayName: Чертеж Ада
		Description: Найти зашифрованный чертеж в лаборатории Дрэйдона в Аду
		QuestObjective.Description: Получить чертеж Ада
		DetailedDescription: Дрэйдон основал аванпост в Аду, используя местное геотермальное тепло для экспериментов. Найдите там чертежи, возможно, они откроют доступ к новому оружию.
	}

	IceLabSchematic: {
		DisplayName: Полярный шифр
		Description: Найти зашифрованный чертеж в лаборатории Дрэйдона в снегах
		QuestObjective.Description: Получить ледяной чертеж
		DetailedDescription: Низкие температуры — идеальная среда для сохранения точных приборов. Проникните в лабораторию подо льдами и найдите законсервированные полярные технологии.
	}

	JungleLabSchematic: {
		DisplayName: Проект джунглей
		Description: Найти зашифрованный чертеж в лаборатории Дрэйдона в джунглях
		QuestObjective.Description: Получить чертеж джунглей
		DetailedDescription: Густые джунгли скрывают биолабораторию Дрэйдона. Там он изучал чуму и нановирусы. Найдите этот чертеж, чтобы раскрыть опасную правду.
	}

	PlanetoidLabSchematic: {
		DisplayName: Загадка звездного потока
		Description: Найти зашифрованный чертеж в лаборатории Дрэйдона на планетоиде
		QuestObjective.Description: Получить чертеж планетоида
		DetailedDescription: В условиях микрогравитации высоко в небе дрейфует лаборатория Дрэйдона. Отправляйтесь туда, чтобы найти ранние чертежи Экзо-механизмов.
	}

	SunkenSeaLabSchematic: {
		DisplayName: Затерянное море
		Description: Найти зашифрованный чертеж в лаборатории Дрэйдона в Затерянном море
		QuestObjective.Description: Получить чертеж Затерянного моря
		DetailedDescription: В этом безмятежном подземном море Дрэйдон оставил исследования призматической энергии. Нырните под воду и заберите эти ценные данные.
	}

	AquaticScourgeQuest: {
		DisplayName: Акватический бич
		Description: Победить Акватического бича
		DetailedDescription: Некогда мирный гигант чистых вод, теперь искаженный токсинами Сернистого моря. В этих загрязненных кислотных водах остерегайтесь его внезапных рывков и ядовитых облаков.
	}

	QueenSlimeQuest: {
		DisplayName: Королева слизней
		Description: Победить Королеву слизней
		DetailedDescription: Кристальная императрица Святых земель, владычица всей святой гели. Куда быстрее и смертоноснее супруга — и она умеет летать.
	}

	BuildHouse: {
		DisplayName: Мастер-строитель
		Description: Построить подходящий дом
		QuestObjective.Description: Построить валидный дом
		DetailedDescription: Каждому нужно убежище. Будь то Гид или другие странники, если вы предоставите комнату со столом, стулом, светом и стенами, они будут служить вам.
	}

	CollectEvilOres: {
		DisplayName: Залежи зла
		Description: Собрать руду злого биома
		QuestObjective.Description: Собрать демонитовую или кримтановую руду
		DetailedDescription: Эта руда источает зловещую ауру, она холодная и липкая на ощупь. Хоть она и происходит из очага болезни этого мира, это незаменимый материал для создания мощного снаряжения.
	}

	CollectFallenStars: {
		DisplayName: Собиратель звезд
		Description: Собрать упавшие звезды
		QuestObjective.Description: Собрать упавшие звезды
		DetailedDescription: Слезы ночного неба, падающие лишь с наступлением темноты. Соберите их, чтобы не только увеличить запас маны, но и использовать как мощные боеприпасы или материал для магии.
	}

	CollectGems: {
		DisplayName: Коллекционер драгоценностей
		Description: Собрать различные драгоценные камни
		QuestObjective.Description: Собрать 5 видов разных камней
		DetailedDescription: Сияющие кристаллы, скрытые в толще породы. Помимо украшений, они важны для создания посохов и крюков-кошек. Собрав камни разных цветов, вы, возможно, сможете воссоздать сияние радуги.
	}

	CollectHerbs: {
		DisplayName: Ученик травника
		Description: Собрать различные травы
		QuestObjective.Description: Собрать 3 вида разных трав
		DetailedDescription: Основа алхимии. Разные растения растут в разных условиях: в пустыне, снегах и даже в Аду. Умение различать их — первый шаг к тому, чтобы стать мастером алхимии.
	}

	CollectOres: {
		DisplayName: Сбор руды
		Description: Собрать базовую руду

		QuestObjective: {
			Description: {
				Iron: Собрать железную или свинцовую руду
				Copper: Собрать медную или оловянную руду
			}
		}

		DetailedDescription: Раскопки — основа выживания. Медь и железо хоть и обычны, но они — фундамент вашего выхода из первобытной жизни. Не пренебрегайте ими, ведь даже легендарные герои начинали с взмахов медной киркой.
	}

	DeepExplorer: {
		DisplayName: Исследователь бездны
		Description: Исследовать все основные биомы
		QuestObjective.Description: Завершить все задания по исследованию
		DetailedDescription: Вы обошли каждый угол мира — от самых высоких облаков до самого глубокого ада. На карте больше нет белых пятен.
	}

	ExploreCaverns: {
		DisplayName: Глубины пещер
		Description: Исследовать глубокие слои пещер
		QuestObjective.Description: Дойти до слоя пещер
		DetailedDescription: Здесь нет солнца, только тьма и неизвестные существа. Появляется лава, а залежи руды становятся богаче. Смотрите под ноги, бездна смотрит на вас.
	}

	ExploreCorruption: {
		DisplayName: Земли Порчи
		Description: Исследовать Порчу или Багрянец
		QuestObjective.Description: Войти в Порчу или Багрянец
		DetailedDescription: Эта земля больна. Фиолетовая гниль или красная плоть пожирают землю. Хоть здесь и полно кровожадных монстров, только проникнув в логово зверя, можно добыть теневую чешую или образцы ткани.
	}

	ExploreDesert: {
		DisplayName: Жгучая пустыня
		Description: Ступить в биом пустыни
		QuestObjective.Description: Дойти до пустыни
		DetailedDescription: Палящее солнце выжигает землю, а под золотыми песками скрыты древние окаменелости и свирепые муравьиные львы. Запаситесь водой, здешняя сухость может стоить вам жизни.
	}

	ExploreFloatingIsland: {
		DisplayName: Парящие острова
		Description: Найти парящий остров в небе
		QuestObjective.Description: Дойти до парящего острова
		DetailedDescription: Над облаками плывут острова с сокровищницами древней цивилизации. Ищите аномалии гравитации или стройте башню сами.
	}

	ExploreGlowingMushroom: {
		DisplayName: Светящиеся грибы
		Description: Найти биом светящихся грибов
		QuestObjective.Description: Дойти до грибного биома
		DetailedDescription: Подземная экосистема, полная психоделических красок. Гигантские грибы излучают призрачный синий свет, разгоняя тьму. Это дом Трюфеля и диковинных насекомых.
	}

	ExploreUnderground: {
		DisplayName: Подземная экспедиция
		Description: Углубиться в подземелье
		QuestObjective.Description: Дойти до подземелья
		DetailedDescription: Под слоем земли — камень. Берите факелы, внизу ещё много ярусов.
	}

	FindLifeCrystal: {
		DisplayName: Источник жизни
		Description: Найти кристалл жизни
		QuestObjective.Description: Найти кристалл жизни
		DetailedDescription: Этот красный кристалл наполнен жизненной силой. Разбейте и используйте его, чтобы навсегда укрепить свое тело. Это ключ к выживанию в битвах с сильными врагами.
	}

	FindShadowOrb: {
		DisplayName: Ядро зла
		Description: Найти теневую сферу или багряное сердце в глубинах зла
		QuestObjective.Description: Уничтожить теневую сферу или сердце
		DetailedDescription: В глубинах злых разломов пульсируют гнилые сердца или теневые сферы. Разбив их, вы получите оружие, но будьте осторожны...... если разобьете три, то пробудите нечто ужасное.
	}

	FirstPotion: {
		DisplayName: Основы алхимии
		Description: Создать свое первое зелье
		QuestObjective.Description: Создать любое зелье
		DetailedDescription: Поставьте пустую банку на стол, и у вас получится простая алхимическая станция. Сложные заклинания не нужны, только правильное смешивание ингредиентов. Выпейте и почувствуйте силу магии.
	}

	NPCVillage: {
		DisplayName: Процветающая деревня
		Description: Привлечь несколько поселенцев
		QuestObjective.Description: Иметь 5 поселенцев
		DetailedDescription: Выживать в дикой природе в одиночку тяжело. Когда вы станете сильнее и богаче, к вам потянутся люди. Создайте процветающее сообщество, и они станут вашей опорой.
	}

	QueenBeeQuest: {
		DisplayName: Королева пчел
		Description: Победить Королеву пчел
		DetailedDescription: В глубине подземных джунглей, в огромном улье, уничтожение личинки разгневает правительницу всего роя. Приготовьте противоядия и остерегайтесь её жал и скоростных рывков.
	}

	CollectorQuest: {
		DisplayName: Помощник-сборщик
		Description: Получить Сборщика
		DetailedDescription: Устройство само подбирает дроп вокруг. Вход в автоматическую логистику: с земли больше не нужно собирать по штуке.
	}

	LumberjackQuest: {
		DisplayName: Время рубить
		Description: Получить Дровосека
		DetailedDescription: Древесина — основа промышленности и строительства. Забудьте о примитивных топорах, эта машина использует электричество для автоматического управления вашей лесофермой, обеспечивая непрерывный поток древесины.
	}

	LifeWeaverQuest: {
		DisplayName: Озеленение
		Description: Получить Сажатель деревьев
		DetailedDescription: Восстановление лесов обычно идет медленно. Эта машина использует электричество для точной посадки саженцев, быстро возвращая жизнь на пустынные земли. Это последний элемент пазла для создания полностью автоматической цикличной лесофермы.
	}

	IncineratorQuest: {
		DisplayName: Электрическая плавильня
		Description: Создать электрический инсинератор
		DetailedDescription: Традиционные печи неэффективны и тратят впустую много минеральной эссенции. Эта машина использует экстремальные температуры высоковольтной дуги для полного расщепления руды, извлекая вдвое больше продукта, чем раньше. Это решающий шаг к индустриализации.
	}

	ItemPipelineQuest: {
		DisplayName: Логистическая система
		Description: Создать логистическую трубу
		DetailedDescription: Трубы — вены промышленности. Соедините машины и контейнеры, и предметы сами пойдут куда надо. Бегать между сундуками больше не придётся.
	}

	ThrowerQuest: {
		DisplayName: Выбрасыватель
		Description: Создать выбрасыватель
		DetailedDescription: Не все предметы стоит хранить. Это устройство выводит предметы из логистической сети, выбрасывая их в мир. Будь то для специфического автокрафта (например, сброс предметов в жидкость) или просто как мусоропровод — оно отлично справится.
	}

	DeerclopsQuest: {
		DisplayName: Циклоп-олень
		Description: Победить Циклопа-оленя
		DetailedDescription: В глубине метели стоит одноглазый гигантский олень. Он сам за вами не придёт — это вы лезете к нему.
	}

	DukeFishronQuest: {
		DisplayName: Герцог Рыброн
		Description: Победить Герцога Рыброна
		DetailedDescription: Наживите крючок трюфельным червём — и в море клюнет герцог. Свинья, дракон и рыба: три лика ярости на одном лице.
	}

	EmpressOfLightQuest: {
		DisplayName: Императрица света
		Description: Победить Императрицу света
		DetailedDescription: Раздавите радужную бабочку в Святых землях — разгневанная императрица придёт выяснять сама. Если разозлить её днём, любой удар смертелен с одного попадания.
	}

	ZenithQuest: {
		DisplayName: Зенит
		Description: Выковать Зенит
		DetailedDescription: От медного короткого меча до Звездоубийцы — каждый клинок, которым вы махали, вас помнит. Сплавьте их вместе, и у этого пути появится форма.
	}

	BloodMoonQuest: {
		DisplayName: Алая ночь
		Description: Пережить кровавую луну
		QuestObjective.Description: Пережить кровавую луну
		DetailedDescription: В ночи, когда луна краснеет, монстры больше не стучат — они открывают дверь сами. Доживите до рассвета.
	}

	TorchGodQuest: {
		DisplayName: Бог Факелов
		Description: Пройти испытание Бога Факелов
		QuestObjective.Description: Получить благословение Бога Факелов
		DetailedDescription: Воткните под землёй сто факелов — и хозяин пламени сам испытает вас. В погасшем свете прячется его милость.
	}

	GoblinArmyQuest: {
		DisplayName: Нашествие гоблинов
		Description: Отбить армию гоблинов
		QuestObjective.Description: Отбить армию гоблинов
		DetailedDescription: Разбитые теневые сферы их приманят, и растущее поселение тоже. Короткие, стаями, без конца; но победите — и, быть может, подберёте пленника, который чинит снаряжение.
	}

	OldOnesArmyQuest: {
		DisplayName: Армия Древних
		Description: Удержать кристалл Этернии и отбить Армию Древних во всех трёх волнах

		QuestObjective: {
			Description: {
				T1: Отбить Армию Древних, 1-я волна
				T2: Отбить Армию Древних, 2-я волна
				T3: Отбить Армию Древних, 3-я волна
			}
		}

		DetailedDescription: Трактирщик принёс просьбу из другого мира. Поставьте кристалл, держите порталы, не дайте ничему его коснуться. Три эшелона, каждый злее предыдущего.
	}

	PirateInvasionQuest: {
		DisplayName: Нашествие пиратов
		Description: Отбить нашествие пиратов
		QuestObjective.Description: Отбить нашествие пиратов
		DetailedDescription: Когда мир затвердеет, на горизонте появятся паруса. Они грабят вас — грабьте обратно, заодно и пожитки капитана.
	}

	SolarEclipseQuest: {
		DisplayName: Охота в затмении
		Description: Убить Мотерона во время солнечного затмения
		QuestObjective.Description: Убить Мотерона
		DetailedDescription: В дни, когда луна закрывает солнце, день страшнее ночи. На улицу выходит всё из фильмов ужасов, а самый быстрый летун среди них — Мотерон.
	}

	MartianMadnessQuest: {
		DisplayName: Марсианское безумие
		Description: Отбить нашествие марсиан
		QuestObjective.Description: Отбить нашествие марсиан
		DetailedDescription: Не пяльтесь на зонд в небе — он улетит домой и приведёт своих. Тарелки, лучи смерти, шлемы контроля разума: полный набор инопланетного вторжения.
	}

	PumpkinMoonQuest: {
		DisplayName: Тыквенная луна
		Description: Победить Тыквенного короля во время Тыквенной луны
		QuestObjective.Description: Победить Тыквенного короля
		DetailedDescription: Медальоном Тыквенной луны разбудите Хэллоуин. Пугала выстраиваются за головами, а напоследок выходит король с двумя косами.
	}

	FrostMoonQuest: {
		DisplayName: Морозная луна
		Description: Победить Ледяную королеву во время Морозной луны
		QuestObjective.Description: Победить Ледяную королеву
		DetailedDescription: Разверните тот подарок, который лучше было не открывать, — и канун Рождества скиснет. Танки патрулируют снег, королева пикирует в метели.
	}

	FishermanQuest: {
		DisplayName: Поручения рыбака
		Description: Выполнить пять поручений рыбака
		QuestObjective.Description: Выполнить поручения рыбака
		DetailedDescription: У моря живёт властный мальчишка, но награды у него на удивление весомые. Где рыба — там и клад.
	}

	LifeMaxQuest: {
		DisplayName: Источник жизни
		Description: Поднять запас здоровья до 400
		QuestObjective.Description: Довести запас здоровья до 400
		DetailedDescription: Кристаллы жизни доведут вас только до половины. Остальное — боями и ростом. Четыреста здоровья — билет, чтобы устоять в хардмоде.
	}

	ManaMaxQuest: {
		DisplayName: Сердце маны
		Description: Поднять запас маны до 200
		QuestObjective.Description: Довести запас маны до 200
		DetailedDescription: Спрессуйте упавшие звёзды в кристаллы и скармливайте себе по одному. Двадцать очков за глоток, девять глотков — и ночное небо течёт у вас в жилах.
	}

	WingsQuest: {
		DisplayName: Расправить крылья
		Description: Надеть любую пару крыльев
		QuestObjective.Description: Надеть крылья
		DetailedDescription: Небесные сокровищницы, перья фей, кожи демонов. Откуда бы ни взялись — в миг, когда крылья вырастут за спиной, урон от падения станет историей.
	}

	MoneyQuest: {
		DisplayName: Первый капитал
		Description: Иметь при себе платиновую монету
		QuestObjective.Description: Иметь платиновую монету
		DetailedDescription: Сто золотых спрессованы в одну платиновую. Пока копили, вы наверняка умирали не раз; торговцы называют это комиссией.
	}

	ExploreAetherQuest: {
		DisplayName: Озеро мерцания
		Description: Найти озеро мерцания
		QuestObjective.Description: Дойти до озера мерцания
		DetailedDescription: В углу мира спрятано озеро, которому здесь не место. Бросьте вещь — вытащите уже другую. Сами не прыгайте проверять.
	}

	HardmodeOresQuest: {
		DisplayName: Три новых металла
		Description: Собрать трёхъярусную руду хардмода

		QuestObjective: {
			Description: {
				T1: Собрать кобальтовую или палладиевую руду
				T2: Собрать мифриловую или орихалковую руду
				T3: Собрать адамантитовую или титановую руду
			}
		}

		DetailedDescription: Когда падёт Стена плоти, разбейте алтари священным молотом — в глубине вырастут три новых металла. Каждый твёрже всего, что было раньше.
	}

	ChlorophyteQuest: {
		DisplayName: Сила хлорофита
		Description: Собрать 30 хлорофитовой руды
		DetailedDescription: Когда падут машины, в глубокой грязи джунглей начнёт расти светящийся зелёный металл. У него своя воля, и он сам себя размножает.
	}

	CalamityLoreHub: {
		DisplayName: Расследование аномалии
		Description: С этим миром что-то не так
		QuestObjective.Description: Нажмите, чтобы получить
		DetailedDescription: Море кислое, скалы горят, в воронке от звезды растёт то, чего нет ни в одном справочнике. Записывайте: тёмная сторона этого мира куда больше, чем кажется.
	}

	ExploreSulphurSea: {
		DisplayName: Серное море
		Description: Исследовать Серное море
		QuestObjective.Description: Дойти до Серного моря
		DetailedDescription: С одной стороны мира нет синего океана, только желтоватая кислота. Дождь шипит, рыба выплывает ядовитой. Закройте рот и нос, не пейте.
	}

	ExploreAbyss: {
		DisplayName: Устье Бездны
		Description: Нырнуть в Бездну под Серным морем
		QuestObjective.Description: Войти в Бездну
		DetailedDescription: В дне Серного моря зияет щель вниз. Свет туда не доходит, дыхание тоже, и чем глубже — тем древнее то, что там живёт.
	}

	AbyssDeepQuest: {
		DisplayName: Дно Бездны
		Description: Принести из Бездны люменил и камень Пустоты
		DetailedDescription: Там, куда не достают шахтёрские лампы, по стенам растут голубые кристаллы. Выкопайте их и всплывите живыми — только тогда вы по-настоящему были в Бездне.
	}

	ExploreSunkenSea: {
		DisplayName: Затерянное море
		Description: Найти Затерянное море в глубинах подземной пустыни
		QuestObjective.Description: Дойти до Затерянного моря
		DetailedDescription: Под пустыней спрятана тихая синева. В воде светятся призмы, моллюски больше вашего дома. Пожалуй, самый мягкий угол этого мира.
	}

	ExploreBrimstoneCrag: {
		DisplayName: Серные скалы
		Description: Ступить на Серные скалы у края Ада
		QuestObjective.Description: Дойти до Серных скал
		DetailedDescription: С одной стороны Ада стоит утёс, который горит неизвестно сколько лет. Из щелей кирпича сочится тёмно-красный огонь, в руинах спит дух стихий.
	}

	ExploreAstral: {
		DisplayName: Звёздная порча
		Description: Исследовать землю, заражённую звёздным сиянием
		QuestObjective.Description: Дойти до Астральной инфекции
		DetailedDescription: Звезда врезалась в мир, и то, что выросло в воронке, не принадлежит ни одному бестиарию. Земля меняет цвет, твари меняют форму, и это только начало.
	}

	AcidRainQuest: {
		DisplayName: Кислотный дождь близко
		Description: Пережить кислотный дождь
		QuestObjective.Description: Пережить событие кислотного дождя
		DetailedDescription: Над Серным морем облака жёлтые. Когда идёт дождь, всё море кипит, и то, что в воде, ползёт на берег вместе с ним. Возьмите зонт. Серьёзно.
	}

	DeliciousMeatQuest: {
		DisplayName: Вкусный стейк
		Description: Добыть кусок вкусного стейка
		DetailedDescription: Никто не знает, с какого это зверя, и никому не важно. Вкусно, сытно, ещё и как стройблок годится. Запасайтесь.
	}

	BrimlishQuest: {
		DisplayName: Серная рыба
		Description: Выудить серную рыбу
		DetailedDescription: Даже в кислоте водится рыба, да ещё на удивление бодрая. Закиньте крючок в Серное море и посмотрите, что клюнет.
	}

	GiantClamQuest: {
		DisplayName: Гигантский моллюск
		Description: Победить Гигантского моллюска
		DetailedDescription: Самая большая раковина Затерянного моря. Обычно тиха как камень; все, кто её вскрывал, жалели.
	}

	CragmawMireQuest: {
		DisplayName: Пасть трясины
		Description: Победить Пасть трясины во время кислотного дождя
		DetailedDescription: Когда мир затвердеет, в кислотном дожде всплывёт кусок ила, который кусается. Зубов слишком много, и все смотрят на вас.
	}

	MaulerQuest: {
		DisplayName: Кровозубая акула
		Description: Победить Кровозубую акулу во время кислотного дождя
		DetailedDescription: Акула, выросшая на кислоте, с нравом под стать кислотности. Когда она выпрыгивает из воды, вспоминать уже поздно.
	}

	NuclearTerrorQuest: {
		DisplayName: Ядерный ужас
		Description: Победить Ядерный ужас во время кислотного дождя
		DetailedDescription: В самой глубине кислотного дождя вылупляется светящийся колосс. Даже кислота отступает там, где он ступает.
	}

	GreatSandSharkQuest: {
		DisplayName: Великая песчаная акула
		Description: Победить Великую песчаную акулу
		DetailedDescription: Самый быстрый охотник пустыни, дюны — её море. Перебейте достаточно родичей — и вожак стаи явится лично.
	}

	LeviathanQuest: {
		DisplayName: Анахита и Левиафан
		Description: Победить Анахиту и Левиафана
		DetailedDescription: Сначала песня, потом огромная тень. Мелодия сирены ведёт зверя бездны; не останавливайтесь слушать.
	}

	AstrumAureusQuest: {
		DisplayName: Аструм Ауреус
		Description: Победить Аструм Ауреуса
		DetailedDescription: В глубине Астральной инфекции лежит заражённая боевая машина. Ночью она просыпается, и там, где прошли гусеницы, ничего не растёт.
	}

	RavagerQuest: {
		DisplayName: Опустошитель
		Description: Победить Опустошителя
		DetailedDescription: Гигант из плоти и кирпича, каждая часть бьёт отдельно. Оторвите все четыре конечности — тогда туловище возьмётся всерьёз.
	}

	AstrumDeusQuest: {
		DisplayName: Аструм Деус
		Description: Победить Аструм Деуса
		DetailedDescription: Возложите дар на астральный маяк — и с ночного неба сойдёт заражённый бог. Только его смерть откроет астральную руду вашему кайлу.
	}

	BossRushQuest: {
		DisplayName: Финальная битва
		Description: Пройти финальную битву один раз
		QuestObjective.Description: Завершить финальную битву
		DetailedDescription: Раздавите Терминус — и всё, что вы когда-либо убивали, выстроится снова. Перебейте всех во второй раз, и на этом пути можно ставить печать.
	}

	AerialiteQuest: {
		DisplayName: Сияние небесной лазури
		Description: Выковать аэралитовые слитки
		DetailedDescription: Когда умрёт Пустынный бич, с неба осядет бледно-голубая рудная пыль. Лёгкая, почти плывёт, но крепче железа.
	}

	CryonicQuest: {
		DisplayName: Полярный кристалл
		Description: Выковать крионические слитки
		DetailedDescription: Когда Криоген расколется, в глубинном льду тундры проявятся синие жилы. В руке не тает — только холодеет.
	}

	PerennialQuest: {
		DisplayName: Дар вечнозелёного
		Description: Выковать многолетние слитки
		DetailedDescription: Там, где увяла Плантера, из почвы растёт дышащий зелёный металл. Джунгли благодарят по-своему.
	}

	LifeAlloyQuest: {
		DisplayName: Сплав жизни
		Description: Выплавить сплав жизни
		DetailedDescription: Три живых металла сплавлены в один; на слитке ещё бьётся пульс. На нём держатся все каркасы высшего снаряжения.
	}

	AstralBarQuest: {
		DisplayName: Астральная выплавка
		Description: Выковать астральные слитки
		DetailedDescription: Когда бог-червь мёртв, астральные жилы наконец поддаются кайлу. Слитки сами светятся в темноте.
	}

	UelibloomQuest: {
		DisplayName: Цветение уэлиблума
		Description: Выковать уэлиблумовые слитки
		DetailedDescription: После священного огня богини в грязи джунглей расцвели металлические цветы. Лепестки плавят в слитки, а свет остаётся внутри.
	}

	BloodstoneQuest: {
		DisplayName: Закалка кровавого камня
		Description: Сгустить ядра кровавого камня
		DetailedDescription: Когда богиня пала, из лавы Серных скал всплыли тёмно-красные камни. Они всё ещё бьются, как сердца вне тела.
	}

	AscendantEssenceQuest: {
		DisplayName: Вознесённый дух
		Description: Сгустить эссенцию вознесённого духа
		DetailedDescription: Призраки, звёздная пыль, лунный свет и упрямство, которое не рассеялось. Сожмите в одну эссенцию — хватит зажечь легенду.
	}

	YharonSoulQuest: {
		DisplayName: Угли драконьей души
		Description: Собрать осколки души Ярона
		DetailedDescription: Когда великий дракон выгорел, в пламени осталось не пепел, а всё ещё горячие осколки души. Поднимая, берегите сердце — обожжёт.
	}

	FruitQuest: {
		DisplayName: Дары жизни
		Description: Собрать все четыре плода, усиливающие здоровье
		DetailedDescription: У тел сильных врагов иногда зреют странные плоды. Всего четыре вида, и каждый поднимает ваш запас здоровья к новому пределу.
	}

	DraedonPowerCellQuest: {
		DisplayName: Древняя энергия
		Description: Собрать энергоячейки
		DetailedDescription: В руинах лабораторий валяются ячейки, в которых ещё остался заряд. Плотность энергии далеко за пределами ваших генераторов — стоит изучить.
	}

	DraedonsForgeQuest: {
		DisplayName: Кузня мастера
		Description: Получить кузню мастера
		DetailedDescription: На конце промышленности стоит печь, которая плавит всё. Соберите её — и в мастерской больше не будет того, чего нельзя сделать.
	}

	ConquerorMilestone: {
		DisplayName: Летопись завоеваний
		Description: Победить каждого сильного врага этого мира
		QuestObjective.Description: Завершить все охотничьи задания
		DetailedDescription: От Короля слизней до того, что стоит на краю мира, — закончите каждый тяжёлый бой. Эту страницу заполняют немногие.
	}

	EventMilestone: {
		DisplayName: Усмиритель событий
		Description: Усмирить каждое нашествие и каждую аномалию
		QuestObjective.Description: Завершить все задания событий
		DetailedDescription: Армии, флоты, луны из других миров. Всё, что приходило толпами, вы отправили обратно.
	}

	CompletionistMilestone: {
		DisplayName: Полный кодекс
		Description: Закончить всё в журнале заданий
		QuestObjective.Description: Завершить все задания
		DetailedDescription: Последняя страница этой книги оставлена тому, кто прочёл её целиком. Когда закроете, в этом мире не останется ничего, чего вы не видели.
	}
}
