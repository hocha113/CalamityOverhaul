QuestNode: {
	FirstQuest: {
		DisplayName: Добро пожаловать в этот мир!
		Description: Начало путешествия
		DetailedDescription: Каждая легенда начинается с малого. Заберите свое стартовое снаряжение и приготовьтесь встретить этот мир, полный богов и чудовищ.
		QuestObjective.Description: Нажмите, чтобы получить стартовые предметы
	}

	MiningQuest: {
		DisplayName: Начало раскопок
		Description: Добыть 10 ед. {0}
		DetailedDescription: Подземелья хранят бесконечные богатства. Для начала нам понадобятся базовые металлы для создания инструментов.
	}

	MiningQuestII: {
		DisplayName: Железный век
		Description: Собрать 50 ед. {0}
		DetailedDescription: Медь слишком мягкая, нам нужен более твердый металл, чтобы защитить себя. Спускайтесь глубже в поисках железных жил.
	}

	MiningQuestIII: {
		DisplayName: Золотая лихорадка
		Description: Собрать 100 ед. {0}
		DetailedDescription: Золото — это не просто валюта, оно обладает отличной магической проводимостью и ковкостью. Хотя оно не так твердо, как железо, это важный материал для создания снаряжения высокого уровня.
	}

	BrimstoneElementalQuest: {
		DisplayName: Серный элементаль
		Description: Победить Серного элементаля
		DetailedDescription: В руинах Серных скал пробудите и победите дремлющего духа стихий. Остерегайтесь её пулевого ада.
	}

	CalamitasCloneQuest: {
		DisplayName: Клон Каламитас
		Description: Победить Клона Каламитас
		DetailedDescription: Клон, наполненный ненавистью и жаждой разрушения. Победите его, чтобы доказать, что вы достойны встретиться с настоящей ведьмой.
	}

	CrabulonQuest: {
		DisplayName: Крабулон
		Description: Победить Крабулона
		DetailedDescription: В подземном биоме светящихся грибов скрывается гигантский краб, пораженный грибком. Его споры очень опасны.
	}

	CryogenQuest: {
		DisplayName: Криоген
		Description: Победить Криогена
		DetailedDescription: Этот некогда могущественный криомант был заточен в вечной ледяной тюрьме. Освободите и победите его, чтобы высвободить холодную силу полярных льдов.
	}

	DesertScourgeQuest: {
		DisplayName: Пустынный бич
		Description: Победить Пустынного бича
		DetailedDescription: Бывший повелитель морей, ныне влачащий жалкое существование в высохшей пустыне. Остерегайтесь его огромных челюстей и миньонов.
	}

	EaterofWorldsQuest: {
		DisplayName: Пожиратель миров / Мозг Ктулху
		Description: Победить босса Порчи или Багрянца
		QuestObjective.Description: Победить Пожирателя миров или Мозг Ктулху
		DetailedDescription: Зло распространяется. Проникните в очаг болезни этого мира и искорените гигантского червя или зловещий мозг, обитающий там.
	}

	EyeofCthulhuQuest: {
		DisplayName: Глаз Ктулху
		Description: Победить Глаз Ктулху
		DetailedDescription: Стоит вам почувствовать этот злобный взгляд, как он появится. Это первое настоящее испытание вашей силы.
	}

	GolemQuest: {
		DisplayName: Голем
		Description: Победить Голема
		DetailedDescription: В глубинах Храма джунглей покоится древняя машина войны. Берегитесь его лазеров и тяжелых кулаков.
	}

	HiveMindQuest: {
		DisplayName: Разум улья / Перфораторы
		Description: Победить истинное божество злого биома
		QuestObjective.Description: Победить Разум улья или Перфораторов
		DetailedDescription: Они являются воплощением сознания Порчи и Багрянца. Если их не уничтожить, эта земля никогда не узнает покоя.
	}

	KingSlimeQuest: {
		DisplayName: Король слизней
		Description: Победить Короля слизней
		DetailedDescription: Повелитель гелевых существ. Хоть он и выглядит комично, не дайте его огромному телу раздавить вас.
	}

	LunaticCultistQuest: {
		DisplayName: Лунатик-культист
		Description: Победить Лунатика-культиста
		DetailedDescription: У входа в Темницу группа фанатиков пытается предотвратить — или вызвать — конец света. Остановите их ритуал.
	}

	MechanicalBossesQuest: {
		DisplayName: Механические боссы
		Description: Победить всех механических боссов
		QuestObjective.Description: Победить всех механических боссов
		DetailedDescription: Кто-то воссоздал органы Ктулху из стали. Пара глаз, череп и длинный червь.
	}

	MoonLordQuest: {
		DisplayName: Лунный лорд
		Description: Победить Лунного лорда
		DetailedDescription: Кукловод за кулисами всего происходящего, ужас с обратной стороны Луны. Положите конец этому долгому кошмару.
	}

	PlaguebringerGoliathQuest: {
		DisplayName: Предвестница чумы, Голиаф
		Description: Победить Предвестницу чумы, Голиаф
		DetailedDescription: Королева пчел, модифицированная нановирусом. Она не только смертоносна, но и переносит опасную чуму.
	}

	PlanteraQuest: {
		DisplayName: Плантера
		Description: Победить Плантеру
		DetailedDescription: В глубине джунглей дремлет гигантский цветок-людоед. Разбейте бутон и столкнитесь с яростью джунглей.
	}

	SkeletronQuest: {
		DisplayName: Скелетрон
		Description: Победить Скелетрона
		DetailedDescription: Только победив этого проклятого старика, вы сможете безопасно войти в Темницу и исследовать её тайны.
	}

	SlimeGodQuest: {
		DisplayName: Бог слизней
		Description: Победить Бога слизней
		DetailedDescription: Вершина эволюции слизней, древнее и ненасытное божество. Остерегайтесь комбинированных атак его частей.
	}

	WallofFleshQuest: {
		DisplayName: Стена плоти
		Description: Победить Стену плоти
		DetailedDescription: Страж этого мира. Бросьте куклу гида в лаву, чтобы освободить древних духов и начать Хардмод.
	}

	CeaselessVoidQuest: {
		DisplayName: Нескончаемая пустота
		Description: Победить Нескончаемую пустоту
		DetailedDescription: Один из стражей Пожирателя богов, зеркало небытия из иного измерения.
	}

	DevourerofGodsQuest: {
		DisplayName: Пожиратель богов
		Description: Победить Пожирателя богов
		DetailedDescription: Космический змей, жаждущий поглотить всю божественность. Сразитесь с ним в пустоте и не дайте себя сожрать.
	}

	DragonfollyQuest: {
		DisplayName: Псевдодракон
		Description: Победить Псевдодракона
		DetailedDescription: Неудачный продукт попытки воскресить Ярона, безумный и наэлектризованный лжедракон.
	}

	ExoMechsQuest: {
		DisplayName: Экзо-механизмы
		Description: Победить Экзо-механизмы
		DetailedDescription: Главный шедевр Дрэйдона, вершина технологий Террарии. Выживите в этом идеальном представлении.
	}

	OldDukeQuest: {
		DisplayName: Герцог-реликт Серного моря
		Description: Победить герцога-реликта Серного моря
		DetailedDescription: Древний владыка глубин Серного моря, сочетание мутации и силы. Остерегайтесь его ядовитого пара.
	}

	PolterghastQuest: {
		DisplayName: Полтергаст
		Description: Победить Полтергаста
		DetailedDescription: Монстр, созданный из скопления душ, погибших в Темнице. Усмирите их гнев.
	}

	PrimordialWyrmQuest: {
		DisplayName: Первозданный змий
		Description: Победить Первозданного змия
		DetailedDescription: Страж глубочайшего слоя Бездны. Существо более древнее, чем сами боги. Не беспокойте его без необходимости.
	}

	ProfanedGuardiansQuest: {
		DisplayName: Оскверненные стражи
		Description: Победить Оскверненных стражей
		DetailedDescription: Верные защитники Оскверненной богини. Победите их, чтобы ослабить защиту божества.
	}

	ProvidenceQuest: {
		DisplayName: Провиденс
		Description: Победить Провиденс
		DetailedDescription: Богиня, управляющая священным огнем и очищением. Бросьте ей вызов в Святых землях или в Аду, но берегитесь её испепеляющего пламени.
	}

	SignusQuest: {
		DisplayName: Сигнус
		Description: Победить Сигнуса
		DetailedDescription: Один из стражей Пожирателя богов, невидимый убийца, призрак пустоты.
	}

	StormWeaverQuest: {
		DisplayName: Штормовой ткач
		Description: Победить Штормового ткача
		DetailedDescription: Один из стражей Пожирателя богов, небесный червь, питающийся грозами и молниями.
	}

	SupremeCalamitasQuest: {
		DisplayName: Высшая Каламитас
		Description: Победить Высшую Каламитас
		DetailedDescription: Легендарная серная ведьма. Это конец вашего пути или начало нового? Приготовьтесь встретить настоящий пулевой ад.
	}

	YharonQuest: {
		DisplayName: Ярон, Дракон джунглей
		Description: Победить Ярона, Дракона джунглей
		DetailedDescription: Верный соратник Тирана, дракон, обладающий способностью феникса к возрождению. Это испытание для вашей души.
	}

	BatteryQuest: {
		DisplayName: Хранение энергии
		Description: Создать термальную батарею
		DetailedDescription: Произведенное электричество нужно хранить. Создание батареи — первый шаг к построению стабильной энергосети.
	}

	HydroelectricQuest: {
		DisplayName: Чистая энергия
		Description: Создать гидроэлектрогенератор
		DetailedDescription: Используйте силу текущей воды для выработки электричества. Это чистый и устойчивый источник энергии.
	}

	IndustrialStartQuest: {
		DisplayName: Промышленная революция
		Description: Создать ветряной генератор
		DetailedDescription: Первый шаг к автоматизации. Используйте энергию ветра, чтобы привести машины в действие и освободить свои руки.
	}

	ItemFilterQuest: {
		DisplayName: Сортировка логистики
		Description: Создать предметный фильтр
		DetailedDescription: Автоматизированные линии требуют порядка. Используйте фильтры для точного контроля потока предметов.
	}

	MiningMachineQuest: {
		DisplayName: Автоматизированная добыча
		Description: Создать буровую установку
		DetailedDescription: Попрощайтесь с утомительной ручной копкой. Эта машина способна поглощать рудные жилы с невероятной эффективностью.
	}

	MiningMachineIIQuest: {
		DisplayName: Глубокое бурение
		Description: Создать буровую установку MK2
		DetailedDescription: Усиленное энергетическое ядро обеспечивает непревзойденную скорость бурения.
	}

	PipelineQuest: {
		DisplayName: Передача энергии
		Description: Создать универсальный энергопровод
		DetailedDescription: Кровеносные сосуды, соединяющие генераторы и машины. Без них электричество — это лишь застоявшаяся вода.
	}

	TeslaTowerQuest: {
		DisplayName: Башня магнитной бури
		Description: Создать Башню Теслы
		DetailedDescription: Чудо беспроводной передачи энергии. Башня передаёт энергию по воздуху и избавляет от большей части проводки.
	}

	FluidPumpQuest: {
		// DisplayName: Fluid Engineering
		// Description: Craft a Fluid Pump
		// DetailedDescription: Water and lava are resources too. The pump is what invites them out of the world.
	}

	FluidPipelineQuest: {
		// DisplayName: Veins of Liquid
		// Description: Craft Fluid Pipelines
		// DetailedDescription: Liquids need a grid of their own. Fluid pipes carry only fluids and leave the power grid alone.
	}

	FluidTankQuest: {
		// DisplayName: Vessel of Reserves
		// Description: Craft a Fluid Tank
		// DetailedDescription: Pumping fast means nothing without somewhere to keep it. The tank is the battery of the fluid network.
	}

	MagmaGeneratorQuest: {
		// DisplayName: Magma Thermal Power
		// Description: Craft a Magma Thermal Generator
		// DetailedDescription: The pumped magma finally has somewhere to go. It earns a little while touching lava, and runs at full power once its tank is fed.
	}

	ShimmerTransmuterQuest: {
		// DisplayName: Shimmer Alchemy
		// Description: Craft a Shimmer Transmuter
		// DetailedDescription: Pump shimmer into the machine, and item forms can be rewritten on an assembly line.
	}

	CrusherQuest: {
		// DisplayName: Ore from Rubble
		// Description: Craft an Ore Crusher
		// DetailedDescription: Two ore crushed into three. The incinerator's supply line just gained a yield step.
	}

	RecyclerQuest: {
		// DisplayName: Waste into Worth
		// Description: Craft a Recycler
		// DetailedDescription: Don't toss retired gear. Break it into bars by rarity and send it back to the furnace.
	}

	AutoCrafterQuest: {
		// DisplayName: Automated Assembly
		// Description: Craft an Auto Crafter
		// DetailedDescription: Pin a recipe; materials walk in and products walk out. The crafting bench no longer needs you standing by.
	}

	MushroomFarmerQuest: {
		// DisplayName: Fungiculture
		// Description: Craft a Mushroom Farming Machine
		// DetailedDescription: Harvests on grass and mushroom grass are its business. Glowing mushrooms included.
	}

	ApiaryQuest: {
		// DisplayName: Sweet Industry
		// Description: Craft an Electric Apiary
		// DetailedDescription: Empty bottles in, bottled honey out. The hive works harder near honey or in the jungle.
	}

	SlimeVatQuest: {
		// DisplayName: Gel Production
		// Description: Craft a Slime Culture Vat
		// DetailedDescription: Water and power in, gel out. The vat is the first raw-material machine of the farm waste stream.
	}

	BiomassGeneratorQuest: {
		// DisplayName: Closed Ecology
		// Description: Craft a Biomass Generator
		// DetailedDescription: Don't waste the farm's surplus. Feed it to the burner for power and the grow-burn loop starts turning.
	}

	FlameTurretQuest: {
		// DisplayName: Line of Fire
		// Description: Craft a Flamethrower Turret
		// DetailedDescription: A close-range wall of fire against crowds. Load gel and it burns harder.
	}

	CryoTurretQuest: {
		// DisplayName: Frost Lockdown
		// Description: Craft a Cryo Turret
		// DetailedDescription: Not built to kill, built to freeze. Enemies under the tower slow down until they can barely step.
	}

	LaserTurretQuest: {
		// DisplayName: Lightspeed Sniper
		// Description: Craft a Laser Turret
		// DetailedDescription: Anything in line of sight is one beam away. Longest range in the family, and it prefers big targets.
	}

	ShieldGeneratorQuest: {
		// DisplayName: Energy Bulwark
		// Description: Craft a Shield Generator
		// DetailedDescription: Everyone in range gets a layer of absorbing shield. More allies, faster drain.
	}

	HealStationQuest: {
		// DisplayName: Field Medicine
		// Description: Craft a Healing Station
		// DetailedDescription: Stand in the aura and wounds slowly close. The phrase "workplace injury" retires today.
	}

	TeleportStationQuest: {
		// DisplayName: Teleport Network
		// Description: Craft a Teleport Station
		// DetailedDescription: Two stations make a network, and the whole map opens up. The farther the hop, the higher the toll.
	}

	ElectricSundialQuest: {
		// DisplayName: Winding the Sundial
		// Description: Craft an Electric Sundial
		// DetailedDescription: Store a thousand units of power to skip the night in one press. The whole server gets notified.
	}

	SolarPanelQuest: {
		// DisplayName: Facing the Sun
		// Description: Craft a Solar Panel
		// DetailedDescription: Generates by day and peaks at noon. Keep its sky clear; rain and eclipses are its days off.
	}

	CapacitorMatrixQuest: {
		// DisplayName: Grand Reservoir
		// Description: Craft a Capacitor Matrix
		// DetailedDescription: Forty thousand units in one bank. The grid's flywheel, and the end of the blackout era.
	}

	WeatherControllerQuest: {
		// DisplayName: Rainmaker
		// Description: Craft a Weather Controller
		// DetailedDescription: Five hundred power buys a rain, and once more clears it. The wind takes no orders.
	}

	WireInterfaceQuest: {
		// DisplayName: Wire Bridging
		// Description: Craft Wire Interfaces
		// DetailedDescription: The wire network and the power grid finally speak. Signals can toggle machines, and machines can send signals back.
	}

	SensorQuest: {
		// DisplayName: Electric Sentry Eye
		// Description: Craft a Multi-Mode Sensor
		// DetailedDescription: Charge levels, enemies and blood moons, nothing escapes its watch. The moment a condition holds, a wire signal goes out.
	}

	GridSwitchQuest: {
		// DisplayName: Grid Dispatch
		// Description: Craft a Grid Switch
		// DetailedDescription: A master switch built into the lines. Flip it open and the whole downstream grid falls silent at once.
	}

	ThermalPowerQuest: {
		DisplayName: Время сжигать
		Description: Создать тепловой электрогенератор
		DetailedDescription: Сжигайте топливо для получения большого количества энергии. Пусть это и не экологично, но на ранних этапах это самый надежный источник энергии.
	}

	AnnihilatingUniverseQuest: {
		DisplayName: Вселенское аннигилирование
		Description: Получить "Вселенское аннигилирование"
		DetailedDescription: Сила галактик, сжатая в тетиве лука. Это оружие обладает мощью, способной разрушать космические измерения, доказывая превосходство стрелка.
	}

	AriaofTheCosmosQuest: {
		DisplayName: Ария Космоса
		Description: Получить "Арию Космоса"
		DetailedDescription: Сыграйте симфонию звезд. Эта магическая книга призывает черные дыры и квазары, заставляя врагов исчезать под песнь вселенной.
	}

	NeutronBowQuest: {
		DisplayName: Нейтронный лук
		Description: Получить нейтронный лук
		DetailedDescription: Лук, выкованный из осколков ядра нейтронной звезды. Каждая стрела несет в себе гравитацию коллапсирующей звезды.
	}

	NeutronGlaiveQuest: {
		DisplayName: Нейтронная глефа
		Description: Получить нейтронную глефу
		DetailedDescription: Древковое оружие невероятной плотности. Чтобы владеть им, нужна огромная сила, но ни одна броня не выдержит его удара.
	}

	NeutronGunQuest: {
		DisplayName: Нейтронная пушка
		Description: Получить нейтронную пушку
		DetailedDescription: Оружие, стреляющее потоками микро-нейтронов. Из-за сверхвысокой плотности пули практически не испытывают сопротивления.
	}

	NeutronScytheQuest: {
		DisplayName: Нейтронная коса
		Description: Получить нейтронную косу
		DetailedDescription: Инструмент жатвы самой Смерти. Она легко разрывает пространство, скашивая жизни, словно пшеницу.
	}

	NeutronStarIngotQuest: {
		DisplayName: Нейтронный слиток
		Description: Получить нейтронный слиток
		DetailedDescription: Одно из самых плотных веществ во вселенной. Этот металл невообразимо тяжел и гудит от гравитационных колебаний.
	}

	NeutronWandQuest: {
		DisplayName: Нейтронный жезл
		Description: Получить нейтронный жезл
		DetailedDescription: Посох, управляющий гравитацией. Используйте силу нейтронной звезды, чтобы искажать пространство-время и сокрушать врагов.
	}

	PandemoniumQuest: {
		DisplayName: Пандемониум
		Description: Получить "Пандемониум"
		DetailedDescription: Абсолютное оружие, впитавшее бесчисленные души и силу бедствия. Держа его, вы держите ключи от Ада и Бездны.
	}

	RockQuest: {
		DisplayName: Древний вечный камень
		Description: Получить Древний вечный камень
		DetailedDescription: С виду обычный камень, но он был свидетелем бесчисленных циклов конца света. Это символ вечной стойкости.
	}

	TerminusQuest: {
		DisplayName: Терминус
		Description: Получить Терминус
		DetailedDescription: Ключ к финальному испытанию. Взгляните в этот камень и приготовьтесь к серии судов от сильнейших существ этого мира.
	}

	SpearOfLonginusQuest: {
		DisplayName: Копье Лонгина
		Description: Получить Копье Лонгина
		DetailedDescription: Легендарное святое копье, пронзившее бога, обладающее властью пробивать любые силовые поля и абсолютные барьеры. Когда его метают, даже закон причинности уступает ему дорогу.
	}

	DragonsWordQuest: {
		DisplayName: Слово дракона
		Description: Получить Слово дракона
		DetailedDescription: Дракон плачет лишь раз в жизни — в момент своей смерти.
	}

	RockQuestII: {
		DisplayName: Цикл войны
		Description: Пройти финальную битву (Терминус) 5 раз и получить более 5 древних вечных камней
		DetailedDescription: Символ истинного воина.
	}

	AdventurerQuests: {
		DisplayName: Искатель приключений
		Description: Мир у моих ног!
		QuestObjective.Description: Нажмите, чтобы получить
		DetailedDescription: Путешествие в тысячу миль начинается с первого шага. Наденьте эти сапоги и отправляйтесь измерять этот огромный мир.
	}

	ExploreDungeon: {
		DisplayName: Жуткая темница
		Description: Найти вход в Темницу
		QuestObjective.Description: Дойти до Темницы
		DetailedDescription: За проклятыми стенами скрыты бесконечные тайны и опасности. Лишь самые храбрые исследователи осмеливаются ступить на эту землю мертвых.
	}

	ExploreHell: {
		DisplayName: Адская бездна
		Description: Спуститься в Ад
		QuestObjective.Description: Дойти до Ада
		DetailedDescription: В самой глубине мира текут реки лавы. Это дом демонов, а также месторождение обсидиана и адского камня. Смотрите под ноги, не упадите.
	}

	ExploreJungle: {
		DisplayName: Экспедиция в джунгли
		Description: Углубиться в биом джунглей
		QuestObjective.Description: Дойти до джунглей
		DetailedDescription: Полный жизни, но смертельно опасный зеленый лабиринт. Густая растительность скрывает древние храмы и смертоносные рои пчел.
	}

	ExploreOcean: {
		DisplayName: Край света
		Description: Дойти до биома океана
		QuestObjective.Description: Дойти до океана
		DetailedDescription: Край континента. Здесь небо встречается с морем. Под глубокой синевой скрываются затонувшие корабли и неизвестные морские чудовища.
	}

	ExploreSnow: {
		DisplayName: Ледяные земли
		Description: Исследовать снежный биом
		QuestObjective.Description: Дойти до снегов
		DetailedDescription: Вечная мерзлота. Пронизывающий ветер и лед, покрывающий всё вокруг. Здесь жизнь существует в своей самой стойкой форме.
	}

	ExploreSpace: {
		DisplayName: Море звезд
		Description: Полететь в космос
		QuestObjective.Description: Дойти до космоса
		DetailedDescription: Избавьтесь от оков гравитации и прикоснитесь к звездам. Только взлетев достаточно высоко, можно увидеть этот мир целиком.
	}

	HellLabSchematic: {
		DisplayName: Чертеж Ада
		Description: Найти зашифрованный чертеж в лаборатории Дрэйдона в Аду
		QuestObjective.Description: Получить чертеж Ада
		DetailedDescription: Дрэйдон основал аванпост в Аду, используя местное геотермальное тепло для экспериментов. Найдите там чертежи, возможно, они откроют доступ к новому оружию.
	}

	IceLabSchematic: {
		DisplayName: Полярный шифр
		Description: Найти зашифрованный чертеж в лаборатории Дрэйдона в снегах
		QuestObjective.Description: Получить ледяной чертеж
		DetailedDescription: Низкие температуры — идеальная среда для сохранения точных приборов. Проникните в лабораторию подо льдами и найдите законсервированные полярные технологии.
	}

	JungleLabSchematic: {
		DisplayName: Проект джунглей
		Description: Найти зашифрованный чертеж в лаборатории Дрэйдона в джунглях
		QuestObjective.Description: Получить чертеж джунглей
		DetailedDescription: Густые джунгли скрывают биолабораторию Дрэйдона. Там он изучал чуму и нановирусы. Найдите этот чертеж, чтобы раскрыть опасную правду.
	}

	PlanetoidLabSchematic: {
		DisplayName: Загадка звездного потока
		Description: Найти зашифрованный чертеж в лаборатории Дрэйдона на планетоиде
		QuestObjective.Description: Получить чертеж планетоида
		DetailedDescription: В условиях микрогравитации высоко в небе дрейфует лаборатория Дрэйдона. Отправляйтесь туда, чтобы найти ранние чертежи Экзо-механизмов.
	}

	SunkenSeaLabSchematic: {
		DisplayName: Затерянное море
		Description: Найти зашифрованный чертеж в лаборатории Дрэйдона в Затерянном море
		QuestObjective.Description: Получить чертеж Затерянного моря
		DetailedDescription: В этом безмятежном подземном море Дрэйдон оставил исследования призматической энергии. Нырните под воду и заберите эти ценные данные.
	}

	AquaticScourgeQuest: {
		DisplayName: Акватический бич
		Description: Победить Акватического бича
		DetailedDescription: Некогда мирный гигант чистых вод, теперь искаженный токсинами Сернистого моря. В этих загрязненных кислотных водах остерегайтесь его внезапных рывков и ядовитых облаков.
	}

	QueenSlimeQuest: {
		DisplayName: Королева слизней
		Description: Победить Королеву слизней
		DetailedDescription: Кристальная императрица Святых земель, управляющая всеми святыми гелевыми существами. Она гораздо быстрее и смертоноснее своего супруга. Приготовьтесь к великолепному шквалу снарядов.
	}

	BuildHouse: {
		DisplayName: Мастер-строитель
		Description: Построить подходящий дом
		QuestObjective.Description: Построить валидный дом
		DetailedDescription: Каждому нужно убежище. Будь то Гид или другие странники, если вы предоставите комнату со столом, стулом, светом и стенами, они будут служить вам.
	}

	CollectEvilOres: {
		DisplayName: Залежи зла
		Description: Собрать руду злого биома
		QuestObjective.Description: Собрать демонитовую или кримтановую руду
		DetailedDescription: Эта руда источает зловещую ауру, она холодная и липкая на ощупь. Хоть она и происходит из очага болезни этого мира, это незаменимый материал для создания мощного снаряжения.
	}

	CollectFallenStars: {
		DisplayName: Собиратель звезд
		Description: Собрать упавшие звезды
		QuestObjective.Description: Собрать упавшие звезды
		DetailedDescription: Слезы ночного неба, падающие лишь с наступлением темноты. Соберите их, чтобы не только увеличить запас маны, но и использовать как мощные боеприпасы или материал для магии.
	}

	CollectGems: {
		DisplayName: Коллекционер драгоценностей
		Description: Собрать различные драгоценные камни
		QuestObjective.Description: Собрать 5 видов разных камней
		DetailedDescription: Сияющие кристаллы, скрытые в толще породы. Помимо украшений, они важны для создания посохов и крюков-кошек. Собрав камни разных цветов, вы, возможно, сможете воссоздать сияние радуги.
	}

	CollectHerbs: {
		DisplayName: Ученик травника
		Description: Собрать различные травы
		QuestObjective.Description: Собрать 3 вида разных трав
		DetailedDescription: Основа алхимии. Разные растения растут в разных условиях: в пустыне, снегах и даже в Аду. Умение различать их — первый шаг к тому, чтобы стать мастером алхимии.
	}

	CollectOres: {
		DisplayName: Сбор руды
		Description: Собрать базовую руду

		QuestObjective: {
			Description: {
				Iron: Собрать железную или свинцовую руду
				Copper: Собрать медную или оловянную руду
			}
		}

		DetailedDescription: Раскопки — основа выживания. Медь и железо хоть и обычны, но они — фундамент вашего выхода из первобытной жизни. Не пренебрегайте ими, ведь даже легендарные герои начинали с взмахов медной киркой.
	}

	DeepExplorer: {
		DisplayName: Исследователь бездны
		Description: Исследовать все основные биомы
		QuestObjective.Description: Завершить все задания по исследованию
		DetailedDescription: Вы обошли каждый уголок мира, от самых высоких облаков до глубочайшего ада. Составленная вами карта доказывает вашу храбрость. Теперь весь мир у ваших ног.
	}

	ExploreCaverns: {
		DisplayName: Глубины пещер
		Description: Исследовать глубокие слои пещер
		QuestObjective.Description: Дойти до слоя пещер
		DetailedDescription: Здесь нет солнца, только тьма и неизвестные существа. Появляется лава, а залежи руды становятся богаче. Смотрите под ноги, бездна смотрит на вас.
	}

	ExploreCorruption: {
		DisplayName: Земли Порчи
		Description: Исследовать Порчу или Багрянец
		QuestObjective.Description: Войти в Порчу или Багрянец
		DetailedDescription: Эта земля больна. Фиолетовая гниль или красная плоть пожирают землю. Хоть здесь и полно кровожадных монстров, только проникнув в логово зверя, можно добыть теневую чешую или образцы ткани.
	}

	ExploreDesert: {
		DisplayName: Жгучая пустыня
		Description: Ступить в биом пустыни
		QuestObjective.Description: Дойти до пустыни
		DetailedDescription: Палящее солнце выжигает землю, а под золотыми песками скрыты древние окаменелости и свирепые муравьиные львы. Запаситесь водой, здешняя сухость может стоить вам жизни.
	}

	ExploreFloatingIsland: {
		DisplayName: Парящие острова
		Description: Найти парящий остров в небе
		QuestObjective.Description: Дойти до парящего острова
		DetailedDescription: Легенды гласят, что над облаками хранятся сокровища древней цивилизации. Ищите гравитационные аномалии или стройте башню до небес, чтобы узнать правду.
	}

	ExploreGlowingMushroom: {
		DisplayName: Светящиеся грибы
		Description: Найти биом светящихся грибов
		QuestObjective.Description: Дойти до грибного биома
		DetailedDescription: Подземная экосистема, полная психоделических красок. Гигантские грибы излучают призрачный синий свет, разгоняя тьму. Это дом Трюфеля и диковинных насекомых.
	}

	ExploreUnderground: {
		DisplayName: Подземная экспедиция
		Description: Углубиться в подземелье
		QuestObjective.Description: Дойти до подземелья
		DetailedDescription: Просто копать грязь на поверхности недостаточно. Настоящие приключения начинаются под землей. Берите факелы, первый слой камня — это только начало.
	}

	FindLifeCrystal: {
		DisplayName: Источник жизни
		Description: Найти кристалл жизни
		QuestObjective.Description: Найти кристалл жизни
		DetailedDescription: Этот красный кристалл наполнен жизненной силой. Разбейте и используйте его, чтобы навсегда укрепить свое тело. Это ключ к выживанию в битвах с сильными врагами.
	}

	FindShadowOrb: {
		DisplayName: Ядро зла
		Description: Найти теневую сферу или багряное сердце в глубинах зла
		QuestObjective.Description: Уничтожить теневую сферу или сердце
		DetailedDescription: В глубинах злых разломов пульсируют гнилые сердца или теневые сферы. Разбив их, вы получите оружие, но будьте осторожны... если разобьете три, то пробудите нечто ужасное.
	}

	FirstPotion: {
		DisplayName: Основы алхимии
		Description: Создать свое первое зелье
		QuestObjective.Description: Создать любое зелье
		DetailedDescription: Поставьте пустую банку на стол, и у вас получится простая алхимическая станция. Сложные заклинания не нужны, только правильное смешивание ингредиентов. Выпейте и почувствуйте силу магии.
	}

	NPCVillage: {
		DisplayName: Процветающая деревня
		Description: Привлечь несколько поселенцев
		QuestObjective.Description: Иметь 5 поселенцев
		DetailedDescription: Выживать в дикой природе в одиночку тяжело. Когда вы станете сильнее и богаче, к вам потянутся люди. Создайте процветающее сообщество, и они станут вашей опорой.
	}

	QueenBeeQuest: {
		DisplayName: Королева пчел
		Description: Победить Королеву пчел
		DetailedDescription: В глубине подземных джунглей, в огромном улье, уничтожение личинки разгневает правительницу всего роя. Приготовьте противоядия и остерегайтесь её жал и скоростных рывков.
	}

	CollectorQuest: {
		DisplayName: Помощник-сборщик
		Description: Получить Сборщика
		DetailedDescription: Устали наклоняться за каждым трофеем? Это устройство автоматически собирает предметы вокруг. Это ключевой компонент для создания автоматизированной логистики и систем сортировки, полностью освобождающий ваши руки.
	}

	LumberjackQuest: {
		DisplayName: Время рубить
		Description: Получить Дровосека
		DetailedDescription: Древесина — основа промышленности и строительства. Забудьте о примитивных топорах, эта машина использует электричество для автоматического управления вашей лесофермой, обеспечивая непрерывный поток древесины.
	}

	LifeWeaverQuest: {
		DisplayName: Озеленение
		Description: Получить Сажатель деревьев
		DetailedDescription: Восстановление лесов обычно идет медленно. Эта машина использует электричество для точной посадки саженцев, быстро возвращая жизнь на пустынные земли. Это последний элемент пазла для создания полностью автоматической цикличной лесофермы.
	}

	IncineratorQuest: {
		DisplayName: Электрическая плавильня
		Description: Создать электрический инсинератор
		DetailedDescription: Традиционные печи неэффективны и тратят впустую много минеральной эссенции. Эта машина использует экстремальные температуры высоковольтной дуги для полного расщепления руды, извлекая вдвое больше продукта, чем раньше. Это решающий шаг к индустриализации.
	}

	ItemPipelineQuest: {
		DisplayName: Логистическая система
		Description: Создать логистическую трубу
		DetailedDescription: Всё еще бегаете между сундуками как дикарь? Эти трубы — вены промышленности. Соедините ими машины и контейнеры, и наблюдайте, как предметы сами текут туда, куда нужно. Постройте автоматизированную сборочную линию.
	}

	ThrowerQuest: {
		DisplayName: Выбрасыватель
		Description: Создать выбрасыватель
		DetailedDescription: Не все предметы стоит хранить. Это устройство выводит предметы из логистической сети, выбрасывая их в мир. Будь то для специфического автокрафта (например, сброс предметов в жидкость) или просто как мусоропровод — оно отлично справится.
	}

	DeerclopsQuest: {
		// DisplayName: Deerclops
		// Description: Defeat Deerclops
		// DetailedDescription: Deep in the blizzard stands a one-eyed giant deer. It does not come looking for you; you insist on looking for it.
	}

	DukeFishronQuest: {
		// DisplayName: Duke Fishron
		// Description: Defeat Duke Fishron
		// DetailedDescription: Bait your hook with a truffle worm and a duke will bite. Pig, dragon, fish; three kinds of menace on a single face.
	}

	EmpressOfLightQuest: {
		// DisplayName: Empress of Light
		// Description: Defeat the Empress of Light
		// DetailedDescription: Step on a prismatic lacewing in the Hallow and the furious empress will come to settle the score herself. Anger her in daylight and every one of her attacks kills in one hit.
	}

	ZenithQuest: {
		// DisplayName: Zenith
		// Description: Forge the Zenith
		// DetailedDescription: From the copper shortsword to the Starwrath, every blade you ever swung remembers you. Melt them together, and this journey takes its final shape.
	}

	BloodMoonQuest: {
		// DisplayName: Night of Blood
		// Description: Live through a Blood Moon
		// QuestObjective.Description: Experience a Blood Moon
		// DetailedDescription: On nights when the moon turns red, monsters stop knocking; they open the door themselves. Survive until dawn.
	}

	TorchGodQuest: {
		// DisplayName: The Torch God
		// Description: Pass the Torch God's trial
		// QuestObjective.Description: Earn the Torch God's Favor
		// DetailedDescription: Plant a hundred torches underground and the master of flame will test you in person. Its favor hides within the extinguished lights.
	}

	GoblinArmyQuest: {
		// DisplayName: Goblin Invasion
		// Description: Repel the Goblin Army
		// QuestObjective.Description: Repel the Goblin Army
		// DetailedDescription: Smashing Shadow Orbs draws them in, and so does a growing settlement. Short, swarming, endless; but win, and you may pick up a captive who repairs gear.
	}

	OldOnesArmyQuest: {
		// DisplayName: Old One's Army
		// Description: Guard the Eternia Crystal and repel all three tiers of the Old One's Army

		QuestObjective: {
			Description: {
				// T1: Repel the Old One's Army Tier 1
				// T2: Repel the Old One's Army Tier 2
				// T3: Repel the Old One's Army Tier 3
			}
		}

		// DetailedDescription: The Tavernkeep brings a plea from another world. Set the crystal, hold the portals, and let nothing touch it. Three tiers, each meaner than the last.
	}

	PirateInvasionQuest: {
		// DisplayName: Pirate Invasion
		// Description: Repel the Pirate Invasion
		// QuestObjective.Description: Repel the Pirate Invasion
		// DetailedDescription: Once the world hardens, sails appear on the horizon. They come for your money; take theirs back, captain's belongings included.
	}

	SolarEclipseQuest: {
		// DisplayName: Eclipse Hunt
		// Description: Slay a Mothron during a Solar Eclipse
		// QuestObjective.Description: Slay a Mothron
		// DetailedDescription: On days the moon blots out the sun, daytime is deadlier than night. Everything from the horror films takes to the streets, and the fastest flier among them is called Mothron.
	}

	MartianMadnessQuest: {
		// DisplayName: Martian Madness
		// Description: Repel the Martian invasion
		// QuestObjective.Description: Repel the Martian invasion
		// DetailedDescription: Do not stare at the probe in the sky; it flies home and brings friends. Saucers, death rays, mind-control helmets; the full alien invasion package.
	}

	PumpkinMoonQuest: {
		// DisplayName: Pumpkin Moon
		// Description: Defeat Pumpking during the Pumpkin Moon
		// QuestObjective.Description: Defeat Pumpking
		// DetailedDescription: Wake Halloween night with a Pumpkin Moon Medallion. Scarecrows line up to collect heads, and the closer is a king carrying twin scythes.
	}

	FrostMoonQuest: {
		// DisplayName: Frost Moon
		// Description: Defeat the Ice Queen during the Frost Moon
		// QuestObjective.Description: Defeat the Ice Queen
		// DetailedDescription: Open the present that should have stayed wrapped and Christmas Eve goes sour. Tanks patrol the snow while the queen dives through the blizzard.
	}

	FishermanQuest: {
		// DisplayName: Angler's Errands
		// Description: Complete five Angler quests
		// QuestObjective.Description: Complete Angler quests
		// DetailedDescription: A bossy little brat lives by the sea, but his rewards are surprisingly solid. Where the fish are, the treasure is.
	}

	LifeMaxQuest: {
		// DisplayName: Fountain of Life
		// Description: Raise your max life to 400
		// QuestObjective.Description: Reach 400 max life
		// DetailedDescription: Heart crystals only carry you halfway. The rest of the road is fought and grown through. Four hundred life is the ticket to standing firm in Hardmode.
	}

	ManaMaxQuest: {
		// DisplayName: Heart of Mana
		// Description: Raise your max mana to 200
		// QuestObjective.Description: Reach 200 max mana
		// DetailedDescription: Press fallen stars into crystals and feed them to yourself one by one. Twenty points a sip, nine sips in all, and the night sky runs in your veins.
	}

	WingsQuest: {
		// DisplayName: Spread Your Wings
		// Description: Equip any pair of wings
		// QuestObjective.Description: Equip wings
		// DetailedDescription: Sky vaults, fairy feathers, demon membranes. Whatever the source, the moment wings sprout from your back, fall damage becomes history.
	}

	MoneyQuest: {
		// DisplayName: First Fortune
		// Description: Hold a Platinum Coin
		// QuestObjective.Description: Hold a Platinum Coin
		// DetailedDescription: A hundred gold coins pressed into one platinum. You probably died plenty of times earning it; merchants call that a handling fee.
	}

	ExploreAetherQuest: {
		// DisplayName: The Shimmering Lake
		// Description: Find the Aether
		// QuestObjective.Description: Reach the Shimmer
		// DetailedDescription: Tucked in a corner of the world is a lake that does not belong here. Drop something in and it comes back changed. Do not jump in to test it yourself.
	}

	HardmodeOresQuest: {
		// DisplayName: Three New Metals
		// Description: Gather the three tiers of Hardmode ore

		QuestObjective: {
			Description: {
				// T1: Collect Cobalt or Palladium Ore
				// T2: Collect Mythril or Orichalcum Ore
				// T3: Collect Adamantite or Titanium Ore
			}
		}

		// DetailedDescription: After the Wall of Flesh falls, smash the altars with a holy hammer and three new metals grow in the deep. Each is harder than everything that came before.
	}

	ChlorophyteQuest: {
		// DisplayName: Power of Chlorophyte
		// Description: Collect 30 Chlorophyte Ore
		// DetailedDescription: With the machines destroyed, a glowing green metal starts growing in the deep jungle mud. It has a will of its own, and it spreads on its own too.
	}

	CalamityLoreHub: {
		// DisplayName: Anomaly Survey
		// Description: Something is wrong with this world
		// QuestObjective.Description: Click to claim
		// DetailedDescription: The sea is acid, the crags are burning, and things no field guide knows grow in the crater a star left behind. Write it all down; this world's dark side is bigger than you think.
	}

	ExploreSulphurSea: {
		// DisplayName: Sulphurous Sea
		// Description: Explore the Sulphurous Sea
		// QuestObjective.Description: Reach the Sulphurous Sea
		// DetailedDescription: One side of the world has no blue ocean, only yellowed acid water. Rain fizzes where it lands and the fish come up venomous. Cover your mouth, and do not drink.
	}

	ExploreAbyss: {
		// DisplayName: Mouth of the Abyss
		// Description: Dive into the Abyss beneath the Sulphurous Sea
		// QuestObjective.Description: Enter the Abyss
		// DetailedDescription: A downward rift splits the floor of the sulphurous sea. Light cannot follow, neither can breath, and the deeper you go, the older the things that live there.
	}

	AbyssDeepQuest: {
		// DisplayName: Bottom of the Abyss
		// Description: Bring back Lumenyl and Voidstone from the Abyss
		// DetailedDescription: Where mining lamps cannot reach, blue-glowing crystal grows along the rock walls. Dig it out and surface alive; only then have you truly been to the Abyss.
	}

	ExploreSunkenSea: {
		// DisplayName: Sunken Sea
		// Description: Find the Sunken Sea deep beneath the desert
		// QuestObjective.Description: Reach the Sunken Sea
		// DetailedDescription: Beneath the desert hides a quiet stretch of blue. Prisms glow in the water and the clams are bigger than your house. This may be the gentlest corner of the world.
	}

	ExploreBrimstoneCrag: {
		// DisplayName: Brimstone Crags
		// Description: Set foot in the Brimstone Crags at the edge of the Underworld
		// QuestObjective.Description: Reach the Brimstone Crags
		// DetailedDescription: On one side of Hell stands a cliff that has burned longer than anyone remembers. Dark red fire seeps from the brickwork, and an elemental spirit sleeps in the ruins.
	}

	ExploreAstral: {
		// DisplayName: Astral Blight
		// Description: Explore the star-tainted land
		// QuestObjective.Description: Reach the Astral Infection
		// DetailedDescription: A star crashed into the world, and what grows in the crater belongs to no bestiary. The land is changing color, the creatures are changing shape, and this is only the beginning.
	}

	AcidRainQuest: {
		// DisplayName: Acid Rain
		// Description: Weather an acid rain
		// QuestObjective.Description: Experience the Acid Rain event
		// DetailedDescription: The clouds over the sulphurous sea are yellow. When it rains the whole sea boils, and the things in the water climb ashore with it. Bring an umbrella. Seriously.
	}

	DeliciousMeatQuest: {
		// DisplayName: Delicious Meat
		// Description: Obtain a piece of Delicious Meat
		// DetailedDescription: Nobody knows what animal it came from, and nobody cares. Tasty, filling, doubles as a building block. Stock up.
	}

	BrimlishQuest: {
		// DisplayName: Brimlish
		// Description: Fish up a Brimlish
		// DetailedDescription: Even the acid water has fish in it, and they look surprisingly lively. Cast your line into the sulphurous sea and see what bites.
	}

	GiantClamQuest: {
		// DisplayName: Giant Clam
		// Description: Defeat the Giant Clam
		// DetailedDescription: The largest shell in the Sunken Sea. Quiet as a rock most days; everyone who pried it open regretted it.
	}

	CragmawMireQuest: {
		// DisplayName: Cragmaw Mire
		// Description: Defeat the Cragmaw Mire during the Acid Rain
		// DetailedDescription: Once the world hardens, something bitey floats up through the acid rain. It has far too many teeth, and all of them point at you.
	}

	MaulerQuest: {
		// DisplayName: The Mauler
		// Description: Defeat the Mauler during the Acid Rain
		// DetailedDescription: A shark raised on acid, with a temper to match the pH. By the time it breaches, remembering to dodge is already too late.
	}

	NuclearTerrorQuest: {
		// DisplayName: Nuclear Terror
		// Description: Defeat the Nuclear Terror during the Acid Rain
		// DetailedDescription: At the deepest hour of the acid rain, something enormous and glowing hatches. Even the acid water pulls back from where it walks.
	}

	GreatSandSharkQuest: {
		// DisplayName: Great Sand Shark
		// Description: Defeat the Great Sand Shark
		// DetailedDescription: The fastest hunter in the desert; the dunes are its open sea. Cull enough of its kin and the king of the pack will show up in person.
	}

	LeviathanQuest: {
		// DisplayName: Anahita and the Leviathan
		// Description: Defeat Anahita and the Leviathan
		// DetailedDescription: The song comes first, the great shadow after. The siren's melody guides the deep-sea beast; do not stop to listen.
	}

	AstrumAureusQuest: {
		// DisplayName: Astrum Aureus
		// Description: Defeat Astrum Aureus
		// DetailedDescription: Deep in the astral blight crouches an infected war machine. It wakes at night, and nothing grows where its treads have passed.
	}

	RavagerQuest: {
		// DisplayName: Ravager
		// Description: Defeat the Ravager
		// DetailedDescription: A giant pieced together from flesh and masonry, every limb attacking on its own. Tear off all four before the body itself gets serious.
	}

	AstrumDeusQuest: {
		// DisplayName: Astrum Deus
		// Description: Defeat Astrum Deus
		// DetailedDescription: Lay an offering on the astral beacon and an infected god swims down out of the night sky. Only its death opens the astral ore to your pickaxe.
	}

	BossRushQuest: {
		// DisplayName: The Final Battle
		// Description: Clear a Boss Rush
		// QuestObjective.Description: Complete the Boss Rush
		// DetailedDescription: Crush the Terminus and everything you have ever slain lines up to find you again. Kill them all a second time to put the seal on this journey.
	}

	AerialiteQuest: {
		// DisplayName: Aerialite Gleam
		// Description: Forge Aerialite Bars
		// DetailedDescription: When the Desert Scourge dies, pale blue ore-dust settles from the sky. Light enough to float, yet sturdier than iron.
	}

	CryonicQuest: {
		// DisplayName: Cryonic Crystal
		// Description: Forge Cryonic Bars
		// DetailedDescription: With Cryogen shattered, blue veins crystallize in the deep ice of the tundra. It does not melt in your hand; it only gets colder.
	}

	PerennialQuest: {
		// DisplayName: Perennial Gift
		// Description: Forge Perennial Bars
		// DetailedDescription: Where Plantera wilted, a breathing green metal grows from the soil. The jungle repays its debts in its own way.
	}

	LifeAlloyQuest: {
		// DisplayName: Life Alloy
		// Description: Smelt Life Alloys
		// DetailedDescription: Three living metals melted into one; the ingot still carries a pulse. Every high-end frame is built on it.
	}

	AstralBarQuest: {
		// DisplayName: Astral Smelting
		// Description: Forge Astral Bars
		// DetailedDescription: With the god-worm dead, the astral veins finally yield to the pickaxe. The bars glow on their own in the dark.
	}

	UelibloomQuest: {
		// DisplayName: Uelibloom in Blossom
		// Description: Forge Uelibloom Bars
		// DetailedDescription: After the goddess's holy fire swept through, metal flowers bloomed in the jungle mud. Smelt the petals into bars; the light stays inside.
	}

	BloodstoneQuest: {
		// DisplayName: Bloodstone Tempering
		// Description: Gather Bloodstone Cores
		// DetailedDescription: With the goddess fallen, dark red stones float up through the lava of the Brimstone Crags. They are still beating, like hearts outside their bodies.
	}

	AscendantEssenceQuest: {
		// DisplayName: Ascendant Spirit
		// Description: Condense Ascendant Spirit Essence
		// DetailedDescription: Phantoms, stardust, moonlight, and a stubborn will that refuses to scatter. Press them into one essence; it is enough to light a legend.
	}

	YharonSoulQuest: {
		// DisplayName: Embers of the Dragon Soul
		// Description: Collect Yharon Soul Fragments
		// DetailedDescription: When the great dragon burned out, what remained in the flames was not ash but shards of soul, still hot. Mind your heart when you pick them up.
	}

	FruitQuest: {
		// DisplayName: Gifts of Life
		// Description: Gather all four life-enhancing fruits
		// DetailedDescription: Strange fruit sometimes ripens beside the corpses of mighty foes. Four kinds in all, and every one pushes your life to a new limit.
	}

	DraedonPowerCellQuest: {
		// DisplayName: Ancient Power
		// Description: Collect Power Cells
		// DetailedDescription: The lab ruins are littered with cells that still hold a charge. An energy density far beyond your generators; worth studying.
	}

	DraedonsForgeQuest: {
		// DisplayName: The Master's Forge
		// Description: Obtain the master craftsman's forge
		// DetailedDescription: At the end of industry stands a furnace that can smelt anything. Assemble it, and your workshop will never again meet something it cannot make.
	}

	ConquerorMilestone: {
		// DisplayName: Chronicle of Conquest
		// Description: Defeat every mighty foe of this world
		// QuestObjective.Description: Complete all hunt quests
		// DetailedDescription: From King Slime to the things at the world's end, finish every hard fight there is. Few ever fill this page.
	}

	EventMilestone: {
		// DisplayName: Peacekeeper
		// Description: Quell every invasion and anomaly
		// QuestObjective.Description: Complete all event quests
		// DetailedDescription: Armies, fleets, moons from other worlds. Whatever came in numbers, you sent home.
	}

	CompletionistMilestone: {
		// DisplayName: The Complete Codex
		// Description: Finish everything in this book
		// QuestObjective.Description: Complete all quests
		// DetailedDescription: The last page of this book is reserved for whoever reads it all. By the time you close it, this world holds nothing you have not seen.
	}
}
