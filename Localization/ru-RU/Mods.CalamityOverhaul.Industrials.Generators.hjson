ThermalGenerator: {
	DisplayName: Тепловой генератор
	Tooltip:
		'''
		Добавьте топливо для генерации энергии.
		ПКМ по блоку — быстрая загрузка топлива, Shift + ПКМ — извлечение.
		'''
}

MagmaThermalGenerator: {
	DisplayName: Магмовый теплогенератор
	Tooltip:
		'''
		Корпус у лавы даёт ток медленно; при запасе лавы в баке — на полную
		Лаву можно подать жидкостной трубой или влить ведром по ПКМ
		Первый основной источник для завода в Аду
		'''
}

WindGrivenGenerator: {
	DisplayName: Ветроэлектрическая установка
	Tooltip: Двигаться по ветру, производить электрическую энергию
	UnderstandWindGriven: Поверхностно изучён принцип работы
	UnderstandWindGriven2: Вам нужно разобрать старый ветрогенератор на планетоиде, чтобы понять принципы его работы
}

WindGrivenGeneratorMK2: {
	DisplayName: Ветроэлектрическая установка второго поколения
	Tooltip: Двигаться по ветру, производить электрическую энергию
	UnderstandWindGrivenMK2: Глубоко изучён принцип работы
	UnderstandWindGrivenMK2Remind: Вам нужно разобрать гигантский ветрогенератор на планетоиде, чтобы понять принципы его работы
}

ThermalGeneratorMK2: {
	DisplayName: Тепловой генератор MK2
	Tooltip:
		'''
		Добавьте топливо для генерации энергии.
		ПКМ по блоку — быстрая загрузка топлива, Shift + ПКМ — извлечение.
		'''
}

WGGMK2Wilderness: {
	DisplayName: Гигантский заросший ветрогенератор
	Tooltip: ""
}

WGGWilderness: {
	DisplayName: Заросший ветрогенератор
	Tooltip: ""
}

SolarPanel: {
	DisplayName: Солнечная панель
	Tooltip:
		'''
		Днём даёт ток; в полдень выход на пике
		В дождь КПД резко падает; во время солнечного затмения полностью встаёт
		Если над головой сплошной блок — не работает
		'''
}

SolarPanelMK2: {
	DisplayName: Солнечная панель MK2
	Tooltip:
		'''
		Днём даёт ток; в полдень выход на пике, КПД втрое выше первого поколения
		В дождь КПД резко падает; во время солнечного затмения полностью встаёт
		Если над головой сплошной блок — не работает
		'''
}

Hydroelectric: {
	DisplayName: Гидроэлектрогенератор
	Tooltip:
		'''
		Работает, находясь в воде.
		"Пример работы механики жидкостей"
		'''
}

HydroelectricMK2: {
	DisplayName: Гидроэлектрогенератор MK2
	Tooltip:
		'''
		Работает, находясь в воде.
		"Пример работы механики жидкостей"
		'''
}

BiomassGenerator: {
	DisplayName: Биогенератор
	Tooltip:
		'''
		Жжёт семена, травы, грибы, улов и прочий сельскохозяйственный отход и даёт ровный ток
		Мощность между ветром и теплом; с сельхозмашинами замыкает цикл «вырастил — сжёг»
		Биотопливо в руке + ПКМ — сразу в топку; ПКМ открывает панель
		'''
}
