CWRServerConfig: {
	DisplayName: Настройки контента

	WeaponOverhaul: {
		Label: Переработка оружия
		Tooltip:
			'''
			Включение изменит большинство оружия.
			[c/FF0000:Если вы хотите получить оптимальный опыт от Calamity Overhaul, включите эту опцию!]
			'''
	}

	ScreenVibration: {
		Label: Вибрация экрана при особых атаках оружия
		Tooltip:
			'''
			Если включено, при некоторых атаках экран начнет вибрировать,
			что, возможно, усилит ощущение удара
			'''
	}

	DomainConciseDisplay: {
		Label: Минималистичное отображение домена
		Tooltip: По умолчанию выключено. При включении скрывает большинство визуальных эффектов внутри домена.
	}

	Headers: {
		CWRSystem: Системные настройки Overhaul
		CWRWeapon: Настройки оружия Overhaul
		CWRWorldGen: Настройки генерации структур Overhaul
	}

	LensEasing: {
		Label: Сглаживание камеры
		Tooltip:
			'''
			При включении камера будет плавно следовать за быстрыми перемещениями на большие расстояния,
			уменьшая ощущение резкого скачка
			'''
	}

	BiologyOverhaul: {
		Label: Модификация биологического поведения [c/06e33f:(Экспериментальная)]
		Tooltip:
			'''
			[c/c20909:Незакончено]
			По умолчанию включено. Изменяет поведение ИИ некоторых существ, например ИИ боссов в режиме смерти.
			Это может значительно повысить сложность игры; при необходимости вы можете отключить эту опцию.
			'''
	}

	QuestLog: {
		Label: Руководство по заданиям
		Tooltip:
			'''
			Если включено, книга заданий будет направлять игрока по ходу игры
			Вы можете открыть интерфейс заданий с помощью предмета "Книга заданий", кнопки в инвентаре или горячей клавиши, чтобы просмотреть текущие задачи
			Включено по умолчанию. Если отключить, подсказок по заданиям не будет
			'''
	}

	DialogueBox_Scale_Value: {
		Label: Масштаб диалогового окна
		Tooltip: Регулирует общий размер диалогового окна
	}

	GenWindGrivenGenerator: {
		Label: Генерация ветрогенератора
		Tooltip: Размещает в мире структуры ветряных генераторов.
	}

	GenWGGCollector: {
		Label: Генерация построек мусорщиков
		Tooltip: Случайно создает враждебные постройки мусорщиков по всему миру. Этот параметр работает только в мирах сложности «Легенда».
	}

	GenJunkmanBase: {
		Label: Генерация базы мусорщиков
		Tooltip: Создает укрепленную базу мусорщиков в пустошах или под землей.
	}

	GenRocketHut: {
		Label: Генерация хижины ракетчика
		Tooltip: Создает таинственную постройку, содержащую детали ракет или технические реликвии.
	}

	GenSylvanOutpost: {
		Label: Генерация лесной заставы
		Tooltip: Создает деревянные посты эльфов или лесных стражей в глубине чащи.
	}

	GenSHPCCradle: {
		// Label: Generate SHPC Cradle Island
		// Tooltip: Generates a crashed vessel sky island above spawn with the SHPC sealed inside. When disabled, the weapon can only be found in Calamity's laboratory.
	}

	ConfigChangePrefix: Пользователь
	ConfigChangeSuffix: изменил(а) настройки сервера

	HackPvP: {
		// Label: Hack Pv P
		// Tooltip: ""
	}
}
