GodSmithExecutionEndow: {
	EndowName: Росчерк казни
	EndowDesc:
		'''
		Попадание по врагу ниже {0}% здоровья выпускает казнящий росчерк
		Росчерк наносит {1}% урона этого удара
		'''
}

GodSmithOverkillEndow: {
	EndowName: Цепь переизбытка
	EndowDesc:
		'''
		Убийство шлёт багровый разряд к ближайшему врагу
		Он несёт {0}% избыточного урона плюс {1}% этого удара
		'''
}

GodSmithCritMarkEndow: {
	EndowName: Метка крита
	EndowDesc:
		'''
		Попадания гравируют метку; на {0} слоях она взрывается
		Взрыв — гарантированный крит, база {1}% этого удара
		'''
}

GodSmithEchoSlashEndow: {
	EndowName: Эхо клинка
	EndowDesc:
		'''
		Попадание поднимает клинок-ветер и гонит его вокруг
		Остальным врагам — {0}% урона этого удара
		'''
}

GodSmithShockwaveEndow: {
	EndowName: Ударная волна
	EndowDesc:
		'''
		Каждые 1.5 с попадание бьёт ударной волной
		Отбрасывает ближних и наносит {0}% урона этого удара
		'''
}

GodSmithComboEndow: {
	EndowName: Всплеск комбо
	EndowDesc:
		'''
		Серия попаданий копит темп; {0}-й удар вспыхивает
		Область получает {1}% урона этого удара
		Пауза или смена оружия сбрасывает темп
		'''
}

GodSmithAfterimageEndow: {
	EndowName: Удар послеобразия
	EndowDesc:
		'''
		Каждое {0}-е применение шлёт послеобразие к прицелу
		Наносит {1}% урона оружия
		'''
}

GodSmithBallisticEndow: {
	EndowName: Пронзающий трассер
	EndowDesc:
		'''
		Каждый {0}-й выстрел добавляет трассер
		Пронзает врагов, нанося {1}% урона оружия
		'''
}

GodSmithRicochetEndow: {
	EndowName: Рикошет
	EndowDesc:
		'''
		Снаряд после попадания отскакивает искрой к другому врагу
		Наносит {0}% урона этого удара
		'''
}

GodSmithPhantomVolleyEndow: {
	EndowName: Призрачный залп
	EndowDesc:
		'''
		Каждый {0}-й выстрел вызывает {1} призрачных снарядов в залпе
		Каждый наносит {2}% урона оружия
		'''
}

GodSmithManaRefluxEndow: {
	EndowName: Возврат маны
	EndowDesc:
		'''
		Попадание с шансом {0}% срывает нить маны и гонит её к вам
		Поймайте — вернёте {1} маны
		'''
}

GodSmithOverloadEndow: {
	EndowName: Чародейская перегрузка
	EndowDesc:
		'''
		Пока маны больше {0}%, попадание взрывает фиолетовые дуги
		Добавляет {1}% урона этого удара
		'''
}

GodSmithMythicEchoEndow: {
	EndowName: Звёздный зов
	EndowDesc:
		'''
		Заклинание зовёт звёздного духа к боку
		Дух то и дело швыряет звёздные болты в ближних, по {0}% урона оружия
		'''
}

GodSmithDesperationEndow: {
	EndowName: Отчаянный взрыв
	EndowDesc:
		'''
		Изувеченное оружие в беде ревёт
		Попадание с шансом {0}% взрывается на {1}% урона этого удара по области
		Чем хуже префикс, тем яростнее взрыв
		'''
}

GodSmithHiddenEdgeEndow: {
	EndowName: Скрытое лезвие
	EndowDesc:
		'''
		Тупое оружие прячет настоящую кромку
		Каждое {0}-е применение вспыхивает белым резом на {1}% урона оружия
		Чем медленнее оружие, тем острее скрытая кромка
		'''
}

GodSmithLuckyStarEndow: {
	EndowName: Счастливая звезда
	EndowDesc:
		'''
		Крит роняет счастливую звезду на цель
		Наносит {0}% урона этого удара
		'''
}

GodSmithMenaceEndow: {
	EndowName: Убийственный умысел
	EndowDesc:
		'''
		Попадания копят умысел; {0}-й удар рвёт чёрно-алым когтем
		Наносит {1}% урона этого удара
		'''
}

GodSmithSwiftFootEndow: {
	EndowName: Порыв ветра
	EndowDesc:
		'''
		Пробегите около {0} клеток — порыв наполнен
		Следующее попадание выпускает пронзающий ветряной клинок на {1}% урона этого удара
		'''
}

GodSmithViolentSurgeEndow: {
	EndowName: Яростный всплеск
	EndowDesc:
		'''
		Ближние удары копят ярость; на {0} слоях вспыхивает багровое кольцо клинков
		Область получает {1}% урона этого удара
		'''
}

GodSmithArcaneWardEndow: {
	EndowName: Чародейская защита
	EndowDesc:
		'''
		При ударе мана ткёт рунную защиту
		Каждая 1 единица маны блокирует {0} урона, не больше {1}% этого удара
		'''
}
