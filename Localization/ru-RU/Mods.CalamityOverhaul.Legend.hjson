		// LockedUnknown: This mei answers to no bond
		// Settle: The blade's bond is sealed — the rubbing of "{0}" falls at your feet
	}

	// OniPlayerDismemberSystem.SelfHurtDeathReason: "{0} was severed by their own blade"

	OniTalismanHud: {
		// HudTitle: Sealing Talisman
		// HudHintFormat: "{0} toggles {1}; click the talisman to open it"
		// HudMeiName: the Inscription Stand
		// HudRegisterName: the Ghost Register
		// HudDangerLine: Revival nearly full; one more use and it wakes
		// HudWraithFormat: Bound {0} · Revival {1}%
		// VigorTitle: Vigor
		// VigorValueFormat: "{0} / {1}"
		// StanceTitle: Stance
		// StanceValueFormat: "{0} / {1}"
		// StanceReadyLine: Full Stance — {0} auto-locks for Finale; double-dash remains available
		// StanceHalfLine: Half Stance — double-tap {0}, then left-click for Annihilating Flash
		// DomainTitle: Eye of the Oni Domain
		// DomainStateClosed: Shut — no domain unfolded
		// DomainStateOmote: Omote — the yellowed-paper world
		// DomainStateUra: Ura — the ink-wash netherworld
		// DomainStateShifting: Mid-rite — do not disturb
		// DomainToggleHintFormat: "{0} or Left Click: unfold / fold the domain"
		// DomainFlipHintFormat: "{0} or Right Click: flip Omote/Ura (unfolds if shut)"
	}

	OnikiriTutorialLead: {
		// AskTitle: Take the Lesson First?
		// AskBody: Vigor and Stance, the Omote and Ura of the domain, the backlash of dismemberment. These three are hard to work out alone without hearing them once. You will only be asked this once
		// AskPrompt: Take the lesson now, or accept the Keiko Rune and open it yourself later
		// RefreshAskTitle: A Couple of New Pages
		// RefreshAskBody: This version adds two lessons: how to read the codex beside the Inscription Stand, and what to know about the Eye of the Oni Domain before you act. You have already done the practice, so it won't be repeated
		// RefreshAskPrompt: Take the additions now, or accept the Keiko Rune and open them later
		// AcceptBtn: Teach Me
		// DeclineBtn: Not Now
		// DeclineNotice: The Keiko Rune has been left with you; use it to open the lesson any time
		// HudTitle: Vigor & Stance
		// HudBody: While holding Onikiri, the lower-left HUD shows Vigor and Stance as read-only gauges. At half Stance, double-dash then left-click for Annihilating Flash; at full Stance, use Execute to auto-lock into Finale. In Omote, holding Sakura Flight turns you to petals on the spot
		// HudPrompt: Learn these readouts; the sealing talisman is the HUD's only panel control
		// RegisterTitle: Ghost Register
		// RegisterBody: The beam plaque "Ghost Register" and its hanging scroll on the left of the Inscription Stand open the ledger. Usable wraiths and archival fragments are separate; clicking only inspects, while the bind seal equips and release disables every wraith ability
		// RegisterPrompt: Click the highlighted plaque or scroll; inspect the register and wraith slot, then close it to continue
		// MeiTitle: Inscription Stand
		// MeiBody: The sealing talisman is the HUD's only panel control and opens the Inscription Stand by default. The blade takes an inscription at three places — tang, groove, and horimono — and each one carries a bestowal and a price. Click a slot to fan out the chisel ribs; the chisels already in your pack sit in the tray below
		// MeiPrompt: Press {0} or click the highlighted talisman to open the stand, then learn the three slots
		// CodexTitle: Mei Codex
		// CodexBody: A stitched booklet sits under the ledger board of the Inscription Stand — that is the codex. The left page lists every inscription by tang, groove, and horimono; the right page gives its bestowal, price, and where it comes from, while unearned ones show only affinity progress. Read-only; chiselling still happens on the stand
		// CodexPrompt: Click the highlighted booklet to read; closing it returns you to the stand
		// DomainTitle: Eye of the Oni Domain
		// DomainBody: That eye beside Vigor rules the domain — unfold Omote (yellowed paper), flip to Ura (ink-wash nether), then fold again. Dismemberment only works in Ura
		// DomainPrompt: Left-click the eye to unfold or fold; Right-click or {0} flips Omote/Ura
		// PrepareTitle: Prepare for Practice
		// PrepareBody: Close the Inscription Stand and Ghost Register, then hold Onikiri. If the domain is open, I will fold it through the normal command first; after an interruption, I will also restore the state needed for your next step
		// PreparePrompt: Keep Onikiri in hand and wait for the eye and panels to settle; if it stalls, hit Skip to go straight to practice
		// OpenDomainTitle: Unfold Omote
		// OpenDomainBody: Press the domain key (Q by default) to unfold the Oni Domain. From a shut eye, the first opening enters shallow Omote and covers the world in yellowed paper
		// OpenDomainPrompt: Press {0} yourself, then wait until the domain settles in Omote
		// FlipDomainTitle: Flip into Ura
		// FlipDomainBody: While in Omote, press the flip key (Mouse3, the middle mouse button, by default) to turn the shallow domain into deep Ura
		// FlipDomainPrompt: Press {0} to enter Ura, then wait for the ink to settle before drawing the blade
		// DismemberTitle: Dismemberment Practice
		// DismemberBody: Put the cursor over the highlighted Santa-NK1 body and make a fresh left-click. Onikiri will dismember the body directly; Omokage paper can also serve as a medium, but this lesson does not require it
		// DismemberPrompt: Aim at the tank body, release left-click, then press it once
		// BacklashTitle: Endure the Backlash
		// BacklashBody: Directly dismembering a body deals a real 25% of maximum life to the wielder and locks movement during the sheathing rite. Watch the full sequence; I will restore you afterward
		// BacklashPrompt: Stop input and wait for the backlash, sheathing, and recovery to finish
		// CloseDomainTitle: Fold the Domain from the Eye
		// CloseDomainBody: Finish by folding the domain yourself. Left-clicking the HUD eye is the shortest way; the domain key counts too, while right-clicking the eye flips Omote and Ura instead
		// CloseDomainPrompt: Left-click the highlighted HUD eye and wait until it shuts completely
		// DomainUnboundHint: No domain key is bound. For this lesson, press Q as the temporary default
		// FlipUnboundHint: No flip key is bound. For this lesson, press Mouse3 (middle mouse) as the temporary default
		// WaitingFeedback: Waiting for this step's result to settle
		// BusyFeedback: The domain is still shifting. Wait until it settles before trying again
		// RetryFeedback: That one didn't land. Follow the prompt and try again, or let me demonstrate
		// NeedBladeHold: You don't have Onikiri. Retrieve it before continuing
		// TargetStalledHint: The practice dummy hasn't arrived. It can't get a slot when the area is crowded — move somewhere open and wait
		// AssistBtn: Demonstrate
		// RetryBtn: Retry
		// NextBtn: Understood
		// OpenRegisterBtn: Open Register
		// OpenMeiBtn: Open Stand
		// OpenCodexBtn: Read Codex
		// SkipBtn: Skip
		// SkipStepBtn: Skip Step
		// AbortBtn: Dismiss
	}

	OniMeiCodexUI: {
		// TitleText: Mei Codex
		// CloseTagText: Close
		// CloseHintFormat: ESC · {0} · click outside to return
		// TabAll: All
		// TallyFormat: Found {0} / {1}
		// TallySlotFormat: "{0} {1}/{2}"
		// PageFormat: "{0} / {1}"
		// EmptyPage: No mei in this volume
		// LockedTitle: Uncarved
		// SectionAcquire: How to find
		// SectionProgress: Bond
		// SectionSource: Provenance
		// HiddenBody: Uncarved mei keep power and burden off this ledger. Carve first, then read
		// EngravedMark: On the blade
		// SourceFactory: Already on the blade when drawn from under the torii
		// SourceGiftFormat: After you cut down "{0}", Hiiro will bring the rubbing
		// SourceGiftUnknown: Hiiro will bring the rubbing on some night
		// SourceGiftJoin: " or "
		// SourceDeed: No one gifts this. Prove it with the blade yourself
		// SourceUnknown: Provenance unknown; the ledger is silent
		// ProgressSettled: Bond sealed
		// ProgressWaiting: Not yet
	}
}

OnikiriOverride: {
	// DisplayName: 鬼切
	/* Tooltip:
		'''
		Hold left-click to drive the five-beat Crimson Rend combo
		[DASH] spends Vigor on a normal Kamui Flash Step; at half Stance or above, press [DASH] again within one second for a free execution dash
		In Omote, hold [SAKURA] to scatter into Sakura Flight on the spot; release or run dry to reform; holding it through a dash chains into the flight too
		After a half-Stance execution dash, left-click for Annihilating Flash; at full Stance, double-dash through a target for Finale Slash
		At full Stance, press [EXECUTE] to auto-lock, dash, and automatically unleash Finale Slash; with no target, the dash follows the cursor
		An unfulfilled execution costs no additional Vigor
		[Lang4]
		legend_Text
		''' */
}

OnikiriTrialQuestLine: {
	// QuestCategory: Onikiri · Trial Cuts
	// TrackerWaiting: It isn't here yet. Wait, or we go ask for it
	// TrackerFighting: "{0}: {1:0%}"
	// TrackerBrief: Next cut: {0}
	// BossRushTargetName: Night That Won't Break
	// EventActiveFormat: "{0}: underway"
	// Trial_0: That Business in the Sky
	// Trial_1: Two Wrong Pulls in the Dirt
	// Trial_2: Clumped into One Blob
	// Trial_3: Heard It's a God
	// Trial_4: Whatever's Blocking the Road
	// Trial_5: That Brimstone Smell
	// Trial_6: Fire Pit Still Lit
	// Trial_7: The Big Name
	// Trial_8: Two Dots in a Pair
	// Trial_9: Old and New Mixed Up
	// Trial_10: Walks Too Much Like a Person
	// Trial_11: That One Down Below
	// Trial_12: The One in the Stone House
	// Trial_13: Mutterers at the Door
	// Trial_14: What's Pressing Up There
	// Trial_15: Heat from the Earth's Heart
	// Trial_16: A Clump in the Damp
	// Trial_17: Where It Feels Too Empty
	// Trial_18: Dragon Still Around
	// Trial_19: Where the Booming Hits the Ears
	// Trial_20: Where the Air Goes Heavy
	// Trial_21: Gathering Again
	/* TrialSummary_0:
		'''
		There's something going on up in the sky, and I can't say what
		Just feels like we're being watched, and the blade's getting restless too
		Go take a look, then come back and tell me what it even was
		Oh—and don't tip your head back too long. Neck'll ache
		''' */
	/* TrialSummary_1:
		'''
		Two wrong pulls from the dirt that way—I can't tell them apart
		Whichever sticks its head out first, cut that one. Don't stare at both
		The blade will know the taste is off. You go first
		''' */
	/* TrialSummary_2:
		'''
		Filth bunched into one blob over there—even the wind of it is annoying
		Don't stand around staring. Go deal with it
		Getting it done matters more than anything else when you're back
		''' */
	/* TrialSummary_3:
		'''
		Heard some puddle calls itself a god. Almost made me laugh
		If names were that easy, who'd bother working
		Go check. If it really calls itself that, take the name apart
		Hey—I'm not sending you to worship. Listen carefully
		''' */
	/* TrialSummary_4:
		'''
		Up ahead feels blocked shut, and I can't say by what
		Road's closed, so open it
		How it feels past that—we'll talk when you're back
		''' */
	/* TrialSummary_5:
		'''
		Smell off the brimstone sea is wrong. Something's churning
		Don't let it near the shore. Go cut it off
		If the blade stinks when you're back, then we'll talk
		''' */
	/* TrialSummary_6:
		'''
		Fire pit that way is still lit, like someone won't go out
		Put it out, and watch your feet while you're at it
		If you burn yourself, I can't blow on it for you
		''' */
	/* TrialSummary_7:
		'''
		There's a thing with a loud name. Sounds scary enough
		Iron's making noise—go poke it, see if it's all bluster
		Don't race it for whose name is bigger
		''' */
	/* TrialSummary_8:
		'''
		Two dots in the sky, like they agreed to come out together
		If they show up as a pair, handle them separate—don't take both glares
		When you're back you can complain whether they look human
		''' */
	/* TrialSummary_9:
		'''
		Old and new mixed together over there—feels wrong, but I haven't seen clear
		Go sort it out. Don't get bluffed
		We'll talk later which side was even real
		''' */
	/* TrialSummary_10:
		'''
		A shadow walking too much like a person—I haven't seen the face and I'm already annoyed
		Don't freeze staring. Go deal with it
		Who it's copying—we'll swear about that when you're back
		''' */
	/* TrialSummary_11:
		'''
		Something blooming down below that shouldn't. Smell's already wrong
		If it's spent, deal with it. Don't leave it to bother me
		Florist rules later. You go first
		''' */
	/* TrialSummary_12:
		'''
		Something in the stone house that doesn't like moving. Looks hard
		Knock it down. Don't bash the blade on stone—I feel that too
		If your hands go numb, rub them when you're back
		''' */
	/* TrialSummary_13:
		'''
		People muttering at the dungeon door, like they aren't finished
		Interrupt them. Spare the ears
		What they were chanting—we'll talk later. Don't believe it
		''' */
	/* TrialSummary_14:
		'''
		Something like it's pressing on the moon. Looking up feels heavy
		Go get rid of it. Don't just stand there staring up
		When you're back I'll ask if you're worn out
		''' */
	/* TrialSummary_15:
		'''
		Heat from the earth's heart that way—my side feels preheated too
		Go. The edge will run hot—know that ahead of time
		Don't linger in the heat. Finish and pull out
		''' */
	/* TrialSummary_16:
		'''
		Ghosts knotted in the damp over there. I'm not counting
		Handle the whole clump. Don't pick them one by one
		And don't overnight there—I'll nag you about that when you're back
		''' */
	/* TrialSummary_17:
		'''
		That direction feels too empty. I'm going heavy on my side too
		I can't say what it is. Just wrong
		Go. Don't stand there alone spacing out—if you can't see clear, look after yourself first
		We'll talk when you're back. Staying alive beats seeing clear
		''' */
	/* TrialSummary_18:
		'''
		Heard there's still a dragon like this. True or not, you go see
		Edge'll probably burn—don't sheath it in a hurry
		I don't want feathers. Just come back yourself
		''' */
	/* TrialSummary_19:
		'''
		One boom from far off and the ears quit first
		Go make them stop, and cover your ears on the way
		If they're still buzzing when you're back, find somewhere quiet
		''' */
	/* TrialSummary_20:
		'''
		Air over there goes heavy and stagnant, like a door that won't air out
		Go end it. Don't freeze in the doorway breathing that in
		When you're back I'll tell you how to clear your head
		''' */
	/* TrialSummary_21:
		'''
		They're gathering again, like nothing ever fully breaks apart
		This one'll run long. You take it. I'll watch
		Stand steady before you start—I'll nag you about swaying when you're back
		''' */
}

KikasaText: {
	KikasaDrownSystem: {
		// BossRefuse: The lake cannot hold something that big
		// DrownBusy: The lake is still taking the last one
		// DrownOutOfGrip: Too far for the lake to reach
	}

	KikasaVaultPlayer: {
		// LakeNotReady: The lake hasn't risen to your feet yet
		// UmbrellaRefuse: The umbrella won't sink into its own lake
		// VaultFull: The lakebed can't hold any more
	}

	KikasaVaultUI: {
		// Title: Lake Hoard
		// CountFormat: Sunken {0} / {1}
		// ExtractHintFormat: Click to retrieve {0}
		// IdleHintFormat: Hold an item and press {0} to sink it · Click outside to close
		// EmptyHint: The lakebed is empty—only the sound of water
		// ViewOnlyFooter: The lake hasn't risen to your feet yet—look, don't touch
		// SummonHintFormat: Press {0} to call it to fight
	}

	KikasaServantPlayer: {
		// ServantNoMemory: The lake hasn't swallowed anything living yet
		// ServantUnknown: The lake hasn't learned to command it
		// ServantBusy: The lake's hands haven't recovered yet
		// MemoryStamp: The lake remembers it
	}

	KikasaHud: {
		// ScrollName: Lakeside Village Scroll
		// OpenTag: Click to unroll the painting
	}

	KikasaSceneUI: {
		// SceneTitle: Lakeside Village Scroll
		// LakeTag: Blood Lake
		// HoundTag: Black Hound
		// MemoryEmpty: The lakebed is still empty
		// ServantOutTag: It's out doing your work
		// DryHintFormat: Press {0} to raise the blood lake
		// ReflectAwake: The reflection is awake
		// ReflectAsleep: The reflection is asleep
		// DreamTitle: Ghost Dream
		// InDreamLine: You are inside the dream
		// HoundCountFormat: Hounds afield {0} / {1}
		// DreamHint: In the dream, hold left-click—the black water keeps spitting out hounds
	}

	KikasaHudLead: {
		// DomainTitle: Raise the Blood Lake
		// DomainBody: Everything the umbrella does grows out of the blood lake domain—the hoard, the drowning, the servants. Raise the lake first.
		// DomainPrompt: Hold the umbrella and press {0}
		// SinkTitle: Sink Into the Hoard
		// SinkBody: The lake is your private vault. Hold an item and press the sink key to drop it in; aim at a living thing and press the same key, and the lake will drag it under.
		// SinkPrompt: Once the water reaches your feet, press {0} while holding an item or aiming at a creature
		// VaultTitle: Open the Lake Window
		// VaultBody: Everything you sank drifts in the blood water. Open the window, click one, and the lake hands it back.
		// VaultPrompt: Open the little scroll at the bottom left and click the blood lake in it; or hold the umbrella and press {0}
		// SummonTitle: Command the Servant
		// SummonBody: The lake always remembers the last creature drowned in its grip. Call its servant to fight for you; press again to dismiss it.
		// SummonPrompt: Press {0}
		// SummonNoMemory: The lake hasn't memorized anything it can command—drown a boss first, or skip this step.
		// MutateTitle: Ghost Rain Mutation
		// MutateBody: The blood lake has two faces. At full water, flip it over into the cold rain side; flip again to come back.
		// MutatePrompt: Press {0} (middle mouse by default)
		// SkipBtn: Skip
		// KeyUnbound: This step's key is unbound; bind it in Settings > Controls first, or click skip.
	}

	// KikasaDreamSystem.ReflectAsleepHint: The reflection has not woken yet
}
